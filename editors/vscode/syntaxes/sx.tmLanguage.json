{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "sx",
  "scopeName": "source.sx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#heredocs" },
    { "include": "#char-literals" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#raw-identifiers" },
    { "include": "#at-identifiers" },
    { "include": "#generic-params" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#declarations" },
    { "include": "#numbers" },
    { "include": "#identifiers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sx",
          "match": "//.*$"
        }
      ]
    },
    "heredocs": {
      "patterns": [
        {
          "begin": "(#string)[ \\t]+(GLSL|VERT|FRAG|VERTEX|FRAGMENT)(?![A-Za-z0-9_])",
          "end": "^(\\2)(?![A-Za-z0-9_])",
          "beginCaptures": {
            "1": { "name": "keyword.other.directive.sx" },
            "2": { "name": "entity.name.tag.sx" }
          },
          "endCaptures": {
            "1": { "name": "entity.name.tag.sx" }
          },
          "contentName": "meta.embedded.block.glsl",
          "patterns": [
            { "include": "source.glsl" }
          ]
        },
        {
          "begin": "(#string)[ \\t]+(SQL)(?![A-Za-z0-9_])",
          "end": "^(\\2)(?![A-Za-z0-9_])",
          "beginCaptures": {
            "1": { "name": "keyword.other.directive.sx" },
            "2": { "name": "entity.name.tag.sx" }
          },
          "endCaptures": {
            "1": { "name": "entity.name.tag.sx" }
          },
          "contentName": "meta.embedded.block.sql",
          "patterns": [
            { "include": "source.sql" }
          ]
        },
        {
          "begin": "(#string)[ \\t]+(HTML)(?![A-Za-z0-9_])",
          "end": "^(\\2)(?![A-Za-z0-9_])",
          "beginCaptures": {
            "1": { "name": "keyword.other.directive.sx" },
            "2": { "name": "entity.name.tag.sx" }
          },
          "endCaptures": {
            "1": { "name": "entity.name.tag.sx" }
          },
          "contentName": "meta.embedded.block.html",
          "patterns": [
            { "include": "text.html.basic" }
          ]
        },
        {
          "begin": "(#string)[ \\t]+(JSON)(?![A-Za-z0-9_])",
          "end": "^(\\2)(?![A-Za-z0-9_])",
          "beginCaptures": {
            "1": { "name": "keyword.other.directive.sx" },
            "2": { "name": "entity.name.tag.sx" }
          },
          "endCaptures": {
            "1": { "name": "entity.name.tag.sx" }
          },
          "contentName": "meta.embedded.block.json",
          "patterns": [
            { "include": "source.json" }
          ]
        },
        {
          "begin": "(#string)[ \\t]+(XML|PLIST|MANIFEST)(?![A-Za-z0-9_])",
          "end": "^(\\2)(?![A-Za-z0-9_])",
          "beginCaptures": {
            "1": { "name": "keyword.other.directive.sx" },
            "2": { "name": "entity.name.tag.sx" }
          },
          "endCaptures": {
            "1": { "name": "entity.name.tag.sx" }
          },
          "contentName": "meta.embedded.block.xml",
          "patterns": [
            { "include": "text.xml" }
          ]
        },
        {
          "begin": "(#string)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
          "end": "^(\\2)(?![A-Za-z0-9_])",
          "beginCaptures": {
            "1": { "name": "keyword.other.directive.sx" },
            "2": { "name": "entity.name.tag.sx" }
          },
          "endCaptures": {
            "1": { "name": "entity.name.tag.sx" }
          },
          "contentName": "string.unquoted.heredoc.sx"
        }
      ]
    },
    "char-literals": {
      "patterns": [
        {
          "name": "string.quoted.single.sx",
          "match": "'(\\\\(?:x[0-9A-Fa-f]{1,2}|u\\{[0-9A-Fa-f]{1,6}\\}|[ntr\\\\'0]))'",
          "captures": {
            "1": { "name": "constant.character.escape.sx" }
          }
        },
        {
          "name": "string.quoted.single.sx",
          "match": "'[^'\\\\]'"
        },
        {
          "name": "invalid.illegal.char.sx",
          "match": "'\\\\[^']*'"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sx",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.sx" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.sx" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.sx",
              "match": "\\\\[ntr\"\\\\{}0]"
            },
            {
              "name": "meta.template.expression.sx",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.sx" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.sx" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.other.directive.sx",
          "match": "#(?:context_extend|jni_method_descriptor|jni_static_call|jni_interface|jni_class|jni_call|jni_env|jni_main|objc_call|objc_class|objc_protocol|swift_class|swift_struct|swift_protocol|import|error|library|framework|using|include|source|define|flags|identity|extends|implements|selector|property|get|set|string)(?![A-Za-z0-9_])"
        },
        {
          "name": "invalid.illegal.directive.sx",
          "match": "#[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "raw-identifiers": {
      "patterns": [
        {
          "match": "(`)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.identifier.raw.sx" },
            "2": { "name": "variable.other.sx" }
          }
        },
        {
          "name": "invalid.illegal.raw-identifier.sx",
          "match": "`"
        }
      ]
    },
    "at-identifiers": {
      "patterns": [
        {
          "name": "keyword.other.directive.sx",
          "match": "@(?:run|insert)(?![A-Za-z0-9_])"
        },
        {
          "name": "support.type.sx",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "generic-params": {
      "patterns": [
        {
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.variable.sx" },
            "2": { "name": "entity.name.type.parameter.sx" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sx",
          "match": "(?<!\\.)\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.sx",
          "match": "(?<!\\.)\\bnull\\b"
        },
        {
          "name": "constant.language.undefined.sx",
          "match": "---"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sx",
          "match": "(?<!\\.)\\b(?:if|else|then|match|case|break|continue|while|for|return|defer|raise|try|catch|onfail|push|in|inline)\\b"
        },
        {
          "name": "storage.type.sx",
          "match": "(?<!\\.)\\b(?:struct|union|enum|error|protocol|impl)\\b"
        },
        {
          "name": "storage.modifier.sx",
          "match": "(?<!\\.)\\b(?:extern|export|private)\\b"
        },
        {
          "name": "keyword.other.sx",
          "match": "(?<!\\.)\\b(?:abi|asm|intrinsic|ufcs)\\b"
        },
        {
          "name": "keyword.operator.word.sx",
          "match": "(?<!\\.)\\b(?:and|or|xx)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.sx",
          "match": "(?<!\\.)\\b(?:[iu](?:[1-9]|[1-5][0-9]|6[0-4])|f32|f64|bool|string|cstring|void|usize|isize|any|Type|Self)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(?=(?:struct|union|enum|error|protocol)\\b)",
          "captures": {
            "1": { "name": "entity.name.type.sx" },
            "2": { "name": "keyword.operator.declaration.sx" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(?=(?:(?:extern|export|private|inline|intrinsic)\\b\\s*)*\\()",
          "captures": {
            "1": { "name": "entity.name.function.sx" },
            "2": { "name": "keyword.operator.declaration.sx" }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "entity.name.type.sx" },
            "2": { "name": "keyword.operator.declaration.sx" }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "variable.other.constant.sx" },
            "2": { "name": "keyword.operator.declaration.sx" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sx",
          "match": "\\b0[xX][0-9A-Fa-f_]+"
        },
        {
          "name": "constant.numeric.binary.sx",
          "match": "\\b0[bB][01_]+"
        },
        {
          "name": "constant.numeric.octal.sx",
          "match": "\\b0[oO][0-7_]+"
        },
        {
          "name": "constant.numeric.float.sx",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*"
        },
        {
          "name": "constant.numeric.integer.sx",
          "match": "\\b[0-9][0-9_]*"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.sx",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "entity.name.function.sx",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.declaration.sx",
          "match": "::"
        },
        {
          "name": "keyword.operator.assignment.walrus.sx",
          "match": ":="
        },
        {
          "name": "keyword.operator.arrow.sx",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.sx",
          "match": "(?:[=<])?\\.\\.(?:[=<])?"
        },
        {
          "name": "keyword.operator.assignment.compound.sx",
          "match": "(?:<<|>>|[+\\-*/%&|^])="
        },
        {
          "name": "keyword.operator.comparison.sx",
          "match": "[=!<>]="
        },
        {
          "name": "keyword.operator.shift.sx",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.optional.sx",
          "match": "\\?\\?|\\?\\.|\\?"
        },
        {
          "name": "keyword.operator.sx",
          "match": "[+\\-*/%=<>!&|^~]"
        }
      ]
    }
  }
}
