// Metal backend for the GPU protocol (iOS + macOS). Two render-target
// modes: a CAMetalLayer drawable (the on-screen app path), or an
// offscreen MTLTexture (windowless — no WindowServer; see
// MetalGPU.initOffscreen / gpu/offscreen_metal.sx).
//
// Importing this module is harmless on any target — lowering is
// demand-driven, so the Metal/objc externs are only pulled by code that
// actually reaches MetalGPU. Platform selection lives at the consumer
// seam (ui/surface_select.sx, the app host), not per-function here;
// touching MetalGPU on a non-Apple target fails at link/JIT with the
// Metal symbol named.
//
// Linking is per-target via the consumer's build.sx:
//   opts.addFramework("Metal")
//   opts.addFramework("QuartzCore")   // CAMetalLayer lives here
// `@framework "Metal"` below adds it to Apple-target link lines
// automatically.

@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/ffi/objc.sx";
@import "modules/ffi/quartzcore.sx";
@import "modules/build.sx";
@import "modules/gpu/types.sx";
@import "modules/gpu/api.sx";

@framework "Metal";

// MTLCreateSystemDefaultDevice lives in the Metal framework as a plain C
// function. Returns id<MTLDevice> retained +1; it is intentionally leaked —
// the device lives for the whole process.
MTLCreateSystemDefaultDevice :: () -> *MTLDevice extern;

// Pixel formats.
MTL_PIXEL_FORMAT_BGRA8_UNORM :u64: 80;
MTL_PIXEL_FORMAT_RGBA8_UNORM :u64: 70;
MTL_PIXEL_FORMAT_R8_UNORM    :u64: 10;
MTL_PIXEL_FORMAT_DEPTH32_FLOAT :u64: 252;

// MTLLoadAction / MTLStoreAction.
MTL_LOAD_ACTION_CLEAR  :u64: 2;
MTL_STORE_ACTION_STORE :u64: 1;

// MTLStorageMode. For UI atlases + sprites the CPU needs to write pixels
// and the GPU needs to sample — `.shared` is the safe default. On iOS-sim
// under Apple Silicon the convenience class method's default storage
// isn't reliably shared, so createTexture sets it explicitly.
MTL_STORAGE_MODE_SHARED  :u64: 0;
MTL_STORAGE_MODE_PRIVATE :u64: 2;

// MTLTextureUsage. The convenience descriptor defaults to ShaderRead;
// an offscreen render target additionally needs RenderTarget.
MTL_TEXTURE_USAGE_SHADER_READ   :u64: 0x1;
MTL_TEXTURE_USAGE_RENDER_TARGET :u64: 0x4;

// MTLPrimitiveType.
MTL_PRIMITIVE_TYPE_TRIANGLE :u64: 3;

// MTLIndexType. drawIndexed is u32-indexed.
MTL_INDEX_TYPE_UINT32 :u64: 1;

// MTLCompareFunction — the subset DepthMode maps onto.
MTL_COMPARE_FUNCTION_LESS   :u64: 1;
MTL_COMPARE_FUNCTION_LEQUAL :u64: 3;
MTL_COMPARE_FUNCTION_ALWAYS :u64: 7;

// MTLBlendFactor — the subset used for normal alpha blending.
MTL_BLEND_FACTOR_SRC_ALPHA       :u64: 4;
MTL_BLEND_FACTOR_ONE_MINUS_SRC_A :u64: 5;

// MTLClearColor is an f64 HFA; MTLRegion (48 B) and MTLScissorRect
// (32 B) are large integer aggregates passed by value. DSL dispatch
// marshals both classes per the C ABI (HFA registers / caller copy +
// ptr). CGSize lives in ffi/quartzcore.sx.
MTLClearColor :: struct {
    red:   f64;
    green: f64;
    blue:  f64;
    alpha: f64;
}

MTLOrigin :: struct { x: u64; y: u64; z: u64; }
MTLSize   :: struct { width: u64; height: u64; depth: u64; }
MTLRegion :: struct { origin: MTLOrigin; size: MTLSize; }
MTLScissorRect :: struct { x: u64; y: u64; width: u64; height: u64; }

// ── Metal object surfaces (@ObjcClass DSL) ──────────────────────────────
// Only the methods this backend dispatches are declared. Instance
// methods dispatch by selector alone — the bound runtime-class name is
// never looked up for them — so protocol-typed Metal objects
// (id<MTLDevice>, id<MTLTexture>, ...) bind by their protocol name
// harmlessly. Statics exist only on the real descriptor classes.
// `extends = NSObject` supplies retain/release for the destroy paths.

MTLBuffer :: @ObjcClass("MTLBuffer", extends = NSObject) extern {
    contents :: (self: *Self) -> *void;
}

MTLTexture :: @ObjcClass("MTLTexture", extends = NSObject) extern {
    replaceRegion_mipmapLevel_withBytes_bytesPerRow :: (self: *Self, region: MTLRegion, level: u64, bytes: *void, bytesPerRow: u64);
    getBytes_bytesPerRow_fromRegion_mipmapLevel :: (self: *Self, out: *void, bytesPerRow: u64, region: MTLRegion, level: u64);
}

MTLRenderPipelineState :: @ObjcClass("MTLRenderPipelineState", extends = NSObject) extern {
}

MTLDepthStencilState :: @ObjcClass("MTLDepthStencilState", extends = NSObject) extern {
}

MTLDepthStencilDescriptor :: @ObjcClass("MTLDepthStencilDescriptor", extends = NSObject) extern {
    alloc :: () -> *MTLDepthStencilDescriptor;
    init :: (self: *Self) -> *MTLDepthStencilDescriptor;
    setDepthCompareFunction :: (self: *Self, fn: u64);
    setDepthWriteEnabled :: (self: *Self, on: BOOL);
}

MTLLibrary :: @ObjcClass("MTLLibrary", extends = NSObject) extern {
    // MTLFunction is only handed straight back to the pipeline
    // descriptor — untyped is enough.
    newFunctionWithName :: (self: *Self, name: *NSString) -> *void;
}

MTLTextureDescriptor :: @ObjcClass("MTLTextureDescriptor", extends = NSObject) extern {
    texture2DDescriptorWithPixelFormat_width_height_mipmapped :: (fmt: u64, w: u64, h: u64, mipmapped: BOOL) -> *MTLTextureDescriptor;
    setUsage :: (self: *Self, usage: u64);
    setStorageMode :: (self: *Self, mode: u64);
}

MTLRenderPipelineColorAttachment :: @ObjcClass("MTLRenderPipelineColorAttachmentDescriptor") extern {
    setPixelFormat :: (self: *Self, fmt: u64);
    setBlendingEnabled :: (self: *Self, on: BOOL);
    setSourceRGBBlendFactor :: (self: *Self, f: u64);
    setDestinationRGBBlendFactor :: (self: *Self, f: u64);
    setSourceAlphaBlendFactor :: (self: *Self, f: u64);
    setDestinationAlphaBlendFactor :: (self: *Self, f: u64);
}

MTLRenderPipelineColorAttachmentArray :: @ObjcClass("MTLRenderPipelineColorAttachmentDescriptorArray") extern {
    objectAtIndexedSubscript :: (self: *Self, i: u64) -> *MTLRenderPipelineColorAttachment;
}

MTLRenderPipelineDescriptor :: @ObjcClass("MTLRenderPipelineDescriptor", extends = NSObject) extern {
    alloc :: () -> *MTLRenderPipelineDescriptor;
    init :: (self: *Self) -> *MTLRenderPipelineDescriptor;
    setVertexFunction :: (self: *Self, f: *void);
    setFragmentFunction :: (self: *Self, f: *void);
    colorAttachments :: (self: *Self) -> *MTLRenderPipelineColorAttachmentArray;
    setDepthAttachmentPixelFormat :: (self: *Self, fmt: u64);
}

MTLRenderPassColorAttachment :: @ObjcClass("MTLRenderPassColorAttachmentDescriptor") extern {
    setTexture :: (self: *Self, tex: *MTLTexture);
    setLoadAction :: (self: *Self, action: u64);
    setStoreAction :: (self: *Self, action: u64);
    setClearColor :: (self: *Self, color: MTLClearColor);
}

MTLRenderPassColorAttachmentArray :: @ObjcClass("MTLRenderPassColorAttachmentDescriptorArray") extern {
    objectAtIndexedSubscript :: (self: *Self, i: u64) -> *MTLRenderPassColorAttachment;
}

MTLRenderPassDepthAttachment :: @ObjcClass("MTLRenderPassDepthAttachmentDescriptor") extern {
    setTexture :: (self: *Self, tex: *MTLTexture);
    setLoadAction :: (self: *Self, action: u64);
    setStoreAction :: (self: *Self, action: u64);
    setClearDepth :: (self: *Self, depth: f64);
}

MTLRenderPassDescriptor :: @ObjcClass("MTLRenderPassDescriptor") extern {
    renderPassDescriptor :: () -> *MTLRenderPassDescriptor;
    colorAttachments :: (self: *Self) -> *MTLRenderPassColorAttachmentArray;
    depthAttachment :: (self: *Self) -> *MTLRenderPassDepthAttachment;
}

MTLRenderCommandEncoder :: @ObjcClass("MTLRenderCommandEncoder") extern {
    endEncoding :: (self: *Self);
    setRenderPipelineState :: (self: *Self, state: *MTLRenderPipelineState);
    setVertexBuffer_offset_atIndex :: (self: *Self, buf: *MTLBuffer, offset: u64, index: u64);
    setFragmentTexture_atIndex :: (self: *Self, tex: *MTLTexture, index: u64);
    setVertexBytes_length_atIndex :: (self: *Self, bytes: *void, length: u64, index: u64);
    setScissorRect :: (self: *Self, rect: MTLScissorRect);
    setDepthStencilState :: (self: *Self, state: *MTLDepthStencilState);
    drawPrimitives_vertexStart_vertexCount :: (self: *Self, prim: u64, start: u64, count: u64);
    drawIndexedPrimitives_indexCount_indexType_indexBuffer_indexBufferOffset :: (self: *Self, prim: u64, count: u64, indexType: u64, buf: *MTLBuffer, offset: u64);
}

MTLBlitCommandEncoder :: @ObjcClass("MTLBlitCommandEncoder") extern {
    endEncoding :: (self: *Self);
    copyFromTexture_toTexture :: (self: *Self, src: *MTLTexture, dst: *MTLTexture);
}

CAMetalDrawable :: @ObjcClass("CAMetalDrawable") extern {
    texture :: (self: *Self) -> *MTLTexture;
    present :: (self: *Self);
}

MTLCommandBuffer :: @ObjcClass("MTLCommandBuffer") extern {
    renderCommandEncoderWithDescriptor :: (self: *Self, pass: *MTLRenderPassDescriptor) -> *MTLRenderCommandEncoder;
    blitCommandEncoder :: (self: *Self) -> *MTLBlitCommandEncoder;
    presentDrawable :: (self: *Self, drawable: *CAMetalDrawable);
    presentDrawable_atTime :: (self: *Self, drawable: *CAMetalDrawable, t: f64);
    commit :: (self: *Self);
    waitUntilScheduled :: (self: *Self);
    waitUntilCompleted :: (self: *Self);
}

MTLCommandQueue :: @ObjcClass("MTLCommandQueue") extern {
    commandBuffer :: (self: *Self) -> *MTLCommandBuffer;
}

// CAMetalLayer is declared in ffi/quartzcore.sx (shared with the
// platform host — one decl per runtime class). Its Metal-typed ends
// are untyped there; this module casts at the boundary.

MTLDevice :: @ObjcClass("MTLDevice") extern {
    newCommandQueue :: (self: *Self) -> *MTLCommandQueue;
    newBufferWithLength_options :: (self: *Self, length: u64, options: u64) -> *MTLBuffer;
    newTextureWithDescriptor :: (self: *Self, desc: *MTLTextureDescriptor) -> *MTLTexture;
    newLibraryWithSource_options_error :: (self: *Self, src: *NSString, options: *void, err: **void) -> *MTLLibrary;
    newRenderPipelineStateWithDescriptor_error :: (self: *Self, desc: *MTLRenderPipelineDescriptor, err: **void) -> *MTLRenderPipelineState;
    newDepthStencilStateWithDescriptor :: (self: *Self, desc: *MTLDepthStencilDescriptor) -> *MTLDepthStencilState;
}

// Pixel sub-format storage for textures. Tracks the bytes-per-pixel for the
// upload path (replaceRegion needs bytesPerRow which is bpp × width).
TextureSlot :: struct {
    tex: *MTLTexture = null;
    bytesPerPixel: u32 = 0;
}

MetalGPU :: struct {
    device:  *MTLDevice = null;
    queue:   *MTLCommandQueue = null;
    layer:   *CAMetalLayer = null;
    pixelW: i32 = 0;
    pixelH: i32 = 0;

    // Offscreen mode (layer == null): the render pass targets
    // offscreenTex; readback blits into the shared readbackTex and
    // reads with getBytes. nextDrawable is never touched.
    offscreenTex: *MTLTexture = null;  // private storage
    readbackTex:  *MTLTexture = null;  // shared storage
    // Pixel format of the render target — pipeline states must match.
    // Layer mode keeps BGRA8 (CAMetalLayer's format); offscreen uses
    // RGBA8 so readback hands out RGBA rows with no swizzle.
    targetFormat: u64 = MTL_PIXEL_FORMAT_BGRA8_UNORM;

    // Per-frame transients. Live only between beginFrame and endFrame.
    drawable:   *CAMetalDrawable = null;
    cmdBuffer: *MTLCommandBuffer = null;
    encoder:    *MTLRenderCommandEncoder = null;
    presentsWithTransaction: bool = false;

    // Every render pass carries a depth attachment and every pipeline
    // declares MTL_PIXEL_FORMAT_DEPTH32_FLOAT: Metal rejects a draw whose
    // pipeline depth format disagrees with the pass, so the two cannot be
    // decided per-frame from the mode.
    depthTex: *MTLTexture = null;
    depthW:   i32 = 0;
    depthH:   i32 = 0;
    depthMode: DepthMode = .disabled;
    depthStates: [3]*MTLDepthStencilState = .[null, null, null];

    boundIndex: *MTLBuffer = null;

    // Only the first `boneCount` matrices carry a live transform.
    bonePalette: [GPU_MAX_BONES]BoneMatrix = ---;
    boneCount: i32 = 0;

    // Resource tables. Handles are 1-based indices (0 = invalid).
    shaders:  List(*MTLRenderPipelineState) = .{};
    buffers:  List(*MTLBuffer)              = .{};
    indices:  List(*MTLBuffer)              = .{};
    textures: List(TextureSlot)             = .{};

    // Captured at init() so resource creation always grows the cache lists
    // through the long-lived allocator, even when the caller is currently
    // inside a transient arena context (e.g. glyph atlas grow during render).
    parentAllocator: Allocator = ---;

    // Handle → retained object lookups shared by the buffer/shader paths.
    lookupBuffer :: (self: *MetalGPU, handle: u32) -> *MTLBuffer {
        if handle == 0 { return null; }
        h64 : i64 = handle.(i64);
        if h64 > self.buffers.len { return null; }
        self.buffers.items[handle - 1]
    }

    lookupIndex :: (self: *MetalGPU, handle: u32) -> *MTLBuffer {
        if handle == 0 { return null; }
        h64 : i64 = handle.(i64);
        if h64 > self.indices.len { return null; }
        self.indices.items[handle - 1]
    }

    lookupShader :: (self: *MetalGPU, handle: u32) -> *MTLRenderPipelineState {
        if handle == 0 { return null; }
        h64 : i64 = handle.(i64);
        if h64 > self.shaders.len { return null; }
        self.shaders.items[handle - 1]
    }

    depthState :: (self: *MetalGPU, mode: DepthMode) -> *MTLDepthStencilState {
        idx : i64 = 0;
        if mode == .less { idx = 1; }
        else if mode == .lequal { idx = 2; }

        cached := self.depthStates[idx];
        if cached != null { return cached; }
        if self.device == null { return null; }

        desc := MTLDepthStencilDescriptor.alloc().init();
        if mode == .disabled {
            desc.setDepthCompareFunction(MTL_COMPARE_FUNCTION_ALWAYS);
            desc.setDepthWriteEnabled(0);
        } else if mode == .less {
            desc.setDepthCompareFunction(MTL_COMPARE_FUNCTION_LESS);
            desc.setDepthWriteEnabled(1);
        } else {
            desc.setDepthCompareFunction(MTL_COMPARE_FUNCTION_LEQUAL);
            desc.setDepthWriteEnabled(1);
        }

        st := self.device.newDepthStencilStateWithDescriptor(desc);
        desc.release();
        self.depthStates[idx] = st;
        st
    }

    ensureDepthTexture :: (self: *MetalGPU) -> *MTLTexture {
        if self.device == null { return null; }
        if self.depthTex != null and self.depthW == self.pixelW and self.depthH == self.pixelH {
            return self.depthTex;
        }
        if self.depthTex != null {
            self.depthTex.release();
            self.depthTex = null;
        }

        desc := MTLTextureDescriptor.texture2DDescriptorWithPixelFormat_width_height_mipmapped(
            MTL_PIXEL_FORMAT_DEPTH32_FLOAT, self.pixelW, self.pixelH, 0);
        if desc == null { return null; }
        desc.setUsage(MTL_TEXTURE_USAGE_RENDER_TARGET);
        desc.setStorageMode(MTL_STORAGE_MODE_PRIVATE);

        self.depthTex = self.device.newTextureWithDescriptor(desc);
        self.depthW = self.pixelW;
        self.depthH = self.pixelH;
        self.depthTex
    }

    // Offscreen (windowless) init: no CAMetalLayer, no WindowServer. The
    // render pass targets a private RGBA8 texture; readback goes through
    // a blit into a shared texture (readOffscreen). Not part of the GPU
    // protocol — backends that own a MetalGPU (gpu/offscreen_metal.sx)
    // call this instead of init().
    initOffscreen :: (self: *MetalGPU, pixelW: i32, pixelH: i32) -> bool {
        if pixelW <= 0 or pixelH <= 0 { return false; }

        self.pixelW = pixelW;
        self.pixelH = pixelH;
        self.parentAllocator = context.allocator;
        self.targetFormat = MTL_PIXEL_FORMAT_RGBA8_UNORM;

        if self.device == null {
            self.device = MTLCreateSystemDefaultDevice();
            if self.device == null { return false; }
        }
        if self.queue == null {
            self.queue = self.device.newCommandQueue();
            if self.queue == null { return false; }
        }

        desc := MTLTextureDescriptor.texture2DDescriptorWithPixelFormat_width_height_mipmapped(
            self.targetFormat, pixelW, pixelH, 0);
        if desc == null { return false; }
        desc.setUsage(MTL_TEXTURE_USAGE_RENDER_TARGET | MTL_TEXTURE_USAGE_SHADER_READ);
        desc.setStorageMode(MTL_STORAGE_MODE_PRIVATE);
        self.offscreenTex = self.device.newTextureWithDescriptor(desc);
        if self.offscreenTex == null { return false; }

        rdesc := MTLTextureDescriptor.texture2DDescriptorWithPixelFormat_width_height_mipmapped(
            self.targetFormat, pixelW, pixelH, 0);
        if rdesc == null { return false; }
        rdesc.setStorageMode(MTL_STORAGE_MODE_SHARED);
        self.readbackTex = self.device.newTextureWithDescriptor(rdesc);
        if self.readbackTex == null { return false; }

        true
    }

    // Copy the offscreen target into `out` (pixelW × pixelH × 4 bytes,
    // top-down RGBA — Metal's texture origin is already top-left). Assumes
    // endFrame has run (it drains the GPU in offscreen mode).
    readOffscreen :: (self: *MetalGPU, out: *void) -> bool {
        if self.offscreenTex == null or self.readbackTex == null { return false; }
        if self.queue == null { return false; }

        // The private render target isn't CPU-readable — blit it into the
        // shared texture first.
        cmd := self.queue.commandBuffer();
        if cmd == null { return false; }
        blit := cmd.blitCommandEncoder();
        if blit == null { return false; }
        blit.copyFromTexture_toTexture(self.offscreenTex, self.readbackTex);
        blit.endEncoding();
        cmd.commit();
        cmd.waitUntilCompleted();

        region : MTLRegion = .{
            origin = .{ x = 0, y = 0, z = 0 },
            size   = .{ width = self.pixelW, height = self.pixelH, depth = 1 },
        };
        bytesPerRow : u64 = (self.pixelW * 4).(u64);
        self.readbackTex.getBytes_bytesPerRow_fromRegion_mipmapLevel(out, bytesPerRow, region, 0);
        true
    }
}

impl GPU for MetalGPU {
    // Two-phase init: callers can `init(null, 0, 0)` first to allocate
    // device + queue eagerly (lets the UI pipeline compile shaders before
    // UIKit hands us a layer), then re-call `init(layer, w, h)` once the
    // CAMetalLayer is available. The second call only updates the layer
    // ref + dims; device/queue are preserved — idempotent on both, and
    // the layer is only touched when one's been supplied.
    init :: (self: *MetalGPU, target: *void, pixelW: i32, pixelH: i32) -> bool {
        if target != null {
            self.layer   = target;
            self.pixelW = pixelW;
            self.pixelH = pixelH;
        }
        self.parentAllocator = context.allocator;
        // Layer mode renders BGRA8 (CAMetalLayer's format). Set explicitly,
        // not via the field default: apps allocate MetalGPU with
        // alloc+memset(0) (defaults never apply), and a zero here is
        // MTLPixelFormatInvalid — pipeline creation fails on every shader.
        self.targetFormat = MTL_PIXEL_FORMAT_BGRA8_UNORM;

        if self.device == null {
            self.device = MTLCreateSystemDefaultDevice();
            if self.device == null { return false; }
        }
        if self.queue == null {
            self.queue = self.device.newCommandQueue();
            if self.queue == null { return false; }
        }

        if self.layer != null {
            self.layer.setDevice(self.device);
            self.layer.setPixelFormat(MTL_PIXEL_FORMAT_BGRA8_UNORM);
            self.layer.setFramebufferOnly(1);

            // setDrawableSize:(0,0) makes nextDrawable abort via XPC. Skip the
            // size set when dims are not yet known — the layer's drawableSize
            // defaults to its bounds×contentsScale until we override it, which
            // also lets the first frame render at the natural backing size.
            if self.pixelW > 0 and self.pixelH > 0 {
                self.layer.setDrawableSize(.{ width = self.pixelW, height = self.pixelH });
            }
            self.layer.setMaximumDrawableCount(3);
            self.layer.setPresentsWithTransaction(1);
            self.presentsWithTransaction = true;
        }

        true
    }

    shutdown :: (self: *MetalGPU) {
        // Metal objects clean up at process exit on iOS. A real shutdown
        // would send `release` to queue + device.
    }

    resize :: (self: *MetalGPU, pixelW: i32, pixelH: i32) {
        self.pixelW = pixelW;
        self.pixelH = pixelH;
        if self.layer == null { return; }
        self.layer.setDrawableSize(.{ width = self.pixelW, height = self.pixelH });
    }

    beginFrame :: (self: *MetalGPU, clear: ClearColor) -> bool {
        if self.layer == null and self.offscreenTex == null { return false; }
        if self.queue == null { return false; }
        if self.pixelW <= 0 or self.pixelH <= 0 { return false; }

        targetTexture := self.offscreenTex;
        if self.layer != null {
            self.drawable = self.layer.nextDrawable();
            if self.drawable == null { return false; }
            targetTexture = self.drawable.texture();
        }

        pass := MTLRenderPassDescriptor.renderPassDescriptor();   // autoreleased
        color0 := pass.colorAttachments().objectAtIndexedSubscript(0);
        color0.setTexture(targetTexture);
        color0.setLoadAction(MTL_LOAD_ACTION_CLEAR);
        color0.setStoreAction(MTL_STORE_ACTION_STORE);
        color0.setClearColor(.{
            red   = clear.r,
            green = clear.g,
            blue  = clear.b,
            alpha = clear.a,
        });

        depth := self.ensureDepthTexture();
        if depth == null { self.drawable = null; return false; }
        d := pass.depthAttachment();
        d.setTexture(depth);
        d.setLoadAction(MTL_LOAD_ACTION_CLEAR);
        d.setStoreAction(MTL_STORE_ACTION_STORE);
        d.setClearDepth(1.0);

        self.cmdBuffer = self.queue.commandBuffer();             // autoreleased
        if self.cmdBuffer == null { self.drawable = null; return false; }

        self.encoder = self.cmdBuffer.renderCommandEncoderWithDescriptor(pass);  // autoreleased
        if self.encoder == null { self.cmdBuffer = null; self.drawable = null; return false; }

        st := self.depthState(self.depthMode);
        if st != null { self.encoder.setDepthStencilState(st); }

        true
    }

    endFrame :: (self: *MetalGPU, targetTime: f64) {
        if self.encoder == null { return; }
        if self.cmdBuffer == null { return; }
        if self.drawable == null and self.offscreenTex == null { return; }

        self.encoder.endEncoding();

        if self.drawable != null and self.presentsWithTransaction {
            // The present has to land inside the current CATransaction:
            // commit, wait until the buffer is scheduled, then present the
            // drawable directly. A present queued on the command buffer
            // fires after the transaction flushes, and the layer drops it.
            self.cmdBuffer.commit();
            self.cmdBuffer.waitUntilScheduled();
            self.drawable.present();
        } else {
            if self.drawable != null {
                if targetTime > 0.0 {
                    self.cmdBuffer.presentDrawable_atTime(self.drawable, targetTime);
                } else {
                    self.cmdBuffer.presentDrawable(self.drawable);
                }
            }
            self.cmdBuffer.commit();
        }

        // Offscreen mode has no vsync to hide behind: the caller reads the
        // texture right after endFrame, so drain the GPU here.
        if self.drawable == null {
            self.cmdBuffer.waitUntilCompleted();
        }

        self.encoder    = null;
        self.cmdBuffer = null;
        self.drawable   = null;
    }

    // ── Resources ────────────────────────────────────────────────────────
    // Handle = 1-based index into the backing List (0 = invalid).

    // Compile the MSL source, look up the conventional entry points `vmain`
    // (vertex) and `fmain` (fragment), and produce an `MTLRenderPipelineState`
    // targeted at the render target's pixel format with standard alpha
    // blending. The fsrc parameter is ignored — Metal's library is one MSL
    // file with both functions; pass the combined source as vsrc.
    createShader :: (self: *MetalGPU, vsrc: string, fsrc: string) -> ShaderHandle {
        if self.device == null { return 0; }

        err : *void = null;
        library := self.device.newLibraryWithSource_options_error(nsstring(vsrc), null, *err);
        if library == null {
            NSLog(nsstring("[metal] MSL compile failed\n"));
            return 0;
        }

        vfn := library.newFunctionWithName(nsstring("vmain"));
        ffn := library.newFunctionWithName(nsstring("fmain"));
        if vfn == null { NSLog(nsstring("[metal] missing vmain in MSL\n")); return 0; }
        if ffn == null { NSLog(nsstring("[metal] missing fmain in MSL\n")); return 0; }

        desc := MTLRenderPipelineDescriptor.alloc().init();
        desc.setVertexFunction(vfn);
        desc.setFragmentFunction(ffn);

        // colorAttachments[0]: pixel format + alpha blending.
        att0 := desc.colorAttachments().objectAtIndexedSubscript(0);
        att0.setPixelFormat(self.targetFormat);
        att0.setBlendingEnabled(1);
        att0.setSourceRGBBlendFactor(MTL_BLEND_FACTOR_SRC_ALPHA);
        att0.setDestinationRGBBlendFactor(MTL_BLEND_FACTOR_ONE_MINUS_SRC_A);
        att0.setSourceAlphaBlendFactor(MTL_BLEND_FACTOR_SRC_ALPHA);
        att0.setDestinationAlphaBlendFactor(MTL_BLEND_FACTOR_ONE_MINUS_SRC_A);

        desc.setDepthAttachmentPixelFormat(MTL_PIXEL_FORMAT_DEPTH32_FLOAT);

        err2 : *void = null;
        state := self.device.newRenderPipelineStateWithDescriptor_error(desc, *err2);
        if state == null {
            NSLog(nsstring("[metal] pipeline state creation failed\n"));
            return 0;
        }

        self.shaders.append(state, self.parentAllocator);
        self.shaders.len
    }

    // Shared-memory MTLBuffer (CPU + GPU visible on UMA hardware). `contents`
    // returns the mapped pointer for c.memcpy uploads.
    createBuffer :: (self: *MetalGPU, sizeBytes: i64) -> BufferHandle {
        if self.device == null { return 0; }
        if sizeBytes <= 0 { return 0; }

        // MTLResourceStorageModeShared is the default (option value 0).
        buf := self.device.newBufferWithLength_options(sizeBytes, 0);
        if buf == null { return 0; }

        self.buffers.append(buf, self.parentAllocator);
        self.buffers.len
    }

    createIndexBuffer :: (self: *MetalGPU, sizeBytes: i64) -> IndexHandle {
        if self.device == null { return 0; }
        if sizeBytes <= 0 { return 0; }

        buf := self.device.newBufferWithLength_options(sizeBytes, 0);
        if buf == null { return 0; }

        self.indices.append(buf, self.parentAllocator);
        self.indices.len
    }

    updateIndexBuffer :: (self: *MetalGPU, buf: IndexHandle, data: *void, sizeBytes: i64) {
        mbuf := self.lookupIndex(buf);
        if mbuf == null { return; }
        if data == null { return; }
        if sizeBytes <= 0 { return; }

        dst := mbuf.contents();
        if dst == null { return; }
        c.memcpy(dst, data, sizeBytes);
    }

    updateBuffer :: (self: *MetalGPU, buf: BufferHandle, data: *void, sizeBytes: i64) {
        mbuf := self.lookupBuffer(buf);
        if mbuf == null { return; }
        if data == null { return; }
        if sizeBytes <= 0 { return; }

        dst := mbuf.contents();
        if dst == null { return; }
        c.memcpy(dst, data, sizeBytes);
    }

    updateBufferAt :: (self: *MetalGPU, buf: BufferHandle, data: *void, sizeBytes: i64, byteOffset: i64) {
        mbuf := self.lookupBuffer(buf);
        if mbuf == null { return; }
        if data == null { return; }
        if sizeBytes <= 0 { return; }
        if byteOffset < 0 { return; }

        base := mbuf.contents();
        if base == null { return; }
        // Add byteOffset via integer arithmetic. `@dst[i]` on `[*]u8` does
        // the same thing; the explicit form keeps the arithmetic visible.
        baseI : i64 = base.(i64);
        dstAt : *void = (baseI + byteOffset).(*void);
        c.memcpy(dstAt, data, sizeBytes);
    }

    createTexture :: (self: *MetalGPU, w: i32, h: i32, format: TextureFormat, pixels: *void) -> TextureHandle {
        if self.device == null { return 0; }
        if w <= 0 { return 0; }
        if h <= 0 { return 0; }

        pixelFormat : u64 = 0;
        bytesPerPixel : u32 = 0;
        if format == .rgba8 {
            pixelFormat = MTL_PIXEL_FORMAT_RGBA8_UNORM;
            bytesPerPixel = 4;
        } else {
            pixelFormat = MTL_PIXEL_FORMAT_R8_UNORM;
            bytesPerPixel = 1;
        }

        desc := MTLTextureDescriptor.texture2DDescriptorWithPixelFormat_width_height_mipmapped(
            pixelFormat, w, h, 0);
        if desc == null { return 0; }

        // Force shared storage so the CPU can keep writing pixels (atlas updates,
        // sprite uploads). On iOS-sim under Apple Silicon the convenience class
        // method's default storage isn't reliably shared for every format.
        desc.setStorageMode(MTL_STORAGE_MODE_SHARED);

        tex := self.device.newTextureWithDescriptor(desc);
        if tex == null { return 0; }

        slot : TextureSlot = .{ tex = tex, bytesPerPixel = bytesPerPixel };
        self.textures.append(slot, self.parentAllocator);

        if pixels != null {
            handle : u32 = self.textures.len.(u32);
            self.updateTextureRegion(handle, 0, 0, w, h, pixels);
        }

        self.textures.len
    }

    updateTextureRegion :: (self: *MetalGPU, tex: TextureHandle, x: i32, y: i32, w: i32, h: i32, pixels: *void) {
        if tex == 0 { return; }
        h64 : i64 = tex.(i64);
        if h64 > self.textures.len { return; }
        slot := self.textures.items[tex - 1];
        if slot.tex == null { return; }
        if pixels == null { return; }
        if w <= 0 { return; }
        if h <= 0 { return; }

        region : MTLRegion = .{
            origin = .{ x = x, y = y, z = 0 },
            size   = .{ width = w, height = h, depth = 1 },
        };
        bytesPerRow : u64 = (slot.bytesPerPixel * w.(u32)).(u64);
        slot.tex.replaceRegion_mipmapLevel_withBytes_bytesPerRow(region, 0, pixels, bytesPerRow);
    }

    // ── Destroy ──────────────────────────────────────────────────────────
    // `release` on a Metal object whose retain count reaches zero deallocates
    // it. Our resource Lists hold the only strong reference (Metal returns
    // retained-+1 objects from `new*` and our `append` doesn't retain), so a
    // single `release` is correct. Slots are null'd so a subsequent lookup
    // short-circuits; the List length doesn't shrink (would break later
    // handle->index mapping).

    destroyShader :: (self: *MetalGPU, sh: ShaderHandle) {
        if sh == 0 { return; }
        h64 : i64 = sh.(i64);
        if h64 > self.shaders.len { return; }
        obj := self.shaders.items[sh - 1];
        if obj == null { return; }
        obj.release();
        self.shaders.items[sh - 1] = null;
    }

    destroyBuffer :: (self: *MetalGPU, buf: BufferHandle) {
        if buf == 0 { return; }
        h64 : i64 = buf.(i64);
        if h64 > self.buffers.len { return; }
        obj := self.buffers.items[buf - 1];
        if obj == null { return; }
        obj.release();
        self.buffers.items[buf - 1] = null;
    }

    destroyIndexBuffer :: (self: *MetalGPU, buf: IndexHandle) {
        if buf == 0 { return; }
        h64 : i64 = buf.(i64);
        if h64 > self.indices.len { return; }
        obj := self.indices.items[buf - 1];
        if obj == null { return; }
        if self.boundIndex == obj { self.boundIndex = null; }
        obj.release();
        self.indices.items[buf - 1] = null;
    }

    destroyTexture :: (self: *MetalGPU, tex: TextureHandle) {
        if tex == 0 { return; }
        h64 : i64 = tex.(i64);
        if h64 > self.textures.len { return; }
        obj := self.textures.items[tex - 1].tex;
        if obj == null { return; }
        obj.release();
        self.textures.items[tex - 1].tex = null;
        self.textures.items[tex - 1].bytesPerPixel = 0;
    }

    // ── Per-draw state ───────────────────────────────────────────────────
    // All operate on `self.encoder`, which is live only between beginFrame
    // and endFrame. Calling these outside that window is a silent no-op.

    setShader :: (self: *MetalGPU, sh: ShaderHandle) {
        if self.encoder == null { return; }
        state := self.lookupShader(sh);
        if state == null { return; }
        self.encoder.setRenderPipelineState(state);
    }

    setVertexBuffer :: (self: *MetalGPU, buf: BufferHandle) {
        if self.encoder == null { return; }
        mbuf := self.lookupBuffer(buf);
        if mbuf == null { return; }
        self.encoder.setVertexBuffer_offset_atIndex(mbuf, 0, 0);
    }

    setIndexBuffer :: (self: *MetalGPU, buf: IndexHandle) {
        self.boundIndex = self.lookupIndex(buf);
    }

    setTexture :: (self: *MetalGPU, slot: u32, tex: TextureHandle) {
        if self.encoder == null { return; }
        if tex == 0 { return; }
        h64 : i64 = tex.(i64);
        if h64 > self.textures.len { return; }
        mtex := self.textures.items[tex - 1].tex;
        if mtex == null { return; }
        self.encoder.setFragmentTexture_atIndex(mtex, slot);
    }

    setVertexConstants :: (self: *MetalGPU, slot: u32, data: *void, sizeBytes: i64) {
        if self.encoder == null { return; }
        if data == null { return; }
        if sizeBytes <= 0 { return; }
        self.encoder.setVertexBytes_length_atIndex(data, sizeBytes, slot);
    }

    setScissor :: (self: *MetalGPU, x: i32, y: i32, w: i32, h: i32) {
        if self.encoder == null { return; }
        self.encoder.setScissorRect(.{ x = x, y = y, width = w, height = h });
    }

    disableScissor :: (self: *MetalGPU) {
        if self.encoder == null { return; }
        // Metal has no "disable scissor" — set the rect to cover the full
        // drawable so subsequent draws aren't clipped.
        self.encoder.setScissorRect(.{ x = 0, y = 0, width = self.pixelW, height = self.pixelH });
    }

    setDepthMode :: (self: *MetalGPU, mode: DepthMode) {
        self.depthMode = mode;
        if self.encoder == null { return; }
        st := self.depthState(mode);
        if st == null { return; }
        self.encoder.setDepthStencilState(st);
    }

    // The skinned shader takes the palette as
    // `constant float4* bones [[buffer(8)]]`, and declares SkinnedVertex
    // with packed members (packed_float3 position, packed_float3 normal,
    // packed_float2 uv, packed_float4 joints, packed_float4 weights) so
    // MSL's layout matches the 64-byte interleave. Bone `i` is the three
    // rows `bones[i*3+0..2]` of a row-major affine transform, applied by
    // dotting each row against `float4(position, 1.0)`.
    setBonePalette :: (self: *MetalGPU, data: *void, count: i32) {
        if data == null { return; }
        if count < 0 { return; }
        if count > GPU_MAX_BONES { return; }
        n : i64 = count.(i64);
        c.memcpy(*self.bonePalette[0], data, n * @sizeOf(BoneMatrix));
        self.boneCount = count;
    }

    drawTriangles :: (self: *MetalGPU, vertexOffset: i32, vertexCount: i32) {
        if self.encoder == null { return; }
        if vertexCount <= 0 { return; }
        self.encoder.drawPrimitives_vertexStart_vertexCount(
            MTL_PRIMITIVE_TYPE_TRIANGLE, vertexOffset, vertexCount);
    }

    drawIndexed :: (self: *MetalGPU, indexOffset: i32, indexCount: i32) {
        if self.encoder == null { return; }
        if self.boundIndex == null { return; }
        if indexCount <= 0 { return; }
        if indexOffset < 0 { return; }
        byteOffset : u64 = (indexOffset * 4).(u64);
        self.encoder.drawIndexedPrimitives_indexCount_indexType_indexBuffer_indexBufferOffset(
            MTL_PRIMITIVE_TYPE_TRIANGLE, indexCount, MTL_INDEX_TYPE_UINT32,
            self.boundIndex, byteOffset);
    }

    drawSkinned :: (self: *MetalGPU, indexOffset: i32, indexCount: i32) {
        if self.encoder == null { return; }
        if self.boundIndex == null { return; }
        if indexCount <= 0 { return; }
        if indexOffset < 0 { return; }
        if self.boneCount <= 0 { return; }

        n : i64 = self.boneCount.(i64);
        self.encoder.setVertexBytes_length_atIndex(
            *self.bonePalette[0], (n * @sizeOf(BoneMatrix)), 8);

        byteOffset : u64 = (indexOffset * 4).(u64);
        self.encoder.drawIndexedPrimitives_indexCount_indexType_indexBuffer_indexBufferOffset(
            MTL_PRIMITIVE_TYPE_TRIANGLE, indexCount, MTL_INDEX_TYPE_UINT32,
            self.boundIndex, byteOffset);
    }
}
