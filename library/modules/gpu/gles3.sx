// GLES3 backend for the GPU protocol, on Android.
//
// We use opengl.sx's runtime-loaded function-pointer variables for every
// GL call, populated via `loadGl(@eglGetProcAddress)` in `init()`.
// `extern` decls for the same names would collide with opengl.sx's
// global variables and silently win — that produces NULL function-
// pointer calls (PC=0 crash) because the variables are uninitialized.
//
// Conventions:
//   - One shared VAO with the renderer's fixed 16-float layout
//     (pos2 / uv2 / color4 / params4 / stroke4 = 64 bytes, attribute
//     locations 0-4).
//     `setVertexBuffer` rebinds the VBO against this VAO each time.
//   - `setVertexConstants(slot=1, data, 64)` is treated as the 4x4
//     projection matrix and uploaded via `glUniformMatrix4fv(uProj)`,
//     matching the renderer.sx shader contract. Other slots are no-ops.
//   - `setTexture(slot=0, tex)` binds texture unit 0 and sets
//     `uniform sampler2D uTex` to 0. Other slots are no-ops.
//   - The skinned shader takes the bone palette as
//     `uniform vec4 uBones[240]`. Bone `i` is the three rows
//     `uBones[i*3+0..2]` of a row-major affine transform, applied by
//     dotting each row against `vec4(position, 1.0)`. 240 rows is
//     `GPU_MAX_BONES * 3`; with the projection matrix's 4 vectors it
//     stays under the 256 vertex uniform vectors GLES3 guarantees.
//   - The shader sources passed to `createShader(vsrc, fsrc)` must be
//     a GLES vertex + fragment pair (NOT the Metal MSL combined source
//     the Metal backend takes — caller branches on OS).

@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/build.sx";
@import "modules/ffi/opengl.sx";
@import "modules/gpu/types.sx";
@import "modules/gpu/api.sx";

// EGL bootstrap helper — used to populate opengl.sx's fn pointers once
// the EGL context is current. We declare only the loader here; EGL
// surface/context creation belongs in the consumer's `main = true`
// Activity (e.g. an `onCreate` body that calls `eglCreateContext`).
eglGetProcAddress :: (name: cstring) -> *void abi(.c) extern;


// ── State + resource tables ────────────────────────────────────────────

Gles3TextureSlot :: struct {
    tex: u32 = 0;
    bytesPerPixel: u32 = 0;
}

Gles3ShaderSlot :: struct {
    program: u32 = 0;
    projLoc: i32 = 0 - 1;
    texLoc:  i32 = 0 - 1;
    tintLoc: i32 = 0 - 1;
    bonesLoc: i32 = 0 - 1;
}

Gles3Gpu :: struct {
    pixelW: i32 = 0;
    pixelH: i32 = 0;

    // The renderer's vertex layout is fixed (see file header). One VAO,
    // reused across every setVertexBuffer.
    vao: u32 = 0;
    // MeshVertex layout for drawIndexed, kept apart from `vao` so the
    // two attribute configurations never overwrite each other.
    meshVao: u32 = 0;
    // SkinnedVertex layout for drawSkinned, apart from both so the
    // three attribute configurations never overwrite each other.
    skinVao: u32 = 0;

    currentShader: u32 = 0;
    currentVbo: u32 = 0;
    currentIbo: u32 = 0;
    depthMode: DepthMode = .disabled;
    glLoaded: bool = false;

    // Only the first `boneCount` matrices carry a live transform.
    bonePalette: [GPU_MAX_BONES]BoneMatrix = ---;
    boneCount: i32 = 0;

    shaders:  List(Gles3ShaderSlot)  = .{};
    buffers:  List(u32)              = .{};
    indices:  List(u32)              = .{};
    textures: List(Gles3TextureSlot) = .{};

    // Captured at init() time so resource creation always grows the cache
    // lists through the long-lived allocator, even when a caller (e.g.
    // glyph_cache atlas-grow during render) is currently inside a transient
    // arena context.
    parentAllocator: Allocator = ---;
}

// ── GPU impl ───────────────────────────────────────────────────────────

impl GPU for Gles3Gpu {
    // EGL is owned by AndroidPlatform; init() here populates the GL
    // function pointers (via opengl.sx's loadGl) and sets up the
    // single shared VAO. Must be called once the EGL context is
    // current (AndroidPlatform.runFrameLoop ensures this before
    // invoking the user's per-frame closure). `target` is unused.
    init :: (self: *Gles3Gpu, target: *void, pixelW: i32, pixelH: i32) -> bool {
        inline if @host.os != .android { return false; }
        self.pixelW = pixelW;
        self.pixelH = pixelH;
        self.parentAllocator = context.allocator;

        if !self.glLoaded {
            loadGl(eglGetProcAddress);
            self.glLoaded = true;
        }

        // Create the VAO. Attribute layout is deferred to setVertexBuffer
        // because `glVertexAttribPointer` captures the currently-bound
        // GL_ARRAY_BUFFER into the VAO state — we don't know which VBO
        // the renderer wants until it tells us via setVertexBuffer.
        glGenVertexArrays(1, *self.vao);
        glGenVertexArrays(1, *self.meshVao);
        glGenVertexArrays(1, *self.skinVao);

        glEnable(GL_BLEND);
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);

        true
    }

    shutdown :: (self: *Gles3Gpu) {
        // GLES objects clean up when the EGL context is destroyed (which
        // happens when the NativeActivity tears down).
    }

    resize :: (self: *Gles3Gpu, pixelW: i32, pixelH: i32) {
        self.pixelW = pixelW;
        self.pixelH = pixelH;
    }

    // The render-target setup (eglMakeCurrent + glViewport) lives in
    // AndroidPlatform.runFrameLoop; beginFrame here just clears the
    // active framebuffer. Returns true so callers don't bail out.
    beginFrame :: (self: *Gles3Gpu, clear: ClearColor) -> bool {
        inline if @host.os != .android { return false; }
        glViewport(0, 0, self.pixelW, self.pixelH);
        glClearColor(clear.r, clear.g, clear.b, clear.a);
        // glClear honours the depth write mask, so the mask must be open
        // for the clear even when the mode leaves it closed for draws.
        glDepthMask(GL_TRUE);
        glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
        gles3ApplyDepthMode(self);
        true
    }

    // eglSwapBuffers happens in AndroidPlatform.endFrame; nothing for us.
    endFrame :: (self: *Gles3Gpu, targetTime: f64) { }

    // ── Resources ────────────────────────────────────────────────────────

    createShader :: (self: *Gles3Gpu, vsrc: string, fsrc: string) -> ShaderHandle {
        inline if @host.os != .android { return 0; }

        prog := createProgram(vsrc, fsrc);
        if prog == 0 { return 0; }
        slot : Gles3ShaderSlot = .{
            program = prog,
            projLoc = glGetUniformLocation(prog, "uProj".ptr),
            texLoc  = glGetUniformLocation(prog, "uTex".ptr),
            tintLoc = glGetUniformLocation(prog, "uTint".ptr),
            bonesLoc = glGetUniformLocation(prog, "uBones".ptr),
        };
        self.shaders.append(slot, self.parentAllocator);
        self.shaders.len
    }

    createBuffer :: (self: *Gles3Gpu, sizeBytes: i64) -> BufferHandle {
        inline if @host.os != .android { return 0; }
        if sizeBytes <= 0 { return 0; }
        b : u32 = 0;
        glGenBuffers(1, *b);
        glBindBuffer(GL_ARRAY_BUFFER, b);
        glBufferData(GL_ARRAY_BUFFER, sizeBytes, null, GL_DYNAMIC_DRAW);
        self.buffers.append(b, self.parentAllocator);
        self.buffers.len
    }

    createIndexBuffer :: (self: *Gles3Gpu, sizeBytes: i64) -> IndexHandle {
        inline if @host.os != .android { return 0; }
        if sizeBytes <= 0 { return 0; }
        b : u32 = 0;
        glGenBuffers(1, *b);
        // The GL_ELEMENT_ARRAY_BUFFER binding is VAO state; scope every
        // element-buffer touch to meshVao so `vao` keeps its own.
        glBindVertexArray(self.meshVao);
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, b);
        glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeBytes, null, GL_DYNAMIC_DRAW);
        self.indices.append(b, self.parentAllocator);
        self.indices.len
    }

    updateIndexBuffer :: (self: *Gles3Gpu, handle: IndexHandle, data: *void, sizeBytes: i64) {
        inline if @host.os != .android { return; }
        buf := gles3LookupIndex(self, handle);
        if buf == 0 { return; }
        if data == null { return; }
        if sizeBytes <= 0 { return; }
        glBindVertexArray(self.meshVao);
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, buf);
        glBufferSubData(GL_ELEMENT_ARRAY_BUFFER, 0, sizeBytes, data);
    }

    updateBuffer :: (self: *Gles3Gpu, handle: BufferHandle, data: *void, sizeBytes: i64) {
        inline if @host.os != .android { return; }
        buf := gles3LookupBuffer(self, handle);
        if buf == 0 { return; }
        if data == null { return; }
        if sizeBytes <= 0 { return; }
        glBindBuffer(GL_ARRAY_BUFFER, buf);
        glBufferSubData(GL_ARRAY_BUFFER, 0, sizeBytes, data);
    }

    updateBufferAt :: (self: *Gles3Gpu, handle: BufferHandle, data: *void, sizeBytes: i64, byteOffset: i64) {
        inline if @host.os != .android { return; }
        buf := gles3LookupBuffer(self, handle);
        if buf == 0 { return; }
        if data == null { return; }
        if sizeBytes <= 0 { return; }
        if byteOffset < 0 { return; }
        glBindBuffer(GL_ARRAY_BUFFER, buf);
        glBufferSubData(GL_ARRAY_BUFFER, byteOffset, sizeBytes, data);
    }

    createTexture :: (self: *Gles3Gpu, w: i32, h: i32, format: TextureFormat, pixels: *void) -> TextureHandle {
        inline if @host.os != .android { return 0; }
        if w <= 0 { return 0; }
        if h <= 0 { return 0; }

        internalFmt : i32 = 0;
        extFmt : u32 = 0;
        bpp : u32 = 0;
        if format == .rgba8 {
            internalFmt = GL_RGBA;
            extFmt = GL_RGBA;
            bpp = 4;
        } else {
            internalFmt = GL_R8;
            extFmt = GL_RED;
            bpp = 1;
        }

        t : u32 = 0;
        glGenTextures(1, *t);
        glBindTexture(GL_TEXTURE_2D, t);
        glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
        glTexImage2D(GL_TEXTURE_2D, 0, internalFmt, w, h, 0, extFmt, GL_UNSIGNED_BYTE, pixels);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);

        slot : Gles3TextureSlot = .{ tex = t, bytesPerPixel = bpp };
        self.textures.append(slot, self.parentAllocator);
        self.textures.len
    }

    updateTextureRegion :: (self: *Gles3Gpu, handle: TextureHandle, x: i32, y: i32, w: i32, h: i32, pixels: *void) {
        inline if @host.os != .android { return; }
        if handle == 0 { return; }
        h64 : i64 = handle.(i64);
        if h64 > self.textures.len { return; }
        slot := self.textures.items[handle - 1];
        if slot.tex == 0 { return; }
        if pixels == null { return; }
        if w <= 0 { return; }
        if h <= 0 { return; }
        extFmt : u32 = if slot.bytesPerPixel == 4 then GL_RGBA else GL_RED;
        glBindTexture(GL_TEXTURE_2D, slot.tex);
        glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
        glTexSubImage2D(GL_TEXTURE_2D, 0, x, y, w, h, extFmt, GL_UNSIGNED_BYTE, pixels);
    }

    // A no-op on Android: opengl.sx's loader carries no glDeleteProgram,
    // and programs free on EGL context teardown.
    destroyShader  :: (self: *Gles3Gpu, sh:  ShaderHandle) { }

    destroyBuffer  :: (self: *Gles3Gpu, handle: BufferHandle) {
        inline if @host.os != .android { return; }
        buf := gles3LookupBuffer(self, handle);
        if buf == 0 { return; }
        if self.currentVbo == buf { self.currentVbo = 0; }
        glDeleteBuffers(1, *buf);
        self.buffers.items[handle - 1] = 0;
    }

    destroyIndexBuffer :: (self: *Gles3Gpu, handle: IndexHandle) {
        inline if @host.os != .android { return; }
        buf := gles3LookupIndex(self, handle);
        if buf == 0 { return; }
        if self.currentIbo == buf { self.currentIbo = 0; }
        glDeleteBuffers(1, *buf);
        self.indices.items[handle - 1] = 0;
    }

    destroyTexture :: (self: *Gles3Gpu, tex: TextureHandle) {
        inline if @host.os != .android { return; }
        if tex == 0 { return; }
        h64 : i64 = tex.(i64);
        if h64 > self.textures.len { return; }
        t := self.textures.items[tex - 1].tex;
        if t == 0 { return; }
        glDeleteTextures(1, *t);
        self.textures.items[tex - 1].tex = 0;
    }

    // ── Per-draw state ───────────────────────────────────────────────────

    setShader :: (self: *Gles3Gpu, handle: ShaderHandle) {
        inline if @host.os != .android { return; }
        if handle == 0 { return; }
        h64 : i64 = handle.(i64);
        if h64 > self.shaders.len { return; }
        prog := self.shaders.items[handle - 1].program;
        if prog == 0 { return; }
        glUseProgram(prog);
        self.currentShader = handle;
    }

    setVertexBuffer :: (self: *Gles3Gpu, handle: BufferHandle) {
        inline if @host.os != .android { return; }
        buf := gles3LookupBuffer(self, handle);
        if buf == 0 { return; }
        self.currentVbo = buf;
        glBindVertexArray(self.vao);
        glBindBuffer(GL_ARRAY_BUFFER, buf);
        // glVertexAttribPointer captures the currently-bound
        // GL_ARRAY_BUFFER into the VAO state. Reconfigure each frame
        // so the VAO knows about the live buffer; otherwise drawing
        // sources attribs from the zero-buffer (invisible geometry).
        glVertexAttribPointer(0, 2, GL_FLOAT, 0, 64, (0).(*void));
        glEnableVertexAttribArray(0);
        glVertexAttribPointer(1, 2, GL_FLOAT, 0, 64, (8).(*void));
        glEnableVertexAttribArray(1);
        glVertexAttribPointer(2, 4, GL_FLOAT, 0, 64, (16).(*void));
        glEnableVertexAttribArray(2);
        glVertexAttribPointer(3, 4, GL_FLOAT, 0, 64, (32).(*void));
        glEnableVertexAttribArray(3);
        glVertexAttribPointer(4, 4, GL_FLOAT, 0, 64, (48).(*void));
        glEnableVertexAttribArray(4);
    }

    setIndexBuffer :: (self: *Gles3Gpu, handle: IndexHandle) {
        inline if @host.os != .android { return; }
        self.currentIbo = gles3LookupIndex(self, handle);
    }

    setTexture :: (self: *Gles3Gpu, slot: u32, handle: TextureHandle) {
        inline if @host.os != .android { return; }
        if slot != 0 { return; } // renderer only uses unit 0
        if handle == 0 { return; }
        h64 : i64 = handle.(i64);
        if h64 > self.textures.len { return; }
        t := self.textures.items[handle - 1].tex;
        if t == 0 { return; }
        glActiveTexture(GL_TEXTURE0);
        glBindTexture(GL_TEXTURE_2D, t);
        if self.currentShader != 0 {
            cs64 : i64 = self.currentShader.(i64);
            if cs64 <= self.shaders.len {
                loc := self.shaders.items[self.currentShader - 1].texLoc;
                if loc >= 0 { glUniform1i(loc, 0); }
            }
        }
    }

    // Slot 1 + 64 bytes is the 4x4 projection matrix into `uniform mat4
    // uProj`; slot 2 + 16 bytes is the mesh tint into `uniform vec4 uTint`.
    // Look up via the current shader's cached uniform locations.
    setVertexConstants :: (self: *Gles3Gpu, slot: u32, data: *void, sizeBytes: i64) {
        inline if @host.os != .android { return; }
        if self.currentShader == 0 { return; }
        cs64 : i64 = self.currentShader.(i64);
        if cs64 > self.shaders.len { return; }
        shader := *self.shaders.items[self.currentShader - 1];

        if slot == 1 and sizeBytes == 64 {
            if shader.projLoc < 0 { return; }
            glUniformMatrix4fv(shader.projLoc, 1, 0, data);
        } else if slot == 2 and sizeBytes == 16 {
            if shader.tintLoc < 0 { return; }
            glUniform4fv(shader.tintLoc, 1, data);
        }
    }

    setScissor :: (self: *Gles3Gpu, x: i32, y: i32, w: i32, h: i32) {
        inline if @host.os != .android { return; }
        glEnable(GL_SCISSOR_TEST);
        glScissor(x, self.pixelH - (y + h), w, h);
    }

    disableScissor :: (self: *Gles3Gpu) {
        inline if @host.os != .android { return; }
        glDisable(GL_SCISSOR_TEST);
    }

    setDepthMode :: (self: *Gles3Gpu, mode: DepthMode) {
        inline if @host.os != .android { return; }
        self.depthMode = mode;
        gles3ApplyDepthMode(self);
    }

    setBonePalette :: (self: *Gles3Gpu, data: *void, count: i32) {
        inline if @host.os != .android { return; }
        if data == null { return; }
        if count < 0 { return; }
        if count > GPU_MAX_BONES { return; }
        n : i64 = count.(i64);
        c.memcpy(*self.bonePalette[0], data, n * @sizeOf(BoneMatrix));
        self.boneCount = count;
    }

    drawTriangles :: (self: *Gles3Gpu, vertexOffset: i32, vertexCount: i32) {
        inline if @host.os != .android { return; }
        if vertexCount <= 0 { return; }
        glBindVertexArray(self.vao);
        glDrawArrays(GL_TRIANGLES, vertexOffset, vertexCount);
    }

    drawIndexed :: (self: *Gles3Gpu, indexOffset: i32, indexCount: i32) {
        inline if @host.os != .android { return; }
        if indexCount <= 0 { return; }
        if indexOffset < 0 { return; }
        if self.currentVbo == 0 { return; }
        if self.currentIbo == 0 { return; }

        glBindVertexArray(self.meshVao);
        glBindBuffer(GL_ARRAY_BUFFER, self.currentVbo);
        // MeshVertex: position at 0, normal at 12, uv at 24, stride 32.
        glVertexAttribPointer(0, 3, GL_FLOAT, 0, 32, (0).(*void));
        glEnableVertexAttribArray(0);
        glVertexAttribPointer(1, 3, GL_FLOAT, 0, 32, (12).(*void));
        glEnableVertexAttribArray(1);
        glVertexAttribPointer(2, 2, GL_FLOAT, 0, 32, (24).(*void));
        glEnableVertexAttribArray(2);
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, self.currentIbo);

        byteOffset : i64 = (indexOffset * 4).(i64);
        glDrawElements(GL_TRIANGLES, indexCount, GL_UNSIGNED_INT, byteOffset.(*void));
    }

    drawSkinned :: (self: *Gles3Gpu, indexOffset: i32, indexCount: i32) {
        inline if @host.os != .android { return; }
        if indexCount <= 0 { return; }
        if indexOffset < 0 { return; }
        if self.boneCount <= 0 { return; }
        if self.currentVbo == 0 { return; }
        if self.currentIbo == 0 { return; }

        glBindVertexArray(self.skinVao);
        glBindBuffer(GL_ARRAY_BUFFER, self.currentVbo);
        // SkinnedVertex: position at 0, normal at 12, uv at 24, joints at
        // 32, weights at 48, stride 64.
        glVertexAttribPointer(0, 3, GL_FLOAT, 0, 64, (0).(*void));
        glEnableVertexAttribArray(0);
        glVertexAttribPointer(1, 3, GL_FLOAT, 0, 64, (12).(*void));
        glEnableVertexAttribArray(1);
        glVertexAttribPointer(2, 2, GL_FLOAT, 0, 64, (24).(*void));
        glEnableVertexAttribArray(2);
        glVertexAttribPointer(3, 4, GL_FLOAT, 0, 64, (32).(*void));
        glEnableVertexAttribArray(3);
        glVertexAttribPointer(4, 4, GL_FLOAT, 0, 64, (48).(*void));
        glEnableVertexAttribArray(4);
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, self.currentIbo);

        bonesLoc := gles3BonesLoc(self);
        if bonesLoc >= 0 {
            glUniform4fv(bonesLoc, 3 * self.boneCount, *self.bonePalette[0]);
        }

        byteOffset : i64 = (indexOffset * 4).(i64);
        glDrawElements(GL_TRIANGLES, indexCount, GL_UNSIGNED_INT, byteOffset.(*void));
    }
}

gles3ApplyDepthMode :: (self: *Gles3Gpu) {
    inline if @host.os != .android { return; }
    if self.depthMode == .disabled {
        glDisable(GL_DEPTH_TEST);
        glDepthMask(GL_FALSE);
        return;
    }
    glEnable(GL_DEPTH_TEST);
    glDepthMask(GL_TRUE);
    if self.depthMode == .less {
        glDepthFunc(GL_LESS);
    } else {
        glDepthFunc(GL_LEQUAL);
    }
}

gles3BonesLoc :: (self: *Gles3Gpu) -> i32 {
    inline if @host.os != .android { return 0 - 1; }
    if self.currentShader == 0 { return 0 - 1; }
    cs64 : i64 = self.currentShader.(i64);
    if cs64 > self.shaders.len { return 0 - 1; }
    self.shaders.items[self.currentShader - 1].bonesLoc
}

gles3LookupBuffer :: (self: *Gles3Gpu, handle: u32) -> u32 {
    inline if @host.os != .android { return 0; }
    if handle == 0 { return 0; }
    h64 : i64 = handle.(i64);
    if h64 > self.buffers.len { return 0; }
    self.buffers.items[handle - 1]
}

gles3LookupIndex :: (self: *Gles3Gpu, handle: u32) -> u32 {
    inline if @host.os != .android { return 0; }
    if handle == 0 { return 0; }
    h64 : i64 = handle.(i64);
    if h64 > self.indices.len { return 0; }
    self.indices.items[handle - 1]
}
