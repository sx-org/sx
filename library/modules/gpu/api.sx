@import "modules/std.sx";
@import "modules/gpu/types.sx";

// GPU is the rendering-API abstraction. Concrete backends live as
// siblings of this file, one per rendering API; the consumer picks one
// at its own platform seam.

// A GPU backend is a named long-lived singleton owning a device and a
// context, reached through concrete handles alongside the erased one — a
// handle borrows the named object's storage, never copies it (same class as
// Platform/Allocator/Io).
GPU :: interface {
    // Bind the GPU to a backend-specific render target. pixelW/pixelH
    // are the drawable's pixel dimensions; call resize when they change.
    init :: (self: *Self, target: *void, pixelW: i32, pixelH: i32) -> bool;
    shutdown :: (self: *Self);

    resize :: (self: *Self, pixelW: i32, pixelH: i32);

    beginFrame :: (self: *Self, clear: ClearColor) -> bool;

    // targetTime is the host clock time at which the drawable should be
    // presented, in the units the platform's display-link callback
    // reports; zero means present as soon as possible. Backends that can
    // schedule presentation use it to cap the pipeline at one frame so a
    // frame lands on the same vsync as the host's own compositing; the
    // rest ignore it.
    endFrame :: (self: *Self, targetTime: f64);

    createShader :: (self: *Self, vsrc: string, fsrc: string) -> ShaderHandle;
    createBuffer :: (self: *Self, sizeBytes: i64) -> BufferHandle;
    createIndexBuffer :: (self: *Self, sizeBytes: i64) -> IndexHandle;
    updateIndexBuffer :: (self: *Self, buf: IndexHandle, data: *void, sizeBytes: i64);
    updateBuffer :: (self: *Self, buf: BufferHandle, data: *void, sizeBytes: i64);
    // Sub-buffer write at a byte offset. A backend may read buffer
    // contents when the GPU executes the draw rather than when the draw
    // is recorded, so re-using one slice across several draws in a frame
    // is a race the last writer wins: a renderer that issues more than
    // one draw per frame must advance its write offset between flushes.
    updateBufferAt :: (self: *Self, buf: BufferHandle, data: *void, sizeBytes: i64, byteOffset: i64);
    createTexture :: (self: *Self, w: i32, h: i32, format: TextureFormat, pixels: *void) -> TextureHandle;
    updateTextureRegion :: (self: *Self, tex: TextureHandle, x: i32, y: i32, w: i32, h: i32, pixels: *void);

    // Release a GPU resource. Implementations release the backing object and
    // null the slot so the handle becomes inert. Calling with handle 0 or
    // an already-destroyed handle is a no-op. Handles are not re-used; the
    // backing List entry stays at its index with a null sentinel.
    destroyShader :: (self: *Self, sh: ShaderHandle);
    destroyBuffer :: (self: *Self, buf: BufferHandle);
    destroyIndexBuffer :: (self: *Self, buf: IndexHandle);
    destroyTexture :: (self: *Self, tex: TextureHandle);

    setShader :: (self: *Self, sh: ShaderHandle);
    setVertexBuffer :: (self: *Self, buf: BufferHandle);
    setIndexBuffer :: (self: *Self, buf: IndexHandle);
    setTexture :: (self: *Self, slot: u32, tex: TextureHandle);
    setVertexConstants :: (self: *Self, slot: u32, data: *void, sizeBytes: i64);
    setScissor :: (self: *Self, x: i32, y: i32, w: i32, h: i32);
    disableScissor :: (self: *Self);

    // Sticky across frames — the mode holds until changed, including
    // over beginFrame, which clears the depth buffer to the far plane
    // alongside the color clear.
    setDepthMode :: (self: *Self, mode: DepthMode);

    // Copy `count` BoneMatrix out of `data` into the backend's palette;
    // every later drawSkinned pushes that copy. Sticky like
    // setDepthMode: the palette holds across shader changes and over
    // frame boundaries. A null pointer, or a count outside
    // [0, GPU_MAX_BONES], leaves the palette unchanged. The palette
    // occupies vertex-constant slot 8, so setVertexConstants must not
    // use that slot.
    setBonePalette :: (self: *Self, data: *void, count: i32);

    // Vertices are the 2D renderer layout (64 bytes), not MeshVertex.
    drawTriangles :: (self: *Self, vertexOffset: i32, vertexCount: i32);

    // Triangles over the bound index buffer, u32 indices, sourcing
    // MeshVertex-stride vertices from the bound vertex buffer.
    // indexOffset counts indices, not bytes.
    drawIndexed :: (self: *Self, indexOffset: i32, indexCount: i32);

    // Triangles over the bound index buffer, u32 indices, sourcing
    // SkinnedVertex-stride vertices from the bound vertex buffer and
    // skinning them in the vertex stage against the current bone
    // palette. indexOffset counts indices, not bytes. An empty palette
    // issues no draw.
    drawSkinned :: (self: *Self, indexOffset: i32, indexCount: i32);
}
