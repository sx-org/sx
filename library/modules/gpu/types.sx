#import "modules/std.sx";

// Opaque GPU resource handles. Each backend decides what the integer
// means. Zero is reserved for "no handle".
ShaderHandle  :: u32;
BufferHandle  :: u32;
IndexHandle   :: u32;
TextureHandle :: u32;

ClearColor :: struct {
    r: f32;
    g: f32;
    b: f32;
    a: f32;

    black :: () -> ClearColor => .{ r = 0.0, g = 0.0, b = 0.0, a = 1.0 };
}

// Texture pixel format. The UI renderer only needs rgba8 (images, the
// 1×1 white solid-rect texture) and r8 (font glyph atlas alpha).
TextureFormat :: enum {
    rgba8;
    r8;
}

// Vertex layout of the 3D draw path (`draw_indexed`), 32 bytes. Byte
// offsets 0 / 12 / 24 are the attribute slots backends bind.
MeshVertex :: struct {
    position: [3]f32;
    normal:   [3]f32;
    uv:       [2]f32;
}

// Depth test applied by `draw_indexed`. `disabled` also stops depth
// writes, so a 2D pass leaves the depth buffer untouched.
DepthMode :: enum {
    disabled;
    less;
    lequal;
}
