// `List` (for the default build script) + the compiler-API build primitives
// (`@emitObject`/`@link`/`@cObjectPaths`/…). The std↔build import cycle (std's
// tail imports cli.sx which imports this file) is handled by the resolver.
@import "modules/std.sx";
@import "modules/compiler.sx";
// The sx-side `.app`/`.apk` bundler. `defaultPipeline` delegates to its
// `bundleMain` when a bundle was requested. The bundler is compile-time-only
// (comptime-only, never emitted into the binary), and the build↔bundle import
// cycle resolves like the std↔build one.
@import "modules/platform/bundle.sx";
// The target facts — `@host` + the OperatingSystem / Architecture enums — live
// in a dependency-free module (std/target.sx) so low-level code can name the
// enum TYPES without the build/std baggage. build.sx imports it (flat) so
// those decls stay registered in the standard import graph (build.sx is
// reachable from std.sx — dropping the import would shift every std program's
// type table). This is NOT a re-export: flat import only splices the names into
// build.sx's own scope, never into build.sx's importers. Consumers need no
// import anyway — the compiler resolves a `@host` field read by name (for both
// `inline if` and value reads); a module that names OperatingSystem /
// Architecture imports std/target.sx directly.
@import "modules/std/target.sx";

// A directory of runtime assets bundled alongside the binary: `src` on disk
// (relative to the CWD at build time), `dest` inside the bundle / APK.
AssetDir :: struct {
    src: string;
    dest: string;
}

// The build configuration. `@buildOptions()` hands out the one instance: the
// compiler keeps a snapshot of it between comptime evaluations, so a field
// written in `@run` is the field the build callback reads, and the fields the
// compiler fills in (`binaryPath`, `targetTriple`, the target lists) are set
// before the callback runs. Strings are `""` when unset. The field order is
// the compiler's contract (`contracts.zig`).
@BuildOptions :: struct {
    linkFlags: List(string);
    frameworks: List(string);
    assetDirs: List(AssetDir);
    outputPath: string;
    wasmShell: string;
    // Path of the freshly-linked binary, `""` before linking.
    binaryPath: string;
    // Apple `.app` / Android `.apk` bundling. macOS bundling needs `bundlePath`
    // and `bundleId`; codesign / provisioning are iOS-device-only.
    bundlePath: string;
    bundleId: string;
    codesignIdentity: string;
    provisioningProfile: string;
    // The canonicalized target triple, `""` before linking.
    targetTriple: string;
    // Linker `-framework` names and `-F` search paths, CLI and `@run` merged;
    // the bundler copies each `<Name>.framework` it finds into `<bundle>/Frameworks/`.
    targetFrameworks: List(string);
    targetFrameworkPaths: List(string);
    // Android: `manifestPath` overrides the synthesized AndroidManifest.xml,
    // `keystorePath` the default `$HOME/.android/debug.keystore`.
    manifestPath: string;
    keystorePath: string;
    // `@JniClass("path") { ... }` decls collected during lowering, by runtime
    // path with the rendered Java source alongside.
    jniMainRuntimePaths: List(string);
    jniMainJavaSources: List(string);

    addLinkFlag :: (self: *@BuildOptions, flag: string) { self.linkFlags.append(flag); }
    addFramework :: (self: *@BuildOptions, name: string) { self.frameworks.append(name); }
    addAssetDir :: (self: *@BuildOptions, src: string, dest: string) {
        self.assetDirs.append(AssetDir{ src = src, dest = dest });
    }

    isIos :: (self: *@BuildOptions) -> bool { tripleHas(self.targetTriple, "apple-ios") }
    isMacos :: (self: *@BuildOptions) -> bool {
        if self.isIos() { return false; }
        return tripleHas(self.targetTriple, "apple-macosx") or tripleHas(self.targetTriple, "apple-macos") or tripleHas(self.targetTriple, "apple-darwin");
    }
    isIosDevice :: (self: *@BuildOptions) -> bool { self.isIos() and !tripleHas(self.targetTriple, "simulator") }
    isIosSimulator :: (self: *@BuildOptions) -> bool { self.isIos() and tripleHas(self.targetTriple, "simulator") }
    isAndroid :: (self: *@BuildOptions) -> bool { tripleHas(self.targetTriple, "android") }
}

tripleHas :: (triple: string, needle: string) -> bool {
    if needle.len > triple.len { return false; }
    i : i64 = 0;
    while i + needle.len <= triple.len {
        k : i64 = 0;
        while k < needle.len and triple[i + k] == needle[k] { k += 1; }
        if k == needle.len { return true; }
        i += 1;
    }
    return false;
}

@buildOptions :: () -> *@BuildOptions;

// The build callback registrar. Registers the sx function that drives
// the build — the compiler invokes it after codegen with the `@BuildOptions`
// handle. `@run @onBuild(build);` (from inside a `@run` block) is the override
// form, where `build :: (opt: *@BuildOptions) -> bool { … }`; the
// last registration wins. With no override the compiler auto-invokes the stdlib
// `defaultPipeline` (below). This is the sole post-build callback mechanism.
@onBuild :: (cb: (opt: *@BuildOptions) -> bool);

// ── The default build script ────────────────────────────────────────────────
//
// `emitAndLink` is the build CORE: emit the sx object, gather the C companion
// objects, and link them into the output with the build's libraries / frameworks /
// flags / target. Shared by `defaultPipeline` AND `platform.bundle.bundleMain`
// (which wraps it with the per-target `.app` / `.apk` bundling) so a bundler
// override doesn't re-implement emit+link.
emitAndLink :: (opt: *@BuildOptions) -> bool {
    obj := @emitObject();
    objs := @cObjectPaths();
    objs.append(obj);
    @link(objs, opt.outputPath, @linkLibraries(), opt.targetFrameworks, @buildFlags(), opt.targetTriple);
    return true;
}

// `defaultPipeline` is the stdlib build driver: the compiler invokes it after
// codegen (everything is sx-driven — there is no auto-emit/auto-link). It emits +
// links the program via `emitAndLink`. A user overrides the whole pipeline with
// their own `@run @onBuild(custom);` in main.sx (last-wins) — e.g. bundling is
// `@import "modules/platform/bundle.sx"; @run @onBuild(bundleMain);`, where
// `bundleMain` runs `emitAndLink` then wraps the binary into a `.app` / `.apk`.
// The compiler FORCE-LOWERS this well-known name and auto-invokes it after codegen
// when no `@onBuild` override was registered (no library `@run` needed).
//
// When a bundle was requested (`--bundle`/`--apk` or `bundlePath`), delegate
// to the per-target bundler (`bundleMain` runs the emit+link core then wraps the
// `.app`/`.apk`); otherwise just emit + link.
defaultPipeline :: (opt: *@BuildOptions) -> bool {
    if opt.bundlePath.len > 0 {
        return bundleMain(opt);
    }
    return emitAndLink(opt);
}
