// Fluent emitter product module (design user guide section 5).
// Self-contained: protocol, sample row types, sink, and emit entry points.
// Apps can implement EmitCell for their own types in this module's style, or
// call emit with the provided EmitText / EmitMark rows.
#import "modules/std.sx";
#import "modules/fluent.sx";

EmitCell :: protocol constraint {
    emit_label :: (self: *Self) -> string;
}

EmitText :: struct { body: string = ""; }
impl EmitCell for EmitText {
    emit_label :: (self: *EmitText) -> string => self.body;
}

EmitMark :: struct { tag: string = "*"; }
impl EmitCell for EmitMark {
    emit_label :: (self: *EmitMark) -> string => self.tag;
}

EmitSink :: struct {
    count: i32 = 0;
    last_label: string = "";

    expression :: (self: *EmitSink, site: BuildSite, value: @Init($V/EmitCell)) {
        dest := context.allocator.create(V);
        value.write(dest);
        self.last_label = dest.emit_label();
        self.count += 1;
        context.allocator.destroy(dest);
        _ := site;
    }
}

emit_into :: (sink: *EmitSink, content: @BuildBlock(EmitCell)) {
    content.run(sink);
}

emit :: (content: @BuildBlock(EmitCell)) -> i32 {
    sink := EmitSink{};
    content.run(*sink);
    sink.count
}
