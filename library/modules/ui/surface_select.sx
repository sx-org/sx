// Select-at-bind for the PixelSurface contract.
// macOS renders through the Metal
// offscreen backend (the platform's normative default — windowless, no
// WindowServer); other desktops go GL over a hidden SDL window.
// References stay per-machine either way. Returns null where no display/GPU
// exists — the caller's graceful skip, which is what keeps the wider test
// suite host-agnostic.
@import "modules/std.sx";
@import "modules/ui/font.sx";
@import "modules/ui/surface.sx";
@import "modules/gpu/offscreen_gl.sx";
@import "modules/gpu/offscreen_metal.sx";

open_pixel_surface :: (w: i32, h: i32) -> ?PixelSurface {
    inline if @host.os == .macos {
        g := context.allocator.make(MetalOffscreen{});
        if !g.open(w, h) { context.allocator.destroy(g); return null; }
        set_global_font(*g.font);
        return g.(PixelSurface);
    }
    inline if @host.os != .ios and @host.os != .macos {
        g := context.allocator.make(GlOffscreen{});
        if !g.open(w, h) { context.allocator.destroy(g); return null; }
        set_global_font(*g.font);
        return g.(PixelSurface);
    }
    null   // iOS: Metal offscreen rides the app host, not the test factory
}
