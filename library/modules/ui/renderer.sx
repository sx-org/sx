@import "modules/std.sx";
@import "modules/build.sx";
@import "modules/ffi/opengl.sx";
@import "modules/math";
@import "modules/gpu/types.sx";
@import "modules/gpu/api.sx";
@import "modules/ui/types.sx";
@import "modules/ui/render.sx";
@import "modules/ui/glyph_cache.sx";
@import "modules/ui/font.sx";

// Vertex: pos(2) + uv(2) + color(4) + params(4) + stroke(4) = 16 floats
UI_VERTEX_FLOATS :i64: 16;
UI_VERTEX_BYTES  :i64: 64;
MAX_UI_VERTICES  :i64: 16384;

UIRenderer :: struct {
    // GL-side handles. Used when `gpu == null`.
    vao: u32;
    vbo: u32;
    shader: u32;
    projLoc: i32;
    texLoc: i32;

    // CPU-side vertex scratch buffer — same for both backends.
    vertices: [*]f32;
    vertexCount: i64;
    screenWidth: f32;
    screenHeight: f32;
    dpiScale: f32;
    whiteTexture: u32;     // GL name OR TextureHandle (both are u32-shaped)
    currentTexture: u32;
    drawCalls: i64;

    // GPU protocol backend. When set, the renderer routes shader / buffer /
    // texture / draw calls through `gpu` instead of raw GL. The chess game
    // sets this on iOS to a boxed `*MetalGPU`.
    gpu: ?GPU = null;
    mtlShader: ShaderHandle = 0;
    mtlVbuf:   BufferHandle = 0;
    // Per-frame byte offset into the Metal vertex buffer. Each flush writes
    // to a fresh slice so concurrent in-flight draws don't trample each
    // other's data — Metal's shared-storage buffer is read at GPU execution
    // time, not at draw-call submission, so re-using offset 0 across flushes
    // would let the last writer win and earlier batches would render as
    // whatever was uploaded last. Reset to 0 in `begin()`.
    mtlBufOffset: i64 = 0;
    mtlBufCapacity: i64 = 0;

    // 3D mesh pass. One mesh is resident at a time (setMesh); render nodes
    // address triangle ranges of it. Requires `gpu`.
    meshShader: ShaderHandle = 0;
    meshVbuf:   BufferHandle = 0;
    meshIbuf:   IndexHandle = 0;
    meshIndexCount: i32 = 0;

    // Skinned 3D pass. Held apart from the rigid mesh because SkinnedVertex
    // is a 64-byte stride against MeshVertex's 32, so one buffer pair cannot
    // serve both. One skinned mesh is resident at a time (setSkinnedMesh);
    // `.skinnedMesh` render nodes address triangle ranges of it.
    skinShader: ShaderHandle = 0;
    skinVbuf:   BufferHandle = 0;
    skinIbuf:   IndexHandle = 0;
    skinIndexCount: i32 = 0;

    // Re-bound after every mesh range so the 2D batches that follow keep
    // drawing through the UI pipeline.
    uiProj: Mat4 = .{};

    init :: (self: *UIRenderer) {
        // Allocate vertex scratch (CPU side) — same for both backends.
        bufSize := MAX_UI_VERTICES * UI_VERTEX_BYTES;
        self.vertices = context.allocator.allocBytes(bufSize).([*]f32);
        c.memset(self.vertices, 0, bufSize);
        self.vertexCount = 0;
        self.dpiScale = 1.0;

        if self.gpu != null {
            // ── Metal backend (via GPU protocol) ───────────────────────
            // Oversize the GPU buffer enough to hold many sub-batches per
            // frame without wrapping. With per-flush offset advance, each
            // draw reads from its own slice and can outlive earlier in-
            // flight draws without corruption.
            metalBufSize := bufSize * 4;
            // Backend-specific shader sources: Metal takes a combined MSL
            // library with `vmain` + `fmain` entry points; GLES3 takes a
            // separate vertex / fragment pair. Caller selects via OS gate.
            inline if @host.os == .android {
                self.mtlShader = self.gpu.createShader(UI_VERT_SRC_ES, UI_FRAG_SRC_ES);
            }
            inline if @host.os == .ios or @host.os == .macos {
                self.mtlShader = self.gpu.createShader(UI_MSL_SRC, "");
            }
            self.mtlVbuf   = self.gpu.createBuffer(metalBufSize);
            self.mtlBufCapacity = metalBufSize;
            whitePx : [4]u8 = .[255, 255, 255, 255];
            self.whiteTexture = self.gpu.createTexture(1, 1, .rgba8, *whitePx[0]);
        } else {
            // ── GL backend ─────────────────────────────────────────────
            // Create shader (ES for WASM/WebGL2 + iOS GLES3, Core for desktop GL 3.3)
            inline if @host.os == .wasm or @host.os == .ios {
                self.shader = createProgram(UI_VERT_SRC_ES, UI_FRAG_SRC_ES);
            } else {
                self.shader = createProgram(UI_VERT_SRC_CORE, UI_FRAG_SRC_CORE);
            }
            self.projLoc = glGetUniformLocation(self.shader, "uProj");
            self.texLoc = glGetUniformLocation(self.shader, "uTex");

            // Create VAO/VBO
            glGenVertexArrays(1, *self.vao);
            glGenBuffers(1, *self.vbo);
            glBindVertexArray(self.vao);
            glBindBuffer(GL_ARRAY_BUFFER, self.vbo);
            glBufferData(GL_ARRAY_BUFFER, bufSize, null, GL_DYNAMIC_DRAW);

            // pos (2 floats)
            glVertexAttribPointer(0, 2, GL_FLOAT, 0, UI_VERTEX_BYTES, (0).(*void));
            glEnableVertexAttribArray(0);
            // uv (2 floats)
            glVertexAttribPointer(1, 2, GL_FLOAT, 0, UI_VERTEX_BYTES, (8).(*void));
            glEnableVertexAttribArray(1);
            // color (4 floats)
            glVertexAttribPointer(2, 4, GL_FLOAT, 0, UI_VERTEX_BYTES, (16).(*void));
            glEnableVertexAttribArray(2);
            // params: cornerRadius, borderWidth, rectW, rectH
            glVertexAttribPointer(3, 4, GL_FLOAT, 0, UI_VERTEX_BYTES, (32).(*void));
            glEnableVertexAttribArray(3);
            // stroke color (4 floats)
            glVertexAttribPointer(4, 4, GL_FLOAT, 0, UI_VERTEX_BYTES, (48).(*void));
            glEnableVertexAttribArray(4);

            glBindVertexArray(0);

            // 1x1 white texture for solid rects
            self.whiteTexture = createWhiteTexture();
        }
    }

    // Make `vertices` / `indices` the mesh that `.mesh` render nodes address,
    // replacing any earlier one. Indices are absolute into `vertices`, so a
    // node's range is `drawIndexed(indexFirst, indexCount)` verbatim.
    // False when there is no GPU backend to hold it.
    setMesh :: (self: *UIRenderer, vertices: []MeshVertex, indices: []u32) -> bool {
        if self.gpu == null { return false; }
        if vertices.len == 0 or indices.len == 0 { return false; }

        if self.meshShader == 0 {
            inline if @host.os == .android {
                self.meshShader = self.gpu.createShader(MESH_VERT_SRC_ES, MESH_FRAG_SRC_ES);
            }
            inline if @host.os == .ios or @host.os == .macos {
                self.meshShader = self.gpu.createShader(MESH_MSL_SRC, "");
            }
            if self.meshShader == 0 { return false; }
        }

        self.gpu.destroyBuffer(self.meshVbuf);
        self.gpu.destroyIndexBuffer(self.meshIbuf);
        self.meshIndexCount = 0;

        vbytes := vertices.len * @sizeOf(MeshVertex);
        ibytes := indices.len * 4;
        self.meshVbuf = self.gpu.createBuffer(vbytes);
        self.meshIbuf = self.gpu.createIndexBuffer(ibytes);
        if self.meshVbuf == 0 or self.meshIbuf == 0 { return false; }

        self.gpu.updateBuffer(self.meshVbuf, *vertices[0], vbytes);
        self.gpu.updateIndexBuffer(self.meshIbuf, *indices[0], ibytes);
        self.meshIndexCount = indices.len.(i32);
        true
    }

    // Make `vertices` / `indices` the skinned mesh that `.skinnedMesh`
    // render nodes address, replacing any earlier one. Indices are absolute
    // into `vertices`, so a node's range is `drawSkinned(indexFirst,
    // indexCount)` verbatim. False when there is no GPU backend to hold it.
    setSkinnedMesh :: (self: *UIRenderer, vertices: []SkinnedVertex, indices: []u32) -> bool {
        if self.gpu == null { return false; }
        if vertices.len == 0 or indices.len == 0 { return false; }

        if self.skinShader == 0 {
            inline if @host.os == .android {
                self.skinShader = self.gpu.createShader(SKINNED_VERT_SRC_ES, SKINNED_FRAG_SRC_ES);
            }
            inline if @host.os == .ios or @host.os == .macos {
                self.skinShader = self.gpu.createShader(SKINNED_MSL_SRC, "");
            }
            if self.skinShader == 0 { return false; }
        }

        self.gpu.destroyBuffer(self.skinVbuf);
        self.gpu.destroyIndexBuffer(self.skinIbuf);
        self.skinIndexCount = 0;

        vbytes := vertices.len * @sizeOf(SkinnedVertex);
        ibytes := indices.len * 4;
        self.skinVbuf = self.gpu.createBuffer(vbytes);
        self.skinIbuf = self.gpu.createIndexBuffer(ibytes);
        if self.skinVbuf == 0 or self.skinIbuf == 0 { return false; }

        self.gpu.updateBuffer(self.skinVbuf, *vertices[0], vbytes);
        self.gpu.updateIndexBuffer(self.skinIbuf, *indices[0], ibytes);
        self.skinIndexCount = indices.len.(i32);
        true
    }

    // The palette every later `.skinnedMesh` range skins against. Sticky in
    // the backend, so it holds across frames until replaced.
    setBonePalette :: (self: *UIRenderer, palette: []BoneMatrix) {
        if self.gpu == null { return; }
        if palette.len == 0 { return; }
        self.gpu.setBonePalette(*palette[0], palette.len.(i32));
    }

    begin :: (self: *UIRenderer, width: f32, height: f32, fontTexture: u32) {
        self.screenWidth = width;
        self.screenHeight = height;
        self.vertexCount = 0;
        self.currentTexture = fontTexture;
        self.drawCalls = 0;

        proj := Mat4.ortho(0.0, width, height, 0.0, -1.0, 1.0);
        self.uiProj = proj;

        if self.gpu != null {
            // Reset the per-frame ring offset; this frame's flushes start at 0.
            self.mtlBufOffset = 0;
            // Pipeline state + vertex buffer + projection + initial texture.
            // Metal blend mode + scissor-cleared defaults are baked into
            // the pipeline state, so no per-frame glEnable/glDisable.
            self.gpu.setShader(self.mtlShader);
            self.gpu.setVertexBuffer(self.mtlVbuf);
            self.gpu.setVertexConstants(1, *proj.data[0], 64);
            self.gpu.setTexture(0, fontTexture);
        } else {
            // GL: bind everything for the frame.
            glUseProgram(self.shader);
            glUniformMatrix4fv(self.projLoc, 1, 0, *proj.data[0]);
            glUniform1i(self.texLoc, 0);
            glActiveTexture(GL_TEXTURE0);
            glBindTexture(GL_TEXTURE_2D, fontTexture);
            glBindVertexArray(self.vao);
            glBindBuffer(GL_ARRAY_BUFFER, self.vbo);
            glEnable(GL_BLEND);
            glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        }
    }

    bindTexture :: (self: *UIRenderer, tex: u32) {
        if tex != self.currentTexture {
            self.flush();
            self.currentTexture = tex;
        }
    }

    // Emit a quad (2 triangles = 6 vertices)
    pushQuad :: (self: *UIRenderer, frame: Frame, color: Color, stroke: Color, radius: f32, borderW: f32) {
        if self.vertexCount + 6 > MAX_UI_VERTICES {
            self.flush();
        }

        x0 := frame.origin.x;
        y0 := frame.origin.y;
        x1 := x0 + frame.size.width;
        y1 := y0 + frame.size.height;

        w := frame.size.width;
        h := frame.size.height;

        // 6 vertices for quad: TL, TR, BL, TR, BR, BL
        self.writeVertex(x0, y0, 0.0, 0.0, color, stroke, radius, borderW, w, h);
        self.writeVertex(x1, y0, 1.0, 0.0, color, stroke, radius, borderW, w, h);
        self.writeVertex(x0, y1, 0.0, 1.0, color, stroke, radius, borderW, w, h);
        self.writeVertex(x1, y0, 1.0, 0.0, color, stroke, radius, borderW, w, h);
        self.writeVertex(x1, y1, 1.0, 1.0, color, stroke, radius, borderW, w, h);
        self.writeVertex(x0, y1, 0.0, 1.0, color, stroke, radius, borderW, w, h);
    }

    // Emit a quad with custom UV coordinates (for sprite sheet sub-textures)
    pushQuadUv :: (self: *UIRenderer, frame: Frame, color: Color, stroke: Color, radius: f32, borderW: f32, uvMin: Point, uvMax: Point) {
        if self.vertexCount + 6 > MAX_UI_VERTICES {
            self.flush();
        }

        x0 := frame.origin.x;
        y0 := frame.origin.y;
        x1 := x0 + frame.size.width;
        y1 := y0 + frame.size.height;

        w := frame.size.width;
        h := frame.size.height;

        uMin := uvMin.x;
        vMin := uvMin.y;
        uMax := uvMax.x;
        vMax := uvMax.y;

        self.writeVertex(x0, y0, uMin, vMin, color, stroke, radius, borderW, w, h);
        self.writeVertex(x1, y0, uMax, vMin, color, stroke, radius, borderW, w, h);
        self.writeVertex(x0, y1, uMin, vMax, color, stroke, radius, borderW, w, h);
        self.writeVertex(x1, y0, uMax, vMin, color, stroke, radius, borderW, w, h);
        self.writeVertex(x1, y1, uMax, vMax, color, stroke, radius, borderW, w, h);
        self.writeVertex(x0, y1, uMin, vMax, color, stroke, radius, borderW, w, h);
    }

    writeVertex :: (self: *UIRenderer, x: f32, y: f32, u: f32, v: f32, color: Color, stroke: Color, cr: f32, bw: f32, rw: f32, rh: f32) {
        off := self.vertexCount * UI_VERTEX_FLOATS;
        self.vertices[off + 0] = x;
        self.vertices[off + 1] = y;
        self.vertices[off + 2] = u;
        self.vertices[off + 3] = v;
        self.vertices[off + 4] = color.rf();
        self.vertices[off + 5] = color.gf();
        self.vertices[off + 6] = color.bf();
        self.vertices[off + 7] = color.af();
        self.vertices[off + 8] = cr;
        self.vertices[off + 9] = bw;
        self.vertices[off + 10] = rw;
        self.vertices[off + 11] = rh;
        self.vertices[off + 12] = stroke.rf();
        self.vertices[off + 13] = stroke.gf();
        self.vertices[off + 14] = stroke.bf();
        self.vertices[off + 15] = stroke.af();
        self.vertexCount += 1;
    }

    // Walk the render tree and emit quads
    process :: (self: *UIRenderer, tree: *RenderTree) {
        i := 0;
        while i < tree.nodes.len {
            node := tree.nodes.items[i];
            match node.type {
                case .rect: {
                    self.pushQuad(node.frame, node.fillColor, COLOR_TRANSPARENT, 0.0, 0.0);
                }
                case .roundedRect: {
                    self.pushQuad(node.frame, node.fillColor, node.strokeColor, node.cornerRadius, node.strokeWidth);
                }
                case .text: {
                    if gFont != null {
                        self.renderText(node);
                    }
                }
                case .image: {
                    self.bindTexture(node.textureId);
                    neg2 : f32 = 0.0 - 2.0;
                    self.pushQuadUv(node.frame, COLOR_WHITE, COLOR_TRANSPARENT, neg2, 0.0, node.uvMin, node.uvMax);
                    // Re-bind font atlas after image
                    font := gFont;
                    if font != null {
                        self.bindTexture(font.textureId);
                    }
                }
                case .mesh: {
                    self.drawMesh(node);
                }
                case .skinnedMesh: {
                    self.drawSkinnedMesh(node);
                }
                case .clipPush: {
                    self.flush();
                    dpi := self.dpiScale;
                    if self.gpu != null {
                        // Metal: pixel coords, top-left origin (no Y flip).
                        self.gpu.setScissor(
                            (node.frame.origin.x * dpi).(i32),
                            (node.frame.origin.y * dpi).(i32),
                            (node.frame.size.width * dpi).(i32),
                            (node.frame.size.height * dpi).(i32),
                        );
                    } else {
                        // GL: pixel coords, bottom-left origin — flip Y.
                        glEnable(GL_SCISSOR_TEST);
                        glScissor(
                            (node.frame.origin.x * dpi).(i32),
                            ((self.screenHeight - node.frame.origin.y - node.frame.size.height) * dpi).(i32),
                            (node.frame.size.width * dpi).(i32),
                            (node.frame.size.height * dpi).(i32)
                        );
                    }
                }
                case .clipPop: {
                    self.flush();
                    if self.gpu != null {
                        self.gpu.disableScissor();
                    } else {
                        glDisable(GL_SCISSOR_TEST);
                    }
                }
                case .opacityPush: {}
                case .opacityPop: {}
            }
            i += 1;
        }
    }

    flush :: (self: *UIRenderer) {
        if self.vertexCount == 0 { return; }

        uploadSize : i64 = self.vertexCount * UI_VERTEX_BYTES;

        if self.gpu != null {
            // Mirror the GL path: bind current texture before drawing.
            // currentTexture may have changed since the last flush.
            self.gpu.setTexture(0, self.currentTexture);

            // Write this batch to a fresh slice of the GPU buffer and draw
            // it from there. Re-using offset 0 would race against earlier
            // still-in-flight draws (see `mtlBufOffset` comment in the
            // struct).
            if self.mtlBufOffset + uploadSize > self.mtlBufCapacity {
                // Frame overflowed the GPU buffer; wrap to 0. Previous in-
                // flight batches from this frame will likely render wrong,
                // but the alternative (skipping the draw) would render
                // even less. Practical UIs should never hit this.
                self.mtlBufOffset = 0;
            }
            byteOff := self.mtlBufOffset;
            self.gpu.updateBufferAt(self.mtlVbuf, self.vertices, uploadSize, byteOff);
            vertexOff : i32 = (byteOff / UI_VERTEX_BYTES).(i32);
            self.gpu.drawTriangles(vertexOff, self.vertexCount.(i32));
            // Each batch starts on a vertex boundary so `vertexOff =
            // byteOff / UI_VERTEX_BYTES` lands on a whole vertex (otherwise
            // the shader reads partway through the previous vertex and the
            // text quads end up reading garbled UVs/colors). uploadSize is
            // already vertexCount × UI_VERTEX_BYTES so the running offset
            // stays vertex-aligned without an extra `% UI_VERTEX_BYTES` pad.
            self.mtlBufOffset = byteOff + uploadSize;
        } else {
            // Only re-bind the current texture (program, projection, VAO
            // already bound in begin()). glBufferData orphans the old buffer
            // to avoid GPU sync stalls.
            glBindTexture(GL_TEXTURE_2D, self.currentTexture);
            glBufferData(GL_ARRAY_BUFFER, uploadSize, self.vertices, GL_DYNAMIC_DRAW);
            glDrawArrays(GL_TRIANGLES, 0, self.vertexCount.(i32));
        }

        self.vertexCount = 0;
        self.drawCalls += 1;
    }

    drawMesh :: (self: *UIRenderer, node: RenderNode) {
        if self.gpu == null { return; }
        if self.meshShader == 0 { return; }
        if node.meshIndexCount <= 0 { return; }
        if node.meshIndexFirst < 0 { return; }
        if node.meshIndexFirst + node.meshIndexCount > self.meshIndexCount { return; }

        // The pending 2D batch belongs under the mesh in paint order, and the
        // pipeline swap below would otherwise draw it with the mesh shader.
        self.flush();

        col := node.fillColor;
        tint : [4]f32 = .[col.rf(), col.gf(), col.bf(), col.af() * node.opacity];
        mvp := node.meshTransform;

        self.gpu.setDepthMode(.less);
        self.gpu.setShader(self.meshShader);
        self.gpu.setVertexBuffer(self.meshVbuf);
        self.gpu.setIndexBuffer(self.meshIbuf);
        self.gpu.setVertexConstants(1, *mvp.data[0], 64);
        self.gpu.setVertexConstants(2, *tint[0], 16);
        self.gpu.drawIndexed(node.meshIndexFirst, node.meshIndexCount);
        self.drawCalls += 1;

        self.gpu.setDepthMode(.disabled);
        self.gpu.setShader(self.mtlShader);
        self.gpu.setVertexBuffer(self.mtlVbuf);
        self.gpu.setVertexConstants(1, *self.uiProj.data[0], 64);
        self.gpu.setTexture(0, self.currentTexture);
    }

    drawSkinnedMesh :: (self: *UIRenderer, node: RenderNode) {
        if self.gpu == null { return; }
        if self.skinShader == 0 { return; }
        if node.meshIndexCount <= 0 { return; }
        if node.meshIndexFirst < 0 { return; }
        if node.meshIndexFirst + node.meshIndexCount > self.skinIndexCount { return; }

        // The pending 2D batch belongs under the mesh in paint order, and the
        // pipeline swap below would otherwise draw it with the mesh shader.
        self.flush();

        col := node.fillColor;
        tint : [4]f32 = .[col.rf(), col.gf(), col.bf(), col.af() * node.opacity];
        mvp := node.meshTransform;

        self.gpu.setDepthMode(.less);
        self.gpu.setShader(self.skinShader);
        self.gpu.setVertexBuffer(self.skinVbuf);
        self.gpu.setIndexBuffer(self.skinIbuf);
        self.gpu.setVertexConstants(1, *mvp.data[0], 64);
        self.gpu.setVertexConstants(2, *tint[0], 16);
        self.gpu.drawSkinned(node.meshIndexFirst, node.meshIndexCount);
        self.drawCalls += 1;

        self.gpu.setDepthMode(.disabled);
        self.gpu.setShader(self.mtlShader);
        self.gpu.setVertexBuffer(self.mtlVbuf);
        self.gpu.setVertexConstants(1, *self.uiProj.data[0], 64);
        self.gpu.setTexture(0, self.currentTexture);
    }

    renderText :: (self: *UIRenderer, node: RenderNode) {
        font := gFont;
        if font == null { return; }

        // Shape text into positioned glyphs. This may rasterize new glyphs
        // AND grow the atlas, which creates a new GPU texture under
        // `font.textureId`. Re-bind the font atlas after shaping so the
        // upcoming text quads sample the texture that actually holds the
        // glyphs we just rasterized.
        font.shapeText(node.text, node.fontSize);

        // Flush any new glyphs to the atlas texture
        font.flush();

        // If the atlas grew (or otherwise changed handle), switch the
        // current texture so the next flush samples the right one.
        self.bindTexture(font.textureId);

        tc := node.textColor;
        ascent := font.getAscent(node.fontSize);
        rasterSize := node.fontSize * font.dpiScale;
        invDpi := font.invDpi;

        i : i64 = 0;
        while i < font.shapedBuf.len {
            shaped := font.shapedBuf.items[i];
            cached := font.getOrRasterize(shaped.glyphIndex, rasterSize);

            if cached != null {
                if cached.width > 0.0 {
                    // Scale physical pixel dimensions back to logical units
                    gx0 := node.frame.origin.x + shaped.x + cached.offsetX * invDpi;
                    gy0 := node.frame.origin.y + ascent + shaped.y + cached.offsetY * invDpi;
                    gx1 := gx0 + cached.width * invDpi;
                    gy1 := gy0 + cached.height * invDpi;

                    uMin := cached.uvX;
                    vMin := cached.uvY;
                    uMax := cached.uvX + cached.uvW;
                    vMax := cached.uvY + cached.uvH;


                    if self.vertexCount + 6 > MAX_UI_VERTICES {
                        self.flush();
                    }

                    // cornerRadius = -1.0 signals "text mode" to the fragment shader
                    neg1 : f32 = 0.0 - 1.0;
                    self.writeVertex(gx0, gy0, uMin, vMin, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.writeVertex(gx1, gy0, uMax, vMin, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.writeVertex(gx0, gy1, uMin, vMax, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.writeVertex(gx1, gy0, uMax, vMin, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.writeVertex(gx1, gy1, uMax, vMax, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.writeVertex(gx0, gy1, uMin, vMax, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                }
            }
            i += 1;
        }

        // Flush any glyphs rasterized during this text draw
        font.flush();
    }
}

createWhiteTexture :: () -> u32 {
    tex : u32 = 0;
    glGenTextures(1, *tex);
    glBindTexture(GL_TEXTURE_2D, tex);
    pixel : [4]u8 = .[255, 255, 255, 255];
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, *pixel);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
    tex
}

// --- UI Shaders ---

// --- Desktop (Core Profile 3.3) shaders ---

UI_VERT_SRC_CORE :: @string GLSL
#version 330 core
layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;
layout(location = 2) in vec4 aColor;
layout(location = 3) in vec4 aParams;
layout(location = 4) in vec4 aStroke;

uniform mat4 uProj;

out vec2 vUV;
out vec4 vColor;
out vec4 vParams;
out vec4 vStroke;

void main() {
    gl_Position = uProj * vec4(aPos, 0.0, 1.0);
    vUV = aUV;
    vColor = aColor;
    vParams = aParams;
    vStroke = aStroke;
}
GLSL;

UI_FRAG_SRC_CORE :: @string GLSL
#version 330 core
in vec2 vUV;
in vec4 vColor;
in vec4 vParams;
in vec4 vStroke;

uniform sampler2D uTex;

out vec4 FragColor;

float roundedBoxSDF(vec2 center, vec2 half_size, float radius) {
    vec2 q = abs(center) - half_size + vec2(radius);
    return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

void main() {
    float mode = vParams.x;
    float border = vParams.y;
    vec2 rectSize = vParams.zw;

    if (mode < -1.5) {
        // Image mode (mode == -2.0): sample texture
        FragColor = texture(uTex, vUV) * vColor;
    } else if (mode < 0.0) {
        // Text mode (mode == -1.0): sample glyph atlas .r as alpha
        float alpha = texture(uTex, vUV).r;
        float ew = fwidth(alpha) * 0.7;
        alpha = smoothstep(0.5 - ew, 0.5 + ew, alpha);
        FragColor = vec4(vColor.rgb, vColor.a * pow(alpha, 0.9));
    } else if (mode > 0.0 || border > 0.0) {
        // Rounded rect: SDF alpha, vertex color only (no texture sample)
        vec2 half_size = rectSize * 0.5;
        vec2 center = (vUV - vec2(0.5)) * rectSize;
        float dist = roundedBoxSDF(center, half_size, mode);
        float aa = fwidth(dist);
        float alpha = 1.0 - smoothstep(-aa, aa, dist);

        vec4 body = vColor;
        if (border > 0.0) {
            // Stroke ring composited OVER the fill, source-over in straight
            // alpha so a transparent fill leaves no dark halo at the seam.
            float inner = roundedBoxSDF(center, half_size - vec2(border), max(mode - border, 0.0));
            float ring = clamp(smoothstep(-aa, aa, inner), 0.0, 1.0);
            float sa = vStroke.a * ring;
            float fa = vColor.a * (1.0 - sa);
            float oa = sa + fa;
            body = vec4((vStroke.rgb * sa + vColor.rgb * fa) / max(oa, 0.0001), oa);
        }

        FragColor = vec4(body.rgb, body.a * alpha);
    } else {
        // Plain rect: vertex color only (no texture sample)
        FragColor = vColor;
    }
}
GLSL;

// --- WASM (ES 3.0 / WebGL2) shaders ---

UI_VERT_SRC_ES :: @string GLSL
#version 300 es
precision mediump float;
layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;
layout(location = 2) in vec4 aColor;
layout(location = 3) in vec4 aParams;
layout(location = 4) in vec4 aStroke;

uniform mat4 uProj;

out vec2 vUV;
out vec4 vColor;
out vec4 vParams;
out vec4 vStroke;

void main() {
    gl_Position = uProj * vec4(aPos, 0.0, 1.0);
    vUV = aUV;
    vColor = aColor;
    vParams = aParams;
    vStroke = aStroke;
}
GLSL;

UI_FRAG_SRC_ES :: @string GLSL
#version 300 es
precision mediump float;
in vec2 vUV;
in vec4 vColor;
in vec4 vParams;
in vec4 vStroke;

uniform sampler2D uTex;

out vec4 FragColor;

float roundedBoxSDF(vec2 center, vec2 half_size, float radius) {
    vec2 q = abs(center) - half_size + vec2(radius);
    return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

void main() {
    float mode = vParams.x;
    float border = vParams.y;
    vec2 rectSize = vParams.zw;

    if (mode < -1.5) {
        // Image mode (mode == -2.0): sample texture
        FragColor = texture(uTex, vUV) * vColor;
    } else if (mode < 0.0) {
        // Text mode (mode == -1.0): sample glyph atlas .r as alpha
        float alpha = texture(uTex, vUV).r;
        float ew = fwidth(alpha) * 0.7;
        alpha = smoothstep(0.5 - ew, 0.5 + ew, alpha);
        FragColor = vec4(vColor.rgb, vColor.a * pow(alpha, 0.9));
    } else if (mode > 0.0 || border > 0.0) {
        // Rounded rect: SDF alpha, vertex color only
        vec2 half_size = rectSize * 0.5;
        vec2 center = (vUV - vec2(0.5)) * rectSize;
        float dist = roundedBoxSDF(center, half_size, mode);
        float aa = fwidth(dist);
        float alpha = 1.0 - smoothstep(-aa, aa, dist);

        vec4 body = vColor;
        if (border > 0.0) {
            // Stroke ring composited OVER the fill, source-over in straight
            // alpha so a transparent fill leaves no dark halo at the seam.
            float inner = roundedBoxSDF(center, half_size - vec2(border), max(mode - border, 0.0));
            float ring = clamp(smoothstep(-aa, aa, inner), 0.0, 1.0);
            float sa = vStroke.a * ring;
            float fa = vColor.a * (1.0 - sa);
            float oa = sa + fa;
            body = vec4((vStroke.rgb * sa + vColor.rgb * fa) / max(oa, 0.0001), oa);
        }

        FragColor = vec4(body.rgb, body.a * alpha);
    } else {
        // Plain rect: vertex color only
        FragColor = vColor;
    }
}
GLSL;

// --- Metal (MSL) — single library with vmain/fmain entry points ---
//
// `packed_float2 / packed_float4` keep the 16-float interleaved vertex
// layout (pos2 / uv2 / color4 / params4 / stroke4 = 64 bytes) without
// padding — MSL's default `float4` has 16-byte alignment and would pad
// the leading pos2/uv2 pair out (see examples/63-metal-clear.sx for the
// gotcha).
//
// Uniform passing: GL uses `glUniformMatrix4fv("uProj", proj)`; Metal
// receives the projection via `setVertexBytes:length:atIndex:1` (slot 0
// is the vertex buffer). Texture binding goes through
// `setFragmentTexture:atIndex:0`.

UI_MSL_SRC :: @string MSL
#include <metal_stdlib>
using namespace metal;

struct UIVertex {
    packed_float2 pos;
    packed_float2 uv;
    packed_float4 color;
    packed_float4 params;
    packed_float4 stroke;
};

struct VOut {
    float4 position [[position]];
    float2 uv;
    float4 color;
    float4 params;
    float4 stroke;
};

vertex VOut vmain(uint vid [[vertex_id]],
                  constant UIVertex* verts [[buffer(0)]],
                  constant float4x4& proj [[buffer(1)]]) {
    UIVertex v = verts[vid];
    VOut o;
    o.position = proj * float4(v.pos, 0.0, 1.0);
    o.uv = float2(v.uv);
    o.color = float4(v.color);
    o.params = float4(v.params);
    o.stroke = float4(v.stroke);
    return o;
}

static float roundedBoxSDF(float2 center, float2 half_size, float radius) {
    float2 q = abs(center) - half_size + float2(radius);
    return length(max(q, float2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

fragment float4 fmain(VOut in [[stage_in]],
                      texture2d<float> tex [[texture(0)]]) {
    constexpr sampler s(coord::normalized, address::clamp_to_edge, filter::linear);

    float mode = in.params.x;
    float border = in.params.y;
    float2 rectSize = in.params.zw;

    if (mode < -1.5) {
        // Image mode (mode == -2.0): sample texture
        return tex.sample(s, in.uv) * in.color;
    } else if (mode < 0.0) {
        // Text mode (mode == -1.0): the glyph atlas stores R8 alpha coverage.
        float alpha = tex.sample(s, in.uv).r;
        return float4(in.color.rgb, in.color.a * alpha);
    } else if (mode > 0.0 || border > 0.0) {
        // Rounded rect: SDF alpha, vertex color only
        float2 half_size = rectSize * 0.5;
        float2 center = (in.uv - float2(0.5)) * rectSize;
        float dist = roundedBoxSDF(center, half_size, mode);
        float aa = fwidth(dist);
        float alpha = 1.0 - smoothstep(-aa, aa, dist);
        float4 body = in.color;
        if (border > 0.0) {
            // Stroke ring composited OVER the fill, source-over in straight
            // alpha so a transparent fill leaves no dark halo at the seam.
            float inner = roundedBoxSDF(center, half_size - float2(border), max(mode - border, 0.0));
            float ring = clamp(smoothstep(-aa, aa, inner), 0.0, 1.0);
            float sa = in.stroke.a * ring;
            float fa = in.color.a * (1.0 - sa);
            float oa = sa + fa;
            body = float4((in.stroke.rgb * sa + in.color.rgb * fa) / max(oa, 0.0001), oa);
        }
        return float4(body.rgb, body.a * alpha);
    } else {
        // Plain rect: vertex color only
        return in.color;
    }
}
MSL;

// --- Mesh shaders (3D pass) ---
//
// Vertex data is MeshVertex (position / normal / uv, 32 bytes). Slot 1 is
// the model-to-clip matrix and slot 2 the tint, matching the constant slots
// both GPU backends route. Lighting is a fixed two-lamp studio rig in mesh
// space, so the tint alone distinguishes parts.

MESH_VERT_SRC_ES :: @string GLSL
#version 300 es
precision mediump float;
layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aUV;

uniform mat4 uProj;
uniform vec4 uTint;

out vec3 vNormal;
out vec4 vColor;

void main() {
    gl_Position = uProj * vec4(aPos, 1.0);
    vNormal = aNormal;
    vColor = uTint;
}
GLSL;

MESH_FRAG_SRC_ES :: @string GLSL
#version 300 es
precision mediump float;
in vec3 vNormal;
in vec4 vColor;

out vec4 FragColor;

void main() {
    vec3 n = normalize(vNormal);
    float key = max(dot(n, normalize(vec3(0.42, 0.55, 0.72))), 0.0);
    float fill = max(dot(n, normalize(vec3(-0.65, 0.25, 0.45))), 0.0);
    float lum = 0.30 + 0.60 * key + 0.20 * fill;
    FragColor = vec4(vColor.rgb * lum, vColor.a);
}
GLSL;

MESH_MSL_SRC :: @string MSL
#include <metal_stdlib>
using namespace metal;

struct MeshVertex {
    packed_float3 position;
    packed_float3 normal;
    packed_float2 uv;
};

struct VOut {
    float4 position [[position]];
    float3 normal;
    float4 color;
};

vertex VOut vmain(uint vid [[vertex_id]],
                  device const MeshVertex* verts [[buffer(0)]],
                  constant float4x4& mvp [[buffer(1)]],
                  constant float4& tint [[buffer(2)]]) {
    VOut o;
    o.position = mvp * float4(verts[vid].position, 1.0);
    o.normal = float3(verts[vid].normal);
    o.color = tint;
    return o;
}

fragment float4 fmain(VOut in [[stage_in]]) {
    float3 n = normalize(in.normal);
    float key = max(dot(n, normalize(float3(0.42, 0.55, 0.72))), 0.0);
    float fill = max(dot(n, normalize(float3(-0.65, 0.25, 0.45))), 0.0);
    float lum = 0.30 + 0.60 * key + 0.20 * fill;
    return float4(in.color.rgb * lum, in.color.a);
}
MSL;

// --- Skinned mesh shaders (3D pass) ---
//
// Vertex data is SkinnedVertex (position / normal / uv / joints / weights,
// 64 bytes); slots 1 and 2 carry the same matrix and tint the rigid mesh
// pass uses. Bone `i` of the palette is the three rows `i*3+0..2` of a
// row-major affine transform: position dots each row against
// `vec4(position, 1.0)`, the normal against the row's xyz alone so the
// translation does not reach it.

SKINNED_VERT_SRC_ES :: @string GLSL
#version 300 es
precision mediump float;
layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aUV;
layout(location = 3) in vec4 aJoints;
layout(location = 4) in vec4 aWeights;

uniform mat4 uProj;
uniform vec4 uTint;
uniform vec4 uBones[240];

out vec3 vNormal;
out vec4 vColor;

void main() {
    vec4 p = vec4(aPos, 1.0);
    vec3 pos = vec3(0.0);
    vec3 nrm = vec3(0.0);
    for (int k = 0; k < 4; ++k) {
        float w = aWeights[k];
        if (w == 0.0) { continue; }
        int b = int(aJoints[k]) * 3;
        pos += w * vec3(dot(uBones[b + 0], p),
                        dot(uBones[b + 1], p),
                        dot(uBones[b + 2], p));
        nrm += w * vec3(dot(uBones[b + 0].xyz, aNormal),
                        dot(uBones[b + 1].xyz, aNormal),
                        dot(uBones[b + 2].xyz, aNormal));
    }
    gl_Position = uProj * vec4(pos, 1.0);
    vNormal = nrm;
    vColor = uTint;
}
GLSL;

SKINNED_FRAG_SRC_ES :: @string GLSL
#version 300 es
precision mediump float;
in vec3 vNormal;
in vec4 vColor;

out vec4 FragColor;

void main() {
    vec3 n = normalize(vNormal);
    float key = max(dot(n, normalize(vec3(0.42, 0.55, 0.72))), 0.0);
    float fill = max(dot(n, normalize(vec3(-0.65, 0.25, 0.45))), 0.0);
    float lum = 0.30 + 0.60 * key + 0.20 * fill;
    FragColor = vec4(vColor.rgb * lum, vColor.a);
}
GLSL;

SKINNED_MSL_SRC :: @string MSL
#include <metal_stdlib>
using namespace metal;

struct SkinnedVertex {
    packed_float3 position;
    packed_float3 normal;
    packed_float2 uv;
    packed_float4 joints;
    packed_float4 weights;
};

struct VOut {
    float4 position [[position]];
    float3 normal;
    float4 color;
};

vertex VOut vmain(uint vid [[vertex_id]],
                  device const SkinnedVertex* verts [[buffer(0)]],
                  constant float4x4& mvp [[buffer(1)]],
                  constant float4& tint [[buffer(2)]],
                  constant float4* bones [[buffer(8)]]) {
    float4 p = float4(float3(verts[vid].position), 1.0);
    float3 n = float3(verts[vid].normal);
    float4 j = float4(verts[vid].joints);
    float4 w = float4(verts[vid].weights);

    float3 pos = float3(0.0);
    float3 nrm = float3(0.0);
    for (uint k = 0; k < 4; ++k) {
        if (w[k] == 0.0) { continue; }
        uint b = uint(j[k]) * 3;
        pos += w[k] * float3(dot(bones[b + 0], p),
                             dot(bones[b + 1], p),
                             dot(bones[b + 2], p));
        nrm += w[k] * float3(dot(bones[b + 0].xyz, n),
                             dot(bones[b + 1].xyz, n),
                             dot(bones[b + 2].xyz, n));
    }

    VOut o;
    o.position = mvp * float4(pos, 1.0);
    o.normal = nrm;
    o.color = tint;
    return o;
}

fragment float4 fmain(VOut in [[stage_in]]) {
    float3 n = normalize(in.normal);
    float key = max(dot(n, normalize(float3(0.42, 0.55, 0.72))), 0.0);
    float fill = max(dot(n, normalize(float3(-0.65, 0.25, 0.45))), 0.0);
    float lum = 0.30 + 0.60 * key + 0.20 * fill;
    return float4(in.color.rgb * lum, in.color.a);
}
MSL;
