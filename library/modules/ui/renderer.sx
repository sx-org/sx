#import "modules/std.sx";
#import "modules/build.sx";
#import "modules/ffi/opengl.sx";
#import "modules/math";
#import "modules/gpu/types.sx";
#import "modules/gpu/api.sx";
#import "modules/ui/types.sx";
#import "modules/ui/render.sx";
#import "modules/ui/glyph_cache.sx";
#import "modules/ui/font.sx";

// Vertex: pos(2) + uv(2) + color(4) + params(4) + stroke(4) = 16 floats
UI_VERTEX_FLOATS :i64: 16;
UI_VERTEX_BYTES  :i64: 64;
MAX_UI_VERTICES  :i64: 16384;

UIRenderer :: struct {
    // GL-side handles. Used when `gpu == null`.
    vao: u32;
    vbo: u32;
    shader: u32;
    proj_loc: i32;
    tex_loc: i32;

    // CPU-side vertex scratch buffer — same for both backends.
    vertices: [*]f32;
    vertex_count: i64;
    screen_width: f32;
    screen_height: f32;
    dpi_scale: f32;
    white_texture: u32;     // GL name OR TextureHandle (both are u32-shaped)
    current_texture: u32;
    draw_calls: i64;

    // GPU protocol backend. When set, the renderer routes shader / buffer /
    // texture / draw calls through `gpu` instead of raw GL. The chess game
    // sets this on iOS to a boxed `*MetalGPU`.
    gpu: ?GPU = null;
    mtl_shader: ShaderHandle = 0;
    mtl_vbuf:   BufferHandle = 0;
    // Per-frame byte offset into the Metal vertex buffer. Each flush writes
    // to a fresh slice so concurrent in-flight draws don't trample each
    // other's data — Metal's shared-storage buffer is read at GPU execution
    // time, not at draw-call submission, so re-using offset 0 across flushes
    // would let the last writer win and earlier batches would render as
    // whatever was uploaded last. Reset to 0 in `begin()`.
    mtl_buf_offset: i64 = 0;
    mtl_buf_capacity: i64 = 0;

    // 3D mesh pass. One mesh is resident at a time (set_mesh); render nodes
    // address triangle ranges of it. Requires `gpu`.
    mesh_shader: ShaderHandle = 0;
    mesh_vbuf:   BufferHandle = 0;
    mesh_ibuf:   IndexHandle = 0;
    mesh_index_count: i32 = 0;

    // Skinned 3D pass. Held apart from the rigid mesh because SkinnedVertex
    // is a 64-byte stride against MeshVertex's 32, so one buffer pair cannot
    // serve both. One skinned mesh is resident at a time (set_skinned_mesh);
    // `.skinned_mesh` render nodes address triangle ranges of it.
    skin_shader: ShaderHandle = 0;
    skin_vbuf:   BufferHandle = 0;
    skin_ibuf:   IndexHandle = 0;
    skin_index_count: i32 = 0;

    // Re-bound after every mesh range so the 2D batches that follow keep
    // drawing through the UI pipeline.
    ui_proj: Mat4 = .{};

    init :: (self: *UIRenderer) {
        // Allocate vertex scratch (CPU side) — same for both backends.
        buf_size := MAX_UI_VERTICES * UI_VERTEX_BYTES;
        self.vertices = xx context.allocator.alloc_bytes(buf_size);
        c.memset(self.vertices, 0, buf_size);
        self.vertex_count = 0;
        self.dpi_scale = 1.0;

        if self.gpu != null {
            // ── Metal backend (via GPU protocol) ───────────────────────
            // Oversize the GPU buffer enough to hold many sub-batches per
            // frame without wrapping. With per-flush offset advance, each
            // draw reads from its own slice and can outlive earlier in-
            // flight draws without corruption.
            metal_buf_size := buf_size * 4;
            // Backend-specific shader sources: Metal takes a combined MSL
            // library with `vmain` + `fmain` entry points; GLES3 takes a
            // separate vertex / fragment pair. Caller selects via OS gate.
            inline if OS == .android {
                self.mtl_shader = self.gpu.create_shader(UI_VERT_SRC_ES, UI_FRAG_SRC_ES);
            }
            inline if OS == .ios or OS == .macos {
                self.mtl_shader = self.gpu.create_shader(UI_MSL_SRC, "");
            }
            self.mtl_vbuf   = self.gpu.create_buffer(metal_buf_size);
            self.mtl_buf_capacity = metal_buf_size;
            white_px : [4]u8 = .[255, 255, 255, 255];
            self.white_texture = self.gpu.create_texture(1, 1, .rgba8, xx *white_px[0]);
        } else {
            // ── GL backend ─────────────────────────────────────────────
            // Create shader (ES for WASM/WebGL2 + iOS GLES3, Core for desktop GL 3.3)
            inline if OS == .wasm or OS == .ios {
                self.shader = create_program(UI_VERT_SRC_ES, UI_FRAG_SRC_ES);
            } else {
                self.shader = create_program(UI_VERT_SRC_CORE, UI_FRAG_SRC_CORE);
            }
            self.proj_loc = glGetUniformLocation(self.shader, "uProj");
            self.tex_loc = glGetUniformLocation(self.shader, "uTex");

            // Create VAO/VBO
            glGenVertexArrays(1, *self.vao);
            glGenBuffers(1, *self.vbo);
            glBindVertexArray(self.vao);
            glBindBuffer(GL_ARRAY_BUFFER, self.vbo);
            glBufferData(GL_ARRAY_BUFFER, xx buf_size, null, GL_DYNAMIC_DRAW);

            // pos (2 floats)
            glVertexAttribPointer(0, 2, GL_FLOAT, 0, xx UI_VERTEX_BYTES, xx 0);
            glEnableVertexAttribArray(0);
            // uv (2 floats)
            glVertexAttribPointer(1, 2, GL_FLOAT, 0, xx UI_VERTEX_BYTES, xx 8);
            glEnableVertexAttribArray(1);
            // color (4 floats)
            glVertexAttribPointer(2, 4, GL_FLOAT, 0, xx UI_VERTEX_BYTES, xx 16);
            glEnableVertexAttribArray(2);
            // params: corner_radius, border_width, rect_w, rect_h
            glVertexAttribPointer(3, 4, GL_FLOAT, 0, xx UI_VERTEX_BYTES, xx 32);
            glEnableVertexAttribArray(3);
            // stroke color (4 floats)
            glVertexAttribPointer(4, 4, GL_FLOAT, 0, xx UI_VERTEX_BYTES, xx 48);
            glEnableVertexAttribArray(4);

            glBindVertexArray(0);

            // 1x1 white texture for solid rects
            self.white_texture = create_white_texture();
        }
    }

    // Make `vertices` / `indices` the mesh that `.mesh` render nodes address,
    // replacing any earlier one. Indices are absolute into `vertices`, so a
    // node's range is `draw_indexed(index_first, index_count)` verbatim.
    // False when there is no GPU backend to hold it.
    set_mesh :: (self: *UIRenderer, vertices: []MeshVertex, indices: []u32) -> bool {
        if self.gpu == null { return false; }
        if vertices.len == 0 or indices.len == 0 { return false; }

        if self.mesh_shader == 0 {
            inline if OS == .android {
                self.mesh_shader = self.gpu.create_shader(MESH_VERT_SRC_ES, MESH_FRAG_SRC_ES);
            }
            inline if OS == .ios or OS == .macos {
                self.mesh_shader = self.gpu.create_shader(MESH_MSL_SRC, "");
            }
            if self.mesh_shader == 0 { return false; }
        }

        self.gpu.destroy_buffer(self.mesh_vbuf);
        self.gpu.destroy_index_buffer(self.mesh_ibuf);
        self.mesh_index_count = 0;

        vbytes := vertices.len * size_of(MeshVertex);
        ibytes := indices.len * 4;
        self.mesh_vbuf = self.gpu.create_buffer(vbytes);
        self.mesh_ibuf = self.gpu.create_index_buffer(ibytes);
        if self.mesh_vbuf == 0 or self.mesh_ibuf == 0 { return false; }

        self.gpu.update_buffer(self.mesh_vbuf, xx *vertices[0], vbytes);
        self.gpu.update_index_buffer(self.mesh_ibuf, xx *indices[0], ibytes);
        self.mesh_index_count = xx indices.len;
        true
    }

    // Make `vertices` / `indices` the skinned mesh that `.skinned_mesh`
    // render nodes address, replacing any earlier one. Indices are absolute
    // into `vertices`, so a node's range is `draw_skinned(index_first,
    // index_count)` verbatim. False when there is no GPU backend to hold it.
    set_skinned_mesh :: (self: *UIRenderer, vertices: []SkinnedVertex, indices: []u32) -> bool {
        if self.gpu == null { return false; }
        if vertices.len == 0 or indices.len == 0 { return false; }

        if self.skin_shader == 0 {
            inline if OS == .android {
                self.skin_shader = self.gpu.create_shader(SKINNED_VERT_SRC_ES, SKINNED_FRAG_SRC_ES);
            }
            inline if OS == .ios or OS == .macos {
                self.skin_shader = self.gpu.create_shader(SKINNED_MSL_SRC, "");
            }
            if self.skin_shader == 0 { return false; }
        }

        self.gpu.destroy_buffer(self.skin_vbuf);
        self.gpu.destroy_index_buffer(self.skin_ibuf);
        self.skin_index_count = 0;

        vbytes := vertices.len * size_of(SkinnedVertex);
        ibytes := indices.len * 4;
        self.skin_vbuf = self.gpu.create_buffer(vbytes);
        self.skin_ibuf = self.gpu.create_index_buffer(ibytes);
        if self.skin_vbuf == 0 or self.skin_ibuf == 0 { return false; }

        self.gpu.update_buffer(self.skin_vbuf, xx *vertices[0], vbytes);
        self.gpu.update_index_buffer(self.skin_ibuf, xx *indices[0], ibytes);
        self.skin_index_count = xx indices.len;
        true
    }

    // The palette every later `.skinned_mesh` range skins against. Sticky in
    // the backend, so it holds across frames until replaced.
    set_bone_palette :: (self: *UIRenderer, palette: []BoneMatrix) {
        if self.gpu == null { return; }
        if palette.len == 0 { return; }
        self.gpu.set_bone_palette(xx *palette[0], xx palette.len);
    }

    begin :: (self: *UIRenderer, width: f32, height: f32, font_texture: u32) {
        self.screen_width = width;
        self.screen_height = height;
        self.vertex_count = 0;
        self.current_texture = font_texture;
        self.draw_calls = 0;

        proj := Mat4.ortho(0.0, width, height, 0.0, -1.0, 1.0);
        self.ui_proj = proj;

        if self.gpu != null {
            // Reset the per-frame ring offset; this frame's flushes start at 0.
            self.mtl_buf_offset = 0;
            // Pipeline state + vertex buffer + projection + initial texture.
            // Metal blend mode + scissor-cleared defaults are baked into
            // the pipeline state, so no per-frame glEnable/glDisable.
            self.gpu.set_shader(self.mtl_shader);
            self.gpu.set_vertex_buffer(self.mtl_vbuf);
            self.gpu.set_vertex_constants(1, xx *proj.data[0], 64);
            self.gpu.set_texture(0, font_texture);
        } else {
            // GL: bind everything for the frame.
            glUseProgram(self.shader);
            glUniformMatrix4fv(self.proj_loc, 1, 0, *proj.data[0]);
            glUniform1i(self.tex_loc, 0);
            glActiveTexture(GL_TEXTURE0);
            glBindTexture(GL_TEXTURE_2D, font_texture);
            glBindVertexArray(self.vao);
            glBindBuffer(GL_ARRAY_BUFFER, self.vbo);
            glEnable(GL_BLEND);
            glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        }
    }

    bind_texture :: (self: *UIRenderer, tex: u32) {
        if tex != self.current_texture {
            self.flush();
            self.current_texture = tex;
        }
    }

    // Emit a quad (2 triangles = 6 vertices)
    push_quad :: (self: *UIRenderer, frame: Frame, color: Color, stroke: Color, radius: f32, border_w: f32) {
        if self.vertex_count + 6 > MAX_UI_VERTICES {
            self.flush();
        }

        x0 := frame.origin.x;
        y0 := frame.origin.y;
        x1 := x0 + frame.size.width;
        y1 := y0 + frame.size.height;

        w := frame.size.width;
        h := frame.size.height;

        // 6 vertices for quad: TL, TR, BL, TR, BR, BL
        self.write_vertex(x0, y0, 0.0, 0.0, color, stroke, radius, border_w, w, h);
        self.write_vertex(x1, y0, 1.0, 0.0, color, stroke, radius, border_w, w, h);
        self.write_vertex(x0, y1, 0.0, 1.0, color, stroke, radius, border_w, w, h);
        self.write_vertex(x1, y0, 1.0, 0.0, color, stroke, radius, border_w, w, h);
        self.write_vertex(x1, y1, 1.0, 1.0, color, stroke, radius, border_w, w, h);
        self.write_vertex(x0, y1, 0.0, 1.0, color, stroke, radius, border_w, w, h);
    }

    // Emit a quad with custom UV coordinates (for sprite sheet sub-textures)
    push_quad_uv :: (self: *UIRenderer, frame: Frame, color: Color, stroke: Color, radius: f32, border_w: f32, uv_min: Point, uv_max: Point) {
        if self.vertex_count + 6 > MAX_UI_VERTICES {
            self.flush();
        }

        x0 := frame.origin.x;
        y0 := frame.origin.y;
        x1 := x0 + frame.size.width;
        y1 := y0 + frame.size.height;

        w := frame.size.width;
        h := frame.size.height;

        u_min := uv_min.x;
        v_min := uv_min.y;
        u_max := uv_max.x;
        v_max := uv_max.y;

        self.write_vertex(x0, y0, u_min, v_min, color, stroke, radius, border_w, w, h);
        self.write_vertex(x1, y0, u_max, v_min, color, stroke, radius, border_w, w, h);
        self.write_vertex(x0, y1, u_min, v_max, color, stroke, radius, border_w, w, h);
        self.write_vertex(x1, y0, u_max, v_min, color, stroke, radius, border_w, w, h);
        self.write_vertex(x1, y1, u_max, v_max, color, stroke, radius, border_w, w, h);
        self.write_vertex(x0, y1, u_min, v_max, color, stroke, radius, border_w, w, h);
    }

    write_vertex :: (self: *UIRenderer, x: f32, y: f32, u: f32, v: f32, color: Color, stroke: Color, cr: f32, bw: f32, rw: f32, rh: f32) {
        off := self.vertex_count * UI_VERTEX_FLOATS;
        self.vertices[off + 0] = x;
        self.vertices[off + 1] = y;
        self.vertices[off + 2] = u;
        self.vertices[off + 3] = v;
        self.vertices[off + 4] = color.rf();
        self.vertices[off + 5] = color.gf();
        self.vertices[off + 6] = color.bf();
        self.vertices[off + 7] = color.af();
        self.vertices[off + 8] = cr;
        self.vertices[off + 9] = bw;
        self.vertices[off + 10] = rw;
        self.vertices[off + 11] = rh;
        self.vertices[off + 12] = stroke.rf();
        self.vertices[off + 13] = stroke.gf();
        self.vertices[off + 14] = stroke.bf();
        self.vertices[off + 15] = stroke.af();
        self.vertex_count += 1;
    }

    // Walk the render tree and emit quads
    process :: (self: *UIRenderer, tree: *RenderTree) {
        i := 0;
        while i < tree.nodes.len {
            node := tree.nodes.items[i];
            match node.type {
                case .rect: {
                    self.push_quad(node.frame, node.fill_color, COLOR_TRANSPARENT, 0.0, 0.0);
                }
                case .rounded_rect: {
                    self.push_quad(node.frame, node.fill_color, node.stroke_color, node.corner_radius, node.stroke_width);
                }
                case .text: {
                    if g_font != null {
                        self.render_text(node);
                    }
                }
                case .image: {
                    self.bind_texture(node.texture_id);
                    neg2 : f32 = 0.0 - 2.0;
                    self.push_quad_uv(node.frame, COLOR_WHITE, COLOR_TRANSPARENT, neg2, 0.0, node.uv_min, node.uv_max);
                    // Re-bind font atlas after image
                    font := g_font;
                    if font != null {
                        self.bind_texture(font.texture_id);
                    }
                }
                case .mesh: {
                    self.draw_mesh(node);
                }
                case .skinned_mesh: {
                    self.draw_skinned_mesh(node);
                }
                case .clip_push: {
                    self.flush();
                    dpi := self.dpi_scale;
                    if self.gpu != null {
                        // Metal: pixel coords, top-left origin (no Y flip).
                        self.gpu.set_scissor(
                            xx (node.frame.origin.x * dpi),
                            xx (node.frame.origin.y * dpi),
                            xx (node.frame.size.width * dpi),
                            xx (node.frame.size.height * dpi),
                        );
                    } else {
                        // GL: pixel coords, bottom-left origin — flip Y.
                        glEnable(GL_SCISSOR_TEST);
                        glScissor(
                            xx (node.frame.origin.x * dpi),
                            xx ((self.screen_height - node.frame.origin.y - node.frame.size.height) * dpi),
                            xx (node.frame.size.width * dpi),
                            xx (node.frame.size.height * dpi)
                        );
                    }
                }
                case .clip_pop: {
                    self.flush();
                    if self.gpu != null {
                        self.gpu.disable_scissor();
                    } else {
                        glDisable(GL_SCISSOR_TEST);
                    }
                }
                case .opacity_push: {}
                case .opacity_pop: {}
            }
            i += 1;
        }
    }

    flush :: (self: *UIRenderer) {
        if self.vertex_count == 0 { return; }

        upload_size : i64 = self.vertex_count * UI_VERTEX_BYTES;

        if self.gpu != null {
            // Mirror the GL path: bind current texture before drawing.
            // current_texture may have changed since the last flush.
            self.gpu.set_texture(0, self.current_texture);

            // Write this batch to a fresh slice of the GPU buffer and draw
            // it from there. Re-using offset 0 would race against earlier
            // still-in-flight draws (see `mtl_buf_offset` comment in the
            // struct).
            if self.mtl_buf_offset + upload_size > self.mtl_buf_capacity {
                // Frame overflowed the GPU buffer; wrap to 0. Previous in-
                // flight batches from this frame will likely render wrong,
                // but the alternative (skipping the draw) would render
                // even less. Practical UIs should never hit this.
                self.mtl_buf_offset = 0;
            }
            byte_off := self.mtl_buf_offset;
            self.gpu.update_buffer_at(self.mtl_vbuf, xx self.vertices, upload_size, byte_off);
            vertex_off : i32 = xx (byte_off / UI_VERTEX_BYTES);
            self.gpu.draw_triangles(vertex_off, xx self.vertex_count);
            // Each batch starts on a vertex boundary so `vertex_off =
            // byte_off / UI_VERTEX_BYTES` lands on a whole vertex (otherwise
            // the shader reads partway through the previous vertex and the
            // text quads end up reading garbled UVs/colors). upload_size is
            // already vertex_count × UI_VERTEX_BYTES so the running offset
            // stays vertex-aligned without an extra `% UI_VERTEX_BYTES` pad.
            self.mtl_buf_offset = byte_off + upload_size;
        } else {
            // Only re-bind the current texture (program, projection, VAO
            // already bound in begin()). glBufferData orphans the old buffer
            // to avoid GPU sync stalls.
            glBindTexture(GL_TEXTURE_2D, self.current_texture);
            glBufferData(GL_ARRAY_BUFFER, xx upload_size, self.vertices, GL_DYNAMIC_DRAW);
            glDrawArrays(GL_TRIANGLES, 0, xx self.vertex_count);
        }

        self.vertex_count = 0;
        self.draw_calls += 1;
    }

    draw_mesh :: (self: *UIRenderer, node: RenderNode) {
        if self.gpu == null { return; }
        if self.mesh_shader == 0 { return; }
        if node.mesh_index_count <= 0 { return; }
        if node.mesh_index_first < 0 { return; }
        if node.mesh_index_first + node.mesh_index_count > self.mesh_index_count { return; }

        // The pending 2D batch belongs under the mesh in paint order, and the
        // pipeline swap below would otherwise draw it with the mesh shader.
        self.flush();

        col := node.fill_color;
        tint : [4]f32 = .[col.rf(), col.gf(), col.bf(), col.af() * node.opacity];
        mvp := node.mesh_transform;

        self.gpu.set_depth_mode(.less);
        self.gpu.set_shader(self.mesh_shader);
        self.gpu.set_vertex_buffer(self.mesh_vbuf);
        self.gpu.set_index_buffer(self.mesh_ibuf);
        self.gpu.set_vertex_constants(1, xx *mvp.data[0], 64);
        self.gpu.set_vertex_constants(2, xx *tint[0], 16);
        self.gpu.draw_indexed(node.mesh_index_first, node.mesh_index_count);
        self.draw_calls += 1;

        self.gpu.set_depth_mode(.disabled);
        self.gpu.set_shader(self.mtl_shader);
        self.gpu.set_vertex_buffer(self.mtl_vbuf);
        self.gpu.set_vertex_constants(1, xx *self.ui_proj.data[0], 64);
        self.gpu.set_texture(0, self.current_texture);
    }

    draw_skinned_mesh :: (self: *UIRenderer, node: RenderNode) {
        if self.gpu == null { return; }
        if self.skin_shader == 0 { return; }
        if node.mesh_index_count <= 0 { return; }
        if node.mesh_index_first < 0 { return; }
        if node.mesh_index_first + node.mesh_index_count > self.skin_index_count { return; }

        // The pending 2D batch belongs under the mesh in paint order, and the
        // pipeline swap below would otherwise draw it with the mesh shader.
        self.flush();

        col := node.fill_color;
        tint : [4]f32 = .[col.rf(), col.gf(), col.bf(), col.af() * node.opacity];
        mvp := node.mesh_transform;

        self.gpu.set_depth_mode(.less);
        self.gpu.set_shader(self.skin_shader);
        self.gpu.set_vertex_buffer(self.skin_vbuf);
        self.gpu.set_index_buffer(self.skin_ibuf);
        self.gpu.set_vertex_constants(1, xx *mvp.data[0], 64);
        self.gpu.set_vertex_constants(2, xx *tint[0], 16);
        self.gpu.draw_skinned(node.mesh_index_first, node.mesh_index_count);
        self.draw_calls += 1;

        self.gpu.set_depth_mode(.disabled);
        self.gpu.set_shader(self.mtl_shader);
        self.gpu.set_vertex_buffer(self.mtl_vbuf);
        self.gpu.set_vertex_constants(1, xx *self.ui_proj.data[0], 64);
        self.gpu.set_texture(0, self.current_texture);
    }

    render_text :: (self: *UIRenderer, node: RenderNode) {
        font := g_font;
        if font == null { return; }

        // Shape text into positioned glyphs. This may rasterize new glyphs
        // AND grow the atlas, which creates a new GPU texture under
        // `font.texture_id`. Re-bind the font atlas after shaping so the
        // upcoming text quads sample the texture that actually holds the
        // glyphs we just rasterized.
        font.shape_text(node.text, node.font_size);

        // Flush any new glyphs to the atlas texture
        font.flush();

        // If the atlas grew (or otherwise changed handle), switch the
        // current texture so the next flush samples the right one.
        self.bind_texture(font.texture_id);

        tc := node.text_color;
        ascent := font.get_ascent(node.font_size);
        raster_size := node.font_size * font.dpi_scale;
        inv_dpi := font.inv_dpi;

        i : i64 = 0;
        while i < font.shaped_buf.len {
            shaped := font.shaped_buf.items[i];
            cached := font.get_or_rasterize(shaped.glyph_index, raster_size);

            if cached != null {
                if cached.width > 0.0 {
                    // Scale physical pixel dimensions back to logical units
                    gx0 := node.frame.origin.x + shaped.x + cached.offset_x * inv_dpi;
                    gy0 := node.frame.origin.y + ascent + shaped.y + cached.offset_y * inv_dpi;
                    gx1 := gx0 + cached.width * inv_dpi;
                    gy1 := gy0 + cached.height * inv_dpi;

                    u_min := cached.uv_x;
                    v_min := cached.uv_y;
                    u_max := cached.uv_x + cached.uv_w;
                    v_max := cached.uv_y + cached.uv_h;


                    if self.vertex_count + 6 > MAX_UI_VERTICES {
                        self.flush();
                    }

                    // corner_radius = -1.0 signals "text mode" to the fragment shader
                    neg1 : f32 = 0.0 - 1.0;
                    self.write_vertex(gx0, gy0, u_min, v_min, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.write_vertex(gx1, gy0, u_max, v_min, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.write_vertex(gx0, gy1, u_min, v_max, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.write_vertex(gx1, gy0, u_max, v_min, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.write_vertex(gx1, gy1, u_max, v_max, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                    self.write_vertex(gx0, gy1, u_min, v_max, tc, COLOR_TRANSPARENT, neg1, 0.0, 0.0, 0.0);
                }
            }
            i += 1;
        }

        // Flush any glyphs rasterized during this text draw
        font.flush();
    }
}

create_white_texture :: () -> u32 {
    tex : u32 = 0;
    glGenTextures(1, *tex);
    glBindTexture(GL_TEXTURE_2D, tex);
    pixel : [4]u8 = .[255, 255, 255, 255];
    glTexImage2D(GL_TEXTURE_2D, 0, xx GL_RGBA, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, *pixel);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, xx GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, xx GL_NEAREST);
    tex
}

// --- UI Shaders ---

// --- Desktop (Core Profile 3.3) shaders ---

UI_VERT_SRC_CORE :: #string GLSL
#version 330 core
layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;
layout(location = 2) in vec4 aColor;
layout(location = 3) in vec4 aParams;
layout(location = 4) in vec4 aStroke;

uniform mat4 uProj;

out vec2 vUV;
out vec4 vColor;
out vec4 vParams;
out vec4 vStroke;

void main() {
    gl_Position = uProj * vec4(aPos, 0.0, 1.0);
    vUV = aUV;
    vColor = aColor;
    vParams = aParams;
    vStroke = aStroke;
}
GLSL;

UI_FRAG_SRC_CORE :: #string GLSL
#version 330 core
in vec2 vUV;
in vec4 vColor;
in vec4 vParams;
in vec4 vStroke;

uniform sampler2D uTex;

out vec4 FragColor;

float roundedBoxSDF(vec2 center, vec2 half_size, float radius) {
    vec2 q = abs(center) - half_size + vec2(radius);
    return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

void main() {
    float mode = vParams.x;
    float border = vParams.y;
    vec2 rectSize = vParams.zw;

    if (mode < -1.5) {
        // Image mode (mode == -2.0): sample texture
        FragColor = texture(uTex, vUV) * vColor;
    } else if (mode < 0.0) {
        // Text mode (mode == -1.0): sample glyph atlas .r as alpha
        float alpha = texture(uTex, vUV).r;
        float ew = fwidth(alpha) * 0.7;
        alpha = smoothstep(0.5 - ew, 0.5 + ew, alpha);
        FragColor = vec4(vColor.rgb, vColor.a * pow(alpha, 0.9));
    } else if (mode > 0.0 || border > 0.0) {
        // Rounded rect: SDF alpha, vertex color only (no texture sample)
        vec2 half_size = rectSize * 0.5;
        vec2 center = (vUV - vec2(0.5)) * rectSize;
        float dist = roundedBoxSDF(center, half_size, mode);
        float aa = fwidth(dist);
        float alpha = 1.0 - smoothstep(-aa, aa, dist);

        vec4 body = vColor;
        if (border > 0.0) {
            // Stroke ring composited OVER the fill, source-over in straight
            // alpha so a transparent fill leaves no dark halo at the seam.
            float inner = roundedBoxSDF(center, half_size - vec2(border), max(mode - border, 0.0));
            float ring = clamp(smoothstep(-aa, aa, inner), 0.0, 1.0);
            float sa = vStroke.a * ring;
            float fa = vColor.a * (1.0 - sa);
            float oa = sa + fa;
            body = vec4((vStroke.rgb * sa + vColor.rgb * fa) / max(oa, 0.0001), oa);
        }

        FragColor = vec4(body.rgb, body.a * alpha);
    } else {
        // Plain rect: vertex color only (no texture sample)
        FragColor = vColor;
    }
}
GLSL;

// --- WASM (ES 3.0 / WebGL2) shaders ---

UI_VERT_SRC_ES :: #string GLSL
#version 300 es
precision mediump float;
layout(location = 0) in vec2 aPos;
layout(location = 1) in vec2 aUV;
layout(location = 2) in vec4 aColor;
layout(location = 3) in vec4 aParams;
layout(location = 4) in vec4 aStroke;

uniform mat4 uProj;

out vec2 vUV;
out vec4 vColor;
out vec4 vParams;
out vec4 vStroke;

void main() {
    gl_Position = uProj * vec4(aPos, 0.0, 1.0);
    vUV = aUV;
    vColor = aColor;
    vParams = aParams;
    vStroke = aStroke;
}
GLSL;

UI_FRAG_SRC_ES :: #string GLSL
#version 300 es
precision mediump float;
in vec2 vUV;
in vec4 vColor;
in vec4 vParams;
in vec4 vStroke;

uniform sampler2D uTex;

out vec4 FragColor;

float roundedBoxSDF(vec2 center, vec2 half_size, float radius) {
    vec2 q = abs(center) - half_size + vec2(radius);
    return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

void main() {
    float mode = vParams.x;
    float border = vParams.y;
    vec2 rectSize = vParams.zw;

    if (mode < -1.5) {
        // Image mode (mode == -2.0): sample texture
        FragColor = texture(uTex, vUV) * vColor;
    } else if (mode < 0.0) {
        // Text mode (mode == -1.0): sample glyph atlas .r as alpha
        float alpha = texture(uTex, vUV).r;
        float ew = fwidth(alpha) * 0.7;
        alpha = smoothstep(0.5 - ew, 0.5 + ew, alpha);
        FragColor = vec4(vColor.rgb, vColor.a * pow(alpha, 0.9));
    } else if (mode > 0.0 || border > 0.0) {
        // Rounded rect: SDF alpha, vertex color only
        vec2 half_size = rectSize * 0.5;
        vec2 center = (vUV - vec2(0.5)) * rectSize;
        float dist = roundedBoxSDF(center, half_size, mode);
        float aa = fwidth(dist);
        float alpha = 1.0 - smoothstep(-aa, aa, dist);

        vec4 body = vColor;
        if (border > 0.0) {
            // Stroke ring composited OVER the fill, source-over in straight
            // alpha so a transparent fill leaves no dark halo at the seam.
            float inner = roundedBoxSDF(center, half_size - vec2(border), max(mode - border, 0.0));
            float ring = clamp(smoothstep(-aa, aa, inner), 0.0, 1.0);
            float sa = vStroke.a * ring;
            float fa = vColor.a * (1.0 - sa);
            float oa = sa + fa;
            body = vec4((vStroke.rgb * sa + vColor.rgb * fa) / max(oa, 0.0001), oa);
        }

        FragColor = vec4(body.rgb, body.a * alpha);
    } else {
        // Plain rect: vertex color only
        FragColor = vColor;
    }
}
GLSL;

// --- Metal (MSL) — single library with vmain/fmain entry points ---
//
// `packed_float2 / packed_float4` keep the 16-float interleaved vertex
// layout (pos2 / uv2 / color4 / params4 / stroke4 = 64 bytes) without
// padding — MSL's default `float4` has 16-byte alignment and would pad
// the leading pos2/uv2 pair out (see examples/63-metal-clear.sx for the
// gotcha).
//
// Uniform passing: GL uses `glUniformMatrix4fv("uProj", proj)`; Metal
// receives the projection via `setVertexBytes:length:atIndex:1` (slot 0
// is the vertex buffer). Texture binding goes through
// `setFragmentTexture:atIndex:0`.

UI_MSL_SRC :: #string MSL
#include <metal_stdlib>
using namespace metal;

struct UIVertex {
    packed_float2 pos;
    packed_float2 uv;
    packed_float4 color;
    packed_float4 params;
    packed_float4 stroke;
};

struct VOut {
    float4 position [[position]];
    float2 uv;
    float4 color;
    float4 params;
    float4 stroke;
};

vertex VOut vmain(uint vid [[vertex_id]],
                  constant UIVertex* verts [[buffer(0)]],
                  constant float4x4& proj [[buffer(1)]]) {
    UIVertex v = verts[vid];
    VOut o;
    o.position = proj * float4(v.pos, 0.0, 1.0);
    o.uv = float2(v.uv);
    o.color = float4(v.color);
    o.params = float4(v.params);
    o.stroke = float4(v.stroke);
    return o;
}

static float roundedBoxSDF(float2 center, float2 half_size, float radius) {
    float2 q = abs(center) - half_size + float2(radius);
    return length(max(q, float2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

fragment float4 fmain(VOut in [[stage_in]],
                      texture2d<float> tex [[texture(0)]]) {
    constexpr sampler s(coord::normalized, address::clamp_to_edge, filter::linear);

    float mode = in.params.x;
    float border = in.params.y;
    float2 rectSize = in.params.zw;

    if (mode < -1.5) {
        // Image mode (mode == -2.0): sample texture
        return tex.sample(s, in.uv) * in.color;
    } else if (mode < 0.0) {
        // Text mode (mode == -1.0): the glyph atlas stores R8 alpha coverage.
        float alpha = tex.sample(s, in.uv).r;
        return float4(in.color.rgb, in.color.a * alpha);
    } else if (mode > 0.0 || border > 0.0) {
        // Rounded rect: SDF alpha, vertex color only
        float2 half_size = rectSize * 0.5;
        float2 center = (in.uv - float2(0.5)) * rectSize;
        float dist = roundedBoxSDF(center, half_size, mode);
        float aa = fwidth(dist);
        float alpha = 1.0 - smoothstep(-aa, aa, dist);
        float4 body = in.color;
        if (border > 0.0) {
            // Stroke ring composited OVER the fill, source-over in straight
            // alpha so a transparent fill leaves no dark halo at the seam.
            float inner = roundedBoxSDF(center, half_size - float2(border), max(mode - border, 0.0));
            float ring = clamp(smoothstep(-aa, aa, inner), 0.0, 1.0);
            float sa = in.stroke.a * ring;
            float fa = in.color.a * (1.0 - sa);
            float oa = sa + fa;
            body = float4((in.stroke.rgb * sa + in.color.rgb * fa) / max(oa, 0.0001), oa);
        }
        return float4(body.rgb, body.a * alpha);
    } else {
        // Plain rect: vertex color only
        return in.color;
    }
}
MSL;

// --- Mesh shaders (3D pass) ---
//
// Vertex data is MeshVertex (position / normal / uv, 32 bytes). Slot 1 is
// the model-to-clip matrix and slot 2 the tint, matching the constant slots
// both GPU backends route. Lighting is a fixed two-lamp studio rig in mesh
// space, so the tint alone distinguishes parts.

MESH_VERT_SRC_ES :: #string GLSL
#version 300 es
precision mediump float;
layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aUV;

uniform mat4 uProj;
uniform vec4 uTint;

out vec3 vNormal;
out vec4 vColor;

void main() {
    gl_Position = uProj * vec4(aPos, 1.0);
    vNormal = aNormal;
    vColor = uTint;
}
GLSL;

MESH_FRAG_SRC_ES :: #string GLSL
#version 300 es
precision mediump float;
in vec3 vNormal;
in vec4 vColor;

out vec4 FragColor;

void main() {
    vec3 n = normalize(vNormal);
    float key = max(dot(n, normalize(vec3(0.42, 0.55, 0.72))), 0.0);
    float fill = max(dot(n, normalize(vec3(-0.65, 0.25, 0.45))), 0.0);
    float lum = 0.30 + 0.60 * key + 0.20 * fill;
    FragColor = vec4(vColor.rgb * lum, vColor.a);
}
GLSL;

MESH_MSL_SRC :: #string MSL
#include <metal_stdlib>
using namespace metal;

struct MeshVertex {
    packed_float3 position;
    packed_float3 normal;
    packed_float2 uv;
};

struct VOut {
    float4 position [[position]];
    float3 normal;
    float4 color;
};

vertex VOut vmain(uint vid [[vertex_id]],
                  device const MeshVertex* verts [[buffer(0)]],
                  constant float4x4& mvp [[buffer(1)]],
                  constant float4& tint [[buffer(2)]]) {
    VOut o;
    o.position = mvp * float4(verts[vid].position, 1.0);
    o.normal = float3(verts[vid].normal);
    o.color = tint;
    return o;
}

fragment float4 fmain(VOut in [[stage_in]]) {
    float3 n = normalize(in.normal);
    float key = max(dot(n, normalize(float3(0.42, 0.55, 0.72))), 0.0);
    float fill = max(dot(n, normalize(float3(-0.65, 0.25, 0.45))), 0.0);
    float lum = 0.30 + 0.60 * key + 0.20 * fill;
    return float4(in.color.rgb * lum, in.color.a);
}
MSL;

// --- Skinned mesh shaders (3D pass) ---
//
// Vertex data is SkinnedVertex (position / normal / uv / joints / weights,
// 64 bytes); slots 1 and 2 carry the same matrix and tint the rigid mesh
// pass uses. Bone `i` of the palette is the three rows `i*3+0..2` of a
// row-major affine transform: position dots each row against
// `vec4(position, 1.0)`, the normal against the row's xyz alone so the
// translation does not reach it.

SKINNED_VERT_SRC_ES :: #string GLSL
#version 300 es
precision mediump float;
layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aUV;
layout(location = 3) in vec4 aJoints;
layout(location = 4) in vec4 aWeights;

uniform mat4 uProj;
uniform vec4 uTint;
uniform vec4 uBones[240];

out vec3 vNormal;
out vec4 vColor;

void main() {
    vec4 p = vec4(aPos, 1.0);
    vec3 pos = vec3(0.0);
    vec3 nrm = vec3(0.0);
    for (int k = 0; k < 4; ++k) {
        float w = aWeights[k];
        if (w == 0.0) { continue; }
        int b = int(aJoints[k]) * 3;
        pos += w * vec3(dot(uBones[b + 0], p),
                        dot(uBones[b + 1], p),
                        dot(uBones[b + 2], p));
        nrm += w * vec3(dot(uBones[b + 0].xyz, aNormal),
                        dot(uBones[b + 1].xyz, aNormal),
                        dot(uBones[b + 2].xyz, aNormal));
    }
    gl_Position = uProj * vec4(pos, 1.0);
    vNormal = nrm;
    vColor = uTint;
}
GLSL;

SKINNED_FRAG_SRC_ES :: #string GLSL
#version 300 es
precision mediump float;
in vec3 vNormal;
in vec4 vColor;

out vec4 FragColor;

void main() {
    vec3 n = normalize(vNormal);
    float key = max(dot(n, normalize(vec3(0.42, 0.55, 0.72))), 0.0);
    float fill = max(dot(n, normalize(vec3(-0.65, 0.25, 0.45))), 0.0);
    float lum = 0.30 + 0.60 * key + 0.20 * fill;
    FragColor = vec4(vColor.rgb * lum, vColor.a);
}
GLSL;

SKINNED_MSL_SRC :: #string MSL
#include <metal_stdlib>
using namespace metal;

struct SkinnedVertex {
    packed_float3 position;
    packed_float3 normal;
    packed_float2 uv;
    packed_float4 joints;
    packed_float4 weights;
};

struct VOut {
    float4 position [[position]];
    float3 normal;
    float4 color;
};

vertex VOut vmain(uint vid [[vertex_id]],
                  device const SkinnedVertex* verts [[buffer(0)]],
                  constant float4x4& mvp [[buffer(1)]],
                  constant float4& tint [[buffer(2)]],
                  constant float4* bones [[buffer(8)]]) {
    float4 p = float4(float3(verts[vid].position), 1.0);
    float3 n = float3(verts[vid].normal);
    float4 j = float4(verts[vid].joints);
    float4 w = float4(verts[vid].weights);

    float3 pos = float3(0.0);
    float3 nrm = float3(0.0);
    for (uint k = 0; k < 4; ++k) {
        if (w[k] == 0.0) { continue; }
        uint b = uint(j[k]) * 3;
        pos += w[k] * float3(dot(bones[b + 0], p),
                             dot(bones[b + 1], p),
                             dot(bones[b + 2], p));
        nrm += w[k] * float3(dot(bones[b + 0].xyz, n),
                             dot(bones[b + 1].xyz, n),
                             dot(bones[b + 2].xyz, n));
    }

    VOut o;
    o.position = mvp * float4(pos, 1.0);
    o.normal = nrm;
    o.color = tint;
    return o;
}

fragment float4 fmain(VOut in [[stage_in]]) {
    float3 n = normalize(in.normal);
    float key = max(dot(n, normalize(float3(0.42, 0.55, 0.72))), 0.0);
    float fill = max(dot(n, normalize(float3(-0.65, 0.25, 0.45))), 0.0);
    float lum = 0.30 + 0.60 * key + 0.20 * fill;
    return float4(in.color.rgb * lum, in.color.a);
}
MSL;
