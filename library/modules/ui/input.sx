// The normalized input surface — host-independent: no ffi, no SDL;
// each backend translates its native events into these (through the
// platform layer's PlatformEvent stream) and pushes them into a
// per-root InputQueue. The router consumes the drained stream
// against the committed snapshot's hit list — the only dispatch path.
//
// Separations the contract pins:
// - physical key (position on the board) / logical key (meaning) / TEXT
//   are three different things; text is never synthesized from key
//   events, IME rides the composition arm, and deleteBackward is an
//   editing intent rather than a key.
// - hover (no button/contact) is not a move.
// - every pointer arm carries its pointer id — that continuity is what
//   the router's capture routes by.
@import "modules/std.sx";
@import "modules/ui/types.sx";

InputModifiers :: struct {
    shift: bool = false;
    control: bool = false;
    alt: bool = false;
    meta: bool = false;
}

InputDeviceId :: struct { value: u64; }
PointerId :: struct { value: u64; }

PointerKind :: enum {
    mouse;
    touch;
    pen;
}

PointerButton :: enum {
    none;       // touch contacts and moves carry no button
    primary;
    secondary;
    middle;
}

// Position on the physical board — a platform scancode, untranslated.
PhysicalKey :: struct { code: u32; }

// The neutral meaning of a key. Letters/digits arrive as TEXT, not
// keys.
LogicalKey :: enum {
    unknown;
    escape;
    enter;
    space;
    tab;
    backspace;
    delete;
    left;
    right;
    up;
    down;
}

// The shared header: which root, when, from what device, under which
// modifiers.
InputHeader :: struct {
    root: UiRootId = .{ value = 0 };
    timeNs: u64 = 0;
    device: InputDeviceId = .{ value = 0 };
    modifiers: InputModifiers = .{};
}

PointerEvent :: struct {
    header: InputHeader = .{};
    pointer: PointerId = .{ value = 0 };
    kind: PointerKind = .mouse;
    button: PointerButton = .none;
    position: Point = .{ x = 0.0, y = 0.0 };
}

ScrollEvent :: struct {
    header: InputHeader = .{};
    pointer: PointerId = .{ value = 0 };
    position: Point = .{ x = 0.0, y = 0.0 };
    delta: Point = .{ x = 0.0, y = 0.0 };
    precise: bool = false;   // pixel-precise (trackpad) vs line-stepped (wheel)
}

KeyEvent :: struct {
    header: InputHeader = .{};
    physical: PhysicalKey = .{ code = 0 };
    logical: LogicalKey = .unknown;
    repeat: bool = false;
}

TextEvent :: struct {
    header: InputHeader = .{};
    // Owned by the queue from push to drain (deep-copied; borrowed by
    // the drain callback for the call only).
    text: string;
}

// The text an IME is composing, replaced in full by each update; an
// empty `marked` is the composition abandoned. Commits arrive as text.
CompositionEvent :: struct {
    header: InputHeader = .{};
    // Owned by the queue on TextEvent.text's terms.
    marked: string;
    // The selection inside `marked`, in UTF-8 bytes.
    selectionStart: i64 = 0;
    selectionEnd: i64 = 0;
}

InputEvent :: enum {
    pointerDown: PointerEvent;
    pointerMove: PointerEvent;
    pointerUp: PointerEvent;
    pointerCancel: PointerEvent;
    pointerHover: PointerEvent;    // no contact — never coalesces with moves
    scroll: ScrollEvent;
    keyDown: KeyEvent;
    keyUp: KeyEvent;
    text: TextEvent;
    composition: CompositionEvent;
    deleteBackward: InputHeader;
}

// --- InputQueue — per UiRoot, persistent; push-side normalization ---
//
// Coalescing touches ONLY the immediately-last queued event, so any
// other event is an ordering barrier by construction: move·down·move
// never merges, and every event that is not a move, a hover or a scroll
// is neither coalesced nor dropped. Moves and hovers replace a
// same-arm/same-pointer/same-root predecessor (latest position wins);
// scrolls additionally ACCUMULATE their deltas.
InputQueue :: struct {
    events: List(InputEvent) = .{};
    gpa: Allocator;

    init :: (gpa: Allocator = context.allocator) -> InputQueue {
        InputQueue{ gpa = gpa }
    }

    len :: (self: *InputQueue) -> i64 @get => self.events.len;

    push :: (self: *InputQueue, ev: InputEvent) {
        // Owned payloads: copy on entry, before any queue placement.
        match ev {
            case .text: |t| {
                self.events.append(.text(self.copyText(t)), self.gpa);
                return;
            }
            case .composition: |cp| {
                self.events.append(.composition(self.copyComposition(cp)), self.gpa);
                return;
            }
            else: {}
        }
        if self.events.len > 0 {
            last := *self.events.items[self.events.len - 1];
            match ev {
                case .pointerMove: |p| {
                    match last {
                        case .pointerMove: |lp| {
                            if lp.pointer.value == p.pointer.value and lp.header.root == p.header.root {
                                self.events.items[self.events.len - 1] = ev;
                                return;
                            }
                        }
                    }
                }
                case .pointerHover: |p| {
                    match last {
                        case .pointerHover: |lp| {
                            if lp.pointer.value == p.pointer.value and lp.header.root == p.header.root {
                                self.events.items[self.events.len - 1] = ev;
                                return;
                            }
                        }
                    }
                }
                case .scroll: |s| {
                    match last {
                        case .scroll: |ls| {
                            if ls.pointer.value == s.pointer.value and ls.header.root == s.header.root {
                                merged := s;
                                merged.delta = ls.delta.add(s.delta);
                                self.events.items[self.events.len - 1] = .scroll(merged);
                                return;
                            }
                        }
                    }
                }
                else: {}
            }
        }
        self.events.append(ev, self.gpa);
    }

    copyText :: (self: *InputQueue, t: TextEvent) -> TextEvent {
        te := t;
        te.text = self.copyString(t.text);
        te
    }

    copyComposition :: (self: *InputQueue, ce: CompositionEvent) -> CompositionEvent {
        e := ce;
        e.marked = self.copyString(ce.marked);
        e
    }

    copyString :: (self: *InputQueue, s: string) -> string {
        raw : [*]u8 = (self.gpa.allocBytes(s.len)).([*]u8);
        c.memcpy(raw, s.ptr, s.len);
        owned : string = ---;
        owned.ptr = raw;
        owned.len = s.len;
        owned
    }

    // Deliver every queued event in order — payloads are borrowed for
    // the call — then clear, releasing owned strings.
    drain :: (self: *InputQueue, f: $F/(*InputEvent) -> void) {
        for *e in self.events { f(e); }
        self.clear();
    }

    clear :: (self: *InputQueue) {
        for e in self.events {
            match e {
                case .text: |t| { self.gpa.deallocBytes(t.text.ptr); true }
                case .composition: |cp| { self.gpa.deallocBytes(cp.marked.ptr); true }
                else: false
            } { }
        }
        self.events.len = 0;
    }

    deinit :: (self: *InputQueue) {
        self.clear();
        self.events.deinit(self.gpa);
    }
}
