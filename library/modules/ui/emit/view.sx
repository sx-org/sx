// `emit.View` — the library's own open set.
//
// A different set from `fluent.View` and `compose.View`, declaring the same
// methods and sharing nothing: a component of another library is not a member
// here, and no conversion stands in for a declaration.
#import "modules/std.sx";
#import "modules/ui/emit/geometry.sx";
#import "modules/ui/emit/render.sx";

View :: @OpenSet(.{ max = 256, align = 8 }) {
    size_that_fits :: (self: *Self, proposal: ProposedSize) -> Size;
    layout :: (self: *Self, bounds: Frame);
    render :: (self: *Self, rc: *RenderContext, frame: Frame);
}
