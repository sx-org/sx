// The fluent library's collection boundary.
//
// `View` is an open set, so it carries its member inside the slot: the sink
// writes the published expression into a slot it owns and appends that. Nothing
// is allocated and nothing borrows the block's frame, which is why the
// initializer's target is the fixed `@Init(View)` rather than an open binder.
//
// Package-local by design.
@import "modules/std.sx";
@import "modules/fluent.sx";
@import "modules/ui/fluent/view.sx";

Sink :: struct {
    children: List(View) = .{};

    expression :: (self: *Sink, value: $I/@Init(View)) {
        item: View = ---;
        value.write(*item);
        self.children.append(item);
    }
}

// Collects a block's children without building a container around them.
collectViews :: (content: $B/@BuildBlock(View)) -> List(View) {
    sink := Sink{};
    content.run(*sink);
    sink.children
}
