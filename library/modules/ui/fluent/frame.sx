// What one fluent build commits.
//
// Rendering a tree produces four things at once: the scene the platform
// renderer draws, and the hit, focus and scroll regions the tree declared. A
// snapshot holds all four together, because input resolves against the SAME
// frame that was drawn — never against a tree being rebuilt.
//
// The hit and scroll lists are paint-ordered, so the last region containing a
// point is the top one there. The focus list is declaration-ordered, which is
// the traversal order.
//
// A snapshot names the allocator its buffers come from. A project fills them
// under that allocator and `deinit` hands them back to it, so a snapshot
// released under some other ambient allocator still returns its memory where it
// took it.
//
// A project refills the lists in place and keeps their buffers, so a
// snapshot projected over and over settles at one frame's memory. A caller
// whose fills come from an arena calls `discard` first: those buffers are the
// arena's to reclaim, and reusing them past its reset would hand out released
// storage.
@import "modules/std.sx";
@import "modules/ui/types.sx";
@import "modules/ui/render.sx";
@import "modules/ui/fluent/view.sx";

CommittedUiSnapshot :: struct {
    revision: i64 = 0;
    root: UiRootId = .{ value = 0 };
    scene: RenderTree = .{};
    hitList: List(HitRegion) = .{};
    focusList: List(FocusRegion) = .{};
    scrollList: List(ScrollRegion) = .{};
    // What made the buffers the lists hold, and what they go back to.
    buffers: Allocator;

    init :: (buffers: Allocator) -> CommittedUiSnapshot => .{ buffers = buffers };

    // Empties the lists for the next fill and keeps their capacity.
    reset :: (self: *CommittedUiSnapshot) {
        self.scene.clear();
        self.hitList.len = 0;
        self.focusList.len = 0;
        self.scrollList.len = 0;
    }

    // Drops the buffers instead of reusing them, for a caller whose fills come
    // from an arena: that arena is what releases them. It names what the next
    // fill comes from, and the snapshot holding nothing here is what makes the
    // change legal.
    discard :: (self: *CommittedUiSnapshot, next: Allocator) {
        self.scene.nodes.detach();
        self.hitList.detach();
        self.focusList.detach();
        self.scrollList.detach();
        self.buffers = next;
    }

    deinit :: (self: *CommittedUiSnapshot) {
        self.scene.nodes.deinit(self.buffers);
        self.hitList.deinit(self.buffers);
        self.focusList.deinit(self.buffers);
        self.scrollList.deinit(self.buffers)
    }
}

// Lays the root out over the viewport and projects it into the snapshot: the
// scene and the three region lists all fill from the one render pass, under
// the snapshot's own allocator, and the revision names the frame they belong
// to.
project :: (root: *View, viewport: Size, snap: *CommittedUiSnapshot) {
    snap.reset();
    bounds := Frame.make(0.0, 0.0, viewport.width, viewport.height);
    push .{ allocator = snap.buffers } {
        root.layout(bounds);
        rc := RenderContext.init(*snap.scene);
        rc.hits = *snap.hitList;
        rc.focuses = *snap.focusList;
        rc.scrolls = *snap.scrollList;
        root.render(*rc, bounds)
    }
    snap.revision += 1;
}
