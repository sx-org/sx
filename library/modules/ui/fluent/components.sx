// The fluent library's leaf components.
//
// Each declares itself into `fluent.View` and answers the three methods the set
// declares, at the types the set declares them.
#import "modules/std.sx";
#import "modules/ui/fluent/geometry.sx";
#import "modules/ui/fluent/render.sx";
#import "modules/ui/fluent/view.sx";
#import "modules/ui/fluent/modifier.sx";

Label :: @OpenVariant(View) {
    text: string = "";
    modifier: Modifier = .{};
    measured: Size = .{};

    size_that_fits :: (self: *Label, proposal: ProposedSize) -> Size {
        w := xx self.text.len * 8;
        Size{ width = w, height = 16.0 }
    }

    layout :: (self: *Label, bounds: Frame) {
        self.measured = bounds.size;
    }

    render :: (self: *Label, rc: *RenderContext, frame: Frame) {
        rc.add_text(frame, self.text);
    }
}

Button :: @OpenVariant(View) {
    label: string = "";
    modifier: Modifier = .{};
    fill: Color = .{ r = 0.2, g = 0.4, b = 0.9, a = 1.0 };

    size_that_fits :: (self: *Button, proposal: ProposedSize) -> Size {
        w := xx self.label.len * 8;
        pad := self.modifier.padding.horizontal();
        Size{ width = w + pad, height = 24.0 + self.modifier.padding.vertical() }
    }

    layout :: (self: *Button, bounds: Frame) {}

    render :: (self: *Button, rc: *RenderContext, frame: Frame) {
        rc.add_rect(frame, self.fill);
        rc.add_text(frame, self.label);
    }
}
