// The fluent library's root and rendering entry points.
@import "modules/std.sx";
@import "modules/ui/types.sx";
@import "modules/ui/render.sx";
@import "modules/ui/fluent/view.sx";

// Measures the root against the viewport, lays it out, and renders it into a
// tree the caller owns.
renderRoot :: (root: *View, viewport: Size, tree: *RenderTree) {
    proposal := ProposedSize.fixed(viewport.width, viewport.height);
    size := root.sizeThatFits(proposal);
    bounds := Frame.make(0.0, 0.0, size.width, size.height);
    root.layout(bounds);
    rc := RenderContext.init(tree);
    root.render(*rc, bounds);
}

commandCount :: (tree: *RenderTree) -> i64 => tree.nodes.len;
