// `fluent.Modifier` and the library's UFCS modifiers.
//
// A modifier is an ordinary value carried by a component, and a modifier call is
// an ordinary value operation — chaining one does not intercept anything.
@import "modules/std.sx";
@import "modules/ui/types.sx";

Modifier :: struct {
    opacity: f32 = 1.0;
    padding: EdgeInsets = .{};

    with_opacity :: (self: Modifier, alpha: f32) -> Modifier {
        Modifier{ opacity = alpha, padding = self.padding }
    }

    with_padding :: (self: Modifier, insets: EdgeInsets) -> Modifier {
        Modifier{ opacity = self.opacity, padding = insets }
    }
}

with_opacity :: ufcs (m: Modifier, alpha: f32) -> Modifier {
    m.with_opacity(alpha)
}

with_padding :: ufcs (m: Modifier, insets: EdgeInsets) -> Modifier {
    m.with_padding(insets)
}
