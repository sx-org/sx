// The fluent library's keyboard focus.
//
// An element declares a focus region while it renders, and DECLARATION order is
// the traversal order — there is no registry to enrol in and no tab index to
// keep. The router holds one id, resolves it against the LATEST committed
// snapshot, and hands that region the keys.
//
// Tab is the router's own key: it steps that order — backward under shift —
// and reaches no region. From nothing it enters at the first region, so a root
// nobody has pointed at can be walked into from the keyboard alone.
//
// A request names an element rather than a position, so a build may focus the
// element it is about to declare; the commit that follows is what validates it.
// An element the committed build stopped declaring is no longer focused.
@import "modules/std.sx";
@import "modules/ui/types.sx";
@import "modules/ui/render.sx";
@import "modules/ui/input.sx";
@import "modules/ui/fluent/view.sx";
@import "modules/ui/fluent/identity.sx";
@import "modules/ui/fluent/frame.sx";

// A component wrapped in its own focus region. The child is stored inline at
// its own type, so a focusable element is one value and the calls into it stay
// static.
Focusable :: @OpenVariant(View) ($V: Type) {
    child: V;
    id: ElementId = .{};
    on_key: ?Closure(*KeyEvent) = null;
    on_text: ?Closure(string) = null;
    wants_keyboard: bool = false;

    size_that_fits :: (self: *Focusable(V), proposal: ProposedSize) -> Size {
        self.child.size_that_fits(proposal)
    }

    layout :: (self: *Focusable(V), bounds: Frame) {
        self.child.layout(bounds)
    }

    render :: (self: *Focusable(V), rc: *RenderContext, frame: Frame) {
        rc.focus_region(self.id.value, frame, self.on_key, self.on_text, self.wants_keyboard);
        self.child.render(rc, frame)
    }
}

// The one way a component becomes focusable: the result is itself a member, so
// it goes wherever a `View` goes. The id is minted at THIS call site.
focusable :: (v: $V/View, on_key: ?Closure(*KeyEvent) = null, on_text: ?Closure(string) = null, wants_keyboard: bool = false, site: SiteId = site_of(@caller)) -> Focusable(V) {
    Focusable(V){ child = v, id = element_id(site), on_key = on_key, on_text = on_text, wants_keyboard = wants_keyboard }
}

// One id and the frame it resolves against: this router owns no allocation, so
// it takes no allocator and has nothing to hand back.
FocusRouter :: struct {
    // The surface every resolution runs against; null until a frame commits.
    snap: *CommittedUiSnapshot = null;
    focused: ?u64 = null;

    init :: () -> FocusRouter => .{};

    // Point the router at the frame that just committed, and let go of an
    // element that frame no longer declares.
    observe :: (self: *FocusRouter, snap: *CommittedUiSnapshot) {
        self.snap = snap;
        if id := self.focused {
            if self.index_of(id) < 0 {
                self.focused = null;
            }
        }
    }

    request_focus :: (self: *FocusRouter, id: ElementId) {
        self.focused = id.value;
    }

    clear_focus :: (self: *FocusRouter) {
        self.focused = null;
    }

    index_of :: (self: *FocusRouter, id: u64) -> i64 {
        if self.snap == null then return -1;
        for r, i in self.snap.focus_list, 0.. {
            if r.id == id then return i
        }
        -1
    }

    // The focused region in the committed frame.
    current :: (self: *FocusRouter) -> ?*FocusRegion {
        if id := self.focused {
            at := self.index_of(id);
            if at >= 0 {
                return *self.snap.focus_list.items[at];
            }
        }
        null
    }

    // What the platform shell polls to drive the soft keyboard.
    wants_keyboard :: (self: *FocusRouter) -> bool {
        if r := self.current() {
            return r.wants_keyboard;
        }
        false
    }

    focus_next :: (self: *FocusRouter) {
        self.step(1)
    }

    focus_prev :: (self: *FocusRouter) {
        self.step(-1)
    }

    // Traversal wraps; from nothing, a forward step enters at the first region
    // and a backward one at the last.
    step :: (self: *FocusRouter, delta: i64) {
        if self.snap == null then return;
        n := self.snap.focus_list.len;
        if n == 0 {
            self.focused = null;
            return;
        }
        next := if delta > 0 then 0 else n - 1;
        if id := self.focused {
            at := self.index_of(id);
            if at >= 0 {
                next = (at + delta + n) % n;
            }
        }
        self.focused = self.snap.focus_list.items[next].id;
    }

    // Tab steps the traversal and stops there — it is consumed whether or not
    // anything is focused. Every other key DOWN is what the focused region
    // hears; an up is not a focus event. Text rides its own channel, never
    // synthesized from keys.
    dispatch :: (self: *FocusRouter, ev: *InputEvent) {
        match ev.* {
            case .key_down: |k| {
                if k.logical == .tab {
                    self.step(if k.header.modifiers.shift then -1 else 1);
                    return;
                }
                if r := self.current() {
                    if h := r.on_key {
                        e := k;
                        h(*e)
                    }
                }
            }
            case .text: |t| {
                if r := self.current() {
                    if h := r.on_text {
                        h(t.text)
                    }
                }
            }
            else: {}
        }
    }
}

@context.extend fluent_focus: *FocusRouter = null;

// The focus state a build reads to style an element by whether the keys reach
// it. With no router in context nothing is focused.
is_focused :: (id: ElementId) -> bool {
    if context.fluent_focus == null then return false;
    if f := context.fluent_focus.focused {
        return f == id.value;
    }
    false
}
