// The fluent library's pointer routing: taps and scroll gestures.
//
// An element declares a hit region while it renders, a scrollable one a scroll
// region; the router resolves a pointer against the LATEST committed snapshot's
// lists, never against the tree. A down captures the hit region under it and
// the scroll region under it; an up over that same hit region taps, and the
// handler that runs is the one the CURRENT snapshot carries — a rebuild between
// the down and the up therefore taps with the newest handler, and an element
// that stopped declaring its region taps not at all.
//
// A pointer that moves past `DRAG_SLOP` from its down point while a scroll
// region holds it becomes a drag: the tap is cancelled, and the region receives
// the movement as gestures until the up. A wheel event reaches the scroll
// region under its position outright.
//
// A tap is what this router recognizes. A point whose policy is `.fail` is
// transparent there, so the probe continues down the paint-ordered stack; any
// other non-`.tap` policy takes the point without taps.
@import "modules/std.sx";
@import "modules/std/core.sx";
@import "modules/std/mem.sx";
@import "modules/ui/types.sx";
@import "modules/ui/render.sx";
@import "modules/ui/input.sx";
@import "modules/ui/fluent/view.sx";
@import "modules/ui/fluent/identity.sx";
@import "modules/ui/fluent/frame.sx";

// How far a pointer travels from its down point before it is a drag.
DRAG_SLOP :: 8.0;

// A component wrapped in its own hit region. The child is stored inline at its
// own type, so an interactive element is one value and the calls into it stay
// static.
Tappable :: @OpenVariant(View) ($V: Type) {
    child: V;
    id: ElementId = .{};
    onTap: ?Closure() = null;
    policy: ?Closure(Point) -> HitPolicy = null;

    fit :: (self: *Tappable(V), proposal: ProposedSize) -> Size {
        self.child.fit(proposal)
    }

    layout :: (self: *Tappable(V), bounds: Frame) {
        self.child.layout(bounds)
    }

    // The region is declared BEFORE the child draws, so a child's own regions
    // land later in paint order and win the points they cover.
    render :: (self: *Tappable(V), rc: *RenderContext, frame: Frame) {
        rc.hitRegion(self.id.value, frame, self.policy, self.onTap);
        self.child.render(rc, frame)
    }
}

// The one way a component becomes tappable: the result is itself a member, so
// it goes wherever a `View` goes. The id is minted at THIS call site.
tappable :: (v: $V/View, onTap: ?Closure() = null, policy: ?Closure(Point) -> HitPolicy = null, site: SiteId = siteOf(@caller)) -> Tappable(V) {
    Tappable(V){ child = v, id = elementId(site), onTap = onTap, policy = policy }
}

// A component wrapped in its own scroll region, declared before the child
// draws like a tap region is.
Scrollable :: @OpenVariant(View) ($V: Type) {
    child: V;
    id: ElementId = .{};
    onScroll: ?Closure(*ScrollGesture) = null;

    fit :: (self: *Scrollable(V), proposal: ProposedSize) -> Size {
        self.child.fit(proposal)
    }

    layout :: (self: *Scrollable(V), bounds: Frame) {
        self.child.layout(bounds)
    }

    render :: (self: *Scrollable(V), rc: *RenderContext, frame: Frame) {
        rc.scrollRegion(self.id.value, frame, self.onScroll);
        self.child.render(rc, frame)
    }
}

scrollable :: (v: $V/View, onScroll: ?Closure(*ScrollGesture) = null, site: SiteId = siteOf(@caller)) -> Scrollable(V) {
    Scrollable(V){ child = v, id = elementId(site), onScroll = onScroll }
}

// Which region owns a point, and what it allows there.
HitTarget :: struct {
    id: u64 = 0;
    policy: HitPolicy = .tap;
}

// One live pointer: the hit region it may tap and the scroll region it may
// drag, either of which may be missing. `inside` follows the pointer off and
// back onto its hit region, and only an up taken inside taps; a drag turns it
// off for good.
PointerSequence :: struct {
    pointer: PointerId = .{ value = 0 };
    element: ?u64 = null;
    scroller: ?u64 = null;
    down: Point = .{ x = 0.0, y = 0.0 };
    last: Point = .{ x = 0.0, y = 0.0 };
    inside: bool = true;
    dragging: bool = false;
}

Router :: struct {
    // The surface every resolution runs against; null until a frame commits.
    snap: *CommittedUiSnapshot = null;
    sequences: List(PointerSequence) = .{};
    gpa: Allocator;

    init :: (gpa: Allocator) -> Router => .{ gpa = gpa };

    // Point the router at the frame that just committed. A sequence lets go of
    // a region that frame no longer declares, and is cancelled once it holds
    // none — or once its drag has nowhere to go.
    observe :: (self: *Router, snap: *CommittedUiSnapshot) {
        self.snap = snap;
        i := 0;
        while i < self.sequences.len {
            s := *self.sequences.items[i];
            if e := s.element { if !Router.declares(snap, e) { s.element = null; } }
            if sc := s.scroller { if !Router.declaresScroll(snap, sc) { s.scroller = null; } }
            if s.scroller == null and (s.dragging or s.element == null) {
                self.sequences.swapRemove(i)
            } else {
                i += 1;
            }
        }
    }

    declares :: (snap: *CommittedUiSnapshot, id: u64) -> bool {
        for r in snap.hitList {
            if r.id == id then return true
        }
        false
    }

    declaresScroll :: (snap: *CommittedUiSnapshot, id: u64) -> bool {
        for r in snap.scrollList {
            if r.id == id then return true
        }
        false
    }

    // The top region at a point: the LAST containing one in paint order whose
    // policy does not fail there.
    hitTop :: (self: *Router, p: Point) -> ?HitTarget {
        if self.snap == null then return null;
        i := self.snap.hitList.len - 1;
        while i >= 0 {
            r := *self.snap.hitList.items[i];
            if r.frame.contains(p) {
                allowed : HitPolicy = .tap;
                if pf := r.policy {
                    allowed = pf(p);
                }
                if allowed != .fail {
                    return HitTarget{ id = r.id, policy = allowed };
                }
            }
            i -= 1;
        }
        null
    }

    // The top scroll region at a point.
    scrollTop :: (self: *Router, p: Point) -> ?u64 {
        if self.snap == null then return null;
        i := self.snap.scrollList.len - 1;
        while i >= 0 {
            r := *self.snap.scrollList.items[i];
            if r.frame.contains(p) { return r.id; }
            i -= 1;
        }
        null
    }

    // Whether `id` is the region a point lands on.
    covers :: (self: *Router, p: Point, id: u64) -> bool {
        if t := self.hitTop(p) {
            return t.id == id;
        }
        false
    }

    pressed :: (self: *Router, id: u64) -> bool {
        for s in self.sequences {
            if e := s.element {
                if e == id and s.inside then return true
            }
        }
        false
    }

    find :: (self: *Router, pointer: PointerId) -> i64 {
        for s, i in self.sequences, 0.. {
            if s.pointer.value == pointer.value then return i
        }
        -1
    }

    drop :: (self: *Router, pointer: PointerId) {
        i := self.find(pointer);
        if i >= 0 {
            self.sequences.swapRemove(i)
        }
    }

    // Runs the handler the CURRENT snapshot carries for `id`.
    fire :: (self: *Router, id: u64) {
        for r in self.snap.hitList {
            if r.id == id {
                if h := r.onTap {
                    h()
                }
                return;
            }
        }
    }

    // Hands a gesture to the scroll region the CURRENT snapshot carries for `id`.
    scroll :: (self: *Router, id: u64, phase: ScrollPhase, delta: Point, timeNs: u64) {
        for r in self.snap.scrollList {
            if r.id == id {
                if h := r.onScroll {
                    g := ScrollGesture{ phase = phase, delta = delta, timeNs = timeNs };
                    h(*g)
                }
                return;
            }
        }
    }

    dispatch :: (self: *Router, ev: *InputEvent) {
        if self.snap == null then return;
        match ev.* {
            case .scroll: |s| {
                if id := self.scrollTop(s.position) {
                    self.scroll(id, .wheel, s.delta, s.header.timeNs)
                }
            }
            case .pointerDown: |p| {
                element : ?u64 = null;
                if t := self.hitTop(p.position) {
                    if t.policy == .tap { element = t.id; }
                }
                scroller := self.scrollTop(p.position);
                if element == null and scroller == null then return;
                self.drop(p.pointer);
                self.sequences.append(.{
                    pointer = p.pointer,
                    element = element,
                    scroller = scroller,
                    down = p.position,
                    last = p.position,
                    inside = element != null,
                }, self.gpa)
            }
            case .pointerMove: |p| {
                i := self.find(p.pointer);
                if i < 0 then return;
                s := *self.sequences.items[i];
                if s.dragging {
                    self.scroll(s.scroller?!, .dragMove, p.position.sub(s.last), p.header.timeNs);
                    s.last = p.position;
                    return;
                }
                if sc := s.scroller {
                    if p.position.distance(s.down) > DRAG_SLOP {
                        s.dragging = true;
                        s.inside = false;
                        s.last = p.position;
                        self.scroll(sc, .dragStart, p.position.sub(s.down), p.header.timeNs);
                        return;
                    }
                }
                if e := s.element {
                    s.inside = self.covers(p.position, e);
                }
            }
            case .pointerUp: |p| {
                i := self.find(p.pointer);
                if i < 0 then return;
                s := self.sequences.items[i];
                self.sequences.swapRemove(i);
                if s.dragging {
                    self.scroll(s.scroller?!, .dragEnd, p.position.sub(s.last), p.header.timeNs);
                    return;
                }
                if e := s.element {
                    if s.inside and self.covers(p.position, e) {
                        self.fire(e)
                    }
                }
            }
            case .pointerCancel: |p| {
                i := self.find(p.pointer);
                if i < 0 then return;
                s := self.sequences.items[i];
                self.sequences.swapRemove(i);
                if s.dragging {
                    self.scroll(s.scroller?!, .cancel, Point.zero(), p.header.timeNs)
                }
            }
            else: {}
        }
    }

    deinit :: (self: *Router) {
        self.sequences.deinit(self.gpa)
    }
}

@context.extend fluentInput: *Router = null;

// The press state a build reads to style an element by what the pointer is
// doing to it. With no router in context nothing is pressed.
isPressed :: (id: ElementId) -> bool {
    if context.fluentInput == null then return false;
    context.fluentInput.pressed(id.value)
}
