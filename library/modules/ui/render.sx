@import "modules/std.sx";
@import "modules/math";
@import "modules/ui/types.sx";
@import "modules/ui/input.sx";

RenderNodeType :: enum {
    rect;
    roundedRect;
    text;
    image;
    mesh;
    skinnedMesh;
    clipPush;
    clipPop;
    opacityPush;
    opacityPop;
}

RenderNode :: struct {
    type: RenderNodeType;
    frame: Frame;

    // Rect / roundedRect
    fillColor: Color;
    strokeColor: Color;
    strokeWidth: f32;
    cornerRadius: f32;

    // Text
    text: string;
    fontSize: f32;
    textColor: Color;

    // Image
    textureId: u32;
    uvMin: Point;
    uvMax: Point;

    // Mesh: a triangle range of the renderer's current mesh — rigid or
    // skinned, per node type — transformed by `meshTransform` into clip
    // space and tinted with `fillColor`.
    meshIndexFirst: i32;
    meshIndexCount: i32;
    meshTransform: Mat4;

    // Opacity
    opacity: f32;

    depth: i64;
}

RenderTree :: struct {
    nodes: List(RenderNode);
    generation: i64;

    init :: () -> RenderTree {
        RenderTree{ generation = 0 }
    }

    clear :: (self: *RenderTree) {
        self.nodes.len = 0;
        self.generation += 1;
    }

    add :: (self: *RenderTree, node: RenderNode) -> i64 {
        idx := self.nodes.len;
        self.nodes.append(node);
        idx
    }
}

// Per-point policy: what a region allows AT a point — the tapActionAtPoint
// shape. Declared as a closure on the region so the answer may depend on point
// and content; the hit list is rebuilt every commit, so policies are
// re-supplied each frame by construction.
HitPolicy :: enum {
    tap;          // default: a single tap fires on release
    waitDouble;  // the release arms a pending tap — a second tap within
                  // the window is the double, the window's end the single
    hold;         // no taps at this point — long-press / pan only
    fail;         // transparent at this point: the hit falls through to
                  // the region below in paint order
}

// A focus declaration: focusable elements declare beside their hit regions;
// DECLARATION order is the tab-traversal order — no
// registry. The handlers fire at delivery from the CURRENT
// committed snapshot, re-supplied each frame like hit-region
// closures; wantsKeyboard is what the platform shell polls to drive
// the soft keyboard.
FocusRegion :: struct {
    id: u64;
    frame: Frame;
    onKey: ?Closure(*KeyEvent) = null;
    onText: ?Closure(string) = null;
    onComposition: ?Closure(*CompositionEvent) = null;
    onDeleteBackward: ?Closure() = null;
    wantsKeyboard: bool = false;
}

// An interactive region declared during render: paint order = emission order,
// so the last containing region whose policy does not fail the point is the
// top hit. The id is the raw ElementId hash — render.sx sits below compose.sx.
HitRegion :: struct {
    id: u64;
    frame: Frame;
    policy: ?Closure(Point) -> HitPolicy = null;   // null = .tap everywhere
    // Tap registration IS the region declaration: the router runs the CURRENT
    // committed snapshot's handler at recognition — fire-time resolution,
    // never a retained callback.
    onTap: ?Closure() = null;
}

// Stateful builder — views use this to emit render nodes

RenderContext :: struct {
    tree: *RenderTree;
    clipDepth: i64;
    opacity: f32;
    depth: i64;
    // Optional hit/focus sinks: the frame loop points these at the
    // committed snapshot's lists; null (the default) makes
    // declarations no-ops.
    hits: *List(HitRegion) = null;
    focuses: *List(FocusRegion) = null;

    init :: (tree: *RenderTree) -> RenderContext {
        RenderContext{
            tree = tree,
            clipDepth = 0,
            opacity = 1.0,
            depth = 0
        }
    }

    hitRegion :: (self: *RenderContext, id: u64, frame: Frame, policy: ?Closure(Point) -> HitPolicy = null, onTap: ?Closure() = null) {
        if self.hits != null {
            self.hits.append(.{ id = id, frame = frame, policy = policy, onTap = onTap });
        }
    }

    focusRegion :: (self: *RenderContext, id: u64, frame: Frame, onKey: ?Closure(*KeyEvent) = null, onText: ?Closure(string) = null, wantsKeyboard: bool = false, onComposition: ?Closure(*CompositionEvent) = null, onDeleteBackward: ?Closure() = null) {
        if self.focuses != null {
            self.focuses.append(.{ id = id, frame = frame, onKey = onKey, onText = onText,
                onComposition = onComposition, onDeleteBackward = onDeleteBackward, wantsKeyboard = wantsKeyboard });
        }
    }

    addRect :: (self: *RenderContext, frame: Frame, fill: Color) {
        self.tree.add(.{
            type = .rect,
            frame = frame,
            fillColor = fill,
            opacity = self.opacity,
            depth = self.depth,
        });
        self.depth += 1;
    }

    addRoundedRect :: (self: *RenderContext, frame: Frame, fill: Color, radius: f32) {
        self.tree.add(.{
            type = .roundedRect,
            frame = frame,
            fillColor = fill,
            cornerRadius = radius,
            opacity = self.opacity,
            depth = self.depth,
        });
        self.depth += 1;
    }

    addStrokedRect :: (self: *RenderContext, frame: Frame, fill: Color, stroke: Color, strokeW: f32, radius: f32) {
        self.tree.add(.{
            type = .roundedRect,
            frame = frame,
            fillColor = fill,
            strokeColor = stroke,
            strokeWidth = strokeW,
            cornerRadius = radius,
            opacity = self.opacity,
            depth = self.depth,
        });
        self.depth += 1;
    }

    addText :: (self: *RenderContext, frame: Frame, text: string, fontSize: f32, color: Color) {
        self.tree.add(.{
            type = .text,
            frame = frame,
            text = text,
            fontSize = fontSize,
            textColor = color,
            opacity = self.opacity,
            depth = self.depth,
        });
        self.depth += 1;
    }

    addImage :: (self: *RenderContext, frame: Frame, textureId: u32) {
        self.addImageUv(frame, textureId, Point.zero(), Point{ x = 1.0, y = 1.0 });
    }

    addImageUv :: (self: *RenderContext, frame: Frame, textureId: u32, uvMin: Point, uvMax: Point) {
        self.tree.add(.{
            type = .image,
            frame = frame,
            textureId = textureId,
            uvMin = uvMin,
            uvMax = uvMax,
            opacity = self.opacity,
            depth = self.depth,
        });
        self.depth += 1;
    }

    // Draw a triangle range of the mesh the renderer holds (UIRenderer.setMesh).
    // `transform` takes mesh positions all the way to clip space, so the node
    // carries no frame; depth testing is on for the range and off again after
    // it.
    addMesh :: (self: *RenderContext, indexFirst: i32, indexCount: i32, transform: Mat4, tint: Color) {
        self.tree.add(.{
            type = .mesh,
            meshIndexFirst = indexFirst,
            meshIndexCount = indexCount,
            meshTransform = transform,
            fillColor = tint,
            opacity = self.opacity,
            depth = self.depth,
        });
        self.depth += 1;
    }

    // Draw a triangle range of the skinned mesh the renderer holds
    // (UIRenderer.setSkinnedMesh), skinned against the palette last given
    // to UIRenderer.setBonePalette. `transform` takes skinned positions to
    // clip space; depth testing is on for the range and off again after it.
    addSkinnedMesh :: (self: *RenderContext, indexFirst: i32, indexCount: i32, transform: Mat4, tint: Color) {
        self.tree.add(.{
            type = .skinnedMesh,
            meshIndexFirst = indexFirst,
            meshIndexCount = indexCount,
            meshTransform = transform,
            fillColor = tint,
            opacity = self.opacity,
            depth = self.depth,
        });
        self.depth += 1;
    }

    pushClip :: (self: *RenderContext, frame: Frame) {
        self.tree.add(.{
            type = .clipPush,
            frame = frame,
            depth = self.depth,
        });
        self.clipDepth += 1;
    }

    popClip :: (self: *RenderContext) {
        self.tree.add(.{
            type = .clipPop,
            depth = self.depth,
        });
        self.clipDepth -= 1;
    }

    pushOpacity :: (self: *RenderContext, alpha: f32) {
        prev := self.opacity;
        self.opacity = prev * alpha;
        self.tree.add(.{
            type = .opacityPush,
            opacity = self.opacity,
            depth = self.depth,
        });
    }

    popOpacity :: (self: *RenderContext, prevOpacity: f32) {
        self.tree.add(.{
            type = .opacityPop,
            depth = self.depth,
        });
        self.opacity = prevOpacity;
    }
}
