// The compose library's frame loop.
//
// A `UiRoot` owns everything that outlives a build — the identity tally, the
// state store, both routers, the input queue and the committed snapshot. A
// `FrameLoop` owns the builder closure it was handed, so its `deinit` frees
// that closure's captured environment.
//
// One frame runs in one order: what the queue holds is consumed against the
// frame that committed BEFORE it, the builder then rebuilds under the state
// those handlers left, and the result becomes the frame the next one routes
// against. That is what lets a tap taken in frame N be read by frame N+1's
// build.
//
// A frame's memory comes from an arena pushed as the ambient allocator for the
// whole frame, so the tree, the handler environments and the snapshot lists are
// reclaimed together and no builder threads an allocator. There are two arenas
// taken in turn, because the frame that committed is still being routed against
// while the next one builds: what a frame allocates lives until the frame after
// next takes its arena back. Frames therefore run at a fixed memory ceiling.
#import "modules/std.sx"
#import "modules/std/core.sx"
#import "modules/std/mem.sx"
#import "modules/ui/types.sx"
#import "modules/ui/render.sx"
#import "modules/ui/input.sx"
#import "modules/ui/compose/view.sx"
#import "modules/ui/compose/identity.sx"
#import "modules/ui/compose/state.sx"
#import "modules/ui/compose/frame.sx"
#import "modules/ui/compose/input.sx"
#import "modules/ui/compose/focus.sx"

// What a frame arena starts with. A reset keeps the largest chunk, so the pair
// settles at the high-water mark of one frame and allocates nothing after.
FRAME_ARENA_BYTES :: 8192

UiRoot :: struct {
    id: UiRootId = .{ value = 0 }
    viewport: Size = .{ width = 0.0, height = 0.0 }
    identity: Identity
    store: StateStore
    taps: Router
    focus: FocusRouter = .{}
    queue: InputQueue
    snapshot: CommittedUiSnapshot = .{}
    arenas: [2]Arena
    parity: i64 = 0

    init :: (viewport: Size, id: UiRootId = .{ value = 0 }, gpa: Allocator = context.allocator) -> UiRoot {
        UiRoot{
            id = id,
            viewport = viewport,
            identity = Identity.init(gpa),
            store = StateStore.init(gpa),
            taps = Router.init(gpa),
            queue = InputQueue.init(gpa),
            arenas = .[Arena.init(gpa, FRAME_ARENA_BYTES), Arena.init(gpa, FRAME_ARENA_BYTES)],
        }
    }

    // The queue is this root's own, so every event in it reaches both routers.
    pump :: (self: *UiRoot) {
        self.queue.drain((e: *InputEvent) {
            self.taps.dispatch(e)
            self.focus.dispatch(e)
        })
    }

    // Where a built tree becomes the committed frame: it projects, names its
    // root, and both routers start resolving against it. The outgoing lists
    // came from the arena the frame before this one built in, so they go
    // instead of being refilled.
    commit :: (self: *UiRoot, tree: *View) {
        self.snapshot.discard()
        project(tree, self.viewport, *self.snapshot)
        self.snapshot.root = self.id
        self.taps.observe(*self.snapshot)
        self.focus.observe(*self.snapshot)
    }

    // The snapshot's lists are the arenas' memory, so releasing the arenas is
    // what releases them.
    deinit :: (self: *UiRoot) {
        self.queue.deinit()
        self.taps.deinit()
        self.store.teardown()
        self.identity.deinit()
        self.arenas[0].deinit()
        self.arenas[1].deinit()
    }
}

// The builder runs under the root's context, so `use_state`, `element_id` and
// the press/focus queries all reach this root's carriers.
FrameLoop :: struct {
    root: *UiRoot
    build: Closure() -> View
    build_allocator: Allocator
    frames: i64 = 0

    // `build_allocator` is the allocator that made `build`'s environment — the
    // one ambient where the literal is written, which need not be the one
    // ambient here. The free is paired with it.
    init :: (root: *UiRoot, build: Closure() -> View, build_allocator: Allocator) -> FrameLoop =>
        .{ root = root, build = build, build_allocator = build_allocator }

    deinit :: (self: *FrameLoop) {
        free(self.build, self.build_allocator)
    }

    frame :: (self: *FrameLoop) {
        r := self.root
        // The frame takes the arena the committed snapshot does NOT hold, so
        // the reset falls on memory two frames old — dead since the frame
        // before this one committed over it.
        r.parity = 1 - r.parity
        r.arenas[r.parity].reset()
        push .{
            allocator = r.arenas[r.parity],
            compose_ui = *r.identity,
            compose_state = *r.store,
            compose_input = *r.taps,
            compose_focus = *r.focus,
        } {
            r.pump()
            r.identity.begin_build()
            r.store.begin_build()
            tree := self.build()
            r.store.commit_build()
            r.commit(*tree)
        }
        self.frames += 1
    }

    run :: (self: *FrameLoop, n: i64) {
        for 0..n {
            self.frame()
        }
    }
}
