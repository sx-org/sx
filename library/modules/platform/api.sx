@import "modules/std.sx";
@import "modules/ui/types.sx";
@import "modules/platform/types.sx";

// A Platform is a named long-lived singleton (an SDL window, the UIKit app,
// the Android surface owner) that the app mutates through BOTH the erased
// handle and concrete ones — a handle borrows the named object's storage,
// never copies it (a snapshot would fork the live platform state).
Platform :: interface {
    init :: (self: *Self, title: [:0]u8, w: i32, h: i32) -> bool;

    runFrameLoop :: (self: *Self, frameFn: Closure());

    pollEvents :: (self: *Self) -> []PlatformEvent;

    beginFrame :: (self: *Self) -> FrameContext;
    endFrame :: (self: *Self);

    safeInsets :: (self: *Self) -> EdgeInsets;
    keyboard :: (self: *Self) -> KeyboardState;
    showKeyboard :: (self: *Self);
    hideKeyboard :: (self: *Self);

    // Request the run loop to stop. On iOS/Android this is a no-op
    // (mobile apps don't quit on user request); on SDL it tears down the
    // `while !quit` loop.
    stop :: (self: *Self);

    shutdown :: (self: *Self);
}
