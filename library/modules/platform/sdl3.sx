@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/build.sx";
@import "modules/ffi/opengl.sx";
@import "modules/ffi/sdl3.sx";
@import "modules/ui/types.sx";
@import "modules/ui/input.sx";
@import "modules/platform/types.sx";
@import "modules/platform/api.sx";

gSdlPlat : *SdlPlatform = null;

chdir :: (path: [*]u8) -> i32 extern;
SDL_GetBasePath :: () -> [*]u8 extern;

// A macOS `.app` launched via Finder / `open` starts with CWD=`/`, so a
// game's CWD-relative asset loads (`read_file_bytes("assets/...")`) miss and
// the app crashes loading fonts/textures. SDL's base path is the directory
// holding the executable — inside the `.app`, where the bundler copied
// `assets/`. chdir there, but ONLY when actually running from within a `.app`
// bundle, so the `sx run` dev flow (binary not bundled, assets in the project
// CWD) is left alone. Mirrors uikit.sx's iOS `chdirToBundle`.
sdlChdirToBundle :: () {
    inline if @host.os != .macos { return; }
    bp := SDL_GetBasePath();
    if bp == null { return; }
    // Reorient only when the base path lives inside a `.app` bundle.
    i : i64 = 0;
    found := false;
    while bp[i] != '\0' {
        if bp[i] == '.' and bp[i + 1] == 'a' and bp[i + 2] == 'p' and bp[i + 3] == 'p' {
            found = true;
            break;
        }
        i = i + 1;
    }
    if found { chdir(bp); }
}

SdlGpuMode :: enum {
    opengl;
    metal;
}

SdlPlatform :: struct {
    window: *void = null;
    glCtx: *void = null;
    metalView: *void = null;
    gpuMode: SdlGpuMode = .opengl;
    running: bool = true;

    width: i32 = 0;
    height: i32 = 0;
    pixelW: i32 = 0;
    pixelH: i32 = 0;
    dpiScale: f32 = 1.0;

    deltaTime: f32 = 0.008;
    lastPerf: u64 = 0;

    frameClosure: Closure() = ---;
    hasFrameClosure: bool = false;

    events: List(PlatformEvent) = .{};
}

// Map an SDL keycode to the neutral LogicalKey. Only the keys apps
// consume are mapped; everything else is `.unknown`. Letters/digits
// arrive as TEXT, not keys.
logicalKeyFromSdl :: (k: SDL_Keycode) -> LogicalKey {
    match k {
        case .escape:     return .escape;
        case .returnKey: return .enter;
        case .space:      return .space;
        case .tab:        return .tab;
        case .backspace:  return .backspace;
        case .deleteKey: return .delete;
        case .left:       return .left;
        case .right:      return .right;
        case .up:         return .up;
        case .down:       return .down;
    }
    .unknown
}

sdlModifiers :: (m: SDL_Keymod) -> InputModifiers {
    InputModifiers{
        shift   = (m & (SDL_Keymod.lshift | SDL_Keymod.rshift)) != 0,
        control = (m & (SDL_Keymod.lctrl | SDL_Keymod.rctrl)) != 0,
        alt     = (m & (SDL_Keymod.lalt | SDL_Keymod.ralt)) != 0,
        meta    = (m & (SDL_Keymod.lgui | SDL_Keymod.rgui)) != 0,
    }
}

// Translate one SDL event into the platform stream — normalization-faithful:
// buttonless motion is a HOVER, not a move; wheel deltas normalize the
// flipped direction; timestamps are SDL's nanosecond event times.
translateSdlEvent :: (sdl: *SDL_Event) -> ?PlatformEvent {
    match sdl {
        case .quit: {
            return .quit;
        }
        case .windowResized: |data| {
            return .windowResize(.{ width = data.data1, height = data.data2 });
        }
        case .keyDown: |data| {
            return .input(.keyDown(.{
                header = .{ timeNs = data.timestamp, modifiers = sdlModifiers(data.mod) },
                physical = .{ code = data.scancode },
                logical = logicalKeyFromSdl(data.key),
                repeat = data.repeat != 0,
            }));
        }
        case .keyUp: |data| {
            return .input(.keyUp(.{
                header = .{ timeNs = data.timestamp, modifiers = sdlModifiers(data.mod) },
                physical = .{ code = data.scancode },
                logical = logicalKeyFromSdl(data.key),
            }));
        }
        case .mouseMotion: |data| {
            pe : PointerEvent = .{
                header = .{ timeNs = data.timestamp },
                pointer = .{ value = data.which.(u64) },
                kind = .mouse,
                position = .{ x = data.x, y = data.y },
            };
            if data.state == 0 { return .input(.pointerHover(pe)); }
            return .input(.pointerMove(pe));
        }
        case .mouseButtonDown: |data| {
            return .input(.pointerDown(sdlPointerButton(data)));
        }
        case .mouseButtonUp: |data| {
            return .input(.pointerUp(sdlPointerButton(data)));
        }
        case .mouseWheel: |data| {
            flip : f32 = if data.direction == 1 then -1.0 else 1.0;
            return .input(.scroll(.{
                header = .{ timeNs = data.timestamp },
                pointer = .{ value = data.which.(u64) },
                position = .{ x = data.mouseX, y = data.mouseY },
                delta = .{ x = data.x * flip, y = data.y * flip },
            }));
        }
    }
    null
}

sdlPointerButton :: (data: SDL_MouseButtonData) -> PointerEvent {
    btn : PointerButton = match data.button {
        case 1: .primary;
        case 2: .middle;
        case 3: .secondary;
        else: .none;
    };
    PointerEvent{
        header = .{ timeNs = data.timestamp },
        pointer = .{ value = data.which.(u64) },
        kind = .mouse,
        button = btn,
        position = .{ x = data.x, y = data.y },
    }
}

impl Platform for SdlPlatform {
    init :: (self: *SdlPlatform, title: [:0]u8, w: i32, h: i32) -> bool {
        self.running = true;
        self.hasFrameClosure = false;
        self.deltaTime = 0.008;
        self.dpiScale = 1.0;
        SDL_Init(SDL_INIT_VIDEO);
        // Find bundled assets when launched as a `.app` (CWD=/ under Finder).
        sdlChdirToBundle();

        inline match @host.os {
            case .wasm: {
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
            }
            case .ios: {
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
            }
            else: {
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
                SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
            }
        }
        SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
        SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24);

        initW := w;
        initH := h;
        inline match @host.os {
            case .wasm: {
                initW = c.emscripten_run_script_int("window.innerWidth");
                initH = c.emscripten_run_script_int("window.innerHeight");
            }
            else: {
                displayId := SDL_GetPrimaryDisplay();
                bounds : SDL_Rect = ---;
                if SDL_GetDisplayUsableBounds(displayId, *bounds) {
                    initW = bounds.w * 3 / 4;
                    initH = bounds.h * 3 / 4;
                }
            }
        }

        windowFlags: u64 = SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY;
        if self.gpuMode == .opengl {
            windowFlags |= SDL_WINDOW_OPENGL;
        } else {
            windowFlags |= SDL_WINDOW_METAL;
        }

        self.window = SDL_CreateWindow(title, initW, initH, windowFlags);
        if self.window == null { return false; }

        if self.gpuMode == .opengl {
            self.glCtx = SDL_GL_CreateContext(self.window);
            SDL_GL_MakeCurrent(self.window, self.glCtx);
            // Vsync: pace swaps to the display refresh. Without this the frame
            // loop free-runs and pins every core it can get (interval 0 =
            // immediate). Ignored on wasm, where emscripten's rAF loop paces.
            SDL_GL_SetSwapInterval(1);
            loadGl(SDL_GL_GetProcAddress);
        } else {
            self.metalView = SDL_Metal_CreateView(self.window);
        }

        SDL_GetWindowSize(self.window, *self.width, *self.height);
        SDL_GetWindowSizeInPixels(self.window, *self.pixelW, *self.pixelH);
        wf : f32 = self.width.(f32);
        pw : f32 = self.pixelW.(f32);
        self.dpiScale = if wf > 0.0 then pw / wf else 1.0;

        if self.gpuMode == .opengl {
            glViewport(0, 0, self.pixelW, self.pixelH);
        }

        gSdlPlat = self;
        self.lastPerf = SDL_GetPerformanceCounter();
        true
    }

    runFrameLoop :: (self: *SdlPlatform, frameFn: Closure()) {
        self.frameClosure = frameFn;
        self.hasFrameClosure = true;
        gSdlPlat = self;

        inline match @host.os {
            case .wasm: {}
            else: { SDL_AddEventWatch(*sdlEventWatch, self); }
        }

        inline match @host.os {
            case .wasm: { c.emscripten_set_main_loop(*sdlWasmTick, 0, 1); }
            else: {
                while self.running {
                    frameFn();
                }
            }
        }
    }

    pollEvents :: (self: *SdlPlatform) -> []PlatformEvent {
        self.events.len = 0;
        sdlEvent : SDL_Event = .none;
        while SDL_PollEvent(*sdlEvent) {
            match sdlEvent {
                case .quit: { self.running = false; }
                case .windowResized: |data| {
                    self.width = data.data1;
                    self.height = data.data2;
                    SDL_GetWindowSizeInPixels(self.window, *self.pixelW, *self.pixelH);
                }
            }
            if pe := translateSdlEvent(*sdlEvent) {
                self.events.append(pe);
            }
        }

        result : []PlatformEvent = ---;
        result.ptr = self.events.items.ptr;
        result.len = self.events.len;
        result
    }

    beginFrame :: (self: *SdlPlatform) -> FrameContext {
        current := SDL_GetPerformanceCounter();
        freq := SDL_GetPerformanceFrequency();
        if freq > 0 and self.lastPerf > 0 {
            diff : f32 = (current - self.lastPerf).(f32);
            fr : f32 = freq.(f32);
            self.deltaTime = diff / fr;
        }
        self.lastPerf = current;

        inline match @host.os {
            case .wasm: {
                newW : i32 = 0;
                newH : i32 = 0;
                SDL_GetWindowSize(self.window, *newW, *newH);
                if newW != self.width or newH != self.height {
                    self.width = newW;
                    self.height = newH;
                    SDL_GetWindowSizeInPixels(self.window, *self.pixelW, *self.pixelH);
                }
            }
            else: {}
        }

        FrameContext{
            viewportW = self.width,
            viewportH = self.height,
            pixelW = self.pixelW,
            pixelH = self.pixelH,
            dpiScale = self.dpiScale,
            deltaTime = self.deltaTime,
        }
    }

    endFrame :: (self: *SdlPlatform) {
        if self.running {
            if self.gpuMode == .opengl {
                SDL_GL_SwapWindow(self.window);
            }
        }
    }

    safeInsets :: (self: *SdlPlatform) -> EdgeInsets {
        EdgeInsets.zero()
    }

    keyboard :: (self: *SdlPlatform) -> KeyboardState {
        KeyboardState.zero()
    }

    showKeyboard :: (self: *SdlPlatform) { }
    hideKeyboard :: (self: *SdlPlatform) { }

    stop :: (self: *SdlPlatform) {
        self.running = false;
    }

    shutdown :: (self: *SdlPlatform) {
        inline match @host.os {
            case .wasm: {}
            else: {
                SDL_GL_DestroyContext(self.glCtx);
                SDL_DestroyWindow(self.window);
                SDL_Quit();
            }
        }
    }
}

// SDL fires the watch synchronously when events are added — including during
// macOS's modal resize-drag, when SDL_PollEvent can't run. Re-invoking the
// frame closure here keeps content rendering at the new size during the drag.
sdlEventWatch :: (userdata: *void, event: *SDL_Event) -> bool abi(.c) {
    plat : *SdlPlatform = userdata.(*SdlPlatform);
    match event.* {
        case .windowResized: |data| {
            plat.width = data.data1;
            plat.height = data.data2;
            SDL_GetWindowSizeInPixels(plat.window, *plat.pixelW, *plat.pixelH);
            if plat.hasFrameClosure {
                fn := plat.frameClosure;
                fn();
            }
        }
    }
    true
}

sdlWasmTick :: () abi(.c) {
    if gSdlPlat == null { return; }
    if !gSdlPlat.hasFrameClosure { return; }
    fn := gSdlPlat.frameClosure;
    fn();
}
