// Pure UIKit + CAEAGLLayer + CADisplayLink backend for iOS.
//
// Linking is per-target via the game's build.sx (`opts.addFramework("UIKit")`
// + `opts.addFramework("OpenGLES")` + `opts.addFramework("QuartzCore")` on
// `.ios`). iOS-only by nature: platform selection lives at the consumer
// seam, not per-function here — touching this host on another target
// fails at link/JIT with the UIKit symbol named.

@import "modules/std.sx";
@import "modules/ffi/objc.sx";
@import "modules/ffi/quartzcore.sx";
@import "modules/build.sx";
@import "modules/ffi/opengl.sx";
@import "modules/ui/types.sx";
@import "modules/ui/input.sx";
@import "modules/platform/types.sx";
@import "modules/platform/api.sx";

UIApplicationMain :: (argc: i32, argv: *void, principalClass: *NSString, delegateClass: *NSString) -> i32 extern;
dlsym             :: (handle: *void, name: [*]u8) -> *void extern;
chdir             :: (path: [*]u8) -> i32 extern;

// kEAGLRenderingAPIOpenGLES3 = 3
EAGL_API_GLES3 :: 3;

// CGFloat is a `double` on 64-bit Apple platforms; CGPoint = {x, y} fits in
// 16 bytes and returns via the FP-register path on arm64.
CGPoint :: struct { x: f64; y: f64; }

// UIEdgeInsets = {top, left, bottom, right} CGFloats — 32 bytes; exceeds the
// 16-byte registers cutoff so it returns via the x8 indirect-result-pointer
// convention. sx generates the right call sequence when the function-pointer
// type declares it as a by-value struct return.
UIEdgeInsets :: struct {
    top: f64;
    left: f64;
    bottom: f64;
    right: f64;
}

// NSRange = {NSUInteger location; NSUInteger length}. The Obj-C type
// encoding carries the struct's NAME, and UIKit declares its text-input
// selectors against `{_NSRange=QQ}` — hence the leading underscore.
_NSRange :: struct { location: u64; length: u64; }

// ── Foundation utility classes ─────────────────────────
// Declarative `@ObjcClass` bindings replace the previous
// `objc_getClass(...) + @ObjcCall(T, ...)` pattern. Each method's sx-
// side name maps to its Obj-C selector via the default mangling rule
// (split on `_`; each piece becomes a keyword with `:`).

NSNumber :: @ObjcClass("NSNumber", extends = NSObject) extern {
    // Class method (no `self: *Self` first param → static dispatch).
    numberWithBool :: (b: i8) -> *NSNumber;
    doubleValue    :: (self: *Self) -> f64;
    integerValue   :: (self: *Self) -> i64;
}

NSValue :: @ObjcClass("NSValue", extends = NSObject) extern {
    CGRectValue :: (self: *Self) -> CGRect;
}

NSDictionary :: @ObjcClass("NSDictionary", extends = NSObject) extern {
    objectForKey :: (self: *Self, key: *void) -> *void;
}

NSNotification :: @ObjcClass("NSNotification", extends = NSObject) extern {
    userInfo :: (self: *Self) -> *NSDictionary;
}

NSNotificationCenter :: @ObjcClass("NSNotificationCenter", extends = NSObject) extern {
    defaultCenter :: () -> *NSNotificationCenter;
    addObserver_selector_name_object :: (self: *Self, observer: *void, sel: *void, name: *NSString, obj: *void);
}

UIKeyboardWillChangeFrameNotification  : *NSString extern;
UIKeyboardFrameEndUserInfoKey          : *NSString extern;
UIKeyboardAnimationDurationUserInfoKey : *NSString extern;
UIKeyboardAnimationCurveUserInfoKey    : *NSString extern;

NSMutableDictionary :: @ObjcClass("NSMutableDictionary", extends = NSDictionary) extern {
    dictionary         :: () -> *NSMutableDictionary;
    setObject_forKey   :: (self: *Self, obj: *void, key: *void);
}

NSSet :: @ObjcClass("NSSet", extends = NSObject) extern {
    anyObject :: (self: *Self) -> *void;
}

NSArray :: @ObjcClass("NSArray", extends = NSObject) extern {
    array         :: () -> *NSArray;
    count         :: (self: *Self) -> u64;
    objectAtIndex :: (self: *Self, index: u64) -> *void;
}

// ── Bundle ─────────────────────────────────────────────

NSBundle :: @ObjcClass("NSBundle", extends = NSObject) extern {
    mainBundle   :: () -> *NSBundle;
    resourcePath :: (self: *Self) -> *NSString;
}

// ── RunLoop + display timing ────────────────────────────

NSRunLoop :: @ObjcClass("NSRunLoop", extends = NSObject) extern {
    currentRunLoop :: () -> *NSRunLoop;
}

// CFRunLoop recognizes the common-modes pseudo-mode by pointer identity
// with this constant; an NSString with the same characters names an
// ordinary mode the loop never runs.
kCFRunLoopCommonModes : *NSString extern;

CADisplayLink :: @ObjcClass("CADisplayLink", extends = NSObject) extern {
    displayLinkWithTarget_selector :: (target: *void, sel: *void) -> *CADisplayLink;
    addToRunLoop_forMode :: (self: *Self, runloop: *NSRunLoop, mode: *NSString);
    targetTimestamp :: (self: *Self) -> f64;
    duration :: (self: *Self) -> f64;
    setPreferredFramesPerSecond :: (self: *Self, fps: i64);
}

// ── View tree + GL drawables ────────────────────────────
// (Declared before UIView so `layer :: (...) -> *CALayer` can reference it.)

// CALayer / CAEAGLLayer / CAMetalLayer live in modules/ffi/quartzcore.sx
// (shared with gpu/metal.sx — one decl per runtime class).

EAGLContext :: @ObjcClass("EAGLContext", extends = NSObject) extern {
    alloc                            :: () -> *EAGLContext;
    initWithAPI                      :: (self: *Self, api: i32) -> *EAGLContext;
    setCurrentContext                :: (ctx: *EAGLContext);
    renderbufferStorage_fromDrawable :: (self: *Self, target: u32, drawable: *void) -> i8;
    presentRenderbuffer              :: (self: *Self, target: u32) -> i8;
}

// ── UIKit chrome ────────────────────────────────────────

UIScreen :: @ObjcClass("UIScreen", extends = NSObject) extern {
    mainScreen  :: () -> *UIScreen;
    nativeScale :: (self: *Self) -> f64;
    maximumFramesPerSecond :: (self: *Self) -> i64;
}

// UIResponder is the root for keyboard / touch / focus dispatch.
// Most UIKit classes inherit from it; sx-defined classes that
// participate in lifecycle callbacks (delegates, scene delegates)
// extend it so the runtime picks up the responder-chain behavior.
UIResponder :: @ObjcClass("UIResponder", extends = NSObject) extern {
    becomeFirstResponder :: (self: *Self) -> i8;
    resignFirstResponder :: (self: *Self) -> i8;
}

UIView :: @ObjcClass("UIView", extends = UIResponder) extern {
    safeAreaInsets        :: (self: *Self) -> UIEdgeInsets;
    layer                 :: (self: *Self) -> *CALayer;
    setContentScaleFactor :: (self: *Self, scale: f64);
    bounds                :: (self: *Self) -> CGRect;
    subviews              :: (self: *Self) -> *NSArray;
    superview             :: (self: *Self) -> *UIView;
    isFirstResponder      :: (self: *Self) -> BOOL;
    addGestureRecognizer  :: (self: *Self, recognizer: *void);
    convertRect_fromView  :: (self: *Self, rect: CGRect, view: *void) -> CGRect;
}

// The keyboard's own window. It is private and outside the app's window
// list, and the class vends the live one.
UIRemoteKeyboardWindow :: @ObjcClass("UIRemoteKeyboardWindow", extends = UIWindow) extern {
    remoteKeyboardWindowForScreen_create :: (screen: *UIScreen, create: BOOL) -> *UIRemoteKeyboardWindow;
}

// UIGestureRecognizerState values the keyboard pan reads.
UI_GESTURE_BEGAN     :: 1;
UI_GESTURE_CHANGED   :: 2;
UI_GESTURE_ENDED     :: 3;
UI_GESTURE_CANCELLED :: 4;
UI_GESTURE_FAILED    :: 5;

UIGestureRecognizer :: @ObjcClass("UIGestureRecognizer", extends = NSObject) extern {
    state                   :: (self: *Self) -> i64;
    setCancelsTouchesInView :: (self: *Self, cancels: BOOL);
    locationInView          :: (self: *Self, view: *void) -> CGPoint;
}

UIPanGestureRecognizer :: @ObjcClass("UIPanGestureRecognizer", extends = UIGestureRecognizer) extern {
    alloc                 :: () -> *UIPanGestureRecognizer;
    initWithTarget_action :: (self: *Self, target: *void, action: *void) -> *UIPanGestureRecognizer;
    velocityInView        :: (self: *Self, view: *void) -> CGPoint;
}

UIWindow :: @ObjcClass("UIWindow", extends = UIView) extern {
    alloc                  :: () -> *UIWindow;
    initWithWindowScene    :: (self: *Self, scene: *void) -> *UIWindow;
    setRootViewController  :: (self: *Self, vc: *void);
    makeKeyAndVisible      :: (self: *Self);
    screen                 :: (self: *Self) -> *UIScreen;
}

UIViewController :: @ObjcClass("UIViewController", extends = UIResponder) extern {
    alloc   :: () -> *UIViewController;
    init    :: (self: *Self) -> *UIViewController;
    setView :: (self: *Self, view: *void);
}

UITouch :: @ObjcClass("UITouch", extends = NSObject) extern {
    locationInView :: (self: *Self, view: *void) -> CGPoint;
}

// ── Text input ──────────────────────────────────────────
// UITextPosition and UITextRange are abstract — a conforming view mints
// its own subclasses and UIKit hands them straight back, so the concrete
// pair lives in the app shell (platform/uikit_app.sx).

UITextPosition :: @ObjcClass("UITextPosition", extends = NSObject) extern {
}

UITextRange :: @ObjcClass("UITextRange", extends = NSObject) extern {
}

UITextInputStringTokenizer :: @ObjcClass("UITextInputStringTokenizer", extends = NSObject) extern {
    alloc             :: () -> *UITextInputStringTokenizer;
    initWithTextInput :: (self: *Self, textInput: *void) -> *UITextInputStringTokenizer;
}

UITextInputDelegate :: @ObjcProtocol("UITextInputDelegate") extern {
    textWillChange :: (self: *Self, textInput: *void);
    textDidChange  :: (self: *Self, textInput: *void);
}

// GLenum constants for renderbuffer/framebuffer setup that aren't in opengl.sx's
// loader path (they live on the framework's symbol table directly).
GL_RENDERBUFFER          :u32: 0x8D41;
GL_FRAMEBUFFER           :u32: 0x8D40;
GL_COLOR_ATTACHMENT0     :u32: 0x8CE0;
GL_FRAMEBUFFER_COMPLETE  :u32: 0x8CD5;

// Which GPU API the UIKit backend wires up. `.gles` keeps the existing
// CAEAGLLayer + EAGLContext + renderbuffer path; `.metal` swaps the view
// for a CAMetalLayer-backed one and leaves rendering to MetalGPU. Set
// before calling `init`; default `.gles` preserves prior behavior.
GpuMode :: enum {
    gles;
    metal;
}

// A responder flip parked by show/hideKeyboard for the next tick.
PendingResponder :: enum {
    none;
    show;
    hide;
}

UIKitPlatform :: struct {
    window: ?*UIWindow = null;
    rootVc: ?*UIViewController = null;
    // SxGLView (gles mode) or SxMetalView (metal mode) — both extend
    // UIView, so the common method surface is reachable as *UIView.
    glView: ?*UIView = null;
    // CAEAGLLayer (gles) or CAMetalLayer (metal) — both extend CALayer.
    glLayer: ?*CALayer = null;
    glCtx: ?*EAGLContext = null;
    displayLink: ?*CADisplayLink = null;
    colorRenderbuffer: u32 = 0;
    framebuffer: u32 = 0;
    glInitialized: bool = false;
    gpuMode: GpuMode = .gles;
    // The Obj-C class handed to UIApplicationMain as the app delegate.
    // The host ships no app class names: the shell's boot
    // (platform/uikit_app.sx `uikitAppRun`) sets its own, an app with
    // custom delegates sets this to theirs before `runFrameLoop`.
    // Must be a NUL-terminated string (a literal is).
    delegateClassName: string = "";

    viewportW: f32 = 0.0;
    viewportH: f32 = 0.0;
    pixelW: i32 = 0;
    pixelH: i32 = 0;
    dpiScale: f32 = 1.0;

    deltaTime: f32 = 0.016;
    // Latest CADisplayLink.targetTimestamp captured each tick.
    lastTargetTs: f64 = 0.0;

    frameClosure: Closure() = ---;
    hasFrameClosure: bool = false;

    events: List(PlatformEvent) = .{};
    // `pollEvents` composes the batch out of `events` and `imeQueue`.
    // `session` is borrowed from whoever owns the focused field, and the
    // frame republishes it — the text IMPs edit through it alone.
    batch: List(PlatformEvent) = .{};
    imeQueue: InputQueue = .{ gpa = context.allocator };
    session: ?*TextInputSession = null;
    // UIKit's text-input delegate, set through -setInputDelegate:, and
    // the tokenizer it reads back. Neither is the document's.
    inputDelegate: ?*UITextInputDelegate = null;
    tokenizer: ?*UITextInputStringTokenizer = null;

    safeTop: f32 = 0.0;
    safeLeft: f32 = 0.0;
    safeBottom: f32 = 0.0;
    safeRight: f32 = 0.0;

    kb: KeyboardOverlap = .{};
    kbSpring: KeyboardSpring = .{};
    kbInset: f32 = 0.0;
    pendingResponder: PendingResponder = .none;

    savedTitle: [*]u8 = null;
}

// The keyboard's show/hide spring, armed by the will-change-frame
// notification and evaluated at each frame's target timestamp, so the
// overlap is where the keyboard will be when the drawable reaches the
// glass, not where its presentation layer was a frame earlier. `start`
// stays 0 until the first evaluation anchors it — that evaluation runs
// in the display phase of the commit the keyboard's own animation
// begins in, so both springs share a clock origin. A retarget re-arms
// from the current position and velocity.
KeyboardSpring :: struct {
    active: bool = false;
    start: f64 = 0.0;
    duration: f64 = 0.0;
    from: f32 = 0.0;
    to: f32 = 0.0;
    v0: f32 = 0.0;
    // Published bottom-inset endpoints: max(overlap, safe-area) at the
    // spring's from and to, interpolated by the spring's own progress.
    insetFrom: f32 = 0.0;
    insetTo: f32 = 0.0;

    // Overlap `t` seconds into the spring:
    // x(t) = to + (A + Bt)·e^(−ωt), A = from−to, B = v0 + ωA.
    at :: (self: *KeyboardSpring, t: f64) -> f32 {
        a : f64 = self.from.(f64) - self.to.(f64);
        b := self.v0.(f64) + KB_SPRING_OMEGA * a;
        (self.to.(f64) + (a + b * t) * exp(0.0 - KB_SPRING_OMEGA * t)).(f32)
    }

    velocityAt :: (self: *KeyboardSpring, t: f64) -> f32 {
        a : f64 = self.from.(f64) - self.to.(f64);
        b := self.v0.(f64) + KB_SPRING_OMEGA * a;
        ((b - KB_SPRING_OMEGA * (a + b * t)) * exp(0.0 - KB_SPRING_OMEGA * t)).(f32)
    }
}

impl Platform for UIKitPlatform {
    init :: (self: *UIKitPlatform, title: [:0]u8, w: i32, h: i32) -> bool {
        self.dpiScale = 1.0;
        self.deltaTime = 0.016;
        self.hasFrameClosure = false;
        self.glInitialized = false;
        self.kb = .{};
        self.kbSpring = .{};
        self.pendingResponder = .none;
        self.savedTitle = title.ptr;
        self.events = .{};
        self.batch = .{};
        self.imeQueue = InputQueue.init(context.allocator);
        self.session = null;
        self.inputDelegate = null;
        self.tokenizer = null;

        // iOS apps start with CWD=/. chdir to the bundle's resourcePath so the
        // game's relative `fopen("assets/...")` calls find their data — must
        // happen BEFORE any code that loads fonts/textures from disk.
        uikitChdirToBundle();
        if self.gpuMode == .gles {
            self.createGlContext();
        } else {
            // Metal mode: skip EAGL. dpiScale still needs to be known
            // before the window exists so callers can size resources.
            self.readScreenScale();
        }
        true
    }

    // Boots UIKit with the app-delegate class named in
    // `self.delegateClassName` — the host ships no app class names;
    // the shell's boot (platform/uikit_app.sx `uikitAppRun`) or the
    // app's own sets the field first. The name goes in the
    // delegateClassName slot: the delegate is a UIResponder, NOT the
    // UIApplication subclass — pass nil for the principal so UIKit uses
    // the default UIApplication. Passing it as the principal makes
    // newer UIKit call UIApplication class methods on it (e.g.
    // `+registerAsSystemApp`) → unrecognized selector crash during
    // UIApplicationMain prep.
    runFrameLoop :: (self: *UIKitPlatform, frameFn: Closure()) {
        self.frameClosure = frameFn;
        self.hasFrameClosure = true;
        if self.delegateClassName.len == 0 {
            NSLog(nsstring("[sx] UIKitPlatform.runFrameLoop: delegateClassName unset — boot through uikitAppRun (platform/uikit_app.sx) or set your own delegate class first\n"));
            return;
        }
        UIApplicationMain(0, (0).(*void), (0).(*NSString), nsstring(self.delegateClassName));
    }

    pollEvents :: (self: *UIKitPlatform) -> []PlatformEvent {
        composeEventBatch(*self.batch, *self.events, *self.imeQueue)
    }

    beginFrame :: (self: *UIKitPlatform) -> FrameContext {
        self.refreshSafeInsets();
        FrameContext{
            viewportW = self.viewportW,
            viewportH = self.viewportH,
            pixelW = self.pixelW,
            pixelH = self.pixelH,
            dpiScale = self.dpiScale,
            deltaTime = self.deltaTime,
            targetPresentTime = self.lastTargetTs,
        }
    }

    endFrame :: (self: *UIKitPlatform) {
        if self.gpuMode == .gles {
            self.presentRenderbuffer();
        }
        // Metal mode: caller's gpu.endFrame() handles present.
    }

    safeInsets :: (self: *UIKitPlatform) -> EdgeInsets {
        bottom := self.safeBottom;
        if self.kb.height > bottom { bottom = self.kb.height; }
        if self.kbSpring.active { bottom = self.kbInset; }
        EdgeInsets{
            top = self.safeTop,
            left = self.safeLeft,
            bottom = bottom,
            right = self.safeRight,
        }
    }

    keyboard :: (self: *UIKitPlatform) -> KeyboardState {
        KeyboardState{
            visible = self.kb.visible(),
            height = self.kb.height,
        }
    }

    // The responder flip is deferred to the next display-link tick: the
    // frame closure runs in the layer's display phase, and a keyboard
    // raised or dismissed inside the commit sets its animation up late.
    showKeyboard :: (self: *UIKitPlatform) {
        self.kb.restore();
        self.pendingResponder = .show;
    }

    hideKeyboard :: (self: *UIKitPlatform) {
        if session := self.session {
            session.abandon();
        }
        self.pendingResponder = .hide;
    }

    stop :: (self: *UIKitPlatform) { }

    shutdown :: (self: *UIKitPlatform) { }

    // ── Internal helpers ───────────────────────────────────────────────────

    refreshSafeInsets :: (self: *UIKitPlatform) {
        if glView := self.glView {
            i := glView.safeAreaInsets();
            self.safeTop    = i.top;
            self.safeLeft   = i.left;
            self.safeBottom = i.bottom;
            self.safeRight  = i.right;
        }
    }

    readScreenScale :: (self: *UIKitPlatform) {
        screen := UIScreen.mainScreen();
        self.dpiScale = screen.nativeScale();
    }

    createGlContext :: (self: *UIKitPlatform) {
        // Read the screen scale up-front so callers can size font caches and
        // textures with the right DPI before the window even exists.
        screen := UIScreen.mainScreen();
        self.dpiScale = screen.nativeScale();

        ctx := EAGLContext.alloc().initWithAPI(EAGL_API_GLES3);
        self.glCtx = ctx;
        EAGLContext.setCurrentContext(ctx);

        loadGl(iosGlProc);
    }

    // Allocate the color renderbuffer + framebuffer and bind them. The
    // renderbuffer gets its pixel storage from the CAEAGLLayer via
    // `[ctx renderbufferStorage:GL_RENDERBUFFER fromDrawable:layer]`, so the
    // layer must already be in the view hierarchy at the right size.
    setupRenderbuffer :: (self: *UIKitPlatform) {

        glGenFramebuffers(1, *self.framebuffer);
        glGenRenderbuffers(1, *self.colorRenderbuffer);

        glBindRenderbuffer(GL_RENDERBUFFER, self.colorRenderbuffer);

        if glCtx := self.glCtx {
            if glLayer := self.glLayer {
                glCtx.renderbufferStorage_fromDrawable(GL_RENDERBUFFER, glLayer);
            }
        }

        glBindFramebuffer(GL_FRAMEBUFFER, self.framebuffer);
        glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, self.colorRenderbuffer);

        pw : i32 = 0;
        ph : i32 = 0;
        GL_RENDERBUFFER_WIDTH  :u32: 0x8D42;
        GL_RENDERBUFFER_HEIGHT :u32: 0x8D43;
        glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_WIDTH,  *pw);
        glGetRenderbufferParameteriv(GL_RENDERBUFFER, GL_RENDERBUFFER_HEIGHT, *ph);
        self.pixelW = pw;
        self.pixelH = ph;
        self.viewportW = pw;
        self.viewportH = ph;
        if self.dpiScale > 0.0 {
            self.viewportW = self.viewportW / self.dpiScale;
            self.viewportH = self.viewportH / self.dpiScale;
        }

        glViewport(0, 0, pw, ph);

        status := glCheckFramebufferStatus(GL_FRAMEBUFFER);
        if status != GL_FRAMEBUFFER_COMPLETE {
            NSLog(nsstring("[sx] framebuffer incomplete after renderbuffer setup\n"));
        }
    }

    presentRenderbuffer :: (self: *UIKitPlatform) {
        glBindRenderbuffer(GL_RENDERBUFFER, self.colorRenderbuffer);
        if glCtx := self.glCtx {
            glCtx.presentRenderbuffer(GL_RENDERBUFFER);
        }
    }

    // Metal mode equivalent of setupRenderbuffer's "tell me how big the
    // drawable is in pixels". Reads the layer's bounds in points and scales
    // to pixels via dpiScale.
    computeLayerPixelSize :: (self: *UIKitPlatform) {
        if glView := self.glView {
            b := glView.bounds();

            wPts : f64 = b.width;
            hPts : f64 = b.height;
            self.viewportW = wPts;
            self.viewportH = hPts;

            scale64 : f64 = self.dpiScale.(f64);
            pw : f64 = wPts * scale64;
            ph : f64 = hPts * scale64;
            self.pixelW = pw;
            self.pixelH = ph;
        }
    }

    // ── Obj-C class-method callbacks ────────────────────────────────────
    // The app shell's exported classes (platform/uikit_app.sx) forward
    // to these through the shell's bridge global so the
    // tick/layout/touch/scene/keyboard paths share one implementation.

    // The keyboard's overlap of the view for the frame about to draw. The
    // presentation layer is where the keyboard IS mid-animation; the model
    // frame is already parked at the end of it. Called after the drawable
    // is acquired so the sample and the present share this CATransaction.
    // The keyboard's view is read fresh — UIKit builds one and tears it
    // down with the keyboard.
    sampleKeyboard :: (self: *UIKitPlatform) {
        view : *UIView = ---;
        if v := self.glView { view = v; } else { return; }
        viewBounds := view.bounds();
        viewH : f32 = viewBounds.height;

        // The spring is evaluated at the frame's target timestamp, one
        // vsync ahead of the presentation layer.
        springTop : ?f32 = null;
        if self.kbSpring.active {
            // The keyboard's own animation begins ~20 ms before the
            // commit that follows the responder flip (measured frame by
            // frame against the on-glass keyboard); the spring's clock
            // backdates to it so the field and the keys share an anchor.
            if self.kbSpring.start <= 0.0 { self.kbSpring.start = CACurrentMediaTime() - 0.020; }
            t := self.lastTargetTs - self.kbSpring.start;
            if t < 0.0 { t = 0.0; }
            if t >= self.kbSpring.duration {
                self.kbSpring.active = false;
            } else {
                x := self.kbSpring.at(t);
                springTop = viewH - x;
                // The inset rides the spring's own progress between its
                // endpoints — the panel and the keys share one curve, so
                // the safe-area gap fades as 1 - p(t).
                q : f32 = 1.0;
                span := self.kbSpring.to - self.kbSpring.from;
                if span > 0.5 or span < -0.5 { q = (x - self.kbSpring.from) / span; }
                self.kbInset = self.kbSpring.insetFrom + (self.kbSpring.insetTo - self.kbSpring.insetFrom) * q;
            }
        }

        // Spring frames skip the remote-keyboard view-tree walk; it
        // stalls during bring-up. The layer is fetched while a pan is live.
        top : ?f32 = viewH;
        layer : *CALayer = null;
        needLayer := self.kb.offset != 0.0 or self.kb.grip != .free;
        if springTop == null or needLayer {
            if kbView := uikitKeyboardView() {
                layer = kbView.layer();
                if springTop == null {
                    top = null;
                    live := layer.presentationLayer();
                    if live != null {
                        inView := view.convertRect_fromView(live.frame(), kbView.superview());
                        top = inView.y;
                    }
                }
            }
        }
        if st := springTop { top = st; }
        self.kb.sample(top, viewH);

        // The pan's offset is the keyboard's own displacement, so the keys
        // and the inset move as one.
        if layer != null {
            b := layer.bounds();
            y : f64 = -self.kb.offset.(f64);
            if b.y != y {
                layer.setBounds(CGRect{ x = b.x, y = y, width = b.width, height = b.height });
            }
        }
    }

    // UIKeyboardWillChangeFrame: arms the spring from the current overlap
    // toward the notification's end frame. Curve 7 is the keyboard spring;
    // any other curve, or a zero duration, leaves presentation sampling in
    // charge.
    keyboardWillChangeFrame :: (self: *UIKitPlatform, note: *NSNotification) {
        view : *UIView = ---;
        if v := self.glView { view = v; } else { return; }
        info := note.userInfo();
        if info == null { return; }
        endObj := info.objectForKey(UIKeyboardFrameEndUserInfoKey);
        if endObj == null { return; }

        dur : f64 = 0.0;
        durObj := info.objectForKey(UIKeyboardAnimationDurationUserInfoKey);
        if durObj != null { dur = durObj.(*NSNumber).doubleValue(); }
        curve : i64 = 7;
        curveObj := info.objectForKey(UIKeyboardAnimationCurveUserInfoKey);
        if curveObj != null { curve = curveObj.(*NSNumber).integerValue(); }
        if curve != 7 or dur <= 0.001 { self.kbSpring.active = false; return; }

        end := endObj.(*NSValue).CGRectValue();
        // The keyboard view's model frame is already parked at the end of
        // the animation; when it agrees with the notification's size it is
        // the more accurate end position.
        if kbView := uikitKeyboardView() {
            kf := kbView.layer().frame();
            dw := kf.width - end.width; if dw < 0.0 { dw = 0.0 - dw; }
            dh := kf.height - end.height; if dh < 0.0 { dh = 0.0 - dh; }
            dx := kf.x - end.x; if dx < 0.0 { dx = 0.0 - dx; }
            if dw < 0.5 and dh < 0.5 and dx < 0.5 { end.y = kf.y; }
        }

        bounds := view.bounds();
        viewH : f32 = bounds.height;
        inView := view.convertRect_fromView(end, null);
        overlap : f32 = viewH - inView.y;
        if overlap < 0.0 { overlap = 0.0; }
        if overlap > viewH { overlap = viewH; }

        from : f32 = self.kb.height + self.kb.offset;
        v0 : f32 = 0.0;
        insetFrom : f32 = self.safeBottom;
        if self.kb.height > insetFrom { insetFrom = self.kb.height; }
        if self.kbSpring.active and self.kbSpring.start > 0.0 {
            t := CACurrentMediaTime() - self.kbSpring.start;
            if t < 0.0 { t = 0.0; }
            from = self.kbSpring.at(t);
            v0 = self.kbSpring.velocityAt(t);
            insetFrom = self.kbInset;
        }
        insetTo : f32 = overlap;
        if insetTo < self.safeBottom { insetTo = self.safeBottom; }

        // A small hop of a shown keyboard is the QuickType bar toggling:
        // the field pins to the end height while the bar animates.
        hop := overlap - from;
        if hop < 0.0 { hop = 0.0 - hop; }
        if !self.kbSpring.active and self.kb.height > 0.5 and hop <= 44.1 {
            from = overlap;
            v0 = 0.0;
        }

        self.kbSpring = .{
            active = true,
            start = 0.0,
            duration = dur,
            from = from,
            to = overlap,
            v0 = v0,
            insetFrom = insetFrom,
            insetTo = insetTo,
        };
        self.kbInset = insetFrom;

        // A display this commit anchors the spring's clock in the same
        // transaction the keyboard's animation begins in.
        if self.gpuMode == .metal { view.layer().setNeedsDisplay(); }
    }

    // The pan takes the keyboard only where the swipe starts on the content
    // above it with a field live; from there the finger carries the keys and
    // the inset together.
    keyboardPan :: (self: *UIKitPlatform, recognizer: *UIPanGestureRecognizer) {
        view : *UIView = ---;
        if v := self.glView { view = v; } else { return; }
        bounds := view.bounds();
        viewH : f32 = bounds.height;
        location := recognizer.locationInView(view);
        y : f32 = location.y;
        state := recognizer.state();
        if state == UI_GESTURE_BEGAN {
            if view.isFirstResponder() == 0 { return; }
            if self.kb.height <= 0.5 { return; }
            if y >= viewH - self.kb.height { return; }
            self.kb.grab();
        } else if state == UI_GESTURE_CHANGED {
            self.kb.track(y, viewH);
        } else if state == UI_GESTURE_ENDED {
            velocity := recognizer.velocityInView(view);
            self.kb.letGo(velocity.y);
        } else if state == UI_GESTURE_CANCELLED or state == UI_GESTURE_FAILED {
            self.kb.letGo(0.0);
        }
    }

    // First scene-connect: builds the window, root VC, layer, EAGL props
    // (if gles) and display link around the app shell's view. Called
    // from the scene delegate (platform/uikit_app.sx), which allocates
    // the GL/Metal view — the shell owns the view classes; the view's
    // +layerClass override supplies the right CAEAGLLayer / CAMetalLayer
    // subclass. iOS reads the window back through the delegate's
    // `-window` (`self.window` here backs it).
    sceneWillConnect :: (self: *UIKitPlatform, scene: *void, glView: *UIView) {

        win := UIWindow.alloc().initWithWindowScene(scene);
        self.window = win;

        vc := UIViewController.alloc().init();
        self.rootVc = vc;

        // Set the VC's view BEFORE setRootViewController to avoid a
        // default-view lazy-load.
        self.glView = glView;
        vc.setView(glView);

        win.setRootViewController(vc);

        glLayer := glView.layer();
        self.glLayer = glLayer;

        // Mark the layer opaque (no compositor blend). Required for EAGL +
        // recommended for Metal (CAMetalLayer.opaque defaults YES but doesn't
        // hurt to be explicit).
        glLayer.setOpaque(1);

        if self.gpuMode == .gles {
            // EAGL drawable properties dict required by
            // EAGLContext.renderbufferStorage:fromDrawable: (color format,
            // non-retained backing). Without this dict the renderbuffer
            // allocation silently fails and the framebuffer reports INCOMPLETE.
            nsNo := NSNumber.numberWithBool(0);

            retainedKey    := uikitExternNsstring("kEAGLDrawablePropertyRetainedBacking".ptr);
            colorformatKey := uikitExternNsstring("kEAGLDrawablePropertyColorFormat".ptr);
            rgba8Value     := uikitExternNsstring("kEAGLColorFormatRGBA8".ptr);

            dict := NSMutableDictionary.dictionary();
            dict.setObject_forKey(nsNo, retainedKey);
            dict.setObject_forKey(rgba8Value, colorformatKey);
            eaglLayer : *CAEAGLLayer = glLayer.(*CAEAGLLayer);
            eaglLayer.setDrawableProperties(dict);
        }

        // Match the layer's drawable scale to the screen's native scale so we
        // get pixel-accurate rendering on retina displays. CGFloat is `double`
        // on 64-bit Apple platforms; reading as f32 would clobber the value.
        screen2 := win.screen();
        scale := screen2.nativeScale();
        self.dpiScale = scale;
        glView.setContentScaleFactor(scale);

        // Renderbuffer is allocated lazily in -[SxGLView layoutSubviews] once
        // the layer has its real on-screen bounds. makeKeyAndVisible triggers
        // a layout pass; layoutSubviews calls setupRenderbuffer.
        win.makeKeyAndVisible();

        // CADisplayLink: vsync-driven tick into our SxGLView. The second arg
        // is a SEL value (not a dispatch selector), so it still goes through
        // sel_registerName.
        selTick := sel_registerName("sxTick:".ptr);
        link := CADisplayLink.displayLinkWithTarget_selector(glView, selTick);
        self.displayLink = link;
        fps := screen2.maximumFramesPerSecond();
        if fps < 60 { fps = 60; }
        // The IME keyboard's CAAnimation runs at the display's max Hz
        // (120 on ProMotion); the link has to match or the sample is coarse.
        link.setPreferredFramesPerSecond(fps);
        runloop := NSRunLoop.currentRunLoop();
        link.addToRunLoop_forMode(runloop, kCFRunLoopCommonModes);

        // `cancelsTouchesInView = NO` is what keeps the view's own touches
        // flowing once the pan recognizes.
        pan := UIPanGestureRecognizer.alloc().initWithTarget_action(
            glView, sel_registerName("sxKeyboardPan:".ptr));
        pan.setCancelsTouchesInView(0);
        glView.addGestureRecognizer(pan);

        center := NSNotificationCenter.defaultCenter();
        center.addObserver_selector_name_object(
            glView, sel_registerName("sxKeyboardFrame:".ptr),
            UIKeyboardWillChangeFrameNotification, null);

        NSLog(nsstring("[sx] UIKitPlatform booted\n"));
    }

    // CADisplayLink callback (vsync-paced). Metal is marked for display
    // and draws in the layer's commit-phase -display, after this cycle's
    // touches and notifications; GLES has no display phase and draws here.
    glViewTick :: (self: *UIKitPlatform, link: *CADisplayLink) {
        self.deltaTime = link.duration();
        self.lastTargetTs = link.targetTimestamp();

        if self.pendingResponder != .none {
            flip := self.pendingResponder;
            self.pendingResponder = .none;
            if view := self.glView {
                if flip == .show { view.becomeFirstResponder(); }
                else { view.resignFirstResponder(); }
            }
        }

        if self.kb.advance(self.deltaTime) { self.hideKeyboard(); }

        if !self.hasFrameClosure { return; }
        if !self.glInitialized { return; }

        if self.gpuMode == .metal {
            if view := self.glView { view.layer().setNeedsDisplay(); }
            return;
        }

        fn := self.frameClosure;
        fn();
    }

    // SxMetalLayer -display: the frame closure acquires the drawable,
    // samples the keyboard, draws and presents inside this commit.
    metalLayerDisplay :: (self: *UIKitPlatform) {
        if !self.hasFrameClosure { return; }
        if !self.glInitialized { return; }

        fn := self.frameClosure;
        fn();
    }

    // UIView -layoutSubviews callback. Sets up the renderbuffer (gles) or
    // computes the layer pixel size (metal) on the first layout pass.
    glViewDidLayout :: (self: *UIKitPlatform) {
        if self.glInitialized { return; }
        if self.gpuMode == .gles {
            self.setupRenderbuffer();
        } else {
            self.computeLayerPixelSize();
        }
        self.glInitialized = true;
    }

    // Touch IMPs — UIKit fires touchesBegan/Moved/Ended/Cancelled with an
    // NSSet<UITouch *> + UIEvent. Single-touch model matching chess's UX.

    pushTouchDown :: (self: *UIKitPlatform, view: *void, touches: *void) {
        touch := uikitFirstTouch(touches);
        if touch == null { return; }
        pos := uikitTouchLocation(touch, view);
        self.events.append(.input(.pointerDown(uikitPointer(pos))));
    }

    pushTouchMoved :: (self: *UIKitPlatform, view: *void, touches: *void) {
        touch := uikitFirstTouch(touches);
        if touch == null { return; }
        pos := uikitTouchLocation(touch, view);
        self.events.append(.input(.pointerMove(uikitPointer(pos))));
    }

    pushTouchUp :: (self: *UIKitPlatform, view: *void, touches: *void) {
        touch := uikitFirstTouch(touches);
        if touch == null { return; }
        pos := uikitTouchLocation(touch, view);
        self.events.append(.input(.pointerUp(uikitPointer(pos))));
    }

    pushTouchCancel :: (self: *UIKitPlatform, view: *void, touches: *void) {
        touch := uikitFirstTouch(touches);
        if touch == null { return; }
        pos := uikitTouchLocation(touch, view);
        self.events.append(.input(.pointerCancel(uikitPointer(pos))));
    }

    hasText :: (self: *UIKitPlatform) -> bool {
        if session := self.session {
            return session.committedLen > 0 or session.markedLen > 0;
        }
        false
    }

    insertText :: (self: *UIKitPlatform, text: *NSString) {
        if session := self.session {
            self.notifyTextWillChange();
            session.insert(fromCstring(text.UTF8String().(cstring)));
            self.notifyTextDidChange();
        }
    }

    deleteBackward :: (self: *UIKitPlatform) {
        if session := self.session {
            self.notifyTextWillChange();
            session.deleteBackward();
            self.notifyTextDidChange();
        }
    }

    // `selectedRange` indexes the marked NSString in UTF-16 code units;
    // the session indexes it in UTF-8 bytes. A nil `text` is the abandon.
    setMarkedText :: (self: *UIKitPlatform, text: ?*NSString, selectedRange: _NSRange) {
        if session := self.session {
            run : string = "";
            if t := text { run = fromCstring(t.UTF8String().(cstring)); }
            selStart := utf16OffsetToBytes(run, selectedRange.location.(i64));
            selEnd := utf16OffsetToBytes(run, (selectedRange.location + selectedRange.length).(i64));
            self.notifyTextWillChange();
            session.setMarked(run, selStart, selEnd);
            self.notifyTextDidChange();
        }
    }

    commitMarked :: (self: *UIKitPlatform) {
        if session := self.session {
            self.notifyTextWillChange();
            session.commitMarked();
            self.notifyTextDidChange();
        }
    }

    // Minted over the view on first read and kept: UIKit reads
    // `tokenizer` on every word-boundary query.
    textTokenizer :: (self: *UIKitPlatform) -> ?*UITextInputStringTokenizer {
        if tok := self.tokenizer { return tok; }
        if view := self.glView {
            tok := UITextInputStringTokenizer.alloc().initWithTextInput(view);
            self.tokenizer = tok;
            return tok;
        }
        null
    }

    notifyTextWillChange :: (self: *UIKitPlatform) {
        if d := self.inputDelegate {
            if view := self.glView { d.textWillChange(view); }
        }
    }

    notifyTextDidChange :: (self: *UIKitPlatform) {
        if d := self.inputDelegate {
            if view := self.glView { d.textDidChange(view); }
        }
    }
}

// Single-touch model: one contact, pointer id 0; timestamps ride the
// process monotonic clock.
uikitPointer :: (pos: Point) -> PointerEvent {
    PointerEvent{
        header = .{ timeNs = time.monoNs().(u64) },
        kind = .touch,
        position = pos,
    }
}

// dlsym(RTLD_DEFAULT, name) — Apple platforms. RTLD_DEFAULT is (void*)-2.
// abi(.c) so this is callable from `loadGl`'s C-conv proc-loader slot.
iosGlProc :: (name: cstring) -> *void abi(.c) {
    rtldDefault : *void = (0 - 2).(*void);
    dlsym(rtldDefault, name)
}

// Read a `extern NSString * const k...` global from the loaded image. The
// extern variable holds a pointer to the NSString instance — dlsym returns
// the address of that variable, which we dereference.
uikitExternNsstring :: (name: [*]u8) -> *void {
    rtldDefault : *void = (0 - 2).(*void);
    p := dlsym(rtldDefault, name);
    if p == null { return null; }
    pp : **void = p.(**void);
    pp.*
}

// ───────────────────────────────────────────────────────────────────────────
// Free helpers
// ───────────────────────────────────────────────────────────────────────────

uikitChdirToBundle :: () {
    bundle := NSBundle.mainBundle();
    rsrc := bundle.resourcePath();
    if rsrc == null { return; }
    chdir(rsrc.UTF8String());
}

// Pull the first UITouch out of an NSSet<UITouch *> and convert its
// location to view-local coordinates. Used by push_touch_* methods on
// UIKitPlatform.

uikitTouchLocation :: (touch: *void, view: *void) -> Point {
    t : *UITouch = touch.(*UITouch);
    p := t.locationInView(view);
    Point{ x = p.x, y = p.y }
}

uikitFirstTouch :: (touches: *void) -> *void {
    touchesSet : *NSSet = touches.(*NSSet);
    touchesSet.anyObject()
}

// The keyboard's own view — the one the keys are drawn in, whose live
// frame is the keyboard's position on screen. Apple ships the views
// inside the keyboard window as private classes; each is named `UI` + a
// stable suffix, so the prefix with the suffix is what identifies one.
uikitKeyboardView :: () -> ?*UIView {
    screen := UIScreen.mainScreen();
    window := UIRemoteKeyboardWindow.remoteKeyboardWindowForScreen_create(screen, 0);
    if window == null { return null; }
    if container := uikitSubviewWithSuffix(window.(*UIView), "InputSetContainerView") {
        if host := uikitSubviewWithSuffix(container, "InputSetHostView") { return host; }
    }
    null
}

uikitClassNameHasSuffix :: (obj: *void, suffix: string) -> bool {
    if obj == null { return false; }
    name := class_getName(object_getClass(obj));
    n : i64 = 0;
    while name[n] != '\0' { n += 1; }
    if n < suffix.len + 2 { return false; }
    if name[0] != 'U' or name[1] != 'I' { return false; }
    i : i64 = 0;
    while i < suffix.len {
        if name[n - suffix.len + i] != suffix[i] { return false; }
        i += 1;
    }
    true
}

uikitSubviewWithSuffix :: (view: *UIView, suffix: string) -> ?*UIView {
    subviews := view.subviews();
    n := subviews.count();
    i : u64 = 0;
    while i < n {
        sub := subviews.objectAtIndex(i);
        i += 1;
        if uikitClassNameHasSuffix(sub, suffix) { return sub.(*UIView); }
    }
    null
}
