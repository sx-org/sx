@import "modules/std.sx";
@import "modules/ui/types.sx";
@import "modules/ui/input.sx";

// The one host event stream. INPUT is the normalized InputEvent —
// consumers push `.input` payloads into their root's InputQueue for
// the §6.9 router. quit/windowResize are lifecycle events, outside the
// normalized input surface.
PlatformEvent :: enum {
    quit;
    windowResize: Size;
    input: InputEvent;
}

FrameContext :: struct {
    viewportW: f32;
    viewportH: f32;
    pixelW: i32;
    pixelH: i32;
    dpiScale: f32;
    deltaTime: f32;
    // The host clock time at which the next vsync will present the frame
    // we're about to render. On iOS this is CADisplayLink.targetTimestamp;
    // forward it to MetalGPU.endFrame() to schedule presentDrawable:atTime:
    // so our drawable hits the same vsync as UIKit's compositor. Other
    // platforms leave it 0 (Metal then falls back to immediate present).
    targetPresentTime: f64;
}

KeyboardState :: struct {
    visible: bool;
    height: f32;

    zero :: () -> KeyboardState => .{ visible = false, height = 0.0 };
}

// The rate a released pan settles the keyboard at, per second, and the
// downward flick, in points per second, that dismisses it whatever the
// distance travelled.
KEYBOARD_SETTLE_RATE :: 20.0;
KEYBOARD_FLICK_VELOCITY :: 100.0;

// Who is placing the keyboard.
KeyboardGrip :: enum {
    free;
    held;
    settling;
    // The dismissal is out and the hold stands until the keyboard clears.
    dismissed;
}

// The soft keyboard's overlap of the view, in points, for the frame about
// to draw. The host samples where the keyboard IS every tick and passes
// `offset` to the keyboard itself, so one number moves the keyboard and
// the inset together.
KeyboardOverlap :: struct {
    height: f32 = 0.0;
    grip: KeyboardGrip = .free;
    // The overlap the pan grabbed, which `offset` measures down from and a
    // dismissing settle drives to.
    grabbed: f32 = 0.0;
    offset: f32 = 0.0;
    settleTo: f32 = 0.0;

    // `top` is the keyboard's live top edge in the view's coordinates; a
    // view no keyboard reaches passes its own height, and a keyboard with
    // no live edge this tick passes null, on which the last overlap stands.
    sample :: (self: *KeyboardOverlap, top: ?f32, viewHeight: f32) {
        live : f32 = ---;
        if t := top { live = viewHeight - t; } else { return; }
        if live < 0.0 { live = 0.0; }
        if live > viewHeight { live = viewHeight; }
        h := live - self.offset;
        if h < 0.0 { h = 0.0; }
        self.height = h;
        if self.grip == .dismissed and live <= 0.0 { self.restore(); }
    }

    // The keyboard comes back to where its own frame puts it.
    restore :: (self: *KeyboardOverlap) {
        self.grip = .free;
        self.offset = 0.0;
        self.settleTo = 0.0;
    }

    visible :: (self: *KeyboardOverlap) -> bool {
        self.grip != .free or self.height > 0.5
    }

    grab :: (self: *KeyboardOverlap) {
        self.grip = .held;
        self.grabbed = self.height;
        self.offset = 0.0;
        self.settleTo = 0.0;
    }

    track :: (self: *KeyboardOverlap, y: f32, viewHeight: f32) {
        if self.grip != .held { return; }
        o := y - (viewHeight - self.grabbed);
        if o < 0.0 { o = 0.0; }
        if o > self.grabbed { o = self.grabbed; }
        self.offset = o;
    }

    // A release with the keyboard pushed to its bottom, or a downward
    // flick, settles it away; anything else settles it back.
    letGo :: (self: *KeyboardOverlap, velocityY: f32) {
        if self.grip != .held { return; }
        self.grip = .settling;
        self.settleTo = 0.0;
        if self.offset > 0.0 {
            if self.offset >= self.grabbed or velocityY > KEYBOARD_FLICK_VELOCITY {
                self.settleTo = self.grabbed;
            }
        }
    }

    // Steps a settle; true on the tick it lands the keyboard away, which is
    // when the dismissal goes out.
    advance :: (self: *KeyboardOverlap, dt: f32) -> bool {
        if self.grip != .settling { return false; }
        k := dt * KEYBOARD_SETTLE_RATE;
        if k > 1.0 { k = 1.0; }
        self.offset += (self.settleTo - self.offset) * k;
        d := self.settleTo - self.offset;
        if d < 0.0 { d = -d; }
        if d > 0.5 { return false; }
        self.offset = self.settleTo;
        if self.settleTo > 0.0 {
            self.grip = .dismissed;
            return true;
        }
        self.grip = .free;
        false
    }
}

// Compose the batch a caller reads: `live` is where the host's callbacks
// append and `ime` is where the focused session reports; both empty into
// `batch`, whose storage and payload copies are the queue allocator's.
// The copies go at the NEXT composition, so a slice handed out stays
// readable until then and a callback re-entered meanwhile appends to
// `live`, out of the batch's reach.
composeEventBatch :: (batch: *List(PlatformEvent), live: *List(PlatformEvent), ime: *InputQueue) -> []PlatformEvent {
    for e in batch.items {
        match e {
            case .input: |ie| {
                match ie {
                    case .text: |t| { ime.gpa.deallocBytes(t.text.ptr); }
                    case .composition: |cp| { ime.gpa.deallocBytes(cp.marked.ptr); }
                    else: {}
                }
            }
            else: {}
        }
    }
    batch.len = 0;

    for e in live.items { batch.append(e, ime.gpa); }
    live.len = 0;

    for e in ime.events.items {
        match e {
            case .text: |t| { batch.append(.input(.text(ime.copyText(t))), ime.gpa); }
            case .composition: |cp| { batch.append(.input(.composition(ime.copyComposition(cp))), ime.gpa); }
            else: { batch.append(.input(e), ime.gpa); }
        }
    }
    ime.clear();

    out : []PlatformEvent = ---;
    out.ptr = batch.items.ptr;
    out.len = batch.len;
    out
}
