..@import "modules/std/c.sx";

core :: @import "modules/std/core.sx";
fmt  :: @import "modules/std/fmt.sx";
list :: @import "modules/std/list.sx";
map  :: @import "modules/std/map.sx";

// --- Compiler-resolved types ---
// (`string` and `@Vector` have no alias here: they are language primitives the
// type system resolves by name program-wide. They are declared nowhere and
// cannot be re-bound.)

Context         :: core.Context;
Allocator       :: core.Allocator;
Io              :: core.Io;
SpawnOpts       :: core.SpawnOpts;
PinTarget       :: core.PinTarget;
ParkToken       :: core.ParkToken;
Into            :: core.Into;
IntCastError    :: core.IntCastError;

// --- The reflected type shape (`@typeInfo`) ---

TypeInfo        :: core.TypeInfo;
FieldInfo       :: core.FieldInfo;
VariantInfo     :: core.VariantInfo;
ArmInfo         :: core.ArmInfo;
MemberInfo      :: core.MemberInfo;
EnumInfo        :: core.EnumInfo;
StructInfo      :: core.StructInfo;
UnionInfo       :: core.UnionInfo;
ErrorInfo       :: core.ErrorInfo;
IntInfo         :: core.IntInfo;
FloatInfo       :: core.FloatInfo;
ArrayInfo       :: core.ArrayInfo;
VectorInfo      :: core.VectorInfo;
SliceInfo       :: core.SliceInfo;
PointerInfo     :: core.PointerInfo;
OptionalInfo    :: core.OptionalInfo;


// --- Type system & reflection intrinsics ---
// (no aliases: an intrinsic is a compiler feature, not a library export. The
// compiler dispatches `@sizeOf` / `@alignOf` / … from its registry before
// name resolution, so they resolve with no import at all — the declarations in
// std/core.sx are their source identity, not their reachability. Same reason
// `string` and `@Vector` have no alias here.)

// --- Output ---

Writer        :: core.Writer;
Fd            :: c.Fd;
FdWriter      :: core.FdWriter;
writeBool     :: core.writeBool;
writeInt      :: core.writeInt;
writeUint     :: core.writeUint;
writeHex      :: core.writeHex;
writeFloat    :: core.writeFloat;

writer        :: @import "modules/std/writer.sx";
StringBuilder :: writer.StringBuilder;
FixedWriter   :: writer.FixedWriter;
writeEach     :: writer.writeEach;

// --- Formatting ---

print  :: fmt.print;
format :: fmt.format;


anyToString      :: fmt.anyToString;
intToString      :: fmt.intToString;
structToString   :: fmt.structToString;
enumToString     :: fmt.enumToString;
flagsToString    :: fmt.flagsToString;
vectorToString   :: fmt.vectorToString;
arrayToString    :: fmt.arrayToString;
sliceToString    :: fmt.sliceToString;
pointerToString  :: fmt.pointerToString;
optionalToString :: fmt.optionalToString;

// --- String ops ---

concat      :: fmt.concat;
last        :: fmt.last;
pathJoin    :: fmt.pathJoin;

buildFormat :: fmt.buildFormat;

// --- Containers ---

List :: list.List;
HashMap :: map.HashMap;
IndexMap :: map.IndexMap;

// --- Async / Io capability ---

IoErr :: core.IoErr;
..@import "modules/std/io.sx";

// --- The stdlib namespace tail: flat-importing std.sx carries these ---

..@import "modules/std/posix.sx";
..@import "modules/std/mem.sx";
..mem;
..@import "modules/std/fs.sx";
..@import "modules/std/process.sx";
..@import "modules/std/socket.sx";
..@import "modules/std/json.sx";
..@import "modules/std/xml.sx";
..@import "modules/std/cli.sx";
..@import "modules/std/hash.sx";
..@import "modules/std/log.sx";
..@import "modules/std/test.sx";
..@import "modules/std/time.sx";
..@import "modules/std/event.sx";
..@import "modules/std/thread.sx";
..@import "modules/std/compress.sx";
..@import "modules/std/encoding.sx";
..@import "modules/std/codecs/deflate.sx";
..@import "modules/std/codecs/zlib.sx";
..@import "modules/std/codecs/gzip.sx";
..@import "modules/std/codecs/png.sx";
..@import "modules/std/codecs/zip.sx";
