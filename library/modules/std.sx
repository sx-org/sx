// The prelude facade: every name here is a RE-EXPORT. The implementations
// live in the part-files (std/core.sx — compiler-coupled primitives,
// std/fmt.sx — formatting + string helpers, std/list.sx — List); each
// alias below is an ordinary OWN declaration of this file, so a flat
// `@import "modules/std.sx"` sees the whole prelude bare, one hop —
// visibility never chains, aliases are the re-export mechanism. The
// part-file namespaces (`core` / `fmt` / `list`) and the namespace tail at
// the bottom are carried to flat importers the same one level.

core :: @import "modules/std/core.sx";
fmt  :: @import "modules/std/fmt.sx";
list :: @import "modules/std/list.sx";
map  :: @import "modules/std/map.sx";

// --- Compiler-resolved types ---
// (`string` and `@Vector` have no alias here: they are language primitives the
// type system resolves by name program-wide. They are declared nowhere and
// cannot be re-bound.)

Context         :: core.Context;
Allocator       :: core.Allocator;
Io              :: core.Io;
SpawnOpts       :: core.SpawnOpts;
PinTarget       :: core.PinTarget;
ParkToken       :: core.ParkToken;
Into            :: core.Into;

// --- The reflected type shape (`@typeInfo`) ---

TypeInfo        :: core.TypeInfo;
FieldInfo       :: core.FieldInfo;
VariantInfo     :: core.VariantInfo;
ArmInfo         :: core.ArmInfo;
MemberInfo      :: core.MemberInfo;
EnumInfo        :: core.EnumInfo;
StructInfo      :: core.StructInfo;
UnionInfo       :: core.UnionInfo;
ErrorInfo       :: core.ErrorInfo;
IntInfo         :: core.IntInfo;
FloatInfo       :: core.FloatInfo;
ArrayInfo       :: core.ArrayInfo;
VectorInfo      :: core.VectorInfo;
SliceInfo       :: core.SliceInfo;
PointerInfo     :: core.PointerInfo;
OptionalInfo    :: core.OptionalInfo;


// --- Type system & reflection intrinsics ---
// (no aliases: an intrinsic is a compiler feature, not a library export. The
// compiler dispatches `size_of` / `struct_field_count` / … from its registry before
// name resolution, so they resolve with no import at all — the declarations in
// std/core.sx are their source identity, not their reachability. Same reason
// `string` and `@Vector` have no alias here.)

// --- Output ---

out :: core.out;

writer        :: @import "modules/std/writer.sx";
Writer        :: writer.Writer;
StringBuilder :: writer.StringBuilder;
FdWriter      :: writer.FdWriter;
write_each    :: writer.write_each;

// --- Formatting ---

print  :: fmt.print;
format :: fmt.format;

// Postfix-assertion runtime (`av.(T)` / `av.(?T)` on a type-erased
// receiver): chained and re-erasure rewrite targets. Their `CastError
// { mismatch }` set has no alias here — error sets cannot be aliased;
// the `mismatch` TAG is global by name, so a caller's own set (or an
// inferred `!`) absorbs it.
__sx_reerase_or_panic    :: fmt.__sx_reerase_or_panic;
__sx_chain_cast_assert   :: fmt.__sx_chain_cast_assert;
__sx_chain_cast_or_panic :: fmt.__sx_chain_cast_or_panic;
__sx_chain_cast_maybe    :: fmt.__sx_chain_cast_maybe;

any_to_string      :: fmt.any_to_string;
int_to_string      :: fmt.int_to_string;
uint_to_string     :: fmt.uint_to_string;
int_to_hex_string  :: fmt.int_to_hex_string;
float_to_string    :: fmt.float_to_string;
bool_to_string     :: fmt.bool_to_string;
struct_to_string   :: fmt.struct_to_string;
enum_to_string     :: fmt.enum_to_string;
flags_to_string    :: fmt.flags_to_string;
vector_to_string   :: fmt.vector_to_string;
array_to_string    :: fmt.array_to_string;
slice_to_string    :: fmt.slice_to_string;
pointer_to_string  :: fmt.pointer_to_string;
optional_to_string :: fmt.optional_to_string;

// --- String ops & allocation helpers ---

concat      :: fmt.concat;
substr      :: fmt.substr;
path_join   :: fmt.path_join;
alloc_string :: fmt.alloc_string;
cstring_len  :: fmt.cstring_len;
from_cstring :: fmt.from_cstring;
to_cstring   :: fmt.to_cstring;
alloc_slice :: fmt.alloc_slice;

// fmt internals, re-exported only because they were always part of the
// flat prelude surface.
build_format    :: fmt.build_format;
hex_group       :: fmt.hex_group;
decompose_u16x4 :: fmt.decompose_u16x4;

// --- Containers ---

List :: list.List;
HashMap :: map.HashMap;
IndexMap :: map.IndexMap;

// --- Async / Io capability (impls in std/io.sx) ---

io_mod      :: @import "modules/std/io.sx";
CBlockingIo :: io_mod.CBlockingIo;
Future      :: io_mod.Future;
FutureState :: io_mod.FutureState;
IoErr       :: core.IoErr;
async       :: io_mod.async;
await       :: io_mod.await;
cancel      :: io_mod.cancel;

// --- The stdlib namespace tail: flat-importing std.sx carries these ---

c       :: @import "modules/std/c.sx";
posix   :: @import "modules/std/posix.sx";
mem     :: @import "modules/std/mem.sx";
// Intentional allocator-prelude re-export. Static method heads obey the same
// one-hop visibility boundary as every other type use; this own alias is what
// makes bare `GPA.init()` part of the std facade rather than an accidental
// reach-through into `std/mem.sx`.
GPA     :: mem.GPA;
fs      :: @import "modules/std/fs.sx";
process :: @import "modules/std/process.sx";
socket  :: @import "modules/std/socket.sx";
json    :: @import "modules/std/json.sx";
xml     :: @import "modules/std/xml.sx";
cli     :: @import "modules/std/cli.sx";
hash    :: @import "modules/std/hash.sx";
log     :: @import "modules/std/log.sx";
test    :: @import "modules/std/test.sx";
time    :: @import "modules/std/time.sx";
event   :: @import "modules/std/event.sx";
thread  :: @import "modules/std/thread.sx";
compress :: @import "modules/std/compress.sx";
deflate  :: @import "modules/std/codecs/deflate.sx";
zlib     :: @import "modules/std/codecs/zlib.sx";
gzip     :: @import "modules/std/codecs/gzip.sx";
png      :: @import "modules/std/codecs/png.sx";
zip      :: @import "modules/std/codecs/zip.sx";
