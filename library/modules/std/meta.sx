// Comptime type metaprogramming — `declare` / `define`: construct a NEW nominal
// type from the `TypeInfo` shape the prelude declares and `@typeInfo` reflects
// into.
//
// This is a SEPARATE on-demand module rather than part of the prelude: only a
// program that MINTS types needs it, and it builds its member list via `List`,
// so it imports `list.sx` (and its `core.sx`) — the two part-files it actually
// needs — NOT the whole `std.sx` facade. Importing the facade would drag
// `map`/`fmt`/etc. into every meta importer's type table for no reason.
//
// `declare` / `define` are ordinary sx over the `intrinsic` primitives
// `rawDeclareType` / `rawRegisterType`, which run at LOWERING time (when a
// `-> Type` builder's result is first referenced), where the compiler can still
// resolve references to the minted types.
@import "modules/std/core.sx";
@import "modules/std/list.sx";
c :: @import "modules/std/c.sx";

// ── The low-level compiler-API type-construction primitives ──────────────────
//
// These `intrinsic` functions are the compiler's type-construction
// primitives — serviced by `comptime_vm.callCompilerFn`. Declared here, not
// imported from `modules/compiler.sx`, so `meta.sx` does not intern
// `compiler.sx`'s `List(string)` types into every importer's table.
//
// `rawRegisterType`'s `Member` is the `{ name, ty }` shape it decodes. The
// `kind` codes match the read-side `rawTypeKind`:
//   1 struct · 2 enum (payloadless) · 3 tagged-union.
Member :: struct { name: string; ty: Type; }

rawDeclareType  :: (name: string) -> Type intrinsic;
rawRegisterType :: (handle: Type, kind: i64, members: []Member) -> Type intrinsic;

KIND_STRUCT       :: 1;
KIND_ENUM         :: 2; // an ACTUAL payloadless enum
KIND_TAGGED_UNION :: 3; // a payload-carrying enum

// ── The metatype DSL ─────────────────────────────────────────────────────────
//
//   declare(name)        — mint a NEW empty (undefined) nominal type NAMED
//                          `name`, returned as a `Type` handle. The compiler
//                          registers the forward type at compile time (it scans
//                          for the literal `declare("Name")` spelling), so the
//                          body of `define` can reference it BY NAME — that's how
//                          self-reference works (`payload = *List` resolves to the
//                          forward `List`). Using the type before its `define` is
//                          a loud error; a pointer to it is fine. A trivial alias
//                          for `rawDeclareType` (both mint the same forward slot).
//   define(handle, info) — fill a declared handle's body from a `TypeInfo`, and
//                          RETURN the handle so the one-shot form chains:
//                              List :: define(declare("List"), .enum(.{ fields = .[
//                                  VariantInfo{ name = "cons", payload = *List },
//                                  VariantInfo{ name = "nil",  payload = void } ] }));

// `declare(name)` is plain sx over the `rawDeclareType` primitive: both mint (or
// find) the same forward nominal slot — `declare` adds nothing but a name the
// compiler scans for to forward-register self-references (`*Name`).
declare :: (name: string) -> Type {
    return rawDeclareType(name);
}

// `define(handle, info)` is plain sx over `rawRegisterType`: match the `TypeInfo`
// union, collect the members into a `[]Member`, and register with the kind code.
// An all-void enum variant set is an ACTUAL enum (kind 2); any payload variant
// makes it a tagged-union (kind 3) — `rawRegisterType` rejects a payload variant
// under kind 2, so the kind is chosen from whether every payload is `void`.
define :: (handle: Type, info: TypeInfo) -> Type {
    match info {
        case .enum: |e| {
            mems : List(Member) = .{};
            allVoid := true;
            for v in e.fields {
                mems.append(Member{ name = v.name, ty = v.payload });
                if v.payload != void { allVoid = false; }
            }
            kind := KIND_TAGGED_UNION;
            if allVoid { kind = KIND_ENUM; }
            return rawRegisterType(handle, kind, mems.items[0..mems.len]);
        }
        case .struct: |s| {
            mems : List(Member) = .{};
            for f in s.fields {
                mems.append(Member{ name = f.name, ty = f.type });
            }
            return rawRegisterType(handle, KIND_STRUCT, mems.items[0..mems.len]);
        }
        else: {
            // Reflect-only shapes (int/float/array/union/...) cannot be minted:
            // there is nothing nominal to register. Loud, not silent.
            msg := "define: only struct/enum TypeInfo shapes can be minted\n";
            c.write(2, msg.ptr, msg.len);
        }
    }
    return handle;
}

// --- Type constructors built in sx library code (no compiler machinery) ---
//
// The channel result types, expressed as type-fns over declare/define. They
// demonstrate that a programmatically-built enum carries a full enum through
// codegen: `RecvResult(i64)` constructs and matches like any hand-written enum,
// and is one nominal type across sites (the type-fn identity path).

// The GENERAL enum constructor: mint a nominal enum NAMED `name` from a variant
// list passed as a VALUE (a `[]VariantInfo`), rather than a hardcoded literal.
// Because `variants` is an ordinary comptime value, a caller can ASSEMBLE it in
// a local (conditionally, in a loop, from type args) before minting — see
// `examples/0620`. `define` decodes the slice via `decodeVariantElements`. The
// channel constructors above are the special-cased shapes; `makeEnum` is the
// open-ended one every other constructor could be written over.
//
// Call it from a non-generic `() -> Type` builder (whose whole body is
// comptime-evaluated, so locals are in scope) or inline with a literal arg
// (`E :: makeEnum("E", .[ … ])`). A *generic* type-fn comptime-evaluates only
// its return EXPRESSION, so build the list inline in the return there, not in a
// preceding local.
makeEnum :: (name: string, variants: []VariantInfo) -> Type {
    return define(declare(name), .enum(.{ fields = variants }));
}

// A blocking recv: a value, or the channel was closed (drained).
RecvResult :: ($T: Type) -> Type {
    return define(declare("RecvResult"), .enum(.{ fields = .[
        VariantInfo{ name = "value",  payload = T    },
        VariantInfo{ name = "closed", payload = void },
    ] }));
}

// A non-blocking try-recv: a value, currently empty, or closed — three states
// a bool can't express.
TryResult :: ($T: Type) -> Type {
    return define(declare("TryResult"), .enum(.{ fields = .[
        VariantInfo{ name = "value",  payload = T    },
        VariantInfo{ name = "empty",  payload = void },
        VariantInfo{ name = "closed", payload = void },
    ] }));
}

// ── Constructing a minted tagged-union VALUE by variant index ─────────────────
//
// The read side reflects a type's members (`@typeInfo(T).struct.fields`) and a
// value's active payload (`@field`); `makeVariant` is the WRITE side.
// It builds a value of a MINTED tagged-union `E` (one made by `makeEnum` /
// `define(declare, .enum(...))`) whose active variant is `idx`, carrying
// `payload`. Needed when the variant is selected at RUNTIME but
// the union was synthesized at comptime so its labels can't be spelled as a
// literal `.label(payload)` — e.g. the `race` result: an `inline for i in 0..N`
// arm constructs the i-th variant of a synthesized `RaceResult`.
//
// LAYOUT COUPLING — MINTED ENUMS ONLY: a minted tagged-union is laid out
// `{ i64 tag @0, payload bytes @ @sizeOf(i64) }` (its tag type is always `i64`
// — the compiler's `declare`/`define` path fixes it). `makeVariant` writes that
// layout directly. It is NOT valid for a source `enum { … }` whose tag may be
// narrower, nor for a `#packed`-backed union — spell those with a literal
// `.label(…)`. Contract (caller-guaranteed, no runtime check, like any raw
// construction): `0 <= idx < @typeInfo(E).enum.fields.len`, and `payload`'s type IS variant
// `idx`'s payload type. `payload` must be non-void (a payload-less variant has
// no value to carry — match it by tag).
makeVariant :: ($E: Type, idx: i64, payload: $P) -> E {
    out : E = ---;
    c.memset(*out, 0, @sizeOf(E));             // clear tag padding + unused payload bytes
    tagPtr : *i64 = (*out).(*i64);
    tagPtr.* = idx;                             // tag @ offset 0 (i64)
    payPtr : *P = ((*out).(i64) + @sizeOf(i64)).(*P); // payload @ offset @sizeOf(i64) (after the tag)
    payPtr.* = payload;
    return out;
}
