c :: scope {
    libc :: @library "c";

    Fd :: enum i32 { stdin = 0; stdout = 1; stderr = 2; raw = else; }

    malloc  :: (size: i64) -> *void extern libc;
    free    :: (ptr: *void) -> void extern libc;
    memcpy  :: (dst: *void, src: *void, size: i64) -> *void extern libc;
    memset  :: (dst: *void, val: i64, size: i64) -> void extern libc;
    memmove :: (dst: *void, src: *void, size: i64) -> *void extern libc;

    read   :: (fd: Fd, buf: [*]u8, count: i64) -> isize extern libc;
    write  :: (fd: Fd, buf: [*]u8, count: i64) -> isize extern libc;
    close  :: (fd: Fd) -> i32 extern libc;
    open   :: (path: [*:0]u8, flags: i32, ..args: []i32) -> i32 extern libc;
    lseek  :: (fd: Fd, offset: i64, whence: i32) -> i64 extern libc;
    unlink :: (path: [*:0]u8) -> i32 extern libc;
    chdir  :: (path: [*:0]u8) -> i32 extern libc;
    rmdir  :: (path: [*:0]u8) -> i32 extern libc;
    mkdir  :: (path: [*:0]u8, mode: u32) -> i32 extern libc;
    access :: (path: [*:0]u8, mode: i32) -> i32 extern libc;
    chmod  :: (path: [*:0]u8, mode: u32) -> i32 extern libc;
    rename :: (oldp: [*:0]u8, newp: [*:0]u8) -> i32 extern libc;
    fstat  :: (fd: Fd, output: *void) -> i32 extern libc;
    fcntl  :: (fd: Fd, cmd: i32, ..args: []i32) -> i32 extern libc;

    // Native 64-bit targets use two C longs. Emscripten keeps time_t at i64 on
    // wasm32 but C long at i32, padding timespec back to 16 bytes.
    inline match @host.pointerSize {
        case 4: Timespec :: struct {
            sec:  i64;
            nsec: i32;
            _pad: i32;
        }
        case 8: Timespec :: struct {
            sec:  i64;
            nsec: i64;
        }
        else: @error("std/c.sx: unsupported pointer size for C timespec");
    }

    usleep :: (usec: u32) -> i32 extern libc;
    clock_gettime :: (clockId: i32, ts: *Timespec) -> i32 extern libc;

    inline match @host.os {
        case .windows: Tm :: struct {
            sec: i32; min: i32; hour: i32; mday: i32; mon: i32; year: i32; wday: i32; yday: i32; isdst: i32;
        }
        case .wasm: Tm :: struct {
            sec: i32; min: i32; hour: i32; mday: i32; mon: i32; year: i32; wday: i32; yday: i32; isdst: i32;
            gmtoff: i32; zone: *u8;
        }
        else: Tm :: struct {
            sec: i32; min: i32; hour: i32; mday: i32; mon: i32; year: i32; wday: i32; yday: i32; isdst: i32;
            gmtoff: i64; zone: *u8;
        }
    }
    inline match @host.os {
        case .windows: localtimeS :: (result: *Tm, source: *i64) -> i32 extern libc "localtime_s";
        else: localtimeR :: (source: *i64, result: *Tm) -> *Tm extern libc "localtime_r";
    }
    inline match @host.os {
        case .windows: mktime :: (value: *Tm) -> i64 extern libc "_mktime64";
        else: mktime :: (value: *Tm) -> i64 extern libc "mktime";
    }

    inline match @host.os {
        case .wasm:
            emscripten_set_main_loop  :: (func: *void, fps: i32, simInfinite: i32) extern libc;
            emscripten_run_script_int :: (script: [*:0]u8) -> i32 extern libc;
        else: {}
    }

    mmap     :: (addr: *void, len: i64, prot: i32, flags: i32, fd: Fd, off: i64) -> *void extern libc;
    mprotect :: (addr: *void, len: i64, prot: i32) -> i32 extern libc;
    munmap   :: (addr: *void, len: i64) -> i32 extern libc;

    abort :: () -> noreturn extern libc;
    // _exit terminates without flushing stdio or running atexit handlers.
    exit :: (code: i32) -> noreturn extern libc "_exit";

    pipe    :: (fds: *[2]Fd) -> i32 extern libc;
    fork    :: () -> i32 extern libc;
    // argv ends with a null pointer; file resolves through PATH.
    execvp  :: (file: [*:0]u8, argv: [*]?[*:0]u8) -> i32 extern libc;
    dup2    :: (oldfd: Fd, newfd: Fd) -> i32 extern libc;
    waitpid :: (pid: i32, status: *i32, options: i32) -> i32 extern libc;
    kill    :: (pid: i32, sig: i32) -> i32 extern libc;
    signal  :: (sig: i32, handler: usize) -> usize extern libc;

    // C's errno macro dereferences this thread-local pointer.
    inline match @host.os {
        case .macos:  errnoLocation :: () -> *i32 extern libc "__error";
        case .ios:    errnoLocation :: () -> *i32 extern libc "__error";
        case .linux:  errnoLocation :: () -> *i32 extern libc "__errno_location";
        case .android: errnoLocation :: () -> *i32 extern libc "__errno";
        case .windows: errnoLocation :: () -> *i32 extern libc "_errno";
        case .wasm:   errnoLocation :: () -> *i32 extern libc "__errno_location";
        else:         @error("std/c.sx: errnoLocation symbol is only known for Darwin (__error), Linux/Emscripten (__errno_location), Android (__errno), and Windows (_errno) — add a case for this target.");
    }

    // Opaque, 8-byte-aligned storage covering Darwin, musl, and glibc pthread types.
    MutexBuf :: struct { slots: [8]i64; }
    CondBuf  :: struct { slots: [6]i64; }

    pthread_create  :: (thread: *usize, attr: *void, start: (*void) -> *void abi(.c), arg: *void) -> i32 extern libc;
    pthread_join    :: (thread: usize, retval: **void) -> i32 extern libc;
    pthread_detach  :: (thread: usize) -> i32 extern libc;

    pthread_mutex_init    :: (m: *MutexBuf, attr: *void) -> i32 extern libc;
    pthread_mutex_lock    :: (m: *MutexBuf) -> i32 extern libc;
    pthread_mutex_unlock  :: (m: *MutexBuf) -> i32 extern libc;
    pthread_mutex_destroy :: (m: *MutexBuf) -> i32 extern libc;

    pthread_cond_init      :: (c: *CondBuf, attr: *void) -> i32 extern libc;
    pthread_cond_wait      :: (c: *CondBuf, m: *MutexBuf) -> i32 extern libc;
    pthread_cond_signal    :: (c: *CondBuf) -> i32 extern libc;
    pthread_cond_broadcast :: (c: *CondBuf) -> i32 extern libc;
    pthread_cond_destroy   :: (c: *CondBuf) -> i32 extern libc;
}
