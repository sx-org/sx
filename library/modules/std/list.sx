// The growable container of the prelude. Consumers never import this file
// directly — std.sx re-exports `List`.
@import "modules/std/core.sx";
c :: @import "modules/std/c.sx";

// `items` is a `[]T` slice whose `.len` IS the live element count, so a `List`
// is directly iterable: `for e in xs.items { ... }`. `cap` is the allocated
// capacity (`>= items.len`); the buffer spans `cap` elements, the slice spans
// the live `items.len`. The `len` `@get` accessor exposes the live count as
// `xs.len` (read), delegating to `items.len`; writes use `xs.items.len`.
//
// `grow_to` is the only path that allocates; every method that needs room
// routes through it. Failures `@panic`: allocation failure, capacity overflow,
// an index outside its method's range.
List :: struct ($T: Type) {
    items: []T = .[];   // empty slice ({ptr, len=0}); `.[]` is the empty-slice
                        // literal — `.{}` would init the slice's underlying
                        // {ptr,len} struct, yielding a garbage len.
    cap: i64 = 0;

    // No-paren read accessor: `xs.len` → the live element count.
    len :: (self: *List(T)) -> i64 @get => self.items.len;
    // Write accessor: `xs.len = n` sets the live count (e.g. `xs.len = 0` to
    // clear without freeing). Mirrors the `@get` above; the buffer / `cap` are
    // untouched, so `n` outside `0 ..= cap` panics. A `@set` signature is
    // `(self, v)` — there is no site parameter to name the assignment, so the
    // panic carries no location.
    len :: (self: *List(T), v: i64) @set {
        if v < 0 or v > self.cap { @panic("List len out of range", @SourceSite{}); }
        self.items.len = v;
    }

    // Every failure `@panic`s before a field is written, so a list that could
    // not grow is unchanged and still owns its buffer. A zero-sized `T` has no
    // buffer: `cap` grows, nothing is allocated.
    grow_to :: (list: *List(T), n: i64, alloc: Allocator, site: @SourceSite) {
        if list.cap >= n { return; }
        new_cap := if list.cap == 0 then 4 else list.cap;
        while new_cap < n {
            if new_cap > i64.max / 2 { @panic("List capacity overflow", site); }
            new_cap = new_cap * 2;
        }
        elem := @sizeOf(T);
        if elem == 0 {
            list.cap = new_cap;
            return;
        }
        if new_cap > i64.max / elem { @panic("List allocation size overflow", site); }
        raw := alloc.alloc_bytes(new_cap * elem);
        if raw == null { @panic("List allocation failed", site); }
        if list.items.len > 0 {
            c.memcpy(raw, list.items.ptr, list.items.len * elem);
        }
        if list.cap > 0 {
            alloc.dealloc_bytes(list.items.ptr);
        }
        list.items.ptr = raw.([*]T);
        list.cap = new_cap;
    }

    // `cap` follows `grow_to`'s doubling, so it can exceed `n`.
    with_capacity :: (n: i64, alloc: Allocator = context.allocator, site: @SourceSite = @caller) -> List(T) {
        list : List(T) = .{};
        list.grow_to(n, alloc, site);
        return list;
    }

    append :: (list: *List(T), item: T, alloc: Allocator = context.allocator, site: @SourceSite = @caller) {
        list.grow_to(list.items.len + 1, alloc, site);
        list.items.ptr[list.items.len] = item;
        list.items.len += 1;
    }

    pop :: (list: *List(T)) -> ?T {
        if list.items.len == 0 { return null; }
        list.items.len -= 1;
        return list.items.ptr[list.items.len];
    }

    // Insert at `i` in `0 ..= len`, shifting the tail up; `i == len` appends.
    insert :: (list: *List(T), i: i64, item: T, alloc: Allocator = context.allocator, site: @SourceSite = @caller) {
        if i < 0 or i > list.items.len { @panic("List insert index out of range", site); }
        list.grow_to(list.items.len + 1, alloc, site);
        n := (list.items.len - i) * @sizeOf(T);
        if n > 0 {
            c.memmove(*list.items.ptr[i + 1], *list.items.ptr[i], n);
        }
        list.items.ptr[i] = item;
        list.items.len += 1;
    }

    // Order-preserving remove: the tail shifts down into slot `i`.
    // `swap_remove` is the O(1) alternative.
    remove :: (list: *List(T), i: i64, site: @SourceSite = @caller) -> T {
        if i < 0 or i >= list.items.len { @panic("List remove index out of range", site); }
        item := list.items.ptr[i];
        n := (list.items.len - i - 1) * @sizeOf(T);
        if n > 0 {
            c.memmove(*list.items.ptr[i], *list.items.ptr[i + 1], n);
        }
        list.items.len -= 1;
        return item;
    }

    // O(1) unordered remove: the last element moves into slot `i`.
    // Order is NOT preserved — `remove` is the order-keeping alternative.
    swap_remove :: (list: *List(T), i: i64, site: @SourceSite = @caller) {
        if i < 0 or i >= list.items.len { @panic("List swap_remove index out of range", site); }
        list.items.ptr[i] = list.items.ptr[list.items.len - 1];
        list.items.len -= 1;
    }

    // Drop every element, keep the buffer: `cap` and the backing allocation
    // are untouched, so appends reuse the same storage.
    clear :: (list: *List(T)) {
        list.items.len = 0;
    }

    ensure_capacity :: (list: *List(T), n: i64, alloc: Allocator = context.allocator, site: @SourceSite = @caller) {
        list.grow_to(n, alloc, site);
    }

    // Drop the reference to a backing that is ALREADY GONE (its arena
    // was reset) — no free, the list is empty and unallocated, ready
    // to grow again from any allocator. For an owned buffer, use
    // `deinit`.
    detach :: (list: *List(T)) {
        list.items.ptr = null;
        list.items.len = 0;
        list.cap = 0;
    }

    deinit :: (list: *List(T), alloc: Allocator = context.allocator) {
        // Ownership is `@sizeOf(T) > 0 and cap > 0`: a ZST growth sets `cap`
        // without allocating, so `cap` alone does not mean there is a buffer.
        // `items.ptr` is not the signal either — `.[]` leaves a len-0 slice
        // whose ptr need not be null.
        if @sizeOf(T) > 0 and list.cap > 0 {
            alloc.dealloc_bytes(list.items.ptr);
        }
        list.detach();
    }
}
