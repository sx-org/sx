// Public value and I/O contracts shared by std.zip and its private engine.
//
// Keeping these declarations in the public codec tree gives diagnostics,
// reflection, and protocol identity public names without duplicating or
// translating the shared std.compress error channel.

@import "modules/std/compress.sx";

Method :: enum { store; deflate; unsupported; }

Source :: interface {
    size :: (self: *Self) -> i64;
    readAt :: (self: *Self, offset: i64, output: string) -> (string, !Error);
}

Sink :: interface {
    write :: (self: *Self, data: string) -> !Error;
}

// Typed factory options. Optionals replace magic sentinels: a null
// `OpenFileOptions.size` means "to the end of the file".
WriterOptions :: struct {
    zip64: bool = false;
}

FileWriterOptions :: struct {
    reserve: i64 = 0;
    zip64: bool = false;
}

FromReaderOptions :: struct {
    forceZip64: bool = false;
}

AppendOptions :: struct {
    forceZip64: bool = false;
    maxMetadata: i64 = 67108864;
}

OpenOptions :: struct {
    maxMetadata: i64 = 67108864;
}

OpenFileOptions :: struct {
    start: i64 = 0;
    size: ?i64 = null;
    maxMetadata: i64 = 67108864;
}

EntryOptions :: struct {
    method: Method = .deflate;
    level: i64 = 6;
    comment: string = "";
    extra: string = "";
    centralExtra: ?string = null;
    storeSmall: bool = true;
    dataDescriptor: bool = true;
    utf8: bool = true;
    externalAttributes: u32 = 0;
    modifiedSeconds: ?i64 = null;
    useFileModifiedTime: bool = false;
}

Entry :: struct {
    name: string;
    comment: string;
    extra: string;
    method: Method;
    size: i64;
    compressedSize: i64;
    checksum: u32;
    modifiedSeconds: ?i64;
    externalAttributes: u32;
    encrypted: bool;
    directory: bool;
    supported: bool;
    safePath:  bool;
}
