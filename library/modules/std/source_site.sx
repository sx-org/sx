// =====================================================================
// source_site.sx — the identity algorithm behind `@SourceSite.id`.
//
// The compiler fills `id` at compile time, but the value is not opaque:
// this file IS the specification. A compiler-created site satisfies
//
//     site.id == sourceSiteKeyId(sourceSiteKey(site))
//
// and the compiler must produce the same result as the ordinary sx below.
//
// The hashing contract:
//   - length-prefix every string;
//   - encode integers little-endian, fixed width;
//   - never hash pointer identities or struct padding; and
//   - stay stable across optimization levels and compiler runs.
//
// At runtime a library EXTENDS the precomputed state instead of hashing the
// source fields again — `site.id` is the intermediate FNV state after them, so
//
//     hasher := sourceSiteHasher(site, "ui.compose.child.v1");
//     hasher.writeU64Le(runtimeOccurrence);
//     hasher.writeString(applicationKey);
//     identity := hasher.state;
//
// gives exactly one continuous hash over the source encoding plus the runtime
// suffix, and costs only the domain and the appended fields. The domain comes
// first so unrelated libraries never share an identity space.
//
// These are FINGERPRINTS, not proof of equality: code that needs
// collision-free correctness stores and compares `SourceSiteKey` plus its own
// dynamic key fields.
// =====================================================================
@import "modules/std/core.sx";
hash :: @import "modules/std/hash.sx";

// The source fields `id` is computed from — the whole of a site's identity.
// `line` and `column` are diagnostics, so they are deliberately absent.
SourceSiteKey :: struct {
    file: string;
    declaration: string;
    ordinal: u64;
}

// The writers are methods, not free functions: `writeString` is far too
// common a bare name to take in the flat prelude namespace.
SourceSiteHasher :: struct {
    state: u64 = hash.FNV_OFFSET_BASIS;

    writeByte :: (self: *SourceSiteHasher, value: u8) {
        self.state = (self.state ^ value.(u64)) * hash.FNV_PRIME;
    }

    writeU64Le :: (self: *SourceSiteHasher, value: u64) {
        inline for index in 0..8 {
            self.writeByte((value >> (index * 8).(u64)).(u8));
        }
    }

    writeString :: (self: *SourceSiteHasher, value: string) {
        self.writeU64Le(value.len.(u64));
        self.state = hash.fnv1aFold(self.state, value.ptr, value.len);
    }
}

sourceSiteKey :: (site: @SourceSite) -> SourceSiteKey {
    SourceSiteKey{
        file = site.file,
        declaration = site.declaration,
        ordinal = site.ordinal,
    }
}

// The normative encoding. The version string both versions the format and
// domain-separates source-site fingerprints from every other key space.
sourceSiteKeyId :: (key: SourceSiteKey) -> u64 {
    hasher := SourceSiteHasher{};
    hasher.writeString("sx.source-site.v1");
    hasher.writeString(key.file);
    hasher.writeString(key.declaration);
    hasher.writeU64Le(key.ordinal);
    hasher.state
}

// A hasher resumed from the source fields the compiler already folded, then
// domain-separated. Append dynamic fields after this returns.
sourceSiteHasher :: (site: @SourceSite, domain: string) -> SourceSiteHasher {
    hasher := SourceSiteHasher{ state = site.id };
    hasher.writeString(domain);
    hasher
}
