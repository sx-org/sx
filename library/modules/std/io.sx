io :: scope {
    @import "modules/std/core.sx";
    @import "modules/std/atomic.sx";
    @import "modules/std/mem.sx";
    @import "modules/std/c.sx";
    time :: @import "modules/std/time.sx";

    // Runs each task inline to completion, so its futures are born `.ready`.
    CBlocking :: struct {}

    // The default context borrows this global's storage.
    cBlocking : CBlocking = .{};

    @context.extend io: Io = cBlocking;

    impl Io for CBlocking {
        spawnRaw :: (self: *CBlocking, entry: *void, arg: *void, opts: SpawnOpts) -> *void {
            entryFn := @reinterpret((*void) -> void, entry);
            entryFn(arg);
            return null;
        }
        // Never parks: with no scheduler, nothing would wake the caller.
        suspendRaw :: (self: *CBlocking, park: *ParkToken) -> !IoErr.Canceled {
            return;
        }
        ready :: (self: *CBlocking, park: ParkToken) {}
        poll :: (self: *CBlocking, deadlineMs: i64) -> i64 { return 0; }
        nowMs :: (self: *CBlocking) -> i64 { return time.monoMs(); }
        armTimer :: (self: *CBlocking, deadlineMs: i64, park: ParkToken) -> *void {
            return null;
        }
        currentPark :: (self: *CBlocking) -> ParkToken {
            return .{ handle = null };
        }
    }

    FutureState :: enum { pending; ready; failed; canceled; }

    // The worker and the awaiter both own the Future; `futRelease` frees it
    // through `alloc` once `workerDone` and `consumed` are both set. A future
    // that is never awaited is never freed.
    Future :: struct ($R: Type) {
        Value :: R;

        value: R;
        state: FutureState = .pending;
        err: IoErr;
        park: ParkToken;
        task: *void = null;
        canceled: Atomic(bool);
        alloc: Allocator;
        workerDone: bool = false;
        consumed: bool = false;
    }

    // `spawnRaw`'s argument. `run` captures the worker by value, so
    // `workerEnv` keeps the worker's env reachable for freeing.
    ThunkBox :: struct { run: Closure() -> void; workerEnv: *void = null; alloc: Allocator; }

    // The one entry `spawnRaw` receives for every `async` instantiation.
    sxRunBoxedClosure :: (arg: *void) {
        b : *ThunkBox = arg.(*ThunkBox);
        b.run();
        a := b.alloc;
        runEnv := b.run.env;
        workerEnv := b.workerEnv;
        a.deallocBytes(runEnv);
        a.deallocBytes(workerEnv);
        a.deallocBytes(b);
    }

    futRelease :: ufcs (f: *Future($R)) {
        if f.workerDone and f.consumed {
            f.alloc.deallocBytes(f);
        }
    }

    // The Future, its box, the completion env and the persisted worker env all
    // come from `alloc`, which must outlive the future: until the worker has
    // run and `await` has consumed the result.
    async :: ufcs (io: Io, worker: $F/() -> ($R, !), alloc: Allocator = context.allocator) -> *Future($R) {
        w := mem.closure(worker, alloc);
        raw := alloc.allocBytes(@sizeOf(Future($R)));
        f : *Future($R) = raw.(*Future($R));
        f.state = .pending;
        f.park = .{ handle = null };
        f.canceled = Atomic(bool).init(false);
        f.alloc = alloc;
        f.workerDone = false;
        f.consumed = false;
        braw := alloc.allocBytes(@sizeOf(ThunkBox));
        b : *ThunkBox = braw.(*ThunkBox);
        b.workerEnv = w.env;
        b.alloc = alloc;
        b.run = mem.closure(||_{ f, w } {
            f.value = w() catch {
                if f.canceled.load(.acquire) { f.state = .canceled; }
                else { f.state = .failed; }
                context.io.ready(f.park);
                f.workerDone = true;
                futRelease(f);   // may free `f`
                return;
            };
            f.state = .ready;
            context.io.ready(f.park);
            f.workerDone = true;
            futRelease(f);   // may free `f`
        }, alloc);
        f.task = io.spawnRaw(@reinterpret(*void, sxRunBoxedClosure), b, .{ cancelFlag = *f.canceled });
        return f;
    }

    // Consumes `f`: it may be freed before `await` returns, so a second
    // `await` or a later `cancel(f)` is a use-after-free. One awaiter per future.
    await :: ufcs (f: *Future($R)) -> ($R, !IoErr) {
        alreadyCanceled := f.canceled.load(.acquire);
        if f.state == .pending and !alreadyCanceled {
            if f.park.handle != null {
                @printf("io: await — future already has an awaiter (one awaiter per future in the M:1 model)\n");
                c.abort();
            }
            context.io.suspendRaw(*f.park) catch {};   // cancellation surfaces via `f.canceled` below
        }
        canceled := f.canceled.load(.acquire);
        if f.state == .canceled { canceled = true; }
        failed := f.state == .failed;
        v := f.value;
        f.consumed = true;
        futRelease(f);   // may free `f`
        if canceled { raise IoErr.Canceled; }
        if failed { raise IoErr.Failed; }
        return v;
    }

    // The cancel flag is sticky: a later `await` raises `.Canceled`, and a parked
    // worker wakes to raise `.Canceled` from its suspend.
    cancel :: ufcs (f: *Future($R)) {
        // A settled future's fiber may already be reaped, so only a pending one is woken.
        wasPending := f.state == .pending;
        f.canceled.store(true, .release);
        f.state = .canceled;
        if wasPending { context.io.ready(.{ handle = f.task }); }
    }

    // A cancellation point: raises `.Canceled` when the task is cancelled while asleep.
    sleep :: ufcs (io: Io, ms: i64) -> !IoErr.Canceled {
        pk : ParkToken = .{ handle = null };
        io.armTimer(io.nowMs() + ms, pk);
        try io.suspendRaw(*pk);
    }
}
