// Formatting + string helpers: the `*_to_string` family, the `Writer` value
// walk, and the comptime `format` / `print` pair. Consumers never import this
// file directly — std.sx re-exports every public name here.
@import "modules/std/core.sx";
@import "modules/std/writer.sx";
c :: @import "modules/std/c.sx";

int_to_string :: (n: i64) -> string {
    if n == 0 { return "0"; }
    neg := n < 0;
    // Extract digits straight from `n` without ever negating it: `0 - n`
    // overflows for i64::MIN (its magnitude is unrepresentable as a
    // positive i64). sx `%` truncates toward zero, so `n % 10` keeps n's
    // sign; take each remainder's absolute value for the digit.
    digits : [20]u8 = ---;
    tmp := string{ ptr = *digits[0], len = 20 };
    i := 19;
    v := n;
    while v != 0 {
        d := v % 10;
        if d < 0 { d = 0 - d; }
        tmp[i] = d + '0';
        v = v / 10;
        i -= 1;
    }
    if neg { tmp[i] = '-'; i -= 1; }
    substr(tmp, i + 1, 19 - i)
}

// Unsigned decimal of `n`'s 64 bits — renders the full u64 range
// (0 .. 18446744073709551615).
uint_to_string :: (n: i64) -> string {
    if n == 0 { return "0"; }
    // Long division by 10 across the four unsigned 16-bit limbs, most
    // significant first. Each step folds the running remainder into the
    // next limb; the per-step accumulator stays well within i64
    // (max 9*65536 + 65535), so signed `/` and `%` are exact.
    g := decompose_u16x4(n);
    digits : [20]u8 = ---;
    tmp := string{ ptr = *digits[0], len = 20 };
    i := 19;
    while g[0] != 0 or g[1] != 0 or g[2] != 0 or g[3] != 0 {
        rem := 0;
        k := 0;
        while k < 4 {
            acc := rem * 65536 + g[k];
            g[k] = acc / 10;
            rem = acc % 10;
            k += 1;
        }
        tmp[i] = rem + '0';
        i -= 1;
    }
    substr(tmp, i + 1, 19 - i)
}

bool_to_string :: (b: bool) -> string {
    if b then "true" else "false"
}

float_to_string :: (f: f64) -> string {
    neg := f < 0.0;
    v := if neg then 0.0 - f else f;
    int_part := v.(i64);
    frac := ((v - int_part.(f64)) * 1000000.0).(i64);
    if frac < 0 { frac = 0 - frac; }
    istr := int_to_string(int_part);
    fstr := int_to_string(frac);
    zeros := "000000";
    sb := StringBuilder.init();
    if neg { sb.write("-"); }
    sb.write(istr);
    sb.write(".");
    sb.write(zeros[0 .. 6 - fstr.len]);
    sb.write(fstr);
    sb.finish()
}

hex_group :: (buf: string, offset: i64, val: i64) {
    i := offset + 3;
    v := val;
    while i >= offset {
        d := v % 16;
        buf[i] = if d < 10 then d + '0' else d - 10 + 'a';
        v = v / 16;
        i -= 1;
    }
}

// Split the 64 bits of `n` into four unsigned 16-bit limbs, most
// significant first: [g3, g2, g1, g0]. A negative input is treated as
// its two's-complement unsigned bit pattern — each limb is corrected
// back into 0..65535 — so callers get correct unsigned arithmetic out
// of a signed-only integer type. Shared by the hex and unsigned-decimal
// formatters.
decompose_u16x4 :: (n: i64) -> [4]i64 {
    g0 := n % 65536;
    if g0 < 0 { g0 = g0 + 65536; }
    r1 := (n - g0) / 65536;
    g1 := r1 % 65536;
    if g1 < 0 { g1 = g1 + 65536; }
    r2 := (r1 - g1) / 65536;
    g2 := r2 % 65536;
    if g2 < 0 { g2 = g2 + 65536; }
    r3 := (r2 - g2) / 65536;
    g3 := r3 % 65536;
    if g3 < 0 { g3 = g3 + 65536; }
    limbs : [4]i64 = ---;
    limbs[0] = g3;
    limbs[1] = g2;
    limbs[2] = g1;
    limbs[3] = g0;
    limbs
}

int_to_hex_string :: (n: i64) -> string {
    if n == 0 { return "0"; }

    g := decompose_u16x4(n);
    digits : [16]u8 = ---;
    buf := string{ ptr = *digits[0], len = 16 };
    hex_group(buf, 0, g[0]);
    hex_group(buf, 4, g[1]);
    hex_group(buf, 8, g[2]);
    hex_group(buf, 12, g[3]);

    // Skip leading zeros (keep at least 1 digit)
    start := 0;
    while start < 15 {
        if buf[start] != '0' { break; }
        start += 1;
    }
    substr(buf, start, 16 - start)
}

concat :: (a: string, b: string) -> string {
    sb := StringBuilder.init();
    sb.reserve(a.len + b.len);
    sb.write(a);
    sb.write(b);
    sb.finish()
}

substr :: (s: string, start: i64, len: i64) -> string {
    sb := StringBuilder.init();
    sb.reserve(len);
    sb.write(s[start .. start + len]);
    sb.finish()
}

last :: ufcs (s: []$T) -> ?$T {
    if s.len == 0 { return null; }
    s[s.len - 1]
}

// ── cstring: the C-boundary string ────────────────────────────────────
// `cstring` is ONE pointer to a null-terminated u8 buffer — C's `char *`.
// It carries no length (`cstring_len` walks to the terminator) and
// crosses `extern` boundaries verbatim in both directions; `?cstring`
// is the nullable case (null pointer = absent). String LITERALS coerce
// to `cstring` implicitly — their bytes are terminated constants; every
// other `string` must materialize through `to_cstring`.

// Byte length of `c` (strlen — O(n), walks to the terminator).
cstring_len :: (c: cstring) -> i64 {
    p : [*]u8 = c.([*]u8);
    n := 0;
    while p[n] != '\0' { n += 1; }
    n
}

// A zero-copy string VIEW over `c`'s bytes ({ptr, strlen}). The view
// shares C's buffer — `substr` it if it must outlive the source.
from_cstring :: (c: cstring) -> string {
    p : [*]u8 = c.([*]u8);
    string{ ptr = p, len = cstring_len(c) }
}

// An owned, terminated copy of `s` as a `cstring`.
to_cstring :: (s: string) -> cstring {
    sb := StringBuilder.init();
    sb.reserve(s.len + 1);
    sb.write(s);
    sb.write("\0");
    sb.finish().ptr.(cstring)
}

// Join path components with the POSIX separator ('/'). Skips empty
// components and collapses duplicate separators at component
// boundaries. Used for bundle paths where Apple .app and Android APK
// both expect POSIX-style paths.
path_join :: (..parts: []string) -> string {
    result := "";
    i := 0;
    while i < parts.len {
        p := parts[i];
        if p.len > 0 {
            if tail := result.([]u8).last() {
                head := p[0];
                if tail == '/' {
                    if head == '/' {
                        p = substr(p, 1, p.len - 1);
                    }
                } else {
                    if head != '/' {
                        result = concat(result, "/");
                    }
                }
            }
            result = concat(result, p);
        }
        i += 1;
    }
    result
}

struct_to_string :: (s: $T) -> string {
    // No type-name prefix: a struct VALUE prints `{x: 1, y: 2}`; a TYPE
    // value prints its name.
    result := "{";
    i := 0;
    while i < struct_field_count(T) {
        if i > 0 { result = concat(result, ", "); }
        result = concat(result, struct_field_name(T, i));
        result = concat(result, ": ");
        result = concat(result, any_to_string(struct_field_value(s, i)));
        i += 1;
    }
    concat(result, "}")
}

vector_to_string :: (v: $T) -> string {
    result := "[";
    i := 0;
    while i < v.len {
        if i > 0 { result = concat(result, ", "); }
        elem : any = v[i];
        result = concat(result, any_to_string(elem));
        i += 1;
    }
    concat(result, "]")
}

array_to_string :: (a: $T) -> string {
    result := "[";
    i := 0;
    while i < a.len {
        if i > 0 { result = concat(result, ", "); }
        elem : any = a[i];
        result = concat(result, any_to_string(elem));
        i += 1;
    }
    concat(result, "]")
}

slice_to_string :: (items: []$T) -> string {
    result := "[";
    i := 0;
    while i < items.len {
        if i > 0 { result = concat(result, ", "); }
        elem : any = items[i];
        result = concat(result, any_to_string(elem));
        i += 1;
    }
    concat(result, "]")
}

pointer_to_string :: (p: $T) -> string {
    addr : i64 = p.(i64);
    if addr == 0 { "null" } else {
        concat(@typeName(T), concat("@0x", int_to_hex_string(addr)))
    }
}

flags_to_string :: (val: $T) -> string {
    v := val.(i64);
    result := "";
    i := 0;
    while i < variant_count(T) {
        fv := variant_value(T, i);
        if v & fv {
            if result.len > 0 { result = concat(result, " | "); }
            result = concat(result, concat(".", variant_name(T, i)));
        }
        i += 1;
    }
    if result.len == 0 { result = "0"; }
    result
}

enum_to_string :: (u: $T) -> string {
    if is_flags(T) { return flags_to_string(u); }
    idx := variant_index(T, u);
    result := concat(".", variant_name(T, idx));
    payload := variant_payload(u, idx);
    pstr := any_to_string(payload);
    if pstr.len > 0 {
        result = concat(result, concat("(", concat(pstr, ")")));
    }
    result
}

optional_to_string :: (o: $T) -> string {
    if o == null { return "null"; }
    return any_to_string(o);
}

// The value walk: ONE compiled body renders every type. The boxed view's
// `@typeInfo` picks the shape and every part is a view into the same storage,
// so no type monomorphizes and nothing is copied.
write_any :: (w: Writer, val: any) {
    t := @typeOf(val);
    match @typeInfo(t) {
        case .void: {}
        case .bool: w.write(bool_to_string(@unbox(val, bool)));
        case .string: w.write(@unbox(val, string));
        // A category arm binds the widened reading its whole tag set shares,
        // so one arm covers every width.
        case .int: {
            match val {
                case unsigned: |n| { w.write(uint_to_string(n)); }
                case signed: |n| { w.write(int_to_string(n)); }
            }
        }
        case .float: {
            match val {
                case float: |f| { w.write(float_to_string(f)); }
            }
        }
        case .struct: |si| {
            w.write("{");
            fi := 0;
            while fi < si.fields.len {
                if fi > 0 { w.write(", "); }
                w.write(si.fields[fi].name);
                w.write(": ");
                write_any(w, @field(val, fi));
                fi += 1;
            }
            w.write("}");
        }
        case .enum: |ei| {
            if is_flags(t) {
                bits := __sx_any_tag_word(t, val);
                empty := true;
                fi := 0;
                while fi < ei.variants.len {
                    flag := ei.variants[fi];
                    if bits & flag.value {
                        if !empty { w.write(" | "); }
                        w.write(".");
                        w.write(flag.name);
                        empty = false;
                    }
                    fi += 1;
                }
                if empty { w.write("0"); }
            } else {
                idx := variant_index(t, val);
                live := ei.variants[idx];
                w.write(".");
                w.write(live.name);
                if !@typeEq(live.payload, void) {
                    w.write("(");
                    write_any(w, @field(val, idx));
                    w.write(")");
                }
            }
        }
        // The payload renders as it constructs, so a struct payload brings its
        // own braces and every other one takes a pair.
        case .error: {
            w.write(@errorName(val));
            p := @errorPayload(val);
            pt := @typeOf(p);
            match @typeInfo(pt) {
                case .void: {}
                case .struct: write_any(w, p);
                else: {
                    w.write("{");
                    write_any(w, p);
                    w.write("}");
                }
            }
        }
        case .array: write_elements(w, val);
        case .vector: write_elements(w, val);
        case .slice: write_elements(w, val);
        case .pointer: write_pointer(w, val);
        case .many_pointer: write_pointer(w, val);
        case .optional: {
            if p := @inner(val) { write_any(w, p); } else { w.write("null"); }
        }
        case .type_value: {
            tv := @unbox(val, Type);
            w.write(@typeName(tv));
        }
        else: w.write("<?>");
    }
}

write_elements :: (w: Writer, val: any) {
    w.write("[");
    n := @len(val);
    i := 0;
    while i < n {
        if i > 0 { w.write(", "); }
        write_any(w, @elementAt(val, i));
        i += 1;
    }
    w.write("]");
}

write_pointer :: (w: Writer, val: any) {
    p := @unbox(val, *void);
    if p == null { w.write("null"); return; }
    pt := @typeOf(val);
    w.write(@typeName(pt));
    w.write("@0x");
    w.write(int_to_hex_string(p.(i64)));
}

any_to_string :: (val: any) -> string {
    sb := StringBuilder.init();
    write_any(sb, val);
    sb.flush();
    sb.finish()
}

emit_segment :: (code: string, sink: string, start: i64, end: i64) -> string {
    r := concat(code, sink);
    r = concat(r, ".write(fmt[");
    r = concat(r, int_to_string(start));
    r = concat(r, "..");
    r = concat(r, int_to_string(end));
    concat(r, "]); ")
}

// The writes `fmt` spells, as statements against `sink` — the name of a
// `Writer` in scope at the `@insert` site, alongside `fmt` and `args`. A
// literal run goes out as a view into `fmt`, a `{}` as its argument's
// rendering, and `{{` / `}}` carry one brace through.
build_format :: (fmt: string, sink: string) -> string {
    code := "";
    seg_start := 0;
    i := 0;
    arg_idx := 0;
    while i < fmt.len {
        if fmt[i] == '{' {
            if i + 1 < fmt.len {
                if fmt[i + 1] == '}' {
                    if i > seg_start { code = emit_segment(code, sink, seg_start, i); }
                    code = concat(code, "write_any(");
                    code = concat(code, sink);
                    code = concat(code, ", args[");
                    code = concat(code, int_to_string(arg_idx));
                    code = concat(code, "]); ");
                    arg_idx += 1;
                    i += 2;
                    seg_start = i;
                } else if fmt[i + 1] == '{' {
                    code = emit_segment(code, sink, seg_start, i + 1);
                    i += 2;
                    seg_start = i;
                } else {
                    i += 1;
                }
            } else {
                i += 1;
            }
        } else if fmt[i] == '}' {
            if i + 1 < fmt.len {
                if fmt[i + 1] == '}' {
                    code = emit_segment(code, sink, seg_start, i + 1);
                    i += 2;
                    seg_start = i;
                } else {
                    i += 1;
                }
            } else {
                i += 1;
            }
        } else {
            i += 1;
        }
    }
    if seg_start < fmt.len { code = emit_segment(code, sink, seg_start, fmt.len); }
    code
}

format :: ($fmt: string, ..$args) -> string {
    sb := StringBuilder.init();
    @insert build_format(fmt, "sb");
    sb.flush();
    return sb.finish();
}

print :: ($fmt: string, ..$args) {
    w := FdWriter.init(1);
    @insert build_format(fmt, "w");
    w.flush();
}

// ── Postfix-assertion runtime ───────────────────────────────────────────
// `av.(T)` on a type-erased receiver is a CHECKED assertion: `@tryCast` is
// the error-channel temperament, `@cast` panics on mismatch (the
// unconsumed-failable carve-out; Go/Odin parity), `@castOrNull` answers
// mismatch with `null`. The compiler rewrites the postfix forms to these.

CastError :: error { mismatch }

@tryCast :: (av: any, $T: Type) -> (T, !CastError) {
    if !@typeEq(@typeOf(av), T) { raise .mismatch; }
    return av.(@Any).data.(*T).*;
}

@cast :: (av: any, $T: Type, site: @SourceSite = @caller) -> T {
    if !@typeEq(@typeOf(av), T) {
        print("type assertion failed at {}:{}: expected {}, got {}\n", site.file, site.line, T, @typeOf(av));
        c.exit(1);
    }
    return av.(@Any).data.(*T).*;
}

// Mismatch is a value (`null`), never a failure — the optional IS the check
// (comma-ok parity).
@castOrNull :: (av: any, $T: Type) -> ?T {
    if !@typeEq(@typeOf(av), T) { return null; }
    v : T = av.(@Any).data.(*T).*;
    return v;
}

// `p.(Q)` between interfaces, unconsumed: an absent row stops the program. The
// referent's concrete type is only known to the running program, so the message
// reads it off the handle rather than off the site.
__sx_reerase_or_panic :: (conforms: bool, concrete: Type, target: Type) {
    if !conforms {
        print("re-erasure failed: '{}' does not conform to '{}'\n", @typeName(concrete), @typeName(target));
        c.exit(1);
    }
}

// ── Optional-chained assertions `o?.(T)` on a `?any` receiver ──────────
// Chain-null is always a VALUE (null result), never a failure; each
// temperament's failure handling applies only to a PRESENT payload.
// (Bodies are self-contained rather than delegating to the unchained
// helpers: a nested generic `try` does not bind `$T` through the outer
// instantiation.)

// Consumed forms (`try o?.(T)`, `o?.(T) ?? d`, `… catch`): mismatch of a
// present payload goes down the error channel; null passes through.
__sx_chain_cast_assert :: (o: ?any, $T: Type) -> (?T, !CastError) {
    if av := o {
        if !@typeEq(@typeOf(av), T) { raise .mismatch; }
        v : T = av.(@Any).data.(*T).*;
        r : ?T = v;
        return r;
    }
    return null;
}

// Unconsumed form (`v := o?.(T);`): a present, mismatched payload panics.
__sx_chain_cast_or_panic :: (o: ?any, $T: Type, site: @SourceSite = @caller) -> ?T {
    if av := o {
        if !@typeEq(@typeOf(av), T) {
            print("type assertion failed at {}:{}: expected {}, got {}\n", site.file, site.line, T, @typeOf(av));
            c.exit(1);
        }
        v : T = av.(@Any).data.(*T).*;
        r : ?T = v;
        return r;
    }
    return null;
}

// Soft form (`o?.(?T)`): chain-null and mismatch-null CONFLATE.
__sx_chain_cast_maybe :: (o: ?any, $T: Type) -> ?T {
    if av := o {
        if !@typeEq(@typeOf(av), T) { return null; }
        v : T = av.(@Any).data.(*T).*;
        r : ?T = v;
        return r;
    }
    return null;
}

// ── The runtime variant walk (enum/tagged-union values behind an `any`) ──
// The tag word of the variant value `av` views: little-endian byte assembly
// of the low `__sx_variant_tag_width(t)` bytes (a payload-less enum's whole
// value; a tagged union's tag slot at offset 0 — never the wider header a
// backing-type union may carry). A negative width means a signed backing /
// tag type: sign-extend so small negative explicit values round-trip.
__sx_any_tag_word :: (t: Type, av: any) -> i64 {
    w := __sx_variant_tag_width(t);
    signed := false;
    if w < 0 { signed = true; w = -w; }
    p : [*]u8 = raw_any_data(av).([*]u8);
    v := 0;
    i := 0;
    while i < w {
        b : i64 = p[i];
        v = v | (b << (8 * i));
        i += 1;
    }
    if signed {
        if w < 8 {
            shift := 64 - 8 * w;
            v = (v << shift) >> shift;
        }
    }
    v
}

// `variant_index(t, av)` with a RUNTIME t lowers to this scan: value → the
// sequential ordinal, over the runtime variant-value table (explicit values
// and explicit tags included). A tag the table does not list names no variant.
__sx_variant_index :: (t: Type, av: any) -> i64 {
    v := __sx_any_tag_word(t, av);
    n := variant_count(t);
    i := 0;
    while i < n {
        if variant_value(t, i) == v { return i; }
        i += 1;
    }
    @panic(format("{} has no variant for tag {}", @typeName(t), v), @SourceSite{})
}
