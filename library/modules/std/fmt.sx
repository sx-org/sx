// Formatting + string helpers: the `*ToString` family, the `Writer` value
// walk, and the comptime `format` / `print` pair. Consumers never import this
// file directly — std.sx re-exports every public name here.
@import "modules/std/core.sx";
@import "modules/std/writer.sx";
c :: @import "modules/std/c.sx";

intToString :: (n: i64) -> string {
    sb := StringBuilder.init();
    writeInt(sb, n);
    sb.finish()
}

hexGroup :: (buf: string, offset: i64, val: i64) {
    i := offset + 3;
    v := val;
    while i >= offset {
        d := v % 16;
        buf[i] = if d < 10 then d + '0' else d - 10 + 'a';
        v = v / 16;
        i -= 1;
    }
}

// Split the 64 bits of `n` into four unsigned 16-bit limbs, most
// significant first: [g3, g2, g1, g0]. A negative input is treated as
// its two's-complement unsigned bit pattern — each limb is corrected
// back into 0..65535 — so callers get correct unsigned arithmetic out
// of a signed-only integer type. Shared by the hex and unsigned-decimal
// formatters.
decomposeU16x4 :: (n: i64) -> [4]i64 {
    g0 := n % 65536;
    if g0 < 0 { g0 = g0 + 65536; }
    r1 := (n - g0) / 65536;
    g1 := r1 % 65536;
    if g1 < 0 { g1 = g1 + 65536; }
    r2 := (r1 - g1) / 65536;
    g2 := r2 % 65536;
    if g2 < 0 { g2 = g2 + 65536; }
    r3 := (r2 - g2) / 65536;
    g3 := r3 % 65536;
    if g3 < 0 { g3 = g3 + 65536; }
    limbs : [4]i64 = ---;
    limbs[0] = g3;
    limbs[1] = g2;
    limbs[2] = g1;
    limbs[3] = g0;
    limbs
}

intToHexString :: (n: i64) -> string {
    if n == 0 { return "0"; }

    g := decomposeU16x4(n);
    digits : [16]u8 = ---;
    buf := string{ ptr = *digits[0], len = 16 };
    hexGroup(buf, 0, g[0]);
    hexGroup(buf, 4, g[1]);
    hexGroup(buf, 8, g[2]);
    hexGroup(buf, 12, g[3]);

    // Skip leading zeros (keep at least 1 digit)
    start := 0;
    while start < 15 {
        if buf[start] != '0' { break; }
        start += 1;
    }
    sb := StringBuilder.init();
    sb.write(buf[start .. 16]);
    sb.finish()
}

concat :: (..parts: []string) -> string {
    n := 0;
    for p in parts { n += p.len; }
    sb := StringBuilder.init();
    sb.reserve(n);
    for p in parts { sb.write(p); }
    sb.finish()
}

last :: ufcs (s: []$T) -> ?$T {
    if s.len == 0 { return null; }
    s[s.len - 1]
}

// ── cstring: the C-boundary string ────────────────────────────────────
// `cstring` is ONE pointer to a null-terminated u8 buffer — C's `char *`.
// It carries no length (`cstringLen` walks to the terminator) and
// crosses `extern` boundaries verbatim in both directions; `?cstring`
// is the nullable case (null pointer = absent). String LITERALS coerce
// to `cstring` implicitly — their bytes are terminated constants; every
// other `string` must materialize through `toCstring`.

// Byte length of `c` (strlen — O(n), walks to the terminator).
cstringLen :: (c: cstring) -> i64 {
    p : [*]u8 = c.([*]u8);
    n := 0;
    while p[n] != '\0' { n += 1; }
    n
}

// A zero-copy string VIEW over `c`'s bytes ({ptr, strlen}). The view
// shares C's buffer — copy it if it must outlive the source.
fromCstring :: (c: cstring) -> string {
    p : [*]u8 = c.([*]u8);
    string{ ptr = p, len = cstringLen(c) }
}

// An owned, terminated copy of `s` as a `cstring`.
toCstring :: (s: string) -> cstring {
    sb := StringBuilder.init();
    sb.reserve(s.len + 1);
    sb.write(s);
    sb.write("\0");
    sb.finish().ptr.(cstring)
}

// Join path components with the POSIX separator ('/'). Skips empty
// components and collapses duplicate separators at component
// boundaries. Used for bundle paths where Apple .app and Android APK
// both expect POSIX-style paths.
pathJoin :: (..parts: []string) -> string {
    sb := StringBuilder.init();
    tail : ?u8 = null;
    for p in parts {
        if p.len == 0 { continue; }
        start := 0;
        if t := tail {
            if t == '/' {
                if p[0] == '/' { start = 1; }
            } else if p[0] != '/' {
                sb.write("/");
            }
        }
        sb.write(p[start .. p.len]);
        tail = p[p.len - 1];
    }
    sb.finish()
}

structToString :: (s: $T) -> string {
    // No type-name prefix: a struct VALUE prints `{x: 1, y: 2}`; a TYPE
    // value prints its name.
    result := "{";
    inline for field in @typeInfo(T).struct.fields {
        if field.index > 0 { result = concat(result, ", "); }
        result = concat(result, field.name);
        result = concat(result, ": ");
        result = concat(result, anyToString(@field(s, field.index)));
    }
    concat(result, "}")
}

vectorToString :: (v: $T) -> string {
    result := "[";
    i := 0;
    while i < v.len {
        if i > 0 { result = concat(result, ", "); }
        elem : any = v[i];
        result = concat(result, anyToString(elem));
        i += 1;
    }
    concat(result, "]")
}

arrayToString :: (a: $T) -> string {
    result := "[";
    i := 0;
    while i < a.len {
        if i > 0 { result = concat(result, ", "); }
        elem : any = a[i];
        result = concat(result, anyToString(elem));
        i += 1;
    }
    concat(result, "]")
}

sliceToString :: (items: []$T) -> string {
    result := "[";
    i := 0;
    while i < items.len {
        if i > 0 { result = concat(result, ", "); }
        elem : any = items[i];
        result = concat(result, anyToString(elem));
        i += 1;
    }
    concat(result, "]")
}

pointerToString :: (p: $T) -> string {
    addr : i64 = p.(i64);
    if addr == 0 { "null" } else {
        concat(@typeName(T), concat("@0x", intToHexString(addr)))
    }
}

flagsToString :: (val: $T) -> string {
    v := val.(i64);
    result := "";
    inline for variant in @typeInfo(T).enum.fields {
        if v & variant.value {
            if result.len > 0 { result = concat(result, " | "); }
            result = concat(result, concat(".", variant.name));
        }
    }
    if result.len == 0 { result = "0"; }
    result
}

enumToString :: (u: $T) -> string {
    if isFlags(T) { return flagsToString(u); }
    av : any = u;
    idx := __sx_variant_index(T, av);
    result := concat(".", @typeInfo(T).enum.fields[idx].name);
    pstr := anyToString(@field(av, idx));
    if pstr.len > 0 {
        result = concat(result, concat("(", concat(pstr, ")")));
    }
    result
}

optionalToString :: (o: $T) -> string {
    if o == null { return "null"; }
    return anyToString(o);
}

// The value walk: ONE compiled body renders every type. The boxed view's
// `@typeInfo` picks the shape and every part is a view into the same storage,
// so no type monomorphizes and nothing is copied.
writeAny :: (w: Writer, val: any) {
    t := @typeOf(val);
    match @typeInfo(t) {
        case .void: {}
        case .bool: writeBool(w, @unbox(val, bool));
        case .string: w.write(@unbox(val, string));
        // A category arm binds the widened reading its whole tag set shares,
        // so one arm covers every width.
        case .int: {
            match val {
                case unsigned: |n| { writeUint(w, n); }
                case signed: |n| { writeInt(w, n); }
            }
        }
        case .float: {
            match val {
                case float: |f| { writeFloat(w, f); }
            }
        }
        case .struct: |si| {
            w.write("{");
            fi := 0;
            while fi < si.fields.len {
                if fi > 0 { w.write(", "); }
                w.write(si.fields[fi].name);
                w.write(": ");
                writeAny(w, @field(val, fi));
                fi += 1;
            }
            w.write("}");
        }
        case .enum: |ei| {
            if isFlags(t) {
                bits := __sx_any_tag_word(t, val);
                empty := true;
                fi := 0;
                while fi < ei.fields.len {
                    flag := ei.fields[fi];
                    if bits & flag.value {
                        if !empty { w.write(" | "); }
                        w.write(".");
                        w.write(flag.name);
                        empty = false;
                    }
                    fi += 1;
                }
                if empty { w.write("0"); }
            } else {
                idx := __sx_variant_index(t, val);
                live := ei.fields[idx];
                w.write(".");
                w.write(live.name);
                if !@typeEq(live.payload, void) {
                    w.write("(");
                    writeAny(w, @field(val, idx));
                    w.write(")");
                }
            }
        }
        // The payload renders as it constructs, so a struct payload brings its
        // own braces and every other one takes a pair.
        case .error: {
            w.write(@errorName(val));
            p := @errorPayload(val);
            pt := @typeOf(p);
            match @typeInfo(pt) {
                case .void: {}
                case .struct: writeAny(w, p);
                else: {
                    w.write("{");
                    writeAny(w, p);
                    w.write("}");
                }
            }
        }
        case .array: writeElements(w, val);
        case .vector: writeElements(w, val);
        case .slice: writeElements(w, val);
        case .pointer: writePointer(w, val);
        case .manyPointer: writePointer(w, val);
        case .optional: {
            if p := @inner(val) { writeAny(w, p); } else { w.write("null"); }
        }
        case .typeValue: {
            tv := @unbox(val, Type);
            w.write(@typeName(tv));
        }
        else: w.write("<?>");
    }
}

writeElements :: (w: Writer, val: any) {
    w.write("[");
    n := @len(val);
    i := 0;
    while i < n {
        if i > 0 { w.write(", "); }
        writeAny(w, @field(val, i));
        i += 1;
    }
    w.write("]");
}

writePointer :: (w: Writer, val: any) {
    p := @unbox(val, *void);
    if p == null { w.write("null"); return; }
    pt := @typeOf(val);
    w.write(@typeName(pt));
    w.write("@0x");
    w.write(intToHexString(p.(i64)));
}

anyToString :: (val: any) -> string {
    sb := StringBuilder.init();
    writeAny(sb, val);
    sb.flush();
    sb.finish()
}

emitSegment :: (code: string, sink: string, start: i64, end: i64) -> string {
    r := concat(code, sink);
    r = concat(r, ".write(fmt[");
    r = concat(r, intToString(start));
    r = concat(r, "..");
    r = concat(r, intToString(end));
    concat(r, "]); ")
}

// The writes `fmt` spells, as statements against `sink` — the name of a
// `Writer` in scope at the `@insert` site, alongside `fmt` and `args`. A
// literal run goes out as a view into `fmt`, a `{}` as its argument's
// rendering, and `{{` / `}}` carry one brace through.
buildFormat :: (fmt: string, sink: string) -> string {
    code := "";
    segStart := 0;
    i := 0;
    argIdx := 0;
    while i < fmt.len {
        if fmt[i] == '{' {
            if i + 1 < fmt.len {
                if fmt[i + 1] == '}' {
                    if i > segStart { code = emitSegment(code, sink, segStart, i); }
                    code = concat(code, "writeAny(");
                    code = concat(code, sink);
                    code = concat(code, ", args[");
                    code = concat(code, intToString(argIdx));
                    code = concat(code, "]); ");
                    argIdx += 1;
                    i += 2;
                    segStart = i;
                } else if fmt[i + 1] == '{' {
                    code = emitSegment(code, sink, segStart, i + 1);
                    i += 2;
                    segStart = i;
                } else {
                    i += 1;
                }
            } else {
                i += 1;
            }
        } else if fmt[i] == '}' {
            if i + 1 < fmt.len {
                if fmt[i + 1] == '}' {
                    code = emitSegment(code, sink, segStart, i + 1);
                    i += 2;
                    segStart = i;
                } else {
                    i += 1;
                }
            } else {
                i += 1;
            }
        } else {
            i += 1;
        }
    }
    if segStart < fmt.len { code = emitSegment(code, sink, segStart, fmt.len); }
    code
}

format :: ($fmt: string, ..$args) -> string {
    sb := StringBuilder.init();
    @insert buildFormat(fmt, "sb");
    sb.flush();
    return sb.finish();
}

print :: ($fmt: string, ..$args) {
    w := FdWriter.init(.stdout);
    @insert buildFormat(fmt, "w");
    w.flush();
}

// `p.(Q)` between interfaces, unconsumed: an absent row stops the program. The
// referent's concrete type is only known to the running program, so the message
// reads it off the handle rather than off the site.
__sx_reerase_or_panic :: (conforms: bool, concrete: Type, target: Type) {
    if !conforms {
        print("re-erasure failed: '{}' does not conform to '{}'\n", @typeName(concrete), @typeName(target));
        c.exit(1);
    }
}

// ── The runtime variant walk (enum/tagged-union values behind an `any`) ──
// The tag word of the variant value `av` views: little-endian byte assembly
// of the low `__sx_variant_tag_width(t)` bytes (a payload-less enum's whole
// value; a tagged union's tag slot at offset 0 — never the wider header a
// backing-type union may carry). A negative width means a signed backing /
// tag type: sign-extend so small negative explicit values round-trip.
__sx_any_tag_word :: (t: Type, av: any) -> i64 {
    w := __sx_variant_tag_width(t);
    signed := false;
    if w < 0 { signed = true; w = -w; }
    p : [*]u8 = rawAnyData(av).([*]u8);
    v := 0;
    i := 0;
    while i < w {
        b : i64 = p[i];
        v = v | (b << (8 * i));
        i += 1;
    }
    if signed {
        if w < 8 {
            shift := 64 - 8 * w;
            v = (v << shift) >> shift;
        }
    }
    v
}

// A variant value's SEQUENTIAL ordinal: scan the reflected variant values
// (explicit values and explicit tags included) for the one the tag word
// carries.
__sx_variant_index :: (t: Type, av: any) -> i64 {
    v := __sx_any_tag_word(t, av);
    n := @typeInfo(t).enum.fields.len;
    i := 0;
    while i < n {
        if @typeInfo(t).enum.fields[i].value == v { return i; }
        i += 1;
    }
    @panic(format("{} has no variant for tag {}", @typeName(t), v), @SourceSite{})
}
