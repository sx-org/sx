// The heap-backed `Writer` and the separator loop over any `Writer`.
// Consumers never import this file directly — std.sx re-exports every name
// here.
@import "modules/std/core.sx";
c :: @import "modules/std/c.sx";

// Text accumulated on the heap. `finish` hands the bytes to the caller and
// leaves the builder empty, so the built string outlives the builder without
// a copy.
StringBuilder :: struct {
    bytes: []u8 = .[];   // `.len` is the live byte count, `cap` the allocation
    cap: i64 = 0;
    alloc: Allocator;

    init :: (alloc: Allocator = context.allocator) -> StringBuilder {
        .{ alloc = alloc }
    }

    // The only path that allocates. A refusal panics before any field is
    // written, so the builder still owns its buffer; `write` has no site
    // parameter to name, so the panic carries no location.
    reserve :: (self: *StringBuilder, n: i64) {
        if self.cap >= n { return; }
        newCap := if self.cap == 0 then 16 else self.cap;
        while newCap < n and newCap <= i64.max / 2 { newCap = newCap * 2; }
        if newCap < n { newCap = n; }
        raw := self.alloc.allocBytes(newCap);
        if raw == null { @panic("StringBuilder: out of memory", @SourceSite{}); }
        if self.bytes.len > 0 { c.memcpy(raw, self.bytes.ptr, self.bytes.len); }
        if self.cap > 0 { self.alloc.deallocBytes(self.bytes.ptr); }
        self.bytes.ptr = raw.([*]u8);
        self.cap = newCap;
    }

    finish :: (self: *StringBuilder) -> string {
        s := string{ ptr = self.bytes.ptr, len = self.bytes.len };
        self.bytes = .[];
        self.cap = 0;
        s
    }
}

impl Writer for StringBuilder {
    write :: (self: *StringBuilder, s: string) -> void {
        if s.len == 0 { return; }
        n := self.bytes.len + s.len;
        // A wrapped sum names less than the write needs; no allocator funds i64.max.
        self.reserve(if n < self.bytes.len then i64.max else n);
        c.memcpy(*self.bytes.ptr[self.bytes.len], s.ptr, s.len);
        self.bytes.len += s.len;
    }
}

// Text written into a caller-owned buffer. `len` is the length the text
// needs; bytes past the end of `dst` are counted but not stored.
FixedWriter :: struct {
    dst: []u8;
    len: i64 = 0;

    init :: (dst: []u8) -> FixedWriter => .{ dst = dst };

    // The bytes, or null when they did not fit — `len` is then the size that
    // would.
    written :: (self: *FixedWriter) -> ?string {
        if self.len > self.dst.len { return null; }
        self.dst[..self.len]
    }
}

impl Writer for FixedWriter {
    write :: (self: *FixedWriter, s: string) -> void {
        room := self.dst.len - self.len;
        if room > 0 {
            n := if s.len < room then s.len else room;
            c.memcpy(*self.dst[self.len], s.ptr, n);
        }
        self.len += s.len;
    }
}

// Write `n` items with `sep` between them; `body(i)` writes item `i`. The call
// consumes `body` before returning, so a capturing lambda stays on the stack.
writeEach :: ufcs (w: Writer, n: i64, sep: string, body: $F/(i64) -> void) {
    i := 0;
    while i < n {
        if i > 0 { w.write(sep); }
        body(i);
        i += 1;
    }
}
