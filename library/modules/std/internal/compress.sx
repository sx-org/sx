// Inflate

Huffman :: struct {
    counts: [16]i16;
    symbols: [288]i16;
    // Exact tinfl lookup representation: low 9 bits hold the symbol and the
    // remaining bits hold the code length. Negative entries select the exact
    // compact binary tree used for codes longer than the 10-bit lookup.
    fast: [1024]i16;
    tree: [576]i16;
}

private buildHuffmanInto :: (h: *Huffman, lengths: string, allowSingle: bool = true, allowEmpty: bool = false) -> !Error {
    i := 0;
    while i < 16 { h.counts[i] = 0; i += 1; }
    i = 0;
    while i < 288 { h.symbols[i] = 0; i += 1; }
    i = 0;
    while i < 1024 { h.fast[i] = 0; i += 1; }
    i = 0;
    while i < 576 { h.tree[i] = 0; i += 1; }

    i = 0;
    nonzero := 0;
    maxLen := 0;
    while i < lengths.len {
        len := lengths[i].(i64);
        if len > 15 { raise .InvalidData; }
        h.counts[len] += 1;
        if len > 0 {
            nonzero += 1;
            if len > maxLen { maxLen = len; }
        }
        i += 1;
    }

    // RFC 1951 permits a dynamic block with one zero-length distance entry
    // when the block contains no matches. It is an unusable tree and decoding
    // a match through it still fails, but literal-only/Huffman-only blocks are
    // valid. No other alphabet may be empty.
    if h.counts[0].(i64) == lengths.len {
        if allowEmpty { return; }
        raise .InvalidData;
    }
    left := 1;
    len := 1;
    while len <= 15 {
        left = (left << 1) - h.counts[len].(i64);
        if left < 0 { raise .InvalidData; }
        len += 1;
    }
    if left > 0 and !(allowSingle and nonzero == 1 and maxLen == 1) {
        raise .InvalidData;
    }

    offsets : [16]i32 = ---;
    offsets[0] = 0;
    offsets[1] = 0;
    len = 1;
    while len < 15 {
        offsets[len + 1] = offsets[len] + h.counts[len];
        len += 1;
    }
    i = 0;
    while i < lengths.len {
        l := lengths[i].(i64);
        if l != 0 {
            at := offsets[l].(i64);
            h.symbols[at] = i.(i16);
            offsets[l] += 1;
        }
        i += 1;
    }

    nextCode : [16]i64 = ---;
    i = 0;
    while i < 16 { nextCode[i] = 0; i += 1; }
    code := 0;
    treeNext := -1;
    len = 1;
    while len <= 15 {
        if len > 1 { code = (code + h.counts[len - 1].(i64)) << 1; }
        nextCode[len] = code;
        len += 1;
    }
    i = 0;
    while i < lengths.len {
        l := lengths[i].(i64);
        if l > 0 {
            canonical := nextCode[l];
            nextCode[l] += 1;
            if l <= 10 {
                wire := reverseBits(canonical, l);
                variants := 1 << (10 - l);
                suffix := 0;
                while suffix < variants {
                    h.fast[wire | (suffix << l)] = ((l << 9) | i).(i16);
                    suffix += 1;
                }
            } else {
                revCode := reverseBits(canonical, l);
                lookupAt := revCode & 1023;
                treeCur := h.fast[lookupAt].(i64);
                if treeCur == 0 {
                    h.fast[lookupAt] = treeNext.(i16);
                    treeCur = treeNext;
                    treeNext -= 2;
                }
                revCode = revCode >> 9;
                remaining := l;
                while remaining > 11 {
                    revCode = revCode >> 1;
                    treeCur -= revCode & 1;
                    treeAt := -treeCur - 1;
                    if h.tree[treeAt] == 0 {
                        h.tree[treeAt] = treeNext.(i16);
                        treeCur = treeNext;
                        treeNext -= 2;
                    } else {
                        treeCur = h.tree[treeAt].(i64);
                    }
                    remaining -= 1;
                }
                revCode = revCode >> 1;
                treeCur -= revCode & 1;
                h.tree[-treeCur - 1] = i.(i16);
            }
        }
        i += 1;
    }
}

// Resolve one symbol using tinfl's 10-bit table and negative-node tree. The
// result keeps the table encoding so callers can consume its length directly.
private huffmanResolve :: (h: *Huffman, bits: i64) -> i64 {
    entry := h.fast[bits & 1023].(i64);
    if entry >= 0 { return entry; }
    length := 10;
    while entry < 0 {
        entry = h.tree[-entry - 1 + ((bits >> length) & 1)].(i64);
        length += 1;
    }
    (length << 9) | entry
}

private fixedTreesInto :: (lit: *Huffman, dist: *Huffman) -> !Error {
    litLengths : [288]u8 = ---;
    i := 0;
    while i <= 143 { litLengths[i] = 8; i += 1; }
    while i <= 255 { litLengths[i] = 9; i += 1; }
    while i <= 279 { litLengths[i] = 7; i += 1; }
    while i <= 287 { litLengths[i] = 8; i += 1; }
    distLengths : [32]u8 = ---;
    i = 0;
    while i < 32 { distLengths[i] = 5; i += 1; }
    try buildHuffmanInto(lit, string{ ptr = *litLengths[0], len = 288 });
    try buildHuffmanInto(dist, string{ ptr = *distLengths[0], len = 32 });
}

private CODELEN_ORDER : [19]i64 = .[16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15];

// -----------------------------------------------------------------------------
// Resumable raw inflate

private StoredDeflatePhase :: enum { fill; header; payload; done; }

// Bounded-memory streaming stored-block encoder. This is the level-0
// primitive and owns one allocator-backed 65,535-byte block buffer.
// `finish=true` latches end-of-input. Callers must re-present any unconsumed
// tail when a call returns `needOutput`.
private StoredDeflater :: struct {
    phase: StoredDeflatePhase;
    buffer: string;
    buffered: i64;
    payloadAt: i64;
    header: [5]u8;
    headerAt:  i64;
    finishing: bool;
    blockFinal: bool;
    alloc: Allocator;

    initWithBuffer :: (alloc: Allocator, buffer: string) -> StoredDeflater {
        StoredDeflater{
            phase = .fill,
            buffer = buffer,
            buffered = 0,
            payloadAt = 0,
            header = ---,
            headerAt = 0,
            finishing = false,
            blockFinal = false,
            alloc = alloc,
        }
    }

    init :: (alloc: Allocator = context.allocator) -> StoredDeflater {
        raw := alloc.allocBytes(65535);
        buffer : string = .{ ptr = null, len = 0 };
        if raw != null { buffer = .{ ptr = raw, len = 65535 }; }
        StoredDeflater.initWithBuffer(alloc, buffer)
    }

    reset :: (self: *StoredDeflater) {
        buffer := self.buffer;
        alloc := self.alloc;
        if buffer.ptr == null {
            raw := alloc.allocBytes(65535);
            if raw != null { buffer = .{ ptr = raw, len = 65535 }; }
        }
        self.* = StoredDeflater.initWithBuffer(alloc, buffer);
    }

    deinit :: (self: *StoredDeflater) {
        if self.buffer.ptr != null { self.alloc.deallocBytes(self.buffer.ptr); }
        self.buffer.ptr = null;
        self.buffer.len = 0;
        self.phase = .done;
    }

    beginBlock :: (self: *StoredDeflater, final: bool) {
        self.blockFinal = final;
        self.header[0] = if final then 1 else 0;
        self.header[1] = (self.buffered & 0xff).(u8);
        self.header[2] = ((self.buffered >> 8) & 0xff).(u8);
        inverse := self.buffered ^ 0xffff;
        self.header[3] = (inverse & 0xff).(u8);
        self.header[4] = ((inverse >> 8) & 0xff).(u8);
        self.headerAt = 0;
        self.payloadAt = 0;
        self.phase = .header;
    }

    step :: (self: *StoredDeflater, input: string, output: string, finish: bool = false) -> (Progress, !Error) {
        if self.buffer.ptr == null { raise .AllocationFailed; }
        if finish { self.finishing = true; }
        if self.phase == .done {
            if input.len > 0 { raise .Finished; }
            return Progress{ consumed = 0, produced = 0, status = .done };
        }
        consumed := 0;
        produced := 0;
        while true {
            if self.phase == .fill {
                take := 65535 - self.buffered;
                if take > input.len - consumed { take = input.len - consumed; }
                n := 0;
                while n < take {
                    self.buffer[self.buffered] = input[consumed];
                    self.buffered += 1;
                    consumed += 1;
                    n += 1;
                }
                if self.buffered == 65535 {
                    self.beginBlock(self.finishing and consumed == input.len);
                    continue;
                }
                if self.finishing and consumed == input.len {
                    self.beginBlock(true);
                    continue;
                }
                return Progress{ consumed = consumed, produced = produced, status = .needInput };
            }
            if self.phase == .header {
                if self.blockFinal and input.len - consumed > 0 { raise .Finished; }
                while self.headerAt < 5 and produced < output.len {
                    output.ptr[produced] = self.header[self.headerAt];
                    self.headerAt += 1;
                    produced += 1;
                }
                if self.headerAt < 5 { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                self.phase = .payload;
                continue;
            }
            if self.phase == .payload {
                if self.blockFinal and input.len - consumed > 0 { raise .Finished; }
                take := self.buffered - self.payloadAt;
                if take > output.len - produced { take = output.len - produced; }
                n := 0;
                while n < take {
                    output.ptr[produced] = self.buffer[self.payloadAt];
                    self.payloadAt += 1;
                    produced += 1;
                    n += 1;
                }
                if self.payloadAt < self.buffered { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                if self.blockFinal {
                    self.phase = .done;
                    return Progress{ consumed = consumed, produced = produced, status = .done };
                }
                self.buffered = 0;
                self.payloadAt = 0;
                self.phase = .fill;
                continue;
            }
        }
        raise .InvalidData;
    }

    end :: (self: *StoredDeflater) -> !Error {
        if self.phase != .done { raise .UnexpectedEnd; }
    }
}

private DeflatePhase :: enum { fill; pendingBits; flushFinal; done; }

private DeflateMatch :: struct { length: i64; distance: i64; }

private emitStoredBytesWithOffset :: (data: string, final: bool, bitOffset: i64, alloc: Allocator) -> (string, i64) {
    writer := BitWriter.init(alloc);
    writer.write(if final then 1 else 0, 1);
    writer.write(0, 2);
    padding := (8 - ((bitOffset + 3) & 7)) & 7;
    writer.write(0, padding);
    writer.write(data.len, 16);
    writer.write((~data.len) & 0xffff, 16);
    i := 0;
    while i < data.len { writer.write(data[i], 8); i += 1; }
    validBits := writer.out.bytes.len * 8 + writer.count;
    return writer.finish(), validBits;
}

private emitStoredRingWithOffset :: (dict: string, start: i64, count: i64, final: bool, bitOffset: i64, alloc: Allocator, storage: string = .{ ptr = null, len = 0 }) -> (string, i64) {
    writer := BitWriter.initCapacityStorage(alloc, count + 8, storage);
    writer.write(if final then 1 else 0, 1);
    writer.write(0, 2);
    padding := (8 - ((bitOffset + 3) & 7)) & 7;
    writer.write(0, padding);
    writer.write(count, 16);
    writer.write((~count) & 0xffff, 16);
    if writer.count == 0 and count > 0 and writer.out.ensureCapacity(writer.out.bytes.len + count) {
        // Stored blocks are normally entered on a byte boundary. Copy their
        // ring payload in at most two spans instead of feeding every byte back
        // through the bit writer. Mixed compressed/stored streams can be
        // unaligned here, so they retain the exact bit-wise path below.
        ringAt := start & 32767;
        first := count;
        available := 32768 - ringAt;
        if first > available { first = available; }
        outAt := writer.out.bytes.items.len;
        c.memcpy(*writer.out.bytes.items.ptr[outAt], *dict.ptr[ringAt], first);
        remaining := count - first;
        if remaining > 0 {
            c.memcpy(*writer.out.bytes.items.ptr[outAt + first], dict.ptr, remaining);
        }
        writer.out.bytes.items.len += count;
    } else {
        i := 0;
        while i < count { writer.write(dict[(start + i) & 32767], 8); i += 1; }
    }
    validBits := writer.out.bytes.len * 8 + writer.count;
    return writer.finish(), validBits;
}

// Faithful sx port of miniz's production tdefl parser. The dictionary, hash
// chains, lazy match state, token buffer, and block state survive every input
// and output chunk boundary. Memory remains bounded independently of input.
Deflater :: struct {
    phase: DeflatePhase;
    rawBuffer: string;
    rawBuffered: i64;
    dict: string;
    hash: string;
    next: string;
    lz: TdeflTokenBuffer;
    lookaheadPos: i64;
    lookaheadSize: i64;
    dictSize: i64;
    blockStart: i64;
    savedMatchDist: i64;
    savedMatchLen: i64;
    savedLit: i64;
    pending: string;
    pendingCapacity: i64;
    sparePending: string;
    pendingBits: i64;
    pendingAt: i64;
    carry: i64;
    carryCount: i64;
    finishing: bool;
    fastDraining: bool;
    blockFinal: bool;
    blockMode: i64;
    level: i64;
    maxProbes: i64;
    greedy: bool;
    strategy: Strategy;
    filterMatches: bool;
    rleMatches: bool;
    useFast: bool;
    hashMask: i64;
    hashShift: i64;
    // Never read: retained solely for struct layout. Removing these two
    // slots shifts the hot match-search fields across a cache line and
    // costs measurable encode time at levels 6-9.
    nondeterministic: bool;
    lessMemory: bool;
    flushMode: Flush;
    needsMarker: bool;
    emittingMarker: bool;
    allocationFailed: bool;
    alloc: Allocator;

    init :: (level: i64 = 6, alloc: Allocator = context.allocator) -> Deflater {
        Deflater.initMode(level, 0, alloc)
    }

    initStrategy :: (level: i64, strategy: Strategy, alloc: Allocator = context.allocator) -> Deflater {
        Deflater.initStrategyMode(level, strategy, 0, alloc)
    }

    initPath :: (level: i64, strategy: Strategy, path: DeflatePath, alloc: Allocator = context.allocator) -> Deflater {
        Deflater.initPathMode(level, strategy, path, 0, alloc)
    }

    // blockMode: 0 follows tdefl, 1 forces fixed blocks without stored
    // fallback, 2 forces dynamic blocks without stored fallback, and 3
    // selects fixed blocks while retaining tdefl's adaptive stored fallback.
    // Mode 3 represents the public `.fixed` strategy.
    initMode :: (level: i64, blockMode: i64, alloc: Allocator) -> Deflater {
        Deflater.initStrategyMode(level, .default, blockMode, alloc)
    }

    initStrategyMode :: (level: i64, strategy: Strategy, blockMode: i64, alloc: Allocator) -> Deflater {
        Deflater.initPathMode(level, strategy, .fastest, blockMode, alloc)
    }

    initPathMode :: (level: i64, strategy: Strategy, path: DeflatePath, blockMode: i64, alloc: Allocator) -> Deflater {
        actualLevel := level;
        if actualLevel < 0 { actualLevel = 6; }
        if actualLevel > 10 { actualLevel = 10; }
        if blockMode > 0 and actualLevel == 0 { actualLevel = 1; }
        probes := TDEFL_PROBES[actualLevel];
        if strategy == .huffmanOnly { probes = 0; }
        greedy := level <= 3;
        Deflater.initCustom(actualLevel, probes, greedy, strategy, path, blockMode, false, false, alloc)
    }

    initCustom :: (actualLevel: i64, probes: i64, greedy: bool, strategy: Strategy, path: DeflatePath, blockMode: i64, lessMemory: bool, nondeterministic: bool, alloc: Allocator) -> Deflater {
        actualMode := blockMode;
        if actualMode == 0 and strategy == .fixed and actualLevel > 0 { actualMode = 3; }
        useFast := path == .fastest and probes == 1 and greedy and
            (strategy == .default or strategy == .fixed);
        rawBuffer := string{ ptr = null, len = 0 };
        dictBuffer := string{ ptr = null, len = 0 };
        hashBuffer := string{ ptr = null, len = 0 };
        nextBuffer := string{ ptr = null, len = 0 };
        if actualLevel == 0 {
            // tdefl checks its raw-block heuristic after recording a token,
            // so forced-raw mode flushes at 31 KiB + 1 byte, not at DEFLATE's
            // maximum stored-block length.
            rawLimit := if lessMemory then TDEFL_LESS_MEMORY_RAW_BLOCK_LIMIT else TDEFL_RAW_BLOCK_LIMIT;
            raw := alloc.allocBytes(rawLimit);
            if raw != null { rawBuffer = .{ ptr = raw, len = rawLimit }; }
        }
        else {
            // Match miniz's production layout exactly. The 257-byte mirror
            // makes every <=258-byte lookahead contiguous across the 32 KiB
            // ring boundary, and the hash chains are uint16 tables (zero is
            // the terminator). Besides preserving tdefl's wrap semantics,
            // this halves the hot chain footprint versus i32 tables.
            dict := alloc.allocBytes(32768 + 257);
            hashSize := if lessMemory then 4096 else 32768;
            hash := alloc.allocBytes(hashSize * @sizeOf(u16));
            next := alloc.allocBytes(32768 * @sizeOf(u16));
            if dict != null { dictBuffer = .{ ptr = dict, len = 32768 + 257 }; }
            if hash != null { hashBuffer = .{ ptr = hash, len = hashSize * @sizeOf(u16) }; }
            if next != null { nextBuffer = .{ ptr = next, len = 32768 * @sizeOf(u16) }; }
        }
        tokenBuffer := TdeflTokenBuffer.init(alloc, actualLevel > 0, lessMemory);
        failed := if actualLevel == 0 then rawBuffer.ptr == null else
            dictBuffer.ptr == null or hashBuffer.ptr == null or nextBuffer.ptr == null or tokenBuffer.codes.ptr == null;
        result := Deflater{
            phase = .fill,
            rawBuffer = rawBuffer,
            rawBuffered = 0,
            dict = dictBuffer,
            hash = hashBuffer,
            next = nextBuffer,
            lz = tokenBuffer,
            lookaheadPos = 0,
            lookaheadSize = 0,
            dictSize = 0,
            blockStart = 0,
            savedMatchDist = 0,
            savedMatchLen = 0,
            savedLit = 0,
            pending = .{ ptr = null, len = 0 },
            pendingCapacity = 0,
            sparePending = .{ ptr = null, len = 0 },
            pendingBits = 0,
            pendingAt = 0,
            carry = 0,
            carryCount = 0,
            finishing = false,
            fastDraining = false,
            blockFinal = false,
            blockMode = actualMode,
            level = actualLevel,
            maxProbes = probes,
            greedy = greedy,
            strategy = strategy,
            filterMatches = strategy == .filtered,
            rleMatches = strategy == .rle,
            useFast = useFast,
            hashMask = if lessMemory then 4095 else 32767,
            hashShift = if lessMemory then 4 else 5,
            nondeterministic = nondeterministic,
            lessMemory = lessMemory,
            flushMode = .none,
            needsMarker = false,
            emittingMarker = false,
            allocationFailed = failed,
            alloc = alloc,
        };
        if actualLevel > 0 and !nondeterministic and !failed {
            heads : [*]u16 = result.hash.ptr.([*]u16);
            links : [*]u16 = result.next.ptr.([*]u16);
            // tdefl's tables are uint16_t arrays cleared to zero. Code zero
            // is the chain terminator even when an absolute position wraps to
            // zero; preserving that quirk is required for byte identity.
            c.memset(heads, 0, result.hash.len);
            c.memset(links, 0, 32768 * @sizeOf(u16));
            c.memset(result.dict.ptr, 0, result.dict.len);
        }
        result
    }

    releasePending :: (self: *Deflater) {
        if self.pending.ptr != null { self.alloc.deallocBytes(self.pending.ptr); }
        if self.sparePending.ptr != null { self.alloc.deallocBytes(self.sparePending.ptr); }
        self.pending.ptr = null;
        self.pending.len = 0;
        self.pendingCapacity = 0;
        self.sparePending.ptr = null;
        self.sparePending.len = 0;
        self.pendingBits = 0;
        self.pendingAt = 0;
    }

    recyclePending :: (self: *Deflater) {
        if self.pending.ptr != null {
            if self.pendingCapacity == TDEFL_OUTPUT_BUFFER_CAPACITY {
                if self.sparePending.ptr != null { self.alloc.deallocBytes(self.sparePending.ptr); }
                self.sparePending = .{ ptr = self.pending.ptr, len = self.pendingCapacity };
            } else {
                self.alloc.deallocBytes(self.pending.ptr);
            }
        }
        self.pending.ptr = null;
        self.pending.len = 0;
        self.pendingCapacity = 0;
        self.pendingBits = 0;
        self.pendingAt = 0;
    }

    takePendingStorage :: (self: *Deflater) -> string {
        storage := self.sparePending;
        self.sparePending = .{ ptr = null, len = 0 };
        storage
    }

    reset :: (self: *Deflater, level: i64 = 6) {
        alloc := self.alloc;
        self.deinit();
        self.* = Deflater.init(level, alloc);
    }

    deinit :: (self: *Deflater) {
        self.releasePending();
        self.lz.deinit(self.alloc);
        if self.rawBuffer.ptr != null { self.alloc.deallocBytes(self.rawBuffer.ptr); }
        if self.dict.ptr != null { self.alloc.deallocBytes(self.dict.ptr); }
        if self.hash.ptr != null { self.alloc.deallocBytes(self.hash.ptr); }
        if self.next.ptr != null { self.alloc.deallocBytes(self.next.ptr); }
        self.rawBuffer.ptr = null; self.rawBuffer.len = 0;
        self.dict.ptr = null; self.dict.len = 0;
        self.hash.ptr = null; self.hash.len = 0;
        self.next.ptr = null; self.next.len = 0;
        self.phase = .done;
    }

    dictByte :: (self: *Deflater, absolute: i64) -> i64 { self.dict[absolute & 32767].(i64) }

    normalHashAt :: (self: *Deflater, absolute: i64) -> i64 {
        ((self.dictByte(absolute) << (self.hashShift * 2)) ^
         (self.dictByte(absolute + 1) << self.hashShift) ^
         self.dictByte(absolute + 2)) & self.hashMask
    }

    fastHashAt :: (self: *Deflater, absolute: i64) -> i64 {
        trigram := self.dictByte(absolute) | (self.dictByte(absolute + 1) << 8) | (self.dictByte(absolute + 2) << 16);
        (trigram ^ (trigram >> 17)) & 4095
    }

    fillNormal :: (self: *Deflater, input: string, consumed: *i64, target: i64) {
        take := target - self.lookaheadSize;
        if take > input.len - consumed.* { take = input.len - consumed.*; }
        if take <= 0 { return; }

        dict := self.dict.ptr;
        heads : [*]u16 = self.hash.ptr.([*]u16);
        links : [*]u16 = self.next.ptr.([*]u16);
        lookahead := self.lookaheadSize;
        absolute := self.lookaheadPos + lookahead;
        history := lookahead + self.dictSize;
        rolling := 0;
        rollingReady := false;
        if history >= 2 {
            insPos := (absolute - 2) & 32767;
            rolling = (dict[insPos].(i64) << self.hashShift) ^ dict[insPos + 1].(i64);
            rollingReady = true;
        }
        at := 0;
        while at < take {
            pos := absolute & 32767;
            value := input.ptr[consumed.* + at];
            dict[pos] = value;
            if pos < 257 { dict[32768 + pos] = value; }
            lookahead += 1;
            history += 1;
            if rollingReady {
                rolling = ((rolling << self.hashShift) ^ value.(i64)) & self.hashMask;
                inserted := absolute - 2;
                insPos := inserted & 32767;
                links[insPos] = heads[rolling];
                heads[rolling] = (inserted & 65535).(u16);
            } else if history == 2 {
                previous := (absolute - 1) & 32767;
                rolling = (dict[previous].(i64) << self.hashShift) ^ value.(i64);
                rollingReady = true;
            }
            absolute += 1;
            at += 1;
        }
        self.lookaheadSize = lookahead;
        consumed.* += take;
    }

    // tdefl's level-1 parser fills a 4 KiB lookahead without constructing the
    // normal 32 KiB hash chains. It retains only one 12-bit hash head per
    // trigram, which is the key to the upstream level-1 throughput profile.
    fillFast :: (self: *Deflater, input: string, consumed: *i64) {
        take := 4096 - self.lookaheadSize;
        if take > input.len - consumed.* { take = input.len - consumed.*; }
        if take <= 0 { return; }
        dict := self.dict.ptr;
        dst := (self.lookaheadPos + self.lookaheadSize) & 32767;
        copied := 0;
        while copied < take {
            span := 32768 - dst;
            if span > take - copied { span = take - copied; }
            c.memcpy(*dict[dst], *input.ptr[consumed.* + copied], span);
            if dst < 257 {
                mirror := 257 - dst;
                if mirror > span { mirror = span; }
                c.memcpy(*dict[32768 + dst], *input.ptr[consumed.* + copied], mirror);
            }
            copied += span;
            dst = (dst + span) & 32767;
        }
        self.lookaheadSize += take;
        consumed.* += take;
    }

    findNormalMatch :: (self: *Deflater, initialLength: i64) -> DeflateMatch {
        result := DeflateMatch{ length = initialLength, distance = 0 };
        lookaheadSize := self.lookaheadSize.(u32);
        initial := initialLength.(u32);
        if lookaheadSize <= initial { return result; }
        links : [*]u16 = self.next.ptr.([*]u16);
        dict := self.dict.ptr;
        lookaheadPos := self.lookaheadPos.(u32);
        dictSize := self.dictSize.(u32);
        pos := lookaheadPos & 32767;
        probePos := pos;
        sourceWords : [*]u16 = (*dict[pos]).([*]u16);
        sourceFirst := sourceWords[0];
        tailAt := pos + initial - 1;
        tailWords : [*]u16 = (*dict[tailAt]).([*]u16);
        tail := tailWords[0];
        configured := self.maxProbes.(u32);
        // tdefl probes up to three chain entries for the two-byte tail
        // precheck, but a candidate that passes that precheck ends the group
        // even if its full match is not better. Preserve that subtle budget
        // behavior: flattening this into N independent probes compresses
        // better than miniz at low levels, but is not the same parser.
        groups := if initial >= 32 then ((configured >> 2) + 2) / 3 else (configured + 2) / 3;
        while groups > 0 {
            groups -= 1;
            found := false;
            distance : u32 = 0;
            tries : u32 = 0;
            while tries < 3 {
                nextProbe := links[probePos].(u32);
                if nextProbe == 0 { return result; }
                distance = (lookaheadPos - nextProbe) & 65535;
                if distance > dictSize { return result; }
                probePos = nextProbe & 32767;
                candidateTail : [*]u16 = (*dict[probePos + result.length.(u32) - 1]).([*]u16);
                if candidateTail[0] == tail {
                    found = true;
                    break;
                }
                tries += 1;
            }
            if found {
                if distance == 0 { return result; }
                candidateWords : [*]u16 = (*dict[probePos]).([*]u16);
                if candidateWords[0] != sourceFirst { continue; }
                // Compare a full group on the hot equal path, then recover
                // tdefl's exact 16-bit mismatch boundary inside that group.
                sourceGroups : [*]u64 = (*sourceWords[1]).([*]u64);
                candidateGroups : [*]u64 = (*candidateWords[1]).([*]u64);
                pair : u32 = 0;
                group : u32 = 0;
                compareGroups : u32 = 32;
                mismatch := false;
                while compareGroups > 0 {
                    if sourceGroups[group] != candidateGroups[group] {
                        pair = group * 4 + 1;
                        if sourceWords[pair] == candidateWords[pair] {
                            pair += 1;
                            if sourceWords[pair] == candidateWords[pair] {
                                pair += 1;
                                if sourceWords[pair] == candidateWords[pair] { pair += 1; }
                            }
                        }
                        mismatch = true;
                        break;
                    }
                    group += 1;
                    compareGroups -= 1;
                }
                length : u32 = 258;
                if mismatch {
                    length = pair * 2;
                    if dict[pos + length] == dict[probePos + length] { length += 1; }
                }
                if length > lookaheadSize { length = lookaheadSize; }
                if length > result.length.(u32) {
                    result.length = length.(i64);
                    result.distance = distance.(i64);
                    if length == lookaheadSize { break; }
                    tailAt = pos + length - 1;
                    tailWords = (*dict[tailAt]).([*]u16);
                    tail = tailWords[0];
                }
            }
        }
        result
    }

    advance :: (self: *Deflater, count: i64) {
        self.lookaheadPos += count;
        self.lookaheadSize -= count;
        self.dictSize += count;
        if self.dictSize > 32768 { self.dictSize = 32768; }
    }

    processFast :: (self: *Deflater) {
        heads : [*]u16 = self.hash.ptr.([*]u16);
        dict := self.dict.ptr;
        codes := self.lz.codes.ptr;
        lookaheadPos := self.lookaheadPos;
        lookaheadSize := self.lookaheadSize;
        dictSize := self.dictSize;
        codeLen := self.lz.codeLen;
        flagsAt := self.lz.flagsAt;
        flagsLeft := self.lz.flagsLeft;
        sourceBytes := self.lz.sourceBytes;

        codeLimit := self.lz.codes.len - 8;
        while lookaheadSize >= 4 and codeLen <= codeLimit {
            pos := lookaheadPos & 32767;
            firstAt : [*]u32 = (*dict[pos]).([*]u32);
            first := firstAt[0].(i64) & 0xffffff;
            h := (first ^ (first >> 17)) & 4095;
            probe := heads[h].(i64);
            heads[h] = (lookaheadPos & 65535).(u16);
            distance := ((lookaheadPos & 65535) - probe) & 65535;
            length := 1;
            probePos := probe & 32767;
            candidateAt : [*]u32 = (*dict[probePos]).([*]u32);
            if distance <= dictSize and (candidateAt[0].(i64) & 0xffffff) == first {
                sourceWords : [*]u16 = (*dict[pos]).([*]u16);
                candidateWords : [*]u16 = (*dict[probePos]).([*]u16);
                // Compare a full group on the hot equal path, then recover
                // tdefl's exact 16-bit mismatch boundary inside that group.
                sourceGroups : [*]u64 = (*sourceWords[1]).([*]u64);
                candidateGroups : [*]u64 = (*candidateWords[1]).([*]u64);
                pair := 0;
                group := 0;
                groups := 32;
                mismatch := false;
                while groups > 0 {
                    if sourceGroups[group] != candidateGroups[group] {
                        pair = group * 4 + 1;
                        if sourceWords[pair] == candidateWords[pair] {
                            pair += 1;
                            if sourceWords[pair] == candidateWords[pair] {
                                pair += 1;
                                if sourceWords[pair] == candidateWords[pair] { pair += 1; }
                            }
                        }
                        mismatch = true;
                        break;
                    }
                    group += 1;
                    groups -= 1;
                }
                if !mismatch { length = if distance != 0 then 258 else 0; }
                else {
                    length = pair * 2;
                    if dict[pos + length] == dict[probePos + length] { length += 1; }
                }
                if length > lookaheadSize { length = lookaheadSize; }
                if length < 3 or (length == 3 and distance >= 8192) { length = 1; }
            }

            if length > 1 {
                li := tdeflLengthIndex(length);
                di := tdeflDistanceIndex(distance);
                packedDistance := distance - 1;
                codes[codeLen] = (length - 3).(u8);
                codes[codeLen + 1] = packedDistance.(u8);
                codes[codeLen + 2] = (packedDistance >> 8).(u8);
                codeLen += 3;
                codes[flagsAt] = ((codes[flagsAt].(i64) >> 1) | 0x80).(u8);
                self.lz.litFreq[257 + li] += 1;
                self.lz.distFreq[di] += 1;
            } else {
                literal := first & 0xff;
                codes[codeLen] = literal.(u8);
                codeLen += 1;
                codes[flagsAt] = (codes[flagsAt].(i64) >> 1).(u8);
                self.lz.litFreq[literal] += 1;
            }
            flagsLeft -= 1;
            if flagsLeft == 0 {
                flagsLeft = 8;
                flagsAt = codeLen;
                codes[codeLen] = 0;
                codeLen += 1;
            }
            sourceBytes += length;
            lookaheadPos += length;
            lookaheadSize -= length;
            dictSize += length;
            if dictSize > 32768 { dictSize = 32768; }
        }

        while lookaheadSize > 0 and codeLen <= codeLimit {
            literal := dict[lookaheadPos & 32767].(i64);
            codes[codeLen] = literal.(u8);
            codeLen += 1;
            codes[flagsAt] = (codes[flagsAt].(i64) >> 1).(u8);
            self.lz.litFreq[literal] += 1;
            flagsLeft -= 1;
            if flagsLeft == 0 {
                flagsLeft = 8;
                flagsAt = codeLen;
                codes[codeLen] = 0;
                codeLen += 1;
            }
            sourceBytes += 1;
            lookaheadPos += 1;
            lookaheadSize -= 1;
            dictSize += 1;
            if dictSize > 32768 { dictSize = 32768; }
        }

        self.lookaheadPos = lookaheadPos;
        self.lookaheadSize = lookaheadSize;
        self.dictSize = dictSize;
        self.lz.codeLen = codeLen;
        self.lz.flagsAt = flagsAt;
        self.lz.flagsLeft = flagsLeft;
        self.lz.sourceBytes = sourceBytes;
    }

    processNormal :: (self: *Deflater) {
        initial := if self.savedMatchLen > 0 then self.savedMatchLen else 2;
        current := DeflateMatch{ length = 0, distance = 0 };
        if self.rleMatches {
            if self.dictSize > 0 {
                pos := self.lookaheadPos & 32767;
                value := self.dict[(pos - 1) & 32767];
                length := 0;
                while length < self.lookaheadSize and self.dict[pos + length] == value { length += 1; }
                if length >= 3 { current.length = length; current.distance = 1; }
            }
        } else {
            current = self.findNormalMatch(initial);
        }
        if (current.length == 3 and current.distance >= 8192) or
           ((self.lookaheadPos & 32767) == current.distance) or
           (self.filterMatches and current.length <= 5) {
            current.length = 0;
            current.distance = 0;
        }
        move := 1;
        if self.savedMatchLen > 0 {
            if current.length > self.savedMatchLen {
                self.lz.literal(self.savedLit, self.alloc);
                if current.length >= 128 {
                    self.lz.match(current.length, current.distance, self.alloc);
                    self.savedMatchLen = 0;
                    move = current.length;
                } else {
                    self.savedLit = self.dictByte(self.lookaheadPos);
                    self.savedMatchDist = current.distance;
                    self.savedMatchLen = current.length;
                }
            } else {
                self.lz.match(self.savedMatchLen, self.savedMatchDist, self.alloc);
                move = self.savedMatchLen - 1;
                self.savedMatchLen = 0;
            }
        } else if current.distance == 0 {
            self.lz.literal(self.dictByte(self.lookaheadPos), self.alloc);
        } else if self.greedy or self.rleMatches or current.length >= 128 {
            self.lz.match(current.length, current.distance, self.alloc);
            move = current.length;
        } else {
            self.savedLit = self.dictByte(self.lookaheadPos);
            self.savedMatchDist = current.distance;
            self.savedMatchLen = current.length;
        }
        self.advance(move);
    }

    shouldFlush :: (self: *Deflater) -> bool {
        codeLimit := self.lz.codes.len - 8;
        if self.useFast { return self.lz.codeLen > codeLimit; }
        self.lz.codeLen > codeLimit or
        (self.lz.sourceBytes > 31 * 1024 and (((self.lz.codeLen * 115) >> 7) >= self.lz.sourceBytes))
    }

    beginRawBlock :: (self: *Deflater, final: bool) {
        view := string{ ptr = self.rawBuffer.ptr, len = self.rawBuffered };
        packed, validBits := emitStoredBytesWithOffset(view, final, self.carryCount, self.alloc);
        if packed.ptr == null { self.allocationFailed = true; self.phase = .done; return; }
        self.pending = packed;
        self.pendingCapacity = 0;
        self.pendingBits = validBits;
        self.pendingAt = 0;
        self.rawBuffered = 0;
        self.blockFinal = final;
        self.phase = .pendingBits;
    }

    beginSyncMarker :: (self: *Deflater) {
        packed, validBits := emitStoredBytesWithOffset("", false, self.carryCount, self.alloc);
        if packed.ptr == null { self.allocationFailed = true; self.phase = .done; return; }
        self.pending = packed;
        self.pendingCapacity = 0;
        self.pendingBits = validBits;
        self.pendingAt = 0;
        self.blockFinal = false;
        self.emittingMarker = true;
        self.phase = .pendingBits;
    }

    clearHistory :: (self: *Deflater) {
        if self.hash.ptr != null { c.memset(self.hash.ptr, 0, self.hash.len); }
        if self.next.ptr != null { c.memset(self.next.ptr, 0, self.next.len); }
        self.dictSize = 0;
        self.savedMatchDist = 0;
        self.savedMatchLen = 0;
        self.savedLit = 0;
        self.fastDraining = false;
    }

    beginCompressedBlock :: (self: *Deflater, final: bool) {
        self.lz.finishFlags();
        storage := self.takePendingStorage();
        packed : string = ---;
        validBits := 0;
        if self.blockMode == 1 or self.blockMode == 3 or
           (self.blockMode == 0 and self.lz.sourceBytes < 48) {
            fixed, fixedBits := emitTdeflFixed(*self.lz, final, self.alloc, storage);
            packed = fixed;
            validBits = fixedBits;
        } else {
            dynamic, dynamicBits := emitTdeflDynamic(*self.lz, final, self.alloc, storage);
            packed = dynamic;
            validBits = dynamicBits;
        }
        if packed.ptr == null {
            // A supplied reusable buffer is owned by the failed writer and is
            // released by ByteWriter.take(); a fresh allocation follows the
            // same path.
            self.allocationFailed = true;
            self.phase = .done;
            return;
        }

        rawAvailable := self.lz.sourceBytes <= self.dictSize and self.lz.sourceBytes <= 32768;
        compressedBytes := (validBits + 7) / 8;
        if (self.blockMode == 0 or self.blockMode == 3) and
           self.lz.sourceBytes > 0 and rawAvailable and compressedBytes >= self.lz.sourceBytes {
            // The stored fallback is at most 32 KiB. Write it into the same
            // retained block buffer instead of freeing and allocating again.
            reusable := string{ ptr = packed.ptr, len = TDEFL_OUTPUT_BUFFER_CAPACITY };
            stored, storedBits := emitStoredRingWithOffset(self.dict, self.blockStart, self.lz.sourceBytes, final, self.carryCount, self.alloc, reusable);
            if stored.ptr == null { self.allocationFailed = true; self.phase = .done; return; }
            packed = stored;
            validBits = storedBits;
        }
        self.blockStart += self.lz.sourceBytes;
        self.lz.clear();
        self.pending = packed;
        self.pendingCapacity = TDEFL_OUTPUT_BUFFER_CAPACITY;
        self.pendingBits = validBits;
        self.pendingAt = 0;
        self.blockFinal = final;
        self.phase = .pendingBits;
    }

    stepUnchecked :: (self: *Deflater, input: string, output: string, finish: bool = false) -> Progress {
        if self.allocationFailed { return Progress{ consumed = 0, produced = 0, status = .done }; }
        self.stepFlushUnchecked(input, output, if finish then .finish else .none)
    }

    stepFlushUnchecked :: (self: *Deflater, input: string, output: string, mode: Flush = .none) -> Progress {
        if self.allocationFailed { return Progress{ consumed = 0, produced = 0, status = .done }; }
        if mode == .finish { self.finishing = true; }
        else if mode == .sync or mode == .full {
            if self.flushMode == .none { self.flushMode = mode; }
        }
        if self.phase == .done {
            return Progress{ consumed = 0, produced = 0, status = .done };
        }
        consumed := 0;
        produced := 0;
        while true {
            if self.allocationFailed {
                return Progress{ consumed = consumed, produced = produced, status = .done };
            }
            if self.phase == .fill {
                if self.level == 0 {
                    take := self.rawBuffer.len - self.rawBuffered;
                    if take > input.len - consumed { take = input.len - consumed; }
                    n := 0;
                    while n < take {
                        self.rawBuffer[self.rawBuffered] = input[consumed];
                        self.rawBuffered += 1;
                        consumed += 1;
                        n += 1;
                    }
                    if self.rawBuffered == self.rawBuffer.len {
                        self.beginRawBlock(self.finishing and consumed == input.len);
                        continue;
                    }
                    if self.finishing and consumed == input.len { self.beginRawBlock(true); continue; }
                    if self.flushMode != .none and consumed == input.len {
                        self.needsMarker = true;
                        self.beginRawBlock(false);
                        continue;
                    }
                    return Progress{ consumed = consumed, produced = produced, status = .needInput };
                }

                if !self.useFast {
                    // tdefl_compress_normal keeps parsing locally until an
                    // actual input/block boundary. Do the same so the hot
                    // token loop does not re-enter the complete streaming
                    // phase dispatcher for every literal or match.
                    while true {
                        self.fillNormal(input, *consumed, 258);
                        maxHistory := 32768 - self.lookaheadSize;
                        if self.dictSize > maxHistory { self.dictSize = maxHistory; }
                        if self.lookaheadSize < 258 and
                           !(self.finishing and consumed == input.len) and
                           !(self.flushMode != .none and consumed == input.len) {
                            return Progress{ consumed = consumed, produced = produced, status = .needInput };
                        }
                        if self.lookaheadSize > 0 {
                            self.processNormal();
                            if self.shouldFlush() {
                                self.beginCompressedBlock(false);
                                break;
                            }
                            continue;
                        }
                        if self.finishing and consumed == input.len {
                            self.beginCompressedBlock(true);
                            break;
                        }
                        if self.flushMode != .none and consumed == input.len {
                            self.needsMarker = true;
                            self.beginCompressedBlock(false);
                            break;
                        }
                        return Progress{ consumed = consumed, produced = produced, status = .needInput };
                    }
                    continue;
                }

                if !self.fastDraining {
                    self.fillFast(input, *consumed);
                    maxHistory := 32768 - self.lookaheadSize;
                    if self.dictSize > maxHistory { self.dictSize = maxHistory; }
                    if self.lookaheadSize < 4096 and
                       !(self.finishing and consumed == input.len) and
                       !(self.flushMode != .none and consumed == input.len) {
                        return Progress{ consumed = consumed, produced = produced, status = .needInput };
                    }
                    self.fastDraining = true;
                }
                if self.lookaheadSize > 0 {
                    self.processFast();
                    if self.shouldFlush() { self.beginCompressedBlock(false); }
                    continue;
                }
                self.fastDraining = false;
                // Match tdefl_compress_fast's local source loop: another
                // complete 4 KiB fill is not a streaming boundary while this
                // call still owns unread input.
                if consumed < input.len { continue; }
                if self.finishing and consumed == input.len { self.beginCompressedBlock(true); continue; }
                if self.flushMode != .none and consumed == input.len {
                    self.needsMarker = true;
                    self.beginCompressedBlock(false);
                    continue;
                }
                return Progress{ consumed = consumed, produced = produced, status = .needInput };
            }

            if self.phase == .pendingBits {
                while self.pendingAt < self.pendingBits {
                    if self.carryCount == 8 {
                        if produced >= output.len { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                        output.ptr[produced] = self.carry.(u8);
                        produced += 1;
                        self.carry = 0;
                        self.carryCount = 0;
                    }
                    // Completed stored blocks and any byte-aligned compressed
                    // block prefix are already in final wire order. Match
                    // miniz's output callback and move the whole available run
                    // with memcpy instead of redispatching one byte at a time.
                    if self.carryCount == 0 and (self.pendingAt & 7) == 0 and self.pendingBits - self.pendingAt >= 8 {
                        sourceBytes := (self.pendingBits - self.pendingAt) / 8;
                        available := output.len - produced;
                        take := if sourceBytes < available then sourceBytes else available;
                        if take <= 0 { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                        c.memcpy(*output.ptr[produced], *self.pending.ptr[self.pendingAt / 8], take);
                        produced += take;
                        self.pendingAt += take * 8;
                        continue;
                    }
                    // Repack aligned source bytes in one operation. When a
                    // previous block ended mid-byte, its carry bits occupy the
                    // low side and the source byte completes the output byte.
                    if (self.pendingAt & 7) == 0 and self.pendingBits - self.pendingAt >= 8 {
                        if produced >= output.len { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                        sourceByte := self.pending[self.pendingAt / 8].(i64);
                        combined := self.carry | (sourceByte << self.carryCount);
                        output.ptr[produced] = (combined & 0xff).(u8);
                        produced += 1;
                        if self.carryCount > 0 { self.carry = sourceByte >> (8 - self.carryCount); }
                        else { self.carry = 0; }
                        self.pendingAt += 8;
                        continue;
                    }
                    byteAt := self.pendingAt / 8;
                    bitAt := self.pendingAt & 7;
                    bit := (self.pending[byteAt].(i64) >> bitAt) & 1;
                    self.carry = self.carry | (bit << self.carryCount);
                    self.carryCount += 1;
                    self.pendingAt += 1;
                }
                if self.carryCount == 8 {
                    if produced >= output.len { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                    output.ptr[produced] = self.carry.(u8);
                    produced += 1;
                    self.carry = 0;
                    self.carryCount = 0;
                }
                wasMarker := self.emittingMarker;
                self.recyclePending();
                if self.blockFinal { self.phase = .flushFinal; }
                else if wasMarker {
                    self.emittingMarker = false;
                    completedMode := self.flushMode;
                    self.flushMode = .none;
                    if completedMode == .full { self.clearHistory(); }
                    self.phase = .fill;
                    return Progress{ consumed = consumed, produced = produced, status = .needInput };
                } else if self.needsMarker {
                    self.needsMarker = false;
                    self.beginSyncMarker();
                } else { self.phase = .fill; }
                continue;
            }

            if self.phase == .flushFinal {
                if self.carryCount > 0 {
                    if produced >= output.len { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                    output.ptr[produced] = self.carry.(u8);
                    produced += 1;
                    self.carry = 0;
                    self.carryCount = 0;
                }
                self.phase = .done;
                return Progress{ consumed = consumed, produced = produced, status = .done };
            }
        }
        Progress{ consumed = consumed, produced = produced, status = .done }
    }

    step :: (self: *Deflater, input: string, output: string, finish: bool = false) -> (Progress, !Error) {
        if self.allocationFailed { raise .AllocationFailed; }
        if input.len > 0 and (self.phase == .done or (self.blockFinal and (self.phase == .pendingBits or self.phase == .flushFinal))) {
            raise .Finished;
        }
        progress := self.stepUnchecked(input, output, finish);
        if self.allocationFailed { raise .AllocationFailed; }
        progress
    }

    stepFlush :: (self: *Deflater, input: string, output: string, mode: Flush) -> (Progress, !Error) {
        if self.allocationFailed { raise .AllocationFailed; }
        if input.len > 0 and (self.phase == .done or (self.blockFinal and (self.phase == .pendingBits or self.phase == .flushFinal))) {
            raise .Finished;
        }
        progress := self.stepFlushUnchecked(input, output, mode);
        if self.allocationFailed { raise .AllocationFailed; }
        progress
    }

    end :: (self: *Deflater) -> !Error {
        if self.phase != .done { raise .UnexpectedEnd; }
    }
}

private ZlibDeflatePhase :: enum { header; body; trailer; done; }

ZlibDeflater :: struct {
    raw: Deflater;
    phase: ZlibDeflatePhase;
    header: [2]u8;
    headerAt: i64;
    trailer: [4]u8;
    trailerAt: i64;
    checksum: i64;
    level: i64;
    strategy: Strategy;
    alloc: Allocator;

    init :: (level: i64 = 6, alloc: Allocator = context.allocator) -> ZlibDeflater {
        ZlibDeflater.initStrategy(level, .default, alloc)
    }

    initStrategy :: (level: i64, strategy: Strategy, alloc: Allocator = context.allocator) -> ZlibDeflater {
        ZlibDeflater.initPath(level, strategy, .fastest, alloc)
    }

    initPath :: (level: i64, strategy: Strategy, path: DeflatePath, alloc: Allocator = context.allocator) -> ZlibDeflater {
        actual := level;
        if actual < 0 { actual = 6; }
        if actual > 10 { actual = 10; }
        probes := TDEFL_PROBES[actual];
        if strategy == .huffmanOnly { probes = 0; }
        probeLevel := 11;
        i := 0;
        while i < TDEFL_PROBES.len {
            if TDEFL_PROBES[i] == probes { probeLevel = i; break; }
            i += 1;
        }
        flevel := 3;
        if probeLevel < 2 { flevel = 0; }
        else if probeLevel < 6 { flevel = 1; }
        else if probeLevel == 6 { flevel = 2; }
        cmf := 0x78;
        flg := flevel << 6;
        flg += (31 - ((cmf * 256 + flg) % 31)) % 31;
        state := ZlibDeflater{
            raw = Deflater.initPath(level, strategy, path, alloc),
            phase = .header,
            header = ---,
            headerAt = 0,
            trailer = ---,
            trailerAt = 0,
            checksum = 1,
            level = actual,
            strategy = strategy,
            alloc = alloc,
        };
        state.header[0] = cmf.(u8);
        state.header[1] = flg.(u8);
        state
    }

    reset :: (self: *ZlibDeflater, level: i64 = 6) {
        alloc := self.alloc;
        self.raw.deinit();
        self.* = ZlibDeflater.init(level, alloc);
    }

    deinit :: (self: *ZlibDeflater) { self.raw.deinit(); self.phase = .done; }

    stepUnchecked :: (self: *ZlibDeflater, input: string, output: string, finish: bool = false) -> Progress {
        self.stepFlushUnchecked(input, output, if finish then .finish else .none)
    }

    stepFlushUnchecked :: (self: *ZlibDeflater, input: string, output: string, mode: Flush = .none) -> Progress {
        consumed := 0;
        produced := 0;
        while true {
            if self.phase == .done { return Progress{ consumed = consumed, produced = produced, status = .done }; }
            if self.phase == .header {
                while self.headerAt < 2 and produced < output.len {
                    output.ptr[produced] = self.header[self.headerAt];
                    self.headerAt += 1;
                    produced += 1;
                }
                if self.headerAt < 2 { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                self.phase = .body;
                continue;
            }
            if self.phase == .body {
                bodyInput : string = .{ ptr = null, len = 0 };
                if consumed < input.len { bodyInput = input[consumed..]; }
                bodyOutput : string = .{ ptr = null, len = 0 };
                if produced < output.len { bodyOutput = output[produced..]; }
                progress := self.raw.stepFlushUnchecked(bodyInput, bodyOutput, mode);
                if progress.consumed > 0 {
                    self.checksum = adler32(input[consumed..consumed + progress.consumed], self.checksum);
                    consumed += progress.consumed;
                }
                produced += progress.produced;
                if progress.status == .done {
                    self.trailer[0] = ((self.checksum >> 24) & 0xff).(u8);
                    self.trailer[1] = ((self.checksum >> 16) & 0xff).(u8);
                    self.trailer[2] = ((self.checksum >> 8) & 0xff).(u8);
                    self.trailer[3] = (self.checksum & 0xff).(u8);
                    self.phase = .trailer;
                    continue;
                }
                return Progress{ consumed = consumed, produced = produced, status = progress.status };
            }
            if self.phase == .trailer {
                while self.trailerAt < 4 and produced < output.len {
                    output.ptr[produced] = self.trailer[self.trailerAt];
                    self.trailerAt += 1;
                    produced += 1;
                }
                if self.trailerAt < 4 { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                self.phase = .done;
                continue;
            }
        }
        Progress{ consumed = consumed, produced = produced, status = .done }
    }

    step :: (self: *ZlibDeflater, input: string, output: string, finish: bool = false) -> (Progress, !Error) {
        if self.raw.allocationFailed { raise .AllocationFailed; }
        if input.len > 0 and (self.phase == .done or self.phase == .trailer or (self.phase == .body and self.raw.blockFinal and (self.raw.phase == .pendingBits or self.raw.phase == .flushFinal))) { raise .Finished; }
        progress := self.stepUnchecked(input, output, finish);
        if self.raw.allocationFailed { raise .AllocationFailed; }
        progress
    }

    stepFlush :: (self: *ZlibDeflater, input: string, output: string, mode: Flush) -> (Progress, !Error) {
        if self.raw.allocationFailed { raise .AllocationFailed; }
        if input.len > 0 and (self.phase == .done or self.phase == .trailer or (self.phase == .body and self.raw.blockFinal and (self.raw.phase == .pendingBits or self.raw.phase == .flushFinal))) { raise .Finished; }
        progress := self.stepFlushUnchecked(input, output, mode);
        if self.raw.allocationFailed { raise .AllocationFailed; }
        progress
    }

    end :: (self: *ZlibDeflater) -> !Error { if self.phase != .done { raise .UnexpectedEnd; } }
}

GzipOptions :: struct {
    mtime: i64 = 0;
    filename: string = "";
    comment: string = "";
    extra: string = "";
    os: u8 = 255;
    text: bool = false;
    headerCrc: bool = false;
}

private containsZero :: (data: string) -> bool {
    i := 0;
    while i < data.len {
        if data[i] == 0 { return true; }
        i += 1;
    }
    false
}

private validateGzipOptions :: (options: GzipOptions) -> !Error {
    if options.mtime < 0 or options.mtime > 0xffffffff { raise .InvalidData; }
    if options.extra.len > 65535 { raise .TooLarge; }
    if containsZero(options.filename) or containsZero(options.comment) { raise .InvalidData; }
}

gzipHeaderOverhead :: (options: GzipOptions) -> (i64, !Error) {
    try validateGzipOptions(options);
    overhead : i64 = 18;
    if options.extra.len > 0 {
        if options.extra.len > i64.max - overhead - 2 { raise .TooLarge; }
        overhead += 2 + options.extra.len;
    }
    if options.filename.len > 0 {
        if options.filename.len > i64.max - overhead - 1 { raise .TooLarge; }
        overhead += options.filename.len + 1;
    }
    if options.comment.len > 0 {
        if options.comment.len > i64.max - overhead - 1 { raise .TooLarge; }
        overhead += options.comment.len + 1;
    }
    if options.headerCrc {
        if overhead > i64.max - 2 { raise .TooLarge; }
        overhead += 2;
    }
    overhead
}

private GzipDeflatePhase :: enum { header; body; trailer; done; }

// Deterministic streaming gzip encoder (MTIME=0, OS=unknown, no optional
// fields). Metadata-bearing one-shot output remains available separately.
GzipDeflater :: struct {
    raw: Deflater;
    phase: GzipDeflatePhase;
    header: [10]u8;
    headerAt: i64;
    headerTail: string;
    headerTailAt: i64;
    trailer: [8]u8;
    trailerAt: i64;
    checksum: i64;
    inputSize: i64;
    level: i64;
    alloc: Allocator;

    init :: (level: i64 = 6, alloc: Allocator = context.allocator) -> GzipDeflater {
        GzipDeflater.initStrategy(level, .default, alloc)
    }

    initStrategy :: (level: i64, strategy: Strategy, alloc: Allocator = context.allocator) -> GzipDeflater {
        actual := level;
        if actual < 0 { actual = 0; }
        if actual > 10 { actual = 10; }
        state := GzipDeflater{
            raw = Deflater.initStrategy(actual, strategy, alloc),
            phase = .header,
            header = ---,
            headerAt = 0,
            headerTail = .{ ptr = null, len = 0 },
            headerTailAt = 0,
            trailer = ---,
            trailerAt = 0,
            checksum = 0,
            inputSize = 0,
            level = actual,
            alloc = alloc,
        };
        state.header[0] = 0x1f; state.header[1] = 0x8b; state.header[2] = 8; state.header[3] = 0;
        state.header[4] = 0; state.header[5] = 0; state.header[6] = 0; state.header[7] = 0;
        state.header[8] = if actual >= 8 then 2 else if actual <= 2 then 4 else 0;
        state.header[9] = 255;
        state
    }

    initOptions :: (level: i64, strategy: Strategy, options: GzipOptions, alloc: Allocator = context.allocator) -> (GzipDeflater, !Error) {
        try validateGzipOptions(options);
        state := GzipDeflater.initStrategy(level, strategy, alloc);
        if state.raw.allocationFailed { state.deinit(); raise .AllocationFailed; }

        flags := 0;
        if options.text { flags |= 1; }
        if options.headerCrc { flags |= 2; }
        if options.extra.len > 0 { flags |= 4; }
        if options.filename.len > 0 { flags |= 8; }
        if options.comment.len > 0 { flags |= 16; }
        state.header[3] = flags.(u8);
        state.header[4] = (options.mtime & 0xff).(u8);
        state.header[5] = ((options.mtime >> 8) & 0xff).(u8);
        state.header[6] = ((options.mtime >> 16) & 0xff).(u8);
        state.header[7] = ((options.mtime >> 24) & 0xff).(u8);
        state.header[9] = options.os;

        if options.extra.len > 0 or options.filename.len > 0 or options.comment.len > 0 or options.headerCrc {
            tail := ByteWriter.init(alloc);
            if options.extra.len > 0 {
                tail.putU16le(options.extra.len);
                tail.putBytes(options.extra);
            }
            if options.filename.len > 0 { tail.putBytes(options.filename); tail.put(0); }
            if options.comment.len > 0 { tail.putBytes(options.comment); tail.put(0); }
            if options.headerCrc {
                fixed := string{ ptr = *state.header[0], len = state.header.len };
                sum := crc32(fixed);
                if tail.bytes.len > 0 {
                    sum = crc32(string{ ptr = tail.bytes.items.ptr, len = tail.bytes.len }, sum);
                }
                tail.putU16le(sum & 0xffff);
            }
            if tail.failed {
                tail.deinit();
                state.deinit();
                raise .AllocationFailed;
            }
            state.headerTail = tail.take();
        }
        state
    }

    reset :: (self: *GzipDeflater, level: i64 = 6) {
        alloc := self.alloc;
        self.deinit();
        self.* = GzipDeflater.init(level, alloc);
    }

    resetOptions :: (self: *GzipDeflater, level: i64, strategy: Strategy, options: GzipOptions) -> !Error {
        alloc := self.alloc;
        self.deinit();
        self.* = try GzipDeflater.initOptions(level, strategy, options, alloc);
    }

    deinit :: (self: *GzipDeflater) {
        if self.headerTail.ptr != null { self.alloc.deallocBytes(self.headerTail.ptr); }
        self.headerTail = .{ ptr = null, len = 0 };
        self.headerTailAt = 0;
        self.raw.deinit();
        self.phase = .done;
    }

    stepUnchecked :: (self: *GzipDeflater, input: string, output: string, finish: bool = false) -> Progress {
        consumed := 0;
        produced := 0;
        while true {
            if self.phase == .done { return Progress{ consumed = consumed, produced = produced, status = .done }; }
            if self.phase == .header {
                while self.headerAt < 10 and produced < output.len {
                    output.ptr[produced] = self.header[self.headerAt];
                    self.headerAt += 1;
                    produced += 1;
                }
                if self.headerAt < 10 { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                while self.headerTailAt < self.headerTail.len and produced < output.len {
                    output.ptr[produced] = self.headerTail[self.headerTailAt];
                    self.headerTailAt += 1;
                    produced += 1;
                }
                if self.headerTailAt < self.headerTail.len { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                self.phase = .body;
                continue;
            }
            if self.phase == .body {
                bodyInput : string = .{ ptr = null, len = 0 };
                if consumed < input.len { bodyInput = input[consumed..]; }
                bodyOutput : string = .{ ptr = null, len = 0 };
                if produced < output.len { bodyOutput = output[produced..]; }
                progress := self.raw.stepUnchecked(bodyInput, bodyOutput, finish);
                if progress.consumed > 0 {
                    consumedBytes := input[consumed..consumed + progress.consumed];
                    self.checksum = crc32(consumedBytes, self.checksum);
                    self.inputSize = (self.inputSize + progress.consumed) & 0xffffffff;
                    consumed += progress.consumed;
                }
                produced += progress.produced;
                if progress.status == .done {
                    self.trailer[0] = (self.checksum & 0xff).(u8);
                    self.trailer[1] = ((self.checksum >> 8) & 0xff).(u8);
                    self.trailer[2] = ((self.checksum >> 16) & 0xff).(u8);
                    self.trailer[3] = ((self.checksum >> 24) & 0xff).(u8);
                    self.trailer[4] = (self.inputSize & 0xff).(u8);
                    self.trailer[5] = ((self.inputSize >> 8) & 0xff).(u8);
                    self.trailer[6] = ((self.inputSize >> 16) & 0xff).(u8);
                    self.trailer[7] = ((self.inputSize >> 24) & 0xff).(u8);
                    self.phase = .trailer;
                    continue;
                }
                return Progress{ consumed = consumed, produced = produced, status = progress.status };
            }
            if self.phase == .trailer {
                while self.trailerAt < 8 and produced < output.len {
                    output.ptr[produced] = self.trailer[self.trailerAt];
                    self.trailerAt += 1;
                    produced += 1;
                }
                if self.trailerAt < 8 { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                self.phase = .done;
                continue;
            }
        }
        Progress{ consumed = consumed, produced = produced, status = .done }
    }

    step :: (self: *GzipDeflater, input: string, output: string, finish: bool = false) -> (Progress, !Error) {
        if self.raw.allocationFailed { raise .AllocationFailed; }
        if input.len > 0 and (self.phase == .done or self.phase == .trailer or (self.phase == .body and self.raw.blockFinal and (self.raw.phase == .pendingBits or self.raw.phase == .flushFinal))) { raise .Finished; }
        progress := self.stepUnchecked(input, output, finish);
        if self.raw.allocationFailed { raise .AllocationFailed; }
        progress
    }

    end :: (self: *GzipDeflater) -> !Error { if self.phase != .done { raise .UnexpectedEnd; } }
}

private InflatePhase :: enum {
    blockHeader;
    storedLength;
    storedInverse;
    storedCopy;
    dynamicCounts;
    dynamicCodeLengths;
    dynamicLengths;
    dynamicRepeat16;
    dynamicRepeat17;
    dynamicRepeat18;
    symbol;
    literal;
    lengthExtra;
    distanceSymbol;
    distanceExtra;
    matchCopy;
    done;
}

// Stateful RFC 1951 decoder. The 32 KiB history window is allocator-owned;
// Huffman tables live in the value itself. `step` performs no allocation and
// retains no input/output pointers after returning.
Inflater :: struct {
    phase: InflatePhase;
    finalBlock: bool;
    bitBuffer: i64;
    bitCount: i64;
    totalOutput: i64;
    maxOutput: i64;
    lastConsumed: i64;
    lastProduced: i64;

    window: string;
    windowPos: i64;
    historyLen: i64;
    directOutput: string;
    // The fused symbol/match loop may only run when the caller supplies the
    // complete remaining input. Resumable chunked input uses the phase machine
    // so a length/distance sequence can straddle arbitrary boundaries.
    directFast: bool;
    fixedTreesReady: bool;
    literalDense: bool;
    alloc: Allocator;

    litTree: Huffman;
    distTree: Huffman;
    codeTree: Huffman;
    codeLengths: [19]u8;
    dynamicLengths: [320]u8;
    hlit: i64;
    hdist: i64;
    hclen: i64;
    dynamicAt: i64;
    previousLength: i64;

    decodeCode: i64;
    decodeFirst: i64;
    decodeIndex: i64;
    decodeLen: i64;

    storedLength: i64;
    pendingLiteral: i64;
    matchLength: i64;
    matchDistance: i64;
    pendingExtraBits: i64;

    initWithWindow :: (maxOutput: i64, alloc: Allocator, window: string) -> Inflater {
        Inflater{
            phase = .blockHeader,
            finalBlock = false,
            bitBuffer = 0,
            bitCount = 0,
            totalOutput = 0,
            maxOutput = maxOutput,
            lastConsumed = 0,
            lastProduced = 0,
            window = window,
            windowPos = 0,
            historyLen = 0,
            directOutput = .{ ptr = null, len = 0 },
            directFast = false,
            fixedTreesReady = false,
            literalDense = false,
            alloc = alloc,
            litTree = ---,
            distTree = ---,
            codeTree = ---,
            codeLengths = ---,
            dynamicLengths = ---,
            hlit = 0,
            hdist = 0,
            hclen = 0,
            dynamicAt = 0,
            previousLength = 0,
            decodeCode = 0,
            decodeFirst = 0,
            decodeIndex = 0,
            decodeLen = 1,
            storedLength = 0,
            pendingLiteral = 0,
            matchLength = 0,
            matchDistance = 0,
            pendingExtraBits = 0,
        }
    }

    init :: (maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> Inflater {
        raw := alloc.allocBytes(32768);
        window : string = .{ ptr = null, len = 0 };
        if raw != null { window = .{ ptr = raw, len = 32768 }; }
        Inflater.initWithWindow(maxOutput, alloc, window)
    }

    reset :: (self: *Inflater, maxOutput: i64 = 1073741824) {
        window := self.window;
        alloc := self.alloc;
        if window.ptr == null {
            raw := alloc.allocBytes(32768);
            if raw != null { window = .{ ptr = raw, len = 32768 }; }
        }
        self.* = Inflater.initWithWindow(maxOutput, alloc, window);
    }

    deinit :: (self: *Inflater) {
        if self.window.ptr != null { self.alloc.deallocBytes(self.window.ptr); }
        self.window.ptr = null;
        self.window.len = 0;
        self.phase = .done;
    }

    resetDecode :: (self: *Inflater) {
        self.decodeCode = 0;
        self.decodeFirst = 0;
        self.decodeIndex = 0;
        self.decodeLen = 1;
    }

    takeBits :: (self: *Inflater, input: string, consumed: *i64, nbits: i64) -> (i64, bool) {
        while self.bitCount < nbits {
            if consumed.* >= input.len { return 0, false; }
            self.bitBuffer = self.bitBuffer | (input[consumed.*].(i64) << self.bitCount);
            consumed.* += 1;
            self.bitCount += 8;
        }
        mask := if nbits == 0 then 0 else (1 << nbits) - 1;
        value := self.bitBuffer & mask;
        self.bitBuffer = self.bitBuffer >> nbits;
        self.bitCount -= nbits;
        return value, true;
    }

    decode :: (self: *Inflater, input: string, consumed: *i64, tree: *Huffman) -> (i64, bool, !Error) {
        if self.decodeLen == 1 {
            peekBits := self.bitBuffer;
            peekCount := self.bitCount;
            peekAt := consumed.*;
            while peekCount < 10 and peekAt < input.len {
                peekBits = peekBits | (input[peekAt].(i64) << peekCount);
                peekAt += 1;
                peekCount += 8;
            }
            if peekCount >= 10 {
                entry := tree.fast[peekBits & 1023].(i64);
                if entry < 0 {
                    while peekCount < 15 and peekAt < input.len {
                        peekBits = peekBits | (input[peekAt].(i64) << peekCount);
                        peekAt += 1;
                        peekCount += 8;
                    }
                    if peekCount >= 15 {
                        entry = huffmanResolve(tree, peekBits);
                    } else {
                        entry = 0;
                    }
                }
                if entry != 0 {
                    length := entry >> 9;
                    symbol := entry & 511;
                    while self.bitCount < length {
                        self.bitBuffer = self.bitBuffer | (input[consumed.*].(i64) << self.bitCount);
                        consumed.* += 1;
                        self.bitCount += 8;
                    }
                    self.bitBuffer = self.bitBuffer >> length;
                    self.bitCount -= length;
                    return symbol, true;
                }
            }
        }
        while self.decodeLen <= 15 {
            bit, available := self.takeBits(input, consumed, 1);
            if !available { return 0, false; }
            self.decodeCode = self.decodeCode | bit;
            count := tree.counts[self.decodeLen].(i64);
            if self.decodeCode - self.decodeFirst < count {
                symbol := tree.symbols[self.decodeIndex + self.decodeCode - self.decodeFirst].(i64);
                self.resetDecode();
                return symbol, true;
            }
            self.decodeIndex += count;
            self.decodeFirst = (self.decodeFirst + count) << 1;
            self.decodeCode = self.decodeCode << 1;
            self.decodeLen += 1;
        }
        self.resetDecode();
        raise .InvalidData;
    }

    decodeDirect :: (self: *Inflater, input: string, consumed: *i64, tree: *Huffman) -> (i64, !Error) {
        while self.bitCount < 15 {
            self.bitBuffer = self.bitBuffer | (input[consumed.*].(i64) << self.bitCount);
            consumed.* += 1;
            self.bitCount += 8;
        }
        entry := huffmanResolve(tree, self.bitBuffer);
        if entry != 0 {
            length := entry >> 9;
            symbol := entry & 511;
            self.bitBuffer = self.bitBuffer >> length;
            self.bitCount -= length;
            return symbol;
        }
        symbol, available := try self.decode(input, consumed, tree);
        if !available { raise .UnexpectedEnd; }
        symbol
    }

    putHistory :: (self: *Inflater, output: string, produced: *i64, value: i64) {
        output.ptr[produced.*] = value.(u8);
        produced.* += 1;
        if self.directOutput.ptr == null {
            self.window[self.windowPos] = value.(u8);
            self.windowPos = (self.windowPos + 1) & 32767;
        }
        if self.historyLen < 32768 { self.historyLen += 1; }
        self.totalOutput += 1;
    }

    finishDynamicTrees :: (self: *Inflater) -> !Error {
        if self.dynamicLengths[256] == 0 { raise .InvalidData; }
        try buildHuffmanInto(*self.litTree, string{ ptr = *self.dynamicLengths[0], len = self.hlit });
        try buildHuffmanInto(*self.distTree, string{ ptr = *self.dynamicLengths[self.hlit], len = self.hdist }, true, true);
        // A complete literal/length tree spans 32768 units at 15-bit
        // precision. Scan only EOB and the at-most-29 length symbols; the
        // remainder is literal weight. Literal-dense blocks can use the
        // bookkeeping-light two-literal loop below.
        nonliteralWeight := 1 << (15 - self.dynamicLengths[256].(i64));
        i := 257;
        while i < self.hlit {
            bits := self.dynamicLengths[i].(i64);
            if bits > 0 { nonliteralWeight += 1 << (15 - bits); }
            i += 1;
        }
        self.literalDense = 32768 - nonliteralWeight >= nonliteralWeight * 16;
        self.fixedTreesReady = false;
        self.resetDecode();
        self.phase = .symbol;
    }

    rememberFailure :: (self: *Inflater, consumed: i64, produced: i64) {
        self.lastConsumed = consumed;
        self.lastProduced = produced;
    }

    step :: (self: *Inflater, input: string, output: string) -> (Progress, !Error) {
        if self.window.ptr == null and self.directOutput.ptr == null { self.rememberFailure(0, 0); raise .AllocationFailed; }
        if self.maxOutput < 0 { self.rememberFailure(0, 0); raise .OutputLimit; }
        consumed := 0;
        produced := 0;
        defer { self.lastConsumed = consumed; self.lastProduced = produced; }
        while true {
            if self.phase == .done {
                if self.directOutput.ptr != null and self.bitCount >= 8 {
                    unread := self.bitCount / 8;
                    if unread <= consumed {
                        consumed -= unread;
                        self.bitCount -= unread * 8;
                        mask := if self.bitCount == 0 then 0 else (1 << self.bitCount) - 1;
                        self.bitBuffer = self.bitBuffer & mask;
                    }
                }
                return Progress{ consumed = consumed, produced = produced, status = .done };
            }

            if self.phase == .blockHeader {
                header, available := self.takeBits(input, *consumed, 3);
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                self.finalBlock = (header & 1) != 0;
                kind := (header >> 1) & 3;
                if kind == 0 {
                    // tinfl's fast decoder may already have read complete
                    // stored-header/payload bytes into the bit buffer. Drop
                    // only the residual alignment bits and retain those
                    // bytes for the LEN/NLEN and payload phases.
                    padding := self.bitCount & 7;
                    self.bitBuffer = self.bitBuffer >> padding;
                    self.bitCount -= padding;
                    self.phase = .storedLength;
                } else if kind == 1 {
                    if !self.fixedTreesReady {
                        fixedTreesInto(*self.litTree, *self.distTree) catch |e| {
                            self.rememberFailure(consumed, produced); raise e;
                        };
                        self.fixedTreesReady = true;
                    }
                    self.literalDense = false;
                    self.resetDecode();
                    self.phase = .symbol;
                } else if kind == 2 {
                    self.phase = .dynamicCounts;
                } else {
                    self.rememberFailure(consumed, produced);
                    raise .InvalidData;
                }
                continue;
            }

            if self.phase == .storedLength {
                value, available := self.takeBits(input, *consumed, 16);
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                self.storedLength = value;
                self.phase = .storedInverse;
                continue;
            }
            if self.phase == .storedInverse {
                inverse, available := self.takeBits(input, *consumed, 16);
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                if ((self.storedLength ^ inverse) & 0xffff) != 0xffff { self.rememberFailure(consumed, produced); raise .InvalidData; }
                if self.storedLength > self.maxOutput - self.totalOutput { self.rememberFailure(consumed, produced); raise .OutputLimit; }
                if self.storedLength == 0 {
                    self.phase = if self.finalBlock then .done else .blockHeader;
                } else {
                    self.phase = .storedCopy;
                }
                continue;
            }
            if self.phase == .storedCopy {
                // Drain complete payload bytes retained by fast Huffman
                // read-ahead before advancing the caller's input pointer.
                while self.storedLength > 0 and self.bitCount >= 8 and produced < output.len {
                    value := self.bitBuffer & 0xff;
                    self.bitBuffer = self.bitBuffer >> 8;
                    self.bitCount -= 8;
                    self.putHistory(output, *produced, value);
                    self.storedLength -= 1;
                }
                if self.storedLength == 0 {
                    self.phase = if self.finalBlock then .done else .blockHeader;
                    continue;
                }
                if produced >= output.len { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                if consumed >= input.len { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                take := self.storedLength;
                if take > input.len - consumed { take = input.len - consumed; }
                if take > output.len - produced { take = output.len - produced; }
                inputStart := consumed;
                outputStart := produced;
                n := 0;
                while n < take { output.ptr[outputStart + n] = input[inputStart + n]; n += 1; }
                if self.directOutput.ptr == null {
                    left := take;
                    copied := 0;
                    while left > 0 {
                        span := 32768 - self.windowPos;
                        if span > left { span = left; }
                        n = 0;
                        while n < span {
                            self.window.ptr[self.windowPos + n] = input[inputStart + copied + n];
                            n += 1;
                        }
                        self.windowPos = (self.windowPos + span) & 32767;
                        copied += span;
                        left -= span;
                    }
                }
                consumed += take;
                produced += take;
                self.totalOutput += take;
                self.historyLen += take;
                if self.historyLen > 32768 { self.historyLen = 32768; }
                self.storedLength -= take;
                if self.storedLength == 0 { self.phase = if self.finalBlock then .done else .blockHeader; }
                continue;
            }

            if self.phase == .dynamicCounts {
                counts, available := self.takeBits(input, *consumed, 14);
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                self.hlit = (counts & 31) + 257;
                self.hdist = ((counts >> 5) & 31) + 1;
                self.hclen = ((counts >> 10) & 15) + 4;
                if self.hlit > 286 or self.hdist > 32 { self.rememberFailure(consumed, produced); raise .InvalidData; }
                i := 0;
                while i < 19 { self.codeLengths[i] = 0; i += 1; }
                self.dynamicAt = 0;
                self.phase = .dynamicCodeLengths;
                continue;
            }
            if self.phase == .dynamicCodeLengths {
                if self.dynamicAt < self.hclen {
                    value, available := self.takeBits(input, *consumed, 3);
                    if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                    self.codeLengths[CODELEN_ORDER[self.dynamicAt]] = value.(u8);
                    self.dynamicAt += 1;
                    continue;
                }
                buildHuffmanInto(*self.codeTree, string{ ptr = *self.codeLengths[0], len = 19 }, false) catch |e| {
                    self.rememberFailure(consumed, produced); raise e;
                };
                self.dynamicAt = 0;
                self.previousLength = 0;
                self.resetDecode();
                self.phase = .dynamicLengths;
                continue;
            }
            if self.phase == .dynamicLengths {
                total := self.hlit + self.hdist;
                if self.dynamicAt == total {
                    self.finishDynamicTrees() catch |e| {
                        self.rememberFailure(consumed, produced); raise e;
                    };
                    continue;
                }
                symbol, available := self.decode(input, *consumed, *self.codeTree) catch |e| {
                    self.rememberFailure(consumed, produced); raise e;
                };
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                if symbol <= 15 {
                    self.dynamicLengths[self.dynamicAt] = symbol.(u8);
                    self.previousLength = symbol;
                    self.dynamicAt += 1;
                } else if symbol == 16 {
                    if self.dynamicAt == 0 { self.rememberFailure(consumed, produced); raise .InvalidData; }
                    self.phase = .dynamicRepeat16;
                } else if symbol == 17 {
                    self.phase = .dynamicRepeat17;
                } else if symbol == 18 {
                    self.phase = .dynamicRepeat18;
                } else {
                    self.rememberFailure(consumed, produced);
                    raise .InvalidData;
                }
                continue;
            }

            if self.phase == .dynamicRepeat16 or self.phase == .dynamicRepeat17 or self.phase == .dynamicRepeat18 {
                extraBits := 2;
                base := 3;
                value := self.previousLength;
                if self.phase == .dynamicRepeat17 { extraBits = 3; base = 3; value = 0; }
                if self.phase == .dynamicRepeat18 { extraBits = 7; base = 11; value = 0; }
                extra, available := self.takeBits(input, *consumed, extraBits);
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                repeat := base + extra;
                total := self.hlit + self.hdist;
                if self.dynamicAt + repeat > total { self.rememberFailure(consumed, produced); raise .InvalidData; }
                n := 0;
                while n < repeat {
                    self.dynamicLengths[self.dynamicAt] = value.(u8);
                    self.dynamicAt += 1;
                    n += 1;
                }
                self.previousLength = value;
                self.phase = .dynamicLengths;
                continue;
            }

            if self.phase == .symbol {
                // One-shot decode owns a stable output buffer, so keep the
                // common literal/length/distance sequence in one tight loop.
                // The resumable state machine below remains the boundary and
                // malformed-input fallback.
                if self.directOutput.ptr != null and self.directFast {
                    if self.literalDense {
                        directBits := self.bitBuffer;
                        directCount := self.bitCount;
                        directTotal := self.totalOutput;
                        directAvailable := output.len - produced;
                        limitAvailable := self.maxOutput - directTotal;
                        if directAvailable > limitAvailable { directAvailable = limitAvailable; }
                        while directAvailable >= 258 and input.len - consumed >= 8 {
                            if directCount < 30 {
                                word := input[consumed].(i64) |
                                    (input[consumed + 1].(i64) << 8) |
                                    (input[consumed + 2].(i64) << 16) |
                                    (input[consumed + 3].(i64) << 24);
                                directBits = directBits | (word << directCount);
                                directCount += 32;
                                consumed += 4;
                            }
                            firstEntry := huffmanResolve(*self.litTree, directBits);
                            if firstEntry == 0 { break; }
                            firstLength := firstEntry >> 9;
                            firstSymbol := firstEntry & 511;
                            if firstSymbol >= 256 { break; }

                            afterFirstBits := directBits >> firstLength;
                            afterFirstCount := directCount - firstLength;
                            secondEntry := huffmanResolve(*self.litTree, afterFirstBits);
                            if secondEntry == 0 or (secondEntry & 511) >= 256 {
                                output.ptr[produced] = firstSymbol.(u8);
                                produced += 1;
                                directTotal += 1;
                                directAvailable -= 1;
                                directBits = afterFirstBits;
                                directCount = afterFirstCount;
                                break;
                            }

                            secondLength := secondEntry >> 9;
                            secondSymbol := secondEntry & 511;
                            output.ptr[produced] = firstSymbol.(u8);
                            output.ptr[produced + 1] = secondSymbol.(u8);
                            produced += 2;
                            directTotal += 2;
                            directAvailable -= 2;
                            directBits = afterFirstBits >> secondLength;
                            directCount = afterFirstCount - secondLength;
                        }
                        self.bitBuffer = directBits;
                        self.bitCount = directCount;
                        self.totalOutput = directTotal;
                        self.historyLen = if directTotal > 32768 then 32768 else directTotal;
                    } else {
                    // Keep tinfl's literal-only inner loop entirely in local
                    // registers. Stop before consuming a length/EOB symbol so
                    // the common path below retains all boundary/error logic.
                    directBits := self.bitBuffer;
                    directCount := self.bitCount;
                    directTotal := self.totalOutput;
                    directHistory := self.historyLen;
                    while output.len - produced >= 258 and input.len - consumed >= 8 and
                          self.maxOutput - directTotal >= 2 {
                        if directCount < 30 {
                            word := input[consumed].(i64) |
                                (input[consumed + 1].(i64) << 8) |
                                (input[consumed + 2].(i64) << 16) |
                                (input[consumed + 3].(i64) << 24);
                            directBits = directBits | (word << directCount);
                            directCount += 32;
                            consumed += 4;
                        }
                        firstEntry := huffmanResolve(*self.litTree, directBits);
                        if firstEntry == 0 { break; }
                        firstLength := firstEntry >> 9;
                        firstSymbol := firstEntry & 511;
                        if firstSymbol >= 256 { break; }

                        afterFirstBits := directBits >> firstLength;
                        afterFirstCount := directCount - firstLength;
                        secondEntry := huffmanResolve(*self.litTree, afterFirstBits);
                        if secondEntry == 0 or (secondEntry & 511) >= 256 {
                            output.ptr[produced] = firstSymbol.(u8);
                            produced += 1;
                            directTotal += 1;
                            if directHistory < 32768 { directHistory += 1; }
                            directBits = afterFirstBits;
                            directCount = afterFirstCount;
                            break;
                        }

                        secondLength := secondEntry >> 9;
                        secondSymbol := secondEntry & 511;
                        output.ptr[produced] = firstSymbol.(u8);
                        output.ptr[produced + 1] = secondSymbol.(u8);
                        produced += 2;
                        directTotal += 2;
                        directHistory += 2;
                        if directHistory > 32768 { directHistory = 32768; }
                        directBits = afterFirstBits >> secondLength;
                        directCount = afterFirstCount - secondLength;
                    }
                    self.bitBuffer = directBits;
                    self.bitCount = directCount;
                    self.totalOutput = directTotal;
                    self.historyLen = directHistory;
                    }

                    while output.len - produced >= 258 and input.len - consumed >= 8 and self.phase == .symbol {
                        symbol := -1;

                        // tinfl's 64-bit fast loop refills 32 bits and decodes
                        // two consecutive literals before returning to the
                        // block dispatcher. Preserve that path for complete
                        // one-shot input; resumable calls continue through
                        // decodeDirect/decode below without read-ahead.
                        if self.bitCount < 30 and input.len - consumed >= 4 {
                            word := input[consumed].(i64) |
                                (input[consumed + 1].(i64) << 8) |
                                (input[consumed + 2].(i64) << 16) |
                                (input[consumed + 3].(i64) << 24);
                            self.bitBuffer = self.bitBuffer | (word << self.bitCount);
                            self.bitCount += 32;
                            consumed += 4;
                        }
                        firstEntry := huffmanResolve(*self.litTree, self.bitBuffer);
                        if firstEntry != 0 {
                            firstLength := firstEntry >> 9;
                            firstSymbol := firstEntry & 511;
                            self.bitBuffer = self.bitBuffer >> firstLength;
                            self.bitCount -= firstLength;
                            if firstSymbol < 256 {
                                secondEntry := huffmanResolve(*self.litTree, self.bitBuffer);
                                if secondEntry != 0 {
                                    secondLength := secondEntry >> 9;
                                    secondSymbol := secondEntry & 511;
                                    self.bitBuffer = self.bitBuffer >> secondLength;
                                    self.bitCount -= secondLength;
                                    if self.totalOutput >= self.maxOutput {
                                        self.rememberFailure(consumed, produced); raise .OutputLimit;
                                    }
                                    output.ptr[produced] = firstSymbol.(u8);
                                    produced += 1;
                                    self.totalOutput += 1;
                                    if self.historyLen < 32768 { self.historyLen += 1; }
                                    if secondSymbol < 256 {
                                        if self.totalOutput >= self.maxOutput {
                                            self.rememberFailure(consumed, produced); raise .OutputLimit;
                                        }
                                        output.ptr[produced] = secondSymbol.(u8);
                                        produced += 1;
                                        self.totalOutput += 1;
                                        if self.historyLen < 32768 { self.historyLen += 1; }
                                        continue;
                                    }
                                    symbol = secondSymbol;
                                } else {
                                    if self.totalOutput >= self.maxOutput {
                                        self.rememberFailure(consumed, produced); raise .OutputLimit;
                                    }
                                    output.ptr[produced] = firstSymbol.(u8);
                                    produced += 1;
                                    self.totalOutput += 1;
                                    if self.historyLen < 32768 { self.historyLen += 1; }
                                    continue;
                                }
                            } else {
                                symbol = firstSymbol;
                            }
                        }

                        if symbol < 0 {
                            symbol = self.decodeDirect(input, *consumed, *self.litTree) catch |e| {
                                self.rememberFailure(consumed, produced); raise e;
                            };
                        }
                        if symbol < 256 {
                            if self.totalOutput >= self.maxOutput { self.rememberFailure(consumed, produced); raise .OutputLimit; }
                            output.ptr[produced] = symbol.(u8);
                            produced += 1;
                            self.totalOutput += 1;
                            if self.historyLen < 32768 { self.historyLen += 1; }
                            continue;
                        }
                        if symbol == 256 {
                            self.phase = if self.finalBlock then .done else .blockHeader;
                            break;
                        }
                        if symbol < 257 or symbol > 285 { self.rememberFailure(consumed, produced); raise .InvalidData; }
                        li := symbol - 257;
                        length := LENGTH_BASE[li];
                        extraBits := LENGTH_EXTRA[li];
                        if extraBits > 0 {
                            extra, hasExtra := self.takeBits(input, *consumed, extraBits);
                            if !hasExtra { self.rememberFailure(consumed, produced); raise .UnexpectedEnd; }
                            length += extra;
                        }
                        distSymbol := self.decodeDirect(input, *consumed, *self.distTree) catch |e| {
                            self.rememberFailure(consumed, produced); raise e;
                        };
                        if distSymbol > 29 { self.rememberFailure(consumed, produced); raise .InvalidData; }
                        distance := DIST_BASE[distSymbol];
                        distBits := DIST_EXTRA[distSymbol];
                        if distBits > 0 {
                            distExtra, hasDistExtra := self.takeBits(input, *consumed, distBits);
                            if !hasDistExtra { self.rememberFailure(consumed, produced); raise .UnexpectedEnd; }
                            distance += distExtra;
                        }
                        if distance <= 0 or distance > self.historyLen { self.rememberFailure(consumed, produced); raise .InvalidData; }
                        if length > self.maxOutput - self.totalOutput { self.rememberFailure(consumed, produced); raise .OutputLimit; }
                        globalAt := self.totalOutput;
                        copied := 0;
                        if distance == 1 {
                            c.memset(*self.directOutput.ptr[globalAt], self.directOutput[globalAt - 1], length);
                        } else {
                            while copied < length {
                                span := distance;
                                if span > length - copied { span = length - copied; }
                                c.memcpy(*self.directOutput.ptr[globalAt + copied], *self.directOutput.ptr[globalAt + copied - distance], span);
                                copied += span;
                            }
                        }
                        produced += length;
                        self.totalOutput += length;
                        self.historyLen += length;
                        if self.historyLen > 32768 { self.historyLen = 32768; }
                    }
                    if self.phase != .symbol { continue; }
                }
                symbol, available := self.decode(input, *consumed, *self.litTree) catch |e| {
                    self.rememberFailure(consumed, produced); raise e;
                };
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                if symbol < 256 {
                    self.pendingLiteral = symbol;
                    self.phase = .literal;
                } else if symbol == 256 {
                    self.phase = if self.finalBlock then .done else .blockHeader;
                } else {
                    if symbol < 257 or symbol > 285 { self.rememberFailure(consumed, produced); raise .InvalidData; }
                    li := symbol - 257;
                    self.matchLength = LENGTH_BASE[li];
                    self.pendingExtraBits = LENGTH_EXTRA[li];
                    self.phase = if self.pendingExtraBits > 0 then .lengthExtra else .distanceSymbol;
                }
                continue;
            }
            if self.phase == .literal {
                if self.totalOutput >= self.maxOutput { self.rememberFailure(consumed, produced); raise .OutputLimit; }
                if produced >= output.len { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                self.putHistory(output, *produced, self.pendingLiteral);
                self.phase = .symbol;
                continue;
            }
            if self.phase == .lengthExtra {
                extra, available := self.takeBits(input, *consumed, self.pendingExtraBits);
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                self.matchLength += extra;
                self.phase = .distanceSymbol;
                continue;
            }
            if self.phase == .distanceSymbol {
                symbol, available := self.decode(input, *consumed, *self.distTree) catch |e| {
                    self.rememberFailure(consumed, produced); raise e;
                };
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                if symbol > 29 { self.rememberFailure(consumed, produced); raise .InvalidData; }
                self.matchDistance = DIST_BASE[symbol];
                self.pendingExtraBits = DIST_EXTRA[symbol];
                self.phase = if self.pendingExtraBits > 0 then .distanceExtra else .matchCopy;
                if self.phase == .matchCopy {
                    if self.matchDistance <= 0 or self.matchDistance > self.historyLen { self.rememberFailure(consumed, produced); raise .InvalidData; }
                    if self.matchLength > self.maxOutput - self.totalOutput { self.rememberFailure(consumed, produced); raise .OutputLimit; }
                }
                continue;
            }
            if self.phase == .distanceExtra {
                extra, available := self.takeBits(input, *consumed, self.pendingExtraBits);
                if !available { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                self.matchDistance += extra;
                if self.matchDistance <= 0 or self.matchDistance > self.historyLen { self.rememberFailure(consumed, produced); raise .InvalidData; }
                if self.matchLength > self.maxOutput - self.totalOutput { self.rememberFailure(consumed, produced); raise .OutputLimit; }
                self.phase = .matchCopy;
                continue;
            }
            if self.phase == .matchCopy {
                if produced >= output.len { return Progress{ consumed = consumed, produced = produced, status = .needOutput }; }
                take := self.matchLength;
                if take > output.len - produced { take = output.len - produced; }
                outputAt := produced;
                n := 0;
                if self.directOutput.ptr != null {
                    globalAt := self.totalOutput;
                    if self.matchDistance == 1 {
                        c.memset(*self.directOutput.ptr[globalAt], self.directOutput[globalAt - 1], take);
                    } else {
                        while n < take {
                            span := self.matchDistance;
                            if span > take - n { span = take - n; }
                            c.memcpy(*self.directOutput.ptr[globalAt + n], *self.directOutput.ptr[globalAt + n - self.matchDistance], span);
                            n += span;
                        }
                    }
                } else {
                    windowAt := self.windowPos;
                    while n < take {
                        source := (windowAt - self.matchDistance) & 32767;
                        value := self.window[source];
                        output.ptr[outputAt + n] = value;
                        self.window.ptr[windowAt] = value;
                        windowAt = (windowAt + 1) & 32767;
                        n += 1;
                    }
                    self.windowPos = windowAt;
                }
                produced += take;
                self.totalOutput += take;
                self.historyLen += take;
                if self.historyLen > 32768 { self.historyLen = 32768; }
                self.matchLength -= take;
                if self.matchLength == 0 { self.phase = .symbol; }
                continue;
            }
        }
        self.rememberFailure(consumed, produced);
        raise .InvalidData;
    }

    end :: (self: *Inflater) -> !Error {
        if self.phase != .done { raise .UnexpectedEnd; }
    }
}

private ZlibInflatePhase :: enum { header; body; checksum; done; }

// Incremental RFC 1950 framing over `Inflater`. Header and Adler trailer bytes
// are retained in the state; compressed input and decoded output remain
// caller-owned windows.
ZlibInflater :: struct {
    raw: Inflater;
    phase: ZlibInflatePhase;
    header: [2]u8;
    headerAt: i64;
    trailer: [4]u8;
    trailerAt: i64;
    checksum: i64;
    maxOutput: i64;
    lastConsumed: i64;
    lastProduced: i64;

    init :: (maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> ZlibInflater {
        ZlibInflater{
            raw = Inflater.init(maxOutput, alloc),
            phase = .header,
            header = ---,
            headerAt = 0,
            trailer = ---,
            trailerAt = 0,
            checksum = 1,
            maxOutput = maxOutput,
            lastConsumed = 0,
            lastProduced = 0,
        }
    }

    initWithWindow :: (maxOutput: i64, alloc: Allocator, window: string) -> ZlibInflater {
        ZlibInflater{
            raw = Inflater.initWithWindow(maxOutput, alloc, window),
            phase = .header,
            header = ---,
            headerAt = 0,
            trailer = ---,
            trailerAt = 0,
            checksum = 1,
            maxOutput = maxOutput,
            lastConsumed = 0,
            lastProduced = 0,
        }
    }

    reset :: (self: *ZlibInflater, maxOutput: i64 = 1073741824) {
        self.raw.reset(maxOutput);
        self.phase = .header;
        self.headerAt = 0;
        self.trailerAt = 0;
        self.checksum = 1;
        self.maxOutput = maxOutput;
        self.lastConsumed = 0;
        self.lastProduced = 0;
    }

    deinit :: (self: *ZlibInflater) {
        self.raw.deinit();
        self.phase = .done;
    }

    step :: (self: *ZlibInflater, input: string, output: string) -> (Progress, !Error) {
        consumed := 0;
        produced := 0;
        defer {
            self.lastConsumed = consumed;
            self.lastProduced = produced;
        }
        while true {
            if self.phase == .done { return Progress{ consumed = consumed, produced = produced, status = .done }; }
            if self.phase == .header {
                while self.headerAt < 2 and consumed < input.len {
                    self.header[self.headerAt] = input[consumed];
                    self.headerAt += 1;
                    consumed += 1;
                }
                if self.headerAt < 2 { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                cmf := self.header[0].(i64);
                flg := self.header[1].(i64);
                if (cmf & 15) != 8 or (cmf >> 4) > 7 {
                    self.lastConsumed = consumed; self.lastProduced = produced;
                    raise .Unsupported;
                }
                if ((cmf << 8) + flg) % 31 != 0 {
                    self.lastConsumed = consumed; self.lastProduced = produced;
                    raise .InvalidData;
                }
                if (flg & 0x20) != 0 {
                    self.lastConsumed = consumed; self.lastProduced = produced;
                    raise .Unsupported;
                }
                self.phase = .body;
                continue;
            }
            if self.phase == .body {
                bodyInput : string = .{ ptr = null, len = 0 };
                if consumed < input.len { bodyInput = input[consumed..]; }
                bodyOutput : string = .{ ptr = null, len = 0 };
                if produced < output.len { bodyOutput = output[produced..]; }
                progress := self.raw.step(bodyInput, bodyOutput) catch |e| {
                    self.lastConsumed = consumed + self.raw.lastConsumed;
                    self.lastProduced = produced + self.raw.lastProduced;
                    raise e;
                };
                consumed += progress.consumed;
                if progress.produced > 0 {
                    made := output[produced..produced + progress.produced];
                    self.checksum = adler32(made, self.checksum);
                    produced += progress.produced;
                }
                if progress.status == .done { self.phase = .checksum; continue; }
                return Progress{ consumed = consumed, produced = produced, status = progress.status };
            }
            if self.phase == .checksum {
                while self.trailerAt < 4 and consumed < input.len {
                    self.trailer[self.trailerAt] = input[consumed];
                    self.trailerAt += 1;
                    consumed += 1;
                }
                if self.trailerAt < 4 { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                expected := (self.trailer[0].(i64) << 24) | (self.trailer[1].(i64) << 16) | (self.trailer[2].(i64) << 8) | self.trailer[3].(i64);
                if self.checksum != expected {
                    self.lastConsumed = consumed; self.lastProduced = produced;
                    raise .ChecksumMismatch;
                }
                self.phase = .done;
                continue;
            }
        }
        raise .InvalidData;
    }

    end :: (self: *ZlibInflater) -> !Error {
        if self.phase != .done { raise .UnexpectedEnd; }
    }
}

private TinflStatus :: enum { cannotMakeProgress; badParam; adlerMismatch; failed; done; needsMoreInput; hasMoreOutput; }

private TinflProgress :: struct {
    consumed: i64;
    produced: i64;
    status: TinflStatus;
}

// Status-preserving native adapter for tinfl_decompress(). The underlying
// decoder owns its 32 KiB history, so both upstream wrapping and non-wrapping
// caller-buffer modes can use arbitrary sx output windows without aliasing.
private TinflDecompressor :: struct {
    framed: ZlibInflater;
    flags: i64;
    checksum: i64;
    previousStatus: TinflStatus;
    terminal: bool;

    init :: (flags: i64 = 0, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> TinflDecompressor {
        TinflDecompressor{
            framed = ZlibInflater.init(maxOutput, alloc),
            flags = flags,
            checksum = 1,
            previousStatus = .needsMoreInput,
            terminal = false,
        }
    }

    initWithWindow :: (flags: i64, maxOutput: i64, alloc: Allocator, window: string) -> TinflDecompressor {
        TinflDecompressor{
            framed = ZlibInflater.initWithWindow(maxOutput, alloc, window),
            flags = flags,
            checksum = 1,
            previousStatus = .needsMoreInput,
            terminal = false,
        }
    }

    reset :: (self: *TinflDecompressor, flags: i64 = 0, maxOutput: i64 = 1073741824) {
        self.framed.reset(maxOutput);
        self.flags = flags;
        self.checksum = 1;
        self.previousStatus = .needsMoreInput;
        self.terminal = false;
    }

    deinit :: (self: *TinflDecompressor) {
        self.framed.deinit();
        self.terminal = true;
    }

    status :: (self: *TinflDecompressor) -> TinflStatus { self.previousStatus }
    adler :: (self: *TinflDecompressor) -> i64 { self.checksum }

    step :: (self: *TinflDecompressor, input: string, output: string, hasMoreInput: bool = false) -> TinflProgress {
        if self.terminal {
            if self.previousStatus == .adlerMismatch { self.previousStatus = .done; }
            return TinflProgress{ consumed = 0, produced = 0, status = self.previousStatus };
        }
        progress : Progress = ---;
        failed := false;
        failure : TinflStatus = .failed;
        if (self.flags & TINFL_FLAG_PARSE_ZLIB_HEADER) != 0 {
            progress = self.framed.step(input, output) catch |e| {
                failed = true;
                if e == .ChecksumMismatch { failure = .adlerMismatch; }
                Progress{ consumed = self.framed.lastConsumed, produced = self.framed.lastProduced, status = .needInput }
            };
        } else {
            progress = self.framed.raw.step(input, output) catch |e| {
                failed = true;
                Progress{ consumed = self.framed.raw.lastConsumed, produced = self.framed.raw.lastProduced, status = .needInput }
            };
        }
        // tinfl updates m_check_adler32 only when the call's final status is
        // nonnegative. The sole exception is an Adler mismatch: that status is
        // assigned after the successfully produced bytes have been included.
        checksumEnabled := (self.flags & (TINFL_FLAG_PARSE_ZLIB_HEADER | TINFL_FLAG_COMPUTE_ADLER32)) != 0;
        cannotProgress := !failed and progress.status == .needInput and !hasMoreInput;
        if progress.produced > 0 and checksumEnabled and ((!failed and !cannotProgress) or failure == .adlerMismatch) {
            self.checksum = adler32(output[..progress.produced], self.checksum);
        }
        if failed {
            self.previousStatus = failure;
            self.terminal = true;
            return TinflProgress{ consumed = progress.consumed, produced = progress.produced, status = failure };
        }
        status : TinflStatus = .failed;
        if progress.status == .done { status = .done; self.terminal = true; }
        else if progress.status == .needOutput { status = .hasMoreOutput; }
        else if hasMoreInput { status = .needsMoreInput; }
        else { status = .cannotMakeProgress; self.terminal = true; }
        self.previousStatus = status;
        TinflProgress{ consumed = progress.consumed, produced = progress.produced, status = status }
    }
}

private tinflError :: (status: TinflStatus) -> Error {
    if status == .adlerMismatch { return .ChecksumMismatch; }
    if status == .hasMoreOutput { return .OutputLimit; }
    if status == .needsMoreInput or status == .cannotMakeProgress { return .UnexpectedEnd; }
    if status == .badParam { return .InvalidData; }
    .InvalidData
}

// tinfl_decompress_mem_to_mem equivalent. `parseZlibHeader` selects RFC
// 1950 framing; raw mode corresponds to the upstream default flags.
inflateInto :: (data: string, output: string, parseZlibHeader: bool = false, alloc: Allocator = context.allocator) -> (i64, i64, !Error) {
    flags := TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF;
    if parseZlibHeader { flags = flags | TINFL_FLAG_PARSE_ZLIB_HEADER; }
    // tinfl reports caller-buffer exhaustion as HAS_MORE_OUTPUT; it does not
    // treat the destination capacity as a global decompression limit.
    state := TinflDecompressor.initWithWindow(flags, 1073741824, alloc, .{ ptr = null, len = 0 });
    defer state.deinit();
    // The non-wrapping helper already owns the complete destination. Point
    // match history at it directly, exactly as upstream tinfl does, so this
    // path does not require the native streaming window allocation.
    state.framed.raw.directOutput = output;
    state.framed.raw.directFast = true;
    inputAt := 0;
    outputAt := 0;
    probedFullOutput := false;
    while true {
        input : string = .{ ptr = null, len = 0 };
        if inputAt < data.len { input = data[inputAt..]; }
        destination : string = .{ ptr = null, len = 0 };
        if outputAt < output.len { destination = output[outputAt..]; }
        progress := state.step(input, destination, false);
        inputAt += progress.consumed;
        outputAt += progress.produced;
        if progress.status == .done { return outputAt, inputAt; }
        if progress.status == .hasMoreOutput and outputAt >= output.len {
            // The native decoder may fill the caller's last byte before it
            // consumes the zero-output end-of-block symbol. Give it one empty
            // window to finish; a second request proves real exhaustion.
            if !probedFullOutput { probedFullOutput = true; continue; }
            state.deinit();
            raise .OutputLimit;
        }
        if progress.produced > 0 { probedFullOutput = false; }
        state.deinit();
        raise tinflError(progress.status);
    }
    raise .InvalidData;
}

private GzipInflatePhase :: enum {
    fixedHeader;
    extraLength;
    extraData;
    filename;
    comment;
    headerCrc;
    body;
    trailer;
    betweenMembers;
    done;
}

// Incremental RFC 1952 reader, including concatenated members. `finish=true`
// identifies the final input window so the state can distinguish a completed
// member awaiting another header from the end of the gzip stream.
GzipInflater :: struct {
    raw: Inflater;
    phase: GzipInflatePhase;
    fixed: [10]u8;
    fixedAt: i64;
    flags: i64;
    extraLengthBytes: [2]u8;
    extraLengthAt:  i64;
    extraRemaining: i64;
    headerCrcBytes: [2]u8;
    headerCrcAt: i64;
    trailer: [8]u8;
    trailerAt: i64;
    headerChecksum: i64;
    memberChecksum: i64;
    memberSize: i64;
    totalOutput: i64;
    maxOutput: i64;
    finishing: bool;

    init :: (maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> GzipInflater {
        GzipInflater{
            raw = Inflater.init(maxOutput, alloc),
            phase = .fixedHeader,
            fixed = ---,
            fixedAt = 0,
            flags = 0,
            extraLengthBytes = ---,
            extraLengthAt = 0,
            extraRemaining = 0,
            headerCrcBytes = ---,
            headerCrcAt = 0,
            trailer = ---,
            trailerAt = 0,
            headerChecksum = 0,
            memberChecksum = 0,
            memberSize = 0,
            totalOutput = 0,
            maxOutput = maxOutput,
            finishing = false,
        }
    }

    startMember :: (self: *GzipInflater) {
        remaining := self.maxOutput - self.totalOutput;
        self.raw.reset(remaining);
        self.phase = .fixedHeader;
        self.fixedAt = 0;
        self.flags = 0;
        self.extraLengthAt = 0;
        self.extraRemaining = 0;
        self.headerCrcAt = 0;
        self.trailerAt = 0;
        self.headerChecksum = 0;
        self.memberChecksum = 0;
        self.memberSize = 0;
    }

    reset :: (self: *GzipInflater, maxOutput: i64 = 1073741824) {
        self.maxOutput = maxOutput;
        self.totalOutput = 0;
        self.finishing = false;
        self.startMember();
    }

    deinit :: (self: *GzipInflater) { self.raw.deinit(); self.phase = .done; }

    afterExtra :: (self: *GzipInflater) {
        if (self.flags & 8) != 0 { self.phase = .filename; }
        else if (self.flags & 16) != 0 { self.phase = .comment; }
        else if (self.flags & 2) != 0 { self.phase = .headerCrc; }
        else { self.phase = .body; }
    }

    afterFilename :: (self: *GzipInflater) {
        if (self.flags & 16) != 0 { self.phase = .comment; }
        else if (self.flags & 2) != 0 { self.phase = .headerCrc; }
        else { self.phase = .body; }
    }

    afterComment :: (self: *GzipInflater) {
        if (self.flags & 2) != 0 { self.phase = .headerCrc; }
        else { self.phase = .body; }
    }

    step :: (self: *GzipInflater, input: string, output: string, finish: bool = false) -> (Progress, !Error) {
        if finish { self.finishing = true; }
        consumed := 0;
        produced := 0;
        while true {
            if self.phase == .done {
                if input.len - consumed > 0 { raise .InvalidData; }
                return Progress{ consumed = consumed, produced = produced, status = .done };
            }
            if self.phase == .betweenMembers {
                if consumed < input.len {
                    self.startMember();
                    continue;
                }
                if self.finishing { self.phase = .done; continue; }
                return Progress{ consumed = consumed, produced = produced, status = .needInput };
            }
            if self.phase == .fixedHeader {
                start := consumed;
                while self.fixedAt < 10 and consumed < input.len {
                    self.fixed[self.fixedAt] = input[consumed];
                    self.fixedAt += 1;
                    consumed += 1;
                }
                if consumed > start {
                    self.headerChecksum = crc32(input[start..consumed], self.headerChecksum);
                }
                if self.fixedAt < 10 { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                if self.fixed[0] != 0x1f or self.fixed[1] != 0x8b { raise .InvalidData; }
                if self.fixed[2] != 8 { raise .Unsupported; }
                self.flags = self.fixed[3].(i64);
                if (self.flags & 0xe0) != 0 { raise .InvalidData; }
                if (self.flags & 4) != 0 { self.phase = .extraLength; }
                else { self.afterExtra(); }
                continue;
            }
            if self.phase == .extraLength {
                start := consumed;
                while self.extraLengthAt < 2 and consumed < input.len {
                    self.extraLengthBytes[self.extraLengthAt] = input[consumed];
                    self.extraLengthAt += 1;
                    consumed += 1;
                }
                if consumed > start { self.headerChecksum = crc32(input[start..consumed], self.headerChecksum); }
                if self.extraLengthAt < 2 { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                self.extraRemaining = self.extraLengthBytes[0].(i64) | (self.extraLengthBytes[1].(i64) << 8);
                self.phase = .extraData;
                continue;
            }
            if self.phase == .extraData {
                take := self.extraRemaining;
                if take > input.len - consumed { take = input.len - consumed; }
                if take > 0 {
                    self.headerChecksum = crc32(input[consumed..consumed + take], self.headerChecksum);
                    consumed += take;
                    self.extraRemaining -= take;
                }
                if self.extraRemaining > 0 { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                self.afterExtra();
                continue;
            }
            if self.phase == .filename or self.phase == .comment {
                start := consumed;
                found := false;
                while consumed < input.len {
                    byte := input[consumed];
                    consumed += 1;
                    if byte == 0 { found = true; break; }
                }
                if consumed > start { self.headerChecksum = crc32(input[start..consumed], self.headerChecksum); }
                if !found { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                if self.phase == .filename { self.afterFilename(); } else { self.afterComment(); }
                continue;
            }
            if self.phase == .headerCrc {
                while self.headerCrcAt < 2 and consumed < input.len {
                    self.headerCrcBytes[self.headerCrcAt] = input[consumed];
                    self.headerCrcAt += 1;
                    consumed += 1;
                }
                if self.headerCrcAt < 2 { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                expected := self.headerCrcBytes[0].(i64) | (self.headerCrcBytes[1].(i64) << 8);
                if (self.headerChecksum & 0xffff) != expected { raise .ChecksumMismatch; }
                self.phase = .body;
                continue;
            }
            if self.phase == .body {
                bodyInput : string = .{ ptr = null, len = 0 };
                if consumed < input.len { bodyInput = input[consumed..]; }
                bodyOutput : string = .{ ptr = null, len = 0 };
                if produced < output.len { bodyOutput = output[produced..]; }
                progress := try self.raw.step(bodyInput, bodyOutput);
                consumed += progress.consumed;
                if progress.produced > 0 {
                    made := output[produced..produced + progress.produced];
                    self.memberChecksum = crc32(made, self.memberChecksum);
                    self.memberSize = (self.memberSize + progress.produced) & 0xffffffff;
                    self.totalOutput += progress.produced;
                    produced += progress.produced;
                }
                if progress.status == .done { self.phase = .trailer; continue; }
                return Progress{ consumed = consumed, produced = produced, status = progress.status };
            }
            if self.phase == .trailer {
                while self.trailerAt < 8 and consumed < input.len {
                    self.trailer[self.trailerAt] = input[consumed];
                    self.trailerAt += 1;
                    consumed += 1;
                }
                if self.trailerAt < 8 { return Progress{ consumed = consumed, produced = produced, status = .needInput }; }
                expectedCrc := self.trailer[0].(i64) | (self.trailer[1].(i64) << 8) | (self.trailer[2].(i64) << 16) | (self.trailer[3].(i64) << 24);
                expectedSize := self.trailer[4].(i64) | (self.trailer[5].(i64) << 8) | (self.trailer[6].(i64) << 16) | (self.trailer[7].(i64) << 24);
                if self.memberChecksum != expectedCrc or self.memberSize != expectedSize { raise .ChecksumMismatch; }
                if consumed < input.len {
                    self.startMember();
                    continue;
                }
                if self.finishing { self.phase = .done; continue; }
                self.phase = .betweenMembers;
                return Progress{ consumed = consumed, produced = produced, status = .needInput };
            }
        }
        raise .InvalidData;
    }

    end :: (self: *GzipInflater) -> !Error {
        if self.phase != .done { raise .UnexpectedEnd; }
    }
}

// Internal form also reports the number of compressed bytes consumed through
// the end of the final block. Framing layers need this to locate their trailer
// and to continue with a concatenated member.
private DIRECT_INFLATE_LIMIT : i64 : 67108864;

inflateWithConsumed :: (data: string, maxOutput: i64, alloc: Allocator) -> (string, i64, !Error) {
    state := Inflater.init(maxOutput, alloc);
    defer state.deinit();
    out := ByteWriter.init(alloc);
    taken := false;
    defer { if !taken { out.deinit(); } }
    direct := maxOutput > 0 and maxOutput <= DIRECT_INFLATE_LIMIT;
    if direct {
        if !out.ensureCapacity(maxOutput) { raise .AllocationFailed; }
        state.directOutput = .{ ptr = out.bytes.items.ptr, len = maxOutput };
        state.directFast = true;
    }
    inputAt := 0;
    while true {
        remaining := maxOutput - out.bytes.len;
        if remaining < 0 { state.deinit(); raise .OutputLimit; }
        chunk := if direct then remaining else 8192;
        if chunk > remaining { chunk = remaining; }
        if chunk > 0 and !out.ensureCapacity(out.bytes.len + chunk) { raise .AllocationFailed; }
        output : string = .{ ptr = null, len = 0 };
        if chunk > 0 { output = string{ ptr = *out.bytes.items.ptr[out.bytes.len], len = chunk }; }
        input : string = .{ ptr = null, len = 0 };
        if inputAt < data.len { input = data[inputAt..]; }
        progress := try state.step(input, output);
        inputAt += progress.consumed;
        out.bytes.items.len += progress.produced;
        if progress.status == .done { taken = true; return out.take(), inputAt; }
        if progress.status == .needInput {
            if inputAt >= data.len {
                out.deinit();
                state.deinit();
                raise .UnexpectedEnd;
            }
        } else if progress.status == .needOutput and remaining == 0 {
            out.deinit();
            state.deinit();
            raise .OutputLimit;
        }
    }
    raise .InvalidData;
}

// -----------------------------------------------------------------------------
// RFC 1950 zlib wrapper

compress :: (data: string, level: i64 = -1, alloc: Allocator = context.allocator) -> string {
    compressStrategy(data, level, .default, alloc)
}

// Owned helper corresponding to mz_compress/mz_compress2. Miniz accepts every
// signed level: negative values select the default probes and values above 10
// clamp to its hidden level-10 mode.
private compressChecked :: (data: string, level: i64 = -1, alloc: Allocator = context.allocator) -> (string, !Error) {
    result := compress(data, level, alloc);
    if result.ptr == null { raise .AllocationFailed; }
    result
}

private compressStrategy :: (data: string, level: i64, strategy: Strategy, alloc: Allocator = context.allocator) -> string {
    compressPath(data, level, strategy, .fastest, alloc)
}

compressPath :: (data: string, level: i64, strategy: Strategy, path: DeflatePath, alloc: Allocator = context.allocator) -> string {
    state := ZlibDeflater.initPath(level, strategy, path, alloc);
    out := ByteWriter.init(alloc);
    // The one-shot zlib wrapper has the same complete-size knowledge as the
    // raw deflate helper. Reserve the public miniz bound once so incompressible
    // streams do not repeatedly allocate, copy, and release their output.
    if data.len <= 83848836698679778 {
        ratioBound := 128 + (data.len * 110) / 100;
        blockBound := 128 + data.len + ((data.len / (31 * 1024)) + 1) * 5;
        out.ensureCapacity(if ratioBound > blockBound then ratioBound else blockBound);
    }
    inputAt := 0;
    while true {
        if state.raw.allocationFailed or !out.ensureCapacity(out.bytes.len + 8192) {
            state.deinit(); out.deinit();
            return .{ ptr = null, len = 0 };
        }
        input : string = .{ ptr = null, len = 0 };
        if inputAt < data.len { input = data[inputAt..]; }
        output := string{ ptr = *out.bytes.items.ptr[out.bytes.len], len = 8192 };
        progress := state.stepUnchecked(input, output, true);
        if state.raw.allocationFailed {
            state.deinit(); out.deinit();
            return .{ ptr = null, len = 0 };
        }
        inputAt += progress.consumed;
        out.bytes.items.len += progress.produced;
        if progress.status == .done { state.deinit(); return out.take(); }
    }
    out.take()
}

// Compress into caller-owned storage without allocating the output. The
// returned string borrows the initialized prefix of `output`.
compressInto :: (data: string, output: string, level: i64 = -1, alloc: Allocator = context.allocator) -> (string, !Error) {
    state := ZlibDeflater.init(level, alloc);
    defer state.deinit();
    inputAt := 0;
    outputAt := 0;
    while true {
        input : string = .{ ptr = null, len = 0 };
        if inputAt < data.len { input = data[inputAt..]; }
        destination : string = .{ ptr = null, len = 0 };
        if outputAt < output.len { destination = output[outputAt..]; }
        progress := try state.step(input, destination, true);
        inputAt += progress.consumed;
        outputAt += progress.produced;
        if progress.status == .done { return output[..outputAt]; }
        if progress.status == .needOutput and outputAt >= output.len {
            state.deinit();
            raise .OutputLimit;
        }
        if progress.status == .needInput and inputAt >= data.len { continue; }
    }
    state.deinit();
    raise .InvalidData;
}

// Strict framing helper for callers that require exactly one zlib stream.
decompressExact :: (data: string, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (string, !Error) {
    result, consumed := try decompressWithConsumed(data, maxOutput, alloc);
    if consumed != data.len {
        alloc.deallocBytes(result.ptr);
        raise .InvalidData;
    }
    result
}

decompressWithConsumed :: (data: string, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (string, i64, !Error) {
    direct := maxOutput > 0 and maxOutput <= DIRECT_INFLATE_LIMIT;
    // One-shot decode writes directly into its final output allocation and
    // never consults the wrapping history window. Avoid allocating a second
    // 32 KiB buffer solely to release it again at the end of the call.
    state := if direct then
        ZlibInflater.initWithWindow(maxOutput, alloc, string{ ptr = null, len = 0 })
    else
        ZlibInflater.init(maxOutput, alloc);
    defer state.deinit();
    out := ByteWriter.init(alloc);
    taken := false;
    defer { if !taken { out.deinit(); } }
    if direct {
        if !out.ensureCapacity(maxOutput) { raise .AllocationFailed; }
        state.raw.directOutput = .{ ptr = out.bytes.items.ptr, len = maxOutput };
        state.raw.directFast = true;
    }
    inputAt := 0;
    while true {
        remaining := maxOutput - out.bytes.len;
        if remaining < 0 { state.deinit(); raise .OutputLimit; }
        chunk := if direct then remaining else 8192;
        if chunk > remaining { chunk = remaining; }
        if chunk > 0 and !out.ensureCapacity(out.bytes.len + chunk) { raise .AllocationFailed; }
        output : string = .{ ptr = null, len = 0 };
        if chunk > 0 { output = string{ ptr = *out.bytes.items.ptr[out.bytes.len], len = chunk }; }
        input : string = .{ ptr = null, len = 0 };
        if inputAt < data.len { input = data[inputAt..]; }
        progress := try state.step(input, output);
        inputAt += progress.consumed;
        out.bytes.items.len += progress.produced;
        if progress.status == .done {
            taken = true;
            return out.take(), inputAt;
        }
        if progress.status == .needInput and inputAt >= data.len {
            out.deinit();
            state.deinit();
            raise .UnexpectedEnd;
        }
        if progress.status == .needOutput and remaining == 0 {
            out.deinit();
            state.deinit();
            raise .OutputLimit;
        }
    }
    raise .InvalidData;
}

// Fixed-destination equivalent of mz_uncompress2. Trailing bytes are left
// unconsumed and reported to the caller, exactly like the upstream helper.
decompressIntoWithConsumed :: (data: string, output: string, alloc: Allocator = context.allocator) -> (i64, i64, !Error) {
    state := ZlibInflater.init(output.len, alloc);
    defer state.deinit();
    inputAt := 0;
    outputAt := 0;
    while true {
        input : string = .{ ptr = null, len = 0 };
        if inputAt < data.len { input = data[inputAt..]; }
        destination : string = .{ ptr = null, len = 0 };
        if outputAt < output.len { destination = output[outputAt..]; }
        progress := state.step(input, destination) catch |e| {
            state.deinit();
            raise e;
        };
        inputAt += progress.consumed;
        outputAt += progress.produced;
        if progress.status == .done { return outputAt, inputAt; }
        if progress.status == .needOutput and outputAt >= output.len { state.deinit(); raise .OutputLimit; }
        if progress.status == .needInput and inputAt >= data.len { state.deinit(); raise .UnexpectedEnd; }
    }
    state.deinit();
    raise .InvalidData;
}

// -----------------------------------------------------------------------------
// RFC 1952 gzip wrapper

gzipCompressOptionsStrategy :: (data: string, options: GzipOptions, level: i64, strategy: Strategy, alloc: Allocator = context.allocator) -> (string, !Error) {
    try validateGzipOptions(options);

    raw := deflateStrategy(data, level, strategy, alloc);
    if raw.ptr == null { raise .AllocationFailed; }
    out := ByteWriter.init(alloc);
    out.put(0x1f);
    out.put(0x8b);
    out.put(8);
    flags := 0;
    if options.text { flags = flags | 1; }
    if options.headerCrc { flags = flags | 2; }
    if options.extra.len > 0 { flags = flags | 4; }
    if options.filename.len > 0 { flags = flags | 8; }
    if options.comment.len > 0 { flags = flags | 16; }
    out.put(flags);
    out.putU32le(options.mtime);
    xfl := 0;
    if level >= 8 { xfl = 2; }
    if level <= 2 { xfl = 4; }
    out.put(xfl);
    out.put(options.os.(i64));
    if options.extra.len > 0 {
        out.putU16le(options.extra.len);
        out.putBytes(options.extra);
    }
    if options.filename.len > 0 { out.putBytes(options.filename); out.put(0); }
    if options.comment.len > 0 { out.putBytes(options.comment); out.put(0); }
    if options.headerCrc {
        header := string{ ptr = out.bytes.items.ptr, len = out.bytes.len };
        out.putU16le(crc32(header) & 0xffff);
    }
    out.putBytes(raw);
    out.putU32le(crc32(data));
    out.putU32le(data.len & 0xffffffff);
    alloc.deallocBytes(raw.ptr);
    if out.failed { out.deinit(); raise .AllocationFailed; }
    out.take()
}

gzipDecompress :: (data: string, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (string, !Error) {
    state := GzipInflater.init(maxOutput, alloc);
    defer state.deinit();
    out := ByteWriter.init(alloc);
    taken := false;
    defer { if !taken { out.deinit(); } }
    inputAt := 0;
    while true {
        remaining := maxOutput - out.bytes.len;
        if remaining < 0 { state.deinit(); raise .OutputLimit; }
        chunk := 8192;
        if chunk > remaining { chunk = remaining; }
        if chunk > 0 and !out.ensureCapacity(out.bytes.len + chunk) { raise .AllocationFailed; }
        output : string = .{ ptr = null, len = 0 };
        if chunk > 0 { output = string{ ptr = *out.bytes.items.ptr[out.bytes.len], len = chunk }; }
        input : string = .{ ptr = null, len = 0 };
        if inputAt < data.len { input = data[inputAt..]; }
        progress := try state.step(input, output, true);
        inputAt += progress.consumed;
        out.bytes.items.len += progress.produced;
        if progress.status == .done { taken = true; return out.take(); }
        if progress.status == .needInput and inputAt >= data.len {
            out.deinit();
            state.deinit();
            raise .UnexpectedEnd;
        }
        if progress.status == .needOutput and remaining == 0 {
            out.deinit();
            state.deinit();
            raise .OutputLimit;
        }
    }
    raise .InvalidData;
}

// Internal RFC 1950 name used by the PNG engine.
zlibCompress :: compressChecked;
