private canonicalCodes :: (lengths: string, maxBits: i64) -> [288]u16 {
    counts : [16]i64 = ---;
    next : [16]i64 = ---;
    // tdefl stores every reversed DEFLATE code in 16 bits (the wire maximum
    // is 15). Avoid carrying 64-bit code tables through every block build.
    codes : [288]u16 = ---;
    i := 0;
    while i < 16 { counts[i] = 0; next[i] = 0; i += 1; }
    i = 0;
    while i < 288 { codes[i] = 0; i += 1; }
    i = 0;
    while i < lengths.len { if lengths[i] > 0 { counts[lengths[i]] += 1; } i += 1; }
    code := 0;
    bits := 1;
    while bits <= maxBits {
        code = (code + counts[bits - 1]) << 1;
        next[bits] = code;
        bits += 1;
    }
    i = 0;
    while i < lengths.len {
        len := lengths[i].(i64);
        if len > 0 {
            codes[i] = reverseBits(next[len], len).(u16);
            next[len] += 1;
        }
        i += 1;
    }
    codes
}

private TdeflTokenBuffer :: struct {
    // Exact tdefl LZ-code layout: one flag byte per eight tokens, one byte
    // per literal, and three bytes per match (length-3, distance-1 LE).
    // Keeping the production packed representation avoids the much larger
    // temporary token structs and their realloc/copy traffic.
    codes: string;
    codeLen: i64;
    flagsAt: i64;
    flagsLeft: i64;
    // tdefl uses 16-bit block-local Huffman counters. The block flush limit
    // keeps every counter representable and the narrower hot arrays reduce
    // load/store traffic in both parsers.
    litFreq: [286]u16;
    distFreq: [30]u16;
    sourceBytes: i64;

    init :: (alloc: Allocator, active: bool, lessMemory: bool = false) -> TdeflTokenBuffer {
        result : TdeflTokenBuffer = ---;
        result.codes = .{ ptr = null, len = 0 };
        if active {
            capacity := if lessMemory then 24 * 1024 else 64 * 1024;
            raw := alloc.allocBytes(capacity);
            if raw != null {
                result.codes = .{ ptr = raw, len = capacity };
                result.codes[0] = 0;
            }
        }
        result.codeLen = 1;
        result.flagsAt = 0;
        result.flagsLeft = 8;
        i := 0;
        while i < 286 { result.litFreq[i] = 0; i += 1; }
        i = 0;
        while i < 30 { result.distFreq[i] = 0; i += 1; }
        result.sourceBytes = 0;
        result
    }

    clear :: (self: *TdeflTokenBuffer) {
        self.codeLen = 1;
        self.flagsAt = 0;
        self.flagsLeft = 8;
        if self.codes.ptr != null { self.codes[0] = 0; }
        i := 0;
        while i < 286 { self.litFreq[i] = 0; i += 1; }
        i = 0;
        while i < 30 { self.distFreq[i] = 0; i += 1; }
        self.sourceBytes = 0;
    }

    deinit :: (self: *TdeflTokenBuffer, alloc: Allocator) {
        if self.codes.ptr != null { alloc.deallocBytes(self.codes.ptr); }
        self.codes.ptr = null;
        self.codes.len = 0;
        self.codeLen = 0;
    }

    nextFlag :: (self: *TdeflTokenBuffer) {
        self.flagsLeft -= 1;
        if self.flagsLeft == 0 {
            self.flagsLeft = 8;
            self.flagsAt = self.codeLen;
            self.codes[self.codeLen] = 0;
            self.codeLen += 1;
        }
    }

    finishFlags :: (self: *TdeflTokenBuffer) {
        self.codes[self.flagsAt] = (self.codes[self.flagsAt].(i64) >> self.flagsLeft).(u8);
        if self.flagsLeft == 8 { self.codeLen -= 1; }
    }

    literal :: (self: *TdeflTokenBuffer, value: i64, alloc: Allocator) {
        self.codes[self.codeLen] = value.(u8);
        self.codeLen += 1;
        self.codes[self.flagsAt] = (self.codes[self.flagsAt].(i64) >> 1).(u8);
        self.nextFlag();
        self.litFreq[value] += 1;
        self.sourceBytes += 1;
    }

    match :: (self: *TdeflTokenBuffer, length: i64, distance: i64, alloc: Allocator) {
        li := tdeflLengthIndex(length);
        di := tdeflDistanceIndex(distance);
        symbol := 257 + li;
        matchDistance := distance - 1;
        self.codes[self.codeLen] = (length - 3).(u8);
        self.codes[self.codeLen + 1] = matchDistance.(u8);
        self.codes[self.codeLen + 2] = (matchDistance >> 8).(u8);
        self.codeLen += 3;
        self.codes[self.flagsAt] = ((self.codes[self.flagsAt].(i64) >> 1) | 0x80).(u8);
        self.nextFlag();
        self.litFreq[symbol] += 1;
        self.distFreq[di] += 1;
        self.sourceBytes += length;
    }
}

// Exact tdefl symbol lookup tables used by the fast parser and block emitter.
// These mirror s_tdefl_len_sym (minus 257), s_tdefl_small_dist_sym,
// and s_tdefl_large_dist_sym from the pinned C source.
