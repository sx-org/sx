// Private state and callback bridges for the idiomatic std.codecs.zip facade.
// The public module aliases the Method/Entry/options/Source/Sink contracts and
// wraps these states; miniz-shaped storage/error machinery stays internal.

@import "modules/std/core.sx";
@import "modules/std/compress.sx";
@import "modules/std/internal/compress.sx";
@import "modules/std/internal/zip.sx";
fs :: @import "modules/std/fs.sx";
zipContracts :: @import "modules/std/codecs/zip_contracts.sx";

StdZipMethod       :: zipContracts.Method;
StdZipSource       :: zipContracts.Source;
StdZipSink         :: zipContracts.Sink;
StdZipEntryOptions :: zipContracts.EntryOptions;
StdZipEntry        :: zipContracts.Entry;
StdZipWriterOptions     :: zipContracts.WriterOptions;
StdZipFileWriterOptions :: zipContracts.FileWriterOptions;
StdZipFromReaderOptions :: zipContracts.FromReaderOptions;
StdZipAppendOptions     :: zipContracts.AppendOptions;
StdZipOpenOptions       :: zipContracts.OpenOptions;
StdZipOpenFileOptions   :: zipContracts.OpenFileOptions;

private stdZipEntryOptions :: (options: StdZipEntryOptions, fromFile: bool = false) -> (ZipEntryOptions, !Error) {
    if options.method == .unsupported { raise .Unsupported; }
    if options.level < 0 or options.level > 10 { raise .InvalidOptions; }
    if options.comment.len > 65535 or options.extra.len > 65535 { raise .TooLarge; }
    if extra := options.centralExtra {
        if extra.len > 65535 { raise .TooLarge; }
    }
    if options.modifiedSeconds != null and options.useFileModifiedTime { raise .InvalidOptions; }
    if options.useFileModifiedTime and !fromFile { raise .InvalidOptions; }

    central := options.centralExtra ?? "";
    ZipEntryOptions{
        method = options.method,
        level = options.level,
        extra = options.extra,
        centralExtra = central,
        separateCentralExtra = options.centralExtra != null,
        comment = options.comment,
        externalAttributes = options.externalAttributes.(i64),
        asciiFilename = !options.utf8,
        dataDescriptor = options.dataDescriptor,
        autoStoreSmall = options.storeSmall,
        timeMode = if options.modifiedSeconds != null then .specified else .none,
        modifiedUnixSeconds = options.modifiedSeconds ?? 0,
        useFileTime = fromFile and options.useFileModifiedTime,
    }
}

private StdZipSourceBridge :: struct {
    source: StdZipSource;
    failure: ?Error = null;
}

private stdZipSourceRead :: (ctx: *void, offset: i64, output: string) -> i64 {
    bridge : *StdZipSourceBridge = ctx.(*StdZipSourceBridge);
    made := 0;
    while made < output.len {
        destination := output[made..];
        result := bridge.source.readAt(offset + made, destination) catch |e| {
            bridge.failure = e;
            return -1;
        };
        if result.len < 0 or result.len > destination.len or
           (result.len > 0 and result.ptr != destination.ptr) {
            failure : Error = .InvalidData;
            bridge.failure = failure;
            return -1;
        }
        if result.len == 0 { return made; }
        made += result.len;
    }
    made
}

private StdZipSinkBridge :: struct {
    sink: StdZipSink;
    failure: ?Error = null;
    poisoned: bool = false;
}

private stdZipSinkWrite :: (ctx: *void, data: string) -> bool {
    bridge : *StdZipSinkBridge = ctx.(*StdZipSinkBridge);
    if bridge.poisoned { return false; }
    bridge.sink.write(data) catch |e| {
        bridge.failure = e;
        bridge.poisoned = true;
        return false;
    };
    true
}

private StdZipMemoryOutput :: struct {
    bytes: ByteWriter;
    taken: bool = false;
}

private stdZipMemoryTruncate :: (ctx: *void, len: i64) -> bool {
    output : *StdZipMemoryOutput = ctx.(*StdZipMemoryOutput);
    if len < 0 or len > output.bytes.bytes.len or output.bytes.failed { return false; }
    output.bytes.bytes.items.len = len;
    true
}

private stdZipMemoryWrite :: (ctx: *void, data: string) -> bool {
    output : *StdZipMemoryOutput = ctx.(*StdZipMemoryOutput);
    before := output.bytes.bytes.len;
    output.bytes.putBytes(data);
    !output.bytes.failed and output.bytes.bytes.len == before + data.len
}

private stdZipMemoryWriteAt :: (ctx: *void, offset: i64, data: string) -> bool {
    output : *StdZipMemoryOutput = ctx.(*StdZipMemoryOutput);
    if offset < 0 or offset > output.bytes.bytes.len or data.len > output.bytes.bytes.len - offset { return false; }
    i := 0;
    while i < data.len {
        output.bytes.bytes.items.ptr[offset + i] = data[i];
        i += 1;
    }
    true
}

private stdZipMemoryReadAt :: (ctx: *void, offset: i64, output: string) -> i64 {
    state : *StdZipMemoryOutput = ctx.(*StdZipMemoryOutput);
    if offset < 0 or offset >= state.bytes.bytes.len { return 0; }
    take := state.bytes.bytes.len - offset;
    if take > output.len { take = output.len; }
    i := 0;
    while i < take {
        output[i] = state.bytes.bytes.items[offset + i];
        i += 1;
    }
    take
}

StdZipReaderState :: struct {
    owned: OwnedZipReader;
    sourceBridge: *StdZipSourceBridge = null;
    closed: bool = false;
}

stdZipReaderMemory :: (data: string, alloc: Allocator = context.allocator) -> (StdZipReaderState, !Error) {
    reader := try openZip(data);
    owned := OwnedZipReader{ reader = reader, bytes = .{ ptr = null, len = 0 }, alloc = alloc };
    StdZipReaderState{ owned = owned }
}

stdZipReaderEmbedded :: (data: string, alloc: Allocator = context.allocator) -> (StdZipReaderState, !Error) {
    reader := try openZipEmbedded(data);
    owned := OwnedZipReader{ reader = reader, bytes = .{ ptr = null, len = 0 }, alloc = alloc };
    StdZipReaderState{ owned = owned }
}

stdZipReaderSource :: (source: StdZipSource, maxMetadata: i64 = 67108864, alloc: Allocator = context.allocator) -> (StdZipReaderState, !Error) {
    size := source.size();
    if size < 0 or maxMetadata < 0 { raise .InvalidArgument; }
    raw := alloc.allocBytes(@sizeOf(StdZipSourceBridge));
    if raw == null { raise .AllocationFailed; }
    bridge : *StdZipSourceBridge = raw.(*StdZipSourceBridge);
    bridge.* = .{ source = source };
    readerSource := ZipReadSource{ ctx = bridge, size = size, read = stdZipSourceRead };
    owned := openZipSource(readerSource, true, alloc, maxMetadata) catch |e| {
        failure := bridge.failure;
        alloc.deallocBytes(raw);
        if failure != null { raise failure; }
        raise e;
    };
    StdZipReaderState{ owned = owned, sourceBridge = bridge }
}

stdZipReaderFile :: (path: [:0]u8, start: i64 = 0, size: i64 = 0, maxMetadata: i64 = 67108864, alloc: Allocator = context.allocator) -> (StdZipReaderState, !Error) {
    owned := try openZipFile(path, start, size, alloc, maxMetadata);
    StdZipReaderState{ owned = owned }
}

stdZipReaderDeinit :: (state: *StdZipReaderState) {
    if state.closed { return; }
    alloc := state.owned.alloc;
    state.owned.deinit();
    if state.sourceBridge != null {
        alloc.deallocBytes(state.sourceBridge);
        state.sourceBridge = null;
    }
    state.closed = true;
}

private stdZipReaderReady :: (state: *StdZipReaderState) -> !Error {
    if state == null or state.closed or !state.owned.reader.active { raise .Finished; }
    if state.sourceBridge != null { state.sourceBridge.failure = null; }
}

private stdZipReaderFailure :: (state: *StdZipReaderState, fallback: Error) -> Error {
    if state.sourceBridge != null {
        if failure := state.sourceBridge.failure { return failure; }
    }
    fallback
}

stdZipReaderLen :: (state: *StdZipReaderState) -> i64 {
    if state == null or state.closed { return 0; }
    state.owned.reader.count
}

stdZipReaderComment :: (state: *StdZipReaderState) -> string {
    if state == null or state.closed { return ""; }
    state.owned.reader.comment
}

stdZipReaderIsZip64 :: (state: *StdZipReaderState) -> bool {
    state != null and !state.closed and state.owned.reader.zip64
}

stdZipReaderEntry :: (state: *StdZipReaderState, index: i64) -> (StdZipEntry, !Error) {
    try stdZipReaderReady(state);
    value := state.owned.reader.entry(index) catch |e| { raise stdZipReaderFailure(state, e); };
    modified : ?i64 = null;
    if value.dosTime != 0 or value.dosDate != 0 {
        seconds, valid := zipDosTimeToUnix(value.dosTime, value.dosDate);
        if valid { modified = seconds; }
    }
    StdZipEntry{
        name = value.name,
        comment = value.comment,
        extra = value.extra,
        method = value.method,
        size = value.size,
        compressedSize = value.compressedSize,
        checksum = value.crc.(u32),
        modifiedSeconds = modified,
        externalAttributes = value.externalAttributes.(u32),
        encrypted = value.isEncrypted(),
        directory = value.isDir(),
        supported = value.isSupported(),
        safePath = value.isSafePath(),
    }
}

stdZipReaderFind :: (state: *StdZipReaderState, name: string) -> (i64, !Error) {
    try stdZipReaderReady(state);
    state.owned.reader.find(name) catch |e| {
        raise stdZipReaderFailure(state, e);
    }
}

stdZipReaderReadAt :: (state: *StdZipReaderState, offset: i64, output: string) -> (string, !Error) {
    try stdZipReaderReady(state);
    made := state.owned.reader.readArchiveData(offset, output) catch |e| {
        raise stdZipReaderFailure(state, e);
    };
    output[..made]
}

stdZipReaderExtract :: (state: *StdZipReaderState, index: i64, compressed: bool = false, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (string, !Error) {
    try stdZipReaderReady(state);
    if maxOutput < 0 { raise .InvalidArgument; }
    options : ZipExtractOptions = .{ compressedData = compressed };
    state.owned.reader.extractOptions(index, options, maxOutput, alloc) catch |e| {
        raise stdZipReaderFailure(state, e);
    }
}

stdZipReaderExtractInto :: (state: *StdZipReaderState, index: i64, output: string, compressed: bool = false, alloc: Allocator = context.allocator) -> (string, !Error) {
    try stdZipReaderReady(state);
    options : ZipExtractOptions = .{ compressedData = compressed };
    made := state.owned.reader.extractInto(index, output, options, alloc) catch |e| {
        raise stdZipReaderFailure(state, e);
    };
    output[..made]
}

stdZipReaderExtractTo :: (state: *StdZipReaderState, index: i64, target: StdZipSink, compressed: bool = false, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (i64, !Error) {
    try stdZipReaderReady(state);
    stdZipExtractToSink(*state.owned.reader, index, target, compressed, maxOutput, alloc) catch |e| {
        raise stdZipReaderFailure(state, e);
    }
}

stdZipReaderExtractFile :: (state: *StdZipReaderState, index: i64, path: [:0]u8, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (i64, !Error) {
    try stdZipReaderReady(state);
    zipExtractToFile(*state.owned.reader, index, path, .{}, maxOutput, alloc) catch |e| {
        raise stdZipReaderFailure(state, e);
    }
}

stdZipReaderValidate :: (state: *StdZipReaderState, headersOnly: bool = false, alloc: Allocator = context.allocator) -> !Error {
    try stdZipReaderReady(state);
    state.owned.reader.validate(headersOnly, alloc) catch |e| {
        raise stdZipReaderFailure(state, e);
    };
}

// Bounded, seekable extraction state behind std.zip.EntryReader. The archive
// Reader (and, for source-backed readers, the caller's Source) must outlive
// this value because ZipSeekExtractor borrows the parsed archive state.
StdZipEntryReaderState :: struct {
    extractor: ZipSeekExtractor;
    owner: *StdZipReaderState;
    closed: bool = false;
}

stdZipEntryReader :: (state: *StdZipReaderState, index: i64, compressed: bool = false, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (StdZipEntryReaderState, !Error) {
    try stdZipReaderReady(state);
    if maxOutput < 0 { raise .InvalidArgument; }
    options : ZipExtractOptions = .{ compressedData = compressed };
    extractor := ZipSeekExtractor.init(*state.owned.reader, index, options, maxOutput, alloc) catch |e| {
        raise stdZipReaderFailure(state, e);
    };
    StdZipEntryReaderState{ extractor = extractor, owner = state }
}

stdZipEntryReaderLen :: (state: *StdZipEntryReaderState) -> i64 {
    if state == null { return 0; }
    state.extractor.size
}

stdZipEntryReaderOffset :: (state: *StdZipEntryReaderState) -> i64 {
    if state == null { return 0; }
    state.extractor.offset()
}

stdZipEntryReaderSeek :: (state: *StdZipEntryReaderState, offset: i64) -> !Error {
    if state == null or state.closed { raise .Finished; }
    try stdZipReaderReady(state.owner);
    state.extractor.seek(offset) catch |e| {
        raise stdZipReaderFailure(state.owner, e);
    };
}

stdZipEntryReaderRead :: (state: *StdZipEntryReaderState, output: string) -> (string, !Error) {
    if state == null or state.closed { raise .Finished; }
    try stdZipReaderReady(state.owner);
    if output.len == 0 { return output[..0]; }
    made := state.extractor.read(output) catch |e| {
        raise stdZipReaderFailure(state.owner, e);
    };
    if made == 0 {
        state.closed = true;
        state.extractor.end() catch |e| {
            raise stdZipReaderFailure(state.owner, e);
        };
    }
    output[..made]
}

// Explicit fallible integrity finalization: validates that the entry stream
// completed and its checksum matched. Stopping early (offset short of the
// final chunk) or a checksum mismatch raises; a stream already finalized by
// its terminal read returns cleanly. Always leaves the reader closed.
stdZipEntryReaderFinish :: (state: *StdZipEntryReaderState) -> !Error {
    if state == null { raise .Finished; }
    if state.closed { return; }
    try stdZipReaderReady(state.owner);
    state.closed = true;
    state.extractor.end() catch |e| {
        raise stdZipReaderFailure(state.owner, e);
    };
}

stdZipEntryReaderDeinit :: (state: *StdZipEntryReaderState) {
    if state == null or state.closed { return; }
    state.extractor.deinit();
    state.closed = true;
}

private StdZipMemoryWriter :: struct {
    writer: ZipStreamWriter;
    output: *StdZipMemoryOutput;
    alloc: Allocator;
    defaultComment: string = "";
    ownsDefaultComment: bool = false;
}

private StdZipBorrowedSinkWriter :: struct {
    writer: ZipStreamWriter;
    bridge: *StdZipSinkBridge;
    alloc: Allocator;
}

private StdZipFileWriter :: struct {
    owned: OwnedZipWriter;
}

private StdZipAppendFileWriter :: struct {
    source: OwnedZipReader;
    writer: ZipStreamWriter;
}

StdZipWriterState :: enum {
    memory: StdZipMemoryWriter;
    sink: StdZipBorrowedSinkWriter;
    file: StdZipFileWriter;
    updateFile: StdZipAppendFileWriter;
    closed;
}

stdZipWriterMemory :: (zip64: bool = false, alloc: Allocator = context.allocator) -> (StdZipWriterState, !Error) {
    raw := alloc.allocBytes(@sizeOf(StdZipMemoryOutput));
    if raw == null { raise .AllocationFailed; }
    output : *StdZipMemoryOutput = raw.(*StdZipMemoryOutput);
    output.* = .{ bytes = ByteWriter.init(alloc) };
    sink := ZipSink{
        ctx = output,
        write = stdZipMemoryWrite,
        writeAt = stdZipMemoryWriteAt,
        readAt = stdZipMemoryReadAt,
        truncate = stdZipMemoryTruncate,
    };
    writer := ZipStreamWriter.initMode(sink, zip64, alloc);
    writer.allowReading = true;
    payload : StdZipMemoryWriter = .{ writer = writer, output = output, alloc = alloc };
    StdZipWriterState.memory(payload)
}

stdZipWriterSink :: (target: StdZipSink, zip64: bool = false, alloc: Allocator = context.allocator) -> (StdZipWriterState, !Error) {
    raw := alloc.allocBytes(@sizeOf(StdZipSinkBridge));
    if raw == null { raise .AllocationFailed; }
    bridge : *StdZipSinkBridge = raw.(*StdZipSinkBridge);
    bridge.* = .{ sink = target };
    sink := ZipSink{ ctx = bridge, write = stdZipSinkWrite };
    writer := ZipStreamWriter.initMode(sink, zip64, alloc);
    if !writer.active {
        alloc.deallocBytes(raw);
        raise .InvalidArgument;
    }
    payload : StdZipBorrowedSinkWriter = .{ writer = writer, bridge = bridge, alloc = alloc };
    StdZipWriterState.sink(payload)
}

stdZipWriterFile :: (path: [:0]u8, reserve: i64 = 0, zip64: bool = false, alloc: Allocator = context.allocator) -> (StdZipWriterState, !Error) {
    owned := try openZipWriterFile(path, reserve, zip64, true, alloc);
    payload : StdZipFileWriter = .{ owned = owned };
    StdZipWriterState.file(payload)
}

stdZipWriterFromReader :: (source: *StdZipReaderState, forceZip64: bool = false, alloc: Allocator = context.allocator) -> (StdZipWriterState, !Error) {
    try stdZipReaderReady(source);
    state := try stdZipWriterMemory(source.owned.reader.zip64 or forceZip64, alloc);
    ready := false;
    defer { if !ready { stdZipWriterDeinit(*state); } }
    sourceComment := source.owned.reader.comment;
    if sourceComment.len > 0 {
        commentRaw := alloc.allocBytes(sourceComment.len);
        if commentRaw == null { raise .AllocationFailed; }
        comment : string = .{ ptr = commentRaw, len = sourceComment.len };
        i := 0;
        while i < sourceComment.len { comment[i] = sourceComment[i]; i += 1; }
        state.memory.defaultComment = comment;
        state.memory.ownsDefaultComment = true;
    }
    output := state.memory.output;
    localSize := source.owned.reader.centralRelativeOffset;
    if localSize < 0 { raise .InvalidData; }
    if !output.bytes.ensureCapacity(localSize) { raise .AllocationFailed; }
    output.bytes.bytes.items.len = localSize;
    source.owned.reader.readExactAt(source.owned.reader.archiveStart, output.bytes.bytes.items) catch |e| {
        raise stdZipReaderFailure(source, e);
    };
    replacement := ZipStreamWriter.initFromReader(*source.owned.reader, ZipSink{
        ctx = output,
        write = stdZipMemoryWrite,
        writeAt = stdZipMemoryWriteAt,
        readAt = stdZipMemoryReadAt,
        truncate = stdZipMemoryTruncate,
    }, forceZip64, alloc) catch |e| {
        raise stdZipReaderFailure(source, e);
    };
    state.memory.writer.deinit();
    state.memory.writer = replacement;
    state.memory.writer.allowReading = true;
    ready = true;
    state
}

stdZipWriterAppendFile :: (path: [:0]u8, forceZip64: bool = false, maxMetadata: i64 = 67108864, alloc: Allocator = context.allocator) -> (StdZipWriterState, !Error) {
    if !fs.exists(path) { return try stdZipWriterFile(path, 0, forceZip64, alloc); }
    source := try openZipFileWritable(path, 0, 0, alloc, maxMetadata);
    writer := zipFileWriterFromReader(*source, forceZip64, alloc) catch |e| {
        source.deinit();
        raise e;
    };
    payload : StdZipAppendFileWriter = .{ source = source, writer = writer };
    StdZipWriterState.updateFile(payload)
}

private stdZipWriterStream :: (state: *StdZipWriterState) -> *ZipStreamWriter {
    match state {
        case .memory: { return *state.*.memory.writer; }
        case .sink: { return *state.*.sink.writer; }
        case .file: { return *state.*.file.owned.writer; }
        case .updateFile: { return *state.*.updateFile.writer; }
        case .closed: {}
    }
    null
}

private stdZipWriterFailure :: (state: *StdZipWriterState, fallback: Error) -> Error {
    match state { case .sink: {} else: { return fallback; } }
    bridge := state.*.sink.bridge;
    if failure := bridge.failure {
        bridge.poisoned = true;
        return failure;
    }
    fallback
}

private stdZipWriterTransferFailure :: (target: *StdZipWriterState, source: *StdZipReaderState, fallback: Error) -> Error {
    match target {
        case .sink: {
            bridge := target.*.sink.bridge;
            if failure := bridge.failure {
                bridge.poisoned = true;
                return failure;
            }
        }
        else: {}
    }
    stdZipReaderFailure(source, fallback)
}

private stdZipWriterReady :: (state: *StdZipWriterState) -> (*ZipStreamWriter, !Error) {
    if state == null { raise .Finished; }
    closed := match state { case .closed: { true } else: { false } };
    if closed { raise .Finished; }
    match state {
        case .sink: {
            bridge := state.*.sink.bridge;
            if bridge.poisoned {
                if failure := bridge.failure { raise failure; }
                raise .Io;
            }
            bridge.failure = null;
        }
        else: {}
    }
    writer := stdZipWriterStream(state);
    if writer == null or !writer.active { raise .Finished; }
    writer
}

private stdZipWriterDefaultComment :: (state: *StdZipWriterState) -> string {
    match state {
        case .memory: { return state.*.memory.defaultComment; }
        case .updateFile: { return state.*.updateFile.source.reader.comment; }
        else: {}
    }
    ""
}

stdZipWriterLen :: (state: *StdZipWriterState) -> i64 {
    writer := stdZipWriterStream(state);
    if writer == null { return 0; }
    if writer.finished then writer.finalCount else writer.entries.len
}

stdZipWriterSize :: (state: *StdZipWriterState) -> i64 {
    writer := stdZipWriterStream(state);
    if writer == null { return 0; }
    writer.offset
}

stdZipWriterIsZip64 :: (state: *StdZipWriterState) -> bool {
    writer := stdZipWriterStream(state);
    writer != null and writer.active and writer.zip64
}

stdZipWriterSetAlignment :: (state: *StdZipWriterState, alignment: i64) -> !Error {
    writer := try stdZipWriterReady(state);
    writer.setAlignment(alignment) catch |e| { raise stdZipWriterFailure(state, e); };
}

stdZipWriterReservePrefix :: (state: *StdZipWriterState, size: i64) -> !Error {
    writer := try stdZipWriterReady(state);
    if writer.finished or writer.entries.len != 0 or size < 0 or size > 0xffffffff { raise .InvalidArgument; }
    writer.emitZeros(size) catch |e| { raise stdZipWriterFailure(state, e); };
}

stdZipWriterAdd :: (state: *StdZipWriterState, name: string, data: string, options: StdZipEntryOptions = .{}) -> !Error {
    writer := try stdZipWriterReady(state);
    actual := try stdZipEntryOptions(options);
    writer.addOptions(name, data, actual) catch |e| { raise stdZipWriterFailure(state, e); };
}

stdZipWriterAddSource :: (state: *StdZipWriterState, name: string, source: StdZipSource, options: StdZipEntryOptions = .{}) -> !Error {
    writer := try stdZipWriterReady(state);
    actual := try stdZipEntryOptions(options);
    stdZipAddSource(writer, name, source, actual) catch |e| { raise stdZipWriterFailure(state, e); };
}

stdZipWriterAddFile :: (state: *StdZipWriterState, name: string, path: [:0]u8, options: StdZipEntryOptions = .{}) -> !Error {
    writer := try stdZipWriterReady(state);
    actual := try stdZipEntryOptions(options, true);
    writer.addFile(name, path, actual) catch |e| { raise stdZipWriterFailure(state, e); };
}

stdZipWriterAddFrom :: (state: *StdZipWriterState, source: *StdZipReaderState, index: i64) -> !Error {
    writer := try stdZipWriterReady(state);
    try stdZipReaderReady(source);
    writer.addFromReader(*source.owned.reader, index) catch |e| {
        raise stdZipWriterTransferFailure(state, source, e);
    };
}

stdZipWriterReadAt :: (state: *StdZipWriterState, offset: i64, output: string) -> (string, !Error) {
    writer := try stdZipWriterReady(state);
    made := writer.readArchiveData(offset, output) catch |e| { raise stdZipWriterFailure(state, e); };
    output[..made]
}

stdZipWriterFinish :: (state: *StdZipWriterState, comment: ?string = null) -> !Error {
    writer := try stdZipWriterReady(state);
    archiveComment := comment ?? stdZipWriterDefaultComment(state);
    writer.finishComment(archiveComment) catch |e| { raise stdZipWriterFailure(state, e); };
}

stdZipWriterTake :: (state: *StdZipWriterState) -> (string, !Error) {
    memory := match state { case .memory: { true } else: { false } };
    if !memory { raise .Unsupported; }
    output := state.*.memory.output;
    if !state.*.memory.writer.finished or output.taken { raise .Finished; }
    failed := output.bytes.failed;
    result := output.bytes.take();
    if failed { raise .AllocationFailed; }
    output.taken = true;
    result
}

// Fallible finalization: exactly deinit's teardown, but flush/close failures
// surface as `Error.Io` instead of being discarded. The state always ends
// `.closed` (resources are released even on failure), so a subsequent
// deinit() is a no-op and take() reports Finished.
stdZipWriterClose :: (state: *StdZipWriterState) -> !Error {
    ok := true;
    match state {
        case .memory: {
            if !state.*.memory.writer.end() { ok = false; }
            state.*.memory.output.bytes.deinit();
            state.*.memory.alloc.deallocBytes(state.*.memory.output);
            if state.*.memory.ownsDefaultComment and state.*.memory.defaultComment.ptr != null {
                state.*.memory.alloc.deallocBytes(state.*.memory.defaultComment.ptr);
            }
        }
        case .sink: {
            if !state.*.sink.writer.end() { ok = false; }
            state.*.sink.alloc.deallocBytes(state.*.sink.bridge);
        }
        case .file: {
            if !state.*.file.owned.end() { ok = false; }
        }
        case .updateFile: {
            if !state.*.updateFile.writer.end() { ok = false; }
            if !state.*.updateFile.source.end() { ok = false; }
        }
        case .closed: { return; }
    }
    state.* = .closed;
    if !ok { raise .Io; }
}

stdZipWriterDeinit :: (state: *StdZipWriterState) {
    match state {
        case .memory: {
            state.*.memory.writer.deinit();
            state.*.memory.output.bytes.deinit();
            state.*.memory.alloc.deallocBytes(state.*.memory.output);
            if state.*.memory.ownsDefaultComment and state.*.memory.defaultComment.ptr != null {
                state.*.memory.alloc.deallocBytes(state.*.memory.defaultComment.ptr);
            }
        }
        case .sink: {
            state.*.sink.writer.deinit();
            state.*.sink.alloc.deallocBytes(state.*.sink.bridge);
        }
        case .file: { state.*.file.owned.deinit(); }
        case .updateFile: {
            state.*.updateFile.writer.deinit();
            state.*.updateFile.source.deinit();
        }
        case .closed: { return; }
    }
    state.* = .closed;
}

private stdZipExtractToSink :: (reader: *ZipReader, index: i64, target: StdZipSink, compressed: bool = false, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (i64, !Error) {
    bridge := StdZipSinkBridge{ sink = target };
    options : ZipExtractOptions = .{ compressedData = compressed };
    result := zipExtractToOutput(reader, index, .{ ctx = *bridge, write = stdZipSinkWrite }, options, maxOutput, alloc) catch |e| {
        if failure := bridge.failure { raise failure; }
        raise e;
    };
    result
}

private stdZipAddSource :: (writer: *ZipStreamWriter, name: string, source: StdZipSource, options: ZipEntryOptions) -> !Error {
    size := source.size();
    if size < 0 { raise .InvalidArgument; }
    bridge := StdZipSourceBridge{ source = source };
    input := ZipInputSource{ ctx = *bridge, size = size, read = stdZipSourceRead };
    writer.addSource(name, input, options) catch |e| {
        if failure := bridge.failure { raise failure; }
        raise e;
    };
}
