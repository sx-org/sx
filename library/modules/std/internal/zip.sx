// Dependency-free ZIP32/ZIP64 archive support.

@import "modules/std/core.sx";
@import "modules/std/list.sx";
@import "modules/std/fs.sx";
@import "modules/std/compress.sx";
@import "modules/std/internal/compress.sx";
zipContracts :: @import "modules/std/codecs/zip_contracts.sx";
time :: @import "modules/std/time.sx";

private le16 :: (data: string, at: i64) -> (i64, !Error) {
    if at < 0 or at + 2 > data.len { raise .UnexpectedEnd; }
    data[at].(i64) | (data[at + 1].(i64) << 8)
}

private le32 :: (data: string, at: i64) -> (i64, !Error) {
    if at < 0 or at + 4 > data.len { raise .UnexpectedEnd; }
    data[at].(i64) | (data[at + 1].(i64) << 8) | (data[at + 2].(i64) << 16) | (data[at + 3].(i64) << 24)
}

private le64 :: (data: string, at: i64) -> (i64, !Error) {
    if at < 0 or at + 8 > data.len { raise .UnexpectedEnd; }
    low := try le32(data, at);
    high := try le32(data, at + 4);
    if (high & 0x80000000) != 0 { raise .TooLarge; }
    low | (high << 32)
}

private zipStringEqual :: (a: string, b: string) -> bool {
    if a.len != b.len { return false; }
    i := 0;
    while i < a.len {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    true
}

ZipMethod :: zipContracts.Method;

ZipExtractOptions :: struct {
    compressedData: bool = false;
    skipCrc: bool = false;
}

private ZipEntry :: struct {
    name: string;
    extra: string;
    comment: string;
    method: ZipMethod;
    methodValue: i64;
    flags: i64;
    crc: i64;
    compressedSize: i64;
    size: i64;
    localOffset: i64;
    dosTime: i64;
    dosDate: i64;
    externalAttributes: i64;
    internalAttributes: i64;
    versionMadeBy: i64;
    versionNeeded: i64;
    centralOffset: i64;
    hasZip64Extra: bool = false;

    isDir :: (self: *ZipEntry) -> bool {
        (self.name.len > 0 and self.name[self.name.len - 1] == '/') or
        (self.externalAttributes & 0x10) != 0
    }

    isEncrypted :: (self: *ZipEntry) -> bool {
        (self.flags & (1 | 0x40)) != 0
    }

    isSupported :: (self: *ZipEntry) -> bool {
        self.method != .unsupported and !self.isEncrypted() and (self.flags & 0x20) == 0
    }

    // Purely lexical safety check for callers which choose to materialize an
    // entry. It deliberately makes no claim about symlinks or the filesystem
    // beneath the eventual destination directory.
    isSafePath :: (self: *ZipEntry) -> bool {
        if self.name.len == 0 { return false; }
        if self.name[0] == '/' { return false; }
        start := 0;
        i := 0;
        while i <= self.name.len {
            boundary := i == self.name.len;
            if !boundary {
                byte := self.name[i];
                // A backslash is a path separator on Windows, colon enables
                // drive-relative paths and alternate data streams, and NUL
                // truncates paths at common OS boundaries. Reject all three
                // rather than interpreting them differently per target.
                if byte == 0 or byte == '\\' or byte == ':' { return false; }
                boundary = byte == '/';
            }
            if boundary {
                len := i - start;
                if len == 2 and self.name[start] == '.' and self.name[start + 1] == '.' { return false; }
                start = i + 1;
            }
            i += 1;
        }
        true
    }
}

private zipExtraHasField :: (extra: string, wantedId: i64) -> bool {
    at := 0;
    while at < extra.len {
        if at + 4 > extra.len { return false; }
        fieldId := le16(extra, at) catch |e| 0;
        fieldSize := le16(extra, at + 2) catch |e| 0;
        end := at + 4 + fieldSize;
        if end > extra.len { return false; }
        if fieldId == wantedId { return true; }
        at = end;
    }
    false
}

// Validate user-authored extra-field framing before any archive bytes are
// emitted. Field 0x0001 is owned by the ZIP64 encoder; accepting another copy
// would make the meaning of sentinel sizes and offsets reader-dependent.
private zipValidateUserExtra :: (extra: string) -> !Error {
    at := 0;
    while at < extra.len {
        if at + 4 > extra.len { raise .InvalidOptions; }
        fieldId := try le16(extra, at);
        fieldSize := try le16(extra, at + 2);
        if fieldSize > extra.len - at - 4 { raise .InvalidOptions; }
        if fieldId == 1 { raise .InvalidOptions; }
        at += 4 + fieldSize;
    }
}

// Return the size of an existing central extra block after removing its ZIP64
// field. Reader-to-writer conversion regenerates that field from resolved
// values and preserves every other field byte-for-byte.
private zipExtraWithoutZip64Size :: (extra: string) -> (i64, !Error) {
    kept := 0;
    at := 0;
    while at < extra.len {
        if at + 4 > extra.len { raise .InvalidData; }
        fieldId := try le16(extra, at);
        fieldSize := try le16(extra, at + 2);
        fieldTotal := 4 + fieldSize;
        if fieldTotal > extra.len - at { raise .InvalidData; }
        if fieldId != 1 { kept += fieldTotal; }
        at += fieldTotal;
    }
    kept
}

private zipCopyExtraWithoutZip64 :: (output: *ByteWriter, extra: string) -> !Error {
    at := 0;
    while at < extra.len {
        if at + 4 > extra.len { raise .InvalidData; }
        fieldId := try le16(extra, at);
        fieldSize := try le16(extra, at + 2);
        fieldTotal := 4 + fieldSize;
        if fieldTotal > extra.len - at { raise .InvalidData; }
        if fieldId != 1 { output.putBytes(extra[at..at + fieldTotal]); }
        at += fieldTotal;
    }
}

private zip64Values :: (extra: string, compressedSize: i64, size: i64, localOffset: i64, diskStart: i64) -> (i64, i64, i64, i64, !Error) {
    needSize := size == 0xffffffff;
    needCompressed := compressedSize == 0xffffffff;
    needOffset := localOffset == 0xffffffff;
    needDisk := diskStart == 0xffff;
    if !needSize and !needCompressed and !needOffset and !needDisk {
        return compressedSize, size, localOffset, diskStart;
    }
    at := 0;
    while at < extra.len {
        if at + 4 > extra.len { raise .InvalidData; }
        fieldId := try le16(extra, at);
        fieldSize := try le16(extra, at + 2);
        dataAt := at + 4;
        end := dataAt + fieldSize;
        if end > extra.len { raise .InvalidData; }
        if fieldId == 1 {
            cursor := dataAt;
            if needSize {
                if cursor + 8 > end { raise .InvalidData; }
                size = try le64(extra, cursor); cursor += 8;
            }
            if needCompressed {
                if cursor + 8 > end { raise .InvalidData; }
                compressedSize = try le64(extra, cursor); cursor += 8;
            }
            if needOffset {
                if cursor + 8 > end { raise .InvalidData; }
                localOffset = try le64(extra, cursor); cursor += 8;
            }
            if needDisk {
                if cursor + 4 > end { raise .InvalidData; }
                diskStart = try le32(extra, cursor);
            }
            return compressedSize, size, localOffset, diskStart;
        }
        at = end;
    }
    raise .InvalidData;
}

ZipReadSource :: struct {
    ctx: *void;
    size: i64;
    read: (*void, i64, string) -> i64;
}

private zipSourceReadExact :: (source: ZipReadSource, offset: i64, output: string) -> !Error {
    if source.read == null or offset < 0 or output.len < 0 or offset > source.size or output.len > source.size - offset {
        raise .InvalidData;
    }
    if output.len == 0 { return; }
    made := source.read(source.ctx, offset, output);
    if made != output.len { raise .Io; }
}

ZipReader :: struct {
    data: string;
    centralOffset: i64;
    centralRelativeOffset: i64 = 0;
    centralSize: i64;
    count: i64;
    comment: string = "";
    zip64: bool = false;
    archiveStart: i64 = 0;
    archiveSize: i64 = 0;
    active: bool = true;
    sourceCtx: *void = null;
    sourceRead: (*void, i64, string) -> i64 = null;
    sourceSize: i64 = 0;

    init :: (data: string) -> (ZipReader, !Error) {
        ZipReader.initMode(data, false)
    }

    // File/user callback readers in miniz detect an archive appended to a
    // prefix (for example, a self-extracting executable). Memory readers do
    // not do this implicitly, so native sx exposes the behavior explicitly.
    initEmbedded :: (data: string) -> (ZipReader, !Error) {
        ZipReader.initMode(data, true)
    }

    initMode :: (data: string, detectPrefix: bool) -> (ZipReader, !Error) {
        if data.len < 22 { raise .InvalidData; }
        minPos := data.len - 65557;
        if minPos < 0 { minPos = 0; }
        pos := data.len - 22;
        found := -1;
        while pos >= minPos {
            if (try le32(data, pos)) == 0x06054b50 {
                found = pos; break;
            }
            pos -= 1;
        }
        if found < 0 { raise .InvalidData; }
        disk := try le16(data, found + 4);
        centralDisk := try le16(data, found + 6);
        diskCount := try le16(data, found + 8);
        count := try le16(data, found + 10);
        centralSize := try le32(data, found + 12);
        centralOffset := try le32(data, found + 16);
        isZip64 := false;
        if found >= 20 and (try le32(data, found - 20)) == 0x07064b50 {
            isZip64 = true;
            // miniz intentionally ignores the locator's "disk with ZIP64
            // EOCD" field. Only the total disk count below participates in
            // its multidisk rejection logic.
            if data[found - 4] != 1 { raise .Unsupported; }
            if data[found - 3] != 0 { raise .Unsupported; }
            if data[found - 2] != 0 { raise .Unsupported; }
            if data[found - 1] != 0 { raise .Unsupported; }
            zip64At := found - 76;
            if zip64At < 0 or (try le32(data, zip64At)) != 0x06064b50 {
                zip64At = try le64(data, found - 12);
            }
            if zip64At < 0 or zip64At + 56 > found - 20 or (try le32(data, zip64At)) != 0x06064b50 {
                raise .InvalidData;
            }
            if (try le64(data, zip64At + 4)) < 44 { raise .InvalidData; }
            disk = try le32(data, zip64At + 16);
            centralDisk = try le32(data, zip64At + 20);
            diskCount = try le64(data, zip64At + 24);
            count = try le64(data, zip64At + 32);
            centralSize = try le64(data, zip64At + 40);
            centralOffset = try le64(data, zip64At + 48);
            if count > 0xffffffff { raise .TooLarge; }
            if centralSize > 0xffffffff { raise .TooLarge; }
        } else if count == 0xffff or centralSize == 0xffffffff or centralOffset == 0xffffffff {
            raise .InvalidData;
        }
        if disk != 0 or centralDisk != 0 or diskCount != count {
            raise .Unsupported;
        }
        centralRelativeOffset := centralOffset;
        archiveStart := 0;
        if detectPrefix {
            tailSize := if isZip64 then 76 else 0;
            relativeEnd := centralRelativeOffset + centralSize + tailSize;
            if relativeEnd > found { raise .InvalidData; }
            archiveStart = found - relativeEnd;
        }
        centralOffset = archiveStart + centralRelativeOffset;
        if centralSize < count * 46 or centralOffset < 0 or centralOffset > data.len or centralSize > data.len - centralOffset or centralOffset + centralSize > found {
            raise .InvalidData;
        }

        // Validate the complete central directory up front. This prevents a
        // claimed entry count or trailing partial record from being accepted
        // merely because a caller never indexes far enough to encounter it.
        centralEnd := centralOffset + centralSize;
        scan := centralOffset;
        n := 0;
        while n < count {
            if scan + 46 > centralEnd or (try le32(data, scan)) != 0x02014b50 {
                raise .InvalidData;
            }
            flags := try le16(data, scan + 8);
            method := try le16(data, scan + 10);
            compressedSize := try le32(data, scan + 20);
            size := try le32(data, scan + 24);
            nameLen := try le16(data, scan + 28);
            extraLen := try le16(data, scan + 30);
            entryCommentLen := try le16(data, scan + 32);
            diskStart := try le16(data, scan + 34);
            localOffset := try le32(data, scan + 42);
            next := scan + 46 + nameLen + extraLen + entryCommentLen;
            if next > centralEnd {
                raise .InvalidData;
            }

            // During initialization miniz only scans a ZIP64 extra field when
            // a 32-bit sentinel is present, and merely marks the archive as
            // ZIP64. Field-value completeness is deferred to file_stat.
            if compressedSize == 0xffffffff or size == 0xffffffff or localOffset == 0xffffffff {
                extra := data[scan + 46 + nameLen..scan + 46 + nameLen + extraLen];
                extraAt := 0;
                foundZip64Extra := false;
                while extraAt < extra.len {
                    if extraAt + 4 > extra.len {
                        raise .InvalidData;
                    }
                    fieldId := try le16(extra, extraAt);
                    fieldSize := try le16(extra, extraAt + 2);
                    if fieldSize > extra.len - extraAt - 4 {
                        raise .InvalidData;
                    }
                    if fieldId == 1 { foundZip64Extra = true; break; }
                    extraAt += 4 + fieldSize;
                }
                if foundZip64Extra { isZip64 = true; }
            }

            if compressedSize != 0xffffffff and size != 0xffffffff {
                if (method == 0 and size != compressedSize) or (size != 0 and compressedSize == 0) {
                    raise .InvalidData;
                }
            }
            if diskStart == 0xffff or (diskStart != disk and diskStart != 1) {
                raise .Unsupported;
            }
            if compressedSize != 0xffffffff and localOffset + 30 + compressedSize > data.len {
                raise .InvalidData;
            }
            // Miniz indexes encrypted, patched, and unknown-method entries so
            // callers can inspect them. Masked local headers fail init.
            if (flags & 0x2000) != 0 {
                raise .Unsupported;
            }
            scan = next;
            n += 1;
        }
        archiveCommentLen := try le16(data, found + 20);
        availableComment := data.len - (found + 22);
        if archiveCommentLen > availableComment { archiveCommentLen = availableComment; }
        ZipReader{
            data = data,
            centralOffset = centralOffset,
            centralRelativeOffset = centralRelativeOffset,
            centralSize = centralSize,
            count = count,
            comment = data[found + 22..found + 22 + archiveCommentLen],
            zip64 = isZip64,
            archiveStart = archiveStart,
            archiveSize = data.len - archiveStart,
            active = true,
            sourceSize = data.len,
        }
    }

    isZip64 :: (self: *ZipReader) -> bool { self.active and self.zip64 }

    readArchiveData :: (self: *ZipReader, offset: i64, output: string) -> (i64, !Error) {
        if !self.active or offset < 0 { raise .InvalidData; }
        if offset >= self.archiveSize { return 0; }
        take := self.archiveSize - offset;
        if take > output.len { take = output.len; }
        sourceAt := self.archiveStart + offset;
        try self.readExactAt(sourceAt, output[..take]);
        take
    }

    readExactAt :: (self: *ZipReader, offset: i64, output: string) -> !Error {
        if !self.active or offset < 0 or output.len < 0 or offset > self.sourceSize or output.len > self.sourceSize - offset {
            raise .InvalidData;
        }
        if output.len == 0 { return; }
        if self.sourceRead != null {
            made := self.sourceRead(self.sourceCtx, offset, output);
            if made != output.len { raise .Io; }
            return;
        }
        if offset > self.data.len or output.len > self.data.len - offset { raise .InvalidData; }
        i := 0;
        while i < output.len { output.ptr[i] = self.data[offset + i]; i += 1; }
    }

    payloadInfo :: (self: *ZipReader, index: i64) -> (ZipEntry, i64, !Error) {
        entry := try self.entry(index);
        at := self.archiveStart + entry.localOffset;
        header : [30]u8 = ---;
        self.readExactAt(at, string{ ptr = *header[0], len = header.len }) catch |e| {
            raise e;
        };
        headerBytes := string{ ptr = *header[0], len = header.len };
        if (try le32(headerBytes, 0)) != 0x04034b50 { raise .InvalidData; }
        nameLen := try le16(headerBytes, 26);
        extraLen := try le16(headerBytes, 28);
        start := at + 30 + nameLen + extraLen;
        if start < at or start > self.sourceSize or entry.compressedSize > self.sourceSize - start {
            raise .InvalidData;
        }
        return entry, start;
    }

    localRecordBounds :: (self: *ZipReader, entry: ZipEntry) -> (i64, i64, !Error) {
        at := self.archiveStart + entry.localOffset;
        header : [30]u8 = ---;
        try self.readExactAt(at, string{ ptr = *header[0], len = header.len });
        bytes := string{ ptr = *header[0], len = header.len };
        if (try le32(bytes, 0)) != 0x04034b50 or (try le16(bytes, 6)) != entry.flags or (try le16(bytes, 8)) != entry.methodValue {
            raise .InvalidData;
        }
        nameLen := try le16(bytes, 26);
        extraLen := try le16(bytes, 28);
        if nameLen != entry.name.len { raise .InvalidData; }
        nameBuf : [4096]u8 = ---;
        nameAt := 0;
        while nameAt < nameLen {
            take := nameLen - nameAt;
            if take > nameBuf.len { take = nameBuf.len; }
            try self.readExactAt(at + 30 + nameAt, string{ ptr = *nameBuf[0], len = take });
            i := 0;
            while i < take {
                if nameBuf[i] != entry.name[nameAt + i] { raise .InvalidData; }
                i += 1;
            }
            nameAt += take;
        }
        payloadStart := at + 30 + nameLen + extraLen;
        if payloadStart < at or payloadStart > self.sourceSize or entry.compressedSize > self.sourceSize - payloadStart { raise .InvalidData; }
        payloadEnd := payloadStart + entry.compressedSize;
        if (entry.flags & 8) == 0 { return payloadStart, payloadEnd; }

        localCompressedRaw := try le32(bytes, 18);
        localSizeRaw := try le32(bytes, 22);
        wide := localCompressedRaw == 0xffffffff or localSizeRaw == 0xffffffff or
                entry.compressedSize >= 0xffffffff or entry.size >= 0xffffffff;
        first : [4]u8 = ---;
        try self.readExactAt(payloadEnd, string{ ptr = *first[0], len = first.len });
        firstBytes := string{ ptr = *first[0], len = first.len };
        signed := (try le32(firstBytes, 0)) == 0x08074b50;
        descriptorSize := if wide then 20 else 12;
        descriptorAt := payloadEnd + (if signed then 4 else 0);
        descriptor : [20]u8 = ---;
        try self.readExactAt(descriptorAt, string{ ptr = *descriptor[0], len = descriptorSize });
        descriptorBytes := string{ ptr = *descriptor[0], len = descriptorSize };
        actualCrc := try le32(descriptorBytes, 0);
        actualCompressed := if wide then try le64(descriptorBytes, 4) else try le32(descriptorBytes, 4);
        actualSize := if wide then try le64(descriptorBytes, 12) else try le32(descriptorBytes, 8);
        if actualCrc != entry.crc or actualCompressed != entry.compressedSize or actualSize != entry.size { raise .InvalidData; }
        return payloadStart, descriptorAt + descriptorSize;
    }

    // Checked lifecycle counterpart of mz_zip_reader_end(). A second end is
    // an invalid-parameter transition, not an idempotent success.
    end :: (self: *ZipReader) -> bool {
        if !self.active {
            return false;
        }
        self.active = false;
        self.data = "";
        self.centralSize = 0;
        self.sourceCtx = null;
        self.sourceRead = null;
        self.sourceSize = 0;
        true
    }

    entry :: (self: *ZipReader, index: i64) -> (ZipEntry, !Error) {
        self.entryUnchecked(index)
    }

    entryUnchecked :: (self: *ZipReader, index: i64) -> (ZipEntry, !Error) {
        if !self.active { raise .Finished; }
        if index < 0 or index >= self.count { raise .NotFound; }
        pos := self.centralOffset;
        n := 0;
        while n <= index {
            if pos + 46 > self.data.len or (try le32(self.data, pos)) != 0x02014b50 { raise .InvalidData; }
            nameLen := try le16(self.data, pos + 28);
            extraLen := try le16(self.data, pos + 30);
            commentLen := try le16(self.data, pos + 32);
            next := pos + 46 + nameLen + extraLen + commentLen;
            if next > self.data.len or next > self.centralOffset + self.centralSize { raise .InvalidData; }
            if n == index {
                methodValue := try le16(self.data, pos + 10);
                method : ZipMethod = .unsupported;
                if methodValue == 0 { method = .store; }
                else if methodValue == 8 { method = .deflate; }
                compressedSize := try le32(self.data, pos + 20);
                size := try le32(self.data, pos + 24);
                localOffset := try le32(self.data, pos + 42);
                diskStart := try le16(self.data, pos + 34);
                extra := self.data[pos + 46 + nameLen..pos + 46 + nameLen + extraLen];
                hasZip64Extra := zipExtraHasField(extra, 1);
                // Upstream only resolves sentinels when a 0x0001 field is
                // actually present. With no extra data at all, file_stat()
                // succeeds and exposes the raw sentinel; later validation or
                // extraction reports the resulting bounds/size error.
                if hasZip64Extra {
                    resolvedCompressed, resolvedSize, resolvedOffset, resolvedDisk := try zip64Values(extra, compressedSize, size, localOffset, diskStart);
                    compressedSize = resolvedCompressed;
                    size = resolvedSize;
                    localOffset = resolvedOffset;
                    diskStart = resolvedDisk;
                }
                if diskStart < 0 or diskStart > 1 { raise .Unsupported; }
                return ZipEntry{
                    name = self.data[pos + 46..pos + 46 + nameLen],
                    extra = extra,
                    comment = self.data[pos + 46 + nameLen + extraLen..pos + 46 + nameLen + extraLen + commentLen],
                    method = method,
                    methodValue = methodValue,
                    flags = try le16(self.data, pos + 8),
                    crc = try le32(self.data, pos + 16),
                    compressedSize = compressedSize,
                    size = size,
                    localOffset = localOffset,
                    dosTime = try le16(self.data, pos + 12),
                    dosDate = try le16(self.data, pos + 14),
                    externalAttributes = try le32(self.data, pos + 38),
                    internalAttributes = try le16(self.data, pos + 36),
                    versionMadeBy = try le16(self.data, pos + 4),
                    versionNeeded = try le16(self.data, pos + 6),
                    centralOffset = pos,
                    hasZip64Extra = hasZip64Extra,
                };
            }
            pos = next;
            n += 1;
        }
        raise .NotFound;
    }

    // Exact, case-sensitive, first-match lookup — the single supported
    // policy. The C-compatible case-folded / comment-filtered / path-ignoring
    // variants and their sorted-index machinery are gone with the C surface.
    find :: (self: *ZipReader, name: string) -> (i64, !Error) {
        if name.len > 65535 { raise .InvalidData; }
        i := 0;
        while i < self.count {
            entry := try self.entry(i);
            if zipStringEqual(entry.name, name) { return i; }
            i += 1;
        }
        raise .NotFound;
    }

    checkExtractSupport :: (self: *ZipReader, entry: ZipEntry, compressedData: bool) -> !Error {
        if entry.isEncrypted() or (entry.flags & 0x20) != 0 {
            raise .Unsupported;
        }
        // Raw compressed-data extraction supports unknown compression methods.
        if !compressedData and entry.method == .unsupported {
            raise .Unsupported;
        }
        // Directories and zero-compressed-size entries need no payload work,
        // but their declared features still have to be supported.
        if entry.isDir() or entry.compressedSize == 0 { return; }
    }

    checkValidationSupport :: (self: *ZipReader, entry: ZipEntry) -> !Error {
        if entry.isEncrypted() or (entry.flags & 0x20) != 0 or entry.method == .unsupported {
            raise .Unsupported;
        }
        if entry.isDir() or entry.size == 0 { return; }
    }

    extract :: (self: *ZipReader, index: i64, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (string, !Error) {
        self.extractOptions(index, ZipExtractOptions{}, maxOutput, alloc)
    }

    extractOptions :: (self: *ZipReader, index: i64, options: ZipExtractOptions, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (string, !Error) {
        entry := try self.entry(index);
        try self.checkExtractSupport(entry, options.compressedData);
        needed := if options.compressedData then entry.compressedSize else entry.size;
        if needed > maxOutput { raise .OutputLimit; }
        raw := alloc.allocBytes(needed);
        if needed > 0 and raw == null { raise .AllocationFailed; }
        result := string{ ptr = raw, len = needed };
        made := self.extractInto(index, result, options, alloc) catch |e| {
            if raw != null { alloc.deallocBytes(raw); }
            raise e;
        };
        if made != needed {
            if raw != null { alloc.deallocBytes(raw); }

            raise .InvalidData;
        }
        result
    }

    extractInto :: (self: *ZipReader, index: i64, output: string, options: ZipExtractOptions = .{}, alloc: Allocator = context.allocator) -> (i64, !Error) {
        self.extractIntoWithReadBuffer(index, output, options, .{ ptr = null, len = 0 }, alloc)
    }

    extractIntoWithReadBuffer :: (self: *ZipReader, index: i64, output: string, options: ZipExtractOptions, readBuffer: string, alloc: Allocator) -> (i64, !Error) {
        entry, payloadStart := try self.payloadInfo(index);
        try self.checkExtractSupport(entry, options.compressedData);
        needed := if options.compressedData then entry.compressedSize else entry.size;
        if needed > output.len { raise .OutputLimit; }
        if options.compressedData or entry.method == .store {
            self.readExactAt(payloadStart, output[..needed]) catch |e| {
                raise e;
            };
        } else {
            // Non-wrapping tinfl output uses the already-produced bytes as its
            // history dictionary, so the separate 32 KiB ring is unnecessary.
            state := Inflater.initWithWindow(entry.size, alloc, .{ ptr = null, len = 0 });
            defer state.deinit();
            state.directOutput = output[..needed];
            state.directFast = self.sourceRead == null;
            inputBuf : string = .{ ptr = null, len = 0 };
            inputOwned := false;
            inputLen := entry.compressedSize;
            inputPos := 0;
            sourceAt := entry.compressedSize;
            if self.sourceRead != null and entry.compressedSize > 0 {
                capacity := entry.compressedSize;
                if capacity > 65536 { capacity = 65536; }
                if readBuffer.ptr != null {
                    if readBuffer.len == 0 { raise .InvalidData; }
                    if capacity > readBuffer.len { capacity = readBuffer.len; }
                    inputBuf = .{ ptr = readBuffer.ptr, len = capacity };
                } else {
                    inputRaw := alloc.allocBytes(capacity);
                    if inputRaw == null { state.deinit(); raise .AllocationFailed; }
                    inputBuf = .{ ptr = inputRaw, len = capacity };
                    inputOwned = true;
                }
                inputLen = 0;
                sourceAt = 0;
            } else if entry.compressedSize > 0 {
                inputBuf = self.data[payloadStart..payloadStart + entry.compressedSize];
            }
            defer { if inputOwned and inputBuf.ptr != null { alloc.deallocBytes(inputBuf.ptr); } }
            outputAt := 0;
            while true {
                if inputPos == inputLen and sourceAt < entry.compressedSize {
                    inputLen = entry.compressedSize - sourceAt;
                    if inputLen > inputBuf.len { inputLen = inputBuf.len; }
                    self.readExactAt(payloadStart + sourceAt, string{ ptr = inputBuf.ptr, len = inputLen }) catch |e| {
                        state.deinit(); raise e;
                    };
                    sourceAt += inputLen;
                    inputPos = 0;
                }
                input : string = .{ ptr = null, len = 0 };
                if inputPos < inputLen { input = inputBuf[inputPos..inputLen]; }
                destination : string = .{ ptr = null, len = 0 };
                if outputAt < needed { destination = output[outputAt..needed]; }
                progress := state.step(input, destination) catch |e| {
                    state.deinit(); raise e;
                };
                inputPos += progress.consumed;
                outputAt += progress.produced;
                if progress.status == .done {
                    consumed := sourceAt - (inputLen - inputPos);
                    if outputAt != entry.size { state.deinit(); raise .InvalidData; }
                    if consumed != entry.compressedSize { state.deinit(); raise .InvalidData; }
                    break;
                }
                if progress.status == .needInput and inputPos == inputLen and sourceAt >= entry.compressedSize {
                    state.deinit(); raise .UnexpectedEnd;
                }
                if progress.status == .needOutput and outputAt >= needed {
                    // Permit a zero-output probe to consume the end-of-block
                    // code, but reject any stream which actually needs more
                    // destination bytes.
                    probeInput : string = .{ ptr = null, len = 0 };
                    if inputPos < inputLen { probeInput = inputBuf[inputPos..inputLen]; }
                    probe := state.step(probeInput, .{ ptr = null, len = 0 }) catch |e| {
                        state.deinit(); raise e;
                    };
                    inputPos += probe.consumed;
                    if probe.status != .done { state.deinit(); raise .OutputLimit; }
                    consumed := sourceAt - (inputLen - inputPos);
                    if consumed != entry.compressedSize { state.deinit(); raise .InvalidData; }
                    break;
                }
            }
        }
        if !options.compressedData and !options.skipCrc and crc32(output[..entry.size]) != entry.crc {
            raise .ChecksumMismatch;
        }
        needed
    }

    validateEntry :: (self: *ZipReader, index: i64, headersOnly: bool = false, skipCrc: bool = false, alloc: Allocator = context.allocator) -> !Error {
        entry := try self.entry(index);
        try self.checkValidationSupport(entry);
        at := self.archiveStart + entry.localOffset;
        localHeader : [30]u8 = ---;
        self.readExactAt(at, string{ ptr = *localHeader[0], len = localHeader.len }) catch |e| {
            raise e;
        };
        header := string{ ptr = *localHeader[0], len = localHeader.len };
        if (le32(header, 0) catch |e| 0) != 0x04034b50 {
            raise .InvalidData;
        }
        localNameLen := le16(header, 26) catch |e| {
            raise e;
        };
        localExtraLen := le16(header, 28) catch |e| {
            raise e;
        };
        payloadStart := at + 30 + localNameLen + localExtraLen;
        if localNameLen != entry.name.len or payloadStart < at or payloadStart > self.sourceSize or entry.compressedSize > self.sourceSize - payloadStart {
            raise .InvalidData;
        }
        nameBuf : [4096]u8 = ---;
        nameAt := 0;
        while nameAt < localNameLen {
            take := localNameLen - nameAt;
            if take > nameBuf.len { take = nameBuf.len; }
            self.readExactAt(at + 30 + nameAt, string{ ptr = *nameBuf[0], len = take }) catch |e| {
                raise e;
            };
            i := 0;
            while i < take {
                if nameBuf[i] != entry.name[nameAt + i] { raise .InvalidData; }
                i += 1;
            }
            nameAt += take;
        }

        localFlags := le16(header, 6) catch |e| 0;
        localCrc := le32(header, 14) catch |e| 0;
        localCompressedRaw := le32(header, 18) catch |e| 0;
        localSizeRaw := le32(header, 22) catch |e| 0;
        localCompressed := localCompressedRaw;
        localSize := localSizeRaw;
        localHasZip64 := false;
        if localExtraLen > 0 and (localCompressedRaw == 0xffffffff or localSizeRaw == 0xffffffff) {
            extraRaw := alloc.allocBytes(localExtraLen);
            if extraRaw == null { raise .AllocationFailed; }
            localExtra := string{ ptr = extraRaw, len = localExtraLen };
            self.readExactAt(at + 30 + localNameLen, localExtra) catch |e| {
                alloc.deallocBytes(extraRaw); raise e;
            };
            resolvedCompressed, resolvedSize, ignoredOffset, ignoredDisk := zip64Values(localExtra, localCompressedRaw, localSizeRaw, 0, 0) catch |e| {
                alloc.deallocBytes(extraRaw);

                raise e;
            };
            localCompressed = resolvedCompressed;
            localSize = resolvedSize;
            localHasZip64 = zipExtraHasField(localExtra, 1);
            alloc.deallocBytes(extraRaw);
        }

        if (localFlags & 8) != 0 and localCompressed == 0 and localCrc == 0 {
            descriptorAt := payloadStart + entry.compressedSize;
            // ZIP64 is an archive/container property. A forced ZIP32-to-ZIP64
            // upgrade leaves existing local records and their 32-bit data
            // descriptors untouched, so descriptor width must come from this
            // record rather than from the EOCD form.
            wide := localCompressedRaw == 0xffffffff or localSizeRaw == 0xffffffff or
                    entry.compressedSize >= 0xffffffff or entry.size >= 0xffffffff or
                    localHasZip64;
            descriptorSize := if wide then 20 else 12;
            descriptor : [24]u8 = ---;
            firstSize := 4;
            self.readExactAt(descriptorAt, string{ ptr = *descriptor[0], len = firstSize }) catch |e| {
                raise e;
            };
            descriptorBytes := string{ ptr = *descriptor[0], len = descriptor.len };
            if (le32(descriptorBytes, 0) catch |e| 0) == 0x08074b50 {
                descriptorAt += 4;
            }
            if descriptorAt < 0 or descriptorAt > self.sourceSize or descriptorSize > self.sourceSize - descriptorAt {
                raise .Io;
            }
            self.readExactAt(descriptorAt, string{ ptr = *descriptor[0], len = descriptorSize }) catch |e| {
                raise e;
            };
            descriptorCrc := le32(descriptorBytes, 0) catch |e| 0;
            descriptorCompressed := if wide then (le64(descriptorBytes, 4) catch |e| -1) else (le32(descriptorBytes, 4) catch |e| -1);
            descriptorSizeValue := if wide then (le64(descriptorBytes, 12) catch |e| -1) else (le32(descriptorBytes, 8) catch |e| -1);
            if descriptorCrc != entry.crc or descriptorCompressed != entry.compressedSize or descriptorSizeValue != entry.size {
                raise .InvalidData;
            }
        } else if localCrc != entry.crc or localCompressed != entry.compressedSize or localSize != entry.size {
            raise .InvalidData;
        }
        if headersOnly { return; }
        discard := ZipExtractSink{ ctx = null, write = zipDiscardOutput };
        made := try zipExtractToOutput(self, index, discard, ZipExtractOptions{ skipCrc = skipCrc }, entry.size, alloc);
        if made != entry.size {
            raise .InvalidData;
        }
    }

    validate :: (self: *ZipReader, headersOnly: bool = false, alloc: Allocator = context.allocator) -> !Error {
        i := 0;
        while i < self.count {
            try self.validateEntry(i, headersOnly, false, alloc);
            i += 1;
        }
    }
}

// Free-function constructor is the canonical module entry point. Keeping the
// constructor at module scope also reads naturally once this becomes
// `zip.open(...)` in the stdlib; `ZipReader.init` remains available to flat
// importers and internal code.
openZip :: (data: string) -> (ZipReader, !Error) {
    ZipReader.init(data)
}

openZipEmbedded :: (data: string) -> (ZipReader, !Error) {
    ZipReader.initEmbedded(data)
}

private ZipFileReadState :: struct {
    file: File;
    start: i64;
    ownsFile: bool;
    writable: bool = false;
    writeBase: i64 = 0;
    writePosition: i64 = 0;
}

private zipFileSourceRead :: (ctx: *void, offset: i64, output: string) -> i64 {
    state : *ZipFileReadState = ctx.(*ZipFileReadState);
    file := *state.file;
    absolute := state.start + offset;
    if absolute < state.start or file.seek(absolute, .set) != absolute { return 0; }
    file.read(output)
}

private zipFileUpdateTruncate :: (ctx: *void, len: i64) -> bool {
    state : *ZipFileReadState = ctx.(*ZipFileReadState);
    if len < 0 or len > state.writePosition { return false; }
    file := *state.file;
    // The tail beyond the rollback point is either the failed record or the
    // stale original central directory — finish() rewrites the directory at
    // the new end either way, so cutting the physical tail is safe.
    if !file.truncate(state.writeBase + len) { return false; }
    state.writePosition = len;
    true
}

private zipFileUpdateWrite :: (ctx: *void, data: string) -> bool {
    state : *ZipFileReadState = ctx.(*ZipFileReadState);
    file := *state.file;
    absolute := state.writeBase + state.writePosition;
    if absolute < state.writeBase or file.seek(absolute, .set) != absolute { return false; }
    at := 0;
    while at < data.len {
        made := file.write(data[at..]);
        if made <= 0 or made > data.len - at { return false; }
        at += made;
    }
    state.writePosition += data.len;
    true
}

private zipFileUpdateWriteAt :: (ctx: *void, offset: i64, data: string) -> bool {
    state : *ZipFileReadState = ctx.(*ZipFileReadState);
    file := *state.file;
    absolute := state.writeBase + offset;
    if offset < 0 or absolute < state.writeBase or file.seek(absolute, .set) != absolute { return false; }
    at := 0;
    while at < data.len {
        made := file.write(data[at..]);
        if made <= 0 or made > data.len - at { return false; }
        at += made;
    }
    true
}

private zipFileUpdateReadAt :: (ctx: *void, offset: i64, output: string) -> i64 {
    state : *ZipFileReadState = ctx.(*ZipFileReadState);
    file := *state.file;
    absolute := state.writeBase + offset;
    if offset < 0 or absolute < state.writeBase or file.seek(absolute, .set) != absolute { return -1; }
    file.read(output)
}

OwnedZipReader :: struct {
    reader: ZipReader;
    bytes: string;
    alloc: Allocator;
    fileState: *ZipFileReadState = null;

    end :: (self: *OwnedZipReader) -> bool {
        readerOk := self.reader.end();
        closeOk := true;
        if self.bytes.ptr != null { self.alloc.deallocBytes(self.bytes.ptr); }
        if self.fileState != null {
            if self.fileState.ownsFile and !self.fileState.file.close() {
                closeOk = false;
            }
            self.alloc.deallocBytes(self.fileState);
        }
        self.bytes.ptr = null;
        self.bytes.len = 0;
        self.reader.data = "";
        self.fileState = null;
        readerOk and closeOk
    }

    deinit :: (self: *OwnedZipReader) {
        self.end();
    }
}

openZipSource :: (source: ZipReadSource, detectPrefix: bool = true, alloc: Allocator = context.allocator, maxMetadata: i64 = 67108864) -> (OwnedZipReader, !Error) {
    if source.read == null or source.size < 22 or maxMetadata < 0 { raise .InvalidData; }

    // Match upstream's backward EOCD search: overlapping 4 KiB reads, capped
    // at the format's 65,535-byte comment window.
    scanBuf : [4096]u8 = ---;
    current := source.size - scanBuf.len;
    if current < 0 { current = 0; }
    found := -1;
    searching := true;
    while searching {
        amount := source.size - current;
        if amount > scanBuf.len { amount = scanBuf.len; }
        window := string{ ptr = *scanBuf[0], len = amount };
        zipSourceReadExact(source, current, window) catch |e| { raise .InvalidData; };
        i := amount - 4;
        while i >= 0 {
            if ((le32(window, i) catch |e| 0) == 0x06054b50 and source.size - (current + i) >= 22) {
                found = current + i;
                break;
            }
            i -= 1;
        }
        if found >= 0 { searching = false; }
        else if current == 0 or source.size - current >= 65557 { searching = false; }
        else {
            next := current - (scanBuf.len - 3);
            if next < 0 { next = 0; }
            current = next;
        }
    }
    if found < 0 { raise .InvalidData; }
    eocd : [22]u8 = ---;
    try zipSourceReadExact(source, found, string{ ptr = *eocd[0], len = eocd.len });
    eocdBytes := string{ ptr = *eocd[0], len = eocd.len };
    if (try le32(eocdBytes, 0)) != 0x06054b50 { raise .InvalidData; }
    disk := try le16(eocdBytes, 4);
    centralDisk := try le16(eocdBytes, 6);
    diskCount := try le16(eocdBytes, 8);
    count := try le16(eocdBytes, 10);
    centralSize := try le32(eocdBytes, 12);
    centralRelative := try le32(eocdBytes, 16);
    commentLen := try le16(eocdBytes, 20);
    if found + 22 + commentLen > source.size { raise .InvalidData; }
    isZip64 := false;

    locator : [20]u8 = ---;
    hasLocator := false;
    if found >= 20 {
        zipSourceReadExact(source, found - 20, string{ ptr = *locator[0], len = locator.len }) catch |e| {};
        hasLocator = (le32(string{ ptr = *locator[0], len = locator.len }, 0) catch |e| 0) == 0x07064b50;
    }
    if hasLocator {
        isZip64 = true;
        locatorBytes := string{ ptr = *locator[0], len = locator.len };
        // The pinned miniz reader does not inspect the locator's
        // disk-with-EOCD64 field. Preserve that quirk for callback/file
        // readers as well as memory readers.
        if (try le32(locatorBytes, 16)) != 1 {
            raise .Unsupported;
        }
        zip64At := found - 76;
        locatorOffset := try le64(locatorBytes, 8);
        zip64Header : [56]u8 = ---;
        candidateOk := false;
        if zip64At >= 0 {
            zipSourceReadExact(source, zip64At, string{ ptr = *zip64Header[0], len = zip64Header.len }) catch |e| {};
            candidateOk = (le32(string{ ptr = *zip64Header[0], len = zip64Header.len }, 0) catch |e| 0) == 0x06064b50;
        }
        if !candidateOk {
            zip64At = locatorOffset;
            zipSourceReadExact(source, zip64At, string{ ptr = *zip64Header[0], len = zip64Header.len }) catch |e| {
                raise e;
            };
        }
        wide := string{ ptr = *zip64Header[0], len = zip64Header.len };
        if (try le32(wide, 0)) != 0x06064b50 or (try le64(wide, 4)) < 44 or zip64At + 56 > found - 20 {
            raise .InvalidData;
        }
        disk = try le32(wide, 16);
        centralDisk = try le32(wide, 20);
        diskCount = try le64(wide, 24);
        count = try le64(wide, 32);
        centralSize = try le64(wide, 40);
        centralRelative = try le64(wide, 48);
        if count > 0xffffffff { raise .TooLarge; }
        if centralSize > 0xffffffff { raise .TooLarge; }
    } else if count == 0xffff or centralSize == 0xffffffff or centralRelative == 0xffffffff {
        raise .InvalidData;
    }
    if disk != 0 or centralDisk != 0 or diskCount != count {
        raise .Unsupported;
    }

    archiveStart := 0;
    if detectPrefix {
        tailRecordSize := if isZip64 then 76 else 0;
        relativeEnd := centralRelative + centralSize + tailRecordSize;
        if centralRelative < 0 or centralSize < 0 or relativeEnd < centralRelative or relativeEnd > found {
            raise .InvalidData;
        }
        archiveStart = found - relativeEnd;
    }
    centralAbsolute := archiveStart + centralRelative;
    if centralSize < count * 46 or centralAbsolute < 0 or centralAbsolute > source.size or
       centralSize > source.size - centralAbsolute or centralAbsolute + centralSize > found or
       centralSize > i64.max - commentLen {
        raise .InvalidData;
    }
    metadataSize := centralSize + commentLen;
    if metadataSize > maxMetadata { raise .OutputLimit; }

    raw := alloc.allocBytes(metadataSize);
    if metadataSize > 0 and raw == null { raise .AllocationFailed; }
    bytes := string{ ptr = raw, len = metadataSize };
    zipSourceReadExact(source, centralAbsolute, bytes[..centralSize]) catch |e| {
        if raw != null { alloc.deallocBytes(raw); } raise e;
    };
    if commentLen > 0 {
        zipSourceReadExact(source, found + 22, bytes[centralSize..centralSize + commentLen]) catch |e| {
            if raw != null { alloc.deallocBytes(raw); } raise e;
        };
    }

    scan := 0;
    n := 0;
    while n < count {
        if scan + 46 > centralSize or (try le32(bytes, scan)) != 0x02014b50 {
            alloc.deallocBytes(raw); raise .InvalidData;
        }
        flags := try le16(bytes, scan + 8);
        method := try le16(bytes, scan + 10);
        compressedSize := try le32(bytes, scan + 20);
        size := try le32(bytes, scan + 24);
        nameLen := try le16(bytes, scan + 28);
        extraLen := try le16(bytes, scan + 30);
        entryCommentLen := try le16(bytes, scan + 32);
        diskStart := try le16(bytes, scan + 34);
        localOffset := try le32(bytes, scan + 42);
        next := scan + 46 + nameLen + extraLen + entryCommentLen;
        if next > centralSize { alloc.deallocBytes(raw); raise .InvalidData; }
        if compressedSize == 0xffffffff or size == 0xffffffff or localOffset == 0xffffffff {
            extra := bytes[scan + 46 + nameLen..scan + 46 + nameLen + extraLen];
            extraAt := 0;
            while extraAt < extra.len {
                if extraAt + 4 > extra.len { alloc.deallocBytes(raw); raise .InvalidData; }
                fieldId := try le16(extra, extraAt);
                fieldSize := try le16(extra, extraAt + 2);
                if fieldSize > extra.len - extraAt - 4 { alloc.deallocBytes(raw); raise .InvalidData; }
                if fieldId == 1 { isZip64 = true; break; }
                extraAt += 4 + fieldSize;
            }
        }
        if compressedSize != 0xffffffff and size != 0xffffffff {
            if (method == 0 and size != compressedSize) or (size != 0 and compressedSize == 0) {
                alloc.deallocBytes(raw); raise .InvalidData;
            }
        }
        if diskStart == 0xffff or (diskStart != disk and diskStart != 1) {
            alloc.deallocBytes(raw); raise .Unsupported;
        }
        if compressedSize != 0xffffffff and
           (localOffset > source.size or archiveStart > source.size - localOffset or
            compressedSize > source.size - archiveStart - localOffset or
            30 > source.size - archiveStart - localOffset - compressedSize) {
            alloc.deallocBytes(raw); raise .InvalidData;
        }
        if (flags & 0x2000) != 0 { alloc.deallocBytes(raw); raise .Unsupported; }
        scan = next;
        n += 1;
    }

    reader := ZipReader{
        data = bytes,
        centralOffset = 0,
        centralRelativeOffset = centralRelative,
        centralSize = centralSize,
        count = count,
        comment = bytes[centralSize..centralSize + commentLen],
        zip64 = isZip64,
        archiveStart = archiveStart,
        archiveSize = source.size - archiveStart,
        active = true,
        sourceCtx = source.ctx,
        sourceRead = source.read,
        sourceSize = source.size,
    };
    OwnedZipReader{ reader = reader, bytes = bytes, alloc = alloc }
}

openZipFile :: (path: [:0]u8, start: i64 = 0, size: i64 = 0, alloc: Allocator = context.allocator, maxMetadata: i64 = 67108864) -> (OwnedZipReader, !Error) {
    openZipFileMode(path, start, size, false, alloc, maxMetadata)
}

// MZ_ZIP_FLAG_READ_ALLOW_WRITING: open the backing file read/write up front so
// reader-to-writer conversion does not need to close and reopen it.
openZipFileWritable :: (path: [:0]u8, start: i64 = 0, size: i64 = 0, alloc: Allocator = context.allocator, maxMetadata: i64 = 67108864) -> (OwnedZipReader, !Error) {
    openZipFileMode(path, start, size, true, alloc, maxMetadata)
}

private openZipFileMode :: (path: [:0]u8, start: i64, size: i64, writable: bool, alloc: Allocator, maxMetadata: i64 = 67108864) -> (OwnedZipReader, !Error) {
    if start < 0 or size < 0 or (size > 0 and size < 22) or maxMetadata < 0 {
        raise .InvalidData;
    }
    maybeFile := if writable then openFile(path, .readWrite) else openFile(path, .read);
    if maybeFile == null { raise .Io; }
    file : File = maybeFile;
    actualSize := size;
    if actualSize == 0 {
        // mz_zip_reader_init_file_v2() uses the complete physical file size
        // here even when file_start_ofs is nonzero. Reads add `start` later.
        actualSize = file.seek(0, .end);
        if actualSize < 0 { file.close(); raise .Io; }
        if actualSize < 22 { file.close(); raise .InvalidData; }
    }
    stateRaw := alloc.allocBytes(@sizeOf(ZipFileReadState));
    if stateRaw == null { file.close(); raise .AllocationFailed; }
    state : *ZipFileReadState = stateRaw.(*ZipFileReadState);
    state.* = ZipFileReadState{ file = file, start = start, ownsFile = true, writable = writable };
    source := ZipReadSource{ ctx = state, size = actualSize, read = zipFileSourceRead };
    owned := openZipSource(source, start == 0, alloc, maxMetadata) catch |e| {
        state.file.close(); alloc.deallocBytes(stateRaw); raise e;
    };
    owned.fileState = state;
    state.writeBase = start + owned.reader.archiveStart;
    owned
}

private ZipExtractSink :: struct {
    ctx: *void;
    write: (*void, string) -> bool;
}

private zipDiscardOutput :: (ctx: *void, data: string) -> bool { true }

zipExtractToOutput :: (reader: *ZipReader, index: i64, sink: ZipExtractSink, options: ZipExtractOptions = .{}, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (i64, !Error) {
    if sink.write == null {
        raise .InvalidData;
    }
    entry, payloadStart := try reader.payloadInfo(index);
    try reader.checkExtractSupport(entry, options.compressedData);
    expected := if options.compressedData then entry.compressedSize else entry.size;
    if expected > maxOutput { raise .OutputLimit; }
    if options.compressedData or entry.method == .store {
        at := 0;
        checksum := 0;
        scratch : [65536]u8 = ---;
        while at < entry.compressedSize {
            take := entry.compressedSize - at;
            if take > scratch.len { take = scratch.len; }
            chunk := string{ ptr = *scratch[0], len = take };
            reader.readExactAt(payloadStart + at, chunk) catch |e| {
                raise e;
            };
            if !options.compressedData and !options.skipCrc { checksum = crc32(chunk, checksum); }
            if !sink.write(sink.ctx, chunk) { raise .Io; }
            at += take;
        }
        if !options.compressedData and !options.skipCrc and checksum != entry.crc { raise .ChecksumMismatch; }
        return expected;
    }

    state := Inflater.init(entry.size, alloc);
    defer state.deinit();
    if state.window.ptr == null { raise .AllocationFailed; }
    scratch : [32768]u8 = ---;
    inputBuf : string = .{ ptr = null, len = 0 };
    inputOwned := false;
    inputLen := entry.compressedSize;
    inputPos := 0;
    sourceAt := entry.compressedSize;
    if reader.sourceRead != null and entry.compressedSize > 0 {
        capacity := entry.compressedSize;
        if capacity > 65536 { capacity = 65536; }
        inputRaw := alloc.allocBytes(capacity);
        if inputRaw == null { state.deinit(); raise .AllocationFailed; }
        inputBuf = .{ ptr = inputRaw, len = capacity };
        inputOwned = true;
        inputLen = 0;
        sourceAt = 0;
    } else if entry.compressedSize > 0 {
        inputBuf = reader.data[payloadStart..payloadStart + entry.compressedSize];
    }
    defer { if inputOwned and inputBuf.ptr != null { alloc.deallocBytes(inputBuf.ptr); } }
    total := 0;
    checksum := 0;
    while true {
        if inputPos == inputLen and sourceAt < entry.compressedSize {
            inputLen = entry.compressedSize - sourceAt;
            if inputLen > inputBuf.len { inputLen = inputBuf.len; }
            reader.readExactAt(payloadStart + sourceAt, string{ ptr = inputBuf.ptr, len = inputLen }) catch |e| {
                state.deinit(); raise e;
            };
            sourceAt += inputLen;
            inputPos = 0;
        }
        input : string = .{ ptr = null, len = 0 };
        if inputPos < inputLen { input = inputBuf[inputPos..inputLen]; }
        outputCapacity := scratch.len - (total & (scratch.len - 1));
        progress := state.step(input, string{ ptr = *scratch[0], len = outputCapacity }) catch |e| {
            state.deinit();
            raise e;
        };
        inputPos += progress.consumed;
        if progress.produced > 0 {
            made := string{ ptr = *scratch[0], len = progress.produced };
            if !options.skipCrc { checksum = crc32(made, checksum); }
            if !sink.write(sink.ctx, made) { state.deinit(); raise .Io; }
            total += progress.produced;
        }
        if progress.status == .done {
            consumed := sourceAt - (inputLen - inputPos);
            if total != entry.size { state.deinit(); raise .InvalidData; }
            if consumed != entry.compressedSize { state.deinit(); raise .InvalidData; }
            if !options.skipCrc and checksum != entry.crc { state.deinit(); raise .ChecksumMismatch; }
            return total;
        }
        if progress.status == .needInput and inputPos == inputLen and sourceAt >= entry.compressedSize { state.deinit(); raise .UnexpectedEnd; }
    }
    raise .InvalidData;
}

private ZipFileSinkState :: struct {
    file: *File;
}

private zipFileSinkWrite :: (ctx: *void, data: string) -> bool {
    state : *ZipFileSinkState = ctx.(*ZipFileSinkState);
    at := 0;
    while at < data.len {
        made := state.file.write(data[at..]);
        if made <= 0 or made > data.len - at { return false; }
        at += made;
    }
    true
}

private zipExtractToHandle :: (reader: *ZipReader, index: i64, file: *File, options: ZipExtractOptions = .{}, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (i64, !Error) {
    if !file.isValid() { raise .Io; }
    entry := reader.entry(index) catch |e| { raise e; };
    if entry.isDir() or !entry.isSupported() {
        raise .Unsupported;
    }
    state := ZipFileSinkState{ file = file };
    sink := ZipExtractSink{ ctx = *state, write = zipFileSinkWrite };
    zipExtractToOutput(reader, index, sink, options, maxOutput, alloc)
}

zipExtractToFile :: (reader: *ZipReader, index: i64, path: [:0]u8, options: ZipExtractOptions = .{}, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (i64, !Error) {
    entry := reader.entry(index) catch |e| { raise e; };
    if entry.isDir() or !entry.isSupported() {
        raise .Unsupported;
    }
    maybeFile := openFile(path, .write);
    if maybeFile == null { raise .Io; }
    file : File = maybeFile;
    made := zipExtractToHandle(reader, index, *file, options, maxOutput, alloc) catch |e| {
        file.close();
        raise e;
    };
    if !file.close() { raise .Io; }
    seconds, valid := zipDosTimeToUnix(entry.dosTime, entry.dosDate);
    if valid and !zipSetFileTime(path, seconds) {
        raise .Io;
    }
    made
}

private ZipExtractIterator :: struct {
    entry: ZipEntry;
    reader: *ZipReader;
    payloadStart: i64;
    inflater: Inflater;
    options: ZipExtractOptions;
    inputAt: i64;
    outputAt: i64;
    checksum: i64;
    done: bool;
    alloc: Allocator;
    inputBuf: string;
    ownsInput: bool;
    inputLen: i64;
    inputPos: i64;
    sourceAt: i64;
    eofRead: bool;
    failed: bool;
    readCalled: bool;

    init :: (reader: *ZipReader, index: i64, options: ZipExtractOptions = .{}, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (ZipExtractIterator, !Error) {
        entry, payloadStart := try reader.payloadInfo(index);
        try reader.checkExtractSupport(entry, options.compressedData);
        expected := if options.compressedData then entry.compressedSize else entry.size;
        if expected > maxOutput { raise .OutputLimit; }
        needsInflater := !options.compressedData and entry.method == .deflate and entry.size > 0;
        inflater := if needsInflater then Inflater.init(entry.size, alloc) else Inflater.initWithWindow(entry.size, alloc, .{ ptr = null, len = 0 });
        if needsInflater and inflater.window.ptr == null {
            inflater.deinit();
            raise .AllocationFailed;
        }
        inputBuf : string = .{ ptr = null, len = 0 };
        ownsInput := false;
        inputLen := 0;
        sourceAt := 0;
        if needsInflater and entry.compressedSize > 0 {
            if reader.sourceRead != null {
                capacity := entry.compressedSize;
                if capacity > 65536 { capacity = 65536; }
                inputRaw := alloc.allocBytes(capacity);
                if inputRaw == null {
                    inflater.deinit();
                    raise .AllocationFailed;
                }
                inputBuf = .{ ptr = inputRaw, len = capacity };
                ownsInput = true;
            } else {
                inputBuf = reader.data[payloadStart..payloadStart + entry.compressedSize];
                inputLen = entry.compressedSize;
                sourceAt = entry.compressedSize;
            }
        }
        ZipExtractIterator{
            entry = entry,
            reader = reader,
            payloadStart = payloadStart,
            inflater = inflater,
            options = options,
            inputAt = 0,
            outputAt = 0,
            checksum = 0,
            done = expected == 0,
            alloc = alloc,
            inputBuf = inputBuf,
            ownsInput = ownsInput,
            inputLen = inputLen,
            inputPos = 0,
            sourceAt = sourceAt,
            eofRead = false,
            failed = false,
            readCalled = false,
        }
    }

    read :: (self: *ZipExtractIterator, output: string) -> (i64, !Error) {
        self.readCalled = true;
        if self.done or output.len == 0 { return 0; }
        if self.options.compressedData or self.entry.method == .store {
            remaining := self.entry.compressedSize - self.outputAt;
            take := if remaining < output.len then remaining else output.len;
            self.reader.readExactAt(self.payloadStart + self.outputAt, output[..take]) catch |e| {
                self.failed = true; raise e;
            };
            if !self.options.compressedData and !self.options.skipCrc and take > 0 {
                self.checksum = crc32(output[..take], self.checksum);
            }
            self.inputAt += take;
            self.outputAt += take;
            if self.outputAt == self.entry.compressedSize {
                if self.reader.sourceRead != null and !self.eofRead {
                    made := self.reader.sourceRead(self.reader.sourceCtx, self.payloadStart + self.outputAt, .{ ptr = null, len = 0 });
                    if made != 0 { self.failed = true; raise .Io; }
                    self.eofRead = true;
                }
                self.done = true;
            }
            return take;
        }

        while true {
            if self.inputPos == self.inputLen and self.sourceAt < self.entry.compressedSize {
                self.inputLen = self.entry.compressedSize - self.sourceAt;
                if self.inputLen > self.inputBuf.len { self.inputLen = self.inputBuf.len; }
                self.reader.readExactAt(self.payloadStart + self.sourceAt, string{ ptr = self.inputBuf.ptr, len = self.inputLen }) catch |e| {
                    self.failed = true; raise e;
                };
                self.sourceAt += self.inputLen;
                self.inputPos = 0;
            }
            if self.reader.sourceRead != null and !self.eofRead and self.inputPos == self.inputLen and self.sourceAt >= self.entry.compressedSize {
                made := self.reader.sourceRead(self.reader.sourceCtx, self.payloadStart + self.sourceAt, .{ ptr = null, len = 0 });
                if made != 0 { self.failed = true; raise .Io; }
                self.eofRead = true;
            }
            input : string = .{ ptr = null, len = 0 };
            if self.inputPos < self.inputLen { input = self.inputBuf[self.inputPos..self.inputLen]; }
            progress := self.inflater.step(input, output) catch |e| {
                self.failed = true;
                raise e;
            };
            self.inputPos += progress.consumed;
            self.inputAt += progress.consumed;
            self.outputAt += progress.produced;
            if !self.options.skipCrc and progress.produced > 0 {
                self.checksum = crc32(output[..progress.produced], self.checksum);
            }
            if progress.status == .done {
                if self.reader.sourceRead != null and !self.eofRead {
                    made := self.reader.sourceRead(self.reader.sourceCtx, self.payloadStart + self.sourceAt, .{ ptr = null, len = 0 });
                    if made != 0 { self.failed = true; raise .Io; }
                    self.eofRead = true;
                }
                if self.outputAt != self.entry.size { self.failed = true; raise .InvalidData; }
                if self.inputAt != self.entry.compressedSize { self.failed = true; raise .InvalidData; }
                self.done = true;
                return progress.produced;
            }
            if progress.status == .needInput and self.inputPos == self.inputLen and self.sourceAt >= self.entry.compressedSize {
                self.failed = true;
                raise .UnexpectedEnd;
            }
            if progress.produced > 0 { return progress.produced; }
        }
        0
    }

    deinit :: (self: *ZipExtractIterator) {
        self.inflater.deinit();
        if self.ownsInput and self.inputBuf.ptr != null { self.alloc.deallocBytes(self.inputBuf.ptr); }
        self.inputBuf = "";
        self.ownsInput = false;
        self.done = true;
    }

    finish :: (self: *ZipExtractIterator) -> !Error {
        failure : ?Error = null;
        if self.failed or !self.done {
            failure = .InvalidData;
        } else if !self.options.compressedData {
            if self.outputAt != self.entry.size {
                failure = .InvalidData;
            } else if !self.options.skipCrc and self.checksum != self.entry.crc {
                failure = .ChecksumMismatch;
            }
        }
        self.deinit();
        if failure != null { raise failure; }
    }
}

ZipSeekExtractor :: struct {
    reader: *ZipReader;
    index: i64;
    options: ZipExtractOptions;
    iterator: ZipExtractIterator;
    size: i64;
    alloc: Allocator;
    active: bool;

    init :: (reader: *ZipReader, index: i64, options: ZipExtractOptions = .{}, maxOutput: i64 = 1073741824, alloc: Allocator = context.allocator) -> (ZipSeekExtractor, !Error) {
        iterator := try ZipExtractIterator.init(reader, index, options, maxOutput, alloc);
        size := if options.compressedData then iterator.entry.compressedSize else iterator.entry.size;
        ZipSeekExtractor{ reader = reader, index = index, options = options, iterator = iterator, size = size, alloc = alloc, active = true }
    }

    offset :: (self: *ZipSeekExtractor) -> i64 { self.iterator.outputAt }

    seek :: (self: *ZipSeekExtractor, target: i64) -> !Error {
        if !self.active or target < 0 or target > self.size {
            raise .InvalidData;
        }
        if target < self.iterator.outputAt {
            self.iterator.deinit();
            self.iterator = try ZipExtractIterator.init(self.reader, self.index, self.options, self.size, self.alloc);
        }
        scratch : [4096]u8 = ---;
        while self.iterator.outputAt < target {
            take := target - self.iterator.outputAt;
            if take > scratch.len { take = scratch.len; }
            made := try self.iterator.read(string{ ptr = *scratch[0], len = take });
            if made == 0 { raise .UnexpectedEnd; }
        }
    }

    read :: (self: *ZipSeekExtractor, output: string) -> (i64, !Error) {
        if !self.active { raise .Finished; }
        self.iterator.read(output)
    }

    end :: (self: *ZipSeekExtractor) -> !Error {
        if !self.active { return; }
        self.active = false;
        try self.iterator.finish();
    }

    deinit :: (self: *ZipSeekExtractor) {
        if self.active { self.iterator.deinit(); self.active = false; }
    }
}

// -----------------------------------------------------------------------------
// ZIP32/ZIP64 writer

private ZipWriterEntry :: struct {
    nameOffset: i64;
    nameLen: i64;
    method: ZipMethod;
    methodValue: i64;
    flags: i64;
    crc: i64;
    compressedSize: i64;
    size: i64;
    localOffset: i64;
    extraOffset: i64;
    extraLen: i64;
    commentOffset: i64;
    commentLen: i64;
    dosTime: i64;
    dosDate: i64;
    externalAttributes: i64;
    internalAttributes: i64;
    versionMadeBy: i64;
    versionNeeded: i64;
    zip64Size: bool;
    zip64Compressed: bool;
    zip64Offset: bool;
}

private zipEntriesReserve :: (entries: *List(ZipWriterEntry), needed: i64, alloc: Allocator) -> bool {
    if needed < 0 { return false; }
    if entries.cap >= needed { return true; }
    newCap := if entries.cap == 0 then 4 else entries.cap;
    while newCap < needed {
        if newCap > i64.max / 2 { return false; }
        newCap *= 2;
    }
    if newCap > i64.max / @sizeOf(ZipWriterEntry) { return false; }
    raw := alloc.allocBytes(newCap * @sizeOf(ZipWriterEntry));
    if raw == null { return false; }
    newPtr : [*]ZipWriterEntry = raw.([*]ZipWriterEntry);
    if entries.items.len > 0 {
        c.memcpy(newPtr, entries.items.ptr, entries.items.len * @sizeOf(ZipWriterEntry));
    }
    if entries.cap > 0 { alloc.deallocBytes(entries.items.ptr); }
    entries.items.ptr = newPtr;
    entries.cap = newCap;
    true
}

private zipEntriesAppendReserved :: (entries: *List(ZipWriterEntry), entry: ZipWriterEntry) {
    entries.items.ptr[entries.items.len] = entry;
    entries.items.len += 1;
}

private ZipTimeMode :: enum { none; specified; file; }

private zipFileModifiedSeconds :: (file: *File) -> (i64, bool) {
    modifiedSeconds(file)
}

// DOS timestamps are LOCAL civil time; std.time owns the libc `struct tm`
// boundary, this module only packs/unpacks the DOS bitfields. The `.none`
// mode represents a MINIZ_NO_TIME build.
zipUnixTimeToDos :: (seconds: i64) -> (i64, i64, bool) {
    civil, valid := time.localCivil(seconds);
    if !valid { return 0, 0, false; }
    if civil.year < 1980 or civil.year > 2107 or civil.month < 1 or civil.month > 12 or
       civil.day < 1 or civil.day > 31 or civil.hour < 0 or civil.hour > 23 or
       civil.minute < 0 or civil.minute > 59 or civil.second < 0 or civil.second > 59 {
        return 0, 0, false;
    }
    dosTime := (civil.hour << 11) + (civil.minute << 5) + (civil.second >> 1);
    dosDate := ((civil.year - 1980) << 9) + (civil.month << 5) + civil.day;
    return dosTime, dosDate, true;
}

zipDosTimeToUnix :: (dosTime: i64, dosDate: i64) -> (i64, bool) {
    civil := time.CivilTime{year = ((dosDate >> 9) & 127) + 1980,
        month = (dosDate >> 5) & 15,
        day = dosDate & 31,
        hour = (dosTime >> 11) & 31,
        minute = (dosTime >> 5) & 63,
        second = (dosTime << 1) & 62,
    };
    return time.localEpoch(civil);
}

zipSetFileTime :: (path: [:0]u8, seconds: i64) -> bool {
    setModifiedSeconds(path, seconds)
}

private zipResolveDosTime :: (options: ZipEntryOptions) -> (i64, i64, !Error) {
    if options.timeMode == .none { return options.dosTime, options.dosDate; }
    // `.file` is resolved by the file/handle adapters before reaching here.
    if options.timeMode == .file { raise .InvalidOptions; }
    dosTime, dosDate, valid := zipUnixTimeToDos(options.modifiedUnixSeconds);
    if !valid { raise .InvalidOptions; }
    return dosTime, dosDate;
}

ZipEntryOptions :: struct {
    method: ZipMethod = .deflate;
    level: i64 = 6;
    extra: string = "";
    centralExtra: string = "";
    separateCentralExtra: bool = false;
    comment: string = "";
    dosTime: i64 = 0;
    dosDate: i64 = 0;
    externalAttributes: i64 = 0;
    asciiFilename: bool = false;
    dataDescriptor: bool = true;
    // The read-callback/CFILE writer emits a descriptor even for an empty
    // source; the memory writer does not. File adapters set this internally.
    descriptorForEmpty: bool = false;
    autoStoreSmall: bool = true;
    timeMode: ZipTimeMode = .none;
    modifiedUnixSeconds: i64 = 0;
    // Used only by addFile(). It defaults to upstream's normal stdio build;
    // set false together with `.none` to model MINIZ_NO_TIME.
    useFileTime: bool = true;
}

private zipAlignmentPadding :: (offset: i64, alignment: i64) -> i64 {
    if alignment <= 1 { return 0; }
    (alignment - (offset & (alignment - 1))) & (alignment - 1)
}

ZipSink :: struct {
    ctx: *void;
    write: (*void, string) -> bool;
    writeAt: (*void, i64, string) -> bool = null;
    readAt: (*void, i64, string) -> i64 = null;
    // Stateful stdio writers flush after the EOCD. A failed flush is reported
    // as FILE_CLOSE_FAILED by upstream, whatever the failure actually was.
    flush: (*void) -> bool = null;
    // Optional physical rollback: shrink accepted output to exactly `len`
    // writer-logical bytes. Backends that can un-emit (memory, files)
    // provide it so a failed record transfer truly disappears; a borrowed
    // streaming sink cannot, and its writer is poisoned instead.
    truncate: (*void, i64) -> bool = null;
}

ZipInputSource :: struct {
    ctx: *void;
    size: i64;
    read: (*void, i64, string) -> i64;
}

private ZipFileInputState :: struct {
    file: *File;
    start: i64;
}

private zipFileInputRead :: (ctx: *void, offset: i64, output: string) -> i64 {
    state : *ZipFileInputState = ctx.(*ZipFileInputState);
    if offset < 0 or state.file.seek(state.start + offset, .set) != state.start + offset { return 0; }
    made := state.file.read(output);
    if made < 0 then 0 else made
}

private ZipFileWriteState :: struct {
    file: File;
    start: i64;
    position: i64 = 0;
    ownsFile: bool;
    buffered: bool = false;
    buffer: [4096]u8 = .{};
    bufferLen: i64 = 0;
}

private zipFileWriteHandle :: (state: *ZipFileWriteState) -> *File {
    *state.file
}

private zipWriterFileFlushBuffer :: (state: *ZipFileWriteState) -> bool {
    if state.bufferLen == 0 { return true; }
    file := zipFileWriteHandle(state);
    desired := state.start + state.position - state.bufferLen;
    if desired < state.start or file.seek(desired, .set) != desired { return false; }
    at := 0;
    while at < state.bufferLen {
        made := file.write(string{ ptr = *state.buffer[at], len = state.bufferLen - at });
        if made <= 0 or made > state.bufferLen - at {
            if at > 0 {
                remaining := state.bufferLen - at;
                i := 0; while i < remaining { state.buffer[i] = state.buffer[at + i]; i += 1; }
                state.bufferLen = remaining;
            }
            return false;
        }
        at += made;
    }
    state.bufferLen = 0;
    true
}

private zipWriterFileSinkTruncate :: (ctx: *void, len: i64) -> bool {
    state : *ZipFileWriteState = ctx.(*ZipFileWriteState);
    if len < 0 or len > state.position { return false; }
    cut := state.position - len;
    if state.buffered and cut <= state.bufferLen {
        // The excess never reached the disk — drop it from the buffer.
        state.bufferLen -= cut;
        state.position = len;
        return true;
    }
    if state.buffered and !zipWriterFileFlushBuffer(state) { return false; }
    file := zipFileWriteHandle(state);
    if !file.truncate(state.start + len) { return false; }
    state.position = len;
    true
}

private zipWriterFileSinkWrite :: (ctx: *void, data: string) -> bool {
    state : *ZipFileWriteState = ctx.(*ZipFileWriteState);
    if state.buffered {
        at := 0;
        while at < data.len {
            room := state.buffer.len - state.bufferLen;
            take := data.len - at; if take > room { take = room; }
            i := 0; while i < take { state.buffer[state.bufferLen + i] = data[at + i]; i += 1; }
            state.bufferLen += take; state.position += take; at += take;
            if state.bufferLen == state.buffer.len and !zipWriterFileFlushBuffer(state) { return false; }
        }
        return true;
    }
    file := zipFileWriteHandle(state);
    absolute := state.start + state.position;
    if absolute < state.start or file.seek(absolute, .set) != absolute { return false; }
    at := 0;
    while at < data.len {
        made := file.write(data[at..]);
        if made <= 0 or made > data.len - at { return false; }
        at += made;
    }
    state.position += data.len;
    true
}

zipWriterFileSinkWriteAt :: (ctx: *void, offset: i64, data: string) -> bool {
    state : *ZipFileWriteState = ctx.(*ZipFileWriteState);
    if state.buffered and !zipWriterFileFlushBuffer(state) { return false; }
    if offset < 0 or state.start > i64.max - offset { return false; }
    file := zipFileWriteHandle(state);
    absolute := state.start + offset;
    if file.seek(absolute, .set) != absolute { return false; }
    at := 0;
    while at < data.len {
        made := file.write(data[at..]);
        if made <= 0 or made > data.len - at { return false; }
        at += made;
    }
    true
}

zipWriterFileSinkReadAt :: (ctx: *void, offset: i64, output: string) -> i64 {
    state : *ZipFileWriteState = ctx.(*ZipFileWriteState);
    if state.buffered and !zipWriterFileFlushBuffer(state) { return -1; }
    if offset < 0 or state.start > i64.max - offset { return -1; }
    file := zipFileWriteHandle(state);
    absolute := state.start + offset;
    if file.seek(absolute, .set) != absolute { return -1; }
    at := 0;
    while at < output.len {
        made := file.read(output[at..]);
        if made < 0 or made > output.len - at { return -1; }
        if made == 0 { break; }
        at += made;
    }
    at
}

zipWriterFileSinkFlush :: (ctx: *void) -> bool {
    state : *ZipFileWriteState = ctx.(*ZipFileWriteState);
    zipWriterFileFlushBuffer(state)
}

// Callback-backed ZIP writer. Entry bytes are emitted immediately using
// data descriptors, while only names/extras/comments and fixed-size central
// metadata remain resident until `finish`. A callback failure is non-atomic:
// bytes already accepted by the sink cannot be recalled.
ZipStreamWriter :: struct {
    sink: ZipSink;
    metadata: ByteWriter;
    entries: List(ZipWriterEntry);
    alloc: Allocator;
    offset: i64;
    finished: bool;
    zip64: bool;
    active: bool;
    alignment: i64;
    allowReading: bool;
    finalCount: i64;

    init :: (sink: ZipSink, alloc: Allocator = context.allocator) -> ZipStreamWriter {
        ZipStreamWriter.initMode(sink, false, alloc)
    }

    initMode :: (sink: ZipSink, zip64: bool, alloc: Allocator) -> ZipStreamWriter {
        valid := sink.write != null;
        writer := ZipStreamWriter{ sink = sink, metadata = ByteWriter.init(alloc), entries = .{}, alloc = alloc, offset = 0, finished = false, zip64 = zip64, active = valid, alignment = 0, allowReading = false, finalCount = 0 };
        writer.entries.items.ptr = null;
        writer.entries.items.len = 0;
        writer.entries.cap = 0;
        writer
    }

    // Stateful user/file writer conversion. Existing local records stay in
    // place; new output begins at the old central-directory offset while the
    // retained central metadata remains available for extraction and reads.
    initFromReader :: (source: *ZipReader, sink: ZipSink, forceZip64: bool = false, alloc: Allocator = context.allocator) -> (ZipStreamWriter, !Error) {
        if !source.active or sink.write == null { raise .InvalidData; }
        destinationZip64 := source.zip64 or forceZip64;
        if (!destinationZip64 and source.count >= 65535) or source.count >= 0xffffffff { raise .TooLarge; }
        writer := ZipStreamWriter.initMode(sink, destinationZip64, alloc);
        writer.offset = source.centralRelativeOffset;
        writer.allowReading = sink.readAt != null;
        if !zipEntriesReserve(*writer.entries, source.count, alloc) {
            writer.deinit(); raise .AllocationFailed;
        }
        i := 0;
        while i < source.count {
            entry := source.entry(i) catch |e| { writer.deinit(); raise e; };
            rawCompressed := le32(source.data, entry.centralOffset + 20) catch |e| { writer.deinit(); raise e; };
            rawSize := le32(source.data, entry.centralOffset + 24) catch |e| { writer.deinit(); raise e; };
            rawOffset := le32(source.data, entry.centralOffset + 42) catch |e| { writer.deinit(); raise e; };
            upgradeEntry := forceZip64 and !source.zip64;
            storedExtraLen := entry.extra.len;
            if upgradeEntry {
                keptExtraLen := zipExtraWithoutZip64Size(entry.extra) catch |e| { writer.deinit(); raise e; };
                storedExtraLen = keptExtraLen + 28;
                if storedExtraLen > 65535 { writer.deinit(); raise .TooLarge; }
            }
            metadataNeeded := entry.name.len + storedExtraLen + entry.comment.len;
            if metadataNeeded > i64.max - writer.metadata.bytes.len or
               !writer.metadata.ensureCapacity(writer.metadata.bytes.len + metadataNeeded) {
                writer.deinit(); raise .AllocationFailed;
            }
            nameOffset := writer.metadata.bytes.len; writer.metadata.putBytes(entry.name);
            extraOffset := writer.metadata.bytes.len;
            if upgradeEntry {
                writer.metadata.putU16le(1); writer.metadata.putU16le(24);
                writer.metadata.putU64le(entry.size);
                writer.metadata.putU64le(entry.compressedSize);
                writer.metadata.putU64le(entry.localOffset);
                zipCopyExtraWithoutZip64(*writer.metadata, entry.extra) catch |e| { writer.deinit(); raise e; };
            } else {
                writer.metadata.putBytes(entry.extra);
            }
            commentOffset := writer.metadata.bytes.len; writer.metadata.putBytes(entry.comment);
            zipEntriesAppendReserved(*writer.entries, ZipWriterEntry{
                nameOffset = nameOffset, nameLen = entry.name.len,
                method = entry.method, methodValue = entry.methodValue,
                flags = entry.flags, crc = entry.crc,
                compressedSize = entry.compressedSize, size = entry.size,
                localOffset = entry.localOffset,
                extraOffset = extraOffset, extraLen = storedExtraLen,
                commentOffset = commentOffset, commentLen = entry.comment.len,
                dosTime = entry.dosTime, dosDate = entry.dosDate,
                externalAttributes = entry.externalAttributes,
                internalAttributes = entry.internalAttributes,
                versionMadeBy = entry.versionMadeBy,
                versionNeeded = entry.versionNeeded,
                zip64Size = upgradeEntry or rawSize == 0xffffffff,
                zip64Compressed = upgradeEntry or rawCompressed == 0xffffffff,
                zip64Offset = upgradeEntry or rawOffset == 0xffffffff,
            });
            i += 1;
        }
        writer
    }

    readArchiveData :: (self: *ZipStreamWriter, offset: i64, output: string) -> (i64, !Error) {
        if !self.active or !self.allowReading or self.sink.readAt == null or offset < 0 {
            raise .InvalidData;
        }
        if offset >= self.offset { return 0; }
        take := self.offset - offset;
        if take > output.len { take = output.len; }
        readAt := self.sink.readAt;
        made := readAt(self.sink.ctx, offset, output[..take]);
        if made < 0 or made > take { raise .Io; }
        made
    }
    setAlignment :: (self: *ZipStreamWriter, alignment: i64) -> !Error {
        if self.finished or alignment < 0 or (alignment > 0 and (alignment & (alignment - 1)) != 0) {
            raise .InvalidArgument;
        }
        self.alignment = alignment;
    }

    emit :: (self: *ZipStreamWriter, data: string) -> !Error {
        if self.sink.write == null {
            raise .InvalidData;
        }
        if self.offset < 0 or data.len > 0x7fffffffffffffff - self.offset { raise .TooLarge; }
        if data.len > 0 and !self.sink.write(self.sink.ctx, data) { raise .Io; }
        self.offset += data.len;
    }

    patch :: (self: *ZipStreamWriter, offset: i64, data: string) -> !Error {
        if offset < 0 or data.len < 0 or offset > self.offset or data.len > self.offset - offset or self.sink.writeAt == null {
            raise .InvalidData;
        }
        writeAt := self.sink.writeAt;
        if data.len > 0 and !writeAt(self.sink.ctx, offset, data) {
            raise .Io;
        }
    }

    emitZeros :: (self: *ZipStreamWriter, count: i64) -> !Error {
        zeros : [4096]u8 = ---;
        i := 0;
        while i < zeros.len { zeros[i] = 0; i += 1; }
        remaining := count;
        while remaining > 0 {
            take := if remaining < zeros.len then remaining else zeros.len;
            try self.emit(string{ ptr = *zeros[0], len = take });
            remaining -= take;
        }
    }

    addOptions :: (self: *ZipStreamWriter, name: string, data: string, options: ZipEntryOptions) -> !Error {
        if !self.active { raise .Io; }
        if self.finished { raise .Finished; }
        centralExtra := if options.separateCentralExtra then options.centralExtra else options.extra;
        if self.entries.len >= 0xffffffff { raise .TooLarge; }
        if name.len > 65535 or (name.len > 0 and name[0] == '/') { raise .TooLarge; }
        if options.comment.len > 65535 or data.len > 0xffffffff { raise .TooLarge; }
        if self.entries.len >= 65535 { self.zip64 = true; }
        if options.method != .store and options.method != .deflate or options.level > 10 { raise .Unsupported; }
        dosTime, dosDate := zipResolveDosTime(options) catch |e| {
            raise e;
        };
        if dosTime < 0 or dosTime > 0xffff or dosDate < 0 or dosDate > 0xffff { raise .InvalidData; }
        if options.externalAttributes < 0 or options.externalAttributes > 0xffffffff { raise .InvalidData; }
        if name.len > 0 and name[name.len - 1] == '/' and data.len != 0 { raise .InvalidData; }
        chosen := options.method;
        if options.autoStoreSmall and data.len <= 3 { chosen = .store; }
        hasDescriptor := options.dataDescriptor and (data.len > 0 or options.descriptorForEmpty);
        // A sequential sink needs a descriptor when sizes are not known at
        // header time. The canonical empty stored entry is already fully known
        // (CRC and both sizes are zero), so it needs neither a descriptor nor
        // a patch callback.
        if !hasDescriptor and self.sink.writeAt == null and (data.len > 0 or chosen != .store) {
            raise .InvalidData;
        }
        zipValidateUserExtra(options.extra) catch |e| { raise e; };
        zipValidateUserExtra(centralExtra) catch |e| { raise e; };
        padding := zipAlignmentPadding(self.offset, self.alignment);
        if self.offset > i64.max - padding { raise .TooLarge; }
        localOffset := self.offset + padding;
        offsetZip64 := localOffset >= 0xffffffff;
        sizeZip64 := data.len >= 0xffffffff;
        maxCompressed := data.len;
        if chosen == .deflate {
            maxCompressed = compressBound(data.len) catch |e| { raise e; };
        }
        mayCompressedZip64 := maxCompressed >= 0xffffffff;
        localZip64ValueSize := (if !hasDescriptor and sizeZip64 then 16 else 0) + (if offsetZip64 then 8 else 0);
        localZip64ExtraSize := if localZip64ValueSize > 0 then 4 + localZip64ValueSize else 0;
        localExtraSize := options.extra.len + localZip64ExtraSize;
        centralZip64ValueMax := (if sizeZip64 then 8 else 0) + (if mayCompressedZip64 then 8 else 0) + (if offsetZip64 then 8 else 0);
        centralZip64ExtraMax := if centralZip64ValueMax > 0 then 4 + centralZip64ValueMax else 0;
        centralExtraMax := centralExtra.len + centralZip64ExtraMax;
        if localExtraSize > 65535 or centralExtraMax > 65535 {
            raise .TooLarge;
        }
        metadataNeeded := name.len + centralExtraMax + options.comment.len;
        if metadataNeeded > i64.max - self.metadata.bytes.len {
            raise .TooLarge;
        }
        if !self.metadata.ensureCapacity(self.metadata.bytes.len + metadataNeeded) or
           !zipEntriesReserve(*self.entries, self.entries.len + 1, self.alloc) {
            raise .AllocationFailed;
        }
        entryStartOffset := self.offset;
        // Bytes emitted from here on (padding, header, payload, descriptor)
        // are physically at the backend. On failure, truly un-emit them when
        // the backend can truncate — the writer stays reusable and the final
        // archive is byte-identical to one that never saw the failure — and
        // POISON the writer otherwise (a borrowed sink cannot take bytes
        // back). Either way the ORIGINAL error is re-raised; a target sink
        // error surfaces at the emit that observed it, before any later
        // source read, so target failures take precedence over source ones.
        committed := false;
        defer {
            if !committed {
                rolledBack := false;
                if self.sink.truncate != null {
                    if self.sink.truncate(self.sink.ctx, entryStartOffset) { rolledBack = true; }
                }
                if rolledBack { self.offset = entryStartOffset; }
                else { self.active = false; }
            }
        }
        try self.emitZeros(padding);
        if offsetZip64 or sizeZip64 { self.zip64 = true; }
        flags := (if options.asciiFilename then 0 else 0x0800) | (if hasDescriptor then 8 else 0);
        header := ByteWriter.init(self.alloc);
        header.putU32le(0x04034b50);
        header.putU16le(if chosen == .deflate then 20 else 0);
        header.putU16le(flags);
        header.putU16le(if chosen == .deflate then 8 else 0);
        header.putU16le(dosTime);
        header.putU16le(dosDate);
        header.putU32le(0); header.putU32le(0); header.putU32le(0);
        header.putU16le(name.len);
        header.putU16le(localExtraSize);
        header.putBytes(name);
        if localZip64ValueSize > 0 {
            header.putU16le(1); header.putU16le(localZip64ValueSize);
            if !hasDescriptor and sizeZip64 { header.putU64le(0); header.putU64le(0); }
            if offsetZip64 { header.putU64le(localOffset); }
        }
        header.putBytes(options.extra);
        headerBytes := header.take();
        if headerBytes.ptr == null { raise .AllocationFailed; }
        self.emit(headerBytes[..30]) catch |e| { self.alloc.deallocBytes(headerBytes.ptr); raise e; };
        self.emit(headerBytes[30..30 + name.len]) catch |e| { self.alloc.deallocBytes(headerBytes.ptr); raise e; };
        if localZip64ExtraSize > 0 {
            self.emit(headerBytes[30 + name.len..30 + name.len + localZip64ExtraSize]) catch |e| { self.alloc.deallocBytes(headerBytes.ptr); raise e; };
        }
        if options.extra.len > 0 {
            self.emit(headerBytes[30 + name.len + localZip64ExtraSize..30 + name.len + localZip64ExtraSize + options.extra.len]) catch |e| { self.alloc.deallocBytes(headerBytes.ptr); raise e; };
        }
        self.alloc.deallocBytes(headerBytes.ptr);

        compressedSize := 0;
        if chosen == .store {
            at := 0;
            while at < data.len {
                take := data.len - at;
                if take > 8192 { take = 8192; }
                try self.emit(data[at..at + take]);
                compressedSize += take;
                at += take;
            }
        } else {
            encoder := Deflater.init(options.level, self.alloc);
            if encoder.allocationFailed { encoder.deinit(); raise .AllocationFailed; }
            inputAt := 0;
            scratch : [8192]u8 = ---;
            done := false;
            while !done {
                input : string = .{ ptr = null, len = 0 };
                if inputAt < data.len { input = data[inputAt..]; }
                progress := encoder.stepUnchecked(input, string{ ptr = *scratch[0], len = scratch.len }, true);
                if encoder.allocationFailed { encoder.deinit(); raise .AllocationFailed; }
                inputAt += progress.consumed;
                if progress.produced > 0 {
                    self.emit(string{ ptr = *scratch[0], len = progress.produced }) catch |e| { encoder.deinit(); raise e; };
                    compressedSize += progress.produced;
                }
                if progress.status == .done { done = true; }
            }
            encoder.deinit();
        }
        compressedZip64 := compressedSize >= 0xffffffff;
        if sizeZip64 or compressedZip64 { self.zip64 = true; }

        sum := crc32(data);
        if hasDescriptor {
            descriptor := ByteWriter.init(self.alloc);
            descriptor.putU32le(0x08074b50);
            descriptor.putU32le(sum);
            if offsetZip64 or sizeZip64 or compressedZip64 {
                descriptor.putU64le(compressedSize);
                descriptor.putU64le(data.len);
            } else {
                descriptor.putU32le(compressedSize);
                descriptor.putU32le(data.len);
            }
            descriptorBytes := descriptor.take();
            if descriptorBytes.ptr == null { raise .AllocationFailed; }
            self.emit(descriptorBytes) catch |e| {
                self.alloc.deallocBytes(descriptorBytes.ptr);
                raise e;
            };
            self.alloc.deallocBytes(descriptorBytes.ptr);
        } else if data.len > 0 or chosen != .store {
            if compressedZip64 and !sizeZip64 { raise .TooLarge; }
            patched := ByteWriter.init(self.alloc);
            patched.putU32le(0x04034b50);
            patched.putU16le(if chosen == .deflate then 20 else 0);
            patched.putU16le(flags);
            patched.putU16le(if chosen == .deflate then 8 else 0);
            patched.putU16le(dosTime); patched.putU16le(dosDate);
            patched.putU32le(sum);
            patched.putU32le(if compressedZip64 then 0xffffffff else compressedSize);
            patched.putU32le(if sizeZip64 then 0xffffffff else data.len);
            patched.putU16le(name.len); patched.putU16le(localExtraSize);
            patchedBytes := patched.take();
            if patchedBytes.ptr == null { raise .AllocationFailed; }
            self.patch(localOffset, patchedBytes) catch |e| { self.alloc.deallocBytes(patchedBytes.ptr); raise e; };
            self.alloc.deallocBytes(patchedBytes.ptr);
            if sizeZip64 {
                wide := ByteWriter.init(self.alloc);
                wide.putU64le(data.len); wide.putU64le(compressedSize);
                wideBytes := wide.take();
                if wideBytes.ptr == null { raise .AllocationFailed; }
                self.patch(localOffset + 30 + name.len + 4, wideBytes) catch |e| { self.alloc.deallocBytes(wideBytes.ptr); raise e; };
                self.alloc.deallocBytes(wideBytes.ptr);
            }
        }

        nameOffset := self.metadata.bytes.len;
        self.metadata.putBytes(name);
        extraOffset := self.metadata.bytes.len;
        zip64FieldSize := (if sizeZip64 then 8 else 0) + (if compressedZip64 then 8 else 0) + (if offsetZip64 then 8 else 0);
        if zip64FieldSize > 0 {
            self.metadata.putU16le(1); self.metadata.putU16le(zip64FieldSize);
            if sizeZip64 { self.metadata.putU64le(data.len); }
            if compressedZip64 { self.metadata.putU64le(compressedSize); }
            if offsetZip64 { self.metadata.putU64le(localOffset); }
        }
        self.metadata.putBytes(centralExtra);
        storedExtraLen := self.metadata.bytes.len - extraOffset;
        commentOffset := self.metadata.bytes.len;
        self.metadata.putBytes(options.comment);
        zipEntriesAppendReserved(*self.entries, ZipWriterEntry{
            nameOffset = nameOffset,
            nameLen = name.len,
            method = chosen,
            methodValue = if chosen == .deflate then 8 else 0,
            flags = flags,
            crc = sum,
            compressedSize = compressedSize,
            size = data.len,
            localOffset = localOffset,
            extraOffset = extraOffset,
            extraLen = storedExtraLen,
            commentOffset = commentOffset,
            commentLen = options.comment.len,
            dosTime = dosTime,
            dosDate = dosDate,
            externalAttributes = options.externalAttributes | (if name.len > 0 and name[name.len - 1] == '/' then 0x10 else 0),
            internalAttributes = 0,
            versionMadeBy = 0,
            versionNeeded = if chosen == .deflate then 20 else 0,
            zip64Size = sizeZip64,
            zip64Compressed = compressedZip64,
            zip64Offset = offsetZip64,
        });
        committed = true;
    }

    // Stream an entry from an exactly-sized random-read source. A zero-length
    // read before `size` is an early EOF, and the callback is never asked for
    // bytes beyond the declared bound. Only fixed input/output windows remain
    // resident while the payload is processed.
    addSource :: (self: *ZipStreamWriter, name: string, source: ZipInputSource, options: ZipEntryOptions = .{}) -> !Error {
        if self.finished { raise .Finished; }
        centralExtra := if options.separateCentralExtra then options.centralExtra else options.extra;
        if self.entries.len >= 0xffffffff { raise .TooLarge; }
        if name.len > 65535 or (name.len > 0 and name[0] == '/') { raise .TooLarge; }
        // Upstream never invokes the read callback for a declared zero-byte
        // source, so a null callback is accepted in that one case.
        if (source.size > 0 and source.read == null) or source.size < 0 or options.comment.len > 65535 { raise .TooLarge; }
        if self.entries.len >= 65535 { self.zip64 = true; }
        if options.method != .store and options.method != .deflate or options.level > 10 { raise .Unsupported; }
        dosTime, dosDate := zipResolveDosTime(options) catch |e| {
            raise e;
        };
        if dosTime < 0 or dosTime > 0xffff or dosDate < 0 or dosDate > 0xffff { raise .InvalidData; }
        if options.externalAttributes < 0 or options.externalAttributes > 0xffffffff { raise .InvalidData; }
        if name.len > 0 and name[name.len - 1] == '/' and source.size != 0 { raise .InvalidData; }

        chosen := options.method;
        if options.autoStoreSmall and source.size <= 3 { chosen = .store; }
        sourceOptions := options;
        // Callback/file sources preserve miniz's descriptor for an empty
        // source; direct in-memory addOptions() deliberately suppresses it.
        sourceOptions.descriptorForEmpty = true;
        hasDescriptor := sourceOptions.dataDescriptor and (source.size > 0 or sourceOptions.descriptorForEmpty);
        if !hasDescriptor and self.sink.writeAt == null and (source.size > 0 or chosen != .store) {
            raise .InvalidData;
        }
        zipValidateUserExtra(options.extra) catch |e| { raise e; };
        zipValidateUserExtra(centralExtra) catch |e| { raise e; };
        padding := zipAlignmentPadding(self.offset, self.alignment);
        if self.offset > i64.max - padding { raise .TooLarge; }
        localOffset := self.offset + padding;
        offsetZip64 := localOffset >= 0xffffffff;
        maxSizeZip64 := source.size >= 0xffffffff;
        maxCompressed := source.size;
        if chosen == .deflate {
            maxCompressed = compressBound(source.size) catch |e| { raise e; };
        }
        mayCompressedZip64 := maxCompressed >= 0xffffffff;
        localZip64ValueSize := (if !hasDescriptor and maxSizeZip64 then 16 else 0) + (if offsetZip64 then 8 else 0);
        localZip64ExtraSize := if localZip64ValueSize > 0 then 4 + localZip64ValueSize else
            if hasDescriptor and maxSizeZip64 then 4 else 0;
        localExtraSize := options.extra.len + localZip64ExtraSize;
        centralZip64ValueMax := (if maxSizeZip64 then 8 else 0) + (if mayCompressedZip64 then 8 else 0) + (if offsetZip64 then 8 else 0);
        centralZip64ExtraMax := if centralZip64ValueMax > 0 then 4 + centralZip64ValueMax else 0;
        centralExtraMax := centralExtra.len + centralZip64ExtraMax;
        if localExtraSize > 65535 or centralExtraMax > 65535 {
            raise .TooLarge;
        }
        metadataNeeded := name.len + centralExtraMax + options.comment.len;
        if metadataNeeded > i64.max - self.metadata.bytes.len {
            raise .TooLarge;
        }
        if !self.metadata.ensureCapacity(self.metadata.bytes.len + metadataNeeded) or
           !zipEntriesReserve(*self.entries, self.entries.len + 1, self.alloc) {
            raise .AllocationFailed;
        }
        entryStartOffset := self.offset;
        // Bytes emitted from here on (padding, header, payload, descriptor)
        // are physically at the backend. On failure, truly un-emit them when
        // the backend can truncate — the writer stays reusable and the final
        // archive is byte-identical to one that never saw the failure — and
        // POISON the writer otherwise (a borrowed sink cannot take bytes
        // back). Either way the ORIGINAL error is re-raised; a target sink
        // error surfaces at the emit that observed it, before any later
        // source read, so target failures take precedence over source ones.
        committed := false;
        defer {
            if !committed {
                rolledBack := false;
                if self.sink.truncate != null {
                    if self.sink.truncate(self.sink.ctx, entryStartOffset) { rolledBack = true; }
                }
                if rolledBack { self.offset = entryStartOffset; }
                else { self.active = false; }
            }
        }
        try self.emitZeros(padding);
        if offsetZip64 or maxSizeZip64 { self.zip64 = true; }
        flags := (if options.asciiFilename then 0 else 0x0800) | (if hasDescriptor then 8 else 0);
        header := ByteWriter.init(self.alloc);
        header.putU32le(0x04034b50);
        header.putU16le(if chosen == .deflate then 20 else 0);
        header.putU16le(flags);
        header.putU16le(if chosen == .deflate then 8 else 0);
        header.putU16le(dosTime); header.putU16le(dosDate);
        header.putU32le(0); header.putU32le(0); header.putU32le(0);
        header.putU16le(name.len); header.putU16le(localExtraSize);
        header.putBytes(name);
        if localZip64ExtraSize > 0 {
            header.putU16le(1); header.putU16le(localZip64ValueSize);
            if !hasDescriptor and maxSizeZip64 { header.putU64le(0); header.putU64le(0); }
            if offsetZip64 { header.putU64le(localOffset); }
        }
        header.putBytes(options.extra);
        headerBytes := header.take();
        if headerBytes.ptr == null { raise .AllocationFailed; }
        self.emit(headerBytes[..30]) catch |e| { self.alloc.deallocBytes(headerBytes.ptr); raise e; };
        self.emit(headerBytes[30..30 + name.len]) catch |e| { self.alloc.deallocBytes(headerBytes.ptr); raise e; };
        if localZip64ExtraSize > 0 {
            self.emit(headerBytes[30 + name.len..30 + name.len + localZip64ExtraSize]) catch |e| { self.alloc.deallocBytes(headerBytes.ptr); raise e; };
        }
        if options.extra.len > 0 {
            self.emit(headerBytes[30 + name.len + localZip64ExtraSize..30 + name.len + localZip64ExtraSize + options.extra.len]) catch |e| { self.alloc.deallocBytes(headerBytes.ptr); raise e; };
        }
        self.alloc.deallocBytes(headerBytes.ptr);

        inputBuf : [65536]u8 = ---;
        outputBuf : [32768]u8 = ---;
        sourceAt := 0;
        checksum := 0;
        compressedSize := 0;
        if chosen == .store {
            while sourceAt < source.size {
                request := source.size - sourceAt;
                if request > inputBuf.len { request = inputBuf.len; }
                made := source.read(source.ctx, sourceAt, string{ ptr = *inputBuf[0], len = request });
                if made <= 0 or made > request {
                    raise .Io;
                }
                bytes := string{ ptr = *inputBuf[0], len = made };
                checksum = crc32(bytes, checksum);
                try self.emit(bytes);
                sourceAt += made;
                compressedSize += made;
            }
        } else {
            encoder := Deflater.init(options.level, self.alloc);
            if encoder.allocationFailed { encoder.deinit(); raise .AllocationFailed; }
            inputLen := 0;
            inputAt := 0;
            sourceDone := source.size == 0;
            streamDone := false;
            while !streamDone {
                if inputAt == inputLen and !sourceDone {
                    request := source.size - sourceAt;
                    if request > inputBuf.len { request = inputBuf.len; }
                    made := source.read(source.ctx, sourceAt, string{ ptr = *inputBuf[0], len = request });
                    if made <= 0 or made > request {
                        encoder.deinit(); raise .Io;
                    }
                    inputLen = made;
                    inputAt = 0;
                    checksum = crc32(string{ ptr = *inputBuf[0], len = made }, checksum);
                    sourceAt += made;
                    sourceDone = sourceAt == source.size;
                }
                input : string = .{ ptr = null, len = 0 };
                if inputAt < inputLen { input = inputBuf[inputAt..inputLen]; }
                progress := encoder.stepUnchecked(input, string{ ptr = *outputBuf[0], len = outputBuf.len }, sourceDone);
                if encoder.allocationFailed { encoder.deinit(); raise .AllocationFailed; }
                inputAt += progress.consumed;
                if progress.produced > 0 {
                    self.emit(string{ ptr = *outputBuf[0], len = progress.produced }) catch |e| { encoder.deinit(); raise e; };
                    compressedSize += progress.produced;
                }
                if progress.status == .done { streamDone = true; }
            }
            encoder.deinit();
        }
        if sourceAt != source.size { raise .Io; }
        sizeZip64 := sourceAt >= 0xffffffff;
        compressedZip64 := compressedSize >= 0xffffffff;
        if sizeZip64 or compressedZip64 { self.zip64 = true; }

        if hasDescriptor {
            descriptor := ByteWriter.init(self.alloc);
            descriptor.putU32le(0x08074b50); descriptor.putU32le(checksum);
            if offsetZip64 or maxSizeZip64 or sizeZip64 or compressedZip64 {
                descriptor.putU64le(compressedSize); descriptor.putU64le(sourceAt);
            } else {
                descriptor.putU32le(compressedSize); descriptor.putU32le(sourceAt);
            }
            descriptorBytes := descriptor.take();
            if descriptorBytes.ptr == null { raise .AllocationFailed; }
            self.emit(descriptorBytes) catch |e| {
                self.alloc.deallocBytes(descriptorBytes.ptr);
                raise e;
            };
            self.alloc.deallocBytes(descriptorBytes.ptr);
        } else {
            if compressedZip64 and !maxSizeZip64 { raise .TooLarge; }
            patched := ByteWriter.init(self.alloc);
            patched.putU32le(0x04034b50);
            patched.putU16le(if chosen == .deflate then 20 else 0);
            patched.putU16le(flags);
            patched.putU16le(if chosen == .deflate then 8 else 0);
            patched.putU16le(dosTime); patched.putU16le(dosDate);
            patched.putU32le(checksum);
            patched.putU32le(if maxSizeZip64 then 0xffffffff else compressedSize);
            patched.putU32le(if maxSizeZip64 then 0xffffffff else sourceAt);
            patched.putU16le(name.len); patched.putU16le(localExtraSize);
            patchedBytes := patched.take();
            if patchedBytes.ptr == null { raise .AllocationFailed; }
            self.patch(localOffset, patchedBytes) catch |e| { self.alloc.deallocBytes(patchedBytes.ptr); raise e; };
            self.alloc.deallocBytes(patchedBytes.ptr);
            if maxSizeZip64 {
                wide := ByteWriter.init(self.alloc);
                wide.putU64le(sourceAt); wide.putU64le(compressedSize);
                wideBytes := wide.take();
                if wideBytes.ptr == null { raise .AllocationFailed; }
                self.patch(localOffset + 30 + name.len + 4, wideBytes) catch |e| { self.alloc.deallocBytes(wideBytes.ptr); raise e; };
                self.alloc.deallocBytes(wideBytes.ptr);
            }
        }

        nameOffset := self.metadata.bytes.len;
        self.metadata.putBytes(name);
        extraOffset := self.metadata.bytes.len;
        zip64FieldSize := (if sizeZip64 then 8 else 0) + (if compressedZip64 then 8 else 0) + (if offsetZip64 then 8 else 0);
        if maxSizeZip64 or zip64FieldSize > 0 {
            self.metadata.putU16le(1); self.metadata.putU16le(zip64FieldSize);
            if sizeZip64 { self.metadata.putU64le(sourceAt); }
            if compressedZip64 { self.metadata.putU64le(compressedSize); }
            if offsetZip64 { self.metadata.putU64le(localOffset); }
        }
        self.metadata.putBytes(centralExtra);
        storedExtraLen := self.metadata.bytes.len - extraOffset;
        commentOffset := self.metadata.bytes.len;
        self.metadata.putBytes(options.comment);
        zipEntriesAppendReserved(*self.entries, ZipWriterEntry{
            nameOffset = nameOffset, nameLen = name.len, method = chosen,
            methodValue = if chosen == .deflate then 8 else 0, flags = flags,
            crc = checksum, compressedSize = compressedSize, size = sourceAt,
            localOffset = localOffset, extraOffset = extraOffset, extraLen = storedExtraLen,
            commentOffset = commentOffset, commentLen = options.comment.len,
            dosTime = dosTime, dosDate = dosDate,
            externalAttributes = options.externalAttributes | (if name.len > 0 and name[name.len - 1] == '/' then 0x10 else 0), internalAttributes = 0,
            versionMadeBy = 0, versionNeeded = if chosen == .deflate then 20 else 0,
            zip64Size = sizeZip64,
            zip64Compressed = compressedZip64,
            zip64Offset = offsetZip64,
        });
        committed = true;
    }

    // Streaming/backend-general form of mz_zip_writer_add_from_zip_reader().
    // Local metadata and descriptors are copied without semantic validation,
    // exactly like upstream; only framing needed to find the record is parsed.
    addFromReader :: (self: *ZipStreamWriter, source: *ZipReader, index: i64) -> !Error {
        if !self.active { raise .Io; }
        if self.finished { raise .Finished; }
        if source == null or !source.active or (source.sourceRead == null and source.data.ptr == null) {
            raise .InvalidData;
        }
        if source.zip64 and !self.zip64 { raise .InvalidData; }
        if index < 0 or index >= source.count { raise .InvalidData; }
        if self.entries.len >= 0xffffffff { raise .TooLarge; }
        if self.entries.len >= 65535 { self.zip64 = true; }
        entry := source.entryUnchecked(index) catch |e| {
            raise e;
        };
        recordStart := source.archiveStart + entry.localOffset;
        localHeader : [30]u8 = ---;
        source.readExactAt(recordStart, string{ ptr = *localHeader[0], len = localHeader.len }) catch |e| {
            raise e;
        };
        header := string{ ptr = *localHeader[0], len = localHeader.len };
        if (le32(header, 0) catch |e| 0) != 0x04034b50 {
            raise .InvalidData;
        }
        localFlags := try le16(header, 6);
        localNameLen := try le16(header, 26);
        localExtraLen := try le16(header, 28);
        followingLen := localNameLen + localExtraLen + entry.compressedSize;
        followingAt := recordStart + 30;
        if followingAt < recordStart or followingLen < 0 or followingAt > source.sourceSize or followingLen > source.sourceSize - followingAt {
            raise .Io;
        }

        descriptor : [24]u8 = ---;
        descriptorLen := 0;
        descriptorOutputLen := 0;
        upgradeDescriptor := false;
        if (localFlags & 8) != 0 {
            foundLocalZip64 := false;
            localCompressed := try le32(header, 18);
            localSize := try le32(header, 22);
            if localExtraLen > 0 and (localCompressed == 0xffffffff or localSize == 0xffffffff) {
                extraRaw := self.alloc.allocBytes(localExtraLen);
                if extraRaw == null { raise .AllocationFailed; }
                extra := string{ ptr = extraRaw, len = localExtraLen };
                source.readExactAt(recordStart + 30 + localNameLen, extra) catch |e| {
                    self.alloc.deallocBytes(extraRaw); raise e;
                };
                extraAt := 0;
                while extraAt < extra.len {
                    if extraAt + 4 > extra.len {
                        self.alloc.deallocBytes(extraRaw); raise .InvalidData;
                    }
                    fieldId := try le16(extra, extraAt);
                    fieldSize := try le16(extra, extraAt + 2);
                    if fieldSize > extra.len - extraAt - 4 {
                        self.alloc.deallocBytes(extraRaw); raise .InvalidData;
                    }
                    if fieldId == 1 {
                        if fieldSize < 16 {
                            self.alloc.deallocBytes(extraRaw); raise .InvalidData;
                        }
                        foundLocalZip64 = true; break;
                    }
                    extraAt += 4 + fieldSize;
                }
                self.alloc.deallocBytes(extraRaw);
            }
            wideDescriptor := localCompressed == 0xffffffff or localSize == 0xffffffff or
                               entry.compressedSize >= 0xffffffff or entry.size >= 0xffffffff or
                               foundLocalZip64;
            descriptorReadLen := if wideDescriptor then 24 else 16;
            descriptorAt := followingAt + followingLen;
            source.readExactAt(descriptorAt, string{ ptr = *descriptor[0], len = descriptorReadLen }) catch |e| {
                raise e;
            };
            signedDescriptor := (try le32(string{ ptr = *descriptor[0], len = descriptorReadLen }, 0)) == 0x08074b50;
            descriptorLen = if wideDescriptor then (if signedDescriptor then 24 else 20)
                             else (if signedDescriptor then 16 else 12);
            upgradeDescriptor = self.zip64 and !source.zip64;
            descriptorOutputLen = if upgradeDescriptor then 24 else descriptorLen;
        }

        outputRecordLen := 30 + followingLen + descriptorOutputLen;
        padding := zipAlignmentPadding(self.offset, self.alignment);
        if self.offset > 0xffffffff - outputRecordLen - padding {
            raise .TooLarge;
        }
        storedExtraLen := entry.extra.len;
        if self.zip64 {
            keptExtraLen := zipExtraWithoutZip64Size(entry.extra) catch |e| {
                raise e;
            };
            storedExtraLen = keptExtraLen + 28;
            if storedExtraLen > 65535 { raise .TooLarge; }
        }
        metadataNeeded := entry.name.len + storedExtraLen + entry.comment.len;
        if !self.metadata.ensureCapacity(self.metadata.bytes.len + metadataNeeded) or
           !zipEntriesReserve(*self.entries, self.entries.len + 1, self.alloc) {
            raise .AllocationFailed;
        }

        entryStartOffset := self.offset;
        // Bytes emitted from here on (padding, header, payload, descriptor)
        // are physically at the backend. On failure, truly un-emit them when
        // the backend can truncate — the writer stays reusable and the final
        // archive is byte-identical to one that never saw the failure — and
        // POISON the writer otherwise (a borrowed sink cannot take bytes
        // back). Either way the ORIGINAL error is re-raised; a target sink
        // error surfaces at the emit that observed it, before any later
        // source read, so target failures take precedence over source ones.
        committed := false;
        defer {
            if !committed {
                rolledBack := false;
                if self.sink.truncate != null {
                    if self.sink.truncate(self.sink.ctx, entryStartOffset) { rolledBack = true; }
                }
                if rolledBack { self.offset = entryStartOffset; }
                else { self.active = false; }
            }
        }
        try self.emitZeros(padding);
        localOffset := self.offset;
        try self.emit(header);
        transfer : [65536]u8 = ---;
        transferred := 0;
        while transferred < followingLen {
            take := followingLen - transferred;
            if take > transfer.len { take = transfer.len; }
            chunk := string{ ptr = *transfer[0], len = take };
            source.readExactAt(followingAt + transferred, chunk) catch |e| {
                raise e;
            };
            try self.emit(chunk);
            transferred += take;
        }
        if descriptorOutputLen > 0 {
            if upgradeDescriptor {
                descriptorBytes := string{ ptr = *descriptor[0], len = descriptorLen };
                hasSignature := (try le32(descriptorBytes, 0)) == 0x08074b50;
                valueAt := if hasSignature then 4 else 0;
                descriptorCrc := try le32(descriptorBytes, valueAt);
                descriptorCompressed := try le32(descriptorBytes, valueAt + 4);
                descriptorSize := try le32(descriptorBytes, valueAt + 8);
                upgraded := ByteWriter.init(self.alloc);
                upgraded.putU32le(0x08074b50); upgraded.putU32le(descriptorCrc);
                upgraded.putU64le(descriptorCompressed); upgraded.putU64le(descriptorSize);
                upgradedBytes := upgraded.take();
                if upgradedBytes.ptr == null { raise .AllocationFailed; }
                self.emit(upgradedBytes) catch |e| { self.alloc.deallocBytes(upgradedBytes.ptr); raise e; };
                self.alloc.deallocBytes(upgradedBytes.ptr);
            } else {
                try self.emit(string{ ptr = *descriptor[0], len = descriptorLen });
            }
        }

        nameOffset := self.metadata.bytes.len; self.metadata.putBytes(entry.name);
        extraOffset := self.metadata.bytes.len;
        if self.zip64 {
            zipCopyExtraWithoutZip64(*self.metadata, entry.extra) catch |e| {
                raise e;
            };
            self.metadata.putU16le(1); self.metadata.putU16le(24);
            self.metadata.putU64le(entry.size); self.metadata.putU64le(entry.compressedSize); self.metadata.putU64le(localOffset);
        } else { self.metadata.putBytes(entry.extra); }
        extraLen := self.metadata.bytes.len - extraOffset;
        commentOffset := self.metadata.bytes.len; self.metadata.putBytes(entry.comment);
        zipEntriesAppendReserved(*self.entries, ZipWriterEntry{
            nameOffset = nameOffset, nameLen = entry.name.len,
            method = entry.method, methodValue = entry.methodValue, flags = entry.flags,
            crc = entry.crc, compressedSize = entry.compressedSize, size = entry.size,
            localOffset = localOffset, extraOffset = extraOffset, extraLen = extraLen,
            commentOffset = commentOffset, commentLen = entry.comment.len,
            dosTime = entry.dosTime, dosDate = entry.dosDate,
            externalAttributes = entry.externalAttributes, internalAttributes = entry.internalAttributes,
            versionMadeBy = entry.versionMadeBy, versionNeeded = entry.versionNeeded,
            zip64Size = self.zip64, zip64Compressed = self.zip64, zip64Offset = self.zip64,
        });
        committed = true;
    }

    addHandle :: (self: *ZipStreamWriter, name: string, file: *File, maxSize: i64, options: ZipEntryOptions = .{}) -> !Error {
        if file.fd < 0 or maxSize < 0 { raise .InvalidData; }
        actualOptions := options;
        if actualOptions.timeMode == .file {
            seconds, valid := zipFileModifiedSeconds(file);
            if !valid { raise .Io; }
            actualOptions.timeMode = .specified;
            actualOptions.modifiedUnixSeconds = seconds;
        }
        actualOptions.descriptorForEmpty = true;
        state := ZipFileInputState{ file = file, start = 0 };
        source := ZipInputSource{ ctx = *state, size = maxSize, read = zipFileInputRead };
        try self.addSource(name, source, actualOptions);
    }

    addFile :: (self: *ZipStreamWriter, name: string, path: [:0]u8, options: ZipEntryOptions) -> !Error {
        if options.useFileTime and !exists(path) {
            raise .Io;
        }
        maybeFile := openFile(path, .read);
        if maybeFile == null { raise .Io; }
        file : File = maybeFile;
        size := file.seek(0, .end);
        if size < 0 { file.close(); raise .Io; }
        actualOptions := options;
        if actualOptions.timeMode == .none and actualOptions.useFileTime { actualOptions.timeMode = .file; }
        self.addHandle(name, *file, size, actualOptions) catch |e| { file.close(); raise e; };
        if !file.close() { raise .Io; }
    }

    finish :: (self: *ZipStreamWriter) -> !Error { try self.finishComment(""); }

    finishComment :: (self: *ZipStreamWriter, archiveComment: string) -> !Error {
        if !self.active { raise .Io; }
        if self.finished { raise .Finished; }
        if archiveComment.len > 65535 { raise .TooLarge; }
        centralOffset := self.offset;
        centralSize := 0;
        i := 0;
        while i < self.entries.len {
            entry := self.entries.items[i];
            entrySize := 46 + entry.nameLen + entry.extraLen + entry.commentLen;
            if entrySize > i64.max - centralSize { raise .TooLarge; }
            centralSize += entrySize;
            i += 1;
        }
        if centralSize >= 0xffffffff { raise .TooLarge; }
        if self.entries.len > 0xffff or centralOffset > 0xffffffff - (centralSize + 22 + archiveComment.len) { self.zip64 = true; }
        totalTail := centralSize + 22 + archiveComment.len + (if self.zip64 then 76 else 0);
        if centralOffset < 0 or totalTail > 0x7fffffffffffffff - centralOffset { raise .TooLarge; }
        i = 0;
        while i < self.entries.len {
            entry := self.entries.items[i];
            name := string{ ptr = *self.metadata.bytes.items.ptr[entry.nameOffset], len = entry.nameLen };
            extra : string = .{ ptr = null, len = 0 };
            comment : string = .{ ptr = null, len = 0 };
            if entry.extraLen > 0 { extra = string{ ptr = *self.metadata.bytes.items.ptr[entry.extraOffset], len = entry.extraLen }; }
            if entry.commentLen > 0 { comment = string{ ptr = *self.metadata.bytes.items.ptr[entry.commentOffset], len = entry.commentLen }; }
            header := ByteWriter.init(self.alloc);
            header.putU32le(0x02014b50);
            header.putU16le(entry.versionMadeBy); header.putU16le(entry.versionNeeded); header.putU16le(entry.flags);
            header.putU16le(entry.methodValue);
            header.putU16le(entry.dosTime); header.putU16le(entry.dosDate);
            header.putU32le(entry.crc);
            header.putU32le(if entry.zip64Compressed then 0xffffffff else entry.compressedSize);
            header.putU32le(if entry.zip64Size then 0xffffffff else entry.size);
            header.putU16le(entry.nameLen); header.putU16le(entry.extraLen); header.putU16le(entry.commentLen);
            header.putU16le(0); header.putU16le(entry.internalAttributes); header.putU32le(entry.externalAttributes);
            header.putU32le(if entry.zip64Offset then 0xffffffff else entry.localOffset);
            header.putBytes(name); header.putBytes(extra); header.putBytes(comment);
            bytes := header.take();
            if bytes.ptr == null { raise .AllocationFailed; }
            self.emit(bytes) catch |e| { self.alloc.deallocBytes(bytes.ptr); raise e; };
            self.alloc.deallocBytes(bytes.ptr);
            i += 1;
        }
        end := ByteWriter.init(self.alloc);
        if self.zip64 {
            zip64Offset := self.offset;
            end.putU32le(0x06064b50); end.putU64le(44);
            end.putU16le(0x031e); end.putU16le(45);
            end.putU32le(0); end.putU32le(0);
            end.putU64le(self.entries.len); end.putU64le(self.entries.len);
            end.putU64le(centralSize); end.putU64le(centralOffset);
            end.putU32le(0x07064b50); end.putU32le(0);
            end.putU64le(zip64Offset); end.putU32le(1);
        }
        end.putU32le(0x06054b50);
        end.putU16le(0); end.putU16le(0);
        end.putU16le(if self.entries.len > 0xffff then 0xffff else self.entries.len);
        end.putU16le(if self.entries.len > 0xffff then 0xffff else self.entries.len);
        end.putU32le(if centralSize > 0xffffffff then 0xffffffff else centralSize);
        end.putU32le(if centralOffset > 0xffffffff then 0xffffffff else centralOffset);
        end.putU16le(archiveComment.len); end.putBytes(archiveComment);
        endBytes := end.take();
        if endBytes.ptr == null { raise .AllocationFailed; }
        endOffset := self.offset;
        self.emit(endBytes) catch |e| { self.alloc.deallocBytes(endBytes.ptr); raise e; };
        if self.sink.flush != null {
            flush := self.sink.flush;
            if !flush(self.sink.ctx) {
                // The sink has already accepted the bytes, but miniz does not
                // advance its logical archive size or finalized mode when
                // fflush() fails.
                self.offset = endOffset;

                self.alloc.deallocBytes(endBytes.ptr);
                raise .Io;
            }
        }
        self.alloc.deallocBytes(endBytes.ptr);
        self.entries.deinit(self.alloc);
        self.metadata.deinit();
        self.finalCount = i;
        self.finished = true;
    }

    end :: (self: *ZipStreamWriter) -> bool {
        if !self.active {
            return false;
        }
        self.deinit();
        true
    }

    deinit :: (self: *ZipStreamWriter) {
        if !self.finished { self.finalCount = self.entries.len; }
        self.entries.deinit(self.alloc);
        self.metadata.deinit();
        self.finished = true;
        self.active = false;
    }
}

// Filesystem writer ownership behind the public std.zip path factories.
OwnedZipWriter :: struct {
    writer: ZipStreamWriter;
    fileState: *ZipFileWriteState;
    alloc: Allocator;

    end :: (self: *OwnedZipWriter) -> bool {
        flushOk := true;
        if self.fileState != null and self.fileState.buffered {
            flushOk = zipWriterFileFlushBuffer(self.fileState);
        }
        writerOk := self.writer.end();
        closeOk := true;
        if self.fileState != null {
            if self.fileState.ownsFile and !self.fileState.file.close() {
                closeOk = false;
            }
            self.alloc.deallocBytes(self.fileState);
            self.fileState = null;
        }
        writerOk and flushOk and closeOk
    }

    deinit :: (self: *OwnedZipWriter) { self.end(); }
}

openZipWriterFile :: (path: [:0]u8, reserve: i64 = 0, zip64: bool = false, allowReading: bool = false, alloc: Allocator = context.allocator) -> (OwnedZipWriter, !Error) {
    openZipWriterFileMode(path, reserve, zip64, allowReading, alloc)
}

openZipWriterFileMode :: (path: [:0]u8, reserve: i64, zip64: bool, allowReading: bool, alloc: Allocator) -> (OwnedZipWriter, !Error) {
    if reserve < 0 { raise .InvalidData; }
    maybeCreated := openFile(path, .write);
    if maybeCreated == null { raise .Io; }
    created : File = maybeCreated;
    file := created;
    if allowReading {
        if !created.close() { raise .Io; }
        maybeReopened := openFile(path, .readWrite);
        if maybeReopened == null { raise .Io; }
        file = maybeReopened;
    }
    stateRaw := alloc.allocBytes(@sizeOf(ZipFileWriteState));
    if stateRaw == null { file.close(); raise .AllocationFailed; }
    state : *ZipFileWriteState = stateRaw.(*ZipFileWriteState);
    state.* = ZipFileWriteState{ file = file, start = 0, ownsFile = true, buffered = true };
    sink := ZipSink{
        ctx = state,
        write = zipWriterFileSinkWrite,
        writeAt = zipWriterFileSinkWriteAt,
        flush = zipWriterFileSinkFlush,
        truncate = zipWriterFileSinkTruncate,
    };
    if allowReading { sink.readAt = zipWriterFileSinkReadAt; }
    writer := ZipStreamWriter.initMode(sink, zip64, alloc);
    writer.allowReading = allowReading;
    writer.emitZeros(reserve) catch |e| {
        writer.deinit(); zipWriterFileFlushBuffer(state); state.file.close(); alloc.deallocBytes(stateRaw);
        raise e;
    };
    OwnedZipWriter{ writer = writer, fileState = state, alloc = alloc }
}

// Convert a reader opened by openZipFileWritable() into an in-place writer.
// The returned writer borrows the OwnedZipReader's file state; finalize/end it
// before deinitializing the owner.
zipFileWriterFromReader :: (owned: *OwnedZipReader, forceZip64: bool = false, alloc: Allocator = context.allocator) -> (ZipStreamWriter, !Error) {
    if owned.fileState == null or !owned.fileState.writable or !owned.reader.active {
        raise .InvalidData;
    }
    state := owned.fileState;
    state.writeBase = state.start + owned.reader.archiveStart;
    state.writePosition = owned.reader.centralRelativeOffset;
    sink := ZipSink{
        ctx = state,
        write = zipFileUpdateWrite,
        writeAt = zipFileUpdateWriteAt,
        readAt = zipFileUpdateReadAt,
        truncate = zipFileUpdateTruncate,
    };
    ZipStreamWriter.initFromReader(*owned.reader, sink, forceZip64, alloc)
}
