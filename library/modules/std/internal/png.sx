// Private PNG assembly layered on the native zlib implementation. The public
// image model and validation live in std/codecs/png.sx; this module owns
// filtered-row construction, PNG chunk encoding, and chunk-walking +
// unfiltering for decode.

@import "modules/std/core.sx";
@import "modules/std/compress.sx";
@import "modules/std/internal/compress.sx";

DecodeErr :: error {
    TruncatedData;
    InvalidSignature;
    ChecksumMismatch;
    UnsupportedFormat;
    InvalidFilter;
    DecompressionFailed;
    AllocationFailed;
}

private PNG_MAX_CHUNK_LEN : i64 = 0x7fffffff;

private pngWriteChunk :: (out: *ByteWriter, kind: string, payload: string) {
    out.putU32be(payload.len);
    out.putBytes(kind);
    out.putBytes(payload);
    checksum := crc32(kind);
    checksum = crc32(payload, checksum);
    out.putU32be(checksum);
}

pngEncodeBytes :: (
    pixels: string,
    width: i64,
    height: i64,
    rowBytes: i64,
    step: i64,
    bottomUp: bool,
    colorType: i64,
    filteredLen: i64,
    level: i64,
    alloc: Allocator,
) -> (string, !Error) {
    filteredRaw := alloc.allocBytes(filteredLen);
    if filteredRaw == null { raise .AllocationFailed; }
    filtered := string{ ptr = filteredRaw, len = filteredLen };
    filteredRowBytes := rowBytes + 1;

    row := 0;
    while row < height {
        sourceRow := if bottomUp then height - 1 - row else row;
        sourceOffset := sourceRow * step;
        destinationOffset := row * filteredRowBytes;

        // The pinned miniz helper always writes filter type zero followed by
        // the source row verbatim. Keeping that layout preserves its exact
        // compressed bytes while avoiding an image-policy surface internally.
        filtered.ptr[destinationOffset] = 0;
        col := 0;
        while col < rowBytes {
            filtered.ptr[destinationOffset + 1 + col] = pixels[sourceOffset + col];
            col += 1;
        }
        row += 1;
    }

    compressed := zlibCompress(filtered, level, alloc) catch |e| {
        alloc.deallocBytes(filteredRaw);
        raise e;
    };
    alloc.deallocBytes(filteredRaw);

    // PNG limits each chunk to 2^31-1 bytes. Ordinary images use one IDAT;
    // unusually large streams are split without changing the zlib payload.
    idatChunks := compressed.len / PNG_MAX_CHUNK_LEN;
    if compressed.len % PNG_MAX_CHUNK_LEN != 0 { idatChunks += 1; }
    if idatChunks == 0 { idatChunks = 1; }

    if compressed.len > i64.max - 45 {
        alloc.deallocBytes(compressed.ptr);
        raise .TooLarge;
    }
    outputLen := compressed.len + 45;
    if idatChunks > (i64.max - outputLen) / 12 {
        alloc.deallocBytes(compressed.ptr);
        raise .TooLarge;
    }
    outputLen += idatChunks * 12;

    out := ByteWriter.init(alloc);
    if !out.ensureCapacity(outputLen) {
        alloc.deallocBytes(compressed.ptr);
        out.deinit();
        raise .AllocationFailed;
    }

    out.put(137); out.put('P'); out.put('N'); out.put('G');
    out.put(13); out.put(10); out.put(26); out.put(10);

    ihdr : [13]u8 = ---;
    ihdr[0] = ((width >> 24) & 0xff).(u8);
    ihdr[1] = ((width >> 16) & 0xff).(u8);
    ihdr[2] = ((width >> 8) & 0xff).(u8);
    ihdr[3] = (width & 0xff).(u8);
    ihdr[4] = ((height >> 24) & 0xff).(u8);
    ihdr[5] = ((height >> 16) & 0xff).(u8);
    ihdr[6] = ((height >> 8) & 0xff).(u8);
    ihdr[7] = (height & 0xff).(u8);
    ihdr[8] = 8;
    ihdr[9] = colorType.(u8);
    ihdr[10] = 0;
    ihdr[11] = 0;
    ihdr[12] = 0;
    pngWriteChunk(*out, "IHDR", string{ ptr = *ihdr[0], len = ihdr.len });

    at := 0;
    while at < compressed.len {
        take := compressed.len - at;
        if take > PNG_MAX_CHUNK_LEN { take = PNG_MAX_CHUNK_LEN; }
        pngWriteChunk(*out, "IDAT", compressed[at..at + take]);
        at += take;
    }
    pngWriteChunk(*out, "IEND", "");
    alloc.deallocBytes(compressed.ptr);

    if out.failed {
        out.deinit();
        raise .AllocationFailed;
    }
    out.take()
}

// ── Decode ──────────────────────────────────────────────────────────────

DecodedPng :: struct {
    pixels: string;
    width: i64;
    height: i64;
    channels: i64;
}

private pngU32be :: (d: string, off: i64) -> i64 {
    (d[off].(i64) << 24) | (d[off + 1].(i64) << 16) | (d[off + 2].(i64) << 8) | d[off + 3].(i64)
}

private paeth :: (a: i64, b: i64, c: i64) -> i64 {
    p := a + b - c;
    pa := if p >= a then p - a else a - p;
    pb := if p >= b then p - b else b - p;
    pc := if p >= c then p - c else c - p;
    if pa <= pb and pa <= pc { return a; }
    if pb <= pc { return b; }
    c
}

// 8-bit, non-interlaced, color types 0/2/4/6 (what `pngEncodeBytes`
// emits, plus filters 1-4 for files written by other encoders). Every
// chunk CRC is verified; anything outside this envelope rejects loudly.
pngDecodeBytes :: (data: string, alloc: Allocator) -> (DecodedPng, !DecodeErr) {
    if data.len < 8 { raise .TruncatedData; }
    sig : [8]u8 = .[137, 80, 78, 71, 13, 10, 26, 10];
    si := 0;
    while si < 8 {
        if data[si] != sig[si] { raise .InvalidSignature; }
        si += 1;
    }

    width := 0;
    height := 0;
    channels := 0;
    sawIhdr := false;
    sawIend := false;
    idatTotal := 0;

    // Pass 1: validate every chunk (length bounds + CRC), parse IHDR,
    // sum the IDAT payload.
    off := 8;
    while off < data.len {
        if off + 12 > data.len { raise .TruncatedData; }
        len := pngU32be(data, off);
        if len < 0 or off + 12 + len > data.len { raise .TruncatedData; }
        kind := data[off + 4..off + 8];
        payload := data[off + 8..off + 8 + len];
        expect := pngU32be(data, off + 8 + len);
        actual := crc32(kind);
        actual = crc32(payload, actual);
        if (actual & 0xffffffff) != expect { raise .ChecksumMismatch; }
        if kind == "IHDR" {
            if len != 13 { raise .UnsupportedFormat; }
            width = pngU32be(payload, 0);
            height = pngU32be(payload, 4);
            bit := payload[8].(i64);
            ct := payload[9].(i64);
            if bit != 8 or payload[10] != 0 or payload[11] != 0 { raise .UnsupportedFormat; }
            if payload[12] != 0 { raise .UnsupportedFormat; }   // Adam7
            if ct == 0 { channels = 1; }
            else if ct == 2 { channels = 3; }
            else if ct == 4 { channels = 2; }
            else if ct == 6 { channels = 4; }
            else { raise .UnsupportedFormat; }                  // palette etc.
            sawIhdr = true;
        } else if kind == "IDAT" {
            idatTotal += len;
        } else if kind == "IEND" {
            sawIend = true;
            break;
        }
        off += 12 + len;
    }
    if !sawIhdr or !sawIend or width < 1 or height < 1 { raise .TruncatedData; }

    // Pass 2: concatenate the zlib stream.
    if idatTotal < 1 { raise .TruncatedData; }
    idatRaw := alloc.allocBytes(idatTotal);
    if idatRaw == null { raise .AllocationFailed; }
    idat := string{ ptr = idatRaw, len = idatTotal };
    at := 0;
    off = 8;
    while true {
        len := pngU32be(data, off);
        kind := data[off + 4..off + 8];
        if kind == "IEND" { break; }
        if kind == "IDAT" {
            ci := 0;
            while ci < len {
                idat.ptr[at + ci] = data[off + 8 + ci];
                ci += 1;
            }
            at += len;
        }
        off += 12 + len;
    }

    rowBytes := width * channels;
    filteredRowBytes := rowBytes + 1;
    need := filteredRowBytes * height;
    filtered := decompressExact(idat, need, alloc) catch |e| {
        alloc.deallocBytes(idatRaw);
        raise .DecompressionFailed;
    };
    alloc.deallocBytes(idatRaw);
    if filtered.len != need {
        alloc.deallocBytes(filtered.ptr);
        raise .TruncatedData;
    }

    outRaw := alloc.allocBytes(rowBytes * height);
    if outRaw == null {
        alloc.deallocBytes(filtered.ptr);
        raise .AllocationFailed;
    }
    out := string{ ptr = outRaw, len = rowBytes * height };

    bpp := channels;
    r := 0;
    while r < height {
        f := filtered[r * filteredRowBytes].(i64);
        if f < 0 or f > 4 {
            alloc.deallocBytes(filtered.ptr);
            alloc.deallocBytes(outRaw);
            raise .InvalidFilter;
        }
        c := 0;
        while c < rowBytes {
            x := filtered[r * filteredRowBytes + 1 + c].(i64);
            a := if c >= bpp then out[r * rowBytes + c - bpp].(i64) else 0;
            b := if r > 0 then out[(r - 1) * rowBytes + c].(i64) else 0;
            cc := if r > 0 and c >= bpp then out[(r - 1) * rowBytes + c - bpp].(i64) else 0;
            v := x;
            if f == 1 { v = x + a; }
            else if f == 2 { v = x + b; }
            else if f == 3 { v = x + (a + b) / 2; }
            else if f == 4 { v = x + paeth(a, b, cc); }
            out.ptr[r * rowBytes + c] = (v & 0xff).(u8);
            c += 1;
        }
        r += 1;
    }
    alloc.deallocBytes(filtered.ptr);

    result : DecodedPng = .{ pixels = out, width = width, height = height, channels = channels };
    result
}
