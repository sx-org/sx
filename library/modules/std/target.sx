// modules/std/target.sx — the target-fact contract. Dependency-free (imports
// NOTHING) so any low-level module can name the target enums without pulling
// the std barrel.
//
// `@host` is declared here; the compiler forms its single value per
// compilation from the build target. A `@host` field read resolves by name, so
// an `inline if @host.os == .linux` at module scope needs no import at all —
// that is how std/net/epoll.sx selects its layout, and importing this module
// from inside the arm it selects would be circular. Import this module to name
// the `OperatingSystem` / `Architecture` TYPE, or to read `@host` whole.
//
// build.sx imports this (flat) so the decls stay registered in the standard
// import graph — NOT to re-export them (flat import doesn't propagate to a
// module's importers).

OperatingSystem :: enum { macos; linux; windows; wasm; ios; android; unknown; }
Architecture :: enum { aarch64; x86_64; wasm32; wasm64; unknown; }

@host :: struct {
    os: OperatingSystem;
    arch: Architecture;
    pointerSize: i64;
    isSimulator: bool;
}
