// std.fs — target-independent filesystem facade.
//
// Platform ABI details live under std/fs/. Paths are UTF-8 at the sx
// boundary; the Windows backend converts them to UTF-16 before calling Win32.
// File is a small by-value handle whose portable slot holds either a POSIX
// descriptor or the bits of a Win32 HANDLE.

inline if @host.os == .windows {
    @import "modules/std/fs/windows.sx";
} else {
    @import "modules/std/fs/posix.sx";
}

OpenMode :: enum i32 { read :: 0; write :: 1; append :: 2; readWrite :: 3; }
SeekFrom :: enum i32 { set :: 0; current :: 1; end :: 2; }

File :: struct {
    // The portable handle slot is wide enough for both a POSIX descriptor and
    // the bits of a Win32 HANDLE.
    fd: i64 = -1;

    isValid :: (self: *File) -> bool {
        self != null and fsFileIsValid(self.fd)
    }

    close :: (self: *File) -> bool {
        if !self.isValid() { return false; }
        ok := fsFileClose(self.fd);
        self.fd = -1;
        ok
    }

    read :: (self: *File, output: string) -> i64 {
        if !self.isValid() { return -1; }
        fsFileRead(self.fd, output)
    }

    write :: (self: *File, data: string) -> i64 {
        if !self.isValid() { return -1; }
        fsFileWrite(self.fd, data)
    }

    // Set the file's length. The file position is unspecified afterwards;
    // callers that keep writing must seek explicitly.
    truncate :: (self: *File, len: i64) -> bool {
        if !self.isValid() { return false; }
        fsFileTruncate(self.fd, len)
    }

    seek :: (self: *File, offset: i64, from: SeekFrom) -> i64 {
        if !self.isValid() { return -1; }
        fsFileSeek(self.fd, offset, from)
    }
}

openFile :: (path: [:0]u8, mode: OpenMode) -> ?File {
    handle := fsOpenHandle(path, mode);
    if !fsFileIsValid(handle) { return null; }
    File{ fd = handle }
}
readFile :: (path: [:0]u8) -> ?string { fsReadFile(path) }
writeFile :: (path: [:0]u8, data: string) -> bool { fsWriteFile(path, data) }
appendFile :: (path: [:0]u8, data: string) -> bool { fsAppendFile(path, data) }
exists :: (path: [:0]u8) -> bool { fsExists(path) }
deleteFile :: (path: [:0]u8) -> bool { fsDeleteFile(path) }
deleteDir :: (path: [:0]u8) -> bool { fsDeleteDir(path) }
createDir :: (path: [:0]u8) -> bool { fsCreateDir(path) }
createDirAll :: (path: [:0]u8) -> bool { fsCreateDirAll(path) }
setMode :: (path: [:0]u8, mode: u32) -> bool { fsSetMode(path, mode) }
move :: (oldPath: [:0]u8, newPath: [:0]u8) -> bool { fsMove(oldPath, newPath) }
copyFile :: (source: [:0]u8, destination: [:0]u8) -> bool { fsCopyFile(source, destination) }
basename :: (path: string) -> string { fsBasename(path) }
dirname :: (path: string) -> string { fsDirname(path) }

// Whole-second modification timestamps. These are deliberately small
// portable adapters rather than public platform stat/FileTime layouts.
modifiedSeconds :: (file: *File) -> (i64, bool) {
    if file == null or !file.isValid() { return 0, false; }
    fsModifiedSecondsHandle(file.fd)
}
setModifiedSeconds :: (path: [:0]u8, seconds: i64) -> bool { fsSetModifiedSeconds(path, seconds) }
