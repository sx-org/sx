@import "modules/std/c.sx";
@import "modules/std/core.sx";
@import "modules/std/fmt.sx";
@import "modules/std/mem.sx";
@import "modules/std/target.sx";
@import "modules/std/fs/posix_abi.sx";

// =====================================================================
// fs.sx — file system stdlib (POSIX backend).
//
// Allocation contract: every returned `string` or slice is allocated
// from `context.allocator`. Callers are responsible for releasing it
// (typically via an arena reset).
//
// Handle ownership: `File` is a small value-typed handle wrapping the
// POSIX file descriptor. Methods are provided for read/write/close;
// the value is invalid (fd == -1) after `close()`.
//
// The surface is file I/O + directory creation/deletion + a whole-second
// modification time + the path helpers `.app` bundling needs. No recursive
// walker, no exposed `stat` layout, no path module.
// =====================================================================

// The backend owns only hidden primitive operations. std/fs.sx owns every
// portable type and method and stores POSIX descriptors in an i64 handle slot.

fsFileIsValid :: (handle: i64) -> bool { handle >= 0 and handle <= 0x7fffffff }

fsFileClose :: (handle: i64) -> bool {
    if !fsFileIsValid(handle) { return false; }
    c.close(handle.(i32)) == 0
}

fsFileRead :: (handle: i64, output: string) -> i64 {
    if !fsFileIsValid(handle) { return -1; }
    c.read(handle.(i32), output.ptr, output.len)
}

fsFileWrite :: (handle: i64, data: string) -> i64 {
    if !fsFileIsValid(handle) { return -1; }
    c.write(handle.(i32), data.ptr, data.len)
}

fsFileTruncate :: (handle: i64, len: i64) -> bool {
    if !fsFileIsValid(handle) or len < 0 { return false; }
    fsPosixFtruncate(handle.(i32), len) == 0
}

fsFileSeek :: (handle: i64, offset: i64, from: i32) -> i64 {
    if !fsFileIsValid(handle) { return -1; }
    whence := FS_POSIX_SEEK_SET;
    if from == 1 { whence = FS_POSIX_SEEK_CUR; }
    else if from == 2 { whence = FS_POSIX_SEEK_END; }
    c.lseek(handle.(i32), offset, whence)
}

// ── High-level file API ─────────────────────────────────────────────
// Named `openFile` (not `open`) so they don't shadow libc's `open`
// symbol; the latter is needed for `extern libc` to resolve. Same
// idea for `deleteFile`/`deleteDir` vs libc's `unlink`/`rmdir`,
// `setMode` vs libc's `chmod`, etc.

fsPosixModeToFlags :: (mode: i32) -> i32 {
    if mode == 1 { return FS_POSIX_O_WRONLY | FS_POSIX_O_CREAT | FS_POSIX_O_TRUNC; }
    if mode == 2 { return FS_POSIX_O_WRONLY | FS_POSIX_O_CREAT | FS_POSIX_O_APPEND; }
    if mode == 3 { return FS_POSIX_O_RDWR; }
    FS_POSIX_O_RDONLY
}

fsOpenHandle :: (path: string, mode: i32) -> i64 {
    z := mem.cloneZ(context.allocator, path);
    defer mem.free(context.allocator, z);
    fd := c.open(z, fsPosixModeToFlags(mode), 420); // 0o644 = 420
    fd
}

// One-shot read: opens, slurps the whole file into a fresh buffer,
// closes. Returns null on any failure. Uses libc directly (not File
// methods) so it remains callable from the post-link IR interpreter,
// which doesn't yet handle `*Self` method dispatch on locally-
// unwrapped optionals.
fsReadFile :: (path: string) -> ?string {
    fd := fsOpenHandle(path, 0).(i32);
    if fd < 0 { return null; }
    size := c.lseek(fd, 0, FS_POSIX_SEEK_END);
    if size < 0 { c.close(fd); return null; }
    if c.lseek(fd, 0, FS_POSIX_SEEK_SET) < 0 { c.close(fd); return null; }
    buf := mem.allocStringZ(size);
    at := 0;
    ok := true;
    while at < size {
        made := c.read(fd, *buf.ptr[at], (size - at));
        if made <= 0 { ok = false; break; }
        at += made;
    }
    closeOk := c.close(fd) == 0;
    if !ok or !closeOk {
        context.allocator.deallocBytes(buf.ptr);
        return null;
    }
    buf
}

fsPosixWriteAll :: (fd: i32, data: string) -> bool {
    at := 0;
    while at < data.len {
        made := c.write(fd, *data.ptr[at], (data.len - at));
        if made <= 0 { return false; }
        at += made;
    }
    true
}

// One-shot write: creates / truncates and writes the whole buffer.
fsWriteFile :: (path: string, data: string) -> bool {
    fd := fsOpenHandle(path, 1).(i32);
    if fd < 0 { return false; }
    ok := fsPosixWriteAll(fd, data);
    closeOk := c.close(fd) == 0;
    ok and closeOk
}

fsAppendFile :: (path: string, data: string) -> bool {
    fd := fsOpenHandle(path, 2).(i32);
    if fd < 0 { return false; }
    ok := fsPosixWriteAll(fd, data);
    closeOk := c.close(fd) == 0;
    ok and closeOk
}

// ── Single-syscall ops ───────────────────────────────────────────────

fsExists :: (path: string) -> bool {
    z := mem.cloneZ(context.allocator, path);
    defer mem.free(context.allocator, z);
    c.access(z, FS_POSIX_F_OK) == 0
}

fsDeleteFile :: (path: string) -> bool {
    z := mem.cloneZ(context.allocator, path);
    defer mem.free(context.allocator, z);
    c.unlink(z) == 0
}

fsDeleteDir :: (path: string) -> bool {
    z := mem.cloneZ(context.allocator, path);
    defer mem.free(context.allocator, z);
    c.rmdir(z) == 0
}

fsCreateDir :: (path: string) -> bool {
    z := mem.cloneZ(context.allocator, path);
    defer mem.free(context.allocator, z);
    c.mkdir(z, 493) == 0 // 0o755 = 493
}

fsSetMode :: (path: string, mode: u32) -> bool {
    z := mem.cloneZ(context.allocator, path);
    defer mem.free(context.allocator, z);
    c.chmod(z, mode) == 0
}

fsMove :: (oldp: string, newp: string) -> bool {
    oldz := mem.cloneZ(context.allocator, oldp);
    defer mem.free(context.allocator, oldz);
    newz := mem.cloneZ(context.allocator, newp);
    defer mem.free(context.allocator, newz);
    c.rename(oldz, newz) == 0
}

fsRealPath :: (path: string) -> ?string {
    z := mem.cloneZ(context.allocator, path);
    defer mem.free(context.allocator, z);
    resolvedBuf := mem.alloc(context.allocator, u8, FS_POSIX_PATH_MAX);
    if resolvedBuf.ptr == null { return null; }
    defer mem.free(context.allocator, resolvedBuf);
    resolved := fsPosixRealpath(z, resolvedBuf.ptr);
    if resolved == null { return null; }
    mem.clone(context.allocator, resolved[0..])
}

// Recursive mkdir -p. Walks the path and creates each missing
// segment. Treats existing directories as success.
fsCreateDirAll :: (path: string) -> bool {
    if path.len == 0 { return true; }
    if fsExists(path) { return true; }
    last := path.len - 1;
    while last > 0 {
        if path[last] == '/' { break; }
        last -= 1;
    }
    if last > 0 and !fsCreateDirAll(path[0 .. last]) { return false; }
    fsCreateDir(path)
}

// Copy a file by streaming through a 64KB buffer. Uses libc directly
// (not File methods) — same interpreter-compat reason as readFile.
// No metadata is preserved beyond what `open` creates (mode 0644).
// Caller is responsible for setting executable bits with `setMode`.
fsCopyFile :: (src: string, dst: string) -> bool {
    srcFd := fsOpenHandle(src, 0).(i32);
    if srcFd < 0 { return false; }
    dstFd := fsOpenHandle(dst, 1).(i32);
    if dstFd < 0 {
        c.close(srcFd);
        return false;
    }
    ok := true;
    buf := mem.allocStringZ(65536);
    loop := true;
    while loop {
        n := c.read(srcFd, buf.ptr, 65536);
        if n < 0 { ok = false; loop = false; }
        if n == 0 { loop = false; }
        if n > 0 {
            at := 0;
            while at < n {
                made := c.write(dstFd, *buf.ptr[at], (n - at));
                if made <= 0 { ok = false; loop = false; break; }
                at += made;
            }
        }
    }
    context.allocator.deallocBytes(buf.ptr);
    srcCloseOk := c.close(srcFd) == 0;
    dstCloseOk := c.close(dstFd) == 0;
    ok and srcCloseOk and dstCloseOk
}

// Return only the portable whole-second modification time. The private raw
// buffer is deliberately oversized; the copied field offset is selected from
// the target ABI instead of exposing a platform stat layout in std.fs.
fsModifiedSecondsHandle :: (handle: i64) -> (i64, bool) {
    if !fsFileIsValid(handle) { return 0, false; }
    inline if @host.os == .wasm { return 0, false; }
    else {
        raw : [256]u8 = .{};
        if c.fstat(handle.(i32), *raw[0]) != 0 { return 0, false; }
        offset := 0;
        inline if @host.os == .macos or @host.os == .ios { offset = 48; }
        else if @host.os == .linux or @host.os == .android { offset = 88; }
        else { @error("std/fs/posix.sx: stat modification-time offset is not defined for this target"); }
        seconds : i64 = 0;
        c.memcpy(*seconds, *raw[offset], @sizeOf(i64));
        return seconds, true;
    }
}

fsSetModifiedSeconds :: (path: string, seconds: i64) -> bool {
    inline if @host.os == .wasm { return false; }
    else {
        times : [2]c.Timespec = .[
            .{ sec = 0, nsec = FS_POSIX_UTIME_OMIT },
            .{ sec = seconds, nsec = 0 },
        ];
        z := mem.cloneZ(context.allocator, path);
        defer mem.free(context.allocator, z);
        return fsPosixUtimensat(FS_POSIX_AT_FDCWD, z, *times[0], 0) == 0;
    }
}

// ── Path helpers ─────────────────────────────────────────────────────
// `pathJoin` is in std.sx (used widely beyond fs). These are the
// fs-adjacent helpers — basename/dirname operate purely on text.

fsBasename :: (p: string) -> string {
    if p.len == 0 { return ""; }
    last := p.len - 1;
    while last > 0 {
        if p[last] != '/' { break; }
        last -= 1;
    }
    end := last + 1;
    while last > 0 {
        if p[last - 1] == '/' { return p[last .. end]; }
        last -= 1;
    }
    p[0 .. end]
}

fsDirname :: (p: string) -> string {
    if p.len == 0 { return ""; }
    last := p.len - 1;
    while last > 0 {
        if p[last] != '/' { break; }
        last -= 1;
    }
    while last > 0 {
        if p[last] == '/' {
            while last > 0 {
                if p[last - 1] != '/' { break; }
                last -= 1;
            }
            return p[0 .. last];
        }
        last -= 1;
    }
    if p[0] == '/' { return "/"; }
    "."
}
