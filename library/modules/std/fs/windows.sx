// Win32 backend for std.fs. Paths are UTF-8 at the sx boundary and converted
// to UTF-16 for filesystem calls.
@import "modules/std/core.sx";
@import "modules/std/fmt.sx";
@import "modules/std/mem.sx";
@import "modules/std/fs/windows_abi.sx";

// The backend owns only hidden primitive operations. std/fs.sx owns every
// portable type and method and stores Win32 HANDLE bits in an i64 slot.

// The UTF-16 path from `context.allocator`, NUL-terminated past its last unit.
fsWindowsWidePath :: (path: string) -> ?[]u16 {
    count := fsWindowsMultiByteToWideChar(FS_WINDOWS_CP_UTF8, 0, path.ptr, path.len.(i32), null, 0);
    if count <= 0 { return null; }
    wide := mem.alloc(context.allocator, u16, count.(i64) + 1);
    if fsWindowsMultiByteToWideChar(FS_WINDOWS_CP_UTF8, 0, path.ptr, path.len.(i32), wide.ptr, count) != count {
        mem.free(context.allocator, wide); return null;
    }
    wide[count] = 0;
    wide
}

fsWindowsHandle :: (handle: i64) -> *void { @reinterpret(*void, handle) }
fsFileIsValid :: (handle: i64) -> bool { handle != -1 and handle != 0 }

fsFileClose :: (handle: i64) -> bool {
    if !fsFileIsValid(handle) { return false; }
    fsWindowsCloseHandle(fsWindowsHandle(handle)) != 0
}

fsFileRead :: (handle: i64, output: string) -> i64 {
    if !fsFileIsValid(handle) or (output.len > 0 and output.ptr == null) { return -1; }
    take := output.len; if take > 0xffffffff { take = 0xffffffff; }
    made : u32 = 0;
    if fsWindowsReadFile(fsWindowsHandle(handle), output.ptr, take.(u32), *made, null) == 0 { return -1; }
    made
}

fsFileWrite :: (handle: i64, data: string) -> i64 {
    if !fsFileIsValid(handle) or (data.len > 0 and data.ptr == null) { return -1; }
    take := data.len; if take > 0xffffffff { take = 0xffffffff; }
    made : u32 = 0;
    if fsWindowsWriteFile(fsWindowsHandle(handle), data.ptr, take.(u32), *made, null) == 0 { return -1; }
    made
}

fsFileSeek :: (handle: i64, offset: i64, from: i32) -> i64 {
    if !fsFileIsValid(handle) { return -1; }
    method := from;
    if method < 0 or method > 2 { method = 0; }
    position : i64 = 0;
    if fsWindowsSetFilePointerEx(fsWindowsHandle(handle), offset, *position, method.(u32)) == 0 { return -1; }
    position
}

fsFileTruncate :: (handle: i64, len: i64) -> bool {
    if !fsFileIsValid(handle) or len < 0 { return false; }
    position : i64 = 0;
    if fsWindowsSetFilePointerEx(fsWindowsHandle(handle), len, *position, 0) == 0 { return false; }
    fsWindowsSetEndOfFile(fsWindowsHandle(handle)) != 0
}

fsOpenHandle :: (path: string, mode: i32) -> i64 {
    wide := fsWindowsWidePath(path); if wide == null { return -1; }
    access := FS_WINDOWS_GENERIC_READ; creation := FS_WINDOWS_OPEN_EXISTING;
    if mode == 1 { access = FS_WINDOWS_GENERIC_WRITE; creation = FS_WINDOWS_CREATE_ALWAYS; }
    else if mode == 2 { access = FS_WINDOWS_GENERIC_WRITE; creation = FS_WINDOWS_OPEN_ALWAYS; }
    else if mode == 3 { access = FS_WINDOWS_GENERIC_READ | FS_WINDOWS_GENERIC_WRITE; creation = FS_WINDOWS_OPEN_EXISTING; }
    handle := fsWindowsCreateFileW(wide.ptr, access, FS_WINDOWS_FILE_SHARE_ALL, null, creation, FS_WINDOWS_FILE_ATTRIBUTE_NORMAL, null);
    mem.free(context.allocator, wide);
    bits : i64 = @reinterpret(isize, handle);
    if !fsFileIsValid(bits) { return -1; }
    if mode == 2 and fsFileSeek(bits, 0, 2) < 0 { fsFileClose(bits); return -1; }
    bits
}

fsExists :: (path: string) -> bool {
    wide := fsWindowsWidePath(path); if wide == null { return false; }
    attributes := fsWindowsGetFileAttributesW(wide.ptr); mem.free(context.allocator, wide); attributes != FS_WINDOWS_INVALID_ATTRIBUTES
}

fsDeleteFile :: (path: string) -> bool {
    wide := fsWindowsWidePath(path); if wide == null { return false; }
    ok := fsWindowsDeleteFileW(wide.ptr) != 0; mem.free(context.allocator, wide); ok
}

fsWriteFile :: (path: string, data: string) -> bool {
    handle := fsOpenHandle(path, 1); if !fsFileIsValid(handle) { return false; }
    at := 0;
    while at < data.len {
        made := fsFileWrite(handle, data[at..]);
        if made <= 0 { fsFileClose(handle); return false; }
        at += made;
    }
    fsFileClose(handle)
}

fsReadFile :: (path: string) -> ?string {
    handle := fsOpenHandle(path, 0); if !fsFileIsValid(handle) { return null; }
    size := fsFileSeek(handle, 0, 2);
    if size < 0 or fsFileSeek(handle, 0, 0) < 0 { fsFileClose(handle); return null; }
    result := mem.allocString(size);
    at := 0;
    while at < size {
        made := fsFileRead(handle, result[at..]);
        if made <= 0 {
            fsFileClose(handle);
            context.allocator.deallocBytes(result.ptr);
            return null;
        }
        at += made;
    }
    if !fsFileClose(handle) {
        context.allocator.deallocBytes(result.ptr);
        return null;
    }
    result
}

fsAppendFile :: (path: string, data: string) -> bool {
    handle := fsOpenHandle(path, 2); if !fsFileIsValid(handle) { return false; }
    at := 0;
    while at < data.len {
        made := fsFileWrite(handle, data[at..]);
        if made <= 0 { fsFileClose(handle); return false; }
        at += made;
    }
    fsFileClose(handle)
}

fsDeleteDir :: (path: string) -> bool {
    wide := fsWindowsWidePath(path); if wide == null { return false; }
    ok := fsWindowsRemoveDirectoryW(wide.ptr) != 0; mem.free(context.allocator, wide); ok
}

fsCreateDir :: (path: string) -> bool {
    wide := fsWindowsWidePath(path); if wide == null { return false; }
    ok := fsWindowsCreateDirectoryW(wide.ptr, null) != 0; mem.free(context.allocator, wide); ok
}

fsSetMode :: (path: string, mode: u32) -> bool {
    wide := fsWindowsWidePath(path); if wide == null { return false; }
    attributes := fsWindowsGetFileAttributesW(wide.ptr);
    if attributes == FS_WINDOWS_INVALID_ATTRIBUTES { mem.free(context.allocator, wide); return false; }
    if (mode & 0x92) == 0 { attributes = attributes | FS_WINDOWS_FILE_ATTRIBUTE_READONLY; }
    else { attributes = attributes & ~FS_WINDOWS_FILE_ATTRIBUTE_READONLY; }
    ok := fsWindowsSetFileAttributesW(wide.ptr, attributes) != 0;
    mem.free(context.allocator, wide);
    ok
}

fsMove :: (oldPath: string, newPath: string) -> bool {
    oldWide := fsWindowsWidePath(oldPath); if oldWide == null { return false; }
    newWide := fsWindowsWidePath(newPath);
    if newWide == null { mem.free(context.allocator, oldWide); return false; }
    ok := fsWindowsMoveFileExW(oldWide.ptr, newWide.ptr, FS_WINDOWS_MOVEFILE_REPLACE_EXISTING) != 0;
    mem.free(context.allocator, newWide); mem.free(context.allocator, oldWide); ok
}

fsCopyFile :: (source: string, destination: string) -> bool {
    sourceWide := fsWindowsWidePath(source); if sourceWide == null { return false; }
    destinationWide := fsWindowsWidePath(destination);
    if destinationWide == null { mem.free(context.allocator, sourceWide); return false; }
    ok := fsWindowsCopyFileW(sourceWide.ptr, destinationWide.ptr, 0) != 0;
    mem.free(context.allocator, destinationWide); mem.free(context.allocator, sourceWide); ok
}

fsWindowsSeparator :: (byte: u8) -> bool { byte == '/' or byte == '\\' }

fsCreateDirAll :: (path: string) -> bool {
    if path.len == 0 or fsExists(path) { return true; }
    last := path.len - 1;
    while last > 0 {
        if fsWindowsSeparator(path[last]) { break; }
        last -= 1;
    }
    // Do not recurse below a drive root such as C:\\.
    if last > 0 and !(last == 2 and path[1] == ':') and !fsCreateDirAll(path[0 .. last]) { return false; }
    fsCreateDir(path) or fsExists(path)
}

fsBasename :: (path: string) -> string {
    if path.len == 0 { return ""; }
    last := path.len - 1;
    while last > 0 and fsWindowsSeparator(path[last]) { last -= 1; }
    end := last + 1;
    while last > 0 {
        if fsWindowsSeparator(path[last - 1]) { return path[last .. end]; }
        last -= 1;
    }
    path[0 .. end]
}

fsDirname :: (path: string) -> string {
    if path.len == 0 { return ""; }
    last := path.len - 1;
    while last > 0 and fsWindowsSeparator(path[last]) { last -= 1; }
    while last > 0 {
        if fsWindowsSeparator(path[last]) {
            while last > 0 and fsWindowsSeparator(path[last - 1]) { last -= 1; }
            if last == 2 and path[1] == ':' { return path[0 .. 3]; }
            return path[0 .. last];
        }
        last -= 1;
    }
    if path.len >= 2 and path[1] == ':' { return path[0 .. 2]; }
    "."
}

fsWindowsWideHasPrefix :: (wide: [*]u16, len: i64, prefix: string) -> bool {
    if len < prefix.len { return false; }
    at := 0;
    while at < prefix.len {
        if wide[at] != prefix[at] { return false; }
        at += 1;
    }
    true
}

// GetFinalPathNameByHandleW answers in the \\?\ namespace. The result drops
// that prefix and spells \\?\UNC\server\share as \\server\share.
fsRealPath :: (path: string) -> ?string {
    wide := fsWindowsWidePath(path); if wide == null { return null; }
    handle := fsWindowsCreateFileW(wide.ptr, 0, FS_WINDOWS_FILE_SHARE_ALL, null, FS_WINDOWS_OPEN_EXISTING, FS_WINDOWS_FILE_FLAG_BACKUP_SEMANTICS, null);
    mem.free(context.allocator, wide); bits : i64 = @reinterpret(isize, handle);
    if !fsFileIsValid(bits) { return null; }
    flags := FS_WINDOWS_FILE_NAME_NORMALIZED | FS_WINDOWS_VOLUME_NAME_DOS;
    capacity := fsWindowsGetFinalPathNameByHandleW(handle, null, 0, flags);
    if capacity == 0 { fsWindowsCloseHandle(handle); return null; }
    final := mem.alloc(context.allocator, u16, capacity.(i64));
    made := fsWindowsGetFinalPathNameByHandleW(handle, final.ptr, capacity, flags).(i64);
    fsWindowsCloseHandle(handle);
    if made == 0 or made >= capacity { mem.free(context.allocator, final); return null; }
    start := 0;
    if fsWindowsWideHasPrefix(final.ptr, made, "\\\\?\\UNC\\") { start = 6; final[6] = '\\'; }
    else if fsWindowsWideHasPrefix(final.ptr, made, "\\\\?\\") { start = 4; }
    size := fsWindowsWideCharToMultiByte(FS_WINDOWS_CP_UTF8, 0, *final[start], (made - start).(i32), null, 0, null, null);
    result : ?string = null;
    if size > 0 {
        text := mem.allocString(size);
        if fsWindowsWideCharToMultiByte(FS_WINDOWS_CP_UTF8, 0, *final[start], (made - start).(i32), text.ptr, size, null, null) == size { result = text; }
        else { mem.free(context.allocator, text); }
    }
    mem.free(context.allocator, final);
    result
}

fsModifiedSecondsHandle :: (handle: i64) -> (i64, bool) {
    if !fsFileIsValid(handle) { return 0, false; }
    value : FsWindowsFileTime = ---;
    if fsWindowsGetFileTime(fsWindowsHandle(handle), null, null, *value) == 0 { return 0, false; }
    ticks := value.low | (value.high.(u64) << 32);
    epochTicks : u64 = 116444736000000000;
    if ticks < epochTicks { return 0, false; }
    return ((ticks - epochTicks) / 10000000).(i64), true;
}

fsSetModifiedSeconds :: (path: string, seconds: i64) -> bool {
    if seconds < -11644473600 or seconds > 1833029933770 { return false; }
    wide := fsWindowsWidePath(path); if wide == null { return false; }
    handle := fsWindowsCreateFileW(wide.ptr, FS_WINDOWS_FILE_WRITE_ATTRIBUTES, FS_WINDOWS_FILE_SHARE_ALL, null, FS_WINDOWS_OPEN_EXISTING, FS_WINDOWS_FILE_ATTRIBUTE_NORMAL, null);
    mem.free(context.allocator, wide); bits : i64 = @reinterpret(isize, handle);
    if !fsFileIsValid(bits) { return false; }
    ticks := (seconds + 11644473600).(u64) * 10000000;
    value := FsWindowsFileTime{ low = ticks.(u32), high = (ticks >> 32).(u32) };
    ok := fsWindowsSetFileTime(handle, null, null, *value) != 0;
    closeOk := fsWindowsCloseHandle(handle) != 0; ok and closeOk
}
