// Private Win32 ABI used by std.fs. windows.sx flat-imports this part so the
// kernel32 handle, extern declarations, and numeric constants cannot become
// authored members of the public std.fs facade.

fsWindowsC :: @import "modules/std/c.sx";
fsWindowsKernel32 :: @library "kernel32";

FsWindowsFileTime :: struct { low: u32; high: u32; }
FsWindowsWidePath :: struct { ptr: [*]u16 = null; heap: *void = null; }

fsWindowsMultiByteToWideChar :: (codePage: u32, flags: u32, input: [*]u8, inputLen: i32, output: [*]u16, outputLen: i32) -> i32 extern fsWindowsKernel32 "MultiByteToWideChar";
fsWindowsGetProcessHeap :: () -> *void extern fsWindowsKernel32 "GetProcessHeap";
fsWindowsHeapAlloc :: (heap: *void, flags: u32, bytes: u64) -> *void extern fsWindowsKernel32 "HeapAlloc";
fsWindowsHeapFree :: (heap: *void, flags: u32, memory: *void) -> i32 extern fsWindowsKernel32 "HeapFree";
fsWindowsCreateFileW :: (name: [*]u16, access: u32, share: u32, security: *void, creation: u32, attributes: u32, template: *void) -> *void extern fsWindowsKernel32 "CreateFileW";
fsWindowsCloseHandle :: (handle: *void) -> i32 extern fsWindowsKernel32 "CloseHandle";
fsWindowsReadFile :: (handle: *void, buffer: *void, bytes: u32, made: *u32, overlapped: *void) -> i32 extern fsWindowsKernel32 "ReadFile";
fsWindowsWriteFile :: (handle: *void, buffer: *void, bytes: u32, made: *u32, overlapped: *void) -> i32 extern fsWindowsKernel32 "WriteFile";
fsWindowsSetFilePointerEx :: (handle: *void, distance: i64, position: *i64, method: u32) -> i32 extern fsWindowsKernel32 "SetFilePointerEx";
fsWindowsSetEndOfFile :: (handle: *void) -> i32 extern fsWindowsKernel32 "SetEndOfFile";
fsWindowsGetFileAttributesW :: (name: [*]u16) -> u32 extern fsWindowsKernel32 "GetFileAttributesW";
fsWindowsDeleteFileW :: (name: [*]u16) -> i32 extern fsWindowsKernel32 "DeleteFileW";
fsWindowsRemoveDirectoryW :: (name: [*]u16) -> i32 extern fsWindowsKernel32 "RemoveDirectoryW";
fsWindowsCreateDirectoryW :: (name: [*]u16, security: *void) -> i32 extern fsWindowsKernel32 "CreateDirectoryW";
fsWindowsMoveFileExW :: (oldName: [*]u16, newName: [*]u16, flags: u32) -> i32 extern fsWindowsKernel32 "MoveFileExW";
fsWindowsCopyFileW :: (oldName: [*]u16, newName: [*]u16, failIfExists: i32) -> i32 extern fsWindowsKernel32 "CopyFileW";
fsWindowsSetFileAttributesW :: (name: [*]u16, attributes: u32) -> i32 extern fsWindowsKernel32 "SetFileAttributesW";
fsWindowsGetFileTime :: (handle: *void, created: *void, accessed: *void, written: *FsWindowsFileTime) -> i32 extern fsWindowsKernel32 "GetFileTime";
fsWindowsSetFileTime :: (handle: *void, created: *void, accessed: *void, written: *FsWindowsFileTime) -> i32 extern fsWindowsKernel32 "SetFileTime";

FS_WINDOWS_CP_UTF8               :u32: 65001;
FS_WINDOWS_GENERIC_READ          :u32: 0x80000000;
FS_WINDOWS_GENERIC_WRITE         :u32: 0x40000000;
FS_WINDOWS_FILE_WRITE_ATTRIBUTES :u32: 0x00000100;
FS_WINDOWS_FILE_SHARE_ALL        :u32: 7;
FS_WINDOWS_CREATE_ALWAYS         :u32: 2;
FS_WINDOWS_OPEN_EXISTING         :u32: 3;
FS_WINDOWS_OPEN_ALWAYS           :u32: 4;
FS_WINDOWS_FILE_ATTRIBUTE_NORMAL :u32: 0x80;
FS_WINDOWS_FILE_ATTRIBUTE_READONLY :u32: 0x01;
FS_WINDOWS_INVALID_ATTRIBUTES    :u32: 0xffffffff;
FS_WINDOWS_MOVEFILE_REPLACE_EXISTING :u32: 0x01;
