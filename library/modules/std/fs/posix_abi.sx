// Private POSIX ABI used by std.fs. This file is flat-imported by the POSIX
// implementation so its extern declarations and ABI constants are not authored
// by the public std.fs facade.

@import "modules/std/c.sx";

fsPosixUtimensat :: (directory: i32, path: [*:0]u8, times: *void, flags: i32) -> i32 extern c.libc "utimensat";
fsPosixFtruncate :: (fd: i32, len: i64) -> i32 extern c.libc "ftruncate";

// The Darwin SDK's realpath is the realpath$DARWIN_EXTSN symbol.
inline match @host.os {
    case .macos: fsPosixRealpath :: (path: [*:0]u8, resolved: [*]u8) -> ?[*:0]u8 extern c.libc "realpath$DARWIN_EXTSN";
    case .ios:   fsPosixRealpath :: (path: [*:0]u8, resolved: [*]u8) -> ?[*:0]u8 extern c.libc "realpath$DARWIN_EXTSN";
    else:        fsPosixRealpath :: (path: [*:0]u8, resolved: [*]u8) -> ?[*:0]u8 extern c.libc "realpath";
}

// Linux, Android, and Emscripten use the Linux asm-generic open flag values;
// Darwin uses the BSD values. Unsupported targets fail closed here.
// FS_POSIX_PATH_MAX is the libc PATH_MAX: the size realpath's output buffer must have.
inline match @host.os {
    case .linux:
        FS_POSIX_O_RDONLY :i32: 0x0000;
        FS_POSIX_O_WRONLY :i32: 0x0001;
        FS_POSIX_O_RDWR   :i32: 0x0002;
        FS_POSIX_O_APPEND :i32: 0x0400;
        FS_POSIX_O_CREAT  :i32: 0x0040;
        FS_POSIX_O_TRUNC  :i32: 0x0200;
        FS_POSIX_AT_FDCWD :i32: -100;
        FS_POSIX_UTIME_OMIT :i32: 1073741822;
        FS_POSIX_PATH_MAX :: 4096;
    case .android:
        FS_POSIX_O_RDONLY :i32: 0x0000;
        FS_POSIX_O_WRONLY :i32: 0x0001;
        FS_POSIX_O_RDWR   :i32: 0x0002;
        FS_POSIX_O_APPEND :i32: 0x0400;
        FS_POSIX_O_CREAT  :i32: 0x0040;
        FS_POSIX_O_TRUNC  :i32: 0x0200;
        FS_POSIX_AT_FDCWD :i32: -100;
        FS_POSIX_UTIME_OMIT :i32: 1073741822;
        FS_POSIX_PATH_MAX :: 4096;
    case .wasm:
        FS_POSIX_O_RDONLY :i32: 0x0000;
        FS_POSIX_O_WRONLY :i32: 0x0001;
        FS_POSIX_O_RDWR   :i32: 0x0002;
        FS_POSIX_O_APPEND :i32: 0x0400;
        FS_POSIX_O_CREAT  :i32: 0x0040;
        FS_POSIX_O_TRUNC  :i32: 0x0200;
        FS_POSIX_AT_FDCWD :i32: -100;
        FS_POSIX_UTIME_OMIT :i32: 1073741822;
        FS_POSIX_PATH_MAX :: 4096;
    case .macos:
        FS_POSIX_O_RDONLY :i32: 0x0000;
        FS_POSIX_O_WRONLY :i32: 0x0001;
        FS_POSIX_O_RDWR   :i32: 0x0002;
        FS_POSIX_O_APPEND :i32: 0x0008;
        FS_POSIX_O_CREAT  :i32: 0x0200;
        FS_POSIX_O_TRUNC  :i32: 0x0400;
        FS_POSIX_AT_FDCWD :i32: -2;
        FS_POSIX_UTIME_OMIT :i32: -2;
        FS_POSIX_PATH_MAX :: 1024;
    case .ios:
        FS_POSIX_O_RDONLY :i32: 0x0000;
        FS_POSIX_O_WRONLY :i32: 0x0001;
        FS_POSIX_O_RDWR   :i32: 0x0002;
        FS_POSIX_O_APPEND :i32: 0x0008;
        FS_POSIX_O_CREAT  :i32: 0x0200;
        FS_POSIX_O_TRUNC  :i32: 0x0400;
        FS_POSIX_AT_FDCWD :i32: -2;
        FS_POSIX_UTIME_OMIT :i32: -2;
        FS_POSIX_PATH_MAX :: 1024;
    else:
        @error("std/fs/posix_abi.sx: POSIX filesystem ABI is not defined for this target");
}

FS_POSIX_SEEK_SET :i32: 0;
FS_POSIX_SEEK_CUR :i32: 1;
FS_POSIX_SEEK_END :i32: 2;
FS_POSIX_F_OK     :i32: 0;
