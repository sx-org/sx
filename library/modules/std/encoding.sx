encoding :: scope {
    // Null for a non-scalar code point: negative, surrogate, or above 0x10FFFF.
    utf8Len :: (cp: i64) -> ?i64 {
        if cp < 0 or 0xD800 <= cp <= 0xDFFF or cp > 0x10FFFF { return null; }
        if cp < 0x80 { return 1; }
        if cp < 0x800 { return 2; }
        if cp < 0x10000 { return 3; }
        4
    }

    // Null for a non-scalar code point or insufficient output storage.
    encodeUtf8 :: (cp: i64, out: []u8) -> ?string {
        if n := utf8Len(cp) {
            if out.len < n { return null; }
            if n == 1 {
                out[0] = cp.(u8);
            } else if n == 2 {
                out[0] = (0xC0 | (cp >> 6)).(u8);
                out[1] = (0x80 | (cp & 0x3F)).(u8);
            } else if n == 3 {
                out[0] = (0xE0 | (cp >> 12)).(u8);
                out[1] = (0x80 | ((cp >> 6) & 0x3F)).(u8);
                out[2] = (0x80 | (cp & 0x3F)).(u8);
            } else {
                out[0] = (0xF0 | (cp >> 18)).(u8);
                out[1] = (0x80 | ((cp >> 12) & 0x3F)).(u8);
                out[2] = (0x80 | ((cp >> 6) & 0x3F)).(u8);
                out[3] = (0x80 | (cp & 0x3F)).(u8);
            }
            return out[..n];
        }
        null
    }

    // n is a 0..15 nibble.
    hexDigit :: (n: i64) -> u8 {
        if n < 10 then (n + '0').(u8) else (n - 10 + 'a').(u8)
    }

    hexValue :: (c: u8) -> ?i64 {
        if '0' <= c <= '9' { return c - '0'; }
        if 'a' <= c <= 'f' { return c - 'a' + 10; }
        if 'A' <= c <= 'F' { return c - 'A' + 10; }
        null
    }

    readU16Le :: (bytes: []u8, at: i64) -> i64 {
        bytes[at].(i64) | (bytes[at + 1].(i64) << 8)
    }

    readU32Le :: (bytes: []u8, at: i64) -> i64 {
        bytes[at].(i64) | (bytes[at + 1].(i64) << 8) | (bytes[at + 2].(i64) << 16) | (bytes[at + 3].(i64) << 24)
    }

    readU32Be :: (bytes: []u8, at: i64) -> i64 {
        (bytes[at].(i64) << 24) | (bytes[at + 1].(i64) << 16) | (bytes[at + 2].(i64) << 8) | bytes[at + 3].(i64)
    }
}
