// Sockets are BLOCKING — open a connection and call `request`. NOTE: a blocking
// client cannot interleave a server driven by `tick` on the SAME thread; run
// such a server on another thread (thread.Thread.spawn(... srv.run ...)) and
// drive the client from the main thread (see the corpus example).
//
// The blocking surface:
//   • `recv`/`recvOn` read Content-Length, close-delimited, or chunked
//     responses into storage from `context.allocator`, which the
//     ClientResponse holds until `deinit` returns it. Chunk framing is
//     removed, and gzip/deflate is decoded incrementally unless
//     ClientOpts.acceptCompression is false. ClientOpts.maxResponseBytes
//     bounds the bytes a response buffers.
//   • `send`/`sendOn` build each request in one allocation from
//     `context.allocator` and free it before returning.
//   • A ClientRequest's `method`, `path`, `host` and `extraHeaders` are
//     sent verbatim (no CRLF sanitisation) — pass trusted values. `fetch`
//     validates its `extraHeaders`.
@import "modules/std/http/wire.sx";
@import "modules/std/core.sx";         // Allocator
@import "modules/std/fmt.sx";          // concat, intToString
@import "modules/std/list.sx";         // List
@import "modules/std/mem.sx";
@import "modules/std/encoding.sx";     // hexValue
private clib :: @import "modules/std/c.sx";
@import "modules/std/posix.sx";
@import "modules/std/socket.sx";

private HDR_ACCEPT_ENCODING :: "Accept-Encoding: gzip, deflate\r\n";

ClientErr :: error {
    Connect;    // socket()/connect()/resolve failed; or the connect timed out
    Tls;        // the TLS dial failed (setup/handshake/VERIFICATION); or an
                // https URL was fetched without a dialer configured
    Send;       // write() failed: the server has gone, an io timeout expired,
                // or the socket faulted
    Recv;       // read() failed or timed out; the peer closed before a full
                // response; or chunked framing was malformed
    TooLarge;   // the response passed the connection's maxResponseBytes
    BadStatus;  // the status line was malformed / no header terminator
    Url;        // fetch: the URL did not parse (scheme/host/port)
    Redirect;   // fetch: the redirect chain exceeded maxRedirects
    Closed;     // recvOn: the peer closed before sending ANY response byte —
                // a clean EOF or an RST; which are the same fact reported
                // differently depending on a race — the stale-keep-alive
                // signature (the pool's ONLY safe retry window besides a send
                // fault: the request provably never executed)
    Allocation; // response storage or content-decoder state could not be
                // allocated
    Header;     // fetch: a caller header line is malformed or names a field
                // fetch writes itself (see `fetch`)
}

// ── sessions ──────────────────────────────────────────────────

// Options for `open`/`openAddr`. Zero values mean "unbounded/plaintext" —
// the behavior.
ClientOpts :: struct {
    // Bound the CONNECT (nonblocking connect + poll + SO_ERROR, then the fd
    // returns to blocking). 0 = a plain blocking connect.
    connectTimeoutMs: i64 = 0;
    // Bound every subsequent read/write (SO_RCVTIMEO/SNDTIMEO — per
    // OPERATION, not per response; an expiry surfaces as Send/Recv). 0 =
    // unbounded.
    ioTimeoutMs: i64 = 0;
    // Client TLS provider (e.g. tls_mbedtls.TlsClientConfig). null =
    // plaintext. The provider must outlive every connection it minted.
    tls: ?TlsDialer = null;
    // SNI/verification hostname for the TLS dial. "" = the host `open` was
    // given (openAddr has no host, so TLS there REQUIRES this). fetch
    // applies an explicit value to the FIRST hop only — a cross-host
    // redirect verifies against ITS OWN host.
    tlsHost: string = "";
    // how many redirects fetch follows (301/302/303 switch to GET
    // and drop the body; 307/308 preserve method + body). 0 = return the
    // 3xx un-followed; exceeding the cap is `ClientErr.Redirect`.
    maxRedirects: i64 = 5;
    // Advertise and transparently decode gzip/deflate. A caller-supplied
    // Accept-Encoding suppresses only the automatic field; decoding remains
    // enabled. False does neither and preserves every raw coding field/body.
    acceptCompression: bool = true;
    // Bound the bytes a response buffers: its head plus its body as it
    // arrives (chunk framing included until it is removed, decoded bytes for
    // a content-coded body). Passing it is `ClientErr.TooLarge`. null =
    // unbounded.
    maxResponseBytes: ?i64 = null;
}

// An open client connection: the fd plus the optional TLS session all
// send/recv on this conn route through.
ClientConn :: struct {
    fd: i32 = -1;
    tls: ?TlsConn = null;
    acceptCompression: bool = true;
    // Set only after sendOn has written a complete request. recvOn uses it
    // to apply HEAD's bodyless response framing before looking at CL/TE.
    requestWasHead: bool = false;
    maxResponseBytes: ?i64 = null;   // see ClientOpts.maxResponseBytes
}

// Open a connection to a prebuilt address (any family — unix included).
// See ClientOpts for the timeout/TLS behavior.
private openAddr :: (a: *socket.Addr, opts: ClientOpts) -> (ClientConn, !ClientErr) {
    c : ClientConn = .{};
    fd := socket.socket(socket.addrFamily(a), socket.SOCK_STREAM, 0);
    if fd < 0 { raise .Connect; }
    if !socket.setNoSigpipe(fd) { socket.close(fd); raise .Connect; }
    if opts.connectTimeoutMs > 0 {
        if !socket.connectTimed(fd, a, opts.connectTimeoutMs) {
            socket.close(fd);
            raise .Connect;
        }
    } else {
        if !socket.connectBlocking(fd, a) { socket.close(fd); raise .Connect; }
    }
    if opts.ioTimeoutMs > 0 {
        if !socket.setIoTimeout(fd, opts.ioTimeoutMs) { socket.close(fd); raise .Connect; }
    }
    c.fd = fd;
    c.acceptCompression = opts.acceptCompression;
    c.maxResponseBytes = opts.maxResponseBytes;
    if opts.tls != null {
        if opts.tlsHost.len == 0 { socket.close(fd); raise .Tls; }
        tc := opts.tls.connect(fd, opts.tlsHost);
        if tc == null { socket.close(fd); raise .Tls; }
        c.tls = tc;
    }
    return c;
}

// Resolve `host` (DNS or numeric) and open a connection. The TLS
// verification name defaults to `host` when opts.tlsHost is "".
private open :: (host: string, port: i64, opts: ClientOpts) -> (ClientConn, !ClientErr) {
    a, ok := socket.resolve(host, port);
    if !ok { raise .Connect; }
    o := opts;
    if o.tls != null and o.tlsHost.len == 0 { o.tlsHost = host; }
    return openAddr(*a, o);
}

// Close the connection (TLS close_notify + session teardown first).
private closeConn :: (c: *ClientConn) {
    if c.tls != null {
        c.tls.close();
        c.tls = null;
    }
    if c.fd >= 0 {
        socket.close(c.fd);
        c.fd = -1;
    }
}

// One write step through the session. Over a BLOCKING fd a Want step can
// only mean an io-timeout expiry (EAGAIN through the TLS bio) — retrying
// would wait the whole timeout again, forever; it is a Send failure.
private connWriteStep :: (c: *ClientConn, buf: [*]u8, len: i64) -> i64 {
    if c.tls != null {
        n, step := c.tls.write(buf, len);
        if step == TlsStep.Done { return n; }
        return -1;
    }
    n := socket.sendNoSigpipe(c.fd, buf, len);
    while n < 0 and socket.errno() == posix.EINTR { n = socket.sendNoSigpipe(c.fd, buf, len); }
    if n <= 0 { return -1; }
    return n;
}

// `connReadStep` sentinel: the read failed because the peer RST the conn.
// Distinct from -1 (any other read fault) so the caller can tell a stale
// keep-alive apart from a genuine receipt failure.
private READ_RESET :i64: -2;

// One read step: > 0 bytes, 0 = orderly end of stream, READ_RESET = the peer
// reset the conn, -1 = any other fault/timeout.
private connReadStep :: (c: *ClientConn, buf: [*]u8, cap: i64) -> i64 {
    if c.tls != null {
        n, step := c.tls.read(buf, cap);
        if step == TlsStep.Done { return n; }
        if step == TlsStep.Closed { return 0; }
        return -1;   // Want (io timeout on a blocking fd) or Fatal
    }
    n := socket.read(c.fd, buf, cap);
    while n < 0 and socket.errno() == posix.EINTR { n = socket.read(c.fd, buf, cap); }
    if n < 0 {
        // READ_RESET, not a generic fault: an idle keep-alive conn the peer
        // has closed answers the request we just wrote with an RST, and the
        // RST discards the queued EOF — so this read reports ECONNRESET where
        // a hair earlier it would have reported a clean 0. Same "never
        // executed" fact; `recvOn` must not let the timing decide.
        if socket.isConnReset(socket.errno()) { return READ_RESET; }
        return -1;
    }
    return n;
}

// One HTTP/1.1 request, as `send`, `sendOn` and `request` write it.
// `extraHeaders` is preformatted "Name: value\r\n" lines (may be ""); a
// Content-Length is added automatically for a non-empty `body`.
ClientRequest :: struct {
    method: string = "GET";
    path: string = "/";
    host: string = "";
    extraHeaders: string = "";
    body: string = "";
}

// A parsed HTTP response. `headersRaw` is the raw block between the status
// line and the body; `body` is the entity body. Every view points into
// `storage`, from `a`, until `deinit` returns it.
ClientResponse :: struct {
    status: i64 = 0;
    reason: string = "";
    headersRaw: string = "";
    body: string = "";
    // Transparent content decoding removes Content-Encoding and the encoded
    // Content-Length from headersRaw. null means no transform; a value names
    // the one coding removed. With acceptCompression=false this stays null.
    decodedFrom: ?ContentCoding = null;
    storage: []u8;
    a: Allocator;

    deinit :: (self: *ClientResponse) {
        mem.free(self.a, self.storage);
    }

    // Case-insensitive header lookup (`name` lowercase); "" when absent.
    // Reuses the server-side parser by viewing headersRaw as a request
    // header block — the shared-types payoff.
    header :: (self: *ClientResponse, name: string) -> string {
        req : Request = .{ headersRaw = self.headersRaw };
        return findHeader(*req, name);
    }
}

// Open a blocking TCP connection to ip:port. `ip` is a packed IPv4 address in
// the order socket.sockaddrIn wants (e.g. 0x0100007F for 127.0.0.1).
private dial :: (ip: u32, port: i64) -> (i32, !ClientErr) {
    sa := socket.sockaddrIn(port, ip);
    a : socket.Addr = .{ len = 16 };
    socket.copyBytes(*a.buf[0], @reinterpret([*]u8, *sa), 16);
    c := try openAddr(*a, .{});
    return c.fd;
}

// Send one HTTP/1.1 request on `fd`.
private send :: (fd: i32, req: ClientRequest) -> !ClientErr {
    conn : ClientConn = .{ fd = fd };
    return sendOn(*conn, req);
}

// Parse the status code out of a status line "HTTP/1.1 200 OK". Returns
// (status, reason); status 0 signals a malformed line.
private parseStatusLine :: (line: string) -> (i64, string) {
    // skip the version token to the first space
    p : i64 = 0;
    while p < line.len and line.ptr[p] != ' ' { p += 1; }
    if p >= line.len { return 0, ""; }
    p += 1;
    // three status digits
    code : i64 = 0;
    digits : i64 = 0;
    while p < line.len and line.ptr[p] >= '0' and line.ptr[p] <= '9' {
        code = code * 10 + (line.ptr[p] - '0');
        p += 1; digits += 1;
    }
    if digits == 0 { return 0, ""; }
    if p < line.len and line.ptr[p] == ' ' { p += 1; }
    reason := string{ ptr = *line.ptr[p], len = line.len - p };
    return code, reason;
}

// Read a full response on `fd`, using the same transfer/content decoding as
// recvOn.
private recv :: (fd: i32, requestMethod: string = "GET", maxResponseBytes: ?i64 = null) -> (ClientResponse, !ClientErr) {
    conn : ClientConn = .{ fd = fd, requestWasHead = ceAsciiIeq(requestMethod, "head"), maxResponseBytes = maxResponseBytes };
    recvOn(*conn)
}

// Send one HTTP/1.1 request on an open ClientConn (TLS-aware `send`).
// The request is built into ONE allocation and freed before returning — no
// arena required, nothing retained (a concat chain would leak every
// intermediate into the caller's context). `credentials` false leaves the
// Authorization and Cookie lines of `req.extraHeaders` out.
private sendOn :: (c: *ClientConn, req: ClientRequest, credentials: bool = true) -> !ClientErr {
    advertise := c.acceptCompression
        and !hasHeader(req.extraHeaders, "accept-encoding")
        and !hasHeader(req.extraHeaders, "range");
    // Content-Length digits on the stack.
    clbuf : [20]u8 = ---;
    cln : i64 = 0;
    if req.body.len > 0 {
        v := req.body.len;
        tmp : [20]u8 = ---;
        tn : i64 = 0;
        while v > 0 { tmp[tn] = ('0' + v % 10).(u8); v = v / 10; tn += 1; }
        while tn > 0 { tn -= 1; clbuf[cln] = tmp[tn]; cln += 1; }
    }
    total := req.method.len + 1 + req.path.len + 11            // "<m> <p> HTTP/1.1\r\n"
           + 6 + req.host.len + 2;                             // "Host: <h>\r\n"
    if req.body.len > 0 { total += 16 + cln + 2; }             // "Content-Length: <n>\r\n"
    if advertise { total += HDR_ACCEPT_ENCODING.len; }
    total += req.extraHeaders.len + 2 + req.body.len;          // "<extra>\r\n<body>"
    p : [*]u8 = mem.alloc(context.allocator, u8, total).ptr;
    w : i64 = 0;
    w = put(p, w, req.method);
    p[w] = ' '; w += 1;
    w = put(p, w, req.path);
    w = put(p, w, " HTTP/1.1\r\n");
    w = put(p, w, "Host: ");
    w = put(p, w, req.host);
    w = put(p, w, "\r\n");
    if req.body.len > 0 {
        w = put(p, w, "Content-Length: ");
        cli : i64 = 0;
        while cli < cln { p[w] = clbuf[cli]; w += 1; cli += 1; }
        w = put(p, w, "\r\n");
    }
    if credentials { w = put(p, w, req.extraHeaders); }
    else { w = putWithoutCredentials(p, w, req.extraHeaders); }
    if advertise { w = put(p, w, HDR_ACCEPT_ENCODING); }
    w = put(p, w, "\r\n");
    w = put(p, w, req.body);

    sent : i64 = 0;
    failed := false;
    while sent < w {
        n := connWriteStep(c, *p[sent], w - sent);
        if n <= 0 { failed = true; break; }
        sent += n;
    }
    context.allocator.deallocBytes(p);
    if failed { raise .Send; }
    c.requestWasHead = ceAsciiIeq(req.method, "head");
    return;
}

// Append `s` into the request build at offset `w`, returning the new offset.
private put :: (p: [*]u8, w: i64, s: string) -> i64 {
    if s.len > 0 { clib.c.memcpy(*p[w], s.ptr, s.len); }
    return w + s.len;
}

// `put` for the lines of a `validFetchHeaders` block not named
// Authorization or Cookie.
private putWithoutCredentials :: (p: [*]u8, w: i64, block: string) -> i64 {
    out := w;
    at : i64 = 0;
    while at < block.len {
        colon := at;
        while block[colon] != ':' { colon += 1; }
        end := colon;
        while block[end] != '\n' { end += 1; }
        end += 1;
        name := block[at..colon];
        if !ceAsciiIeq(name, "authorization") and !ceAsciiIeq(name, "cookie") {
            out = put(p, out, block[at..end]);
        }
        at = end;
    }
    out
}

// Whether `block` is an `extraHeaders` block `fetch` accepts.
private validFetchHeaders :: (block: string) -> bool {
    at : i64 = 0;
    while at < block.len {
        colon := at;
        while colon < block.len and isTchar(block[colon]) { colon += 1; }
        if colon == at or colon >= block.len or block[colon] != ':' { return false; }
        name := block[at..colon];
        if ceAsciiIeq(name, "host") or ceAsciiIeq(name, "content-length")
            or ceAsciiIeq(name, "transfer-encoding") { return false; }
        end := colon + 1;
        while end < block.len and block[end] != '\r' and block[end] != '\n' and block[end] != 0 { end += 1; }
        if end + 1 >= block.len or block[end] != '\r' or block[end + 1] != '\n' { return false; }
        at = end + 2;
    }
    true
}

// ── URL fetch + redirects ─────────────────────────────────────

// A parsed URL target. `host`/`path` are VIEWS into the parsed text.
private Url :: struct {
    https: bool = false;
    host: string = "";
    port: i64 = 0;      // defaulted from the scheme when absent
    path: string = "/";
}

private startsWith :: (s: string, prefix: string) -> bool {
    if s.len < prefix.len { return false; }
    i : i64 = 0;
    while i < prefix.len {
        if s[i] != prefix[i] { return false; }
        i += 1;
    }
    return true;
}

// Minimal absolute URL: scheme://host[:port][/path...]. Bracketed v6
// literals supported ([::1]:8080). The path view carries everything after
// the authority up to the fragment; userinfo and the query are not split.
private parseUrl :: (url: string) -> (Url, bool) {
    u : Url = .{};
    rest := "";
    if startsWith(url, "http://") {
        u.https = false;
        u.port = 80;
        rest = string{ ptr = *url.ptr[7], len = url.len - 7 };
    } else if startsWith(url, "https://") {
        u.https = true;
        u.port = 443;
        rest = string{ ptr = *url.ptr[8], len = url.len - 8 };
    } else {
        return u, false;
    }
    if rest.len == 0 { return u, false; }
    // authority: [v6] or a name/v4 up to ':' or '/'
    he : i64 = 0;          // just past the host
    ps : i64 = 0;          // where ':' / '/' scanning resumes
    if rest[0] == '[' {
        he = 1;
        while he < rest.len and rest[he] != ']' { he += 1; }
        if he >= rest.len { return u, false; }
        u.host = string{ ptr = *rest.ptr[1], len = he - 1 };
        ps = he + 1;
    } else {
        while he < rest.len and rest[he] != ':' and rest[he] != '/' { he += 1; }
        u.host = string{ ptr = rest.ptr, len = he };
        ps = he;
    }
    if u.host.len == 0 { return u, false; }
    if ps < rest.len and rest[ps] == ':' {   // port
        ps += 1;
        v : i64 = 0;
        d : i64 = 0;
        while ps < rest.len and rest[ps] >= '0' and rest[ps] <= '9' {
            v = v * 10 + (rest[ps] - '0');
            ps += 1;
            d += 1;
        }
        // Bound the digit COUNT too — an attacker-controlled Location with
        // 2^64-ish digits wraps i64 back into range.
        if d == 0 or d > 5 or v < 1 or v > 65535 { return u, false; }
        u.port = v;
    }
    if ps < rest.len {
        if rest[ps] != '/' { return u, false; }   // junk between port and path
        u.path = string{ ptr = *rest.ptr[ps], len = rest.len - ps };
    }
    u.path = stripFragment(u.path);
    return u, true;
}

// `u` with its host and path copied into `text`, one allocation from
// `context.allocator` that the caller frees.
private ownUrl :: (u: Url) -> (Url, []u8, !ClientErr) {
    text := mem.alloc(context.allocator, u8, u.host.len + u.path.len);
    if text.ptr == null { raise .Allocation; }
    put(text.ptr, put(text.ptr, 0, u.host), u.path);
    o := u;
    o.host = text[0 .. u.host.len];
    o.path = text[u.host.len ..];
    return o, text;
}

// Whether a fetch hop to `u` carries the caller's credential lines: only
// when it shares the first URL's origin (scheme, host, port).
private sameOrigin :: (origin: Url, u: Url) -> bool {
    return origin.https == u.https and origin.port == u.port and ceAsciiIeq(origin.host, u.host);
}

// `req` sent to `u` over a FRESH connection; the conn is returned (still
// open) alongside the response for the caller to reuse or close.
// `verifyHost` is the TLS name ("" = the URL host).
private fetchHop :: (u: Url, req: ClientRequest, credentials: bool, opts: ClientOpts, verifyHost: string) -> (ClientConn, ClientResponse, !ClientErr) {
    o := opts;
    if u.https {
        if o.tls == null { raise .Tls; }   // never plaintext to an https target
        if verifyHost.len > 0 { o.tlsHost = verifyHost; }
        else { o.tlsHost = u.host; }
    } else {
        o.tls = null;                            // an http hop is plaintext even with a dialer configured
    }
    c, oe := open(u.host, u.port, o);
    if oe { raise oe; }
    se := sendOn(*c, req, credentials);
    if se { closeConn(*c); raise se; }
    r, re := recvOn(*c);
    if re { closeConn(*c); raise re; }
    return c, r;
}

// Truncate at '#' — fragments never go on the wire (RFC 9112). "" → "/".
private stripFragment :: (s: string) -> string {
    i : i64 = 0;
    while i < s.len {
        if s[i] == '#' { break; }
        i += 1;
    }
    if i == 0 { return "/"; }
    return string{ ptr = s.ptr, len = i };
}

// The target a redirect's Location `loc` names from `u`, or null when `loc`
// is neither an absolute http(s) URL nor `/`-relative. A relative one keeps
// `u`'s scheme, host and port. The path views `loc` without its fragment.
private resolveLocation :: (u: Url, loc: string) -> ?Url {
    if loc.len > 0 and loc[0] == '/' {
        t := u;
        t.path = stripFragment(loc);
        return t;
    }
    t, ok := parseUrl(loc);
    if !ok { return null; }
    return t;
}

private connectionSaysClose :: (v: string) -> bool {
    i : i64 = 0;
    while i < v.len {
        // token start: skip OWS and commas
        while i < v.len and (v[i] == ' ' or v[i] == '\t' or v[i] == ',') { i += 1; }
        s := i;
        while i < v.len and v[i] != ',' { i += 1; }
        e := i;
        while e > s and (v[e - 1] == ' ' or v[e - 1] == '\t') { e -= 1; }
        if e - s == 5 {
            same := true;
            want := "close";
            j : i64 = 0;
            while j < 5 {
                ch := v[s + j];
                if ch >= 'A' and ch <= 'Z' { ch = ch + ' '; }
                if ch != want[j] { same = false; break; }
                j += 1;
            }
            if same { return true; }
        }
    }
    return false;
}

// "chunked" exactly, ASCII-case-insensitively (RFC 9112: the only coding we
// implement; it must also be the FINAL one, which an exact match enforces).
private teIsChunked :: (te: string) -> bool {
    if te.len != 7 { return false; }
    want := "chunked";
    i : i64 = 0;
    while i < 7 {
        ch := te[i];
        if ch >= 'A' and ch <= 'Z' { ch = ch + ' '; }
        if ch != want[i] { return false; }
        i += 1;
    }
    return true;
}

private isRedirect :: (status: i64) -> bool {
    return status == 301 or status == 302 or status == 303 or status == 307 or status == 308;
}

// Fetch `url`, following redirects per opts.maxRedirects. 301/302/303
// re-issue as a bodyless GET; 307/308 preserve method + body. A relative
// Location keeps the scheme/host/port; an absolute one re-resolves (and
// re-verifies TLS against ITS host — an explicit opts.tlsHost pins the
// FIRST hop only). A 3xx without a Location is returned as-is.
//
// Cross-scheme hops: an https→http Location is followed as PLAINTEXT
// (curl-parity would warn — treat redirect targets you don't control as
// untrusted); http→https needs opts.tls (`ClientErr.Tls` mid-chain otherwise).
// Timeouts are per OPERATION per HOP — a full chain can take up to
// (maxRedirects + 1) × (connect + io) timeouts.
//
// `extraHeaders` is preformatted "Name: value\r\n" lines (may be "") sent on
// every hop, except that Authorization and Cookie lines go only to hops on
// the first URL's origin (scheme, host, port). A line that is not
// `token ":" value CRLF`, holds CR, LF or NUL inside its value, or names
// Host, Content-Length or Transfer-Encoding raises `ClientErr.Header`
// before any connection opens.
//
// Each hop's response is read into storage from `context.allocator`; a
// redirect's is returned once its Location is copied, and the returned
// response holds its own until `deinit`.
private fetch :: (method: string, url: string, extraHeaders: string, body: string, opts: ClientOpts) -> (ClientResponse, !ClientErr) {
    u, ok := parseUrl(url);
    if !ok { raise .Url; }
    if !validFetchHeaders(extraHeaders) { raise .Header; }
    origin := u;
    // The current target's host and path, once a redirect has named it.
    target : ?[]u8 = null;
    defer if t := target { mem.free(context.allocator, t); };
    req : ClientRequest = .{ method = method, path = u.path, host = u.host, extraHeaders = extraHeaders, body = body };
    hops : i64 = 0;
    first := true;
    while true {
        vh := if first then opts.tlsHost else "";
        c, r, he := fetchHop(u, req, sameOrigin(origin, u), opts, vh);
        if he { raise he; }
        closeConn(*c);
        if !isRedirect(r.status) or opts.maxRedirects <= 0 { return r; }
        loc := r.header("location");
        if loc.len == 0 { return r; }
        status := r.status;
        hops += 1;
        if hops > opts.maxRedirects { r.deinit(); raise .Redirect; }
        nu := resolveLocation(u, loc);
        if nu == null { r.deinit(); raise .Url; }
        owned, text, oe := ownUrl(nu);
        r.deinit();
        if oe { raise oe; }
        if t := target { mem.free(context.allocator, t); }
        target = text;
        u = owned;
        req.path = u.path;
        req.host = u.host;
        if status == 301 or status == 302 or status == 303 {
            req.method = "GET";
            req.body = "";
        }
        first = false;
    }
    raise .Url;   // unreachable — the loop returns or raises
}

private CLIENT_WIRE_PIECE :: 16384;
private CLIENT_LINE_LIMIT :: 8192;

private EncodedChunkPhase :: enum {
    size;
    extension;
    sizeLf;
    data;
    dataCr;
    dataLf;
    trailer;
    trailerLf;
    done;
}

// Feed one content-coded payload span into the decoder. The returned counts
// are relative to this span/output window; `done` means the content coding
// reached its terminal checksum/trailer.
private feedContentDecoder :: (decoder: *Decoder, input: string, output: string) -> (i64, i64, bool, !ClientErr) {
    progress := decoder.read(input, output) catch |e| {
        if e == .OutputLimit { raise .TooLarge; }
        raise .Recv;
    };
    return progress.consumed, progress.produced, progress.status == .done;
}

private finishContentDecoder :: (decoder: *Decoder, output: string) -> (i64, bool, !ClientErr) {
    progress := decoder.finish(output) catch |e| {
        if e == .OutputLimit { raise .TooLarge; }
        raise .Recv;
    };
    return progress.produced, progress.status == .done;
}

// `buf` grown to at least `want` bytes and at most `limit`, doubling its
// length and keeping its bytes. `.TooLarge` when `want` passes `limit`.
private growResponse :: (buf: []u8, want: i64, limit: ?i64) -> ([]u8, !ClientErr) {
    if want <= buf.len { return buf; }
    n := buf.len * 2;
    if n < want { n = want; }
    if l := limit {
        if want > l { raise .TooLarge; }
        if n > l { n = l; }
    }
    grown := mem.resize(context.allocator, buf, n);
    if grown == null { raise .Allocation; }
    return grown;
}

// The unwritten tail of `buf.*` from `at`, grown first when it is empty;
// "" once `buf.*` has reached `limit`.
private outputWindow :: (buf: *[]u8, at: i64, limit: ?i64) -> (string, !ClientErr) {
    if at >= buf.len {
        if l := limit { if buf.len >= l { return ""; } }
        buf.* = try growResponse(buf.*, at + 1, limit);
    }
    return buf.*[at ..];
}

// Header compaction leaves the decoded body at its original headEnd;
// only the public headersRaw view shrinks.
private normalizeDecodedHeaders :: (raw: [*]u8, len: i64) -> i64 {
    readAt : i64 = 0;
    writeAt : i64 = 0;
    while readAt < len {
        lineEnd := readAt;
        while lineEnd < len and raw[lineEnd] != '\r' and raw[lineEnd] != '\n' { lineEnd += 1; }
        after := lineEnd;
        if after < len and raw[after] == '\r' { after += 1; }
        if after < len and raw[after] == '\n' { after += 1; }
        colon := readAt;
        while colon < lineEnd and raw[colon] != ':' { colon += 1; }
        remove := false;
        if colon < lineEnd {
            field := string{ ptr = *raw[readAt], len = colon - readAt };
            remove = ceAsciiIeq(field, "content-encoding")
                or ceAsciiIeq(field, "content-length");
        }
        if !remove {
            count := after - readAt;
            if writeAt != readAt { clib.c.memmove(*raw[writeAt], *raw[readAt], count); }
            writeAt += count;
        }
        readAt = after;
    }
    writeAt
}

// Decode a gzip/deflate response while its transfer framing is read. The
// decoded body lands in `buf.*` from `headEnd`, growing it up to `limit`;
// compressed wire bytes live only in one 16 KiB stack window, so chunked and
// close-delimited responses do not require buffering their encoded form.
// `initial` is the body prefix that arrived with the header read and is
// copied before output can overwrite it.
private recvEncodedBody :: (c: *ClientConn, buf: *[]u8, limit: ?i64, headEnd: i64,
                      initial: string, contentLen: i64, chunked: bool,
                      contentEncoding: Encoding) -> (i64, !ClientErr) {
    outputCap : i64 = i64.max;
    if l := limit { outputCap = l - headEnd; }
    decoder := Decoder.init(contentEncoding, outputCap, context.allocator) catch |e| {
        if e == .AllocationFailed { raise .Allocation; }
        raise .Recv;
    };
    defer decoder.deinit();

    wire : [CLIENT_WIRE_PIECE]u8 = ---;
    if initial.len > CLIENT_WIRE_PIECE { raise .TooLarge; }
    if initial.len > 0 { clib.c.memcpy(*wire[0], initial.ptr, initial.len); }
    wireAt : i64 = 0;
    wireLen : i64 = initial.len;
    outputAt : i64 = 0;
    transferDone := false;
    decoderDone := false;
    fixedLeft := contentLen;

    phase := EncodedChunkPhase.size;
    chunkSize: i64 = 0;
    chunkLeft: i64 = 0;
    sizeDigits : i64 = 0;
    lineLen : i64 = 0;

    while !transferDone {
        // Content-Length is a wire-length delimiter. A zero-length encoded
        // body is still passed to finish below, which correctly rejects a
        // missing gzip/zlib stream.
        if !chunked and contentLen >= 0 and fixedLeft == 0 {
            if wireAt != wireLen { raise .Recv; }
            transferDone = true;
            break;
        }

        if wireAt >= wireLen {
            n := connReadStep(c, *wire[0], CLIENT_WIRE_PIECE);
            if n < 0 { raise .Recv; }
            if n == 0 {
                if chunked or contentLen >= 0 { raise .Recv; }
                transferDone = true; // close-delimited body
                break;
            }
            wireAt = 0;
            wireLen = n;
        }

        if !chunked {
            take := wireLen - wireAt;
            if contentLen >= 0 and take > fixedLeft { take = fixedLeft; }
            if decoderDone and take > 0 { raise .Recv; }
            while take > 0 {
                output := try outputWindow(buf, headEnd + outputAt, limit);
                consumed, produced, done := try feedContentDecoder(*decoder,
                    string{ ptr = *wire[wireAt], len = take }, output);
                wireAt += consumed;
                take -= consumed;
                if contentLen >= 0 { fixedLeft -= consumed; }
                outputAt += produced;
                if done {
                    decoderDone = true;
                    if take > 0 { raise .Recv; }
                }
                if outputAt >= outputCap and !decoderDone and take > 0 { raise .TooLarge; }
                if consumed == 0 and produced == 0 { raise .Recv; }
            }
            continue;
        }

        // Incremental chunked transfer parser. Only chunk DATA is handed to
        // the content decoder; size lines, extensions, CRLF and trailers are
        // validated and discarded in bounded state.
        if phase == .data {
            available := wireLen - wireAt;
            take := if available < chunkLeft then available else chunkLeft;
            if decoderDone and take > 0 { raise .Recv; }
            while take > 0 {
                output := try outputWindow(buf, headEnd + outputAt, limit);
                consumed, produced, done := try feedContentDecoder(*decoder,
                    string{ ptr = *wire[wireAt], len = take }, output);
                wireAt += consumed;
                take -= consumed;
                chunkLeft -= consumed;
                outputAt += produced;
                if done {
                    decoderDone = true;
                    if take > 0 or chunkLeft > 0 { raise .Recv; }
                }
                if outputAt >= outputCap and !decoderDone and take > 0 { raise .TooLarge; }
                if consumed == 0 and produced == 0 { raise .Recv; }
            }
            if chunkLeft == 0 { phase = .dataCr; }
            continue;
        }

        b := wire[wireAt];
        wireAt += 1;
        if phase == .size {
            if digit := encoding.hexValue(b) {
                if chunkSize > 0x07FFFFFFFFFFFFFF { raise .Recv; }
                chunkSize = chunkSize * 16 + digit;
                sizeDigits += 1;
                lineLen += 1;
                if lineLen > CLIENT_LINE_LIMIT { raise .Recv; }
            } else if b == ';' and sizeDigits > 0 {
                phase = .extension;
                lineLen += 1;
            } else if b == '\r' and sizeDigits > 0 {
                phase = .sizeLf;
            } else {
                raise .Recv;
            }
            continue;
        }
        if phase == .extension {
            if b == '\r' { phase = .sizeLf; }
            else {
                if b == '\n' { raise .Recv; }
                lineLen += 1;
                if lineLen > CLIENT_LINE_LIMIT { raise .Recv; }
            }
            continue;
        }
        if phase == .sizeLf {
            if b != '\n' { raise .Recv; }
            if chunkSize == 0 {
                phase = .trailer;
                lineLen = 0;
            } else {
                chunkLeft = chunkSize;
                phase = .data;
            }
            continue;
        }
        if phase == .dataCr {
            if b != '\r' { raise .Recv; }
            phase = .dataLf;
            continue;
        }
        if phase == .dataLf {
            if b != '\n' { raise .Recv; }
            phase = .size;
            chunkSize = 0;
            sizeDigits = 0;
            lineLen = 0;
            continue;
        }
        if phase == .trailer {
            if b == '\r' { phase = .trailerLf; }
            else {
                if b == '\n' { raise .Recv; }
                lineLen += 1;
                if lineLen > CLIENT_LINE_LIMIT { raise .Recv; }
            }
            continue;
        }
        if phase == .trailerLf {
            if b != '\n' { raise .Recv; }
            if lineLen == 0 {
                phase = .done;
                if wireAt != wireLen { raise .Recv; }
                transferDone = true;
            } else {
                lineLen = 0;
                phase = .trailer;
            }
            continue;
        }
        raise .Recv;
    }

    while !decoderDone {
        output := try outputWindow(buf, headEnd + outputAt, limit);
        produced, done := try finishContentDecoder(*decoder, output);
        outputAt += produced;
        decoderDone = done;
        if !done and outputAt >= outputCap { raise .TooLarge; }
        if !done and produced == 0 { raise .Recv; }
    }
    outputAt
}

private validContentLength :: (value: string) -> (i64, bool) {
    if value.len == 0 { return 0, false; }
    result : i64 = 0;
    i : i64 = 0;
    while i < value.len {
        b := value[i];
        if b < '0' or b > '9' { return 0, false; }
        if result > 0x0CCCCCCCCCCCCCCC { return 0, false; }
        result = result * 10 + (b - '0');
        if result < 0 { return 0, false; }
        i += 1;
    }
    return result, true;
}

// Read a full response on an open ClientConn. The status and request method are
// known before body framing is chosen: HEAD and 1xx/204/304 never consume a
// body, and informational heads are consumed until the final response.
private responseHeadEnd :: (buf: [*]u8, len: i64) -> i64 {
    i : i64 = 0;
    while i + 3 < len {
        if buf[i] == '\r' and buf[i+1] == '\n' and buf[i+2] == '\r' and buf[i+3] == '\n' { return i + 4; }
        i += 1;
    }
    -1
}

private recvOn :: (c: *ClientConn) -> (ClientResponse, !ClientErr) {
    limit := c.maxResponseBytes;
    firstCap : i64 = CLIENT_WIRE_PIECE;
    if l := limit { if l < firstCap { firstCap = l; } }
    buf := mem.alloc(context.allocator, u8, firstCap);
    if buf.ptr == null and firstCap > 0 { raise .Allocation; }
    kept := false;
    defer if !kept mem.free(context.allocator, buf);
    total : i64 = 0;
    headEnd : i64 = -1;
    headerStart : i64 = 0;
    statusLineLen : i64 = 0;
    contentLen : i64 = -1;
    chunked := false;
    scan : ChunkScan = .{};
    decoded : i64 = -1;
    encoding := Encoding.identity;
    decodedFrom : ?ContentCoding = null;
    normalizedHeadersLen : i64 = -1;
    finalStatus: i64 = 0;
    requestWasHead := c.requestWasHead;
    c.requestWasHead = false;
    sawInformational := false;

    while true {
        // Parse any complete head already buffered. This runs before another
        // read so a coalesced 1xx + final response cannot block waiting for
        // bytes that are already buffered.
        if headEnd < 0 { headEnd = responseHeadEnd(buf.ptr, total); }
        if headEnd >= 0 and finalStatus == 0 {
            sl : i64 = 0;
            while sl + 1 < headEnd and !(buf[sl] == '\r' and buf[sl+1] == '\n') { sl += 1; }
            if sl + 1 >= headEnd { raise .BadStatus; }
            code, _ := parseStatusLine(buf[0 .. sl]);
            if code == 0 { raise .BadStatus; }

            if code >= 100 and code < 200 {
                remaining := total - headEnd;
                if remaining > 0 { clib.c.memmove(buf.ptr, *buf[headEnd], remaining); }
                total = remaining;
                headEnd = -1;
                sawInformational = true;
                continue;
            }

            finalStatus = code;
            statusLineLen = sl;
            headerStart = sl + 2;
            hdrs := buf[headerStart .. headEnd - 2];

            if !(requestWasHead or code == 204 or code == 304) {
                tmp : Request = .{ headersRaw = hdrs };
                teCount := countHeader(*tmp, "transfer-encoding");
                clCount := countHeader(*tmp, "content-length");
                if teCount > 1 or clCount > 1 { raise .Recv; }
                if teCount > 0 and clCount > 0 { raise .Recv; }
                te := findHeader(*tmp, "transfer-encoding");
                if te.len > 0 {
                    if !teIsChunked(te) { raise .Recv; }
                    chunked = true;
                } else {
                    cl := findHeader(*tmp, "content-length");
                    if clCount > 0 {
                        v, valid := validContentLength(cl);
                        if !valid { raise .Recv; }
                        contentLen = v;
                    }
                }

                rangeResponse := code == 206 or code == 416 or hasHeader(hdrs, "content-range");
                if c.acceptCompression and !rangeResponse {
                    ceCount := countHeader(*tmp, "content-encoding");
                    if ceCount > 0 {
                        if ceCount != 1 { raise .Recv; }
                        encoding = parseContentEncoding(findHeader(*tmp, "content-encoding"));
                        if encoding == .unacceptable { raise .Recv; }
                    }
                    if encoding != .identity {
                        decoded = try recvEncodedBody(c, *buf, limit, headEnd,
                            buf[headEnd .. total], contentLen, chunked, encoding);
                        decodedFrom = if encoding == .gzip then ContentCoding.gzip else ContentCoding.deflate;
                        normalizedHeadersLen = normalizeDecodedHeaders(*buf[headerStart], headEnd - 2 - headerStart);
                        total = headEnd + decoded;
                        break;
                    }
                }
            }
        }

        if headEnd >= 0 and finalStatus > 0 {
            bodyless := requestWasHead or finalStatus == 204 or finalStatus == 304;
            if bodyless {
                total = headEnd;
                decoded = 0;
                break;
            }
            if chunked {
                maxBody : i64 = i64.max;
                if l := limit { maxBody = l - headEnd; }
                r := decodeChunked(*buf[headEnd], total - headEnd, maxBody, scan);
                if r.status == ChunkStatus.OK { decoded = r.decodedLen; break; }
                if r.status == ChunkStatus.TOO_BIG { raise .TooLarge; }
                if r.status != ChunkStatus.NEED_MORE { raise .Recv; }
                scan.rp = r.resumeRp;
                scan.decoded = r.resumeDecoded;
            } else if contentLen >= 0 and total - headEnd >= contentLen {
                break;
            }
        }

        buf = try growResponse(buf, total + 1, limit);
        room := buf.len - total;
        if headEnd < 0 and room > CLIENT_WIRE_PIECE { room = CLIENT_WIRE_PIECE; }
        n := connReadStep(c, *buf[total], room);
        if n == READ_RESET and total == 0 and !sawInformational { raise .Closed; }
        if n < 0 { raise .Recv; }
        if n == 0 {
            if total == 0 {
                if sawInformational { raise .Recv; }
                raise .Closed;
            }
            if headEnd < 0 { raise .BadStatus; }
            if chunked { raise .Recv; }
            if contentLen >= 0 and total - headEnd < contentLen { raise .Recv; }
            break;
        }
        total += n;
    }
    if headEnd < 0 or finalStatus == 0 { raise .BadStatus; }

    bodyLen := if decoded >= 0 then decoded
                else if contentLen >= 0 then contentLen
                else total - headEnd;
    headersLen := if normalizedHeadersLen >= 0 then normalizedHeadersLen else headEnd - 2 - headerStart;
    _, reason := parseStatusLine(buf[0 .. statusLineLen]);
    kept = true;
    return ClientResponse{
        status = finalStatus,
        reason = reason,
        headersRaw = buf[headerStart .. headerStart + headersLen],
        body = buf[headEnd .. headEnd + bodyLen],
        decodedFrom = decodedFrom,
        storage = buf,
        a = context.allocator,
    };
}

// Convenience: dial ip:port, send `req`, read the response, close the
// connection. One blocking round-trip.
private request :: (ip: u32, port: i64, req: ClientRequest, maxResponseBytes: ?i64 = null) -> (ClientResponse, !ClientErr) {
    fd := try dial(ip, port);
    defer socket.close(fd);
    try send(fd, req);
    return recv(fd, req.method, maxResponseBytes);
}

// ── keep-alive connection pool ────────────────────────────────

// One pooled keep-alive connection, keyed (https, host, port). `host` is a
// copy from the pool's allocator.
private PoolEntry :: struct {
    host: string;
    port: i64 = 0;
    https: bool = false;
    conn: ClientConn;
    live: bool = false;
}

// A SINGLE-THREADED keep-alive pool: fetch reuses an open connection to the
// same (scheme, host, port) when one exists; a REUSED connection that
// faults at send or receive is dropped and the request retried ONCE on a
// fresh dial (the stale-keep-alive race — the server may have evicted the
// idle conn between requests). NOT thread-safe; one pool per thread.
// Entries grow through the allocator captured at init (the long-lived-
// container rule), which must outlive the pool.
ClientPool :: struct {
    opts: ClientOpts;
    entries: List(PoolEntry);
    a: Allocator;

    init :: (opts: ClientOpts) -> ClientPool {
        return .{ opts = opts, a = context.allocator };
    }

    // Fetch through the pool. Redirect hops are followed with the SAME
    // pooling (each hop reuses/creates its host's entry). `extraHeaders`
    // is validated, `method`, `extraHeaders` and `body` are sent, and each
    // response is read into storage from `context.allocator`, as by the
    // free `fetch`.
    fetch :: (self: *ClientPool, method: string, url: string, extraHeaders: string, body: string) -> (ClientResponse, !ClientErr) {
        u, ok := parseUrl(url);
        if !ok { raise .Url; }
        if !validFetchHeaders(extraHeaders) { raise .Header; }
        origin := u;
        target : ?[]u8 = null;
        defer if t := target { mem.free(context.allocator, t); };
        req : ClientRequest = .{ method = method, path = u.path, host = u.host, extraHeaders = extraHeaders, body = body };
        hops : i64 = 0;
        first := true;
        while true {
            r := try self.hop(u, req, sameOrigin(origin, u), first);
            if !isRedirect(r.status) or self.opts.maxRedirects <= 0 { return r; }
            loc := r.header("location");
            if loc.len == 0 { return r; }
            status := r.status;
            hops += 1;
            if hops > self.opts.maxRedirects { r.deinit(); raise .Redirect; }
            nu := resolveLocation(u, loc);
            if nu == null { r.deinit(); raise .Url; }
            owned, text, oe := ownUrl(nu);
            r.deinit();
            if oe { raise oe; }
            if t := target { mem.free(context.allocator, t); }
            target = text;
            u = owned;
            req.path = u.path;
            req.host = u.host;
            if status == 301 or status == 302 or status == 303 {
                req.method = "GET";
                req.body = "";
            }
            first = false;
        }
        raise .Url;   // unreachable — the loop returns or raises
    }

    // One pooled request: reuse the entry when live, else dial + store.
    // RETRY POLICY : a fresh dial retries a REUSED conn
    // only when the request provably never executed — a SEND fault, or the
    // peer closing before any response byte (`ClientErr.Closed`, the stale-keep-
    // alive signature). Every receipt failure after bytes arrived
    // (TooLarge/BadStatus/Recv) propagates AS ITSELF: the server may have
    // executed the request, and re-sending would double side effects.
    hop :: (self: *ClientPool, u: Url, req: ClientRequest, credentials: bool, first: bool) -> (ClientResponse, !ClientErr) {
        idx := self.find(u);
        reused := idx >= 0 and self.entries.items[idx].live;
        attempt : i64 = 0;
        while true {
            if idx < 0 or !self.entries.items[idx].live {
                c, oe := self.dialEntry(u, first);
                if oe { raise oe; }
                idx = self.store(u, c);
                reused = false;
            }
            e: *PoolEntry = *self.entries.items[idx];
            se := sendOn(*e.conn, req, credentials);
            if se {
                self.drop(idx);
                idx = -1;
                if reused and attempt == 0 { attempt += 1; reused = false; continue; }
                raise se;
            }
            r, re := recvOn(*e.conn);
            if re {
                self.drop(idx);
                idx = -1;
                if re == .Closed and reused and attempt == 0 {
                    attempt += 1;
                    reused = false;
                    continue;
                }
                raise re;
            }
            // The server may close after this response (its requestCount
            // cap / an error close): drop the conn when it SAID so —
            // "close" as a token of the comma-separated list, per RFC. A
            // length-only match would accept any 5-char value and miss
            // "close, ..." lists.
            if connectionSaysClose(r.header("connection")) { self.drop(idx); }
            return r;
        }
        raise .Send;   // unreachable — the loop returns or raises
    }

    dialEntry :: (self: *ClientPool, u: Url, first: bool) -> (ClientConn, !ClientErr) {
        o := self.opts;
        if u.https {
            if o.tls == null { raise .Tls; }
            if !(first and o.tlsHost.len > 0) { o.tlsHost = u.host; }
        } else {
            o.tls = null;
        }
        return open(u.host, u.port, o);
    }

    find :: (self: *ClientPool, u: Url) -> i64 {
        i : i64 = 0;
        while i < self.entries.len {
            e: *PoolEntry = *self.entries.items[i];
            if e.live and e.https == u.https and e.port == u.port and e.host == u.host { return i; }
            i += 1;
        }
        return -1;
    }

    store :: (self: *ClientPool, u: Url, c: ClientConn) -> i64 {
        // reuse a dead slot first
        i : i64 = 0;
        while i < self.entries.len {
            if !self.entries.items[i].live { break; }
            i += 1;
        }
        ne : PoolEntry = .{ host = mem.clone(self.a, u.host), port = u.port,
                            https = u.https, conn = c, live = true };
        if i < self.entries.len {
            mem.free(self.a, self.entries.items[i].host);
            self.entries.items[i] = ne;
        } else {
            self.entries.append(ne, self.a);
        }
        return i;
    }

    drop :: (self: *ClientPool, idx: i64) {
        e: *PoolEntry = *self.entries.items[idx];
        if !e.live { return; }
        closeConn(*e.conn);
        e.live = false;
    }

    // Close every pooled connection and release the entry storage.
    close :: (self: *ClientPool) {
        i : i64 = 0;
        while i < self.entries.len {
            e: *PoolEntry = *self.entries.items[i];
            if e.live { closeConn(*e.conn); e.live = false; }
            mem.free(self.a, e.host);
            i += 1;
        }
        self.entries.deinit(self.a);
    }
}

Client :: struct {
    // Open a blocking TCP connection to ip:port (see free `dial`).
    dial :: (ip: u32, port: i64) -> (i32, !ClientErr) { return dial(ip, port); }
    // Send one request on an open fd (see free `send`).
    send :: (fd: i32, req: ClientRequest) -> !ClientErr { return send(fd, req); }
    // Read a full response on an open fd (see free `recv`).
    recv :: (fd: i32, requestMethod: string = "GET", maxResponseBytes: ?i64 = null) -> (ClientResponse, !ClientErr) {
        return recv(fd, requestMethod, maxResponseBytes);
    }
    // One blocking round-trip: dial → send → recv → close (see free `request`).
    request :: (ip: u32, port: i64, req: ClientRequest, maxResponseBytes: ?i64 = null) -> (ClientResponse, !ClientErr) {
        return request(ip, port, req, maxResponseBytes);
    }
    // ── sessions (see the free functions above) ────────────────
    open :: (host: string, port: i64, opts: ClientOpts) -> (ClientConn, !ClientErr) {
        return open(host, port, opts);
    }
    openAddr :: (a: *socket.Addr, opts: ClientOpts) -> (ClientConn, !ClientErr) {
        return openAddr(a, opts);
    }
    sendOn :: (c: *ClientConn, req: ClientRequest) -> !ClientErr { return sendOn(c, req); }
    recvOn :: (c: *ClientConn) -> (ClientResponse, !ClientErr) { return recvOn(c); }
    closeConn :: (c: *ClientConn) { closeConn(c); }
    // ── (see the free `fetch`) ─────────────────────────────────
    fetch :: (method: string, url: string, extraHeaders: string, body: string, opts: ClientOpts) -> (ClientResponse, !ClientErr) {
        return fetch(method, url, extraHeaders, body, opts);
    }
}
