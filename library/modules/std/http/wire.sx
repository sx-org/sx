@import "modules/std/core.sx";
@import "modules/std/mem.sx";
@import "modules/std/encoding.sx";
@import "modules/std/compress.sx";
..@import "modules/std/http/types.sx";
..@import "modules/std/http/tls.sx";
..@import "modules/std/http/fiber.sx";
private clib :: @import "modules/std/c.sx";
@import "modules/std/thread.sx";
@import "modules/std/event.sx";
private gzipCodec :: @import "modules/std/codecs/gzip.sx";
private zlibCodec :: @import "modules/std/codecs/zlib.sx";

ChunkStatus :: enum {
    NEED_MORE;
    OK;
    BAD;
    TOO_BIG;
    OVERFLOW;
}

// On NEED_MORE, resume fields point to the first incomplete chunk element.
private ChunkResult :: struct {
    status: ChunkStatus = ChunkStatus.NEED_MORE;
    decodedLen: i64 = 0;
    rawLen: i64 = 0;

    resumeRp: i64 = 0;
    resumeDecoded: i64 = 0;
}

// The checkpoint advances only at chunk boundaries, bounding rescans on partial reads.
ChunkScan :: struct {
    rp: i64 = 0;
    decoded: i64 = 0;
}

// Compaction destroys framing, so validation must confirm the entire body first.
decodeChunked :: (src: [*]u8, avail: i64, maxBody: i64, resume: ChunkScan) -> ChunkResult {
    scan := decodeChunkedPass(src, avail, maxBody, false, resume);
    if scan.status != ChunkStatus.OK { return scan; }

    return decodeChunkedPass(src, avail, maxBody, true, ChunkScan{});
}

private decodeChunkedPass :: (src: [*]u8, avail: i64, maxBody: i64, commit: bool, resume: ChunkScan) -> ChunkResult {
    rp : i64 = resume.rp;
    wp : i64 = 0;
    decoded : i64 = resume.decoded;
    cpRp : i64 = resume.rp;
    cpDecoded : i64 = resume.decoded;
    while true {
        cpRp = rp;
        cpDecoded = decoded;
        size : i64 = 0;
        digits : i64 = 0;

        if rp >= avail { return ChunkResult{ status = ChunkStatus.NEED_MORE, resumeRp = cpRp, resumeDecoded = cpDecoded }; }
        while rp < avail {
            hv := encoding.hexValue(src[rp]);
            if hv == null { break; }

            // Largest size for which size * 16 + 15 fits in i64.
            if size > (0x07FFFFFFFFFFFFFF) { return ChunkResult{ status = ChunkStatus.OVERFLOW }; }
            size = size * 16 + hv;
            if size < 0 { return ChunkResult{ status = ChunkStatus.OVERFLOW }; }
            digits += 1;
            rp += 1;
        }
        if digits == 0 { return ChunkResult{ status = ChunkStatus.BAD }; }

        if rp >= avail { return ChunkResult{ status = ChunkStatus.NEED_MORE, resumeRp = cpRp, resumeDecoded = cpDecoded }; }
        if src[rp] != ';' and src[rp] != '\r' { return ChunkResult{ status = ChunkStatus.BAD }; }

        if src[rp] == ';' {
            while rp < avail and src[rp] != '\r' { rp += 1; }
        }

        if rp + 1 >= avail { return ChunkResult{ status = ChunkStatus.NEED_MORE, resumeRp = cpRp, resumeDecoded = cpDecoded }; }
        if src[rp] != '\r' or src[rp + 1] != '\n' { return ChunkResult{ status = ChunkStatus.BAD }; }
        rp += 2;

        if size == 0 {
            while true {
                if rp + 1 >= avail { return ChunkResult{ status = ChunkStatus.NEED_MORE, resumeRp = cpRp, resumeDecoded = cpDecoded }; }
                if src[rp] == '\r' and src[rp + 1] == '\n' { rp += 2; break; }

                ts := rp;
                while rp < avail and src[rp] != '\r' { rp += 1; }
                if rp + 1 >= avail { return ChunkResult{ status = ChunkStatus.NEED_MORE, resumeRp = cpRp, resumeDecoded = cpDecoded }; }
                if src[rp] != '\r' or src[rp + 1] != '\n' { return ChunkResult{ status = ChunkStatus.BAD }; }
                if rp == ts { rp += 2; break; }
                rp += 2;
            }
            return ChunkResult{ status = ChunkStatus.OK, decodedLen = decoded, rawLen = rp };
        }

        if decoded + size > maxBody { return ChunkResult{ status = ChunkStatus.TOO_BIG }; }

        if rp + size + 1 >= avail { return ChunkResult{ status = ChunkStatus.NEED_MORE, resumeRp = cpRp, resumeDecoded = cpDecoded }; }

        if commit and wp != rp {
            clib.c.memmove(*src[wp], *src[rp], size);
        }
        wp += size;
        rp += size;

        if src[rp] != '\r' or src[rp + 1] != '\n' { return ChunkResult{ status = ChunkStatus.BAD }; }
        rp += 2;
        decoded += size;
    }

    return ChunkResult{ status = ChunkStatus.BAD };
}

private decInto :: (n: i64, dst: [*]u8) -> i64 {
    if n == 0 { dst[0] = '0'; return 1; }
    tmp : [20]u8 = ---;
    cnt : i64 = 0;
    v := n;
    while v > 0 {
        tmp[cnt] = ('0' + v % 10).(u8);
        v = v / 10;
        cnt += 1;
    }
    i : i64 = 0;
    while i < cnt {
        dst[i] = tmp[cnt - 1 - i];
        i += 1;
    }
    return cnt;
}

private decLen :: (n: i64) -> i64 {
    if n == 0 { return 1; }
    c : i64 = 0;
    v := n;
    while v > 0 { c += 1; v = v / 10; }
    return c;
}

private statusLineFor :: (status: i64) -> string {
    if status == 200 { return "HTTP/1.1 200 OK"; }
    if status == 201 { return "HTTP/1.1 201 Created"; }
    if status == 204 { return "HTTP/1.1 204 No Content"; }
    if status == 206 { return "HTTP/1.1 206 Partial Content"; }
    if status == 301 { return "HTTP/1.1 301 Moved Permanently"; }
    if status == 302 { return "HTTP/1.1 302 Found"; }
    if status == 304 { return "HTTP/1.1 304 Not Modified"; }
    if status == 400 { return "HTTP/1.1 400 Bad Request"; }
    if status == 401 { return "HTTP/1.1 401 Unauthorized"; }
    if status == 403 { return "HTTP/1.1 403 Forbidden"; }
    if status == 404 { return "HTTP/1.1 404 Not Found"; }
    if status == 405 { return "HTTP/1.1 405 Method Not Allowed"; }
    if status == 406 { return "HTTP/1.1 406 Not Acceptable"; }
    if status == 408 { return "HTTP/1.1 408 Request Timeout"; }
    if status == 413 { return "HTTP/1.1 413 Content Too Large"; }
    if status == 417 { return "HTTP/1.1 417 Expectation Failed"; }
    if status == 431 { return "HTTP/1.1 431 Request Header Fields Too Large"; }
    if status == 500 { return "HTTP/1.1 500 Internal Server Error"; }
    if status == 501 { return "HTTP/1.1 501 Not Implemented"; }
    if status == 503 { return "HTTP/1.1 503 Service Unavailable"; }
    if status == 504 { return "HTTP/1.1 504 Gateway Timeout"; }
    if status == 505 { return "HTTP/1.1 505 HTTP Version Not Supported"; }
    return "";
}

Encoding :: enum {
    identity;
    gzip;
    deflate;
    unacceptable;
}

// A policy that forbids transformation can serve identity only when identityQ > 0.
private AcceptEncoding :: struct {
    headers: string = "";
    found: bool = false;
    gzipQ: i64 = 0;
    deflateQ: i64 = 0;
    identityQ: i64 = 1000;
    wildcardQ: i64 = -1;
}

asciiLower :: (c: u8) -> u8 {
    if 'A' <= c <= 'Z' then c + ' ' else c
}

ceAsciiIeq :: (a: string, b: string) -> bool {
    if a.len != b.len { return false; }
    i : i64 = 0;
    while i < a.len {
        if asciiLower(a[i]) != asciiLower(b[i]) { return false; }
        i += 1;
    }
    true
}

private asciiIprefix :: (value: string, prefix: string) -> bool {
    if value.len < prefix.len { return false; }
    i : i64 = 0;
    while i < prefix.len {
        if asciiLower(value[i]) != asciiLower(prefix[i]) { return false; }
        i += 1;
    }
    true
}

private isOws :: (c: u8) -> bool { c == ' ' or c == '\t' }

trimOws :: (value: string) -> string {
    first : i64 = 0;
    last : i64 = value.len;
    while first < last and isOws(value[first]) { first += 1; }
    while last > first and isOws(value[last - 1]) { last -= 1; }
    value[first..last]
}

header :: (raw: string, name: string) -> string {
    at : i64 = 0;
    while at < raw.len {
        lineEnd := at;
        while lineEnd < raw.len and raw[lineEnd] != '\r' and raw[lineEnd] != '\n' { lineEnd += 1; }
        colon := at;
        while colon < lineEnd and raw[colon] != ':' { colon += 1; }
        if colon < lineEnd {
            field := raw[at..colon];
            if ceAsciiIeq(field, name) { return trimOws(raw[colon + 1..lineEnd]); }
        }
        while lineEnd < raw.len and (raw[lineEnd] == '\r' or raw[lineEnd] == '\n') { lineEnd += 1; }
        at = lineEnd;
    }
    ""
}

hasHeader :: (raw: string, name: string) -> bool {
    at : i64 = 0;
    while at < raw.len {
        lineEnd := at;
        while lineEnd < raw.len and raw[lineEnd] != '\r' and raw[lineEnd] != '\n' { lineEnd += 1; }
        colon := at;
        while colon < lineEnd and raw[colon] != ':' { colon += 1; }
        if colon < lineEnd and ceAsciiIeq(raw[at..colon], name) { return true; }
        while lineEnd < raw.len and (raw[lineEnd] == '\r' or raw[lineEnd] == '\n') { lineEnd += 1; }
        at = lineEnd;
    }
    false
}

hasHeaderToken :: (raw: string, name: string, token: string) -> bool {
    lineAt : i64 = 0;
    while lineAt < raw.len {
        lineEnd := lineAt;
        while lineEnd < raw.len and raw[lineEnd] != '\r' and raw[lineEnd] != '\n' { lineEnd += 1; }
        colon := lineAt;
        while colon < lineEnd and raw[colon] != ':' { colon += 1; }
        if colon < lineEnd and ceAsciiIeq(raw[lineAt..colon], name) {
            value := raw[colon + 1..lineEnd];
            at : i64 = 0;
            while at <= value.len {
                end := at;
                while end < value.len and value[end] != ',' { end += 1; }
                item := trimOws(value[at..end]);
                itemEnd : i64 = 0;
                while itemEnd < item.len and item[itemEnd] != ';' { itemEnd += 1; }
                if ceAsciiIeq(trimOws(item[..itemEnd]), token) { return true; }
                if end >= value.len { break; }
                at = end + 1;
            }
        }
        while lineEnd < raw.len and (raw[lineEnd] == '\r' or raw[lineEnd] == '\n') { lineEnd += 1; }
        lineAt = lineEnd;
    }
    false
}

// RFC qvalues use thousandths; malformed weights refuse the coding.
private quality :: (value: string) -> i64 {
    v := trimOws(value);
    if v.len == 0 { return 0; }
    whole := v[0];
    if whole != '0' and whole != '1' { return 0; }
    if v.len == 1 { return if whole == '1' then 1000 else 0; }
    if v[1] != '.' { return 0; }
    if v.len > 5 { return 0; }
    result : i64 = 0;
    scale : i64 = 100;
    i : i64 = 2;
    while i < v.len {
        if v[i] < '0' or v[i] > '9' { return 0; }
        digit : i64 = v[i] - '0';
        if whole == '1' and digit != 0 { return 0; }
        result += digit * scale;
        scale = scale / 10;
        i += 1;
    }
    if whole == '1' { return 1000; }
    result
}

private itemQuality :: (item: string) -> i64 {
    q : i64 = 1000;
    seen := false;
    at : i64 = 0;
    while at < item.len and item[at] != ';' { at += 1; }
    while at < item.len {
        at += 1;
        while at < item.len and isOws(item[at]) { at += 1; }
        nameAt := at;
        while at < item.len and item[at] != '=' and item[at] != ';' { at += 1; }
        name := trimOws(item[nameAt..at]);
        value := "";
        if at < item.len and item[at] == '=' {
            at += 1;
            valueAt := at;
            while at < item.len and item[at] != ';' { at += 1; }
            value = trimOws(item[valueAt..at]);
        }
        if ceAsciiIeq(name, "q") {
            parsed := quality(value);
            if !seen or parsed < q { q = parsed; }
            seen = true;
        }
    }
    q
}

// Duplicate entries take the lowest quality to preserve explicit refusals.
parseAcceptEncoding :: (headers: string) -> AcceptEncoding {
    result: AcceptEncoding = .{ headers = headers };
    gzipQ:  i64 = -1;
    deflateQ : i64 = -1;
    identityQ: i64 = -1;
    wildcardQ: i64 = -1;
    found := false;

    lineAt : i64 = 0;
    while lineAt < headers.len {
        lineEnd := lineAt;
        while lineEnd < headers.len and headers[lineEnd] != '\r' and headers[lineEnd] != '\n' { lineEnd += 1; }
        colon := lineAt;
        while colon < lineEnd and headers[colon] != ':' { colon += 1; }
        if colon < lineEnd and ceAsciiIeq(headers[lineAt..colon], "accept-encoding") {
            found = true;
            value := headers[colon + 1..lineEnd];
            at : i64 = 0;
            while at <= value.len {
                end := at;
                while end < value.len and value[end] != ',' { end += 1; }
                item := trimOws(value[at..end]);
                tokenEnd : i64 = 0;
                while tokenEnd < item.len and item[tokenEnd] != ';' and !isOws(item[tokenEnd]) { tokenEnd += 1; }
                token := item[..tokenEnd];
                q := itemQuality(item);
                if ceAsciiIeq(token, "gzip") {
                    if gzipQ < 0 or q < gzipQ { gzipQ = q; }
                } else if ceAsciiIeq(token, "deflate") {
                    if deflateQ < 0 or q < deflateQ { deflateQ = q; }
                } else if ceAsciiIeq(token, "identity") {
                    if identityQ < 0 or q < identityQ { identityQ = q; }
                } else if ceAsciiIeq(token, "*") {
                    if wildcardQ < 0 or q < wildcardQ { wildcardQ = q; }
                }
                if end >= value.len { break; }
                at = end + 1;
            }
        }
        while lineEnd < headers.len and (headers[lineEnd] == '\r' or headers[lineEnd] == '\n') { lineEnd += 1; }
        lineAt = lineEnd;
    }

    result.found = found;
    if !found { return result; }
    if gzipQ < 0 { gzipQ = wildcardQ; }
    if deflateQ < 0 { deflateQ = wildcardQ; }
    if gzipQ < 0 { gzipQ = 0; }
    if deflateQ < 0 { deflateQ = 0; }
    if identityQ < 0 { identityQ = if wildcardQ == 0 then 0 else 1000; }
    result.gzipQ = gzipQ;
    result.deflateQ = deflateQ;
    result.identityQ = identityQ;
    result.wildcardQ = wildcardQ;
    result
}

// Equal positive weights prefer gzip; an absent field keeps identity.
preferredEncoding :: (accept: *AcceptEncoding) -> Encoding {
    if !accept.found { return .identity; }
    if accept.gzipQ > 0 and accept.gzipQ >= accept.deflateQ and accept.gzipQ >= accept.identityQ { return .gzip; }
    if accept.deflateQ > 0 and accept.deflateQ >= accept.identityQ { return .deflate; }
    if accept.identityQ > 0 { return .identity; }
    if accept.gzipQ > 0 and accept.gzipQ >= accept.deflateQ { return .gzip; }
    if accept.deflateQ > 0 { return .deflate; }
    .unacceptable
}

identityAcceptable :: (accept: *AcceptEncoding) -> bool { accept.identityQ > 0 }

private explicitQuality :: (headers: string, wanted: string) -> i64 {
    best : i64 = -1;
    lineAt : i64 = 0;
    while lineAt < headers.len {
        lineEnd := lineAt;
        while lineEnd < headers.len and headers[lineEnd] != '\r' and headers[lineEnd] != '\n' { lineEnd += 1; }
        colon := lineAt;
        while colon < lineEnd and headers[colon] != ':' { colon += 1; }
        if colon < lineEnd and ceAsciiIeq(headers[lineAt..colon], "accept-encoding") {
            value := headers[colon + 1..lineEnd];
            at : i64 = 0;
            while at <= value.len {
                end := at;
                while end < value.len and value[end] != ',' { end += 1; }
                item := trimOws(value[at..end]);
                tokenEnd : i64 = 0;
                while tokenEnd < item.len and item[tokenEnd] != ';' and !isOws(item[tokenEnd]) { tokenEnd += 1; }
                if ceAsciiIeq(item[..tokenEnd], wanted) {
                    q := itemQuality(item);
                    if best < 0 or q < best { best = q; }
                }
                if end >= value.len { break; }
                at = end + 1;
            }
        }
        while lineEnd < headers.len and (headers[lineEnd] == '\r' or headers[lineEnd] == '\n') { lineEnd += 1; }
        lineAt = lineEnd;
    }
    best
}

private codingQuality :: (accept: *AcceptEncoding, coding: string) -> i64 {
    if !accept.found { return 1000; }
    if ceAsciiIeq(coding, "identity") { return accept.identityQ; }
    if ceAsciiIeq(coding, "gzip") { return accept.gzipQ; }
    if ceAsciiIeq(coding, "deflate") { return accept.deflateQ; }
    q := explicitQuality(accept.headers, coding);
    if q >= 0 { return q; }
    if accept.wildcardQ >= 0 { return accept.wildcardQ; }
    0
}

private isTchar :: (c: u8) -> bool {
    if c >= 'a' and c <= 'z' { return true; }
    if c >= 'A' and c <= 'Z' { return true; }
    if c >= '0' and c <= '9' { return true; }
    c == '!' or c == '#' or c == '$' or c == '%' or c == '&' or c == '\''
        or c == '*' or c == '+' or c == '-' or c == '.' or c == '^'
        or c == '_' or c == '`' or c == '|' or c == '~'
}

private validCodingToken :: (value: string) -> bool {
    if value.len == 0 { return false; }
    i : i64 = 0;
    while i < value.len {
        if !isTchar(value[i]) { return false; }
        i += 1;
    }
    true
}

contentCodingAcceptable :: (accept: *AcceptEncoding, raw: string) -> bool {
    found := false;
    lineAt : i64 = 0;
    while lineAt < raw.len {
        lineEnd := lineAt;
        while lineEnd < raw.len and raw[lineEnd] != '\r' and raw[lineEnd] != '\n' { lineEnd += 1; }
        colon := lineAt;
        while colon < lineEnd and raw[colon] != ':' { colon += 1; }
        if colon < lineEnd and ceAsciiIeq(raw[lineAt..colon], "content-encoding") {
            found = true;
            value := raw[colon + 1..lineEnd];
            at : i64 = 0;
            while at <= value.len {
                end := at;
                while end < value.len and value[end] != ',' { end += 1; }
                coding := trimOws(value[at..end]);
                if !validCodingToken(coding) or codingQuality(accept, coding) <= 0 { return false; }
                if end >= value.len { break; }
                at = end + 1;
            }
        }
        while lineEnd < raw.len and (raw[lineEnd] == '\r' or raw[lineEnd] == '\n') { lineEnd += 1; }
        lineAt = lineEnd;
    }
    if !found { return identityAcceptable(accept); }
    true
}

parseContentEncoding :: (value: string) -> Encoding {
    v := trimOws(value);
    if !validCodingToken(v) { return .unacceptable; }
    if ceAsciiIeq(v, "identity") { return .identity; }
    if ceAsciiIeq(v, "gzip") { return .gzip; }
    if ceAsciiIeq(v, "deflate") { return .deflate; }
    .unacceptable
}

compressibleContentType :: (value: string) -> bool {
    end : i64 = 0;
    while end < value.len and value[end] != ';' { end += 1; }
    media := trimOws(value[..end]);
    (media.len > 5 and asciiIprefix(media, "text/"))
        or ceAsciiIeq(media, "application/json")
        or ceAsciiIeq(media, "application/javascript")
        or ceAsciiIeq(media, "application/xml")
        or ceAsciiIeq(media, "image/svg+xml")
}

encode :: (data: string, encoding: Encoding, level: i64, alloc: Allocator) -> (string, !Error) {
    if encoding == .gzip {
        return gzipCodec.encode(data, .{ level = level }, .{}, alloc);
    }
    if encoding == .deflate {
        return zlibCodec.encode(data, .{ level = level }, alloc);
    }
    raise .Unsupported;
}

private EncoderStorage :: union {
    gzip: gzipCodec.Encoder;
    deflate: zlibCodec.Encoder;
}

private Encoder :: struct {
    encoding: Encoding;
    storage: EncoderStorage;

    init :: (encoding: Encoding, level: i64, alloc: Allocator) -> (Encoder, !Error) {
        result : Encoder = ---;
        result.encoding = encoding;
        if encoding == .gzip {
            result.storage.gzip = try gzipCodec.Encoder.init(.{ level = level }, .{}, alloc);
            return result;
        }
        if encoding == .deflate {
            result.storage.deflate = try zlibCodec.Encoder.init(.{ level = level }, alloc);
            return result;
        }
        raise .Unsupported;
    }

    write :: (self: *Encoder, input: string, output: string) -> (Progress, !Error) {
        if self.encoding == .gzip { return self.storage.gzip.write(input, output); }
        if self.encoding == .deflate { return self.storage.deflate.write(input, output); }
        raise .Unsupported;
    }

    finish :: (self: *Encoder, output: string) -> (Progress, !Error) {
        if self.encoding == .gzip { return self.storage.gzip.finish(output); }
        if self.encoding == .deflate { return self.storage.deflate.finish(output); }
        raise .Unsupported;
    }

    deinit :: (self: *Encoder) {
        if self.encoding == .gzip { self.storage.gzip.deinit(); }
        else if self.encoding == .deflate { self.storage.deflate.deinit(); }
        self.encoding = .identity;
    }
}

private DecoderStorage :: union {
    gzip: gzipCodec.Decoder;
    deflate: zlibCodec.Decoder;
}

Decoder :: struct {
    encoding: Encoding;
    storage: DecoderStorage;

    init :: (encoding: Encoding, maxOutput: i64, alloc: Allocator) -> (Decoder, !Error) {
        result : Decoder = ---;
        result.encoding = encoding;
        if encoding == .gzip {
            result.storage.gzip = try gzipCodec.Decoder.init(maxOutput, alloc);
            return result;
        }
        if encoding == .deflate {
            result.storage.deflate = try zlibCodec.Decoder.init(maxOutput, alloc);
            return result;
        }
        raise .Unsupported;
    }

    read :: (self: *Decoder, input: string, output: string) -> (Progress, !Error) {
        if self.encoding == .gzip { return self.storage.gzip.read(input, output); }
        if self.encoding == .deflate { return self.storage.deflate.read(input, output); }
        raise .Unsupported;
    }

    finish :: (self: *Decoder, output: string) -> (Progress, !Error) {
        if self.encoding == .gzip { return self.storage.gzip.finish(output); }
        if self.encoding == .deflate { return self.storage.deflate.finish(output); }
        raise .Unsupported;
    }

    deinit :: (self: *Decoder) {
        if self.encoding == .gzip { self.storage.gzip.deinit(); }
        else if self.encoding == .deflate { self.storage.deflate.deinit(); }
        self.encoding = .identity;
    }
}

// Source buffering stays bounded independently of the response body length.
private SOURCE_PIECE :: 16384;

private EncodedProduceStatus :: enum {
    data;
    pending;
    done;
}

EncodedProduceStep :: struct {
    produced: i64 = 0;
    status: EncodedProduceStatus = .pending;
}

EncodedProducer :: struct {
    source: StreamProducer;
    sourceCtx: usize;
    sourceOff: i64;
    input: [*]u8;
    inputAt: i64;
    inputLen: i64;
    sourceEof: bool;
    finished: bool;
    encoder: Encoder;
    alloc: Allocator;

    init :: (encoding: Encoding, level: i64, source: StreamProducer, sourceCtx: usize, alloc: Allocator) -> (EncodedProducer, !Error) {
        input := alloc.allocBytes(SOURCE_PIECE);
        if input == null { raise .AllocationFailed; }
        encoder := Encoder.init(encoding, level, alloc) catch |e| {
            alloc.deallocBytes(input);
            raise e;
        };
        EncodedProducer{
            source = source,
            sourceCtx = sourceCtx,
            sourceOff = 0,
            input = input,
            inputAt = 0,
            inputLen = 0,
            sourceEof = false,
            finished = false,
            encoder = encoder,
            alloc = alloc,
        }
    }

    // pending makes progress without output; event-loop callers yield before retrying.
    next :: (self: *EncodedProducer, output: string) -> (EncodedProduceStep, !Error) {
        if self.finished { return EncodedProduceStep{ status = EncodedProduceStatus.done }; }
        if self.inputAt < self.inputLen {
            input := string{ ptr = *self.input[self.inputAt], len = self.inputLen - self.inputAt };
            progress := try self.encoder.write(input, output);
            self.inputAt += progress.consumed;
            if progress.status == .done { self.finished = true; }
            if progress.produced > 0 { return EncodedProduceStep{ produced = progress.produced, status = EncodedProduceStatus.data }; }
            if self.finished { return EncodedProduceStep{ status = EncodedProduceStatus.done }; }
            if progress.consumed > 0 { return EncodedProduceStep{ status = EncodedProduceStatus.pending }; }
            raise .InvalidData;
        }

        if !self.sourceEof {
            n := self.source(self.sourceCtx, self.sourceOff, self.input, SOURCE_PIECE);
            if n < 0 or n > SOURCE_PIECE { raise .Io; }
            if n > 0 {
                self.sourceOff += n;
                self.inputAt = 0;
                self.inputLen = n;
                return EncodedProduceStep{ status = EncodedProduceStatus.pending };
            }
            self.sourceEof = true;
        }

        progress := try self.encoder.finish(output);
        if progress.status == .done { self.finished = true; }
        if progress.produced > 0 { return EncodedProduceStep{ produced = progress.produced, status = EncodedProduceStatus.data }; }
        if self.finished { return EncodedProduceStep{ status = EncodedProduceStatus.done }; }
        raise .InvalidData;
    }

    deinit :: (self: *EncodedProducer) {
        self.encoder.deinit();
        if self.input != null { self.alloc.deallocBytes(self.input); self.input = null; }
        self.finished = true;
    }
}

createEncodedProducer :: (encoding: Encoding, level: i64, source: StreamProducer, sourceCtx: usize, alloc: Allocator) -> *EncodedProducer {
    result := mem.create(alloc, EncodedProducer);
    if result == null { return null; }
    state := EncodedProducer.init(encoding, level, source, sourceCtx, alloc) catch {
        alloc.deallocBytes(result);
        return null;
    };
    result.* = state;
    result
}

destroyEncodedProducer :: (state: *EncodedProducer, alloc: Allocator) {
    if state == null { return; }
    state.deinit();
    alloc.deallocBytes(state);
}

private OUT_CHAN_CAP :: 65536;

private OutChanTake :: enum {
    data;
    pending;
    eof;
    producerFault;
}

// A full channel blocks the worker; an empty channel makes the next feed wake
// the loop. Server.close aborts feeders before joining the pool.
OutChan :: struct {
    mu: thread.Mutex = .{};
    cv: thread.Cond = .{};
    buf: [*]u8 = null;
    cap: i64 = 0;
    len: i64 = 0;
    eof: bool = false;
    fault: bool = false;
    producerFault: bool = false;
    hungry: bool = false;
    // The worker owns the initial reference; a queued completion retains one.
    refs: i64 = 1;
    alloc: Allocator;
    lp: event.Loop = .{};

    feedAll :: (self: *OutChan, src: [*]u8, n: i64) -> bool {
        off : i64 = 0;
        while off < n {
            self.mu.lock();
            while self.cap - self.len == 0 and !self.fault {
                self.cv.wait(*self.mu);
            }
            if self.fault { self.mu.unlock(); return false; }
            space := self.cap - self.len;
            rem := n - off;
            take := if rem < space then rem else space;
            clib.c.memcpy(*self.buf[self.len], *src[off], take);
            self.len += take;
            off += take;
            w := self.hungry;
            if w { self.hungry = false; }
            self.mu.unlock();
            if w { self.lp.wake(); }
        }
        return true;
    }

    finishEof :: (self: *OutChan) {
        self.mu.lock();
        self.eof = true;
        w := self.hungry;
        if w { self.hungry = false; }
        self.mu.unlock();
        if w { self.lp.wake(); }
    }

    finishFault :: (self: *OutChan) {
        self.mu.lock();
        self.producerFault = true;
        w := self.hungry;
        if w { self.hungry = false; }
        self.mu.unlock();
        if w { self.lp.wake(); }
    }

    take :: (self: *OutChan, dst: [*]u8, want: i64) -> (i64, OutChanTake) {
        self.mu.lock();
        n := if want < self.len then want else self.len;
        if n > 0 {
            clib.c.memcpy(dst, self.buf, n);
            rest := self.len - n;
            if rest > 0 { clib.c.memmove(self.buf, *self.buf[n], rest); }
            self.len = rest;
            self.cv.signal();
        }
        status := OutChanTake.data;
        if n == 0 {
            if self.producerFault { status = .producerFault; }
            else if self.eof { status = .eof; }
            else { status = .pending; self.hungry = true; }
        }
        self.mu.unlock();
        return n, status;
    }

    abort :: (self: *OutChan) {
        self.mu.lock();
        self.fault = true;
        self.cv.broadcast();
        self.mu.unlock();
    }

    retain :: (self: *OutChan) {
        self.mu.lock();
        self.refs += 1;
        self.mu.unlock();
    }

    release :: (self: *OutChan) {
        self.mu.lock();
        self.refs -= 1;
        last := self.refs == 0;
        self.mu.unlock();
        if last {
            self.mu.destroy();
            self.cv.destroy();
            a := self.alloc;
            if self.buf != null { a.deallocBytes(self.buf); }
            a.deallocBytes(self);
        }
    }
}

createOutChan :: (alloc: Allocator, lp: event.Loop) -> *OutChan {
    result := mem.create(alloc, OutChan);
    if result == null { return null; }
    result.* = OutChan{ alloc = alloc, lp = lp };
    if !result.mu.setup() { alloc.deallocBytes(result); return null; }
    if !result.cv.setup() {
        result.mu.destroy();
        alloc.deallocBytes(result);
        return null;
    }
    bytes := mem.alloc(alloc, u8, OUT_CHAN_CAP);
    if bytes.ptr == null {
        result.cv.destroy();
        result.mu.destroy();
        alloc.deallocBytes(result);
        return null;
    }
    result.buf = bytes.ptr;
    result.cap = OUT_CHAN_CAP;
    result
}

OutBytes :: struct {
    buf: [*]u8 = null;
    len: i64 = 0;
}

private HDR_CL    : string : "\r\nContent-Length: ";
private HDR_TE    : string : "\r\nTransfer-Encoding: chunked";
private HDR_CT    : string : "\r\nContent-Type: ";
private HDR_DATE  : string : "\r\nDate: ";
private HDR_SRV   : string : "\r\nServer: ";
private HDR_KA    : string : "\r\nConnection: keep-alive\r\n";
private HDR_CLOSE : string : "\r\nConnection: close\r\n";
private HTTP_PFX  : string : "HTTP/1.1 ";

private putStr :: (dst: [*]u8, off: i64, s: string) -> i64 {
    clib.c.memcpy(*dst[off], s.ptr, s.len);
    return off + s.len;
}

respHeadLen :: (resp: *Response, keep: bool, date: string, serverName: string, noBodyStatus: bool, chunked: bool) -> i64 {
    sl := statusLineFor(resp.status);
    n : i64 = if sl.len > 0 then sl.len
              else HTTP_PFX.len + decLen(resp.status) + 1 + reasonFor(resp.status).len;
    if chunked { n += HDR_TE.len; }
    else if !noBodyStatus { n += HDR_CL.len + decLen(resp.body.len); }
    n += HDR_CT.len + resp.contentType.len;
    n += HDR_DATE.len + date.len;
    if serverName.len > 0 { n += HDR_SRV.len + serverName.len; }
    n += if keep then HDR_KA.len else HDR_CLOSE.len;
    n += resp.extraHeaders.len;
    return n + 2;
}

respHeadWrite :: (resp: *Response, keep: bool, date: string, serverName: string, noBodyStatus: bool, chunked: bool, dst: [*]u8) -> i64 {
    off : i64 = 0;
    sl := statusLineFor(resp.status);
    if sl.len > 0 { off = putStr(dst, off, sl); }
    else {
        off = putStr(dst, off, HTTP_PFX);
        off += decInto(resp.status, *dst[off]);
        dst[off] = ' ';
        off += 1;
        off = putStr(dst, off, reasonFor(resp.status));
    }
    if chunked { off = putStr(dst, off, HDR_TE); }
    else if !noBodyStatus {
        off = putStr(dst, off, HDR_CL);
        off += decInto(resp.body.len, *dst[off]);
    }
    off = putStr(dst, off, HDR_CT);
    off = putStr(dst, off, resp.contentType);
    off = putStr(dst, off, HDR_DATE);
    off = putStr(dst, off, date);
    if serverName.len > 0 {
        off = putStr(dst, off, HDR_SRV);
        off = putStr(dst, off, serverName);
    }
    off = putStr(dst, off, if keep then HDR_KA else HDR_CLOSE);
    if resp.extraHeaders.len > 0 { off = putStr(dst, off, resp.extraHeaders); }
    dst[off] = '\r';
    dst[off + 1] = '\n';
    return off + 2;
}

// HEAD retains the GET Content-Length but omits the body; 204/304 omit both.
serializeBytes :: (resp: *Response, keep: bool, alloc: Allocator, headOnly: bool, date: string, serverName: string) -> OutBytes {
    noBodyStatus := resp.status == 204 or resp.status == 304;
    hl := respHeadLen(resp, keep, date, serverName, noBodyStatus, false);
    bodyLen : i64 = if headOnly or noBodyStatus then 0 else resp.body.len;
    raw := alloc.allocBytes(hl + bodyLen);
    if raw == null { return .{}; }
    buf : [*]u8 = raw.([*]u8);
    w := respHeadWrite(resp, keep, date, serverName, noBodyStatus, false, buf);
    if bodyLen > 0 { clib.c.memcpy(*buf[w], resp.body.ptr, bodyLen); }
    return OutBytes{ buf = buf, len = w + bodyLen };
}

serializeChunkedHead :: (resp: *Response, keep: bool, alloc: Allocator, date: string, serverName: string) -> OutBytes {
    hl := respHeadLen(resp, keep, date, serverName, false, true);
    raw := alloc.allocBytes(hl);
    if raw == null { return .{}; }
    buf : [*]u8 = raw.([*]u8);
    w := respHeadWrite(resp, keep, date, serverName, false, true, buf);
    return OutBytes{ buf = buf, len = w };
}
