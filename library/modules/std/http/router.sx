// MEMORY: `init` captures `context.allocator` as the Router's own and the
// route table grows through it — the table outlives any transient
// per-request scope, per the long-lived-container rule; `deinit` returns
// it. Path params, query pairs, form pairs and decoded query/form
// tokens (percent/`+` decoding needs fresh bytes) live in the RouteCtx's
// lists, grown through the allocator current at dispatch (the server's
// per-request arena) and returned to it when the handler returns.
//
// ROUTING ORDER: matching is FIRST-REGISTERED-WINS over the route table, NOT
// static-preferred. If a param route (`/users/:id`) is registered before a
// static one (`/users/me`), the param route shadows the static — `/users/me`
// binds `:id="me"` and the static handler never runs. REGISTER STATIC ROUTES
// BEFORE PARAM ROUTES on the same prefix.
//
// DECODING: percent-decoding is permissive — a malformed `%` sequence
// (trailing `%`, `%G…`) is left literal, never an error or an OOB read. `%00`
// decodes to an embedded NUL byte; sx strings are length-based so this is
// memory-safe, but a handler treating such a value as a C string should know.
//
// multipart/form-data is OUT OF SCOPE (it is large — boundary framing,
// streamed parts, per-part headers). This layer covers only
// application/x-www-form-urlencoded.

@import "modules/std/http/wire.sx";
@import "modules/std/core.sx";
@import "modules/std/fmt.sx";          // concat
@import "modules/std/list.sx";
@import "modules/std/mem.sx";
@import "modules/std/writer.sx";       // StringBuilder
@import "modules/std/encoding.sx";     // hexValue
@import "modules/std/json.sx";

// One (name → value) pair. `name`/`value` are VIEWS — params point into the
// request's path (untouched during dispatch); decoded query/form values
// point into the RouteCtx's decoded tokens. Valid only for the handler call.
KV :: struct {
    name: string = "";
    value: string = "";
}

// One registered route: (method, pattern) → handler. The pattern is the
// raw "/users/:id" string; matching splits it on '/' each dispatch (cheap,
// no per-route preprocessing).
RouteHandler :: (rc: *RouteCtx) -> void;

Route :: struct {
    method: string = "";    // "GET", "POST", … (compared case-insensitively)
    pattern: string = "";   // "/users/:id"
    handler: RouteHandler = null;
}

// The handler-facing context. Built fresh (on the stack) per dispatch by
// Router.dispatch; carries the live request/response, the matched path
// params, and the app's own ctx word. Query/form pairs are parsed LAZILY
// on first access and cached here, so a handler that never asks pays
// nothing. Every list grows through `a`, and `deinit` returns them.
RouteCtx :: struct {
    req: *Request = null;
    resp: *Response = null;
    appCtx: usize = 0;          // the word the app gave Router.init
    a: Allocator;

    // path params (filled by the match)
    params: List(KV) = .{};

    // query cache (lazy)
    queryParsed: bool = false;
    query: List(KV) = .{};

    // form cache (lazy)
    formParsed: bool = false;
    form: List(KV) = .{};

    // decoded query/form tokens the pairs view
    decoded: List(string) = .{};

    deinit :: (self: *RouteCtx) {
        for t in self.decoded.items { mem.free(self.a, t); }
        self.decoded.deinit(self.a);
        self.params.deinit(self.a);
        self.query.deinit(self.a);
        self.form.deinit(self.a);
    }

    // ── path params ──────────────────────────────────────────────────
    // Look up a path param by name; "" when absent. Names come straight
    // from the pattern's ":name" segments.
    param :: (self: *RouteCtx, name: string) -> string {
        for kv in self.params.items {
            if strEq(kv.name, name) { return kv.value; }
        }
        return "";
    }

    // ── query string ─────────────────────────────────────────────────
    // Value of query key `name` from the request path's `?...` portion;
    // "" when the key is absent. A bare flag (`?x`) yields "". Decoded
    // (percent + '+') on first call.
    queryGet :: (self: *RouteCtx, name: string) -> string {
        if !self.queryParsed {
            self.parsePairs(queryStringOf(self.req.path), *self.query);
            self.queryParsed = true;
        }
        for kv in self.query.items {
            if strEq(kv.name, name) { return kv.value; }
        }
        return "";
    }

    // True if the query key is present at all (distinguishes a flag with
    // no value, `?x`, whose queryGet is "", from a missing key).
    queryHas :: (self: *RouteCtx, name: string) -> bool {
        if !self.queryParsed {
            self.parsePairs(queryStringOf(self.req.path), *self.query);
            self.queryParsed = true;
        }
        for kv in self.query.items {
            if strEq(kv.name, name) { return true; }
        }
        return false;
    }

    // ── urlencoded form body ─────────────────────────────────────────
    // Value of form field `name` from an application/x-www-form-urlencoded
    // request body; "" when absent. Same percent/'+' decoding as the query.
    formGet :: (self: *RouteCtx, name: string) -> string {
        if !self.formParsed {
            self.parsePairs(self.req.body, *self.form);
            self.formParsed = true;
        }
        for kv in self.form.items {
            if strEq(kv.name, name) { return kv.value; }
        }
        return "";
    }

    formHas :: (self: *RouteCtx, name: string) -> bool {
        if !self.formParsed {
            self.parsePairs(self.req.body, *self.form);
            self.formParsed = true;
        }
        for kv in self.form.items {
            if strEq(kv.name, name) { return true; }
        }
        return false;
    }

    // Decode a token: a clean one is a view into the source; one with escapes
    // is decoded into a token from `a` that `deinit` returns.
    decodeToken :: (self: *RouteCtx, s: string) -> string {
        if !needsDecode(s) { return s; }
        buf := mem.alloc(self.a, u8, s.len);
        n := urlDecodeInto(s, buf);
        self.decoded.append(buf, self.a);
        return buf[0 .. n];
    }

    // Parse `a=1&b=two&flag` into decoded KV pairs appended to `out`.
    // A pair with no '=' (`flag`) has value "". Keys AND values are decoded
    // (percent + '+').
    parsePairs :: (self: *RouteCtx, s: string, out: *List(KV)) {
        i := 0;
        while i < s.len {
            // one segment runs to the next '&'
            segStart := i;
            while i < s.len and s[i] != '&' { i += 1; }
            seg := string{ ptr = *s[segStart], len = i - segStart };
            if i < s.len { i += 1; }   // skip '&'

            if seg.len == 0 { continue; }   // empty segment ("&&")

            // split on the first '='
            eq := -1;
            k := 0;
            while k < seg.len {
                if seg[k] == '=' { eq = k; break; }
                k += 1;
            }
            key := "";
            val := "";
            if eq < 0 {
                key = seg;
            } else {
                key = string{ ptr = seg.ptr, len = eq };
                val = string{ ptr = *seg[eq + 1], len = seg.len - eq - 1 };
            }
            out.append(KV{ name = self.decodeToken(key), value = self.decodeToken(val) }, self.a);
        }
    }

    // ── JSON request body ────────────────────────────────────────────
    // Parse the request body as JSON (under the per-request arena) and
    // return the root Value + an ok flag. A malformed body → (.null,
    // false). Strings/numbers/bools/objects/arrays per std/json.
    jsonBody :: (self: *RouteCtx) -> (json.Value, bool) {
        v, e := json.parse(self.req.body, context.allocator);
        if e {
            nv : json.Value = .null;
            return nv, false;
        }
        return v, true;
    }

    // ── JSON response ────────────────────────────────────────────────
    // Send `v` as the response body: sets Content-Type application/json
    // and serializes via std/json into a `StringBuilder` on the
    // per-request arena. `status` sets the response status. Returns
    // false if serialization raises (`json.Error.NonFinite`).
    jsonSend :: (self: *RouteCtx, status: i64, v: json.Value) -> bool {
        sb := StringBuilder.init();
        jw := json.Writer.init(sb);
        jw.write(v) catch { return false; };
        self.resp.status = status;
        self.resp.contentType = "application/json";
        self.resp.body = sb.finish();
        return true;
    }
}

// ── string helpers ───────────────────────────────────────────────────

private strEq :: (a: string, b: string) -> bool {
    if a.len != b.len { return false; }
    i := 0;
    while i < a.len {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    return true;
}

// Case-insensitive ASCII equality (for method comparison).
private ciEq :: (a: string, b: string) -> bool {
    if a.len != b.len { return false; }
    i := 0;
    while i < a.len {
        ca := a[i];
        cb := b[i];
        if ca >= 'A' and ca <= 'Z' { ca = ca + ' '; }
        if cb >= 'A' and cb <= 'Z' { cb = cb + ' '; }
        if ca != cb { return false; }
        i += 1;
    }
    return true;
}

// The portion of a request path before any '?': "/users/42?x=1" → "/users/42".
private pathOnly :: (path: string) -> string {
    i := 0;
    while i < path.len {
        if path[i] == '?' { return string{ ptr = path.ptr, len = i }; }
        i += 1;
    }
    return path;
}

// The query string AFTER the '?': "/s?a=1&b=2" → "a=1&b=2"; "" when none.
private queryStringOf :: (path: string) -> string {
    i := 0;
    while i < path.len {
        if path[i] == '?' {
            return string{ ptr = *path[i + 1], len = path.len - i - 1 };
        }
        i += 1;
    }
    return "";
}

// ── percent / '+' decoding ───────────────────────────────────────────

// Decode one urlencoded token (`%XX` → byte, `+` → space, others verbatim)
// from `s` into `dst` (at least s.len bytes — decoding only shrinks).
// Returns the decoded byte length. A malformed `%` (truncated or non-hex)
// is passed through literally rather than dropped.
private urlDecodeInto :: (s: string, dst: []u8) -> i64 {
    di : i64 = 0;
    i := 0;
    while i < s.len {
        c := s[i];
        if c == '%' and i + 2 < s.len {   // '%' with two more chars
            hi := encoding.hexValue(s[i + 1]);
            lo := encoding.hexValue(s[i + 2]);
            if hi != null and lo != null {
                dst[di] = (hi * 16 + lo).(u8);
                di += 1;
                i += 3;
                continue;
            }
        }
        if c == '+' { dst[di] = ' '; }   // '+' → space
        else { dst[di] = c; }
        di += 1;
        i += 1;
    }
    return di;
}

// True if a raw token needs decoding (has a '%' or '+'); a clean token is
// returned as a zero-copy view, no arena byte spent.
private needsDecode :: (s: string) -> bool {
    i := 0;
    while i < s.len {
        if s[i] == '%' or s[i] == '+' { return true; }
        i += 1;
    }
    return false;
}

// ── pattern matching ─────────────────────────────────────────────────

// Match `path` (already stripped of any query) against `pattern`,
// appending its ":name" segments to `rc.params`. Both are split on '/'. On
// a mismatch `rc.params` is left empty.
// Trailing-slash insensitive: "/users" matches "/users/" (empty trailing
// segments are ignored on both sides).
private matchPattern :: (pattern: string, path: string, rc: *RouteCtx) -> bool {
    rc.params.clear();
    pi := 0;   // pattern cursor
    xi := 0;   // path cursor
    while true {
        // advance past leading '/'
        while pi < pattern.len and pattern[pi] == '/' { pi += 1; }
        while xi < path.len and path[xi] == '/' { xi += 1; }
        patEnd := pi >= pattern.len;
        pathEnd := xi >= path.len;
        if patEnd and pathEnd { return true; }
        if patEnd or pathEnd { rc.params.clear(); return false; }
        // grab one segment from each
        ps := pi;
        while pi < pattern.len and pattern[pi] != '/' { pi += 1; }
        pseg := string{ ptr = *pattern[ps], len = pi - ps };
        xs := xi;
        while xi < path.len and path[xi] != '/' { xi += 1; }
        xseg := string{ ptr = *path[xs], len = xi - xs };
        if pseg.len > 0 and pseg[0] == ':' {   // param segment
            name := string{ ptr = *pseg[1], len = pseg.len - 1 };
            rc.params.append(KV{ name = name, value = xseg }, rc.a);
        } else {
            if !strEq(pseg, xseg) { rc.params.clear(); return false; }
        }
    }
    return false;
}

// ── the Router ───────────────────────────────────────────────────────

Router :: struct {
    routes: List(Route) = .{};
    a: Allocator;
    appCtx: usize = 0;             // the word route handlers see (RouteCtx.appCtx)
    notFound: RouteHandler = null; // optional custom 404 handler

    // Initialize with the app's own ctx word (whatever route handlers want
    // — a store handle, config). The route table grows through the
    // `context.allocator` current here, which must outlive the Router. Bind
    // the result to a local; `router` is the ctx.
    init :: (appCtx: usize) -> Router {
        Router{ a = context.allocator, appCtx = appCtx }
    }

    deinit :: (self: *Router) {
        self.routes.deinit(self.a);
    }

    // Register (method, pattern) → handler. Method is matched case-
    // insensitively; pattern segments beginning ':' are path params.
    route :: (self: *Router, method: string, pattern: string, h: RouteHandler) {
        self.routes.append(Route{ method = method, pattern = pattern, handler = h }, self.a);
    }

    get  :: (self: *Router, pattern: string, h: RouteHandler) { self.route("GET",  pattern, h); }
    post :: (self: *Router, pattern: string, h: RouteHandler) { self.route("POST", pattern, h); }
    put  :: (self: *Router, pattern: string, h: RouteHandler) { self.route("PUT",  pattern, h); }
    del  :: (self: *Router, pattern: string, h: RouteHandler) { self.route("DELETE", pattern, h); }

    // Set a custom 404 handler (else a plain "404 Not Found" text body).
    setNotFound :: (self: *Router, h: RouteHandler) { self.notFound = h; }
}

// The one handler you hand to Server.init — a plain free function with the
// exact (*Request, *Response, usize) server-handler shape (so it binds to
// the Server's handler fn-ptr field). `ctx` is `router`. Matches the
// request to a route and dispatches; a path that matches no pattern → 404;
// a path that matches a pattern but whose method no route registered → 405
// with an `Allow` header listing the methods registered for that path.
//
dispatch :: (req: *Request, resp: *Response, ctx: usize) {
    self : *Router = @reinterpret(*Router, ctx);
    path := pathOnly(req.path);    

    rc : RouteCtx = .{ req = req, resp = resp, appCtx = self.appCtx, a = context.allocator };
    defer rc.deinit();

    // First pass: find an exact (method, pattern) match.
    for r in self.routes.items {
        if ciEq(r.method, req.method) and matchPattern(r.pattern, path, *rc) {
            h := r.handler;
            h(*rc);
            return;
        }
    }

    // (RFC 9110 §9.3.2): HEAD must be supported wherever GET is —
    // a HEAD request with no HEAD route of its own (the exact pass above
    // found nothing, so an explicitly registered HEAD route still wins)
    // dispatches the matching GET route. The SERVER layer suppresses the
    // response body (automatic HEAD), so the handler needs no HEAD
    // awareness.
    if ciEq(req.method, "HEAD") {
        for r in self.routes.items {
            if ciEq(r.method, "GET") and matchPattern(r.pattern, path, *rc) {
                h := r.handler;
                h(*rc);
                return;
            }
        }
    }

    // No method+path match. Does the PATH match any route (wrong method)
    // → 405 + Allow; else → 404.
    pathMatched := false;
    allow := "";
    hasGet := false;
    hasHead := false;
    for r in self.routes.items {
        if matchPattern(r.pattern, path, *rc) {
            pathMatched = true;
            if allow.len == 0 { allow = r.method; }
            else { allow = concat(allow, concat(", ", r.method)); }
            if ciEq(r.method, "GET") { hasGet = true; }
            if ciEq(r.method, "HEAD") { hasHead = true; }
        }
    }
    // (RFC 9110 §10.2.1): HEAD is implicitly supported wherever GET
    // is (the fallback pass above dispatches it), so Allow must say so —
    // unless an explicit HEAD route already put it in the list.
    if hasGet and !hasHead { allow = concat(allow, ", HEAD"); }

    if pathMatched {
        resp.status = 405;
        resp.body = "405 Method Not Allowed";
        resp.addHeader("Allow", allow);
        return;
    }

    if self.notFound != null {
        h := self.notFound;
        h(*rc);
        return;
    }
    resp.status = 404;
    resp.body = "404 Not Found";
}
