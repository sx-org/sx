// std.http — the event-loop HTTP server.
//
// Config/Server + the connection state machine, pool dispatch, response
// serialization, streaming, timeouts, observability. Drives the transport
// seam (tls.sx) and reuses the shared types (types.sx), both flat-imported
// so the server bodies read unqualified. Facade re-exports Server/Config/
// Stats/EventKind under `http`.
@import "modules/std/core.sx";         // out, @sizeOf, Allocator, Context
@import "modules/std/mem.sx";          // Arena
clib   :: @import "modules/std/c.sx";  // namespace `clib` (not `c` — `c` is a local conn var throughout)
socket :: @import "modules/std/socket.sx";
thread :: @import "modules/std/thread.sx";
event  :: @import "modules/std/event.sx";
time   :: @import "modules/std/time.sx";
@import "modules/std/http/types.sx";   // Request, Response, findHeader, decodeChunked, reasonFor, …
@import "modules/std/http/tls.sx";     // TlsConn, TlsAcceptor, TlsStep
@import "modules/std/http/fiber.sx";   // FiberRunner (fiber-handler seam)
fs :: @import "modules/std/fs.sx";     // unlink for the AF_UNIX listener's socket file
@import "modules/std/compress.sx";     // shared codec Error/Progress contract
@import "modules/std/http/content_encoding.sx";

libc :: clib.libc;
// run()'s backoff between consecutive loop failures (never on the
// serving fast path — only after tick() itself has already failed).
usleep :: (usec: i64) -> i32 extern libc;
// (the overlap-safe memmove is clib.memmove — the shared libc surface.)

HttpErr :: error {
    Bind;    // socket/bind/listen failed for the configured address; or
             // bindAddr / unixPath was unusable
    Loop;    // the readiness loop could not be created or waited on
    Config;  // invalid Config combination (streamRequestBody
             // requires pool mode; unixPath with bindAddr or
             // reusePort — see each field's doc)
}

// unlink an AF_UNIX listener's socket file (init's stale-file removal
// and the close()/stop() teardown). Stack-NUL-copies the path for the
// syscall; sun_path bounds the length, so an over-long path is a no-op
// (init already rejected it).
unlinkPath :: (path: string) {
    if path.len == 0 or path.len > 110 { return; }
    pb : [112]u8 = ---;
    clib.memcpy(*pb[0], path.ptr, path.len);
    pb[path.len] = 0;
    p : string = .{ ptr = *pb[0], len = path.len };
    fs.deleteFile(p);
}

// tear down a bound-but-unusable listener on an init
// error path — a failed construction never reaches close()/stop(), so the
// AF_UNIX socket file the bind just created must be removed HERE.
closeListener :: (lfd: i32, unixPath: string) {
    socket.close(lfd);
    if unixPath.len > 0 { unlinkPath(unixPath); }
}

// The kind of event handed to Config.onEvent. The hook
// is the user's escape hatch to LOG/COUNT faults that otherwise close a
// connection silently — the server forces no format. `detail` carries the
// HTTP status (PARSE_ERROR), an errno-ish code, or 0 (see each call site).
EventKind :: enum {
    ACCEPT;         // a connection was accepted (slot = the new slot)
    CLOSE;          // a connection slot was closed/recycled
    ACCEPT_FAULT;   // accept() faulted, or a slot/nonblock setup failed → fd dropped
    READ_FAULT;     // a read faulted (peer reset / closed mid-request) → silent close
    WRITE_FAULT;    // a write faulted, or arming the write watch failed → silent close
    PARSE_ERROR;    // a request was rejected; detail = the HTTP status (400/413/431/501)
    TIMEOUT;        // a connection was evicted at its delivery/keepalive deadline
    REJECTED_503;   // backpressure: the pool backlog was full → 503 shed
    LISTEN_ERROR;   // the readiness loop itself failed (tick/wait error);
                    // detail = the CONSECUTIVE failure count. At
                    // LOOP_FAULT_LIMIT consecutive failures run() gives up
                    // and returns (see run).
    HANDLER_TIMEOUT;// (pool mode) a CONN_HANDLING request overran
                    // handlerTimeoutMs: the loop sent 504 + closed the
                    // slot; the worker's late completion will be discarded.
    TLS_HANDSHAKE_FAULT;// a TLS handshake failed or the peer dropped
                    // mid-handshake → the slot is closed; never served plaintext.
}

// Metrics snapshot. All fields are plain i64 counters that ONLY the
// loop thread mutates (see the note on Server's stat fields) — Server.stats
// copies them out, no lock needed. Cumulative totals except activeConns
// and poolQueueDepth, which are live gauges.
Stats :: struct {
    activeConns: i64 = 0;     // connections currently occupying a slot (gauge)
    acceptedTotal: i64 = 0;   // connections accepted since init
    closedTotal: i64 = 0;     // connection slots closed since init
    requestsServed: i64 = 0;  // requests whose response began sending
    errors4xx: i64 = 0;       // parser/client errors (400/413/431)
    errors5xx: i64 = 0;       // server errors (500/501/503)
    timeouts: i64 = 0;         // deadline evictions
    rejected503: i64 = 0;     // 503 backpressure sheds (subset of errors5xx)
    poolQueueDepth: i64 = 0; // pending pool completions awaiting drain (gauge)
    bytesIn: i64 = 0;         // request bytes consumed off the wire
    bytesOut: i64 = 0;        // response bytes written to the wire
}


// httpz-mirroring knobs (single-worker subset).
Config :: struct {
    port: i64 = 8080;
    backlog: i32 = 128;
    maxConn: i64 = 256;             // workers.maxConn
    // MAXIMUM bytes one request (headers + body) may occupy. The
    // per-connection buffer starts at READ_BUF_INITIAL and grows on
    // demand toward this limit (a declared Content-Length sizes it in
    // one step); a grown buffer is retained for slot reuse.
    readBufCap: i64 = 1048576;
    // MAXIMUM decoded request-body size (bytes). Enforced EARLY: a
    // declared Content-Length over this → 413 before any body is buffered;
    // a chunked body whose accumulated decoded length crosses this → 413 as
    // soon as a chunk-size header pushes the running total over (the data
    // bytes for that chunk are never read into the slot). Defaults to
    // readBufCap so it is always ≤ the buffer the raw request must fit in;
    // set it smaller to reject big bodies without growing the read buffer.
    // 0 means "use readBufCap" (the buffer cap is the hard ceiling either
    // way — the raw request, framing included, can never exceed readBufCap).
    maxBody: i64 = 0;
    timeoutRequestMs: i64 = 5000;  // deliver a full request, or evicted
    timeoutKeepaliveMs: i64 = 5000;// idle between requests, or evicted
    requestCount: i64 = 100;        // requests per connection, then close
    // Handler dispatch. 0 (default) runs handlers INLINE on the loop
    // thread — measured ~1.7x faster than pool(4) for a trivial handler
    // (bench/BENCH-HTTPZ.md: one hand-off + completion drain saved per
    // request).
    // N > 0 dispatches each parsed request to a thread pool of N
    // workers (slow handlers stop stalling the loop, httpz's shape);
    // requires the Server's constructing allocator to be THREAD-SAFE
    // (GPA/malloc — never an Arena).
    threadPoolCount: i64 = 0;
    threadPoolBacklog: i64 = 500;  // queued jobs beyond running ones; full = 503 shed
    // Per-request handler deadline (ms; 0 = disabled). Bounds the time a
    // request may spend in CONN_HANDLING so one slow/hung handler can't
    // permanently consume capacity. ENFORCEMENT DIFFERS BY MODE:
    //   • POOL MODE (threadPoolCount > 0): the handler runs on a WORKER, so
    //     the LOOP thread enforces a HARD timeout — a connection past its
    //     handler-deadline gets a 504, is closed/freed, and its slot gen is
    //     bumped so the worker's eventual (late) completion is discarded. The
    //     server stays responsive; the one stuck worker is lost capacity
    //     (there is NO pthread_cancel — cancelling a thread mid-sx-allocation
    //     is unsafe — so the worker runs to completion, then its result is
    //     dropped). This is the real, testable guarantee.
    //   • INLINE MODE (threadPoolCount == 0): the handler runs ON the loop
    //     thread and CANNOT be preempted without signals. A hung inline
    //     handler hangs the WHOLE server — there is NO hard timeout. The
    //     deadline is exposed to the handler (Request.deadlineMs) so a
    //     COOPERATIVE handler can self-limit; that is the only enforcement.
    //     Untrusted or slow handlers MUST use pool mode.
    handlerTimeoutMs: i64 = 30000;
    // Header-block bounds (request-smuggling / resource-exhaustion guard):
    // too many header lines, or any single line too long, → 431.
    maxHeaders: i64 = 100;          // max header lines in one request
    maxHeaderLine: i64 = 8192;     // max bytes in a single header line
    // lingering close: when an ERROR response (400/413/431/501/503/504)
    // finishes sending on a connection that is being closed, the client's
    // remaining request bytes are often still unread in our receive queue —
    // an immediate close() would make the kernel RST and DISCARD any unsent
    // response bytes, so the client sees a reset instead of the error it is
    // owed. Instead the server shutdown(SHUT_WR)s (FIN after the response),
    // then reads and DISCARDS inbound bytes until EOF or this deadline, and
    // only then closes. 0 selects the abrupt close. Normal keep-alive
    // closes don't linger (nothing is pending by protocol contract).
    lingerTimeoutMs: i64 = 1000;
    // Graceful shutdown (Server.stop): after stop is requested the loop
    // stops accepting, closes idle keep-alives, and drains in-flight
    // requests until none remain OR this many ms elapse — then run()
    // returns. A drain that overruns the deadline force-closes whatever
    // is still in flight.
    shutdownTimeoutMs: i64 = 5000;
    // Observability hook (OPTIONAL — default null is silent, zero overhead
    // beyond a null check). When non-null it is
    // called from the LOOP thread at every fault / key lifecycle site that
    // otherwise closes silently: (ctx, kind, slot, detail). `detail` is the
    // HTTP status for PARSE_ERROR, otherwise an errno-ish code or 0. The
    // signature mirrors the handler convention (fn-ptr + an opaque ctx word
    // the user gives init via onEventCtx). The user formats however they
    // want; the server never allocates for this.
    onEvent: (ctx: usize, ev: EventKind, slot: i64, detail: i64) -> void = null;
    onEventCtx: usize = 0;
    // TLS: when set, every accepted connection is served over
    // TLS via this acceptor (see TlsAcceptor). null = plaintext HTTP.
    // Supplied by an opt-in provider module so non-TLS programs never
    // compile the crypto. The acceptor's state must outlive the Server.
    tls: ?TlsAcceptor = null;
    // bind the listener with SO_REUSEPORT so SEVERAL Servers (each
    // its own thread + event loop + slots + stats) can share one port —
    // the kernel distributes incoming connections across the listeners
    // (linux hashes the 4-tuple; darwin favors recent binders). This is
    // the multi-loop scaling pattern: run N instances instead of making
    // one loop multi-threaded. Opt-in: every sharing listener must set
    // it, and a plain bind on a shared port still fails loudly.
    // See docs/http-server.md "Scaling across cores".
    reusePort: bool = false;
    // the listener's bind address — a NUMERIC literal ("127.0.0.1",
    // "::", "::1"); "" (default) binds v4 INADDR_ANY. The family follows
    // the literal (a v6 literal makes an AF_INET6 listener). A value that
    // parses as neither family is `HttpErr.Bind` — never a fallback bind.
    bindAddr: string = "";
    // non-empty = an AF_UNIX listener on this path (`port`,
    // `bindAddr` and `reusePort` do not apply; combining with bindAddr
    // or reusePort is `HttpErr.Config`). THE PATH BELONGS TO THE SERVER —
    // exclusively: whatever file is there is unlinked before bind (a
    // regular file included — point this at nothing you value), and
    // close()/stop() remove it. Corollary: two servers configured with
    // the SAME path sabotage each other (the second init unlinks the
    // first's live socket; either teardown unlinks the other's) — give
    // each server its own path. The string's bytes must outlive the
    // Server (teardown reads it).
    unixPath: string = "";
    // every AF_INET6 listener sets IPV6_V6ONLY explicitly from this
    // — false (default) makes "::" deterministic dual-stack (v4 arrives
    // as mapped addresses), true binds v6 only. Never the OS default.
    ipv6Only: bool = false;
    // value of the `Server:` response header; "" (default) sends
    // none. The string's bytes must outlive the Server (a literal, or
    // caller-owned storage) — pool workers read it while serializing.
    // Emitted VERBATIM, like contentType/extraHeaders: developer-owned
    // config, so it must not contain CR/LF (that would inject headers).
    serverName: string = "";
    // Opt-in negotiated response compression. Fixed bodies at or above
    // `compressMinSize` and every streamed body with a compressible media
    // type are encoded when Accept-Encoding permits gzip/deflate. The
    // default stays identity, preserving existing wire behavior. The level
    // is the shared std.compress level (0...10).
    compressResponses: bool = false;
    compressMinSize: i64 = 1024;
    compressLevel: i64 = 6;
    // dispatch every body-carrying request (Transfer-Encoding, or a
    // Content-Length > 0) at HEADERS-COMPLETE and hand the handler an
    // incremental reader (req.readBody: > 0 bytes / 0 end / -1 fault;
    // req.body is "" then) instead of accumulating the decoded body first.
    // POOL MODE ONLY — the reader BLOCKS the worker until the loop thread
    // feeds more bytes; an inline handler runs ON the loop thread, which
    // must stay free to do that feeding, so init raises `HttpErr.Config` when
    // this is set with threadPoolCount == 0 (the fiber mode will lift
    // the restriction by yielding instead of blocking).
    // STREAMED REQUESTS ARE EXEMPT FROM maxBody — bodies larger than any
    // buffer are the point; the reading handler is the bound (respond and
    // return without draining to refuse one — the server then closes the
    // connection). The delivery deadline (timeoutRequestMs) becomes a
    // STALL bound, refreshed on every piece of body progress; the handler
    // deadline is armed once the body completes.
    // fibers lift the pool-only restriction — a fiber's readBody
    // SUSPENDS the fiber instead of blocking a worker.
    streamRequestBody: bool = false;
    // run every handler as an M:1 FIBER on the loop thread (see the
    // FiberRunner seam — the provider module fiber_sched.sx is an opt-in
    // import, so non-fiber programs never compile the fiber runtime). A
    // fiber handler may block-style req.readBody (the fiber suspends;
    // the body pump wakes it) while everything stays single-threaded.
    // COOPERATIVE: a compute-bound handler still stalls the whole server
    // exactly like inline mode — there is NO preemption and NO hard
    // handler timeout (stays advisory); the win is I/O-shaped waiting.
    // Mutually exclusive with threadPoolCount > 0 (`HttpErr.Config`). The
    // runner's state must outlive the Server; its deinit is the caller's,
    // after Server.close. Handlers must not call the scheduler's own
    // sleep/fd-wait (the server drives fibers with a non-blocking poll).
    // STACK: a fiber handler runs on the provider's bounded fiber stack
    // (sched.sx: 128 KB, guard-paged — an overflow faults immediately,
    // never corrupts a neighbor); keep large buffers on the heap or the
    // per-request arena, not in handler locals. BACKPRESSURE: fiber mode
    // has no 503 shed (there is no queue to fill — at most one fiber per
    // occupied slot, bounded by maxConn; spawn failure is a loud abort).
    // resp.stream producers keep the INLINE contract in fiber mode (the
    // loop pulls them after the fiber is reaped — ctx must be
    // caller-owned; the fiber's stack is gone by then).
    fibers: ?FiberRunner = null;
}

READ_BUF_INITIAL :: 16384;

// how large a persistent per-conn write buffer (Conn.wbuf)
// may stay RETAINED once its connection closes. Unlike readBuf (bounded
// by config.readBufCap), wbuf grows to the largest inline response the
// slot ever served — one huge response must not pin that memory for the
// server's lifetime. An over-cap wbuf is freed at connClose; live
// connections keep whatever they grew (a retention policy, not a size
// limit).
WBUF_RETAIN_CAP :: 65536;

// consecutive tick()/wait() failures run() tolerates (with backoff +
// LISTEN_ERROR emissions) before concluding the loop is dead and returning.
LOOP_FAULT_LIMIT :: 5;

// capacity of one streamed request's loop→worker body channel. The
// loop parks the conn's read watch when it fills (backpressure); a bigger
// buffer only smooths hand-offs, it never changes semantics.
BODY_CHAN_CAP :: 65536;

// The bounded scratch a streamed/chunked response drains through.
// Each refill pulls at most STREAM_PIECE bytes from the producer, frames
// them as one chunk, and stages the framing in this buffer — so the
// server NEVER holds the whole body, only one bounded piece + its framing.
// STREAM_BUF_CAP leaves room for the largest chunk header (16 hex digits
// + CRLF) + the piece + trailing CRLF.
STREAM_PIECE :: 16384;
STREAM_BUF_CAP :: STREAM_PIECE + 32;

// Connection slot states.
CONN_FREE      :u8: 0;
CONN_READING   :u8: 1;   // awaiting a complete request (deadline: request)
CONN_WRITING   :u8: 2;   // response partially sent (deadline: request)
CONN_KEEPALIVE :u8: 3;   // between requests (deadline: keepalive)
CONN_HANDLING  :u8: 4;   // request dispatched to the pool: the loop must
                         // not read or serve the slot until the completion
                         // lands (response ordering; the worker itself owns
                         // a COPY of the request bytes — see HandlerJob)
CONN_TLS_HANDSHAKE :u8: 5;// negotiating TLS before the first request:
                         // readiness drives c.tls.handshake() incrementally
                         // (deadline: request) until Done → CONN_READING
CONN_LINGER    :u8: 6;   // error response fully sent + SHUT_WR done:
                         // reading + discarding inbound until EOF or the
                         // linger deadline, then close. Owes nothing.
CONN_BODY      :u8: 7;   // headers dispatched to a pool worker, body
                         // still STREAMING: the loop keeps reading, decodes
                         // the framing incrementally and pushes the decoded
                         // bytes into the conn's BodyChan. At end-of-body
                         // the slot becomes CONN_HANDLING.

// one deadline-heap entry (see Server.dheap). Entries are WAKE-UP
// HINTS, not the source of truth: the sweep re-checks the conn's CURRENT
// relevant deadline before evicting, so a stale entry (slot recycled,
// deadline extended) costs one spurious pop — never a wrong eviction.
DlEntry :: struct {
    deadline: i64 = 0;
    slot: i64 = 0;
    gen: i64 = 0;
}

Conn :: struct {
    fd: i32 = -1;
    state: u8 = 0;
    // O(1) slot recycling: singly-linked free list threaded through
    // the slots (Server.freeHead → nextFree → … → -1). A slot is ON the
    // list iff state == CONN_FREE.
    nextFree: i64 = -1;
    // deadline value of this conn's live heap entry (0 = none).
    // Kept so a deadline EXTENSION doesn't push a second entry — the live
    // (earlier) entry re-arms itself from the current deadline when it
    // pops. Bounds the heap at ~one entry per active conn.
    hqDeadline: i64 = 0;
    readBuf: [*]u8 = null;   // grows toward config.readBufCap, reused across connections
    readCap: i64 = 0;
    readLen: i64 = 0;
    outBuf: [*]u8 = null;    // the response bytes currently draining
    outLen: i64 = 0;
    outSent: i64 = 0;
    // outBuf ownership: true = outBuf is a per-response allocation
    // (pool completion attach, stream scratch) freed when fully sent /
    // on close; false = outBuf aliases this conn's persistent wbuf
    // (inline serialization) and must NOT be freed per response.
    outOwned: bool = true;
    // persistent per-conn write buffer for inline serialization —
    // grown on demand via ownAlloc, reused across requests AND across
    // connections on this slot (like readBuf), freed only by
    // Server.close. Kills the alloc/free pair per inline response.
    wbuf: [*]u8 = null;
    wbufCap: i64 = 0;
    // Streamed/chunked output. When `streaming` is set, outBuf is a
    // BOUNDED scratch (STREAM_BUF_CAP) that holds the current chunk-framed
    // piece; writeMore drains it then refills by pulling the next piece
    // from `producer` (resumable via streamOff). Memory stays bounded
    // regardless of total body size.
    streaming: bool = false;
    producer: StreamProducer = null;
    producerCtx: usize = 0;
    // Inline/fiber streamed response content encoder. Pool workers encode
    // before feeding OutChan, so this is null for their streams. The state
    // owns one bounded source piece + codec state and is released at stream
    // end or connection teardown.
    encodedProducer: *EncodedProducer = null;
    streamOff: i64 = 0;      // running bytes pulled from the producer
    streamDone: bool = false;// the producer returned 0 (zero chunk queued)
    // worker-fed stream (pool mode): non-null = streamRefill takes
    // from this channel instead of calling `producer` (which stays the
    // INLINE path). streamWaiting: the channel was empty mid-drain — the
    // write watch is dropped and the worker's next feed wakes the loop.
    ochan: *OutChan = null;
    streamWaiting: bool = false;
    deadline: i64 = 0;
    // incremental parse progress for the request currently at the
    // FRONT of readBuf. Reset whenever the front request is consumed
    // (compaction) or the buffer is discarded — see resetParse.
    //   hdrEnd  — cached index of the \r\n\r\n terminator (-1 = not seen);
    //   scanPos — bytes known to contain no terminator (scan resumes at
    //              scanPos - 3 so a straddling terminator is caught);
    //   chunk_*  — resumable chunked-validation checkpoint (types.ChunkScan
    //              shape) for the body after hdrEnd. Valid iff chunkActive.
    hdrEnd: i64 = -1;
    scanPos: i64 = 0;
    chunkActive: bool = false;
    chunkRp: i64 = 0;
    chunkDecoded: i64 = 0;
    // the interim "100 Continue" for the request at the FRONT of
    // readBuf has been sent — at most one per request, however many
    // need-more read cycles its body takes. Reset with the parse state.
    contSent: bool = false;
    // the request dispatched to the pool was a HEAD. The handler
    // timeout sweep needs it — its 504 must suppress the body like any
    // other HEAD response (the worker's own serialization is discarded).
    headReq: bool = false;
    // this close is an ERROR close — once the response drains, linger
    // (shutdown write side + drain-and-discard) instead of an abrupt close,
    // so the error bytes survive the kernel's close-with-unread-data RST.
    lingerClose: bool = false;
    // Monotonic deadline for a handler running in the pool. Set when the
    // slot enters CONN_HANDLING (job submitted); checked by the tick sweep
    // (which otherwise skips CONN_HANDLING for the delivery deadline). 0 =
    // no handler timeout (handlerTimeoutMs disabled or inline mode).
    handlerDeadline: i64 = 0;
    // streaming request body (CONN_BODY): the loop→worker channel plus
    // the incremental framing decoder's state. bodyMode: 0 = none, 1 =
    // Content-Length countdown (bodyRemaining = bytes still owed), 2 =
    // chunked (bchState: 0 = size line, 1 = chunk data with bodyRemaining
    // counting the chunk's bytes left, 2 = the CRLF after a chunk's data,
    // 3 = trailer block with bodyRemaining counting trailer LINES).
    // bodyParked: the read watch is parked on a full channel, awaiting the
    // draining worker's wake (resumeBodyPumps).
    bchan: *BodyChan = null;
    bodyMode: u8 = 0;
    bodyRemaining: i64 = 0;
    bchState: u8 = 0;
    bodyParked: bool = false;
    // fiber mode: the live fiber's opaque handle (0 = none). The body
    // pump / eof / abort / connClose WAKE it; the fiber tail marks
    // fiberDone (+ fiberEarly when it responded over an unfinished body)
    // and finalizeFibers attaches the response after the drive.
    fiberH: usize = 0;
    fiberDone: bool = false;
    fiberEarly: bool = false;
    served: i64 = 0;
    closeAfter: bool = false;
    writeArmed: bool = false;
    gen: i64 = 0;   // bumped on close; a stale pool completion is dropped
    // TLS: per-connection TLS session from cfg.tls.accept
    // (null = plaintext). Drives the transport seam (connRead/connWrite);
    // closed + freed via its own TlsConn.close in connClose.
    tls: ?TlsConn = null;
    // DATA-phase cross-direction TLS wants — which OPPOSITE readiness
    // the last would-blocked TLS op needs (renegotiation / ticket-flush
    // shaped flows; always false for plaintext):
    //   tlsRdWantWrite — the pending READ needs WRITABILITY: connRead
    //     armed the write watch; the ready loop routes the writable back
    //     into the read path (readMore / bodyReady).
    //   tlsWrWantRead  — the pending WRITE needs READABILITY: the write
    //     watch is NOT armed (a level-triggered writable would spin futile
    //     retries); the always-armed read watch delivers the retry, routed
    //     to writeMore.
    tlsRdWantWrite: bool = false;
    tlsWrWantRead: bool = false;

    // forget the incremental parse progress. Call whenever the
    // request at the front of readBuf is consumed (compaction slides the
    // next pipelined request to offset 0) or the buffered bytes are
    // discarded — stale offsets against new front bytes would corrupt the
    // parse.
    resetParse :: (self: *Conn) {
        self.hdrEnd = -1;
        self.scanPos = 0;
        self.chunkActive = false;
        self.chunkRp = 0;
        self.chunkDecoded = 0;
        self.contSent = false;
    }
}

// ── the loop→worker body channel ───────────────────────────────
// One per STREAMED request (Config.streamRequestBody): the loop thread
// decodes body framing as it arrives and pushes the decoded bytes here;
// the worker's req.readBody pulls, BLOCKING on the cond until bytes are
// buffered, the body ends (eof) or the connection faults. Bounded: when
// the buffer fills, feed() reports the shortfall AND marks `stalled` in
// the same critical section — the loop then PARKS the conn's read watch
// (Conn.bodyParked) and the next worker read that finds `stalled` set
// wakes the loop to resume. Heap-resident (ownAlloc): the conn and the
// job each hold a reference; the LAST release destroys the primitives and
// frees the buffer + the struct.
BodyChan :: struct {
    mu: thread.Mutex = .{};
    cv: thread.Cond = .{};
    buf: [*]u8 = null;
    cap: i64 = 0;
    len: i64 = 0;
    eof: bool = false;      // all body bytes pushed (loop side)
    fault: bool = false;    // conn faulted / evicted / bad framing (loop side)
    stalled: bool = false;  // a push fell short — the loop parked the watch
    drained: bool = false;  // the READER saw end-of-body (read returned 0)
    refs: i64 = 2;          // conn + job
    alloc: Allocator;       // ownAlloc: frees buf + self on the last release
    // Loop copy for the worker→loop wake. Captured at dispatch, which runs
    // strictly after init's unconditional addWake — so wakeFd is live in
    // the copy (the PoolState.loopCopy timing rule).
    lp: event.Loop = .{};

    // Worker side (the BodyReadFn): block until ≥ 1 byte, end, or fault.
    // Bytes buffered BEFORE a fault are still delivered — the fault only
    // surfaces once the buffer is dry. Wakes the loop when it drains a
    // stalled channel.
    read :: (self: *BodyChan, dst: [*]u8, want: i64) -> i64 {
        if want <= 0 { return 0; }
        self.mu.lock();
        while self.len == 0 and !self.eof and !self.fault {
            self.cv.wait(*self.mu);
        }
        if self.len == 0 {
            fa := self.fault;
            if !fa { self.drained = true; }
            self.mu.unlock();
            if fa { return -1; }
            return 0;
        }
        n := if want < self.len then want else self.len;
        clib.memcpy(dst, self.buf, n);
        rest := self.len - n;
        if rest > 0 { clib.memmove(self.buf, *self.buf[n], rest); }
        self.len = rest;
        wake := self.stalled;
        if wake { self.stalled = false; }
        self.mu.unlock();
        if wake { self.lp.wake(); }
        return n;
    }

    // Loop side: push up to `n` decoded bytes; returns how many fit. A
    // shortfall marks `stalled` in the SAME critical section (marking it
    // after unlock would race a worker that drains and checks between the
    // two — the wake would be lost and the parked conn would stall until
    // its deadline).
    feed :: (self: *BodyChan, src: [*]u8, n: i64) -> i64 {
        self.mu.lock();
        space := self.cap - self.len;
        take := if n < space then n else space;
        if take > 0 {
            clib.memcpy(*self.buf[self.len], src, take);
            self.len += take;
            self.cv.signal();
        }
        if take < n { self.stalled = true; }
        self.mu.unlock();
        return take;
    }

    // Loop side: mark end-of-body (fault = false) or a connection fault
    // (fault = true) and wake a blocked reader. Idempotent.
    finish :: (self: *BodyChan, fault: bool) {
        self.mu.lock();
        if fault { self.fault = true; }
        else { self.eof = true; }
        self.cv.broadcast();
        self.mu.unlock();
    }

    // Worker side, post-handler: did the reader consume to end-of-body?
    // A response over an UNDRAINED body can never keep the connection
    // (the wire still carries request bytes) — the worker serializes
    // Connection: close then.
    wasDrained :: (self: *BodyChan) -> bool {
        self.mu.lock();
        d := self.drained;
        self.mu.unlock();
        return d;
    }

    // Drop one reference (conn or job side); the last one destroys the
    // primitives and frees the buffer + the struct itself.
    release :: (self: *BodyChan) {
        self.mu.lock();
        self.refs -= 1;
        last := self.refs == 0;
        self.mu.unlock();
        if last {
            self.mu.destroy();
            self.cv.destroy();
            a := self.alloc;
            if self.buf != null { a.deallocBytes(self.buf); }
            a.deallocBytes(self);
        }
    }
}

// The BodyReadFn the server wires into a streamed request's Request
// (bodyReadCtx = the *BodyChan).
bodyChanRead :: (ctx: usize, dst: [*]u8, cap: i64) -> i64 {
    ch : *BodyChan = ctx.(*BodyChan);
    return ch.read(dst, cap);
}

// ── the worker→loop response-stream channel ────────────────────
// BodyChan's reverse twin, one per pool-mode STREAMED response: the WORKER
// that ran the handler keeps pulling the producer (inside the job's push
// scope — request views and the per-request arena stay alive, which
// retires the caller-owned-ctx UAF class) and feeds the bytes
// here; the loop takes them nonblocking into the chunk-framing scratch.
// Backpressure both ways: a full buffer BLOCKS the feeder on the cond; an
// empty one marks `hungry` so the next feed wakes the loop
// (resumeStreamPumps). Creation gives the worker one reference; queueing a
// completion retains the connection's reference. The last release frees.
// registered in PoolState.ochans so Server.close can abort every feeder
// BEFORE joining the pool (a blocked feeder would deadlock the join).
OUT_CHAN_CAP :: 65536;

OutChanTake :: enum {
    data;
    pending;
    eof;
    producerFault;
}

OutChan :: struct {
    mu: thread.Mutex = .{};
    cv: thread.Cond = .{};
    buf: [*]u8 = null;
    cap: i64 = 0;
    len: i64 = 0;
    eof: bool = false;      // producer finished (worker side)
    fault: bool = false;    // conn died / server closing — feeder aborts
    producerFault: bool = false; // producer/codec failed; close without terminator
    hungry: bool = false;   // loop found it empty; the next feed wakes lp
    refs: i64 = 1;          // worker initially; retained once for completion/conn
    alloc: Allocator;       // ownAlloc: frees buf + self on the last release
    lp: event.Loop = .{};   // loop copy for the worker→loop wake

    // Worker side: block until ALL n bytes are accepted or the conn
    // faults. False = aborted (stop producing; the loop already closed).
    feedAll :: (self: *OutChan, src: [*]u8, n: i64) -> bool {
        off : i64 = 0;
        while off < n {
            self.mu.lock();
            while self.cap - self.len == 0 and !self.fault {
                self.cv.wait(*self.mu);
            }
            if self.fault { self.mu.unlock(); return false; }
            space := self.cap - self.len;
            rem := n - off;
            take := if rem < space then rem else space;
            clib.memcpy(*self.buf[self.len], *src[off], take);
            self.len += take;
            off += take;
            w := self.hungry;
            if w { self.hungry = false; }
            self.mu.unlock();
            if w { self.lp.wake(); }
        }
        return true;
    }

    // Worker side: the producer returned clean EOF. The loop's next take
    // stages the terminator chunk after all buffered bytes drain.
    finishEof :: (self: *OutChan) {
        self.mu.lock();
        self.eof = true;
        w := self.hungry;
        if w { self.hungry = false; }
        self.mu.unlock();
        if w { self.lp.wake(); }
    }

    // Worker side: source/codec failure. Already-buffered bytes may drain, but
    // the loop then closes the connection without staging a zero chunk.
    finishFault :: (self: *OutChan) {
        self.mu.lock();
        self.producerFault = true;
        w := self.hungry;
        if w { self.hungry = false; }
        self.mu.unlock();
        if w { self.lp.wake(); }
    }

    // Loop side, NONBLOCKING. A zero-byte result distinguishes pending, clean
    // EOF, and producer fault so truncation can never masquerade as a clean
    // terminating chunk.
    take :: (self: *OutChan, dst: [*]u8, want: i64) -> (i64, OutChanTake) {
        self.mu.lock();
        n := if want < self.len then want else self.len;
        if n > 0 {
            clib.memcpy(dst, self.buf, n);
            rest := self.len - n;
            if rest > 0 { clib.memmove(self.buf, *self.buf[n], rest); }
            self.len = rest;
            self.cv.signal();   // space freed — unblock the feeder
        }
        status := OutChanTake.data;
        if n == 0 {
            if self.producerFault { status = .producerFault; }
            else if self.eof { status = .eof; }
            else { status = .pending; self.hungry = true; }
        }
        self.mu.unlock();
        return n, status;
    }

    // Loop side (or Server.close): the connection is gone — wake and stop
    // a blocked feeder. Idempotent.
    abort :: (self: *OutChan) {
        self.mu.lock();
        self.fault = true;
        self.cv.broadcast();
        self.mu.unlock();
    }

    retain :: (self: *OutChan) {
        self.mu.lock();
        self.refs += 1;
        self.mu.unlock();
    }

    // Drop one reference (conn or worker side); the last one destroys the
    // primitives and frees the buffer + the struct itself.
    release :: (self: *OutChan) {
        self.mu.lock();
        self.refs -= 1;
        last := self.refs == 0;
        self.mu.unlock();
        if last {
            self.mu.destroy();
            self.cv.destroy();
            a := self.alloc;
            if self.buf != null { a.deallocBytes(self.buf); }
            a.deallocBytes(self);
        }
    }
}

createOutChan :: (alloc: Allocator, lp: event.Loop) -> *OutChan {
    result := alloc.create(OutChan);
    if result == null { return null; }
    result.* = OutChan{ alloc = alloc, lp = lp };
    if !result.mu.setup() { alloc.deallocBytes(result); return null; }
    if !result.cv.setup() {
        result.mu.destroy();
        alloc.deallocBytes(result);
        return null;
    }
    bytes := alloc.alloc(u8, OUT_CHAN_CAP);
    if bytes.ptr == null {
        result.cv.destroy();
        result.mu.destroy();
        alloc.deallocBytes(result);
        return null;
    }
    result.buf = bytes.ptr;
    result.cap = OUT_CHAN_CAP;
    result
}

// The listener's udata; connection udata is the slot index.
LISTENER_UDATA :usize: 0xFFFFFFFF;
// The pool wake channel's udata.
WAKE_UDATA :usize: 0xFFFFFFFE;

// Serialized response bytes (shared by the inline and pooled paths).
OutBytes :: struct {
    buf: [*]u8 = null;
    len: i64 = 0;
}

// storage for one cached IMF-fixdate (29 bytes used; struct-wrapped
// so it can carry a `.{}` field default, like thread.MutexBuf).
DateBuf :: struct {
    bytes: [32]u8;
}

// One finished pool job, queued for the loop thread to attach.
Completion :: struct {
    slot: i64 = 0;
    gen: i64 = 0;
    out: OutBytes = .{};
    closeAfter: bool = false;
    consumed: i64 = 0;   // request bytes to drop from the read buffer
    // a streamed/chunked response. The worker serializes only the
    // head into `out` and then PUMPS the producer itself (inside the job's
    // push scope), feeding the body through `ochan` — the loop thread only
    // takes framed pieces from the channel; it never runs producer code.
    // streamed=false → out carries the whole fixed-body response (the fast
    // path) and ochan is null.
    streamed: bool = false;
    ochan: *OutChan = null;
}

// Heap-resident pool machinery: embeds a Mutex and is shared with
// worker threads, so it must never move (the Server struct itself is
// returned by value from init and may be copied).
PoolState :: struct {
    pool: *thread.Pool = null;
    mu: thread.Mutex = .{};
    done: [*]Completion = null;
    doneCap: i64 = 0;
    doneLen: i64 = 0;
    loopCopy: event.Loop = .{};   // Loop is an fd wrapper; copy-safe
    // every OutChan a worker is CURRENTLY pumping (registered before
    // the pump, removed before the worker's release; mu-guarded). Bounded
    // by the worker count — one pump per worker at a time. Server.close
    // aborts each so no feeder blocks the pool join. The registry sweep
    // alone is NOT window-free — a worker still before its register (e.g.
    // mid-handler) would escape a one-shot abort and block the join
    //  — so close() also sets `closing` in the same
    // critical section, and ochanRegister aborts any chan registered
    // after that: the worker's first feed then fails immediately.
    ochans: [*]*OutChan = null;
    ochansLen: i64 = 0;
    closing: bool = false;
}

// Append one finished job to the completion queue and wake the loop.
// (also called MID-job for a streamed response — the completion must
// be attached and draining while the same worker feeds the channel, or a
// stream larger than the channel would deadlock the worker.)
// A full queue can only mean the sizing invariant broke (doneCap covers
// maxConn + backlog + workers — see init); the drop is still handled
// LOUDLY: the response bytes are freed and a streamed chan is aborted +
// released (never a silently pinned worker or leaked chan) —
// the conn is evicted at its deadline .
queueCompletion :: (ps: *PoolState, alloc: Allocator, done: Completion) {
    dropped := false;
    ps.mu.lock();
    if ps.doneLen < ps.doneCap {
        ps.done[ps.doneLen] = done;
        ps.doneLen += 1;
    } else {
        dropped = true;
    }
    ps.mu.unlock();
    if dropped {
        if done.out.buf != null { alloc.deallocBytes(done.out.buf); }
        if done.ochan != null {
            done.ochan.abort();
            done.ochan.release();
        }
    }
    ps.loopCopy.wake();
}

// registry of channels being pumped (see PoolState.ochans). A chan
// registered after close() flipped `closing` is aborted on the spot — the
// pump's first feed fails and the worker proceeds straight to the join.
ochanRegister :: (ps: *PoolState, ch: *OutChan) {
    ps.mu.lock();
    ps.ochans[ps.ochansLen] = ch;
    ps.ochansLen += 1;
    late := ps.closing;
    ps.mu.unlock();
    if late { ch.abort(); }
}

ochanUnregister :: (ps: *PoolState, ch: *OutChan) {
    ps.mu.lock();
    i : i64 = 0;
    while i < ps.ochansLen {
        if ps.ochans[i] == ch {
            ps.ochans[i] = ps.ochans[ps.ochansLen - 1];
            ps.ochansLen -= 1;
            break;
        }
        i += 1;
    }
    ps.mu.unlock();
}

// What a worker needs to run one handler. Allocated per dispatch from the
// server's thread-safe allocator as ONE block: the job header followed by a
// COPY of the raw request bytes (`req`'s views point into that tail, never
// into the connection's read buffer — a handler-timeout can free/reuse the
// slot and its buffer while the worker still runs). Freed as one block in
// runHandlerJob.
HandlerJob :: struct {
    handler: (*Request, *Response, usize) -> void;
    appCtx:  usize = 0;
    ps: *PoolState = null;
    alloc: Allocator;
    req: Request = .{};
    slot: i64 = 0;
    gen: i64 = 0;
    keep: bool = false;
    consumed: i64 = 0;
    // Config.serverName, forwarded so the worker's serialization
    // can stamp the Server: header (the bytes outlive the Server per the
    // Config field's contract).
    serverName: string = "";
    compressResponses: bool = false;
    compressMinSize: i64 = 1024;
    compressLevel: i64 = 6;
    // the body channel of a STREAMED request (null = accumulated).
    // The job holds one of the two references; runHandlerJob wires it
    // into req.bodyReadFn/_ctx and releases it after the handler returns.
    chan: *BodyChan = null;
    // fiber mode: the owning Server — the fiber tail completes the
    // request same-thread (serialize into the conn's wbuf, gen-checked)
    // and bodyFiberRead reaches the runner through it. Null in pool mode.
    srv: *Server = null;
}

addAcceptEncodingVary :: (resp: *Response) {
    if !hasHeaderToken(resp.extraHeaders, "vary", "accept-encoding")
        and !hasHeaderToken(resp.extraHeaders, "vary", "*") {
        // A second Vary field is equivalent to extending the existing field,
        // and avoids rewriting caller-owned preformatted headers.
        resp.addHeader("Vary", "Accept-Encoding");
    }
}

hasStrongValidatorOrDigest :: (raw: string) -> bool {
    at : i64 = 0;
    while at < raw.len {
        lineEnd := at;
        while lineEnd < raw.len and raw[lineEnd] != '\r' and raw[lineEnd] != '\n' { lineEnd += 1; }
        colon := at;
        while colon < lineEnd and raw[colon] != ':' { colon += 1; }
        if colon < lineEnd {
            field := raw[at..colon];
            if asciiIeq(field, "content-digest") or asciiIeq(field, "repr-digest")
                or asciiIeq(field, "digest") or asciiIeq(field, "content-md5") { return true; }
            if asciiIeq(field, "etag") {
                value := trimOws(raw[colon + 1..lineEnd]);
                if value.len < 2 or asciiLower(value[0]) != 'w' or value[1] != '/' { return true; }
            }
        }
        while lineEnd < raw.len and (raw[lineEnd] == '\r' or raw[lineEnd] == '\n') { lineEnd += 1; }
        at = lineEnd;
    }
    false
}

setNotAcceptable :: (resp: *Response) {
    resp.* = Response{ status = 406, body = "", allowCompression = false };
    resp.addHeader("Vary", "Accept-Encoding");
}

// Apply the server's response-compression policy after the handler returns
// but before any response bytes are serialized. Fixed bodies are encoded in
// the current per-request arena. Streamed bodies return the selected coding;
// startStream / the pool worker drives a bounded incremental encoder.
prepareContentEncoding :: (req: *Request, resp: *Response, enabled: bool, minSize: i64, level: i64, alloc: Allocator) -> Encoding {
    // Message framing is exclusively server-owned. Reject a handler response
    // that tries to inject a second delimiter before any bytes are serialized.
    if hasHeader(resp.extraHeaders, "content-length") or hasHeader(resp.extraHeaders, "transfer-encoding") {
        resp.* = Response{ status = 500, body = reasonFor(500), allowCompression = false };
        return .identity;
    }
    if resp.status == 204 or resp.status == 304 { return .identity; }

    accept := parseAcceptEncoding(req.headersRaw);
    existingCoding := hasHeader(resp.extraHeaders, "content-encoding");
    if enabled or accept.found or existingCoding { addAcceptEncodingVary(resp); }

    // Existing/stacked codings belong to the handler. Preserve them byte-for-
    // byte only when every coding is accepted; never automatically re-encode.
    if existingCoding {
        if !contentCodingAcceptable(*accept, resp.extraHeaders) { setNotAcceptable(resp); }
        return .identity;
    }

    eligible := enabled and resp.allowCompression
        and !hasHeader(req.headersRaw, "range")
        and resp.status != 206 and resp.status != 416
        and !hasHeader(resp.extraHeaders, "content-range")
        and !hasHeaderToken(resp.extraHeaders, "cache-control", "no-transform")
        and !hasStrongValidatorOrDigest(resp.extraHeaders)
        and compressibleContentType(resp.contentType);
    if !eligible {
        if !identityAcceptable(*accept) { setNotAcceptable(resp); }
        return .identity;
    }

    selected := preferredEncoding(*accept);
    if selected == .unacceptable { setNotAcceptable(resp); return .identity; }
    if selected == .identity { return .identity; }
    if !resp.streamed and resp.body.len < minSize {
        if !identityAcceptable(*accept) { setNotAcceptable(resp); }
        return .identity;
    }
    if resp.streamed and resp.producer != null {
        resp.addHeader("Content-Encoding", if selected == .gzip then "gzip" else "deflate");
        return selected;
    }

    failed := false;
    encoded := encode(resp.body, selected, level, alloc) catch {
        failed = true;
        ""
    };
    if failed {
        // Compression state could not be built before the head went out: a
        // plain 500 is honest; never advertise an encoding for identity data.
        resp.* = Response{ status = 500, body = reasonFor(500), allowCompression = false };
        return .identity;
    }
    resp.body = encoded;
    resp.addHeader("Content-Encoding", if selected == .gzip then "gzip" else "deflate");
    selected
}

// the fiber-mode BodyReadFn — the same-thread twin of BodyChan.read.
// Instead of blocking on the cond (nobody else would feed it — the loop IS
// this thread), an empty channel SUSPENDS the fiber; the body pump wakes it
// when bytes / eof / a fault arrive. ctx = the *HandlerJob (carries both
// the channel and the server, whose cfg.fibers parks the fiber). The
// mutex is uncontended here (single thread) — kept for field-protocol
// uniformity with the pool path, not for exclusion.
bodyFiberRead :: (ctx: usize, dst: [*]u8, cap: i64) -> i64 {
    job : *HandlerJob = ctx.(*HandlerJob);
    ch := job.chan;
    if cap <= 0 { return 0; }
    while true {
        ch.mu.lock();
        if ch.len > 0 {
            n := if cap < ch.len then cap else ch.len;
            clib.memcpy(dst, ch.buf, n);
            rest := ch.len - n;
            if rest > 0 { clib.memmove(ch.buf, *ch.buf[n], rest); }
            ch.len = rest;
            wake := ch.stalled;
            if wake { ch.stalled = false; }
            ch.mu.unlock();
            // A stalled pump parked the read watch; the sticky self-wake
            // fires resumeBodyPumps on the next tick, exactly like the
            // pool path's worker wake.
            if wake { ch.lp.wake(); }
            return n;
        }
        fa := ch.fault;
        eo := ch.eof;
        if eo and !fa { ch.drained = true; }
        ch.mu.unlock();
        if fa { return -1; }
        if eo { return 0; }
        job.srv.cfg.fibers.suspendCurrent();   // the pump / eof / abort wakes us
    }
    return -1;
}

// The pool task: fabricated per-job arena over the (thread-safe) server
// allocator; serialize into job-owned bytes; queue the completion; wake
// the loop.
runHandlerJob :: (arg: usize) {
    job : *HandlerJob = arg.(*HandlerJob);
    resp : Response = .{};
    arena := Arena.init(job.alloc, 65536);
    ob : OutBytes = .{};
    streamed := false;
    completed := false;   // a streamed response queues its completion mid-job
    // the worker stamps its OWN Date — the Server's per-second cache
    // is loop-thread-only. One clock read + 29-byte format per response;
    // the serialize concats copy the bytes, so a stack buffer suffices.
    // Stamped AFTER the handler runs (below) so a slow handler's Date is
    // the response's generation time, not its start time (RFC 9110: "as
    // close as practical to generating the message").
    db : [32]u8 = ---;
    date : string = "";
    // keep may be DOWNGRADED post-handler — a response over a body
    // the reader never drained cannot keep the connection (the wire still
    // carries request bytes), so the serialized header must say close.
    keep := job.keep;
    push .{ allocator = arena } {
        h := job.handler;
        // wire the streaming reader into the request the handler sees.
        if job.chan != null {
            job.req.bodyReadFn = bodyChanRead;
            job.req.bodyReadCtx = job.chan.(usize);
        }
        // a HEAD response never carries body bytes; a 204/304 never
        // carries a body regardless of method — and a no-body status wins
        // over a handler that (contradictorily) also called stream().
        // isHead is read from the PARSED method BEFORE the handler runs —
        // a handler mutating req.method must not flip body suppression.
        isHead := asciiIeq(job.req.method, "head");
        h(*job.req, *resp, job.appCtx);
        if job.chan != null and !job.chan.wasDrained() { keep = false; }
        encoding := prepareContentEncoding(*job.req, *resp,
            job.compressResponses, job.compressMinSize,
            job.compressLevel, context.allocator);
        encoded : *EncodedProducer = null;
        if resp.streamed and resp.producer != null and !isHead and encoding != .identity {
            encoded = createEncodedProducer(encoding,
                job.compressLevel, resp.producer, resp.producerCtx,
                job.alloc);
            if encoded == null {
                resp = Response{ status = 500, body = reasonFor(500), allowCompression = false };
                keep = false;
                encoding = .identity;
            }
        }
        formatImfDate(time.nowSecs(), *db[0]);
        date = string{ ptr = *db[0], len = IMF_DATE_LEN };
        noBody := resp.status == 204 or resp.status == 304;
        if resp.streamed and resp.producer != null and !isHead and !noBody {
            // chunked — serialize ONLY the head (job.alloc-owned),
            // then pump the producer ON THIS WORKER, inside the push scope:
            // the request views and the per-request arena stay alive for
            // every pull, so producerCtx may reference them (there is no
            // caller-owned-ctx UAF window in pool mode). The bytes
            // flow to the loop through a bounded OutChan; the completion is
            // queued BEFORE the pump so the loop drains while we feed (a
            // stream larger than the channel would deadlock otherwise).
            // COST: this worker is pinned for the stream's lifetime — size
            // the pool for the number of concurrent streamed responses.
            och := createOutChan(job.alloc, job.ps.loopCopy);
            if och == null {
                // Allocation/primitive setup failed before the head escaped.
                if encoded != null {
                    destroyEncodedProducer(encoded, job.alloc);
                    encoded = null;
                }
                resp = Response{ status = 500, body = reasonFor(500) };
                keep = false;
                ob = serializeBytes(*resp, keep, job.alloc, isHead, date, job.serverName);   // isHead: a HEAD 500 ships no body
            } else {
                ob = serializeChunkedHead(*resp, keep, job.alloc, date, job.serverName);
                if ob.buf == null {
                    och.release();
                    if encoded != null { destroyEncodedProducer(encoded, job.alloc); encoded = null; }
                    resp = Response{ status = 500, body = reasonFor(500) };
                    keep = false;
                    ob = serializeBytes(*resp, keep, job.alloc, isHead, date, job.serverName);
                } else {
                    streamed = true;
                    och.retain(); // completion/connection reference
                    queueCompletion(job.ps, job.alloc, Completion{
                        slot = job.slot, gen = job.gen, out = ob,
                        closeAfter = !keep, consumed = job.consumed,
                        streamed = true, ochan = och,
                    });
                    completed = true;
                    // Pull bounded steps. A producer/codec fault is distinct
                    // from EOF: the loop drains queued bytes, then closes the
                    // connection without a terminating zero chunk.
                    ochanRegister(job.ps, och);
                    piece : [STREAM_PIECE]u8 = ---;
                    off : i64 = 0;
                    prod := resp.producer;
                    pctx := resp.producerCtx;
                    producerFailed := false;
                    aborted := false;
                    while true {
                        n : i64 = 0;
                        if encoded != null {
                            stepFailed := false;
                            step := encoded.next(piece[..]) catch { stepFailed = true; EncodedProduceStep{} };
                            if stepFailed { producerFailed = true; break; }
                            if step.status == .pending { continue; }
                            if step.status == .done { break; }
                            n = step.produced;
                        } else {
                            n = prod(pctx, off, *piece[0], STREAM_PIECE);
                            if n < 0 or n > STREAM_PIECE { producerFailed = true; break; }
                            if n == 0 { break; }
                        }
                        off += n;
                        if !och.feedAll(*piece[0], n) { aborted = true; break; }
                    }
                    if encoded != null { destroyEncodedProducer(encoded, job.alloc); encoded = null; }
                    if !aborted {
                        if producerFailed { och.finishFault(); }
                        else { och.finishEof(); }
                    }
                    ochanUnregister(job.ps, och);
                    och.release();   // worker reference; completion/conn owns the other
                }
            }
        } else if resp.streamed and resp.producer != null and isHead and !noBody {
            // HEAD of a streamed response: the chunked head ALONE is the
            // whole response — the producer is never pulled (streamed stays
            // false, so the loop thread just drains these bytes).
            ob = serializeChunkedHead(*resp, keep, job.alloc, date, job.serverName);
        } else {
            ob = serializeBytes(*resp, keep, job.alloc, isHead, date, job.serverName);
        }
    }
    arena.deinit();
    // the handler is done reading — drop the job's channel reference
    // (the conn side still holds one until completion/close).
    if job.chan != null { job.chan.release(); }

    // a streamed response queued its completion before the pump;
    // everything else queues here. (`streamed` is true iff `completed`.)
    if !completed {
        queueCompletion(job.ps, job.alloc, Completion{
            slot = job.slot, gen = job.gen, out = ob,
            closeAfter = !keep, consumed = job.consumed,
            streamed = streamed,
        });
    }
    a := job.alloc;
    a.deallocBytes(job);
}

// the fiber task — one per dispatched request in fiber mode. Runs
// ON the loop thread, cooperatively: wires the SUSPENDING reader, runs the
// handler, then completes the request same-thread — gen-checked
// serialization straight into the conn's persistent wbuf (the inline-path
// shape; shallow clib.memcpy work only — writeMore runs later on the LOOP
// stack in finalizeFibers, never on this bounded fiber stack). The job is
// freed here; the runner reaps the fiber (env + stack) after this returns.
runFiberJob :: (arg: usize) {
    job : *HandlerJob = arg.(*HandlerJob);
    srv := job.srv;
    resp : Response = .{};
    arena := Arena.init(job.alloc, 65536);
    keep := job.keep;
    push .{ allocator = arena } {
        h := job.handler;
        if job.chan != null {
            job.req.bodyReadFn = bodyFiberRead;
            job.req.bodyReadCtx = job.(usize);
        }
        isHead := asciiIeq(job.req.method, "head");
        h(*job.req, *resp, job.appCtx);
        if job.chan != null and !job.chan.wasDrained() { keep = false; }
        encoding := prepareContentEncoding(*job.req, *resp,
            job.compressResponses, job.compressMinSize,
            job.compressLevel, context.allocator);
        c := *srv.conns[job.slot];
        // Same-thread completion, gen-checked exactly like a pool
        // completion: a closed/recycled slot (eviction, disconnect,
        // Server.close) makes this response moot — skip it entirely.
        if c.gen == job.gen and (c.state == CONN_HANDLING or c.state == CONN_BODY) {
            early := c.state == CONN_BODY;
            if early {
                // The handler answered over an UNFINISHED inbound body —
                // the early semantics, applied same-thread: stop
                // reading, discard the buffered framing, fault the channel
                // (idempotent — readBody already saw whatever it saw),
                // close + linger after the response drains.
                if c.bodyParked {
                    c.bodyParked = false;
                    srv.bodyParkedN -= 1;
                } else {
                    srv.loop.delRead(c.fd);
                }
                c.readLen = 0;
                c.bodyMode = 0;
                if c.bchan != null { c.bchan.finish(true); }
                c.lingerClose = true;
            }
            srv.serializeResponse(job.slot, *resp, keep, isHead, encoding);
            // Drop the consumed request bytes (accumulate dispatch; the
            // streamed dispatch consumed its headers up front → 0).
            rest := c.readLen - job.consumed;
            if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[job.consumed], rest); }
            c.readLen = rest;
            c.resetParse();
            c.fiberEarly = early;
            c.fiberDone = true;
            srv.fiberDoneN += 1;
        }
    }
    arena.deinit();
    if job.chan != null { job.chan.release(); }   // the job's ref; the conn's is released at finalize/close
    a := job.alloc;
    a.deallocBytes(job);
}

// ── single-pass response-head serialization ────────────────────
// The head is built in ONE pass over shared literal pieces — no concat
// chains, no context-allocator churn: respHeadLen computes the exact
// byte count from the SAME literals respHeadWrite copies, so the two
// cannot drift. decInto/statusLineFor (types.sx) keep the status and
// Content-Length digits alloc-free.

HDR_CL    :: "\r\nContent-Length: ";
HDR_TE    :: "\r\nTransfer-Encoding: chunked";
HDR_CT    :: "\r\nContent-Type: ";
HDR_DATE  :: "\r\nDate: ";
HDR_SRV   :: "\r\nServer: ";
HDR_KA    :: "\r\nConnection: keep-alive\r\n";
HDR_CLOSE :: "\r\nConnection: close\r\n";
HTTP_PFX  :: "HTTP/1.1 ";

// Append `s` at dst[off]; returns the new offset.
putStr :: (dst: [*]u8, off: i64, s: string) -> i64 {
    clib.memcpy(*dst[off], s.ptr, s.len);
    return off + s.len;
}

// Exact byte length of the head respHeadWrite emits for the same
// arguments. `chunked` selects Transfer-Encoding over Content-Length;
// `noBodyStatus` (204/304, fixed-body only) omits Content-Length.
// A NEGATIVE resp.status (buggy handler) yields zero digits from
// decLen/decInto — len and write stay consistent (no overrun), the
// line is just invalid ("HTTP/1.1  Status"), as any negative status is.
respHeadLen :: (resp: *Response, keep: bool, date: string, serverName: string, noBodyStatus: bool, chunked: bool) -> i64 {
    sl := statusLineFor(resp.status);
    n : i64 = if sl.len > 0 then sl.len
              else HTTP_PFX.len + decLen(resp.status) + 1 + reasonFor(resp.status).len;
    if chunked { n += HDR_TE.len; }
    else if !noBodyStatus { n += HDR_CL.len + decLen(resp.body.len); }
    n += HDR_CT.len + resp.contentType.len;
    n += HDR_DATE.len + date.len;
    if serverName.len > 0 { n += HDR_SRV.len + serverName.len; }
    n += if keep then HDR_KA.len else HDR_CLOSE.len;
    n += resp.extraHeaders.len;
    return n + 2;   // final "\r\n"
}

// Write the head into dst (caller sized it via respHeadLen); returns
// the bytes written.
respHeadWrite :: (resp: *Response, keep: bool, date: string, serverName: string, noBodyStatus: bool, chunked: bool, dst: [*]u8) -> i64 {
    off : i64 = 0;
    sl := statusLineFor(resp.status);
    if sl.len > 0 { off = putStr(dst, off, sl); }
    else {
        off = putStr(dst, off, HTTP_PFX);
        off += decInto(resp.status, *dst[off]);
        dst[off] = ' ';
        off += 1;
        off = putStr(dst, off, reasonFor(resp.status));
    }
    if chunked { off = putStr(dst, off, HDR_TE); }
    else if !noBodyStatus {
        off = putStr(dst, off, HDR_CL);
        off += decInto(resp.body.len, *dst[off]);
    }
    off = putStr(dst, off, HDR_CT);
    off = putStr(dst, off, resp.contentType);
    off = putStr(dst, off, HDR_DATE);
    off = putStr(dst, off, date);
    if serverName.len > 0 {
        off = putStr(dst, off, HDR_SRV);
        off = putStr(dst, off, serverName);
    }
    off = putStr(dst, off, if keep then HDR_KA else HDR_CLOSE);
    if resp.extraHeaders.len > 0 { off = putStr(dst, off, resp.extraHeaders); }
    dst[off] = '\r';
    dst[off + 1] = '\n';
    return off + 2;
}

// Build the response bytes: head + body — one allocation from `alloc`,
// one pass. Used by POOL WORKERS (the completion owns the buffer); the
// inline path serializes into the conn's persistent wbuf instead
// (serializeResponse) and allocates nothing per response.
//
// (RFC 9110 §9.3.2, §6.4.1): `headOnly` is the HEAD-request flag —
// the response keeps every header of the equivalent GET, INCLUDING the
// Content-Length of the body the handler produced (that is the point of
// HEAD), but the body bytes never go on the wire. Independently, a 204 or
// 304 status suppresses the body no matter what the handler set, and
// omits Content-Length entirely (a 204 MUST NOT carry one; for 304
// omitting is the safe MAY — the peer frames both by status alone).
// `date` is the IMF-fixdate for the response's Date header (from the
// Server's per-second cache on the loop thread; stamped fresh by a pool
// worker) and `serverName` the optional Server: header value ("" = none).
serializeBytes :: (resp: *Response, keep: bool, alloc: Allocator, headOnly: bool, date: string, serverName: string) -> OutBytes {
    noBodyStatus := resp.status == 204 or resp.status == 304;
    hl := respHeadLen(resp, keep, date, serverName, noBodyStatus, false);
    bodyLen : i64 = if headOnly or noBodyStatus then 0 else resp.body.len;
    raw := alloc.allocBytes(hl + bodyLen);
    if raw == null { return .{}; }
    buf : [*]u8 = raw.([*]u8);
    w := respHeadWrite(resp, keep, date, serverName, noBodyStatus, false, buf);
    if bodyLen > 0 { clib.memcpy(*buf[w], resp.body.ptr, bodyLen); }
    return OutBytes{ buf = buf, len = w + bodyLen };
}

// Build the HEAD of a chunked (streamed) response — status line,
// Transfer-Encoding: chunked, connection mode, extra headers — and NOTHING
// of the body. The body follows as chunks emitted incrementally by
// writeMore pulling the producer. One allocation from `alloc` (pool
// workers; the inline stream path writes into its scratch directly).
serializeChunkedHead :: (resp: *Response, keep: bool, alloc: Allocator, date: string, serverName: string) -> OutBytes {
    hl := respHeadLen(resp, keep, date, serverName, false, true);
    raw := alloc.allocBytes(hl);
    if raw == null { return .{}; }
    buf : [*]u8 = raw.([*]u8);
    w := respHeadWrite(resp, keep, date, serverName, false, true, buf);
    return OutBytes{ buf = buf, len = w };
}

// Lowercase-hex of a non-negative chunk length, no "0x", no leading
// zeros (RFC 7230 chunk-size). Returns the digit count written into `dst`.
hexLenInto :: (n: i64, dst: [*]u8) -> i64 {
    if n == 0 { dst[0] = '0'; return 1; }
    // collect digits low-to-high into a small temp, then reverse.
    tmp : [16]u8 = ---;
    cnt : i64 = 0;
    v := n;
    while v > 0 {
        d := v % 16;
        if d < 10 { tmp[cnt] = ('0' + d).(u8); }       // '0'..'9'
        else { tmp[cnt] = ('a' + (d - 10)).(u8); }     // 'a'..'f'
        v = v / 16;
        cnt += 1;
    }
    i : i64 = 0;
    while i < cnt {
        dst[i] = tmp[cnt - 1 - i];
        i += 1;
    }
    return cnt;
}

Server :: struct {
    cfg: Config;
    loop: event.Loop;
    lfd: i32 = -1;
    conns: [*]Conn = null;
    ownAlloc: Allocator;
    // The handler's third argument is `ctx`, an opaque word the app
    // gave init — typically a pointer to its own state (store handle,
    // config), since the server owns the call site.
    handler: (*Request, *Response, usize) -> void;
    ctx: usize = 0;
    ps: *PoolState = null;   // non-null iff cfg.threadPoolCount > 0
    // Graceful-shutdown flags. `stopping` is set by stop() (possibly from
    // another thread) and observed by run() between ticks; `stopBegun`
    // guards the one-time quiesce (listener removed, idles closed).
    stopping: bool = false;
    stopBegun: bool = false;
    lfdRemoved: bool = false;   // listener pulled from the loop / closed

    // Counters. ALL of these are mutated ONLY from loop-thread code
    // paths (acceptReady, readMore, respondErrorClose, connClose, the
    // tick timeout-eviction sweep, drainCompletions, the 503 backpressure
    // path). No worker thread ever touches them — in pooled mode a request
    // is counted "served" when its completion is DRAINED on the loop thread
    // (drainCompletions), never inside the worker — so no cross-thread
    // atomics are needed. stats() just snapshots them.
    stAccepted: i64 = 0;
    stClosed: i64 = 0;
    stRequests: i64 = 0;
    st4xx: i64 = 0;
    st5xx: i64 = 0;
    stTimeouts: i64 = 0;
    stRejected: i64 = 0;
    stBytesIn:  i64 = 0;
    stBytesOut: i64 = 0;

    // head of the free-slot list (-1 = all slots in use). Threaded
    // through Conn.nextFree; freeSlot pops, connClose pushes — O(1)
    // both ways, no per-accept scan.
    freeHead: i64 = -1;
    // how many CONN_BODY slots have their read watch parked on a full
    // body channel. Gates resumeBodyPumps' slot scan so the wake path
    // stays O(1) when nothing is parked (the common case).
    bodyParkedN: i64 = 0;
    // how many CONN_WRITING streams are paused on an empty worker-fed
    // channel (Conn.streamWaiting). Gates resumeStreamPumps' scan.
    streamWaitingN: i64 = 0;
    // how many fibers have completed (serialized, awaiting attach).
    // Gates finalizeFibers' scan after each drive.
    fiberDoneN: i64 = 0;
    // set by both fiber spawn sites. finalizeFibers can
    // DISPATCH a new fiber (writeMore → serveBuffered → tryServeOne on
    // pipelined bytes) after this tick's drive already ran — without the
    // re-drive loop in tick, that fiber would sleep out the next tick's
    // whole wait (no fd event exists for already-buffered bytes and no
    // completion wake exists in fiber mode), stalling the pipelined
    // response for the length of that wait.
    fiberSpawned: bool = false;
    // Min-heap of deadline wake-up hints (DlEntry), loop-thread only. It
    // serves the nearest-deadline, eviction, and handler-timeout queries
    // without a per-tick full-array scan. Grown through ownAlloc
    // (long-lived, must not bind a transient context.allocator).
    dheap: [*]DlEntry = null;
    dheapLen: i64 = 0;
    dheapCap: i64 = 0;

    // ── deadline heap (loop-thread only) ────────────────────────────

    heapPush :: (self: *Server, dl: i64, slot: i64, gen: i64) {
        if self.dheapLen == self.dheapCap {
            ncap := self.dheapCap * 2;
            nb : [*]DlEntry = self.ownAlloc.alloc(DlEntry, ncap).ptr;
            i : i64 = 0;
            while i < self.dheapLen { nb[i] = self.dheap[i]; i += 1; }
            self.ownAlloc.deallocBytes(self.dheap);
            self.dheap = nb;
            self.dheapCap = ncap;
        }
        i := self.dheapLen;
        self.dheapLen += 1;
        self.dheap[i] = DlEntry{ deadline = dl, slot = slot, gen = gen };
        while i > 0 {
            p := (i - 1) / 2;
            if self.dheap[p].deadline <= self.dheap[i].deadline { break; }
            tmp := self.dheap[p];
            self.dheap[p] = self.dheap[i];
            self.dheap[i] = tmp;
            i = p;
        }
    }

    heapPop :: (self: *Server) -> DlEntry {
        top := self.dheap[0];
        self.dheapLen -= 1;
        if self.dheapLen > 0 {
            self.dheap[0] = self.dheap[self.dheapLen];
            i : i64 = 0;
            while true {
                l := 2 * i + 1;
                if l >= self.dheapLen { break; }
                m := l;
                r := l + 1;
                if r < self.dheapLen and self.dheap[r].deadline < self.dheap[l].deadline { m = r; }
                if self.dheap[i].deadline <= self.dheap[m].deadline { break; }
                tmp := self.dheap[i];
                self.dheap[i] = self.dheap[m];
                self.dheap[m] = tmp;
                i = m;
            }
        }
        return top;
    }

    // Push a wake-up hint for `dl` unless the slot already has a live
    // entry at-or-before it (an EXTENSION never pushes — the earlier
    // entry re-arms itself from the current deadline when it pops).
    armSlot :: (self: *Server, slot: i64, dl: i64) {
        c := *self.conns[slot];
        if c.hqDeadline == 0 or dl < c.hqDeadline {
            self.heapPush(dl, slot, c.gen);
            c.hqDeadline = dl;
        }
    }

    // Set the conn's delivery/keepalive/linger deadline `ms` from now and
    // arm the heap. EVERY c.deadline write goes through here — a deadline
    // the heap never hears about would make its eviction unbounded-late.
    setDeadline :: (self: *Server, slot: i64, ms: i64) {
        c := *self.conns[slot];
        c.deadline = event.deadlineIn(ms);
        self.armSlot(slot, c.deadline);
    }

    // The deadline the sweep must enforce for the conn's CURRENT state
    // (0 = none): a pool-handled conn is bounded by its handler deadline
    // only (the delivery deadline is suspended while the worker owns the
    // request); every other active state is bounded by c.deadline.
    relevantDeadline :: (self: *Server, slot: i64) -> i64 {
        c := *self.conns[slot];
        if c.state == CONN_FREE { return 0; }
        if c.state == CONN_HANDLING { return c.handlerDeadline; }
        return c.deadline;
    }

    // the cached response-Date value (IMF-fixdate), rebuilt at most
    // once per wall-clock second. LOOP-THREAD ONLY, like the counters —
    // pool workers never read it (runHandlerJob stamps its own date).
    // Sentinel is far outside any clock value: -1 would collide with a
    // wall clock set to 1969-12-31 23:59:59 and serve the zeroed buffer.
    dateSecs: i64 = -(1 << 62);
    dateCache: DateBuf = .{};

    // The current Date header value for a response serialized on the loop
    // thread. Rebuild-on-second-change gives the RFC's "generated as close
    // to the response as practical" with one clock read per response.
    dateNow :: (self: *Server) -> string {
        now := time.nowSecs();
        if now != self.dateSecs {
            self.dateSecs = now;
            formatImfDate(now, *self.dateCache.bytes[0]);
        }
        return string{ ptr = *self.dateCache.bytes[0], len = IMF_DATE_LEN };
    }

    // Fire the optional event hook (no-op when unset — a single null check,
    // zero allocation). Loop-thread only, like the counters.
    emit :: (self: *Server, ev: EventKind, slot: i64, detail: i64) {
        h := self.cfg.onEvent;
        if h != null { h(self.cfg.onEventCtx, ev, slot, detail); }
    }

    // Snapshot the live counters. activeConns and poolQueueDepth are
    // derived gauges (accepted - closed; pending pool completions). Safe to
    // call from the loop thread (between ticks); the pool-depth read takes
    // ps.mu since a worker may be appending to ps.done concurrently.
    stats :: (self: *Server) -> Stats {
        depth : i64 = 0;
        if self.ps != null {
            self.ps.mu.lock();
            depth = self.ps.doneLen;
            self.ps.mu.unlock();
        }
        return Stats{
            activeConns = self.stAccepted - self.stClosed,
            acceptedTotal = self.stAccepted,
            closedTotal = self.stClosed,
            requestsServed = self.stRequests,
            errors4xx = self.st4xx,
            errors5xx = self.st5xx,
            timeouts = self.stTimeouts,
            rejected503 = self.stRejected,
            poolQueueDepth = depth,
            bytesIn = self.stBytesIn,
            bytesOut = self.stBytesOut,
        };
    }

    init :: (cfg: Config, handler: (*Request, *Response, usize) -> void, ctx: usize) -> (Server, !HttpErr) {
        if cfg.compressLevel < 0 or cfg.compressLevel > 10 or cfg.compressMinSize < 0 {
            raise .Config;
        }
        // fibers and a worker pool are mutually exclusive dispatch
        // models — configuring both is ambiguous, never silently resolved.
        if cfg.fibers != null and cfg.threadPoolCount > 0 {
            raise .Config;
        }
        // the streaming body reader WAITS for the loop to feed it —
        // a pool worker blocks on a cond, a fiber suspends. Plain
        // inline mode has neither (the handler runs ON the feeding
        // thread); fail loudly, never silently accumulate.
        if cfg.streamRequestBody and cfg.threadPoolCount <= 0 and cfg.fibers == null {
            raise .Config;
        }
        // the listener address — AF_UNIX on a path, or TCP on the
        // family bindAddr picks ("" is v4 INADDR_ANY).
        lfd : i32 = -1;
        if cfg.unixPath.len > 0 {
            // Port sharing and bind addresses are meaningless on a path —
            // configuring them together is ambiguous, never resolved.
            if cfg.reusePort or cfg.bindAddr.len > 0 { raise .Config; }
            ua, uok := socket.addrUnix(cfg.unixPath);
            if !uok { raise .Bind; }   // empty / overflows sun_path
            lfd = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM, 0);
            if lfd < 0 { raise .Bind; }
            if !socket.setCloexec(lfd) { socket.close(lfd); raise .Bind; }
            // The path belongs to the server (documented contract): a
            // stale socket file from a previous run would fail the bind —
            // remove it. A path we cannot unlink fails at bind, loud.
            unlinkPath(cfg.unixPath);
            if socket.bindTo(lfd, *ua) != 0 { socket.close(lfd); raise .Bind; }
            if socket.listen(lfd, cfg.backlog) != 0 { socket.close(lfd); raise .Bind; }
            if !socket.setNonblocking(lfd) { socket.close(lfd); raise .Bind; }
        } else {
            btext := if cfg.bindAddr.len > 0 then cfg.bindAddr else "0.0.0.0";
            ba, bok := socket.parseAddr(btext, cfg.port);
            if !bok { raise .Bind; }   // not a numeric address literal
            fam := socket.addrFamily(*ba);
            lfd = socket.socket(fam, socket.SOCK_STREAM, 0);
            if lfd < 0 { raise .Bind; }
            // the listener must not leak into fork/exec'd children (an
            // inherited listener keeps the port bound after Server.close).
            // Conn fds get CLOEXEC at accept (acceptConnNb).
            if !socket.setCloexec(lfd) { socket.close(lfd); raise .Bind; }
            one : i32 = 1;
            socket.setsockopt(lfd, socket.SOL_SOCKET, socket.SO_REUSEADDR, *one, 4);
            // opt-in port sharing. A refused setsockopt is a hard Bind
            // fault — silently continuing would bind WITHOUT sharing and the
            // next instance's bind would fail mysteriously.
            if cfg.reusePort {
                if socket.setsockopt(lfd, socket.SOL_SOCKET, socket.SO_REUSEPORT, *one, 4) != 0 {
                    socket.close(lfd);
                    raise .Bind;
                }
            }
            // a v6 listener gets IPV6_V6ONLY set EXPLICITLY from the
            // config — "::" is deterministic dual-stack by default, never
            // the OS's sysctl-dependent choice. Refusal is a hard Bind
            // fault (same rationale as reusePort).
            if fam == socket.AF_INET6 {
                v6only : i32 = if cfg.ipv6Only then 1 else 0;
                if socket.setsockopt(lfd, socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, *v6only, 4) != 0 {
                    socket.close(lfd);
                    raise .Bind;
                }
            }
            if socket.bindTo(lfd, *ba) != 0 { socket.close(lfd); raise .Bind; }
            if socket.listen(lfd, cfg.backlog) != 0 { socket.close(lfd); raise .Bind; }
            if !socket.setNonblocking(lfd) { socket.close(lfd); raise .Bind; }
        }

        lp, le := event.Loop.init();
        if le { closeListener(lfd, cfg.unixPath); raise .Loop; }
        are := false;
        lp.addRead(lfd, LISTENER_UDATA) catch { are = true; };
        if are { closeListener(lfd, cfg.unixPath); raise .Loop; }
        // Register the wake channel unconditionally: stop() wakes the loop
        // through it (eventfd/EVFILT_USER write is atomic, so stop() is
        // safe from another thread or a signal-ish context), and run()'s
        // wait() returns promptly instead of sleeping out the full tick.
        // The pooled path reuses the same channel for completions.
        swe := false;
        lp.addWake(WAKE_UDATA) catch { swe = true; };
        if swe { closeListener(lfd, cfg.unixPath); raise .Loop; }

        oa := context.allocator;
        slots : [*]Conn = oa.alloc(Conn, cfg.maxConn).ptr;
        i : i64 = 0;
        while i < cfg.maxConn {
            slots[i] = Conn{};
            // thread the initial free list in index order (head = 0,
            // so the first accept lands in slot 0 — tests rely on it).
            slots[i].nextFree = if i + 1 < cfg.maxConn then i + 1 else -1;
            i += 1;
        }
        dcap : i64 = 64;
        dh : [*]DlEntry = oa.alloc(DlEntry, dcap).ptr;

        ps : *PoolState = null;
        if cfg.threadPoolCount > 0 {
            ps = oa.create(PoolState);
            ps.* = PoolState{};
            // Failure below this point must release what init already
            // allocated (slots, dheap, ps, ps.done) — these late paths used
            // to close only the fd and leak the rest .
            if !ps.mu.setup() {
                oa.deallocBytes(ps);
                oa.deallocBytes(slots);
                oa.deallocBytes(dh);
                closeListener(lfd, cfg.unixPath);
                raise .Loop;
            }
            // Max completions pending between two drains: every conn has at
            // most ONE job in flight, and within one tick's serve storm the
            // loop can submit up to maxConn replacements while backlog +
            // workers earlier jobs finish into the queue — backlog + workers
            // alone under-counts that same-tick refill; queueCompletion
            // still handles a drop loudly as belt.
            ps.doneCap = cfg.maxConn + cfg.threadPoolBacklog + cfg.threadPoolCount;
            ps.done = oa.alloc(Completion, ps.doneCap).ptr;
            ps.doneLen = 0;
            // one pumping stream channel per worker, at most.
            ps.ochans = oa.alloc(usize, cfg.threadPoolCount).ptr;
            ps.ochansLen = 0;
            // Capture the loop AFTER addWake (registered above): on epoll,
            // addWake lazily creates wakeFd, so a copy taken earlier would
            // freeze wakeFd == -1 and ps.loopCopy.wake() would silently
            // no-op. The unconditional addWake in init runs before here.
            ps.loopCopy = lp;
            pool, pce := thread.Pool.create(cfg.threadPoolCount, cfg.threadPoolBacklog);
            if pce {
                ps.mu.destroy();
                oa.deallocBytes(ps.done);
                oa.deallocBytes(ps.ochans);
                oa.deallocBytes(ps);
                oa.deallocBytes(slots);
                oa.deallocBytes(dh);
                closeListener(lfd, cfg.unixPath);
                raise .Loop;
            }
            ps.pool = pool;
        }

        return Server{
            cfg = cfg, loop = lp, lfd = lfd, conns = slots,
            ownAlloc = oa, handler = handler, ctx = ctx, ps = ps,
            freeHead = 0, dheap = dh, dheapCap = dcap,
        };
    }

    // Tear down everything init (and runtime) allocated, in an order
    // that never touches freed memory:
    //   1. shutdown the pool FIRST — joins every worker, so no worker can
    //      still write into ps.done / ps.loopCopy after we free ps.
    //      (Pool.shutdown frees the Pool struct + its tasks/threads from
    //      the allocator it was created with — ownAlloc here — so we do
    //      NOT free ps.pool ourselves.)
    //   2. close every connection still active (frees its outBuf, removes
    //      it from the loop, closes the fd).
    //   3. free every slot's readBuf — these survive connClose (reused
    //      across connections) so they leak unless freed here; a slot may
    //      hold a grown buffer even while CONN_FREE.
    //   4. free the conns array.
    //   5. free ps.done, then ps (the PoolState struct).
    //   6. close the listener and the loop (ps.loopCopy is a value copy
    //      of self.loop — sharing the same fds — and must NOT be closed).
    close :: (self: *Server) {
        if self.ps != null {
            // a worker can be BLOCKED in a body-channel read; fault
            // every live channel BEFORE joining, or shutdown would deadlock
            // on that worker. (connClose below releases the conn refs.)
            i0 : i64 = 0;
            while i0 < self.cfg.maxConn {
                if self.conns[i0].bchan != null { self.conns[i0].bchan.finish(true); }
                i0 += 1;
            }
            // same for feeders BLOCKED in a stream-channel feed. The
            // registry covers every chan a worker is pumping — including
            // ones whose completion was never attached to a conn (queued
            // after the conn died), which the conns sweep cannot see.
            // `closing` is flipped in the SAME critical section so a worker
            // that has not registered YET (still mid-handler) aborts at its
            // own register instead of escaping this one-shot sweep and
            // deadlocking the join.
            self.ps.mu.lock();
            self.ps.closing = true;
            oi : i64 = 0;
            while oi < self.ps.ochansLen {
                self.ps.ochans[oi].abort();
                oi += 1;
            }
            self.ps.mu.unlock();
            self.ps.pool.shutdown();
        }
        i : i64 = 0;
        while i < self.cfg.maxConn {
            if self.conns[i].state != CONN_FREE { self.connClose(i); }
            i += 1;
        }
        // the closes above faulted every live body channel and woke
        // every parked fiber; drive them to completion NOW (a woken read
        // returns -1, the handler unwinds, the gen check skips the moot
        // response, the job is freed, the fiber + its env are reaped). One
        // drive suffices — a faulted fiber has no further suspend point.
        // Any completion marked before its conn closed was already
        // un-marked by connClose; belt-reset the counter regardless.
        if self.cfg.fibers != null {
            self.cfg.fibers.drive();
            self.fiberDoneN = 0;
        }
        i = 0;
        while i < self.cfg.maxConn {
            c := *self.conns[i];
            if c.readBuf != null {
                self.ownAlloc.deallocBytes(c.readBuf);
                c.readBuf = null;
                c.readCap = 0;
            }
            if c.wbuf != null {   // the persistent write buffer
                self.ownAlloc.deallocBytes(c.wbuf);
                c.wbuf = null;
                c.wbufCap = 0;
            }
            i += 1;
        }
        self.ownAlloc.deallocBytes(self.conns);
        self.conns = null;
        if self.dheap != null {
            self.ownAlloc.deallocBytes(self.dheap);
            self.dheap = null;
            self.dheapLen = 0;
            self.dheapCap = 0;
        }

        if self.ps != null {
            // Pool.shutdown() has joined every worker, so
            // ps.doneLen / ps.done are stable — no lock needed. Workers
            // that finished an in-flight handler queued their serialized
            // response bytes (out.buf, from serializeBytes) here and they
            // were never drained: free each before the ps.done array.
            // Only 0..doneLen are pending: drainCompletions resets
            // doneLen to 0 as it takes a batch, so anything already
            // drained is outside this range — no double-free.
            d : i64 = 0;
            while d < self.ps.doneLen {
                if self.ps.done[d].out.buf != null {
                    self.ownAlloc.deallocBytes(self.ps.done[d].out.buf);
                }
                // an undrained streamed completion still holds the
                // conn-side channel reference (it was never attached).
                if self.ps.done[d].ochan != null {
                    self.ps.done[d].ochan.release();
                }
                d += 1;
            }
            if self.ps.done != null { self.ownAlloc.deallocBytes(self.ps.done); }
            if self.ps.ochans != null { self.ownAlloc.deallocBytes(self.ps.ochans); }
            self.ps.mu.destroy();
            self.ownAlloc.deallocBytes(self.ps);
            self.ps = null;
        }

        if self.lfd >= 0 { socket.close(self.lfd); }
        self.lfd = -1;
        // an AF_UNIX listener's socket file is removed at teardown
        // (idempotent — stop() may have unlinked it already).
        if self.cfg.unixPath.len > 0 { unlinkPath(self.cfg.unixPath); }
        self.loop.close();
    }

    // ── slot management ──────────────────────────────────────────────

    // pop the free-list head — O(1), no scan. -1 = at maxConn.
    freeSlot :: (self: *Server) -> i64 {
        s := self.freeHead;
        if s >= 0 {
            self.freeHead = self.conns[s].nextFree;
            self.conns[s].nextFree = -1;
        }
        return s;
    }

    connClose :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        // push onto the free list exactly once per FREE transition
        // (a re-close of an already-free slot — close()'s teardown sweep
        // tolerates them — must not corrupt the list with a cycle).
        wasActive := c.state != CONN_FREE;
        // TLS: tear down the per-connection TLS session first,
        // while the fd is still open so close() can attempt a best-effort
        // close_notify. close() frees the session's own state; idempotent
        // (null = plaintext).
        if c.tls != null {
            c.tls.close();
            c.tls = null;
        }
        // a live body channel must never strand a blocked reader —
        // fault it (the worker's readBody returns -1; its completion will
        // fail the gen check and be discarded) and drop the conn's ref.
        if c.bchan != null {
            c.bchan.finish(true);
            c.bchan.release();
            c.bchan = null;
        }
        // wake the conn's fiber so it observes the fault and unwinds
        // (its completion then fails the gen check and is skipped; the
        // runner reaps it at the next drive). A pending fiber completion
        // for THIS conn is moot — drop the mark.
        if c.fiberH != 0 {
            if self.cfg.fibers != null { self.cfg.fibers.wake(c.fiberH); }
            c.fiberH = 0;
        }
        if c.fiberDone {
            c.fiberDone = false;
            self.fiberDoneN -= 1;
        }
        c.fiberEarly = false;
        if c.bodyParked {
            c.bodyParked = false;
            self.bodyParkedN -= 1;
        }
        c.bodyMode = 0;
        c.bodyRemaining = 0;
        c.bchState = 0;
        // same for a worker-fed response stream — abort unblocks a
        // feeder mid-feedAll; drop the conn's ref.
        if c.ochan != null {
            c.ochan.abort();
            c.ochan.release();
            c.ochan = null;
        }
        if c.encodedProducer != null {
            destroyEncodedProducer(c.encodedProducer, self.ownAlloc);
            c.encodedProducer = null;
        }
        if c.streamWaiting {
            c.streamWaiting = false;
            self.streamWaitingN -= 1;
        }
        if c.fd >= 0 {
            self.loop.delRead(c.fd);
            if c.writeArmed { self.loop.delWrite(c.fd); }
            socket.close(c.fd);
            // A real connection occupied this slot — count the close and
            // surface it. Slots swept while already CONN_FREE (close()'s
            // teardown) carry fd < 0 and are not double-counted.
            self.stClosed += 1;
            self.emit(EventKind.CLOSE, slot, 0);
        }
        if c.outBuf != null {
            // only per-response allocations are freed here — an
            // outBuf aliasing the persistent wbuf is retained for reuse.
            if c.outOwned { self.ownAlloc.deallocBytes(c.outBuf); }
            c.outBuf = null;
        }
        c.outOwned = true;
        // readBuf (and wbuf) stay allocated — reused by the next
        // connection here. Exception: an over-cap wbuf (grown by one huge
        // response) is released now instead of pinning the high-water mark
        // for the server's lifetime .
        if c.wbufCap > WBUF_RETAIN_CAP {
            self.ownAlloc.deallocBytes(c.wbuf);
            c.wbuf = null;
            c.wbufCap = 0;
        }
        c.fd = -1;
        c.state = CONN_FREE;
        c.gen += 1;   // also invalidates every heap entry for this slot
        c.hqDeadline = 0;
        if wasActive {
            c.nextFree = self.freeHead;
            self.freeHead = slot;
        }
        c.handlerDeadline = 0;
        c.headReq = false;
        c.readLen = 0;
        c.resetParse();
        c.outLen = 0;
        c.outSent = 0;
        c.served = 0;
        c.closeAfter = false;
        c.lingerClose = false;
        c.writeArmed = false;
        c.tlsRdWantWrite = false;
        c.tlsWrWantRead = false;
        c.streaming = false;
        c.producer = null;
        c.producerCtx = 0;
        c.encodedProducer = null;
        c.streamOff = 0;
        c.streamDone = false;
    }

    // ── the tick: one bounded loop iteration ─────────────────────────
    //
    // Waits at most `maxWaitMs` (sooner when a connection deadline is
    // nearer), services every ready fd, then evicts expired connections.
    tick :: (self: *Server, maxWaitMs: i64) -> !HttpErr {
        // The nearest wake-up hint is the heap min — O(1), not a
        // full-slot scan. A stale top (recycled slot, extended
        // deadline) only wakes the loop early; the sweep discards it.
        waitMs := maxWaitMs;
        if self.dheapLen > 0 {
            left := event.remainingMs(self.dheap[0].deadline);
            if left < waitMs { waitMs = left; }
        }

        evs : [64]event.Event = ---;
        n, werr := self.loop.wait(.{ ptr = *evs[0], len = 64 }, waitMs);
        if werr { raise .Loop; }

        k : i64 = 0;
        while k < n {
            ev := evs[k];
            k += 1;
            if ev.udata == LISTENER_UDATA {
                self.acceptReady();
                continue;
            }
            if ev.user or ev.udata == WAKE_UDATA {
                self.drainCompletions();
                self.resumeBodyPumps();     // a worker drained a stalled channel
                self.resumeStreamPumps();   // a worker fed a hungry channel
                continue;
            }
            slot : i64 = ev.udata.(i64);
            c := *self.conns[slot];
            if c.state == CONN_FREE or c.fd != ev.fd { continue; }   // stale event for a recycled slot
            if c.state == CONN_HANDLING { continue; }   // buffer frozen until the worker finishes
            if c.state == CONN_BODY {                   // streaming body inbound
                // a writable can also mean "retry the blocked TLS
                // read" — the pump's read cross-armed the write watch.
                if ev.readable or ev.eof or (ev.writable and c.tlsRdWantWrite) { self.bodyReady(slot); }
                continue;
            }
            if c.state == CONN_TLS_HANDSHAKE {          // drive the handshake on either readiness
                if ev.readable or ev.writable or ev.eof { self.driveHandshake(slot); }
                continue;
            }
            if c.state == CONN_LINGER {                 // discard until EOF
                if ev.readable or ev.eof { self.lingerDrain(slot); }
                continue;
            }
            if ev.writable and c.tlsRdWantWrite {
                // the writable IS the blocked TLS read's retry signal.
                // readMore consumes the event's readable too (its loop
                // drains the fd) and may leave the slot in ANY state (close,
                // recycle, dispatch → CONN_BODY/CONN_HANDLING, linger) —
                // re-routing the remaining bits against the ORIGINAL state
                // ladder would misdeliver them. Stop here: both
                // backends are level-triggered, so anything unconsumed
                // (e.g. a writable for a response drain) re-surfaces at the
                // next wait.
                self.readMore(slot);
                continue;
            }
            if ev.writable and c.state == CONN_WRITING {
                self.writeMore(slot);
                continue;
            }
            if ev.readable or ev.eof {
                // readability resumes a write blocked on a
                // read-direction TLS want; otherwise it is inbound data.
                if c.state == CONN_WRITING and c.tlsWrWantRead { self.writeMore(slot); }
                else { self.readMore(slot); }
            }
        }

        // Deadline eviction — after I/O, so a request that just arrived
        // under the wire is served, not evicted. Pop expired wake-up
        // hints off the heap instead of scanning every slot; the conn's
        // CURRENT relevant deadline decides, never the entry.
        self.sweepDeadlines();
        // run every fiber made ready this tick (dispatch spawns,
        // body-pump wakes, eviction faults), then attach the responses
        // the fibers completed — on THIS stack, never a fiber's. LOOP
        // until quiescent: finalize's write→serve path dispatches the
        // NEXT pipelined request's fiber, which must run THIS tick, not
        // after the next wait() . Bounded: each pass
        // consumes already-buffered requests; no new bytes arrive here.
        if self.cfg.fibers != null {
            while true {
                self.fiberSpawned = false;
                self.cfg.fibers.drive();
                self.finalizeFibers();
                if !self.fiberSpawned { break; }
            }
        }
        return;
    }

    // attach every fiber-completed response — the bookkeeping
    // drainCompletions does for pool completions, minus the queue (the
    // fiber tail already serialized into the conn's wbuf same-thread).
    // Gated on the counter; runs right after each drive.
    finalizeFibers :: (self: *Server) {
        if self.fiberDoneN == 0 { return; }
        i : i64 = 0;
        while i < self.cfg.maxConn {
            c := *self.conns[i];
            if c.fiberDone {
                c.fiberDone = false;
                self.fiberDoneN -= 1;
                c.fiberH = 0;
                if c.bchan != null {   // the conn's channel ref (streamed dispatch)
                    c.bchan.release();
                    c.bchan = null;
                }
                early := c.fiberEarly;
                c.fiberEarly = false;
                if !early {
                    // Re-arm the read watch parked at dispatch / body-eof
                    // (pipelined bytes may be waiting). An early-response
                    // conn stays read-parked: inbound is discard-only
                    // until the linger close.
                    rae := false;
                    self.loop.addRead(c.fd, i.(usize)) catch { rae = true; };
                    if rae {
                        self.emit(EventKind.READ_FAULT, i, 0);
                        self.connClose(i);
                        i += 1;
                        continue;
                    }
                }
                self.stRequests += 1;
                c.state = CONN_READING;
                self.setDeadline(i, self.cfg.timeoutRequestMs);
                self.writeMore(i);
            }
            i += 1;
        }
    }

    // enforce every deadline whose wake-up hint has expired. Pops the
    // heap while its min is past; each pop re-checks the conn's CURRENT
    // relevant deadline (relevantDeadline), so recycled slots (gen bump)
    // and extended deadlines are discarded/re-armed — never mis-evicted.
    // Carries both the delivery/keepalive/linger eviction semantics and the
    // pool handler-timeout 504, in one pass over the deadline heap.
    sweepDeadlines :: (self: *Server) {
        while self.dheapLen > 0 and event.expired(self.dheap[0].deadline) {
            e := self.heapPop();
            c := *self.conns[e.slot];
            if c.gen != e.gen or c.state == CONN_FREE { continue; }   // recycled
            if e.deadline == c.hqDeadline { c.hqDeadline = 0; }     // its live entry
            rel := self.relevantDeadline(e.slot);
            if rel == 0 { continue; }   // e.g. CONN_HANDLING with no handler deadline
            if !event.expired(rel) {
                // The deadline moved on (keep-alive refresh, 504 window,
                // state change) — re-arm the hint at the current value.
                self.armSlot(e.slot, rel);
                continue;
            }
            slot := e.slot;
            st := c.state;
            // Handler-deadline enforcement (pool mode — inline handlers
            // run on THIS thread and can't be preempted). The worker is
            // still running (no safe pthread_cancel), so reply 504 and free
            // the slot. connClose bumps c.gen, so the worker's eventual
            // completion fails the gen check in drainCompletions and is
            // discarded + freed — never a double-response or double-free.
            if st == CONN_HANDLING {
                self.stTimeouts += 1;
                self.st5xx += 1;
                self.emit(EventKind.HANDLER_TIMEOUT, slot, 504);
                c.handlerDeadline = 0;
                // The worker owns its own COPY of the request bytes (see
                // HandlerJob), so freeing/reusing this slot and its read
                // buffer is safe even while the worker still runs: it writes
                // only into its job-arena + serialized completion, never the
                // conn slot. Discard any pipelined bytes; serialize the 504.
                resp : Response = .{ status = 504, body = reasonFor(504) };
                c.readLen = 0;
                c.resetParse();
                toArena := Arena.init(self.ownAlloc, 4096);
                push .{ allocator = toArena } {
                    // keep=false → closeAfter. headOnly = the dispatched
                    // request's method, stamped on the slot at dispatch — a
                    // timed-out HEAD is owed a body-less 504 like any other
                    // HEAD response (RFC 9110 §9.3.2).
                    self.serializeResponse(slot, *resp, false, c.headReq, .identity);
                }
                toArena.deinit();
                // Leave CONN_HANDLING: any completion the worker queues after
                // this point sees state != CONN_HANDLING (CONN_WRITING here)
                // OR, once writeMore closes the slot, a bumped gen — either
                // way drainCompletions discards + frees it. The read watch
                // stays PARKED (0.2): this 504 always closes after the write
                // (keep=false), and re-arming would resume the level-
                // triggered spin on whatever the client is still flooding.
                // Refresh the delivery deadline for the 504 itself — the
                // request deadline is typically long expired by now and the
                // next sweep would kill the 504 before it drains.
                c.state = CONN_WRITING;
                self.setDeadline(slot, self.cfg.timeoutRequestMs);
                self.writeMore(slot);
            }
            // a lingering conn expiring is NORMAL linger completion
            // (the client never sent EOF within the window) — close it
            // silently, not as a timeout fault.
            else if st == CONN_LINGER {
                self.connClose(slot);
            }
            // a PARTIAL REQUEST evicted at the delivery deadline is
            // owed an answer — 408 (Connection: close, via the linger
            // path so it actually lands). Idle evictions (keepalive
            // between requests, or a conn that never sent a byte) and a
            // mid-response CONN_WRITING stall stay wire-silent: nothing
            // is owed / a second response can't be spliced in.
            else if st == CONN_READING and c.readLen > 0 {
                self.stTimeouts += 1;
                self.emit(EventKind.TIMEOUT, slot, 408);
                self.sendErrorClose(slot, 408);
            } else {
                self.stTimeouts += 1;
                self.emit(EventKind.TIMEOUT, slot, 0);
                self.connClose(slot);
            }
        }
    }

    // ── graceful shutdown ────────────────────────────────────────────
    //
    // stop() requests a clean quiesce: stop accepting, close idle
    // keep-alives, drain in-flight requests within shutdownTimeoutMs,
    // then make run() return. It only flips a flag and wakes the loop, so
    // it is safe to call from ANOTHER thread (the wake write is atomic) or
    // between ticks (e.g. from a handler or a signal-relay). It does NOT
    // tear down — close() does that, and the caller of run() owns it.
    stop :: (self: *Server) {
        self.stopping = true;
        self.loop.wake();   // break run()'s wait() so it observes the flag
    }

    // The one-time quiesce, run when the loop first observes `stopping`:
    // pull the listener out of the loop and close its fd so no new
    // connection arrives, then close every IDLE connection immediately
    // (CONN_KEEPALIVE between requests, or CONN_READING that hasn't
    // buffered a single byte). In-flight work (a partial request, a
    // pending write, a pooled handler) is left to drain.
    beginStop :: (self: *Server) {
        if self.stopBegun { return; }
        self.stopBegun = true;
        if !self.lfdRemoved and self.lfd >= 0 {
            self.loop.delRead(self.lfd);
            socket.close(self.lfd);
            self.lfd = -1;
            self.lfdRemoved = true;
            // stop() means "accept no more" — remove the AF_UNIX
            // socket file with the listener so new dials fail fast.
            if self.cfg.unixPath.len > 0 { unlinkPath(self.cfg.unixPath); }
        }
        i : i64 = 0;
        while i < self.cfg.maxConn {
            c := self.conns[i];
            if c.state == CONN_KEEPALIVE or c.state == CONN_TLS_HANDSHAKE or c.state == CONN_LINGER or (c.state == CONN_READING and c.readLen == 0) {
                self.connClose(i);
            }
            i += 1;
        }
    }

    // Count connections still doing work the drain must wait on: a
    // partially-read request, an in-progress write, or a pooled handler.
    // Pending pool completions also count (they still owe a response).
    inFlight :: (self: *Server) -> i64 {
        n : i64 = 0;
        i : i64 = 0;
        while i < self.cfg.maxConn {
            c := self.conns[i];
            st := c.state;
            if st == CONN_WRITING or st == CONN_HANDLING or st == CONN_BODY { n += 1; }
            else if st == CONN_READING and c.readLen > 0 { n += 1; }
            i += 1;
        }
        if self.ps != null {
            self.ps.mu.lock();
            n += self.ps.doneLen;
            self.ps.mu.unlock();
        }
        return n;
    }

    // The forever loop. Serves until stop() is requested,
    // then quiesces (stop accepting, close idles) and drains in-flight
    // requests until none remain OR shutdownTimeoutMs elapses — any
    // stragglers past the deadline are force-closed. run() returns
    // cleanly; it does NOT call close() (the caller owns teardown, so a
    // fresh Server can be init'd and run() again in the same process).
    run :: (self: *Server) {
        // a persistent tick()/wait() failure must not become a silent
        // hot spin. Count CONSECUTIVE failures, surface each through the
        // observability hook (LISTEN_ERROR, detail = the count), back off
        // between retries, and give up cleanly at the limit. One successful
        // tick resets the count (a transient EINTR-ish blip is forgiven).
        consec : i64 = 0;
        while !self.stopping and consec < LOOP_FAULT_LIMIT {
            te := false;
            self.tick(1000) catch { te = true; };
            if !te { consec = 0; continue; }
            consec += 1;
            self.emit(EventKind.LISTEN_ERROR, -1, consec);
            if consec < LOOP_FAULT_LIMIT {
                usleep(consec * 10000);   // 10/20/30/40 ms — no hot spin
            }
        }
        loopDead := consec >= LOOP_FAULT_LIMIT;
        // Quiesce + bounded drain. With a dead loop the drain's ticks would
        // fail identically — skip straight to the force-close.
        self.beginStop();
        if !loopDead {
            drainDeadline := event.deadlineIn(self.cfg.shutdownTimeoutMs);
            while self.inFlight() > 0 and !event.expired(drainDeadline) {
                self.tick(50) catch {};
            }
        }
        // Force-close anything still in flight at the deadline.
        i : i64 = 0;
        while i < self.cfg.maxConn {
            if self.conns[i].state != CONN_FREE { self.connClose(i); }
            i += 1;
        }
        return;
    }

    // ── accept ───────────────────────────────────────────────────────

    acceptReady :: (self: *Server) {
        while true {
            // acceptConnNb hands back the fd with O_NONBLOCK +
            // FD_CLOEXEC already applied (atomically via accept4 on linux;
            // accept + fcntls on darwin — see socket.sx).
            fd, ae := socket.acceptConnNb(self.lfd);
            if ae { return; }   // WouldBlock = drained; Fault = nothing to do here
            // disable Nagle. Without it a keep-alive response sits in
            // the kernel until the peer's delayed ACK (~40 ms latency cliffs
            // on request/response traffic). A failure (the peer can already
            // have RST the conn before accept dequeued it) is an accept
            // fault — never a silently slow connection. Runs BEFORE the
            // free-list pop: freeSlot is destructive, so an early
            // return between the pop and c.state = CONN_READING would leak
            // the slot forever (state still CONN_FREE → neither connClose
            // nor anything else would re-push it). The fd
            // is validated first; only then is a slot committed.
            // TCP_NODELAY is a TCP option — an AF_UNIX conn refuses
            // it (EOPNOTSUPP) and has no Nagle to disable; skip, don't die.
            if self.cfg.unixPath.len == 0 {
                one : i32 = 1;
                if socket.setsockopt(fd, socket.IPPROTO_TCP, socket.TCP_NODELAY, *one, 4) != 0 {
                    socket.close(fd);
                    self.emit(EventKind.ACCEPT_FAULT, -1, 0);
                    return;
                }
            }
            slot := self.freeSlot();
            if slot < 0 {                                // at maxConn: shed
                socket.close(fd);
                self.emit(EventKind.ACCEPT_FAULT, -1, 0);
                return;
            }
            c := *self.conns[slot];
            if c.readBuf == null {
                initCap : i64 = READ_BUF_INITIAL;
                if initCap > self.cfg.readBufCap { initCap = self.cfg.readBufCap; }
                c.readBuf = self.ownAlloc.alloc(u8, initCap).ptr;
                c.readCap = initCap;
            }
            c.fd = fd;
            c.state = CONN_READING;
            c.readLen = 0;
            c.served = 0;
            c.closeAfter = false;
            self.setDeadline(slot, self.cfg.timeoutRequestMs);
            // The connection now owns an fd — count the accept and surface it
            // BEFORE addRead, so if registration faults the matching connClose
            // (which counts/emits the close) is balanced by this accept (no
            // orphan CLOSE; closedTotal stays ≤ acceptedTotal).
            self.stAccepted += 1;
            self.emit(EventKind.ACCEPT, slot, 0);
            are := false;
            self.loop.addRead(fd, slot.(usize)) catch { are = true; };
            if are {
                self.emit(EventKind.ACCEPT_FAULT, slot, 0);
                self.connClose(slot);
                continue;
            }
            // TLS: mint a per-connection session and negotiate before the
            // first request. accept() returns null on a per-session setup
            // failure → drop the connection (never serve it in the clear). On
            // success the slot enters CONN_TLS_HANDSHAKE and we kick the
            // handshake once (it typically wants the ClientHello → WantRead,
            // for which read interest is already armed).
            if self.cfg.tls != null {
                tc := self.cfg.tls.accept(fd);
                if tc == null {
                    self.emit(EventKind.TLS_HANDSHAKE_FAULT, slot, 0);
                    self.connClose(slot);
                    continue;
                }
                c.tls = tc;
                c.state = CONN_TLS_HANDSHAKE;
                self.driveHandshake(slot);
            }
        }
    }

    // Advance a CONN_TLS_HANDSHAKE slot one step. WantRead leaves the slot
    // on the (always-armed) read watch; WantWrite arms the write watch; Done
    // transitions to CONN_READING and drains any app-data mbedTLS already
    // buffered; Closed/Fatal drops the connection. The request deadline (set at
    // accept) bounds a stalled handshake — the tick eviction loop closes it.
    driveHandshake :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        step := c.tls.handshake();
        if step == TlsStep.WantWrite {
            if !c.writeArmed {
                awe := false;
                self.loop.addWrite(c.fd, slot.(usize)) catch { awe = true; };
                if awe {
                    self.emit(EventKind.TLS_HANDSHAKE_FAULT, slot, 0);
                    self.connClose(slot);
                    return;
                }
                c.writeArmed = true;
            }
            return;
        }
        // No longer waiting on writability — drop the write watch if held.
        if c.writeArmed {
            self.loop.delWrite(c.fd);
            c.writeArmed = false;
        }
        if step == TlsStep.WantRead { return; }   // read watch stays armed
        if step == TlsStep.Done {
            c.state = CONN_READING;
            c.readLen = 0;
            self.setDeadline(slot, self.cfg.timeoutRequestMs);
            self.readMore(slot);   // serve any request bytes already decrypted
            return;
        }
        // Closed (peer aborted handshake) / Fatal (protocol error).
        self.emit(EventKind.TLS_HANDSHAKE_FAULT, slot, 0);
        self.connClose(slot);
    }

    // ── streaming request-body pump (CONN_BODY) ────────────────

    // Park the conn's read watch: the body channel is full and the worker
    // hasn't drained it yet. feed() already marked the channel `stalled`
    // in the same critical section as the shortfall, so the worker's next
    // draining read wakes the loop → resumeBodyPumps.
    bodyPark :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        if c.bodyParked { return; }
        self.loop.delRead(c.fd);
        c.bodyParked = true;
        self.bodyParkedN += 1;
    }

    // End-of-body: signal the channel, park the read watch for the
    // CONN_HANDLING stretch (0.2 — pipelined bytes would level-trigger-spin
    // the loop while the worker runs), and arm the handler deadline — the
    // handler's budget starts at BODY-COMPLETE (the upload itself was
    // bounded by the stall-refreshed delivery deadline, never in total).
    bodyEof :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        c.bchan.finish(false);
        // a fiber parked in readBody is woken by state changes too
        // (this eof may arrive with no byte progress this pump — e.g. the
        // trailer's final CRLF alone).
        if c.fiberH != 0 { self.cfg.fibers.wake(c.fiberH); }
        c.bodyMode = 0;
        if c.bodyParked {
            c.bodyParked = false;
            self.bodyParkedN -= 1;
        } else {
            self.loop.delRead(c.fd);
        }
        c.state = CONN_HANDLING;
        // Reading just parked for the handler stretch —
        // drop any unresolved cross-direction want + cross-armed watch.
        self.tlsWantDrop(slot);
        // Fiber mode keeps handlerDeadline 0 (cooperative — the sweep can
        // never preempt a fiber, and arming here would only push a spurious
        // heap hint).
        if self.cfg.handlerTimeoutMs > 0 and self.cfg.fibers == null {
            c.handlerDeadline = event.deadlineIn(self.cfg.handlerTimeoutMs);
            self.armSlot(slot, c.handlerDeadline);
        } else {
            c.handlerDeadline = 0;
        }
    }

    // Abort a streaming body mid-flight (bad framing / oversized framing
    // element / trailer flood). The worker still owes its completion, so
    // the slot STAYS CONN_BODY: reading stops, the buffered framing is
    // discarded, the channel faults (a blocked reader wakes with -1) and
    // the eventual response closes the connection (drainCompletions'
    // early-response path). Surfaced as a 400-class parse error — note the
    // wire status is whatever the handler responds (a second response
    // cannot be spliced into an owed completion).
    bodyAbort :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        if c.bodyParked {
            c.bodyParked = false;
            self.bodyParkedN -= 1;
        } else {
            self.loop.delRead(c.fd);
        }
        // Reading stops for good on this slot (it idles
        // for the owed completion) — a live cross-armed write watch would
        // spin the loop until it lands. Drop the wants.
        self.tlsWantDrop(slot);
        c.readLen = 0;
        c.bodyMode = 0;
        c.closeAfter = true;
        c.lingerClose = true;   // the client is mid-upload: linger so the response lands
        c.bchan.finish(true);
        if c.fiberH != 0 { self.cfg.fibers.wake(c.fiberH); }   // -1 to a parked reader
        self.st4xx += 1;
        self.emit(EventKind.PARSE_ERROR, slot, 400);
        // Give the worker's response time to materialize — the delivery
        // deadline may be mid-refresh-cycle from the aborted upload.
        self.setDeadline(slot, self.cfg.timeoutRequestMs);
    }

    // Decode the body framing buffered at the front of readBuf and push
    // the decoded bytes into the slot's channel, consuming what it decodes
    // (memmove compaction — the front of readBuf is ALWAYS body framing
    // while CONN_BODY). Refreshes the delivery deadline on any progress
    // (stall-based timeout). Parks the read watch when the channel is full
    // with bytes still pending. On end-of-body: bodyEof (leftover bytes —
    // the next pipelined request — stay buffered for the completion drain).
    pumpBody :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        progressed := false;
        while c.bodyMode != 0 {
            if c.bodyMode == 1 {
                // Content-Length countdown.
                if c.readLen == 0 { break; }
                n := if c.bodyRemaining < c.readLen then c.bodyRemaining else c.readLen;
                took := c.bchan.feed(c.readBuf, n);
                if took > 0 {
                    progressed = true;
                    rest := c.readLen - took;
                    if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[took], rest); }
                    c.readLen = rest;
                    c.bodyRemaining -= took;
                }
                if c.bodyRemaining == 0 {
                    self.bodyEof(slot);
                    break;
                }
                if took < n { self.bodyPark(slot); }
                break;   // pushed all buffered bytes; need more from the wire
            }
            // Chunked framing, one element per iteration.
            if c.bchState == 0 {
                // Size line: hex size [;ext] CRLF. Same validation rules as
                // decodeChunkedPass (first non-hex byte must be ';' or CR;
                // i64-wrap guard on the shift; the line ends at its FIRST
                // CR, which must be part of a CRLF — a bare CR inside the
                // extension is malformed there too).
                e : i64 = -1;   // offset of the line's first CR
                k : i64 = 0;
                while k < c.readLen {
                    if c.readBuf[k] == '\r' { e = k; break; }
                    k += 1;
                }
                if e < 0 { break; }                 // no CR yet — need more (bodyReady grows/aborts at the cap)
                if e + 1 >= c.readLen { break; }   // CR at the buffer edge — need the LF
                if c.readBuf[e + 1] != '\n' {
                    self.bodyAbort(slot);          // bare CR in the size line
                    return;
                }
                size : i64 = 0;
                digits : i64 = 0;
                p : i64 = 0;
                bad := false;
                while p < e {
                    ch := c.readBuf[p];
                    hv : i64 = -1;
                    if '0' <= ch <= '9' { hv = (ch - '0').(i64); }
                    else if 'a' <= ch <= 'f' { hv = (ch - 'a' + 10).(i64); }
                    else if 'A' <= ch <= 'F' { hv = (ch - 'A' + 10).(i64); }
                    if hv < 0 { break; }
                    if size > 0x07FFFFFFFFFFFFFF { bad = true; break; }   // would wrap i64
                    size = size * 16 + hv;
                    digits += 1;
                    p += 1;
                }
                if !bad and (digits == 0 or (p < e and c.readBuf[p] != ';')) { bad = true; }   // not ';' before CR
                if bad {
                    self.bodyAbort(slot);
                    return;
                }
                consumed := e + 2;
                rest := c.readLen - consumed;
                if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[consumed], rest); }
                c.readLen = rest;
                progressed = true;
                if size == 0 {
                    c.bchState = 3;        // trailer block
                    c.bodyRemaining = 0;   // trailer LINE counter (bounded by maxHeaders)
                } else {
                    c.bchState = 1;
                    c.bodyRemaining = size;
                }
                continue;
            }
            if c.bchState == 1 {
                // Chunk data: stream it as it arrives — a chunk larger than
                // the read buffer (or the channel) never needs to fit whole.
                if c.readLen == 0 { break; }
                n := if c.bodyRemaining < c.readLen then c.bodyRemaining else c.readLen;
                took := c.bchan.feed(c.readBuf, n);
                if took > 0 {
                    progressed = true;
                    rest := c.readLen - took;
                    if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[took], rest); }
                    c.readLen = rest;
                    c.bodyRemaining -= took;
                }
                if c.bodyRemaining == 0 {
                    c.bchState = 2;   // the CRLF after the data
                    continue;
                }
                if took < n { self.bodyPark(slot); }
                break;
            }
            if c.bchState == 2 {
                if c.readLen < 2 { break; }
                if c.readBuf[0] != '\r' or c.readBuf[1] != '\n' {
                    self.bodyAbort(slot);
                    return;
                }
                rest := c.readLen - 2;
                if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[2], rest); }
                c.readLen = rest;
                progressed = true;
                c.bchState = 0;
                continue;
            }
            // bchState == 3: trailer block — consume lines until the empty
            // one; contents ignored, never merged (no smuggle). The line
            // COUNT is bounded by maxHeaders (an attacker must not keep a
            // request alive with an infinite trailer drip).
            if c.readLen < 2 { break; }
            if c.readBuf[0] == '\r' and c.readBuf[1] == '\n' {
                rest := c.readLen - 2;
                if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[2], rest); }
                c.readLen = rest;
                self.bodyEof(slot);
                break;
            }
            // A trailer line also ends at its FIRST CR, which must be part
            // of a CRLF — a bare CR inside the line is malformed (parity
            // with decodeChunkedPass's trailer scan).
            te : i64 = -1;
            tk : i64 = 0;
            while tk < c.readLen {
                if c.readBuf[tk] == '\r' { te = tk; break; }
                tk += 1;
            }
            if te < 0 { break; }                 // trailer line incomplete
            if te + 1 >= c.readLen { break; }   // CR at the buffer edge — need the LF
            if c.readBuf[te + 1] != '\n' {
                self.bodyAbort(slot);           // bare CR in a trailer line
                return;
            }
            c.bodyRemaining += 1;
            if c.bodyRemaining > self.cfg.maxHeaders {
                self.bodyAbort(slot);
                return;
            }
            rest := c.readLen - (te + 2);
            if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[te + 2], rest); }
            c.readLen = rest;
            progressed = true;
        }
        if progressed and self.conns[slot].state == CONN_BODY {
            self.setDeadline(slot, self.cfg.timeoutRequestMs);
            // byte progress wakes the conn's fiber (a parked reader);
            // the tick-end drive runs it. (The eof transition wakes inside
            // bodyEof — it can arrive with no byte progress.)
            if self.conns[slot].fiberH != 0 {
                self.cfg.fibers.wake(self.conns[slot].fiberH);
            }
        }
    }

    // Readiness on a CONN_BODY slot: pump what is buffered, then read more.
    // Mirrors readMore's error contract (WouldBlock pauses; Closed/Fault
    // drops the conn — connClose faults the channel so the blocked reader
    // wakes) but never parses requests: the front of readBuf is body
    // framing until end-of-body.
    bodyReady :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        while true {
            self.pumpBody(slot);
            if c.state != CONN_BODY { return; }   // end-of-body → CONN_HANDLING
            if c.bodyParked { return; }          // channel full — parked
            if c.bodyMode == 0 { return; }       // aborted (bad framing)
            if c.readLen == c.readCap {
                // A framing ELEMENT (size line / trailer line) larger than
                // the buffer: grow toward the cap, else the framing is
                // abusive — abort. (Chunk DATA never requires growth — it
                // streams out through the channel.)
                if !self.growReadBuf(slot, 0) {
                    self.bodyAbort(slot);
                    return;
                }
            }
            nq, re := self.connRead(slot, *c.readBuf[c.readLen], c.readCap - c.readLen);
            if re == .WouldBlock { return; }
            if re {
                self.emit(EventKind.READ_FAULT, slot, 0);
                self.connClose(slot);   // faults + releases the channel
                return;
            }
            self.stBytesIn += nq;
            c.readLen += nq;
        }
    }

    // A worker drained a STALLED channel and woke the loop: resume every
    // parked CONN_BODY slot — pump the framing still buffered, and re-arm
    // the read watch if the pump wants more wire bytes. Gated on the
    // parked counter so the slot scan costs nothing when nothing is parked.
    resumeBodyPumps :: (self: *Server) {
        if self.bodyParkedN == 0 { return; }
        i : i64 = 0;
        while i < self.cfg.maxConn {
            c := *self.conns[i];
            if c.state == CONN_BODY and c.bodyParked {
                c.bodyParked = false;
                self.bodyParkedN -= 1;
                self.pumpBody(i);
                // Still streaming and not re-parked → hungry for wire bytes.
                if c.state == CONN_BODY and !c.bodyParked and c.bodyMode != 0 {
                    are := false;
                    self.loop.addRead(c.fd, i.(usize)) catch { are = true; };
                    if are {
                        self.emit(EventKind.READ_FAULT, i, 0);
                        self.connClose(i);
                    } else {
                        self.bodyReady(i);   // level-triggered: catch bytes queued while parked
                    }
                }
            }
            i += 1;
        }
    }

    // a worker fed a HUNGRY stream channel and woke the loop — resume
    // every paused stream drain. writeMore re-arms the write watch on the
    // first WouldBlock and re-flags streamWaiting if the channel runs dry
    // again. Gated on the counter so the scan costs nothing normally.
    resumeStreamPumps :: (self: *Server) {
        if self.streamWaitingN == 0 { return; }
        i : i64 = 0;
        while i < self.cfg.maxConn {
            c := *self.conns[i];
            if c.state == CONN_WRITING and c.streamWaiting {
                c.streamWaiting = false;
                self.streamWaitingN -= 1;
                self.writeMore(i);
            }
            i += 1;
        }
    }

    // ── read → parse → dispatch ──────────────────────────────────────

    // Grow the slot's read buffer to at least `target` (0 = double),
    // never past cfg.readBufCap. False when already at the limit.
    growReadBuf :: (self: *Server, slot: i64, target: i64) -> bool {
        c := *self.conns[slot];
        want := if target > 0 then target else c.readCap * 2;
        if want <= c.readCap { return true; }
        if want > self.cfg.readBufCap { want = self.cfg.readBufCap; }
        if want <= c.readCap { return false; }   // already at the limit
        nb : [*]u8 = self.ownAlloc.alloc(u8, want).ptr;
        if c.readLen > 0 { clib.memcpy(nb, c.readBuf, c.readLen); }
        self.ownAlloc.deallocBytes(c.readBuf);
        c.readBuf = nb;
        c.readCap = want;
        return true;
    }

    // ── Transport seam ────────────────────────────────────
    // readMore / writeMore go through these instead of calling
    // socket.*_nb directly, so a connection is transport-agnostic:
    // plaintext, or TLS app-data once cfg.tls negotiated the session.
    // The (i64, !) contract is IDENTICAL to socket.readNb/writeNb
    // — `SockErr.WouldBlock` to pause (re-arm), `SockErr.Closed`/`Fault` to drop —
    // so the callers stay unchanged. The TLS branch maps the abstract
    // TlsStep onto the same channel; a TlsStep.Closed (clean close_notify)
    // is `SockErr.Closed` exactly like a plaintext EOF.
    //
    // CROSS-DIRECTION WANTS: a DATA-phase TLS
    // read may return WantWrite (the session must flush a pending record
    // before it can deliver plaintext) and a write may return WantRead (the
    // session needs a peer message first) — renegotiation / ticket-flush
    // shaped flows. Both surface to the callers as `SockErr.WouldBlock`
    // (the same pause/re-arm contract), but the wanted DIRECTION is
    // tracked on the Conn so the ready loop drives the OPPOSITE readiness:
    //   read-want-write  → connRead arms the write watch here (readability
    //     alone can never unstick it); a writable event re-enters the READ
    //     path. The cross-arm is torn down the moment the read resolves the
    //     other way (WantRead / progress / EOF) — unless a response drain
    //     owns the watch (CONN_WRITING: writeMore manages it, with its del
    //     sites guarded on the flag).
    //   write-want-read  → connWrite records the flag and DROPS the write
    //     watch if armed: a level-triggered writable with a read-direction
    //     want would spin one futile retry per tick. The always-armed read
    //     watch delivers the retry; the ready loop routes it to writeMore.
    tlsRdWantClear :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        if !c.tlsRdWantWrite { return; }
        c.tlsRdWantWrite = false;
        if c.writeArmed and c.state != CONN_WRITING {
            self.loop.delWrite(c.fd);
            c.writeArmed = false;
        }
    }

    // Drop BOTH pending cross-direction wants and the
    // cross-armed write watch. Called wherever the conn LEAVES the reading
    // paths with the want unresolved — dispatch into CONN_HANDLING (reading
    // parks: a level-triggered writable would be swallowed by the ready
    // loop's CONN_HANDLING skip, spinning the loop for the whole handler
    // run while the retry it carries could never fire), bodyAbort (reading
    // stops; the slot idles for the owed completion), and beginLinger (raw
    // discard — the TLS want is moot). Dropping is safe: the TLS session
    // still holds the pending record, so the want re-establishes itself on
    // the first connRead/connWrite after the slot returns to an I/O state.
    tlsWantDrop :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        c.tlsWrWantRead = false;
        if !c.tlsRdWantWrite { return; }
        c.tlsRdWantWrite = false;
        if c.writeArmed {
            self.loop.delWrite(c.fd);
            c.writeArmed = false;
        }
    }

    connRead :: (self: *Server, slot: i64, buf: [*]u8, cap: i64) -> (i64, !) {
        c := *self.conns[slot];
        if c.tls != null {
            n, step := c.tls.read(buf, cap);
            if step == TlsStep.Done {
                self.tlsRdWantClear(slot);
                if n > 0 { return n; }
                raise socket.SockErr.Closed;                // 0 bytes done == EOF
            }
            if step == TlsStep.WantWrite {
                // cross-arm the write watch — only writability can
                // deliver the retry. An arm failure means the fd is
                // unusable: surface as a read fault (the caller closes).
                c.tlsRdWantWrite = true;
                if !c.writeArmed {
                    awe := false;
                    self.loop.addWrite(c.fd, slot.(usize)) catch { awe = true; };
                    if awe { raise socket.SockErr.Closed; }
                    c.writeArmed = true;
                }
                raise socket.SockErr.WouldBlock;
            }
            if step == TlsStep.WantRead {
                self.tlsRdWantClear(slot);
                raise socket.SockErr.WouldBlock;
            }
            self.tlsRdWantClear(slot);
            raise socket.SockErr.Closed;                    // Closed (close_notify) / Fatal → drop
        }
        nq, re := socket.readNb(c.fd, buf, cap);
        if re == .WouldBlock { raise socket.SockErr.WouldBlock; }
        if re { raise socket.SockErr.Closed; }              // Closed / Fault → drop
        return nq;
    }

    connWrite :: (self: *Server, slot: i64, buf: [*]u8, len: i64) -> (i64, !) {
        c := *self.conns[slot];
        if c.tls != null {
            n, step := c.tls.write(buf, len);
            if step == TlsStep.Done {
                c.tlsWrWantRead = false;
                if n > 0 { return n; }
                raise socket.SockErr.WouldBlock;            // 0 written → retry on writable
            }
            if step == TlsStep.WantRead {
                // the write needs READABILITY. Drop the write watch —
                // a level-triggered writable with nothing to act on would
                // spin the loop; the read watch delivers the retry. (Unless
                // a blocked TLS READ cross-armed it — that retry still
                // needs writability, and its routing does real work.)
                c.tlsWrWantRead = true;
                if c.writeArmed and !c.tlsRdWantWrite {
                    self.loop.delWrite(c.fd);
                    c.writeArmed = false;
                }
                raise socket.SockErr.WouldBlock;
            }
            if step == TlsStep.WantWrite {
                c.tlsWrWantRead = false;
                raise socket.SockErr.WouldBlock;
            }
            c.tlsWrWantRead = false;
            raise socket.SockErr.Closed;                    // Closed / Fatal → drop
        }
        nq, we := socket.writeNb(c.fd, buf, len);
        if we == .WouldBlock { raise socket.SockErr.WouldBlock; }
        if we { raise socket.SockErr.Closed; }              // Closed / Fault → drop
        return nq;
    }

    // the one-off interim "HTTP/1.1 100 Continue" — written DIRECTLY
    // through the transport seam, not via the outBuf machinery (outBuf
    // carries exactly one FINAL response per request and its completion
    // drives the keep-alive state machine; an interim must not). 25 bytes
    // into a send queue that is empty in practice (the server has written
    // nothing for this request yet); a peer on which even that blocks or
    // faults mid-interim would leave half a status line on the wire — the
    // stream is unrecoverable, so treat it as a write fault and close.
    // Returns false when the connection was closed.
    sendContinue :: (self: *Server, slot: i64) -> bool {
        c := *self.conns[slot];
        if c.contSent { return true; }
        c.contSent = true;
        msg := "HTTP/1.1 100 Continue\r\n\r\n";
        mp : [*]u8 = msg.ptr;
        off : i64 = 0;
        while off < msg.len {
            nq, we := self.connWrite(slot, *mp[off], msg.len - off);
            if we {   // WouldBlock or fault — see above: both close
                self.emit(EventKind.WRITE_FAULT, slot, 0);
                self.connClose(slot);
                return false;
            }
            self.stBytesOut += nq;
            off += nq;
        }
        return true;
    }

    readMore :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        if c.state == CONN_KEEPALIVE {
            c.state = CONN_READING;
            self.setDeadline(slot, self.cfg.timeoutRequestMs);
        }
        while true {
            if c.readLen == c.readCap {
                if !self.growReadBuf(slot, 0) {
                    // 0.3: a response is in flight (CONN_WRITING) — NEVER
                    // serialize a second response over a draining outBuf
                    // (that leaks the old buffer and splices error bytes
                    // into the wire mid-body). Stop reading instead: drop
                    // the read watch (level-triggered — the flood would
                    // otherwise spin the loop), discard the over-cap bytes,
                    // and close once the in-flight response finishes.
                    if c.state == CONN_WRITING {
                        self.loop.delRead(c.fd);
                        c.readLen = 0;
                        c.resetParse();
                        c.closeAfter = true;
                        // this is an error close (the flood is being
                        // rejected without a response) — linger so the
                        // in-flight response's tail isn't RST-killed by the
                        // unread flood at close. Surface the rejection to
                        // observability as a 431-class parse fault (no
                        // second response is serialized — see above).
                        c.lingerClose = true;
                        self.st4xx += 1;
                        self.emit(EventKind.PARSE_ERROR, slot, 431);
                        return;
                    }
                    // over the limit: oversized headers (431) or body (413)
                    hdrDone := false;
                    i : i64 = 0;
                    while i + 3 < c.readLen {
                        if c.readBuf[i] == '\r' and c.readBuf[i+1] == '\n' and c.readBuf[i+2] == '\r' and c.readBuf[i+3] == '\n' { hdrDone = true; break; }
                        i += 1;
                    }
                    self.respondErrorClose(slot, if hdrDone then 413 else 431);
                    return;
                }
            }
            nq, re := self.connRead(slot, *c.readBuf[c.readLen], c.readCap - c.readLen);
            if re == .WouldBlock { break; }
            if re {   // Closed or Fault — peer reset / EOF mid-request
                self.emit(EventKind.READ_FAULT, slot, 0);
                self.connClose(slot);
                return;
            }
            self.stBytesIn += nq;
            c.readLen += nq;
        }
        self.serveBuffered(slot);
    }

    // Serve every complete request sitting in the buffer (a keep-alive
    // client may pipeline; each response must finish sending before the
    // next parse — a pending partial write pauses the drain and
    // writeMore resumes it).
    serveBuffered :: (self: *Server, slot: i64) {
        while self.conns[slot].state == CONN_READING {
            if !self.tryServeOne(slot) { return; }
        }
    }

    // (RFC 3986 §2.1, §5.2.4): canonicalize the routable path —
    // percent-decode + dot-segment removal, IN PLACE in readBuf, with the
    // query (if any) slid left against the new path end so the combined
    // req.path view stays contiguous. Shared by the accumulate and streaming
    // streamed dispatch paths; MUST run exactly once per request, only when
    // the request is guaranteed to be CONSUMED this cycle (the canonical
    // path may contain a literal '%' from %25 — a re-parse would double-
    // decode). The query itself is NEVER decoded (the router's permissive
    // query/form decode is a separate, later layer). Skipped for the
    // synthetic "/" and asterisk-form targets, and for any path with
    // neither a '%' nor a dot segment (the common case — one scan).
    // False = the path was rejected (400 sent, connection closing).
    canonPath :: (self: *Server, slot: i64, req: *Request, pathOff: i64, pathStaticRoot: bool) -> bool {
        c := *self.conns[slot];
        if pathStaticRoot or (req.path.len == 1 and req.path[0] == '*') { return true; }
        qoff := 0;   // offset of '?' (or path end) within the target view
        while qoff < req.path.len and req.path[qoff] != '?' { qoff += 1; }
        // Dirty = any '%', or a DOT SEGMENT — "/." only counts when
        // the dot ends the path or is followed by '/' or another dot,
        // so dotfile paths ("/.well-known/…") stay on the fast path.
        dirty := false;
        sc := 0;
        while sc < qoff {
            ch := req.path[sc];
            if ch == '%' { dirty = true; break; }
            if ch == '.' and sc > 0 and req.path[sc - 1] == '/' {         // "/."
                nx : u8 = 0;
                if sc + 1 < qoff { nx = req.path[sc + 1]; }
                if sc + 1 >= qoff or nx == '/' or nx == '.' { dirty = true; break; }
            }
            sc += 1;
        }
        if !dirty { return true; }
        np := normalizePath(*c.readBuf[pathOff], qoff);
        if np < 0 {
            self.respondErrorClose(slot, 400);
            return false;
        }
        if qoff < req.path.len {
            // slide "?query" left against the canonical path end
            qlen := req.path.len - qoff;
            mv : i64 = 0;
            while mv < qlen {
                c.readBuf[pathOff + np + mv] = c.readBuf[pathOff + qoff + mv];
                mv += 1;
            }
            np += qlen;
        }
        req.path = string{ ptr = *c.readBuf[pathOff], len = np };
        return true;
    }

    // Parse one request off the front of the buffer; false = incomplete
    // (need more bytes) or the connection left the READING state.
    tryServeOne :: (self: *Server, slot: i64) -> bool {
        c := *self.conns[slot];
        buf := string{ ptr = c.readBuf, len = c.readLen };

        // headers complete? Resume the terminator scan where the last
        // cycle left off (scanPos bytes are known clean; back up 3 so a
        // terminator straddling the previous boundary is caught) and cache
        // the hit, so a slow-dripped request does not rescan from byte 0
        // every read cycle.
        he := c.hdrEnd;
        if he < 0 {
            i := c.scanPos - 3;
            if i < 0 { i = 0; }
            while i + 3 < buf.len {
                if buf[i] == '\r' and buf[i+1] == '\n' and buf[i+2] == '\r' and buf[i+3] == '\n' { he = i; break; }
                i += 1;
            }
            if he < 0 {
                c.scanPos = buf.len;
                return false;
            }
            c.hdrEnd = he;
        }

        // request line: METHOD SP PATH SP VERSION CRLF
        req : Request = .{};
        p := 0;
        while p < he and buf[p] != ' ' { p += 1; }
        req.method = string{ ptr = c.readBuf, len = p };
        p += 1;
        ps := p;
        while p < he and buf[p] != ' ' { p += 1; }
        req.path = string{ ptr = *c.readBuf[ps], len = p - ps };
        p += 1;
        vs := p;
        while p < he and buf[p] != '\r' { p += 1; }
        req.version = string{ ptr = *c.readBuf[vs], len = p - vs };
        hdrStart := p + 2;
        // hdrStart == he + 2 is the LEGAL zero-header shape (the request
        // line's own CRLF is the first half of the terminator); anything
        // beyond is malformed. A header-less request is a legal HTTP/1.0 form.
        if req.method.len == 0 or req.path.len == 0 or hdrStart > he + 2 {
            self.respondErrorClose(slot, 400);
            return false;
        }
        // Version must be exactly HTTP/1.0 or HTTP/1.1. A WELL-FORMED
        // but unsupported version token ("HTTP/2.0", "HTTP/1.7") is a
        // version-negotiation failure → 505; only a token that isn't even
        // an HTTP-version shape ("FOO/1.1", junk) is a malformed request
        // line → 400. Method/path must be free of control chars (a CR/LF
        // or NUL smuggled into either is a request-splitting vector).
        if !asciiIeq(req.version, "http/1.0") and !asciiIeq(req.version, "http/1.1") {
            httpShape := req.version.len >= 6
                and asciiIeq(string{ ptr = req.version.ptr, len = 5 }, "http/");
            self.respondErrorClose(slot, if httpShape then 505 else 400);
            return false;
        }
        if hasCtrl(req.method) or hasCtrl(req.path) {
            self.respondErrorClose(slot, 400);
            return false;
        }

        // (RFC 9112 §3.2): classify the request-target form. The
        // routable path (req.path) and, for absolute-form, the embedded
        // authority (req.authority) are derived HERE, so downstream code —
        // the router, the pool-job view rebuild — never sees a raw
        // absolute-form target.
        //   origin-form    "/path?query"      — the common case, as-is.
        //   absolute-form  "http://auth/path" — an origin server MUST
        //     accept it (§3.2.2): authority → req.authority, req.path →
        //     the embedded path (query rides along; no path at all → "/").
        //     Only the http/https schemes are meaningful here → 400 else.
        //   asterisk-form  "*"                — OPTIONS only → 400 else.
        //   authority-form "host:port"        — CONNECT only, and CONNECT
        //     is unimplemented → 501; any other method whose target is
        //     none of the forms above is malformed → 400.
        // CONNECT is not implemented AT ALL — reject it for EVERY target
        // form, before classification (its target must be authority-form
        // per §3.2.3 anyway; an origin/absolute-form CONNECT falling
        // through to the handler would "serve" a tunnel request as if it
        // were a GET). Method tokens here and below are matched
        // case-insensitively — a DELIBERATE leniency, consistent with the
        // router's method matching (ciEq); RFC methods are case-sensitive,
        // but the lenient match only changes what happens to bogus tokens
        // ("connect", "options"), never the handling of a legal request.
        if asciiIeq(req.method, "connect") {
            self.respondErrorClose(slot, 501);
            return false;
        }
        pathOff := ps;              // readBuf offset of the routable path
        authOff := 0;               // readBuf offset of the authority
        authLen : i64 = 0;          //   (absolute-form only; 0 = none)
        pathStaticRoot := false;   // req.path is the static "/" literal
        if req.path[0] != '/' {       // not origin-form
            if req.path.len == 1 and req.path[0] == '*' {
                if !asciiIeq(req.method, "options") {
                    self.respondErrorClose(slot, 400);
                    return false;
                }
            } else {
                t := req.path;
                // absolute-form iff the target has a "://" after its scheme
                schemeEnd := -1;
                k := 0;
                while k + 2 < t.len {
                    if t[k] == ':' and t[k + 1] == '/' and t[k + 2] == '/' { schemeEnd = k; break; }   // "://"
                    k += 1;
                }
                if schemeEnd < 0 {
                    // authority-form ("host:port") or junk. Authority-form
                    // is legal ONLY for CONNECT — rejected 501 above — so
                    // whatever reaches here is malformed → 400.
                    self.respondErrorClose(slot, 400);
                    return false;
                }
                sch := string{ ptr = t.ptr, len = schemeEnd };
                if !asciiIeq(sch, "http") and !asciiIeq(sch, "https") {
                    self.respondErrorClose(slot, 400);
                    return false;
                }
                astart := schemeEnd + 3;
                aend := astart;
                while aend < t.len and t[aend] != '/' and t[aend] != '?' { aend += 1; }   // '/' or '?'
                if aend == astart {   // "http:///path" — empty authority
                    self.respondErrorClose(slot, 400);
                    return false;
                }
                authOff = ps + astart;
                authLen = aend - astart;
                req.authority = string{ ptr = *c.readBuf[authOff], len = authLen };
                if aend < t.len and t[aend] == '/' {
                    // embedded path; its query, if any, rides along — the
                    // router splits on '?' itself
                    pathOff = ps + aend;
                    req.path = string{ ptr = *c.readBuf[pathOff], len = t.len - aend };
                } else if aend < t.len {
                    // '?' straight after the authority ("http://host?q"):
                    // an empty path with a query. Splicing the implied "/"
                    // in front of the query would need an allocation the
                    // request views can't own; real clients normalize this
                    // shape away — reject loudly instead of routing wrong.
                    self.respondErrorClose(slot, 400);
                    return false;
                } else {
                    // no path at all ("http://host") — the path is "/"
                    req.path = "/";
                    pathStaticRoot = true;
                }
            }
        }

        req.headersRaw = string{ ptr = *c.readBuf[hdrStart], len = he - hdrStart + 2 };

        // Header-block bounds: cap the line count and each line's length
        // (resource exhaustion / smuggling) → 431. One pass over the raw
        // block, counting CRLF-delimited lines.
        {
            hb := req.headersRaw;
            lines := 0;
            ls := 0;
            k := 0;
            while k < hb.len {
                if hb[k] == '\n' {           // ends a line
                    // line length excludes the trailing CR (and the LF)
                    ll := k - ls;
                    if ll > 0 and hb[k - 1] == '\r' { ll -= 1; }
                    if ll > 0 {
                        lines += 1;
                        if ll > self.cfg.maxHeaderLine { self.respondErrorClose(slot, 431); return false; }
                    }
                    ls = k + 1;
                }
                k += 1;
            }
            if lines > self.cfg.maxHeaders { self.respondErrorClose(slot, 431); return false; }
        }

        // Whitespace before the field-name's colon is malformed (RFC 7230
        // §3.2.4) and a known smuggling vector: a peer that strips the space
        // and a peer that doesn't disagree on whether the header exists
        // (e.g. "Transfer-Encoding : chunked" is seen as TE by one and as a
        // junk name by the other). Reject the whole message → 400. One pass
        // over the raw block: for each non-empty line, scan to the first ':'
        // and fail if any space/tab precedes it; a line with no ':' before
        // its terminator is also malformed.
        {
            hb := req.headersRaw;
            ls := 0;
            k := 0;
            while k < hb.len {
                if hb[k] == '\n' {           // ends a line
                    le := k;
                    if le > ls and hb[le - 1] == '\r' { le -= 1; }   // drop CR
                    if le > ls {           // non-empty line (skip the terminator)
                        colon := -1;
                        badWs := false;
                        m := ls;
                        while m < le {
                            ch := hb[m];
                            if ch == ':' { colon = m; break; }
                            if ch == ' ' or ch == '\t' { badWs = true; break; }
                            m += 1;
                        }
                        if badWs or colon < 0 {
                            self.respondErrorClose(slot, 400);
                            return false;
                        }
                    }
                    ls = k + 1;
                }
                k += 1;
            }
        }

        // (RFC 9112 §3.2): an HTTP/1.1 request MUST carry exactly one
        // Host header — missing or duplicated is malformed (two peers
        // disagreeing on which Host applies is a routing/cache-poisoning
        // vector) → 400. HTTP/1.0 predates Host and stays exempt.
        if asciiIeq(req.version, "http/1.1") {
            if countHeader(*req, "host") != 1 {
                self.respondErrorClose(slot, 400);
                return false;
            }
        }

        // (RFC 9110 §10.1.1): Expect. The only expectation defined is
        // 100-continue: when this 1.1 request declares a body that has NOT
        // fully arrived, the client is told to go ahead with a one-off
        // interim "100 Continue" — sent at the two need-more-body sites
        // below (sendContinue), so an up-front reject (413/400/501) sends
        // the FINAL status instead and a body that already arrived in full
        // needs no interim at all. Any other expectation is unsupported →
        // 417. On HTTP/1.0 the expectation is ignored per the RFC.
        expectContinue := false;
        if asciiIeq(req.version, "http/1.1") {
            exv := findHeader(*req, "expect");
            if asciiIeq(exv, "100-continue") { expectContinue = true; }
            else if exv.len > 0 { self.respondErrorClose(slot, 417); return false; }
        }

        // Treating a TE request as bodyless is a smuggling vector, so an
        // unsupported coding is refused outright → 501 (the accepted set is
        // narrowed below). Detection is by header PRESENCE, not value length:
        // an empty or whitespace-only TE value ("TE:\r\n", "TE:   \r\n") still
        // smuggles, so a single present TE line is enough.
        teCount := countHeader(*req, "transfer-encoding");

        // Duplicate / conflicting Transfer-Encoding is a smuggling vector. Two
        // TE lines (e.g. `chunked` then `gzip`) are equivalent to the coding
        // list `chunked, gzip` per RFC 7230 §3.3.1, where chunked is not the
        // final coding. findHeader sees only the first value, so a downstream
        // that honors the second would frame the body differently → 400.
        if teCount > 1 {
            self.respondErrorClose(slot, 400);
            return false;
        }

        // Duplicate / conflicting Content-Length is a smuggling vector
        // (findHeader sees only the first) → 400.
        clCount := countHeader(*req, "content-length");
        if clCount > 1 {
            self.respondErrorClose(slot, 400);
            return false;
        }

        // Content-Length AND Transfer-Encoding together is the classic
        // CL.TE / TE.CL request-smuggling pair (the two ends disagree on
        // the body framing) → reject outright, never parse ambiguously.
        // (Hoisted above the dispatch-model split — it guards BOTH.)
        if teCount > 0 and clCount > 0 { self.respondErrorClose(slot, 400); return false; }

        // Only `chunked` is implemented. A TE that is not exactly the
        // single token `chunked` (e.g. `gzip`, `identity`, or a multi-
        // coding list `gzip, chunked`) is unimplemented → 501. Treating it
        // as bodyless would smuggle, so we never fall through silently.
        if teCount > 0 {
            tev := findHeader(*req, "transfer-encoding");
            if !asciiIeq(tev, "chunked") { self.respondErrorClose(slot, 501); return false; }
        }

        // does this request stream its body to the handler? (init
        // guarantees the pool exists when the knob is set; the ps check is
        // a belt against an inconsistent Server.)
        streaming := self.cfg.streamRequestBody and (self.ps != null or self.cfg.fibers != null);

        // Parse a PRESENT Content-Length once, up front — shared by the
        // accumulate and streamed paths. A PRESENT Content-Length must be
        // 1*DIGIT (RFC 9112 §6.3) — a present-but-empty value
        // ("Content-Length:\t") must not parse as 0 and leave the real
        // payload unconsumed in the buffer (a framing disagreement with any
        // peer that rejects it). "" from an ABSENT header stays a legal
        // bodyless request, so gate on the count.
        clen : i64 = 0;
        if teCount == 0 and clCount == 1 {
            clv := findHeader(*req, "content-length");
            if clv.len == 0 { self.respondErrorClose(slot, 400); return false; }
            j := 0;
            while j < clv.len {
                d := clv[j];
                if d < '0' or d > '9' { self.respondErrorClose(slot, 400); return false; }
                if streaming {
                    // A streamed body may be ANY size — guard only the i64
                    // wrap of the `clen*10 + digit` shift below.
                    if clen > (1 << 59) { self.respondErrorClose(slot, 400); return false; }
                } else {
                    // Overflow guard: a magnitude this large can't be a real
                    // body and would wrap i64 — an unparseable/malformed
                    // length, not a merely-too-big one → 400. (readBufCap
                    // is ~1 MB / 7 digits, so any value past readBufCap*10
                    // is wildly out of range.)
                    if clen > self.cfg.readBufCap { self.respondErrorClose(slot, 400); return false; }
                }
                clen = clen * 10 + (d - '0');
                if clen < 0 { self.respondErrorClose(slot, 400); return false; }
                j += 1;
            }
        }

        // ── STREAMED dispatch (pool mode, streamRequestBody) ──────
        // A body-carrying request is handed to a worker at HEADERS-COMPLETE:
        // the job copies ONLY the header region; req.body stays "" and the
        // body flows through a bounded BodyChan as the loop decodes the
        // framing (CONN_BODY). maxBody is NOT enforced — the reading
        // handler is the bound (see Config.streamRequestBody).
        if streaming and (teCount > 0 or clen > 0) {
            // The request is CONSUMED this cycle (dispatch is unconditional
            // from here; every failure path below closes the conn), so the
            // once-only path canonicalization is safe now.
            if !self.canonPath(slot, *req, pathOff, pathStaticRoot) { return false; }
            // An Expect: 100-continue client is told to proceed — the body
            // WILL be read. (Harmless if some body bytes already arrived.)
            if expectContinue and !self.sendContinue(slot) { return false; }

            // keep-alive: same rules as the accumulate path, decided at
            // dispatch. (c.served counts DISPATCHED requests; the accumulate
            // path counts at completion — equivalent, one per request.)
            req.keepAlive = !asciiIeq(req.version, "http/1.0");
            cnv := findHeader(*req, "connection");
            if tokenListHas(cnv, "close") { req.keepAlive = false; }
            else if tokenListHas(cnv, "keep-alive") { req.keepAlive = true; }
            c.served += 1;
            keep := req.keepAlive and c.served < self.cfg.requestCount;
            isHead := asciiIeq(req.method, "head");
            req.deadlineMs = self.cfg.handlerTimeoutMs;

            ch : *BodyChan = self.ownAlloc.create(BodyChan);
            ch.* = BodyChan{ alloc = self.ownAlloc };
            if !ch.mu.setup() {
                self.ownAlloc.deallocBytes(ch);
                self.respondErrorClose(slot, 500);
                return false;
            }
            if !ch.cv.setup() {
                ch.mu.destroy();
                self.ownAlloc.deallocBytes(ch);
                self.respondErrorClose(slot, 500);
                return false;
            }
            ch.buf = self.ownAlloc.alloc(u8, BODY_CHAN_CAP).ptr;
            ch.cap = BODY_CHAN_CAP;
            // Copy AFTER init's unconditional addWake — wakeFd is live.
            ch.lp = self.loop;

            // The job owns a copy of the HEADER region only (0.1 rules; the
            // views are rebuilt over the copy exactly like the accumulate
            // pool path, minus the body — the channel IS the body).
            hdrTotal := he + 4;
            job : *HandlerJob = self.ownAlloc.allocBytes(@sizeOf(HandlerJob) + hdrTotal).(*HandlerJob);
            jb : [*]u8 = job.([*]u8);
            raw : [*]u8 = *jb[@sizeOf(HandlerJob)];
            clib.memcpy(raw, c.readBuf, hdrTotal);
            jreq := req;
            jreq.body = "";
            jreq.method = string{ ptr = raw, len = req.method.len };
            if !pathStaticRoot { jreq.path = string{ ptr = *raw[pathOff], len = req.path.len }; }
            if authLen > 0 { jreq.authority = string{ ptr = *raw[authOff], len = authLen }; }
            jreq.version = string{ ptr = *raw[vs], len = req.version.len };
            jreq.headersRaw = string{ ptr = *raw[hdrStart], len = req.headersRaw.len };
            job.* = HandlerJob{
                handler = self.handler, appCtx = self.ctx, ps = self.ps,
                alloc = self.ownAlloc, req = jreq,
                slot = slot, gen = c.gen, keep = keep, consumed = 0,
                serverName = self.cfg.serverName,
                compressResponses = self.cfg.compressResponses,
                compressMinSize = self.cfg.compressMinSize,
                compressLevel = self.cfg.compressLevel,
                chan = ch, srv = self,
            };

            c.headReq = isHead;
            c.bchan = ch;
            if teCount > 0 {
                c.bodyMode = 2;
                c.bchState = 0;
                c.bodyRemaining = 0;
            } else {
                c.bodyMode = 1;
                c.bodyRemaining = clen;
            }
            c.state = CONN_BODY;
            // The DELIVERY deadline bounds body progress (stall-based —
            // pumpBody refreshes it on every piece); the handler deadline
            // is armed once the body completes (bodyEof).
            c.handlerDeadline = 0;

            if self.cfg.fibers != null {
                // spawn the handler FIBER (enqueued ready — it first
                // runs at this tick's drive). Its readBody suspends on an
                // empty channel; the pump wakes it. Completion is the
                // fiber tail + finalizeFibers.
                c.fiberH = self.cfg.fibers.spawn(runFiberJob.(*void), job);
                self.fiberSpawned = true;   // tick re-drives until quiescent
            } else if !self.ps.pool.submit(runHandlerJob, job.(usize)) {
                // Backlog full: shed 503 — undo the dispatch (the worker
                // never saw the job; both channel refs die here).
                self.ownAlloc.deallocBytes(job);
                c.bchan = null;
                c.bodyMode = 0;
                c.state = CONN_READING;
                ch.release();
                ch.release();
                self.respondErrorClose(slot, 503);
                return false;
            }

            // Drop the consumed header region NOW — from here the front of
            // readBuf is body framing (the job owns its own header copy).
            rest := c.readLen - hdrTotal;
            if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[hdrTotal], rest); }
            c.readLen = rest;
            c.resetParse();
            self.setDeadline(slot, self.cfg.timeoutRequestMs);
            // Pump whatever body framing already arrived with the headers
            // (may complete the body immediately → CONN_HANDLING).
            self.pumpBody(slot);
            return false;
        }

        // The effective body-size ceiling. maxBody == 0 means "use the
        // read-buffer cap" (the raw request, framing included, can never
        // exceed readBufCap anyway). Otherwise clamp to readBufCap — a
        // configured maxBody larger than the buffer is meaningless since the
        // request can't be buffered past the cap.
        maxBody := self.cfg.maxBody;
        if maxBody <= 0 or maxBody > self.cfg.readBufCap { maxBody = self.cfg.readBufCap; }

        // total = raw request bytes (request line + headers + CRLFCRLF + body
        // framing) to consume from the read buffer once dispatched.
        total : i64 = 0;

        if teCount > 0 {
            // Decode the chunked body in place. Validation RESUMES at
            // the checkpoint from the previous NEED_MORE (a chunk boundary),
            // so each raw byte is scanned once regardless of how many partial
            // reads deliver the body. The compaction still runs exactly once,
            // over the whole framing, only after validation proves it
            // complete — semantics (early 413, BAD/OVERFLOW, commit-only-
            // when-complete) unchanged.
            bodyStart := he + 4;
            resume : ChunkScan = .{};
            if c.chunkActive { resume = ChunkScan{ rp = c.chunkRp, decoded = c.chunkDecoded }; }
            cr := decodeChunked(*c.readBuf[bodyStart], c.readLen - bodyStart, maxBody, resume);
            if cr.status == ChunkStatus.NEED_MORE {
                c.chunkActive = true;
                c.chunkRp = cr.resumeRp;
                c.chunkDecoded = cr.resumeDecoded;
                // Not all framing has arrived. Make sure the buffer can grow
                // to admit more bytes; if it's already at the cap with no
                // complete body, that's an over-cap body → 413.
                if c.readLen == c.readCap and !self.growReadBuf(slot, 0) {
                    self.respondErrorClose(slot, 413);
                    return false;
                }
                // headers complete, chunked body still incoming —
                // tell an Expect: 100-continue client to proceed (once).
                if expectContinue and !self.sendContinue(slot) { return false; }
                return false;
            }
            if cr.status == ChunkStatus.TOO_BIG { self.respondErrorClose(slot, 413); return false; }
            if cr.status == ChunkStatus.BAD or cr.status == ChunkStatus.OVERFLOW {
                self.respondErrorClose(slot, 400);
                return false;
            }
            // OK: decoded body is compacted at bodyStart, rawLen bytes used.
            total = bodyStart + cr.rawLen;
            req.body = string{ ptr = *c.readBuf[bodyStart], len = cr.decodedLen };
        } else {
            // body per Content-Length (`clen` parsed up front, above).
            // Early 413: a cleanly-parsed Content-Length over maxBody is
            // rejected NOW — before the body is buffered (the body bytes are
            // never admitted into the slot's read buffer).
            if clen > maxBody { self.respondErrorClose(slot, 413); return false; }
            total = he + 4 + clen;
            if total > self.cfg.readBufCap { self.respondErrorClose(slot, 413); return false; }
            if c.readLen < total {
                // size the buffer for the declared body in one step
                self.growReadBuf(slot, total);
                // headers complete, a non-empty declared body still
                // incoming — tell an Expect: 100-continue client to
                // proceed (once).
                if expectContinue and clen > 0 and !self.sendContinue(slot) { return false; }
                return false;
            }
            req.body = string{ ptr = *c.readBuf[he + 4], len = clen };
        }

        // canonicalize the routable path (percent-decode + dot-segment
        // removal, in place — see canonPath). Runs HERE — only once the
        // request is COMPLETE — because a partial-body retry re-parses the
        // raw bytes; an earlier rewrite would corrupt the re-parse.
        if !self.canonPath(slot, *req, pathOff, pathStaticRoot) { return false; }

        // keep-alive: 1.1 default on, 1.0 default off, header overrides.
        // (RFC 9110 §7.6.1): Connection is a comma-separated token
        // list ("close, TE" reads as close) — token match, never substring.
        // If both tokens appear (pathological), close wins. KNOWN LIMIT:
        // findHeader returns the FIRST Connection line only, so a second
        // `Connection: close` line is missed — benign (the client FINs and
        // the close is reaped), unlike TE/CL where duplicates are 400'd.
        req.keepAlive = !asciiIeq(req.version, "http/1.0");
        cnv := findHeader(*req, "connection");
        if tokenListHas(cnv, "close") { req.keepAlive = false; }
        else if tokenListHas(cnv, "keep-alive") { req.keepAlive = true; }

        c.served += 1;
        keep := req.keepAlive and c.served < self.cfg.requestCount;

        // HEAD is decided by the PARSED method, before the handler
        // runs — a handler mutating req.method must not flip body
        // suppression. The pool path stamps it on the slot too, so the
        // handler-timeout sweep's 504 suppresses its body for a HEAD.
        isHead := asciiIeq(req.method, "head");

        // Expose the per-request budget to the handler (advisory in
        // inline mode, also loop-enforced in pool mode below).
        req.deadlineMs = self.cfg.handlerTimeoutMs;

        // Pooled dispatch: freeze this connection (CONN_HANDLING — no
        // reads, no eviction, no recycling, so the job's request views
        // into the read buffer stay valid), hand the job to a worker,
        // and return; the completion re-enters via drainCompletions.
        // A full backlog sheds with 503 (httpz backpressure).
        // fiber mode takes the SAME job-copy shape — the fiber's
        // suspension points make the conn's readBuf just as unsafe to
        // view as a worker's (the buffer stays frozen, but the copy keeps
        // one ownership rule for all non-inline dispatch).
        if self.ps != null or self.cfg.fibers != null {
            // 0.1: the job OWNS a copy of the raw request bytes. The worker
            // must never read the conn's readBuf after dispatch — a handler
            // timeout (handler_timeout_sweep) frees the slot mid-run, and a
            // reusing connection rewrites or reallocs the buffer under the
            // worker's views. One allocation carries the job header + the
            // bytes tail; runHandlerJob frees them together. The request
            // views are rebuilt over the copy from the parse offsets above
            // (method at 0, path at pathOff — inside the target, which for
            // absolute-form is PAST ps — authority at authOff, version at
            // vs, headers at hdrStart, body — Content-Length or compacted
            // chunked — at he + 4). A synthetic "/" path (empty-path
            // absolute-form) is a static literal, valid on any thread — no
            // rebuild.
            job : *HandlerJob = self.ownAlloc.allocBytes(@sizeOf(HandlerJob) + total).(*HandlerJob);
            jb : [*]u8 = job.([*]u8);
            raw : [*]u8 = *jb[@sizeOf(HandlerJob)];
            clib.memcpy(raw, c.readBuf, total);
            jreq := req;
            jreq.method      = string{ ptr = raw, len = req.method.len };
            if !pathStaticRoot { jreq.path = string{ ptr = *raw[pathOff], len = req.path.len }; }
            if authLen > 0 { jreq.authority = string{ ptr = *raw[authOff], len = authLen }; }
            jreq.version     = string{ ptr = *raw[vs], len = req.version.len };
            jreq.headersRaw = string{ ptr = *raw[hdrStart], len = req.headersRaw.len };
            jreq.body        = string{ ptr = *raw[he + 4], len = req.body.len };
            job.* = HandlerJob{
                handler = self.handler, appCtx = self.ctx, ps = self.ps,
                alloc = self.ownAlloc, req = jreq,
                slot = slot, gen = c.gen, keep = keep, consumed = total,
                serverName = self.cfg.serverName,
                compressResponses = self.cfg.compressResponses,
                compressMinSize = self.cfg.compressMinSize,
                compressLevel = self.cfg.compressLevel,
                srv = self,
            };
            c.state = CONN_HANDLING;
            // Reading parks below — drop any unresolved
            // cross-direction want with its cross-armed watch.
            self.tlsWantDrop(slot);
            c.headReq = isHead;
            if self.cfg.fibers != null {
                // (cooperative): no hard handler deadline — the loop
                // cannot preempt a fiber it is hosting (inline semantics;
                // Request.deadlineMs stays the advisory budget).
                c.handlerDeadline = 0;
                c.fiberH = self.cfg.fibers.spawn(runFiberJob.(*void), job);
                self.fiberSpawned = true;   // tick re-drives until quiescent
            } else {
                // Arm the handler deadline as the slot enters
                // CONN_HANDLING. The tick sweep enforces it (504 + close)
                // if the worker overruns. 0 disables (no timeout). Distinct
                // from c.deadline (delivery), which the sweep skips while
                // CONN_HANDLING.
                if self.cfg.handlerTimeoutMs > 0 {
                    c.handlerDeadline = event.deadlineIn(self.cfg.handlerTimeoutMs);
                    self.armSlot(slot, c.handlerDeadline);
                } else {
                    c.handlerDeadline = 0;
                }
                if !self.ps.pool.submit(runHandlerJob, job.(usize)) {
                    self.ownAlloc.deallocBytes(job);
                    c.state = CONN_READING;
                    c.handlerDeadline = 0;
                    self.respondErrorClose(slot, 503);
                    return false;
                }
            }
            // 0.2: PARK the read watch while the worker holds the request.
            // The loop ignores readiness on a CONN_HANDLING slot anyway, and
            // both backends are level-triggered — pipelined bytes arriving
            // mid-handler would otherwise make wait() return the same
            // readable event instantly every tick (100% CPU for the whole
            // handler runtime). drainCompletions re-arms on attach; the
            // 504 sweep path deliberately does NOT (it always closes).
            self.loop.delRead(c.fd);
            return false;
        }

        // Dispatch under a per-request arena: everything the handler
        // (and serialization) allocates through the implicit context
        // dies with the request — response bytes survive because
        // serialize copies them into ownAlloc inside the push scope.
        // Serialize while the request views are still valid (the body
        // may reference the read buffer), THEN drop the served bytes —
        // writeMore's pipelining check must see only the remainder —
        // and only then start sending (memmove, overlap-safe).
        // (The handler field must be loaded — `self.handler(...)` would
        // be parsed as a dot-call on a function named `handler`.)
        h := self.handler;
        resp : Response = .{};
        reqArena := Arena.init(self.ownAlloc, 65536);
        push .{ allocator = reqArena } {
            h(*req, *resp, self.ctx);
            encoding := prepareContentEncoding(*req, *resp,
                self.cfg.compressResponses, self.cfg.compressMinSize,
                self.cfg.compressLevel, context.allocator);
            // HEAD runs the handler like GET; serialization suppresses
            // the body bytes (and never drives a stream producer).
            self.serializeResponse(slot, *resp, keep, isHead, encoding);
        }
        reqArena.deinit();
        // A real request produced a response and begins sending: count it
        // served (inline path, loop thread). The pooled path counts in
        // drainCompletions instead — never inside the worker.
        self.stRequests += 1;
        rest := c.readLen - total;
        if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[total], rest); }
        c.readLen = rest;
        c.resetParse();   // the next pipelined request now starts at 0
        self.writeMore(slot);
        return true;
    }

    // ── response serialization + write continuation ──────────────────

    // Build the response bytes into the slot's out buffer. Does NOT
    // start sending — tryServeOne compacts the read buffer between
    // serialization and the first write (see the ordering note there).
    // Set up a chunked stream on the slot. outBuf becomes ONE bounded
    // scratch (≥ STREAM_BUF_CAP) that first carries the response head, then
    // is refilled one chunk-framed piece at a time by writeMore pulling the
    // producer. Memory stays bounded regardless of total body size.
    // make the slot's persistent write buffer hold at least `need`
    // bytes (rounded up to a 4 KB multiple; grown via ownAlloc, retained
    // across requests and connections, freed only by Server.close).
    ensureWbuf :: (self: *Server, slot: i64, need: i64) {
        c := *self.conns[slot];
        if c.wbufCap >= need { return; }
        want := ((need + 4095) / 4096) * 4096;
        if c.wbuf != null { self.ownAlloc.deallocBytes(c.wbuf); }
        c.wbuf = self.ownAlloc.alloc(u8, want).ptr;
        c.wbufCap = want;
    }

    startStream :: (self: *Server, slot: i64, resp: *Response, keep: bool, encoding: Encoding) -> bool {
        c := *self.conns[slot];
        encoded : *EncodedProducer = null;
        if encoding != .identity {
            encoded = createEncodedProducer(encoding,
                self.cfg.compressLevel, resp.producer, resp.producerCtx,
                self.ownAlloc);
            if encoded == null { return false; }
        }
        // The scratch must hold the head's first staging AND every later
        // chunk-framed piece (≤ STREAM_BUF_CAP). Size it to the larger so a
        // pathologically large header block still fits its one-time staging.
        // the head is written straight into the scratch (one pass, no
        // intermediate allocation). The scratch stays a per-stream owned
        // allocation — freed at stream end — NOT the persistent wbuf, whose
        // cap would otherwise be held hostage by streamRefill's layout.
        date := self.dateNow();
        hl := respHeadLen(resp, keep, date, self.cfg.serverName, false, true);
        cap := STREAM_BUF_CAP;
        if hl > cap { cap = hl; }
        raw := self.ownAlloc.allocBytes(cap);
        if raw == null {
            if encoded != null { destroyEncodedProducer(encoded, self.ownAlloc); }
            return false;
        }
        sb : [*]u8 = raw.([*]u8);
        w := respHeadWrite(resp, keep, date, self.cfg.serverName, false, true, sb);
        c.outBuf = sb;
        c.outLen = w;
        c.outSent = 0;
        c.outOwned = true;
        c.closeAfter = !keep;
        c.streaming = true;
        c.producer = resp.producer;
        c.producerCtx = resp.producerCtx;
        c.encodedProducer = encoded;
        c.streamOff = 0;
        c.streamDone = false;
        true
    }

    // `headOnly` = the request was HEAD — suppress body bytes (and
    // never drive a stream producer) while keeping the GET-equivalent
    // headers. A 204/304 status suppresses the body independently of the
    // method and wins over a contradictory stream() call.
    // the inline paths serialize into the slot's persistent wbuf
    // (outOwned = false) — zero per-response allocations on the fast path.
    serializeResponse :: (self: *Server, slot: i64, resp: *Response, keep: bool, headOnly: bool, encoding: Encoding) {
        c := *self.conns[slot];
        noBody := resp.status == 204 or resp.status == 304;
        if resp.streamed and resp.producer != null and !headOnly and !noBody {
            if self.startStream(slot, resp, keep, encoding) { return; }
            // Encoder initialization failed before any bytes were staged.
            // Replace the response atomically with an identity 500.
            resp.* = Response{ status = 500, body = reasonFor(500), allowCompression = false };
        }
        date := self.dateNow();
        if resp.streamed and resp.producer != null and headOnly and !noBody {
            // HEAD of a streamed response: the chunked head ALONE is the
            // whole response — the producer is never pulled, no chunk and
            // no terminator is emitted (c.streaming stays false).
            hl := respHeadLen(resp, keep, date, self.cfg.serverName, false, true);
            self.ensureWbuf(slot, hl);
            c.outLen = respHeadWrite(resp, keep, date, self.cfg.serverName, false, true, c.wbuf);
            c.outBuf = c.wbuf;
            c.outSent = 0;
            c.outOwned = false;
            c.closeAfter = !keep;
            c.streaming = false;
            return;
        }
        hl := respHeadLen(resp, keep, date, self.cfg.serverName, noBody, false);
        bodyLen : i64 = if headOnly or noBody then 0 else resp.body.len;
        self.ensureWbuf(slot, hl + bodyLen);
        w := respHeadWrite(resp, keep, date, self.cfg.serverName, noBody, false, c.wbuf);
        if bodyLen > 0 { clib.memcpy(*c.wbuf[w], resp.body.ptr, bodyLen); }
        c.outBuf = c.wbuf;
        c.outLen = w + bodyLen;
        c.outSent = 0;
        c.outOwned = false;
        c.closeAfter = !keep;
        c.streaming = false;
    }

    // Attach every queued pool completion to its connection: drop the
    // served request bytes, take the response, start writing. A
    // completion whose generation no longer matches (the conn was
    // closed by Server.close) just frees its bytes.
    drainCompletions :: (self: *Server) {
        if self.ps == null { return; }
        ps := self.ps;
        ps.mu.lock();
        n := ps.doneLen;
        ps.doneLen = 0;
        // copy out under the lock; the list is small (<= backlog + workers).
        // Scratch buffer from ownAlloc (thread-safe, and freed below) —
        // not context.allocator, which would both depend on a transient
        // scope and leak (this buffer must be reclaimed every drain).
        batch : [*]Completion = self.ownAlloc.allocBytes(if n > 0 then n * @sizeOf(Completion) else 8).([*]Completion);
        i : i64 = 0;
        while i < n {
            batch[i] = ps.done[i];
            i += 1;
        }
        ps.mu.unlock();

        i = 0;
        while i < n {
            done := batch[i];
            i += 1;
            c := *self.conns[done.slot];
            if (c.state != CONN_HANDLING and c.state != CONN_BODY) or c.gen != done.gen {
                if done.out.buf != null { self.ownAlloc.deallocBytes(done.out.buf); }
                // the conn died before attach — abort the feeder (the
                // worker may still be pumping) and drop the conn-side ref.
                if done.ochan != null {
                    done.ochan.abort();
                    done.ochan.release();
                }
                continue;
            }
            // The worker could not allocate even the response head. No bytes
            // escaped, so drop the completion and close the connection.
            if done.out.buf == null {
                if done.ochan != null { done.ochan.abort(); done.ochan.release(); }
                self.emit(EventKind.WRITE_FAULT, done.slot, 0);
                self.connClose(done.slot);
                continue;
            }
            // EARLY RESPONSE: the handler answered while the body was
            // still streaming (CONN_BODY). The inbound stream is unfinished
            // — it can never pipeline: stop reading, discard the buffered
            // framing, fault the channel (harmless — the worker already
            // returned) and force close-after-response (linger: the client
            // is likely still uploading). The worker already serialized
            // Connection: close (the reader never drained — see
            // runHandlerJob's keep downgrade).
            early := c.state == CONN_BODY;
            if early {
                if c.bodyParked {
                    c.bodyParked = false;
                    self.bodyParkedN -= 1;
                } else {
                    self.loop.delRead(c.fd);
                }
                c.readLen = 0;
                c.resetParse();
                c.bodyMode = 0;
                c.lingerClose = true;
            }
            // the conn's channel reference is done either way — a
            // normal completion follows bodyEof (channel already finished);
            // the early path faults it first.
            if c.bchan != null {
                if early { c.bchan.finish(true); }
                c.bchan.release();
                c.bchan = null;
            }
            // 0.2: re-arm the read watch parked at dispatch (pipelined bytes
            // may be waiting in the kernel buffer; without this the conn
            // would sit deaf until the keepalive deadline evicted it). A
            // re-arm failure means the fd is unusable — drop the connection
            // and this completion's bytes. (Early-response conns must NOT
            // re-arm: inbound is discard-only until the linger close.)
            if !early {
                rae := false;
                self.loop.addRead(c.fd, done.slot.(usize)) catch { rae = true; };
                if rae {
                    self.ownAlloc.deallocBytes(done.out.buf);
                    // the chan is NOT attached yet, so the
                    // connClose below cannot see it — abort + release here
                    // or the pumping worker blocks until Server.close and
                    // the chan (struct + 64 KB) leaks.
                    if done.ochan != null {
                        done.ochan.abort();
                        done.ochan.release();
                    }
                    self.emit(EventKind.READ_FAULT, done.slot, 0);
                    self.connClose(done.slot);
                    continue;
                }
            }
            if done.streamed {
                // Chunked: stage the worker-built head into a bounded scratch
                // and wire up the worker-fed channel — the loop never
                // runs producer code; writeMore pulls the body from there.
                // Free the worker's head buffer once copied.
                cap := STREAM_BUF_CAP;
                if done.out.len > cap { cap = done.out.len; }
                raw := self.ownAlloc.allocBytes(cap);
                if raw == null {
                    self.ownAlloc.deallocBytes(done.out.buf);
                    if done.ochan != null { done.ochan.abort(); done.ochan.release(); }
                    self.emit(EventKind.WRITE_FAULT, done.slot, 0);
                    self.connClose(done.slot);
                    continue;
                }
                sb : [*]u8 = raw.([*]u8);
                clib.memcpy(sb, done.out.buf, done.out.len);
                self.ownAlloc.deallocBytes(done.out.buf);
                c.outBuf = sb;
                c.outLen = done.out.len;
                c.outSent = 0;
                c.outOwned = true;   // per-stream scratch, freed at stream end
                c.closeAfter = done.closeAfter;
                c.streaming = true;
                c.ochan = done.ochan;
                c.producer = null;
                c.producerCtx = 0;
                c.streamOff = 0;
                c.streamDone = false;
            } else {
                c.outBuf = done.out.buf;
                c.outLen = done.out.len;
                c.outSent = 0;
                c.outOwned = true;   // worker-allocated, freed when sent
                c.closeAfter = done.closeAfter;
                c.streaming = false;
            }
            // Count the request served HERE — on the loop thread, as its
            // completion is drained — not inside the worker (avoids a
            // cross-thread counter bump). A stale completion (slot recycled)
            // was already skipped above and is not counted.
            self.stRequests += 1;
            // drop the served bytes (memmove — overlap-safe, and the
            // kernel-grade copy beats a byte loop on multi-KB pipelines)
            rest := c.readLen - done.consumed;
            if rest > 0 { clib.memmove(c.readBuf, *c.readBuf[done.consumed], rest); }
            c.readLen = rest;
            c.resetParse();   // the next pipelined request now starts at 0
            c.state = CONN_READING;
            self.setDeadline(done.slot, self.cfg.timeoutRequestMs);
            self.writeMore(done.slot);
        }
        self.ownAlloc.deallocBytes(batch);
    }

    // Refill the streaming scratch (outBuf) with the next chunk —
    // up to STREAM_PIECE body bytes, framed as `<hexlen>\r\n<data>\r\n`.
    // a pool-mode stream (c.ochan != null) TAKES the bytes from the
    // worker-fed channel — nonblocking; an empty-but-running channel
    // returns false with NOTHING staged (the caller pauses the drain; the
    // worker's next feed wakes the loop). The inline path still pulls the
    // producer directly (the loop IS the handler thread there). End of
    // body stages the terminating `0\r\n\r\n` and marks streamDone.
    // Returns true iff something was staged. Memory is bounded: outBuf is
    // one STREAM_BUF_CAP scratch reused every refill.
    streamRefill :: (self: *Server, slot: i64) -> i64 {
        c := *self.conns[slot];
        if c.streamDone { return 0; }
        // Stage the chunk header room at the front, data after it, then the
        // trailing CRLF — but the header length is variable (hex digits), so
        // produce data into a known offset and assemble. Layout in outBuf:
        //   [hexlen]\r\n[data...]\r\n
        // Reserve up to 16 hex digits; we know the count after producing.
        // Produce into a temp region past the max header to avoid a second
        // copy: data goes at offset 18 (16 hex + CRLF), then we shift the
        // header to butt against it. Simpler: produce data at a fixed data
        // offset, write the exact header before it (right-aligned), and set
        // outBuf/outLen to the contiguous framed span.
        DATA_OFF :: 18;   // 16 hex digits + "\r\n"
        produced : i64 = 0;
        if c.ochan != null {
            n, takeStatus := c.ochan.take(*c.outBuf[DATA_OFF], STREAM_PIECE);
            if n == 0 and takeStatus == .pending { return 0; }
            if n == 0 and takeStatus == .producerFault { return -1; }
            produced = n;
            // channel progress refreshes the delivery deadline — a
            // PROGRESSING worker-paced stream must outlive one fixed
            // window; a stalled one still dies at the stall bound.
            self.setDeadline(slot, self.cfg.timeoutRequestMs);
        } else if c.encodedProducer != null {
            failed := false;
            step := c.encodedProducer.next(string{ ptr = *c.outBuf[DATA_OFF], len = STREAM_PIECE }) catch {
                failed = true;
                EncodedProduceStep{}
            };
            if failed { return -1; }
            if step.status == .pending {
                // Re-enter on the next loop turn, not recursively in this
                // writable drain. This bounds cooperative work per tick.
                self.loop.wake();
                return 0;
            }
            if step.status == .data { produced = step.produced; }
        } else {
            produced = c.producer(c.producerCtx, c.streamOff, *c.outBuf[DATA_OFF], STREAM_PIECE);
            if produced < 0 or produced > STREAM_PIECE { return -1; }
        }
        if produced == 0 {
            // terminating zero chunk: "0\r\n\r\n"
            c.outBuf[0] = '0';
            c.outBuf[1] = '\r'; c.outBuf[2] = '\n';
            c.outBuf[3] = '\r'; c.outBuf[4] = '\n';
            c.outLen = 5;
            c.outSent = 0;
            c.streamDone = true;
            return 1;
        }
        c.streamOff += produced;
        // header: hex(produced) + CRLF, right-aligned so it butts against
        // DATA_OFF. hdr_digits in [1..16].
        hbuf : [16]u8 = ---;
        hdig := hexLenInto(produced, *hbuf[0]);
        hstart := DATA_OFF - 2 - hdig;   // header begins here
        m : i64 = 0;
        while m < hdig { c.outBuf[hstart + m] = hbuf[m]; m += 1; }
        c.outBuf[hstart + hdig] = '\r';
        c.outBuf[hstart + hdig + 1] = '\n';
        // trailing CRLF after the data
        c.outBuf[DATA_OFF + produced] = '\r';
        c.outBuf[DATA_OFF + produced + 1] = '\n';
        // the framed span starts at hstart and runs to data end + CRLF; we
        // drain it relative to outBuf, so shift outBuf's logical base by
        // tracking outSent from hstart. Use outSent as an absolute index
        // into outBuf and outLen as the absolute end.
        c.outSent = hstart;
        c.outLen = DATA_OFF + produced + 2;
        return 1;
    }

    writeMore :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        while true {
            while c.outSent < c.outLen {
                nq, we := self.connWrite(slot, *c.outBuf[c.outSent], c.outLen - c.outSent);
                if we == .WouldBlock {
                    // a TLS write that wants READABILITY must not arm
                    // the write watch (connWrite already dropped it) — the
                    // read watch delivers the retry.
                    if !c.writeArmed and !c.tlsWrWantRead {
                        awe := false;
                        self.loop.addWrite(c.fd, slot.(usize)) catch { awe = true; };
                        if awe {                             // arming the write watch failed
                            self.emit(EventKind.WRITE_FAULT, slot, 0);
                            self.connClose(slot);
                            return;
                        }
                        c.writeArmed = true;
                    }
                    c.state = CONN_WRITING;
                    return;
                }
                if we {                                       // write faulted
                    self.emit(EventKind.WRITE_FAULT, slot, 0);
                    self.connClose(slot);
                    return;
                }
                self.stBytesOut += nq;
                c.outSent += nq;
            }
            // current buffer fully sent. If streaming and not yet terminated,
            // refill with the next chunk and keep draining (bounded memory).
            if c.streaming and !c.streamDone {
                refilled := self.streamRefill(slot);
                if refilled > 0 { continue; }
                if refilled < 0 {
                    self.emit(EventKind.WRITE_FAULT, slot, 0);
                    self.connClose(slot);
                    return;
                }
                // the worker-fed channel is empty but still running —
                // pause the drain until the feed wakes the loop. Drop the
                // write watch: a level-triggered writable with nothing
                // staged would spin the loop. (unless a blocked TLS
                // READ owns the cross-armed watch — its retry needs it.)
                if c.writeArmed and !c.tlsRdWantWrite {
                    self.loop.delWrite(c.fd);
                    c.writeArmed = false;
                }
                c.state = CONN_WRITING;
                if !c.streamWaiting {
                    c.streamWaiting = true;
                    self.streamWaitingN += 1;
                }
                return;
            }
            break;
        }
        // fully sent (and, if streamed, the zero chunk is out)
        c.streaming = false;
        c.producer = null;
        c.streamOff = 0;
        c.streamDone = false;
        if c.encodedProducer != null {
            destroyEncodedProducer(c.encodedProducer, self.ownAlloc);
            c.encodedProducer = null;
        }
        // the stream is over — drop the conn's channel reference (the
        // worker released its side when the pump ended).
        if c.ochan != null {
            c.ochan.release();
            c.ochan = null;
        }
        // keep the watch when a blocked TLS read cross-armed it.
        if c.writeArmed and !c.tlsRdWantWrite {
            self.loop.delWrite(c.fd);
            c.writeArmed = false;
        }
        // free only per-response buffers (pool attach, stream
        // scratch); the persistent wbuf is reused by the next response.
        if c.outOwned { self.ownAlloc.deallocBytes(c.outBuf); }
        c.outBuf = null;
        c.outOwned = true;
        c.outLen = 0;
        c.outSent = 0;
        if c.closeAfter {
            // an error close lingers (SHUT_WR + drain-and-discard) so
            // the just-sent error response survives instead of being RST-
            // killed by close-with-unread-data. Normal closes stay abrupt.
            if c.lingerClose and self.cfg.lingerTimeoutMs > 0 {
                self.beginLinger(slot);
                return;
            }
            self.connClose(slot);
            return;
        }
        if c.readLen > 0 {
            // pipelined bytes already buffered: keep serving
            c.state = CONN_READING;
            self.setDeadline(slot, self.cfg.timeoutRequestMs);
            self.serveBuffered(slot);
            return;
        }
        c.state = CONN_KEEPALIVE;
        self.setDeadline(slot, self.cfg.timeoutKeepaliveMs);
    }

    // ── lingering close ─────────────────────────────────────────

    // Enter CONN_LINGER once an error response has fully drained: FIN our
    // side (shutdown SHUT_WR — the kernel delivers the response, then the
    // FIN, never an RST), re-arm the read watch (the 0.3 flood guard may
    // have parked it), and discard whatever the client still sends until
    // EOF or the linger deadline. The slot owes nothing — beginStop and
    // the force-close path may drop it at any time.
    beginLinger :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        // Linger discards RAW bytes — any pending TLS
        // want is moot, and a surviving cross-armed write watch would spin
        // against the CONN_LINGER arm (which ignores writable) until the
        // linger deadline.
        self.tlsWantDrop(slot);
        socket.shutdown(c.fd, socket.SHUT_WR);
        are := false;
        self.loop.addRead(c.fd, slot.(usize)) catch { are = true; };
        if are {   // can't watch the fd: fall back to the abrupt close
            self.connClose(slot);
            return;
        }
        c.state = CONN_LINGER;
        c.readLen = 0;
        c.resetParse();
        self.setDeadline(slot, self.cfg.lingerTimeoutMs);
        // Level-triggered: bytes that arrived before the re-arm are
        // reported on the next wait; drain what is already queued now.
        self.lingerDrain(slot);
    }

    // Discard inbound bytes on a lingering conn. EOF (or any read fault)
    // ends the linger — the client has seen our FIN + response by then.
    lingerDrain :: (self: *Server, slot: i64) {
        c := *self.conns[slot];
        scratch : [4096]u8 = ---;
        while true {
            nq, re := socket.readNb(c.fd, *scratch[0], 4096);
            if re == .WouldBlock { return; }   // the socket is drained
            if re {                                 // EOF / reset: done
                self.connClose(slot);
                return;
            }
            // nq bytes discarded; keep draining
            if nq == 0 { return; }
        }
    }

    // A terminal error response: serialize, send, close when done.
    // Same arena discipline as dispatch — serialization concats must
    // not accumulate in the long-lived loop context.
    respondErrorClose :: (self: *Server, slot: i64, status: i64) {
        // Classify + surface before sending. 503 is backpressure (its own
        // event + counter); every other 4xx/5xx here is a parser/client or
        // server rejection (PARSE_ERROR, status in detail). All on the loop
        // thread — this is only ever called from the parse/read paths.
        if status == 503 {
            self.stRejected += 1;
            self.st5xx += 1;
            self.emit(EventKind.REJECTED_503, slot, status);
        } else {
            if status >= 400 and status < 500 { self.st4xx += 1; }
            else if status >= 500 { self.st5xx += 1; }
            self.emit(EventKind.PARSE_ERROR, slot, status);
        }
        self.sendErrorClose(slot, status);
    }

    // The un-classified tail of respondErrorClose (also used by the
    // 408 eviction path, which classifies as a TIMEOUT, not a PARSE_ERROR):
    // serialize the status + reason, discard buffered request bytes, mark
    // the close as an error close (lingers), refresh the delivery window so
    // the error itself has time to drain (the 408 path arrives here with an
    // already-expired deadline), send.
    sendErrorClose :: (self: *Server, slot: i64, status: i64) {
        resp : Response = .{ status = status, body = reasonFor(status) };
        self.conns[slot].readLen = 0;
        self.conns[slot].resetParse();
        // error closes linger so the response above actually lands.
        self.conns[slot].lingerClose = true;
        self.setDeadline(slot, self.cfg.timeoutRequestMs);
        errArena := Arena.init(self.ownAlloc, 4096);
        push .{ allocator = errArena } {
            // headOnly=false: an error reply may not know the method (the
            // request line can be the malformed part) — the tiny reason body
            // ships even to a HEAD; safe, since error closes never pipeline.
            self.serializeResponse(slot, *resp, false, false, .identity);
        }
        errArena.deinit();
        self.writeMore(slot);
    }
}
