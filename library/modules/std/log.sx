@import "modules/std/core.sx";
@import "modules/std/fmt.sx";
@import "modules/std/writer.sx";

// =====================================================================
// log.sx — plain leveled logging, orthogonal to the
// error channel. Each entry is written to stderr as `LEVEL: <msg>\n`,
// where <msg> is the formatted `fmt` + args (same `{}` interpolation as
// `print`). Sink is stderr (fd 2) so log output stays out of a program's
// stdout data stream. A line carries no timestamp: the level and the message
// are the whole record, which keeps goldens time-independent.
// =====================================================================

// Prefix the level, append a newline, write the whole line to stderr.
logEmit :: (level: string, msg: string) {
    w := FdWriter.init(.stderr);
    w.write(level);
    w.write(msg);
    w.write("\n");
}

warn  :: ($fmt: string, ..$args) { sb := StringBuilder.init(); @insert buildFormat(fmt, "sb"); sb.flush(); logEmit("WARN:  ", sb.finish()); }
info  :: ($fmt: string, ..$args) { sb := StringBuilder.init(); @insert buildFormat(fmt, "sb"); sb.flush(); logEmit("INFO:  ", sb.finish()); }
debug :: ($fmt: string, ..$args) { sb := StringBuilder.init(); @insert buildFormat(fmt, "sb"); sb.flush(); logEmit("DEBUG: ", sb.finish()); }
err   :: ($fmt: string, ..$args) { sb := StringBuilder.init(); @insert buildFormat(fmt, "sb"); sb.flush(); logEmit("ERROR: ", sb.finish()); }
