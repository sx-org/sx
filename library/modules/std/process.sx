process :: scope {
    @import "modules/std/core.sx";
    @import "modules/std/fmt.sx";
    @import "modules/std/mem.sx";
    @import "modules/std/writer.sx";
    @import "modules/std/c.sx";
    @import "modules/std/posix.sx";
    @import "modules/std/trace.sx";

    libc :: c.libc;

    popen  :: (cmd: [*:0]u8, mode: [*:0]u8) -> *void extern libc;
    pclose :: (stream: *void) -> i32 extern libc;
    fread  :: (ptr: [*]u8, size: i64, nmemb: i64, stream: *void) -> usize extern libc;
    feof   :: (stream: *void) -> i32 extern libc;
    getenv :: (name: [*:0]u8) -> ?[*:0]u8 extern libc;
    system :: (cmd: [*:0]u8) -> i32 extern libc;

    ProcessResult :: struct {
        exitCode: i32;
        stdout:   string;
    }

    // cmd is interpreted by /bin/sh; callers quote shell metacharacters.
    // Null means popen or pclose failed.
    run :: (cmd: string) -> ?ProcessResult {
        z := mem.cloneZ(cmd);
        defer mem.free(z);
        f := popen(z, "r");
        if f == null { return null; }

        sb := StringBuilder.init();
        buf : [4096]u8 = ---;
        while true {
            n := fread(*buf[0], 1, 4096, f);
            if n == 0 { break; }
            sb.write(buf[0 .. n]);
        }
        out := sb.finish();
        rawStatus := pclose(f);
        if rawStatus < 0 {
            mem.free(out);
            return null;
        }
        ProcessResult{ exitCode = decodeStatus(rawStatus), stdout = out }
    }

    // Signal deaths use the shell convention, 128 + signal.
    decodeStatus :: (raw: i32) -> i32 {
        code := (raw >> 8) & 0xFF;
        sig := raw & 0x7F;
        if code == 0 and sig != 0 { return 128.(i32) + sig; }
        code
    }

    // Copy getenv's buffer because setenv can invalidate it.
    env :: (name: string) -> ?string {
        z := mem.cloneZ(name);
        defer mem.free(z);
        p := getenv(z);
        if p == null { return null; }
        mem.clone(p[0..])
    }

    // name must be shell-safe for command -v.
    findExecutable :: (name: string) -> ?string {
        cmd := concat("command -v ", name);
        if r := run(cmd) {
            if r.exitCode != 0 { return null; }
            out := r.stdout;
            if out.len > 0 {
                if out[out.len - 1] == '\n' { out = out[0 .. out.len - 1]; }
            }
            if out.len == 0 { return null; }
            return out;
        }
        null
    }

    O_RDWR     :i32: 2;
    FD_CLOEXEC :i32: 1;
    F_GETFD    :i32: 1;
    F_SETFD    :i32: 2;
    WNOHANG    :i32: 1;
    SIGKILL    :i32: 9;
    SIGPIPE    :i32: 13;
    SIGTERM    :i32: 15;
    SIG_IGN    :usize: 1;

    inline match @host.os {
        case .macos:   F_DUPFD_CLOEXEC :i32: 67;
        case .ios:     F_DUPFD_CLOEXEC :i32: 67;
        case .linux:   F_DUPFD_CLOEXEC :i32: 1030;
        case .android: F_DUPFD_CLOEXEC :i32: 1030;
        case .wasm:    F_DUPFD_CLOEXEC :i32: 1030;
        else:          @error("std/process.sx: F_DUPFD_CLOEXEC is only known for Darwin (67) and Linux/Android/Emscripten (1030) — add a case for this target.");
    }

    Stdio :: enum {
        inherit;
        pipe;
        null;
    }

    // Cwd and Exec: the child cannot enter opts.cwd or exec argv[0]. spawn has reaped
    // it, and posix.errno() reads the errno of its failed chdir or execvp.
    SpawnErr :: error { EmptyArgv; Pipe; Fork; Cwd; Exec }

    SpawnOpts :: struct {
        stdin:  Stdio = .inherit;
        stdout: Stdio = .inherit;
        stderr: Stdio = .inherit;
        // The child's working directory; null keeps the caller's.
        cwd:    ?string = null;
        // Overlaid on the caller's environment: NAME=value sets NAME, a bare NAME unsets
        // it, and the last entry naming a variable wins. argv[0]'s PATH search uses the result.
        env:    ?[]string = null;
    }

    // Ends with a null pointer; glibc's and musl's clearenv set environ itself to null.
    environ : ?[*]?[*:0]u8 extern;

    // A forked child that cannot run argv[0] reports the failed step and its errno.
    ChildStep :: enum i32 { cwd; exec; }
    ChildFailure :: struct {
        step:  ChildStep;
        errno: i32;
    }

    // A reaped pid and closed or unpiped descriptors are -1.
    Child :: struct {
        pid:    i32 = -1;
        stdin:  i32 = -1;
        stdout: i32 = -1;
        stderr: i32 = -1;
        status: ?i32 = null;

        stdinWrite :: (self: *Child, line: []u8) -> isize {
            return c.write(self.stdin, line.ptr, line.len);
        }
        stdoutRead :: (self: *Child, buf: []u8) -> isize {
            return c.read(self.stdout, buf.ptr, buf.len);
        }
        stderrRead :: (self: *Child, buf: []u8) -> isize {
            return c.read(self.stderr, buf.ptr, buf.len);
        }

        stdinClose :: (self: *Child) {
            if self.stdin >= 0 { c.close(self.stdin); self.stdin = -1; }
        }
        stdoutClose :: (self: *Child) {
            if self.stdout >= 0 { c.close(self.stdout); self.stdout = -1; }
        }
        stderrClose :: (self: *Child) {
            if self.stderr >= 0 { c.close(self.stderr); self.stderr = -1; }
        }

        // kill(-1, sig) broadcasts; kill(0, sig) targets the process group.
        kill :: (self: *Child, sig: i32) -> i32 {
            if self.pid <= 0 { return -1; }
            return c.kill(self.pid, sig);
        }

        // A reaped child answers from stored status because the kernel reuses pids.
        wait :: (self: *Child, block: bool) -> ?i32 {
            if self.pid <= 0 { return self.status; }
            options : i32 = if block then 0 else WNOHANG;
            raw : i32 = 0;
            while true {
                r := c.waitpid(self.pid, *raw, options);
                if r == self.pid {
                    self.status = decodeStatus(raw);
                    self.pid = -1;
                    return self.status;
                }
                if r == 0 { return null; }
                if posix.errno() != posix.EINTR { return null; }
            }
            return null;
        }
    }

    // Call from one thread: pipe + FD_CLOEXEC is not atomic with a concurrent fork.
    // spawn returns once the child has exec'd argv[0]; the caller must reap it with wait.
    spawn :: (argv: []string, opts: SpawnOpts = .{}) -> (Child, !SpawnErr) {
        if argv.len == 0 { raise .EmptyArgv; }

        // Runs after the deferred cleanup below, so no libc call overwrites the child's errno.
        childErrno : ?i32 = null;
        defer { if n := childErrno { posix.setErrno(n); } }

        vec : [*]?[*:0]u8 = mem.alloc(context.allocator, ?[*:0]u8, argv.len + 1).ptr;
        i := 0;
        while i < argv.len {
            vec[i] = mem.cloneZ(argv[i]);
            i += 1;
        }
        vec[argv.len] = null;
        file := vec[0]?!;
        cwdZ : ?[:0]u8 = null;
        if dir := opts.cwd { cwdZ = mem.cloneZ(dir); }
        envp : ?[]?[*:0]u8 = null;
        if vars := opts.env { envp = childEnv(vars); }

        // child ends map to standard slots; parent ends belong to the returned Child.
        child  : [3]i32 = .[-1, -1, -1];
        parent : [3]i32 = .[-1, -1, -1];
        handedOff := false;
        defer {
            s := 0;
            while s < 3 {
                if child[s] >= 0 { c.close(child[s]); }
                if !handedOff and parent[s] >= 0 { c.close(parent[s]); }
                s += 1;
            }
            freeArgv(vec, argv.len);
            if dir := cwdZ { mem.free(dir); }
            if p := envp { freeArgv(p.ptr, p.len); }
        }

        slot := 0;
        while slot < 3 {
            mode := opts.stdin;
            if slot == 1 { mode = opts.stdout; }
            if slot == 2 { mode = opts.stderr; }
            if mode == .pipe {
                fds : [2]c.Fd = ---;
                if c.pipe(*fds) != 0 { raise .Pipe; }
                if !setCloexec(fds[0]) or !setCloexec(fds[1]) {
                    c.close(fds[0]);
                    c.close(fds[1]);
                    raise .Pipe;
                }
                if slot == 0 {
                    child[0] = fds[0];
                    parent[0] = fds[1];
                } else {
                    child[slot] = fds[1];
                    parent[slot] = fds[0];
                }
            }
            if mode == .null {
                fd := c.open("/dev/null", O_RDWR);
                if fd < 0 { raise .Pipe; }
                if !setCloexec(fd) { c.close(fd); raise .Pipe; }
                child[slot] = fd;
            }
            slot += 1;
        }

        // Lift pipe ends above 0/1/2 so dup2 cannot overwrite another source or retain CLOEXEC.
        slot = 0;
        while slot < 3 {
            if child[slot] >= 0 and !liftAboveStdio(*child[slot]) { raise .Pipe; }
            slot += 1;
        }

        // The child writes a ChildFailure to report, lifted clear of the dup2 targets;
        // a successful exec closes it instead.
        reportPipe : [2]c.Fd = ---;
        if c.pipe(*reportPipe) != 0 { raise .Pipe; }
        defer c.close(reportPipe[0]);
        report : i32 = reportPipe[1];
        if !setCloexec(reportPipe[0]) or !setCloexec(report) or !liftAboveStdio(*report) {
            c.close(report);
            raise .Pipe;
        }

        pid := c.fork();
        // Only async-signal-safe calls: allocator locks may belong to threads absent in the child.
        if pid == 0 {
            if child[0] >= 0 { c.dup2(child[0], 0); }
            if child[1] >= 0 { c.dup2(child[1], 1); }
            if child[2] >= 0 { c.dup2(child[2], 2); }
            if dir := cwdZ {
                if c.chdir(dir) != 0 { failChild(report, .cwd); }
            }
            if p := envp { environ = p.ptr; }
            c.execvp(file, vec);
            failChild(report, .exec);
        }
        c.close(report);
        if pid < 0 { raise .Fork; }

        failure : ChildFailure = ---;
        got : isize = 0;
        while true {
            got = c.read(reportPipe[0], @reinterpret([*]u8, *failure), @sizeOf(ChildFailure));
            if got >= 0 or posix.errno() != posix.EINTR { break; }
        }
        if got == @sizeOf(ChildFailure) {
            raw : i32 = 0;
            while c.waitpid(pid, *raw, 0) < 0 and posix.errno() == posix.EINTR {}
            childErrno = failure.errno;
            if failure.step == .cwd { raise .Cwd; }
            raise .Exec;
        }

        handedOff = true;
        return Child{ pid = pid, stdin = parent[0], stdout = parent[1], stderr = parent[2] };
    }

    // SIGPIPE disposition is process-wide.
    ignoreSigpipe :: () {
        c.signal(SIGPIPE, SIG_IGN);
    }

    setCloexec :: (fd: i32) -> bool {
        return c.fcntl(fd, F_SETFD, FD_CLOEXEC) >= 0;
    }

    // Moves a descriptor in 0..2 to the lowest free one above 2, close-on-exec.
    liftAboveStdio :: (fd: *i32) -> bool {
        if fd.* > 2 { return true; }
        lifted := c.fcntl(fd.*, F_DUPFD_CLOEXEC, 3);
        if lifted < 0 { return false; }
        c.close(fd.*);
        fd.* = lifted;
        true
    }

    // Writes step and errno to fd, then exits 127. One write keeps the record whole:
    // a pipe write under PIPE_BUF is atomic.
    failChild :: (fd: i32, step: ChildStep) -> noreturn {
        failure := ChildFailure{ step = step, errno = posix.errno() };
        c.write(fd, @reinterpret([*]u8, *failure), @sizeOf(ChildFailure));
        c.exit(127)
    }

    // The caller's environ overlaid by vars, as SpawnOpts.env describes. The entries are
    // owned copies, and a null pointer follows the last one.
    childEnv :: (vars: []string) -> []?[*:0]u8 {
        inherited : []?[*:0]u8 = .[];
        if all := environ {
            k := 0;
            while all[k] != null { k += 1; }
            inherited = all[0 .. k];
        }
        out := mem.alloc(context.allocator, ?[*:0]u8, inherited.len + vars.len + 1);
        n := 0;
        for e in inherited {
            entry := e?![0..];
            if !namedIn(vars, envName(entry)) { out[n] = mem.cloneZ(entry); n += 1; }
        }
        i := 0;
        while i < vars.len {
            name := envName(vars[i]);
            if name.len < vars[i].len and !namedIn(vars[i + 1 ..], name) { out[n] = mem.cloneZ(vars[i]); n += 1; }
            i += 1;
        }
        out[n] = null;
        out[0 .. n]
    }

    // The text before an entry's first '='; a bare entry is all name.
    envName :: (entry: string) -> string {
        i := 0;
        while i < entry.len and entry[i] != '=' { i += 1; }
        entry[0 .. i]
    }

    // Whether an entry of vars, bare or NAME=value, names the variable name.
    namedIn :: (vars: []string, name: string) -> bool {
        for v in vars { if envName(v) == name { return true; } }
        false
    }

    freeArgv :: (vec: [*]?[*:0]u8, n: i64) {
        i := 0;
        while i < n {
            if p := vec[i] { context.allocator.deallocBytes(p); }
            i += 1;
        }
        context.allocator.deallocBytes(vec);
    }

    // _exit skips defer and stdio cleanup; comptime calls terminate the compiler with a diagnostic.
    exit :: (code: u8, site: @SourceSite = @caller) -> noreturn {
        if @isComptime() {
            print("\nprocess.exit({}) called from {} at {}:{}\n", code, site.declaration, site.file, site.line);
            trace.printInterpreterFrames();
        }
        c.exit(code)
    }

    assert :: (cond: bool, msg: string, site: @SourceSite = @caller) {
        if !cond {
            print("ASSERTION FAILED at {}:{}: {}\n", site.file, site.line, msg);
            exit(1);
        }
    }
}
