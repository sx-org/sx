// QuartzCore layer surfaces shared by the platform host (uikit.sx) and
// the Metal GPU backend (gpu/metal.sx). ONE declaration per runtime
// class: the @ObjcClass registry is name-keyed program-wide, so two
// modules declaring the same class race for the slot and whichever
// loses resolves against the other's method surface.
//
// The Metal-typed ends of CAMetalLayer (device, drawable) are declared
// untyped here — MTLDevice/CAMetalDrawable live in gpu/metal.sx, which
// this module must not import (dependency direction: the GPU backend
// consumes the layer, not the reverse).
@import "modules/ffi/objc.sx";

@framework "QuartzCore";

// The Core Animation clock — the timebase of CADisplayLink timestamps
// and CAAnimation begin times.
CACurrentMediaTime :: () -> f64 extern;

// CGSize is a 2-element f64 HFA. arm64 Apple ABI puts it in d0,d1.
CGSize :: struct { width: f64; height: f64; }

// CGRect is a 4-element f64 HFA: Apple ARM64 keeps it in v0..v3 for
// both the return slot and the argument slot.
CGRect :: struct {
    x: f64;
    y: f64;
    width: f64;
    height: f64;
}

CALayer :: @ObjcClass("CALayer", extends = NSObject) extern {
    setOpaque :: (self: *Self, opaque: i8);
    frame     :: (self: *Self) -> CGRect;
    bounds    :: (self: *Self) -> CGRect;
    setBounds :: (self: *Self, bounds: CGRect);
    setNeedsDisplay :: (self: *Self);
    setNeedsLayout :: (self: *Self);
    layoutIfNeeded :: (self: *Self);
    // The layer's on-screen geometry for the frame being composited; nil
    // where the layer has no presentation yet.
    presentationLayer :: (self: *Self) -> *CALayer;
}

CAEAGLLayer :: @ObjcClass("CAEAGLLayer", extends = CALayer) extern {
    class :: () -> *void;
    setDrawableProperties :: (self: *Self, props: *void);
}

CAMetalLayer :: @ObjcClass("CAMetalLayer", extends = CALayer) extern {
    class :: () -> *void;
    setDevice :: (self: *Self, device: *void);
    setPixelFormat :: (self: *Self, fmt: u64);
    setFramebufferOnly :: (self: *Self, on: BOOL);
    setDrawableSize :: (self: *Self, size: CGSize);
    nextDrawable :: (self: *Self) -> *void;
    // Three drawables: with presentsWithTransaction the present is tied
    // to the commit, so the third buys stall headroom, not latency —
    // two makes nextDrawable block whenever the compositor still holds
    // one, and the blocked frame reads as a judder tick.
    setMaximumDrawableCount :: (self: *Self, n: u64);
    // The drawable commits in the current CATransaction, with the IME
    // keyboard's animation, instead of on a separate present timeline.
    setPresentsWithTransaction :: (self: *Self, on: BOOL);
}
