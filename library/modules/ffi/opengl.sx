// OpenGL 3.3 Core — runtime-loaded function pointers
// No @library needed — caller provides a loader (e.g. SDL_GL_GetProcAddress)

// Constants
GL_FALSE             :i32: 0;
GL_TRUE              :i32: 1;
GL_DEPTH_TEST        :u32: 0x0B71;
GL_CULL_FACE         :u32: 0x0B44;
GL_BLEND             :u32: 0x0BE2;
GL_TRIANGLES         :u32: 4;
GL_LINES             :u32: 1;
GL_FLOAT             :u32: 0x1406;
GL_UNSIGNED_INT      :u32: 0x1405;
GL_VERTEX_SHADER     :u32: 0x8B31;
GL_FRAGMENT_SHADER   :u32: 0x8B30;
GL_COMPILE_STATUS    :u32: 0x8B81;
GL_LINK_STATUS       :u32: 0x8B82;
GL_ARRAY_BUFFER      :u32: 0x8892;
GL_ELEMENT_ARRAY_BUFFER :u32: 0x8893;
GL_STATIC_DRAW       :u32: 0x88E4;
GL_COLOR_BUFFER_BIT  :u32: 0x4000;
GL_DEPTH_BUFFER_BIT  :u32: 0x0100;
GL_FRONT_AND_BACK    :u32: 0x0408;
GL_LINE              :u32: 0x1B01;
GL_FILL              :u32: 0x1B02;

// Function pointer variables (mutable, loaded at runtime)
glClearColor             : (f32, f32, f32, f32) -> void abi(.c) = ---;
glClear                  : (u32) -> void abi(.c) = ---;
glEnable                 : (u32) -> void abi(.c) = ---;
glDisable                : (u32) -> void abi(.c) = ---;
glViewport               : (i32, i32, i32, i32) -> void abi(.c) = ---;
glFlush                  : () -> void abi(.c) = ---;
glDrawArrays             : (u32, i32, i32) -> void abi(.c) = ---;
glPolygonMode            : (u32, u32) -> void abi(.c) = ---;
glLineWidth              : (f32) -> void abi(.c) = ---;
glCreateShader           : (u32) -> u32 abi(.c) = ---;
glShaderSource           : (u32, i32, *[:0]u8, *i32) -> void abi(.c) = ---;
glCompileShader          : (u32) -> void abi(.c) = ---;
glGetShaderiv            : (u32, u32, *i32) -> void abi(.c) = ---;
glGetShaderInfoLog       : (u32, i32, *i32, [*]u8) -> void abi(.c) = ---;
glCreateProgram          : () -> u32 abi(.c) = ---;
glAttachShader           : (u32, u32) -> void abi(.c) = ---;
glLinkProgram            : (u32) -> void abi(.c) = ---;
glGetProgramiv           : (u32, u32, *i32) -> void abi(.c) = ---;
glGetProgramInfoLog      : (u32, i32, *i32, [*]u8) -> void abi(.c) = ---;
glUseProgram             : (u32) -> void abi(.c) = ---;
glDeleteShader           : (u32) -> void abi(.c) = ---;
glGenVertexArrays        : (i32, *u32) -> void abi(.c) = ---;
glGenBuffers             : (i32, *u32) -> void abi(.c) = ---;
glBindVertexArray        : (u32) -> void abi(.c) = ---;
glBindBuffer             : (u32, u32) -> void abi(.c) = ---;
glBufferData             : (u32, isize, *void, u32) -> void abi(.c) = ---;
glVertexAttribPointer    : (u32, i32, u32, u8, i32, *void) -> void abi(.c) = ---;
glEnableVertexAttribArray : (u32) -> void abi(.c) = ---;
glGetUniformLocation     : (u32, [*]u8) -> i32 abi(.c) = ---;
glUniformMatrix4fv       : (i32, i32, u8, [*]f32) -> void abi(.c) = ---;
glUniform3f              : (i32, f32, f32, f32) -> void abi(.c) = ---;
glUniform4fv             : (i32, i32, [*]f32) -> void abi(.c) = ---;
glDepthFunc              : (u32) -> void abi(.c) = ---;
glUniform1f              : (i32, f32) -> void abi(.c) = ---;
GL_LESS                  :u32: 0x0201;
GL_LEQUAL                :u32: 0x0203;
GL_SCISSOR_TEST          :u32: 0x0C11;
GL_DYNAMIC_DRAW          :u32: 0x88E8;
GL_TEXTURE_2D            :u32: 0x0DE1;
GL_TEXTURE_MIN_FILTER    :u32: 0x2801;
GL_TEXTURE_MAG_FILTER    :u32: 0x2800;
GL_NEAREST               :u32: 0x2600;
GL_RGBA                  :u32: 0x1908;
GL_UNSIGNED_BYTE         :u32: 0x1401;
GL_PACK_ALIGNMENT        :u32: 0x0D05;
GL_SRC_ALPHA             :u32: 0x0302;
GL_ONE_MINUS_SRC_ALPHA   :u32: 0x0303;
GL_TEXTURE0              :u32: 0x84C0;
GL_LINEAR                :u32: 0x2601;
GL_RED                   :u32: 0x1903;
GL_R8                    :u32: 0x8229;
GL_UNPACK_ALIGNMENT      :u32: 0x0CF5;

glScissor                : (i32, i32, i32, i32) -> void abi(.c) = ---;
glBufferSubData          : (u32, isize, isize, *void) -> void abi(.c) = ---;
glGenTextures            : (i32, *u32) -> void abi(.c) = ---;
glBindTexture            : (u32, u32) -> void abi(.c) = ---;
glTexImage2D             : (u32, i32, i32, i32, i32, i32, u32, u32, *void) -> void abi(.c) = ---;
glTexParameteri          : (u32, u32, i32) -> void abi(.c) = ---;
glBlendFunc              : (u32, u32) -> void abi(.c) = ---;
glReadPixels             : (i32, i32, i32, i32, u32, u32, *void) -> void abi(.c) = ---;
glActiveTexture          : (u32) -> void abi(.c) = ---;
glUniform1i              : (i32, i32) -> void abi(.c) = ---;
glPixelStorei            : (u32, i32) -> void abi(.c) = ---;
glTexSubImage2D          : (u32, i32, i32, i32, i32, i32, u32, u32, *void) -> void abi(.c) = ---;
glDeleteTextures         : (i32, *u32) -> void abi(.c) = ---;
glDeleteBuffers          : (i32, *u32) -> void abi(.c) = ---;
glDrawElements           : (u32, i32, u32, *void) -> void abi(.c) = ---;
glDepthMask              : (u8) -> void abi(.c) = ---;

glGenFramebuffers              : (i32, *u32) -> void abi(.c) = ---;
glGenRenderbuffers             : (i32, *u32) -> void abi(.c) = ---;
glBindFramebuffer              : (u32, u32) -> void abi(.c) = ---;
glBindRenderbuffer             : (u32, u32) -> void abi(.c) = ---;
glFramebufferRenderbuffer      : (u32, u32, u32, u32) -> void abi(.c) = ---;
glGetRenderbufferParameteriv   : (u32, u32, *i32) -> void abi(.c) = ---;
glCheckFramebufferStatus       : (u32) -> u32 abi(.c) = ---;

GL_TEXTURE_WRAP_S        :u32: 0x2802;
GL_TEXTURE_WRAP_T        :u32: 0x2803;
GL_CLAMP_TO_EDGE         :u32: 0x812F;

// Loader: call once after creating GL context
// Pass in a proc loader (e.g. SDL_GL_GetProcAddress)
load_fn :: (slot: *$T, name: cstring, get_proc: (cstring) -> *void abi(.c)) {
    slot.* = get_proc(name).(T);
}

load_gl :: (get_proc: (cstring) -> *void abi(.c)) {
    load_fn(*glClearColor, "glClearColor", get_proc);
    load_fn(*glClear, "glClear", get_proc);
    load_fn(*glEnable, "glEnable", get_proc);
    load_fn(*glDisable, "glDisable", get_proc);
    load_fn(*glViewport, "glViewport", get_proc);
    load_fn(*glFlush, "glFlush", get_proc);
    load_fn(*glDrawArrays, "glDrawArrays", get_proc);
    load_fn(*glPolygonMode, "glPolygonMode", get_proc);
    load_fn(*glLineWidth, "glLineWidth", get_proc);
    load_fn(*glCreateShader, "glCreateShader", get_proc);
    load_fn(*glShaderSource, "glShaderSource", get_proc);
    load_fn(*glCompileShader, "glCompileShader", get_proc);
    load_fn(*glGetShaderiv, "glGetShaderiv", get_proc);
    load_fn(*glGetShaderInfoLog, "glGetShaderInfoLog", get_proc);
    load_fn(*glCreateProgram, "glCreateProgram", get_proc);
    load_fn(*glAttachShader, "glAttachShader", get_proc);
    load_fn(*glLinkProgram, "glLinkProgram", get_proc);
    load_fn(*glGetProgramiv, "glGetProgramiv", get_proc);
    load_fn(*glGetProgramInfoLog, "glGetProgramInfoLog", get_proc);
    load_fn(*glUseProgram, "glUseProgram", get_proc);
    load_fn(*glDeleteShader, "glDeleteShader", get_proc);
    load_fn(*glGenVertexArrays, "glGenVertexArrays", get_proc);
    load_fn(*glGenBuffers, "glGenBuffers", get_proc);
    load_fn(*glBindVertexArray, "glBindVertexArray", get_proc);
    load_fn(*glBindBuffer, "glBindBuffer", get_proc);
    load_fn(*glBufferData, "glBufferData", get_proc);
    load_fn(*glVertexAttribPointer, "glVertexAttribPointer", get_proc);
    load_fn(*glEnableVertexAttribArray, "glEnableVertexAttribArray", get_proc);
    load_fn(*glGetUniformLocation, "glGetUniformLocation", get_proc);
    load_fn(*glUniformMatrix4fv, "glUniformMatrix4fv", get_proc);
    load_fn(*glUniform3f, "glUniform3f", get_proc);
    load_fn(*glUniform4fv, "glUniform4fv", get_proc);
    load_fn(*glDepthFunc, "glDepthFunc", get_proc);
    load_fn(*glUniform1f, "glUniform1f", get_proc);
    load_fn(*glScissor, "glScissor", get_proc);
    load_fn(*glBufferSubData, "glBufferSubData", get_proc);
    load_fn(*glGenTextures, "glGenTextures", get_proc);
    load_fn(*glBindTexture, "glBindTexture", get_proc);
    load_fn(*glTexImage2D, "glTexImage2D", get_proc);
    load_fn(*glTexParameteri, "glTexParameteri", get_proc);
    load_fn(*glBlendFunc, "glBlendFunc", get_proc);
    load_fn(*glReadPixels, "glReadPixels", get_proc);
    load_fn(*glActiveTexture, "glActiveTexture", get_proc);
    load_fn(*glUniform1i, "glUniform1i", get_proc);
    load_fn(*glPixelStorei, "glPixelStorei", get_proc);
    load_fn(*glTexSubImage2D, "glTexSubImage2D", get_proc);
    load_fn(*glDeleteTextures, "glDeleteTextures", get_proc);
    load_fn(*glDeleteBuffers, "glDeleteBuffers", get_proc);
    load_fn(*glDrawElements, "glDrawElements", get_proc);
    load_fn(*glDepthMask, "glDepthMask", get_proc);

    load_fn(*glGenFramebuffers, "glGenFramebuffers", get_proc);
    load_fn(*glGenRenderbuffers, "glGenRenderbuffers", get_proc);
    load_fn(*glBindFramebuffer, "glBindFramebuffer", get_proc);
    load_fn(*glBindRenderbuffer, "glBindRenderbuffer", get_proc);
    load_fn(*glFramebufferRenderbuffer, "glFramebufferRenderbuffer", get_proc);
    load_fn(*glGetRenderbufferParameteriv, "glGetRenderbufferParameteriv", get_proc);
    load_fn(*glCheckFramebufferStatus, "glCheckFramebufferStatus", get_proc);
}


// --- Shader utilities ---

create_program :: (vert_src: [:0]u8, frag_src: [:0]u8) -> u32 {
    vs := compile_shader(GL_VERTEX_SHADER, vert_src);
    fs := compile_shader(GL_FRAGMENT_SHADER, frag_src);

    prog := glCreateProgram();
    glAttachShader(prog, vs);
    glAttachShader(prog, fs);
    glLinkProgram(prog);

    status : i32 = 0;
    glGetProgramiv(prog, GL_LINK_STATUS, *status);
    if status == GL_FALSE {
        log_buf: [512]u8 = ---;
        glGetProgramInfoLog(prog, 512, null, *log_buf[0]);
    }

    glDeleteShader(vs);
    glDeleteShader(fs);
    return prog;
}

compile_shader :: (shader_type : u32, source: [:0]u8) -> u32 {
    shader := glCreateShader(shader_type);
    glShaderSource(shader, 1, source, null);
    glCompileShader(shader);

    status : i32 = 0;
    glGetShaderiv(shader, GL_COMPILE_STATUS, *status);
    if status == GL_FALSE {
        log_buf : [512]u8 = ---;
        glGetShaderInfoLog(shader, 512, null, *log_buf[0]);
    }
    return shader;
}