// OpenGL 3.3 Core — runtime-loaded function pointers
// No @library needed — caller provides a loader (e.g. SDL_GL_GetProcAddress)

// Constants
GL_FALSE             :i32: 0;
GL_TRUE              :i32: 1;
GL_DEPTH_TEST        :u32: 0x0B71;
GL_CULL_FACE         :u32: 0x0B44;
GL_BLEND             :u32: 0x0BE2;
GL_TRIANGLES         :u32: 4;
GL_LINES             :u32: 1;
GL_FLOAT             :u32: 0x1406;
GL_UNSIGNED_INT      :u32: 0x1405;
GL_VERTEX_SHADER     :u32: 0x8B31;
GL_FRAGMENT_SHADER   :u32: 0x8B30;
GL_COMPILE_STATUS    :u32: 0x8B81;
GL_LINK_STATUS       :u32: 0x8B82;
GL_ARRAY_BUFFER      :u32: 0x8892;
GL_ELEMENT_ARRAY_BUFFER :u32: 0x8893;
GL_STATIC_DRAW       :u32: 0x88E4;
GL_COLOR_BUFFER_BIT  :u32: 0x4000;
GL_DEPTH_BUFFER_BIT  :u32: 0x0100;
GL_FRONT_AND_BACK    :u32: 0x0408;
GL_LINE              :u32: 0x1B01;
GL_FILL              :u32: 0x1B02;

// Function pointer variables (mutable, loaded at runtime)
glClearColor             : (f32, f32, f32, f32) -> void abi(.c) = ---;
glClear                  : (u32) -> void abi(.c) = ---;
glEnable                 : (u32) -> void abi(.c) = ---;
glDisable                : (u32) -> void abi(.c) = ---;
glViewport               : (i32, i32, i32, i32) -> void abi(.c) = ---;
glFlush                  : () -> void abi(.c) = ---;
glDrawArrays             : (u32, i32, i32) -> void abi(.c) = ---;
glPolygonMode            : (u32, u32) -> void abi(.c) = ---;
glLineWidth              : (f32) -> void abi(.c) = ---;
glCreateShader           : (u32) -> u32 abi(.c) = ---;
glShaderSource           : (u32, i32, *[:0]u8, *i32) -> void abi(.c) = ---;
glCompileShader          : (u32) -> void abi(.c) = ---;
glGetShaderiv            : (u32, u32, *i32) -> void abi(.c) = ---;
glGetShaderInfoLog       : (u32, i32, *i32, [*]u8) -> void abi(.c) = ---;
glCreateProgram          : () -> u32 abi(.c) = ---;
glAttachShader           : (u32, u32) -> void abi(.c) = ---;
glLinkProgram            : (u32) -> void abi(.c) = ---;
glGetProgramiv           : (u32, u32, *i32) -> void abi(.c) = ---;
glGetProgramInfoLog      : (u32, i32, *i32, [*]u8) -> void abi(.c) = ---;
glUseProgram             : (u32) -> void abi(.c) = ---;
glDeleteShader           : (u32) -> void abi(.c) = ---;
glGenVertexArrays        : (i32, *u32) -> void abi(.c) = ---;
glGenBuffers             : (i32, *u32) -> void abi(.c) = ---;
glBindVertexArray        : (u32) -> void abi(.c) = ---;
glBindBuffer             : (u32, u32) -> void abi(.c) = ---;
glBufferData             : (u32, isize, *void, u32) -> void abi(.c) = ---;
glVertexAttribPointer    : (u32, i32, u32, u8, i32, *void) -> void abi(.c) = ---;
glEnableVertexAttribArray : (u32) -> void abi(.c) = ---;
glGetUniformLocation     : (u32, [*]u8) -> i32 abi(.c) = ---;
glUniformMatrix4fv       : (i32, i32, u8, [*]f32) -> void abi(.c) = ---;
glUniform3f              : (i32, f32, f32, f32) -> void abi(.c) = ---;
glUniform4fv             : (i32, i32, [*]f32) -> void abi(.c) = ---;
glDepthFunc              : (u32) -> void abi(.c) = ---;
glUniform1f              : (i32, f32) -> void abi(.c) = ---;
GL_LESS                  :u32: 0x0201;
GL_LEQUAL                :u32: 0x0203;
GL_SCISSOR_TEST          :u32: 0x0C11;
GL_DYNAMIC_DRAW          :u32: 0x88E8;
GL_TEXTURE_2D            :u32: 0x0DE1;
GL_TEXTURE_MIN_FILTER    :u32: 0x2801;
GL_TEXTURE_MAG_FILTER    :u32: 0x2800;
GL_NEAREST               :u32: 0x2600;
GL_RGBA                  :u32: 0x1908;
GL_UNSIGNED_BYTE         :u32: 0x1401;
GL_PACK_ALIGNMENT        :u32: 0x0D05;
GL_SRC_ALPHA             :u32: 0x0302;
GL_ONE_MINUS_SRC_ALPHA   :u32: 0x0303;
GL_TEXTURE0              :u32: 0x84C0;
GL_LINEAR                :u32: 0x2601;
GL_RED                   :u32: 0x1903;
GL_R8                    :u32: 0x8229;
GL_UNPACK_ALIGNMENT      :u32: 0x0CF5;

glScissor                : (i32, i32, i32, i32) -> void abi(.c) = ---;
glBufferSubData          : (u32, isize, isize, *void) -> void abi(.c) = ---;
glGenTextures            : (i32, *u32) -> void abi(.c) = ---;
glBindTexture            : (u32, u32) -> void abi(.c) = ---;
glTexImage2D             : (u32, i32, i32, i32, i32, i32, u32, u32, *void) -> void abi(.c) = ---;
glTexParameteri          : (u32, u32, i32) -> void abi(.c) = ---;
glBlendFunc              : (u32, u32) -> void abi(.c) = ---;
glReadPixels             : (i32, i32, i32, i32, u32, u32, *void) -> void abi(.c) = ---;
glActiveTexture          : (u32) -> void abi(.c) = ---;
glUniform1i              : (i32, i32) -> void abi(.c) = ---;
glPixelStorei            : (u32, i32) -> void abi(.c) = ---;
glTexSubImage2D          : (u32, i32, i32, i32, i32, i32, u32, u32, *void) -> void abi(.c) = ---;
glDeleteTextures         : (i32, *u32) -> void abi(.c) = ---;
glDeleteBuffers          : (i32, *u32) -> void abi(.c) = ---;
glDrawElements           : (u32, i32, u32, *void) -> void abi(.c) = ---;
glDepthMask              : (u8) -> void abi(.c) = ---;

glGenFramebuffers              : (i32, *u32) -> void abi(.c) = ---;
glGenRenderbuffers             : (i32, *u32) -> void abi(.c) = ---;
glBindFramebuffer              : (u32, u32) -> void abi(.c) = ---;
glBindRenderbuffer             : (u32, u32) -> void abi(.c) = ---;
glFramebufferRenderbuffer      : (u32, u32, u32, u32) -> void abi(.c) = ---;
glGetRenderbufferParameteriv   : (u32, u32, *i32) -> void abi(.c) = ---;
glCheckFramebufferStatus       : (u32) -> u32 abi(.c) = ---;

GL_TEXTURE_WRAP_S        :u32: 0x2802;
GL_TEXTURE_WRAP_T        :u32: 0x2803;
GL_CLAMP_TO_EDGE         :u32: 0x812F;

// Loader: call once after creating GL context
// Pass in a proc loader (e.g. SDL_GL_GetProcAddress)
loadFn :: (slot: *$T, name: cstring, getProc: (cstring) -> *void abi(.c)) {
    slot.* = getProc(name).(T);
}

loadGl :: (getProc: (cstring) -> *void abi(.c)) {
    loadFn(*glClearColor, "glClearColor", getProc);
    loadFn(*glClear, "glClear", getProc);
    loadFn(*glEnable, "glEnable", getProc);
    loadFn(*glDisable, "glDisable", getProc);
    loadFn(*glViewport, "glViewport", getProc);
    loadFn(*glFlush, "glFlush", getProc);
    loadFn(*glDrawArrays, "glDrawArrays", getProc);
    loadFn(*glPolygonMode, "glPolygonMode", getProc);
    loadFn(*glLineWidth, "glLineWidth", getProc);
    loadFn(*glCreateShader, "glCreateShader", getProc);
    loadFn(*glShaderSource, "glShaderSource", getProc);
    loadFn(*glCompileShader, "glCompileShader", getProc);
    loadFn(*glGetShaderiv, "glGetShaderiv", getProc);
    loadFn(*glGetShaderInfoLog, "glGetShaderInfoLog", getProc);
    loadFn(*glCreateProgram, "glCreateProgram", getProc);
    loadFn(*glAttachShader, "glAttachShader", getProc);
    loadFn(*glLinkProgram, "glLinkProgram", getProc);
    loadFn(*glGetProgramiv, "glGetProgramiv", getProc);
    loadFn(*glGetProgramInfoLog, "glGetProgramInfoLog", getProc);
    loadFn(*glUseProgram, "glUseProgram", getProc);
    loadFn(*glDeleteShader, "glDeleteShader", getProc);
    loadFn(*glGenVertexArrays, "glGenVertexArrays", getProc);
    loadFn(*glGenBuffers, "glGenBuffers", getProc);
    loadFn(*glBindVertexArray, "glBindVertexArray", getProc);
    loadFn(*glBindBuffer, "glBindBuffer", getProc);
    loadFn(*glBufferData, "glBufferData", getProc);
    loadFn(*glVertexAttribPointer, "glVertexAttribPointer", getProc);
    loadFn(*glEnableVertexAttribArray, "glEnableVertexAttribArray", getProc);
    loadFn(*glGetUniformLocation, "glGetUniformLocation", getProc);
    loadFn(*glUniformMatrix4fv, "glUniformMatrix4fv", getProc);
    loadFn(*glUniform3f, "glUniform3f", getProc);
    loadFn(*glUniform4fv, "glUniform4fv", getProc);
    loadFn(*glDepthFunc, "glDepthFunc", getProc);
    loadFn(*glUniform1f, "glUniform1f", getProc);
    loadFn(*glScissor, "glScissor", getProc);
    loadFn(*glBufferSubData, "glBufferSubData", getProc);
    loadFn(*glGenTextures, "glGenTextures", getProc);
    loadFn(*glBindTexture, "glBindTexture", getProc);
    loadFn(*glTexImage2D, "glTexImage2D", getProc);
    loadFn(*glTexParameteri, "glTexParameteri", getProc);
    loadFn(*glBlendFunc, "glBlendFunc", getProc);
    loadFn(*glReadPixels, "glReadPixels", getProc);
    loadFn(*glActiveTexture, "glActiveTexture", getProc);
    loadFn(*glUniform1i, "glUniform1i", getProc);
    loadFn(*glPixelStorei, "glPixelStorei", getProc);
    loadFn(*glTexSubImage2D, "glTexSubImage2D", getProc);
    loadFn(*glDeleteTextures, "glDeleteTextures", getProc);
    loadFn(*glDeleteBuffers, "glDeleteBuffers", getProc);
    loadFn(*glDrawElements, "glDrawElements", getProc);
    loadFn(*glDepthMask, "glDepthMask", getProc);

    loadFn(*glGenFramebuffers, "glGenFramebuffers", getProc);
    loadFn(*glGenRenderbuffers, "glGenRenderbuffers", getProc);
    loadFn(*glBindFramebuffer, "glBindFramebuffer", getProc);
    loadFn(*glBindRenderbuffer, "glBindRenderbuffer", getProc);
    loadFn(*glFramebufferRenderbuffer, "glFramebufferRenderbuffer", getProc);
    loadFn(*glGetRenderbufferParameteriv, "glGetRenderbufferParameteriv", getProc);
    loadFn(*glCheckFramebufferStatus, "glCheckFramebufferStatus", getProc);
}


// --- Shader utilities ---

createProgram :: (vertSrc: [:0]u8, fragSrc: [:0]u8) -> u32 {
    vs := compileShader(GL_VERTEX_SHADER, vertSrc);
    fs := compileShader(GL_FRAGMENT_SHADER, fragSrc);

    prog := glCreateProgram();
    glAttachShader(prog, vs);
    glAttachShader(prog, fs);
    glLinkProgram(prog);

    status : i32 = 0;
    glGetProgramiv(prog, GL_LINK_STATUS, *status);
    if status == GL_FALSE {
        logBuf: [512]u8 = ---;
        glGetProgramInfoLog(prog, 512, null, *logBuf[0]);
    }

    glDeleteShader(vs);
    glDeleteShader(fs);
    return prog;
}

compileShader :: (shaderType : u32, source: [:0]u8) -> u32 {
    shader := glCreateShader(shaderType);
    glShaderSource(shader, 1, source, null);
    glCompileShader(shader);

    status : i32 = 0;
    glGetShaderiv(shader, GL_COMPILE_STATUS, *status);
    if status == GL_FALSE {
        logBuf : [512]u8 = ---;
        glGetShaderInfoLog(shader, 512, null, *logBuf[0]);
    }
    return shader;
}