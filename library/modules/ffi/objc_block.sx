// Obj-C blocks over sx callables.
//
// Apple's block ABI (clang's "Block Implementation Specification"): a block
// pointer addresses { isa, flags, reserved, invoke, descriptor } followed by
// the captured state. The runtime reads `invoke` and calls it with the block
// pointer as the first argument, and moves a stack block to the heap by
// copying `descriptor.size` bytes verbatim.
//
// An sx block is that header, its own descriptor, and the callable value —
// captures included — in one instance, so the runtime's verbatim copy is
// self-contained: a block an API keeps past the call outlives the frame that
// built it. `blockCreate` returns a heap block holding one reference;
// `blockRelease` drops it.

// `buildBlockInvoke` (below) is a comptime metaprogram that emits sx source
// with `concat` / `intToString`; those live in std.sx. A metaprogram body
// resolves its bare names in its OWN module, so this module must
// import std.sx itself rather than relying on the call site's visibility.
@import "modules/std.sx";

// Apple's block header. `*Block` is what every block-taking API receives.
Block :: struct {
    isa: *void;
    flags: i32;
    reserved: i32;
    invoke: *void;
    descriptor: *BlockDescriptor;
}

// Per-instance metadata. `size` covers the whole instance, captures included —
// what the runtime allocates and copies when the block escapes.
BlockDescriptor :: struct {
    reserved: i64;
    size: i64;
    copy: (*Block, *Block) -> void abi(.c);
    dispose: (*Block) -> void abi(.c);
}

// The header and the descriptor it addresses, at the same offsets in every sx
// block whatever it captures.
BlockHead :: struct {
    header: Block;
    shape: BlockDescriptor;
}

// One sx block: the fixed head plus the callable, whose captures ride inline.
BlockStorage :: struct ($F: Type) {
    head: BlockHead;
    callable: F;
}

// libSystem isa pointer for stack-allocated blocks. Resolved at link time
// (auto-linked on every Apple target via libSystem).
_NSConcreteStackBlock : *void extern;

_Block_copy :: (block: *void) -> *void extern;
_Block_release :: (block: *void) extern;

// The `flags` bit that makes the runtime call the descriptor's two helpers.
kBlockHasCopyDispose :: 1 << 25;

// A fresh copy inherits the source's descriptor pointer; re-point it at the
// copy's own.
blockCopyHelper :: (dst: *Block, src: *Block) abi(.c) {
    _ = src;
    head := dst.(*BlockHead);
    head.header.descriptor = *head.shape;
}

// A block owns nothing outside its own instance, and the runtime calls both
// helpers or neither.
blockDisposeHelper :: (block: *Block) abi(.c) {
    _ = block;
}

// A heap block around `f`, copied in captures and all: a lambda that writes its
// own env, a function, or a callable nominal. The caller owns the returned
// reference; an API that keeps the block past the call takes its own.
blockCreate :: (f: $F/(..$A) -> $R) -> *Block {
    inline match F {
        case closure: @error("a block owns the callable it copies, and a 'Closure' only borrows its environment — write the lambda's env ('||_{ }' when it captures nothing) so it carries its own, or hand 'blockCreate' a function");
        case pointer: @error("a block owns the callable it copies, and a pointer only borrows what it addresses — hand 'blockCreate' the callable itself");
        else: {}
    }
    @insert buildBlockInvoke($A, $R);
    value : BlockStorage(F) = ---;
    value.head.shape = .{
        reserved = 0,
        size = @sizeOf(BlockStorage(F)),
        copy = blockCopyHelper,
        dispose = blockDisposeHelper,
    };
    value.head.header = .{
        isa = *_NSConcreteStackBlock,
        flags = kBlockHasCopyDispose,
        reserved = 0,
        invoke = (*invoke).(*void),
        descriptor = *value.head.shape,
    };
    value.callable = f;
    return _Block_copy((*value).(*void)).(*Block);
}

// Drop the reference `blockCreate` returned.
blockRelease :: (block: *Block) {
    _Block_release(block.(*void));
}

// Comptime builder for `blockCreate`'s per-shape `invoke`: the `abi(.c)` fn
// the block runtime calls, taking the block pointer and then the callable's
// own parameters verbatim, and forwarding to the callable stored in the
// instance. Per-call-shape monomorphisation of `blockCreate` re-runs this
// builder with the concrete types bound, so each shape gets its own
// trampoline.
buildBlockInvoke :: (args: []Type, $ret: Type) -> string {
    retName := @typeName(ret);
    code := "invoke :: (blockSelf: *Block";
    i : i64 = 0;
    while i < args.len {
        code = concat(code, ", arg");
        code = concat(code, intToString(i));
        code = concat(code, ": ");
        code = concat(code, @typeName(args[i]));
        i = i + 1;
    }
    code = concat(code, ") -> ");
    code = concat(code, retName);
    code = concat(code, " abi(.c) { storage := blockSelf.(*BlockStorage(F)); ");
    if retName == "void" {
        code = concat(code, "storage.callable(");
    } else {
        code = concat(code, "return storage.callable(");
    }
    i = 0;
    while i < args.len {
        if i > 0 { code = concat(code, ", "); }
        code = concat(code, "arg");
        code = concat(code, intToString(i));
        i = i + 1;
    }
    code = concat(code, "); }");
    return code;
}
