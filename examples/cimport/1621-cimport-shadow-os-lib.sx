// Unit-first JIT resolution: a `@source` unit defining a
// symbol that ALSO lives in an OS image already loaded into the
// compiler process (libz, via libLLVM) still wins — the unit's objects
// link into the program's JITDylib, whose definitions precede the
// process-wide search. The unit's zlibCompileFlags answers 0xDEADBEEF; the OS
// one answers real flag bits, so `true` proves the unit won.
//
@import "modules/std.sx";

zshadow :: @import c {
    @include "1621-cimport-shadow-os-lib/shadow.h";
    @source  "1621-cimport-shadow-os-lib/shadow.c";
};

main :: () -> i32 {
    print("fromUnit: {}\n", zshadow.zlibCompileFlags() == 3735928559);
    0
}
