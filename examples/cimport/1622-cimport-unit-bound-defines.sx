// `@define`/`@flags` reach a unit whose ONLY consumer is hand-curated
// `extern` decls — no `@include`, no auto-synthesis:
// the macro decides what the unit-bound decl answers.
@import "modules/std.sx";

unit :: @import c {
    @define "UNIT_BASE=33";
    @flags  "-O2";
    @source "1622-cimport-unit-bound-defines/unit.c";
};

unitAnswer :: () -> i32 extern unit "unit_answer";

main :: () -> i32 {
    print("unit answer = {}\n", unitAnswer());
    0
}
