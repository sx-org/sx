// A `-> void` callee with a comptime param is INLINED into its caller, and a
// `return;` in its body is ITS exit, not the caller's: it lands on the
// inliner's own exit rather than emitting the caller's `ret` in place, and the
// return-type check reads the CALLEE's signature.
//
// The caller returns a distinctive 37 so the exit code alone proves it ran to
// its own end, and the three lines pin the statements on both sides of the call.
@import "modules/std.sx";

speak :: ($tag: string) {
    print("before\n");
    if true { return; }
    print("unreached\n");
}

main :: () -> i32 {
    speak("a");
    print("inside\n");
    print("after\n");
    37
}
