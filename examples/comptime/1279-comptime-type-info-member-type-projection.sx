// `@typeInfo(T).struct.fields[i].type` / `.enum.fields[i].payload` is a
// comptime type. A tagless variant's payload is `void`.
@import "modules/std.sx";

Future :: struct { value: i64; ready: bool; }
Holder :: struct { fut: *Future; tag: i32; }

Shape :: enum { circle: f64; rect: i64; empty; }

nameOf :: ($T: Type) -> string {
    return @typeName(T);
}

firstResult :: ($T: Type) -> i64 {
    total := 0;
    inline for i in 0..1 {
        r : @typeInfo(pointeeType(@typeInfo(T).struct.fields[i].type)).struct.fields[0].type = 42;
        total = total + r;
    }
    return total;
}

main :: () {
    v : @typeInfo(Holder).struct.fields[1].type = 7;
    a : @typeInfo(Shape).enum.fields[0].payload = 1.5;
    print("v={} a={}\n", v, a);

    print("tagless={} held={}\n",
        @typeName(@typeInfo(Shape).enum.fields[2].payload),
        nameOf(@typeInfo(Holder).struct.fields[0].type));

    print("peeled={}\n", firstResult(Holder));
}
