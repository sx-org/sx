// struct_field_offset(T, i) — the i-th field's byte offset, folded at
// compile time from the same layout walk typeSizeBytes uses (fields
// aligned to their own alignment, declaration order). Parity with
// type_info's StructField.offset is pinned.
@import "modules/std.sx";
meta :: @import "modules/std/meta.sx";

Padded :: struct { a: u8; b: i64; c: u16; }
PaddedT :: struct { a: u8; b: i64 };

parity :: () -> bool {
    ti := type_info(Padded);
    match ti { case .struct: |si| { return si.fields[1].offset == struct_field_offset(Padded, 1); } else: {} }
    return false;
}
PARITY :: @run parity();

main :: () {
    print("{} {} {}\n", struct_field_offset(Padded, 0), struct_field_offset(Padded, 1), struct_field_offset(Padded, 2));
    print("product: {} {}\n", struct_field_offset(PaddedT, 0), struct_field_offset(PaddedT, 1));
    print("parity={}\n", PARITY);
}
