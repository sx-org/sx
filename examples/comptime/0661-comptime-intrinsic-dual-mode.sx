// A `dual`-mode intrinsic is dispatched two ways: folded at lowering when the
// type argument is statically resolvable, and serviced by the comptime VM when
// it is not. `@typeName`, the `is unsigned` read, and `@typeInfo` are the
// only three (see `ir/intrinsics.zig`).
//
// Both stages agree: the same intrinsic evaluated behind `@run` and at runtime
// yields the same answer.
@import "modules/std.sx";

P :: struct { a: i64; b: f32; }

// `@run` forces evaluation in the comptime VM.
CT_NAME     :: @run @typeName(P);
CT_UNSIGNED :: @run u32 is unsigned;
CT_SIGNED   :: @run i32 is unsigned;
CT_SIZE     :: @run @sizeOf(P);

main :: () {
    // comptime vs runtime — the two columns must match.
    print("@typeName         ct={} rt={}\n", CT_NAME, @typeName(P));
    print("is unsigned       ct={} rt={}\n", CT_UNSIGNED, u32 is unsigned);
    print("is unsigned       ct={} rt={}\n", CT_SIGNED, i32 is unsigned);
    print("@sizeOf           ct={} rt={}\n", CT_SIZE, @sizeOf(P));
}
