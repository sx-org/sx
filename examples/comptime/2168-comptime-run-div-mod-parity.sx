// `/` and `%` truncate toward zero and read their signedness from the operand
// type. The comptime VM computes what codegen's `sdiv`/`srem`, `udiv`/`urem`
// and `frem` compute, so one call site spells one answer at both stages.
#import "modules/std/core.sx";

report :: (stage: string, n: i64, d: i64, un: u64, ud: u64, x: f64, y: f64) -> i64 {
    @printf("{}: {} {} {} {} {}\n", stage, n / d, n % d, un / ud, un % ud, x % y);
    0
}

#run report("comptime", -7, 10, u64.max, 3, -7.5, 2.0);

main :: () {
    report("runtime", -7, 10, u64.max, 3, -7.5, 2.0);
}
