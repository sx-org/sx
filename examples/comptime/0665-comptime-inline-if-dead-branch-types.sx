// A statically-dead `inline if` branch is dropped WHOLE: its type
// annotations are not resolved, exactly as its statements are not
// lowered — a type that exists only on another target (or behind a
// disabled feature const) must not error from a pruned branch, so the
// unknown-type checker walks only the live one. Covers the bool-const,
// `OS ==` binary, and/or, and `inline match OS` forms; the taken
// branch always runs.
@import "modules/std.sx";

ENABLED :: false;

main :: () {
    inline if ENABLED {
        a : *MissingA = null;
        missing_fn(a);
    } else {
        print("const ok\n");
    }
    inline if OS == .ios {
        c : *MissingC = null;
        print("{}\n", c);
    } else {
        print("os ok\n");
    }
    inline if OS == .ios or OS == .android {
        d : *MissingD = null;
        print("{}\n", d);
    } else {
        print("or ok\n");
    }
    inline match OS {
        case .ios: {
            e : *MissingE = null;
            print("{}\n", e);
        }
        else: { print("match ok\n"); }
    }
}
