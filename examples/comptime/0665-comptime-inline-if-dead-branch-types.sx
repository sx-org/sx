// A statically-dead `inline if` branch is dropped WHOLE: its type
// annotations are not resolved, exactly as its statements are not
// lowered — a type that exists only on another target (or behind a
// disabled feature const) must not error from a pruned branch, so the
// unknown-type checker walks only the live one.
@import "modules/std.sx";

ENABLED :: false;

main :: () {
    inline if ENABLED {
        a : *MissingA = null;
        missingFn(a);
    } else {
        print("const ok\n");
    }
    inline if @host.os == .ios {
        c : *MissingC = null;
        print("{}\n", c);
    } else {
        print("os ok\n");
    }
    inline if @host.os == .ios or @host.os == .android {
        d : *MissingD = null;
        print("{}\n", d);
    } else {
        print("or ok\n");
    }
    inline match @host.os {
        case .ios: {
            e : *MissingE = null;
            print("{}\n", e);
        }
        else: { print("match ok\n"); }
    }
}
