@import "modules/std.sx";

Box :: struct {
    value: i32;
    read :: (self: Box, extra: i32) -> i32 { self.value + extra }
}

clear :: (box: *?Box) -> i32 { box.* = null; 1 }

value :: () -> i32 {
    box: ?Box = Box{value = 42};
    if box == null { return 0; }
    box.read(clear(*box))
}

Folded :: @run value();

main :: () { print("{} {}\n", Folded, value()); }
