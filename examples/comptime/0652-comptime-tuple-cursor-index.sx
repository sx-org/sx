@import "modules/std.sx";

Box :: struct ($R: Type) { value: R; }

// Read each handle with its concrete type via the `inline for` cursor.
showAll :: (tup: $T) {
    inline for i in 0..@typeInfo(T).struct.fields.len {
        h := @field(tup, i);                       // concrete `*Box(T_i)`, not `any`
        print("[{}] = {}\n", i, h.value);  // field access resolves
    }
}

// Literal-index form, positional tuple.
firstTwo :: (tup: $T) -> i64 {
    a := @field(tup, 0);
    b := @field(tup, 1);
    return a.value + b.value;
}

main :: () -> i32 {
    ba : Box(i64)  = .{ value = 7 };
    bb : Box(bool) = .{ value = true };
    bc : Box(f64)  = .{ value = 2.5 };
    showAll(.{a = *ba, b = *bb, c = *bc});   // named tuple of *Box(..)

    p0 : Box(i64) = .{ value = 10 };
    p1 : Box(i64) = .{ value = 32 };
    print("sum = {}\n", firstTwo(.{*p0, *p1}));  // positional, literal index
    return 0;
}
