// Comptime type-call COMPOSITION: a `($T) -> Type` builder walks a named
// tuple's reflected members, projects each element type through `pointeeType`
// + a member projection, and mints a tagged-union whose variant labels mirror
// the tuple's labels — the shape the `race` result synthesis needs
// (`(a: *Task(A), b: *Task(B))` -> `{ a: A; b: B }`).
//
// Exercises three things off the member cursor: its `.type` used as (1) a
// `Type`-typed struct field value, (2) a nested type-call arg
// (`@typeInfo(pointeeType(field.type)).struct.fields[0].type`), and its `.name`
// as a comptime string for a minted variant NAME.
@import "modules/std.sx";
@import "modules/std/meta.sx";

// Stand-in for a task handle: a pointer to a generic box carrying the result.
Box :: struct ($R: Type) { value: R; }

// Mint a tagged-union mirroring a named tuple of `*Box(..)` handles:
// variant name = tuple label, payload = the box's value type (`*Box(A)` -> `A`).
ResultOf :: ($T: Type) -> Type {
    vs : [@typeInfo(T).struct.fields.len]VariantInfo = ---;
    inline for field in @typeInfo(T).struct.fields {
        vs[field.index] = VariantInfo{
            name    = field.name,                                               // folded to a const string
            payload = @typeInfo(pointeeType(field.type)).struct.fields[0].type, // *Box(A) -> Box(A) -> A
        };
    }
    return makeEnum("ResultOf", vs);
}

Handles :: struct { a: *Box(i64); b: *Box(bool); c: *Box(f64) };
R :: ResultOf(Handles);

use :: (r: R) {
    match r {
        case .a: |v| { print("a (i64)  = {}\n", v); }
        case .b: |v| { print("b (bool) = {}\n", v); }
        case .c: |v| { print("c (f64)  = {}\n", v); }
    }
}

main :: () -> i32 {
    use(.a(42));
    use(.b(true));
    use(.c(2.5));
    print("R: variants={} names=({},{},{})\n",
        @typeInfo(R).enum.fields.len,
        @typeInfo(R).enum.fields[0].name, @typeInfo(R).enum.fields[1].name, @typeInfo(R).enum.fields[2].name);
    return 0;
}
