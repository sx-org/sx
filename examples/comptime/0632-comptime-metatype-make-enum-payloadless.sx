// A comptime-minted FULLY payloadless enum (every variant tagless) mints as a
// real `.@"enum"`, not an all-void taggedUnion, whose IR/LLVM size mismatch
// trips `verifySizes` at codegen. `makeEnum` (declare/define) with an all-void
// variant list produces an ordinary enum, usable like a hand-written one.

@import "modules/std.sx";
@import "modules/std/meta.sx";

makeSuit :: () -> Type {
    return makeEnum("Suit", .[
        VariantInfo{ name = "hearts",   payload = void },
        VariantInfo{ name = "spades",   payload = void },
        VariantInfo{ name = "diamonds", payload = void },
    ]);
}
Suit :: makeSuit();

show :: (s: Suit) {
    match s {
        case .hearts:   { print("hearts\n"); }
        case .spades:   { print("spades\n"); }
        case .diamonds: { print("diamonds\n"); }
    }
}

main :: () {
    show(.spades);       // leading-dot, typed context
    x := Suit.diamonds;  // qualified construction
    show(x);
}
