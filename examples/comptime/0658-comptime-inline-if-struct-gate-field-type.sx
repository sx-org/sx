// A comptime-dead `inline if T is struct` branch that walks
// `@typeInfo(T).struct.fields` must be ELIDED from type resolution when T is an
// enum, so the `.struct` projection never lowers `.unresolved` to the backend.
// The `$T is struct` comptime predicate gates the branch, and a direct
// `Enum.variant` value (`E.A`) is a first-class generic-call argument (its type
// infers to the enum). Compiles + runs for BOTH a struct and an enum
// instantiation of the same generic.
@import "modules/std.sx";

// Field-wise fold: recurse struct fields, leaf-count everything else. An enum
// reflects as `.enum`, so entering the walk on one would spell a wrong-variant
// projection.
leafCount :: (v: $T) -> i64 {
    inline if T is struct {
        n := 0;
        inline for field in @typeInfo(T).struct.fields {
            n = n + leafCount(structFieldValue(v, field.index).(field.type));
        }
        return n;
    }
    return 1; // enum / scalar leaf
}

E :: enum { A; B; }
Pair :: struct { a: i64; e: E; }

main :: () {
    // enum instantiation — dead `inline if` branch elided, no panic.
    print("{}\n", leafCount(E.A));                 // 1
    // scalar leaf.
    print("{}\n", leafCount(7.(i64)));         // 1
    // struct instantiation — branch taken, recurses two leaves (i64 + enum).
    print("{}\n", leafCount(Pair{ a=1, e=E.B}));   // 2
}
