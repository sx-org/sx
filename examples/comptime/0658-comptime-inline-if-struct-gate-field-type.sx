// A comptime-dead `inline if T is struct` branch that
// reflects with `structFieldType(T, i)` must be ELIDED from type resolution when T is
// a non-indexable type (an enum), so `structFieldType(enum)` never lowers `.unresolved`
// to the backend. The `$T is struct` comptime predicate gates the branch, and a
// direct `Enum.variant` value (`E.A`) is a first-class generic-call argument
// (its type infers to the enum). Compiles + runs for BOTH a struct and an enum
// instantiation of the same generic.
@import "modules/std.sx";

// (`structFieldType` needs no declaration or import here — it is an intrinsic, and
// the compiler dispatches it from its registry. Its source identity lives in
// std/core.sx.)

// Field-wise fold: recurse struct fields, leaf-count everything else. The
// `inline if T is struct` branch (containing `structFieldType(T,i)`) must not resolve
// when T is an enum — `structFieldCount(enum)` is the variant count, so a naive path
// would enter the field loop and trip `structFieldType(enum)` → `.unresolved` panic.
leafCount :: (v: $T) -> i64 {
    inline if T is struct {
        n := 0;
        inline for i in 0..structFieldCount(T) {
            n = n + leafCount(structFieldValue(v, i).(structFieldType(T, i)));
        }
        return n;
    }
    return 1; // enum / scalar leaf
}

E :: enum { A; B; }
Pair :: struct { a: i64; e: E; }

main :: () {
    // enum instantiation — dead `inline if` branch elided, no panic.
    print("{}\n", leafCount(E.A));                 // 1
    // scalar leaf.
    print("{}\n", leafCount(7.(i64)));         // 1
    // struct instantiation — branch taken, recurses two leaves (i64 + enum).
    print("{}\n", leafCount(Pair{ a=1, e=E.B}));   // 2
}
