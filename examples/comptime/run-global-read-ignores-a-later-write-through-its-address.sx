@import "modules/std.sx";

Box :: struct { value: i32; }

g : Box = Box{value = 42};

bump :: (box: *Box) -> i32 { box.value = 100; 1 }

add :: (box: Box, extra: i32) -> i32 { box.value + extra }

value :: () -> i32 { add(g, bump(*g)) }

Folded :: @run value();

main :: () { print("{} {}\n", Folded, value()); }
