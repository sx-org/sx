// Comptime slice over a non-string AGGREGATE: assemble a pool of candidate
// variants in a local array, then mint an enum from a SUBSLICE of it. This
// exercises the `subslice` op on an array VALUE (`dirs[0..2]`), yielding a
// real `[]VariantInfo` the `define` decoder reads.
//
// `Axis` is built from only the first two of four directions, so `.south` /
// `.west` are NOT variants of it.
@import "modules/std.sx";
@import "modules/std/meta.sx";

build_axis :: () -> Type {
    dirs := .[
        VariantInfo{ name = "north", payload = void },
        VariantInfo{ name = "east",  payload = i64 },   // carries a bearing
        VariantInfo{ name = "south", payload = void },
        VariantInfo{ name = "west",  payload = void },
    ];
    return makeEnum("Axis", dirs[0..2]);   // first two only — a comptime subslice
}

Axis :: build_axis();

main :: () -> i32 {
    a : Axis = .north;
    b : Axis = .east(90);
    match a { case .north: { print("north\n"); } case .east: |d| { print("east {}\n", d); } }
    match b { case .north: { print("north\n"); } case .east: |d| { print("east {}\n", d); } }
    return 0;
}
