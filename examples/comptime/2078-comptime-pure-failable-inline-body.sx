// A callee with a comptime param is INLINED into its caller, so its body has a
// second exit sink: the inliner's return slot and done block rather than a real
// `ret`. The pure-failable demand reads the same there — an undemanded tail is
// discarded and the call yields the success tag; only an error tail reaches the
// caller's `catch`.
//
// Both inline shapes are covered: a body with no explicit `return` and a body
// that has one. Defers run before either exit.
//
// A `-> noreturn` callee is the third shape reaching the same sink: nothing is
// demanded of its tail, and its body closes the block it was inlined into, so
// the call site has no live position left to hold a result and none is emitted.
// The exit comes from the inlined `proc.exit(0)`, not from a return.
@import "modules/std.sx";
proc :: @import "modules/std/process.sx";

Failed :: error { Nope }

tick :: (label: string) -> i32 {
    print("tick {}\n", label);
    42
}

tick64 :: (label: string) -> i64 {
    print("tick64 {}\n", label);
    7
}

nothing :: (label: string) {
    print("void {}\n", label);
}

fails :: () -> !Failed {
    .Nope
}

// ── No explicit `return` in the body ───────────────────────────────────

ctValue :: ($label: string) -> !Failed {
    tick(label)
}

ctWide :: ($label: string) -> !Failed {
    tick64(label)
}

ctVoid :: ($label: string) -> !Failed {
    nothing(label)
}

ctCompound :: ($label: string) -> !Failed {
    { x := tick(label); }
}

ctError :: ($label: string) -> !Failed {
    print("ct-error {}\n", label);
    .Nope
}

ctForward :: ($label: string) -> !Failed {
    print("ct-forward {}\n", label);
    fails()
}

ctDefer :: ($label: string) -> !Failed {
    defer print("ct defer {}\n", label);
    tick(label)
}

ctDeferError :: ($label: string) -> !Failed {
    defer print("ct defer {}\n", label);
    fails()
}

ctMixed :: ($label: string, b: bool) -> !Failed {
    defer print("ct mixed defer\n");
    if b { fails() } else { tick(label) }
}

// ── With an explicit `return` in the body ──────────────────────────────

ctRetValue :: ($label: string, n: i32) -> !Failed {
    if n < 0 { return; }
    tick(label)
}

ctRetError :: ($label: string, n: i32) -> !Failed {
    if n < 0 { return; }
    print("ct-ret-error {}\n", label);
    .Nope
}

ctRetEarly :: ($label: string, n: i32) -> !Failed {
    if n < 0 {
        print("early {}\n", label);
        return;
    }
    tick(label)
}

ctRetRaise :: ($label: string, n: i32) -> !Failed {
    if n < 0 {
        raise .Nope;
    }
    tick(label)
}

ctRetMixed :: ($label: string, b: bool) -> !Failed {
    if b { return; }
    if b { fails() } else { tick(label) }
}

// ── A `-> noreturn` callee at the same sink ────────────────────────────

ctStop :: ($label: string) -> noreturn {
    print("stop {}\n", label);
    proc.exit(0);
}

main :: () -> i32 {
    ctValue("ct-value") catch { print("NOT REACHED ct-value\n"); };
    ctWide("ct-wide") catch { print("NOT REACHED ct-wide\n"); };
    ctVoid("ct-void") catch { print("NOT REACHED ct-void\n"); };
    ctCompound("ct-compound") catch { print("NOT REACHED ct-compound\n"); };
    ctDefer("ct-defer") catch { print("NOT REACHED ct-defer\n"); };
    ctMixed("ct-mixed", false) catch { print("NOT REACHED ct-mixed\n"); };
    ctError("a") catch { print("caught ct-error\n"); };
    ctForward("b") catch { print("caught ct-forward\n"); };
    ctDeferError("c") catch { print("caught ct-defer-error\n"); };
    ctMixed("d", true) catch { print("caught ct-mixed\n"); };

    ctRetValue("ct-ret-value", 1) catch { print("NOT REACHED ct-ret-value\n"); };
    ctRetValue("ct-ret-none", -1) catch { print("NOT REACHED ct-ret-none\n"); };
    ctRetEarly("ct-ret-early", -1) catch { print("NOT REACHED ct-ret-early\n"); };
    ctRetRaise("ct-ret-raise", 1) catch { print("NOT REACHED ct-ret-raise\n"); };
    ctRetMixed("ct-ret-mixed", false) catch { print("NOT REACHED ct-ret-mixed\n"); };
    ctRetError("e", 1) catch { print("caught ct-ret-error\n"); };
    ctRetRaise("f", -1) catch { print("caught ct-ret-raise\n"); };

    // The body runs, then diverges — so this is main's tail, and there is no
    // trailing value after it.
    ctStop("ct-stop");
}
