// A `@panic` reached under `@run` stops the COMPILER with exit code 1 — the
// `@is_comptime()` arm takes `c.exit(1)` instead of the abort a compiled panic
// raises. The build never reaches `main`, so no `--- build done ---` marker and
// no runtime output follow the message.
#import "modules/std/core.sx";

widths :: (n: i64) -> i64 {
    if n <= 0 {
        @panic("a width table needs at least one column");
    }
    n
}

@run widths(0);

main :: () {
    @printf("{}\n", widths(3));
}
