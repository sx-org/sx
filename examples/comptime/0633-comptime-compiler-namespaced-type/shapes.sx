// A module that MINTS a comptime enum via the compiler API and exports it.
@import "modules/std.sx";
@import "modules/std/meta.sx";   // rawDeclareType / rawRegisterType / Member

build_suit :: () -> Type {
    return rawRegisterType(rawDeclareType("Suit"), 2, .[   // kind 2 = actual enum
        Member{ name = "hearts", ty = void },
        Member{ name = "spades", ty = void },
    ]);
}

Suit :: build_suit();
