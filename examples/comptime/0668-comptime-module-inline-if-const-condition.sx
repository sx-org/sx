// Lowering owns the module-scope expansion fold, so a condition folds against
// everything an in-function `inline if` folds against — not just the target
// facts. A module constant, a chain of them, and a constant whose own value is
// a target comparison all select a group here.
@import "modules/std.sx";

ENABLED :: true;
ALIAS   :: ENABLED;
NATIVE  :: POINTER_SIZE == 8;

inline if ENABLED { from_const :: () -> i64 { 1 } } else { from_const :: () -> i64 { -1 } }
inline if ALIAS   { from_alias :: () -> i64 { 2 } } else { from_alias :: () -> i64 { -2 } }
inline if NATIVE  { from_target :: () -> i64 { 3 } } else { from_target :: () -> i64 { -3 } }

main :: () -> i32 {
    print("{} {} {}\n", from_const(), from_alias(), from_target());
    0
}
