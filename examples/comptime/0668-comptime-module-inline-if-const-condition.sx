// Lowering owns the module-scope expansion fold, so a condition folds against
// everything an in-function `inline if` folds against — not just the target
// facts. A module constant, a chain of them, and a constant whose own value is
// a target comparison all select a group here.
@import "modules/std.sx";

ENABLED :: true;
ALIAS   :: ENABLED;
NATIVE  :: @host.pointerSize == 8;

inline if ENABLED { fromConst :: () -> i64 { 1 } } else { fromConst :: () -> i64 { -1 } }
inline if ALIAS   { fromAlias :: () -> i64 { 2 } } else { fromAlias :: () -> i64 { -2 } }
inline if NATIVE  { fromTarget :: () -> i64 { 3 } } else { fromTarget :: () -> i64 { -3 } }

main :: () -> i32 {
    print("{} {} {}\n", fromConst(), fromAlias(), fromTarget());
    0
}
