// A CONCRETE builtin arm (`case i64:`, `case u8:`, `case f32:`) matches in
// an `inline match T` static type dispatch: the static fold resolves the
// primitive spelling exactly like the runtime type switch, which is what makes
// these arms reachable rather than falling to `else:` (`case string:` matches
// by doubling as a category name). Both the inline-constraint form and the
// leading `$T: Type` form.
@import "modules/std.sx";

byInline :: (v: $K) -> i64 {
    n := 0;
    inline match K {
        case i64: { n = 1; }
        case u8: { n = 2; }
        case f32: { n = 3; }
        case string: { n = 4; }
        else: { n = 5; }
    }
    n
}

byType :: ($T: Type) -> i64 {
    n := 0;
    inline match T {
        case i64: { n = 1; }
        case u8: { n = 2; }
        case f32: { n = 3; }
        else: { n = 5; }
    }
    n
}

main :: () {
    x : i64 = 7;
    b : u8 = 1;
    f : f32 = 1.5;
    print("{} {} {} {} {}\n", byInline(x), byInline(b), byInline(f), byInline("s"), byInline(true));
    print("{} {} {} {}\n", byType(i64), byType(u8), byType(f32), byType(bool));
}
