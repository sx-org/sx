@import "modules/std.sx";
@import "modules/std/meta.sx";

Boxed :: ($T: Type) -> Type {
    print("building Boxed\n");
    return define(declare("Boxed"), .struct(.{ fields = .[
        FieldInfo{ name = "value", type = T },
    ] }));
}

main :: () {
    b := Boxed(i64){ value = 42 };
    print("{}\n", b.value);
}
