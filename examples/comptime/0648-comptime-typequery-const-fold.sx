// Int-returning type-query builtins (`@sizeOf` / `@alignOf`) fold as comptime
// constants, like a plain `K :: 3` const.
@import "modules/std.sx";

main :: () -> i32 {
    s := 0;
    inline for i in 0..@sizeOf(i32) { s = s + i; }   // 0+1+2+3 = 6
    print("@sizeOf(i32) loop sum = {}\n", s);

    xs : [@sizeOf(i64)]i64 = ---;
    inline for i in 0..@sizeOf(i64) { xs[i] = i * 10; }
    print("array[@sizeOf(i64)] len = {}  xs[2] = {}\n", xs.len, xs[2]);

    print("@alignOf(f64) = {}\n", @alignOf(f64));

    ys : [@alignOf(f64) + 1]i64 = ---;
    print("[@alignOf(f64) + 1] len = {}\n", ys.len);

    return 0;
}
