// A reflected member's `.type` — and a variant's `.payload` — folds at lower
// time, so the projection composes wherever a type is spelled: inside
// `@typeEq`, `@typeName`, or any other type-arg slot.
@import "modules/std.sx";

Point :: struct { x: i64; y: f64; on: bool; }

Msg :: enum { num: i64; tag: bool; quit; }

main :: () -> i32 {
    print("field 0 is i64: {}\n", @typeEq(@typeInfo(Point).struct.fields[0].type, i64));
    print("field 1 is f64: {}\n", @typeEq(@typeInfo(Point).struct.fields[1].type, f64));
    print("field 2: {}\n", @typeName(@typeInfo(Point).struct.fields[2].type));

    slot : @typeInfo(Msg).enum.fields[0].payload = 7;
    print("Msg.num payload: {} = {}\n", @typeName(@typeOf(slot)), slot);
    return 0;
}
