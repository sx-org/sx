@import "modules/std.sx";

dbl :: (x: i64) -> i64 => x * 2;
apply :: (x: i64, f: Closure(i64) -> i64 = dbl) -> i64 { f(x) }

persist :: (x: i64) -> i64 {
    n := 40;
    c := mem.closure(|y: i64|_{ n } y + n);
    r := c(x);
    mem.free(c);
    r
}

Folded :: @run apply(21);
Persisted :: @run persist(2);

main :: () { print("{} {}\n", Folded, Persisted); }
