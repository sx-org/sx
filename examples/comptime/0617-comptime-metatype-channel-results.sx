// Comptime type construction — channel result types: meta.RecvResult($T) /
// meta.TryResult($T), built ENTIRELY in sx library code as type-fns over the
// `meta.define(meta.declare(), ...)` primitives (no compiler machinery). A
// blocking recv yields a value or a `closed` marker; a non-blocking try-recv
// adds `empty` — three states a bool can't express. This locks that they
// construct and match like any enum, and that `meta.RecvResult(i64)` is one
// nominal type across sites (the type-fn identity path).
@import "modules/std.sx";
@import "modules/std/meta.sx";

main :: () -> i32 {
    r := meta.RecvResult(i64).value(42);
    match r {
        case .value:  |v| { print("recv value {}\n", v); }
        case .closed: { print("recv closed\n"); }
    }

    rc : meta.RecvResult(i64) = .closed;
    match rc {
        case .value:  |v| { print("recv value {}\n", v); }
        case .closed: { print("recv closed\n"); }
    }

    t := meta.TryResult(i64).value(7);
    match t {
        case .value:  |v| { print("try value {}\n", v); }
        case .empty:  { print("try empty\n"); }
        case .closed: { print("try closed\n"); }
    }

    te : meta.TryResult(i64) = .empty;
    match te {
        case .value:  |v| { print("try value {}\n", v); }
        case .empty:  { print("try empty\n"); }
        case .closed: { print("try closed\n"); }
    }
    return 0;
}
