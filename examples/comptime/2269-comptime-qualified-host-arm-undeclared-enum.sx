// A qualified `@host.os` arm resolves with no declaration of the enum in reach.
inline match @host.os {
    case target.OperatingSystem.macos: HOST_OS :: "macos";
    case target.OperatingSystem.linux: HOST_OS :: "linux";
    case target.OperatingSystem.windows: HOST_OS :: "windows";
    else: @error("no qualified arm names this host's os");
}

main :: () {}
