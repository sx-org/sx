// A `@printf` under a top-level `@run` renders in the compiler and writes the
// compiler's stdout. The comptime VM walks the same core.sx primitives the
// runtime does, so one call site spells one rendering at both stages, with no
// allocator at either.
@import "modules/std/core.sx";

render :: (stage: string) -> i64 {
    n: i64 = 4242;
    wide: u32 = 4000000000;
    @printf("{}: {} {} {} {} braces {{}}\n", stage, n, wide, true, 0.5);
    low: i64 = i64.min;
    high: u64 = u64.max;
    @printf("{} {} {}\n", -7, low, high);
    0
}

@run render("comptime");

main :: () {
    render("runtime");
}
