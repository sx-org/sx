// A body-local `@run` of a scalar, a struct, an array, or an `?Array`
// optional bakes the VM result as a constant. The constructors run only at
// compile time (`@is_comptime()`). An unbridgeable result (e.g. `[2][]i64`)
// still fails the build.
#import "modules/std.sx";

Pt :: struct { x: i64; y: i64; }

mk_scalar :: () -> i64 {
    if !@is_comptime() { @panic("mk_scalar ran at runtime"); }
    42
}
mk_struct :: () -> Pt {
    if !@is_comptime() { @panic("mk_struct ran at runtime"); }
    .{ x = 3, y = 4 }
}
mk_arr :: () -> [3]i64 {
    if !@is_comptime() { @panic("mk_arr ran at runtime"); }
    r : [3]i64 = ---;
    r[0] = 10;
    r[1] = 20;
    r[2] = 30;
    r
}
mk_opt :: () -> ?[3]i64 {
    if !@is_comptime() { @panic("mk_opt ran at runtime"); }
    r : [3]i64 = ---;
    r[0] = 1;
    r[1] = 2;
    r[2] = 3;
    r
}

main :: () {
    N :: @run mk_scalar();
    S :: @run mk_struct();
    A :: @run mk_arr();
    O :: @run mk_opt();

    print("N={}\n", N);
    print("S={} {}\n", S.x, S.y);
    print("A={} {} {}\n", A[0], A[1], A[2]);
    v := O!;
    print("O={}\n", v[1]);
}
