// A body-local `@run` of a scalar, a struct, an array, or an `?Array`
// optional bakes the VM result as a constant. The constructors run only at
// compile time (`@isComptime()`). An unbridgeable result (e.g. `[2][]i64`)
// still fails the build.
@import "modules/std.sx";

Pt :: struct { x: i64; y: i64; }

mkScalar :: () -> i64 {
    if !@isComptime() { @panic("mkScalar ran at runtime"); }
    42
}
mkStruct :: () -> Pt {
    if !@isComptime() { @panic("mkStruct ran at runtime"); }
    .{ x = 3, y = 4 }
}
mkArr :: () -> [3]i64 {
    if !@isComptime() { @panic("mkArr ran at runtime"); }
    r : [3]i64 = ---;
    r[0] = 10;
    r[1] = 20;
    r[2] = 30;
    r
}
mkOpt :: () -> ?[3]i64 {
    if !@isComptime() { @panic("mkOpt ran at runtime"); }
    r : [3]i64 = ---;
    r[0] = 1;
    r[1] = 2;
    r[2] = 3;
    r
}

main :: () {
    N :: @run mkScalar();
    S :: @run mkStruct();
    A :: @run mkArr();
    O :: @run mkOpt();

    print("N={}\n", N);
    print("S={} {}\n", S.x, S.y);
    print("A={} {} {}\n", A[0], A[1], A[2]);
    v := O?!;
    print("O={}\n", v[1]);
}
