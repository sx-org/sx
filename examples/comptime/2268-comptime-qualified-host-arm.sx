// A `case` arm may qualify its variant with the enum a `@host` field belongs
// to, `target.OperatingSystem`, which is declared in a module the arm need not
// import.
@import "modules/std.sx";

inline match @host.os {
    case target.OperatingSystem.macos: POSIX :: true;
    case target.OperatingSystem.linux: POSIX :: true;
    case target.OperatingSystem.windows: POSIX :: false;
    else: @error("no qualified arm names this host's os");
}

main :: () {
    print("posix: {}\n", POSIX);
}
