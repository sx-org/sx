@import "modules/std.sx";
@import "modules/math";
@import "modules/build.sx";
@import "modules/std/test.sx";
pkg :: @import "tests/fixtures/testpkg";

main :: () {

    // --- inline if (compile-time conditionals) ---
    print("=== inline if ===\n");
    {
        inline if @host.pointerSize == 8 {
            print("64-bit\n");
        } else {
            print("32-bit\n");
        }

        inline if @host.os == .wasm {
            print("wasm\n");
        } else {
            print("not wasm\n");
        }

        // != comparison
        inline if @host.os != .unknown {
            print("known os\n");
        } else {
            print("unknown os\n");
        }

        // nested inline if
        inline if @host.pointerSize != 4 {
            inline if @host.os != .wasm {
                print("desktop 64-bit\n");
            } else {
                print("wasm 64-bit??\n");
            }
        }

        ps := if @host.pointerSize == 8 then "8" else "4";
        print("pointer size via if: {}\n", ps);
    }
}
