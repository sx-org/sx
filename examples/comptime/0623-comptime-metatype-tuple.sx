// Comptime STRUCT metaprogramming for a positional product — `meta.define`
// constructs a struct whose fields are named `"0"` / `"1"`, and `@typeInfo`
// reflects it. Same two paths as 0622:
//   1. Programmatic build:
//      `meta.define(meta.declare("Pair"), .struct(.{ fields = … }))`.
//   2. Round-trip: `meta.define(meta.declare("TripleCopy"), @typeInfo(Triple))`.
@import "modules/std.sx";
@import "modules/std/meta.sx";

Pair :: meta.define(meta.declare("Pair"), .struct(.{ fields = .[
    FieldInfo{ name = "0", type = i64 },
    FieldInfo{ name = "1", type = f64 },
] }));

Triple :: struct { a: i64; b: bool; c: f64 };
TripleCopy :: meta.define(meta.declare("TripleCopy"), @typeInfo(Triple));

main :: () -> i32 {
    p : Pair = .{ 3, 2.5 };
    print("p = {} {}\n", @field(p, 0), @field(p, 1));

    t : TripleCopy = .{ a = 7, b = true, c = 1.5 };
    print("t = {} {} {}\n", t.a, t.b, t.c);
    return 0;
}
