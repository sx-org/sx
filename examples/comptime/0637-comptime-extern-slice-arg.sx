// Comptime host-FFI with a SLICE argument: a `@run` calling a libc function whose
// parameter is a `string` (a `{ptr,len}` fat pointer), not a bare `[*:0]u8`. The VM
// marshals the fat pointer to a NUL-terminated `char*` before the call.
// (A bare `[*:0]u8` arg passes as a word.)
@import "modules/std.sx";

strlen :: (s: string) -> usize extern c.libc;

LEN :: @run strlen("hello, world");

main :: () -> i32 {
    print("len={}\n", LEN);
    return 0;
}
