// Comptime compiler API — field-level reflection readers.
//
// Builds on the `rawFindType` / `rawFieldCount` readers (example 0628) with the
// per-member readers, all on the same plain-`u32`-handle shape (scalar in,
// handle out — no marshaling):
//
//   rawFieldName(t, i) → the i-th member's name handle (StringId)
//   rawFieldType(t, i) → the i-th member's type handle (TypeId)
//   rawTypeName(t)     → a named type's own name handle (StringId)
//
// Reflecting `Pair { lo: Point; hi: Point; }`: read each field's name, and the
// nominal name of each field's type. Chains
// rawIntern → rawFindType → rawField{Name,Type} → (rawTypeName) → rawTextOf,
// all folded at comptime, all serviced natively by the flat-memory VM.

@import "modules/std.sx";


StringId :: u32;
TypeId   :: u32;


Point :: struct { x: i64; y: i64; }
Pair  :: struct { lo: Point; hi: Point; }

pair    :: @run rawFindType(rawIntern("Pair"));
n       :: @run rawFieldCount(rawFindType(rawIntern("Pair")));
f0Name  :: @run rawTextOf(rawFieldName(rawFindType(rawIntern("Pair")), 0));
f1Name  :: @run rawTextOf(rawFieldName(rawFindType(rawIntern("Pair")), 1));
// field 0's type is `Point` — read its nominal name through the type handle.
f0Type :: @run rawTextOf(rawTypeName(rawFieldType(rawFindType(rawIntern("Pair")), 0)));

main :: () {
    print("Pair has {} fields\n", n);
    print("field 0 = {} : {}\n", f0Name, f0Type);
    print("field 1 = {} : {}\n", f1Name, f0Type);
}
