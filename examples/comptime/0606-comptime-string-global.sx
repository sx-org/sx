// The buffer allocated through `c.malloc` at comptime escapes into a static
// byte array; the returned string must point to that array at runtime.
@import "modules/std.sx";

buildGreeting :: () -> string {
    return concat("hello", " world");
}

GREETING :: @run buildGreeting();

main :: () -> i32 {
    print("greeting = '{}'\n", GREETING);
    print("greeting.len = {}\n", GREETING.len);
    return 0;
}
