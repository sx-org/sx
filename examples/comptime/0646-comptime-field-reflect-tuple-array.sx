// Comptime field reflection (`structFieldCount` / `structFieldName` /
// `structFieldType`) over aggregate kinds — struct, enum, and a positional
// anonymous product (`@typeOf(.{…})`).
//
// BOTH the name-array build and the GEP sizing are driven from one source of
// truth (`memberCount`/`memberName`), so they cannot diverge and a
// `structFieldName(T, i)` read is always in bounds. A positional product
// member's name is its index string `"0"`, `"1"`, …
@import "modules/std.sx";

S :: struct { a: i64; b: bool; }
E :: enum { X; Y; Z; }
NamT :: struct { a: i64; b: bool };

main :: () -> i32 {
    // struct: named fields
    print("struct: fc={} fn=({},{}) ft0={}\n",
        structFieldCount(S), structFieldName(S, 0), structFieldName(S, 1), @typeName(structFieldType(S, 0)));

    // enum: variant names (the variant* family — structField* rejects enums)
    print("enum: fc={} fn=({},{},{})\n",
        variantCount(E), variantName(E, 0), variantName(E, 1), variantName(E, 2));

    // positional product: element types, index names
    pos := .{0, false};
    print("posproduct: fc={} ft=({},{}) fn0=[{}]\n",
        structFieldCount(@typeOf(pos)),
        @typeName(structFieldType(@typeOf(pos), 0)), @typeName(structFieldType(@typeOf(pos), 1)),
        structFieldName(@typeOf(pos), 0));

    // named product: element labels recovered
    print("namproduct: fc={} fn=({},{})\n",
        structFieldCount(NamT),
        structFieldName(NamT, 0), structFieldName(NamT, 1));

    // arrays/vectors left the structField* family: lengths/lanes read via
    // `.len` on the VALUE, elements via native indexing (typed).
    arr : [4]i64 = .[10, 20, 30, 40];
    vec : @Vector(4, f32) = .[1.0, 2.0, 3.0, 4.0];
    print("array: len={} a1={}\n", arr.len, arr[1]);
    print("vector: len={} v1={}\n", vec.len, vec[1]);

    return 0;
}
