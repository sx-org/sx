// Comptime field reflection (`struct_field_count` / `struct_field_name` /
// `struct_field_type`) over aggregate kinds — struct, enum, and a positional
// anonymous product (`type_of(.{…})`).
//
// BOTH the name-array build and the GEP sizing are driven from one source of
// truth (`memberCount`/`memberName`), so they cannot diverge and a
// `struct_field_name(T, i)` read is always in bounds. A positional product
// member's name is its index string `"0"`, `"1"`, …
@import "modules/std.sx";

S :: struct { a: i64; b: bool; }
E :: enum { X; Y; Z; }
NamT :: struct { a: i64; b: bool };

main :: () -> i32 {
    // struct: named fields
    print("struct: fc={} fn=({},{}) ft0={}\n",
        struct_field_count(S), struct_field_name(S, 0), struct_field_name(S, 1), type_name(struct_field_type(S, 0)));

    // enum: variant names (the variant_* family — struct_field_* rejects enums)
    print("enum: fc={} fn=({},{},{})\n",
        variant_count(E), variant_name(E, 0), variant_name(E, 1), variant_name(E, 2));

    // positional product: element types, index names
    pos := .{0, false};
    print("posproduct: fc={} ft=({},{}) fn0=[{}]\n",
        struct_field_count(type_of(pos)),
        type_name(struct_field_type(type_of(pos), 0)), type_name(struct_field_type(type_of(pos), 1)),
        struct_field_name(type_of(pos), 0));

    // named product: element labels recovered
    print("namproduct: fc={} fn=({},{})\n",
        struct_field_count(NamT),
        struct_field_name(NamT, 0), struct_field_name(NamT, 1));

    // arrays/vectors left the struct_field_* family: lengths/lanes read via
    // `.len` on the VALUE, elements via native indexing (typed).
    arr : [4]i64 = .[10, 20, 30, 40];
    vec : @Vector(4, f32) = .[1.0, 2.0, 3.0, 4.0];
    print("array: len={} a1={}\n", arr.len, arr[1]);
    print("vector: len={} v1={}\n", vec.len, vec[1]);

    return 0;
}
