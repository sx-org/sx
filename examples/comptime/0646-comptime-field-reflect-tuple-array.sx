// Comptime member reflection (`.len` / `.name` / `.type`) over aggregate kinds
// — struct, enum, and a positional anonymous product (`@typeOf(.{…})`).
// A positional product member's name is its index string `"0"`, `"1"`, …
@import "modules/std.sx";

S :: struct { a: i64; b: bool; }
E :: enum { X; Y; Z; }
NamT :: struct { a: i64; b: bool };

main :: () -> i32 {
    // struct: named fields
    print("struct: fc={} fn=({},{}) ft0={}\n",
        @typeInfo(S).struct.fields.len,
        @typeInfo(S).struct.fields[0].name, @typeInfo(S).struct.fields[1].name,
        @typeName(@typeInfo(S).struct.fields[0].type));

    // enum: variant names, off the `.enum` member list
    print("enum: fc={} fn=({},{},{})\n",
        @typeInfo(E).enum.fields.len,
        @typeInfo(E).enum.fields[0].name, @typeInfo(E).enum.fields[1].name, @typeInfo(E).enum.fields[2].name);

    // positional product: element types, index names
    pos := .{0, false};
    print("posproduct: fc={} ft=({},{}) fn0=[{}]\n",
        @typeInfo(@typeOf(pos)).struct.fields.len,
        @typeName(@typeInfo(@typeOf(pos)).struct.fields[0].type),
        @typeName(@typeInfo(@typeOf(pos)).struct.fields[1].type),
        @typeInfo(@typeOf(pos)).struct.fields[0].name);

    // named product: element labels recovered
    print("namproduct: fc={} fn=({},{})\n",
        @typeInfo(NamT).struct.fields.len,
        @typeInfo(NamT).struct.fields[0].name, @typeInfo(NamT).struct.fields[1].name);

    // arrays/vectors carry no reflected member list: lengths/lanes read via
    // `.len` on the VALUE, elements via native indexing (typed).
    arr : [4]i64 = .[10, 20, 30, 40];
    vec : @Vector(4, f32) = .[1.0, 2.0, 3.0, 4.0];
    print("array: len={} a1={}\n", arr.len, arr[1]);
    print("vector: len={} v1={}\n", vec.len, vec[1]);

    return 0;
}
