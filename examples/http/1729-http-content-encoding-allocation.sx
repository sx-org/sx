// An allocation failure in std.http's content-encoding paths unwinds with
// nothing leaked: each allocation of the gzip and deflate encoded producers and
// of the out channel, the first of response serialization, and the client's
// response storage and the first allocation of its decoder.
@import "modules/std.sx";
@import "modules/std/http.sx";
wire :: @import "modules/std/http/wire.sx";

FailingAllocator :: struct {
    parent: Allocator;
    failAt: i64;
    sequence: i64 = 0;
    failures: i64 = 0;
    live: i64 = 0;
}

impl Allocator for FailingAllocator {
    allocBytes :: (self: *FailingAllocator, size: i64) -> *void {
        self.sequence += 1;
        if self.failAt > 0 and self.sequence == self.failAt {
            self.failures += 1;
            return null;
        }
        raw := self.parent.allocBytes(size);
        if raw != null { self.live += 1; }
        raw
    }

    deallocBytes :: (self: *FailingAllocator, ptr: *void) {
        if ptr == null { return; }
        self.live -= 1;
        self.parent.deallocBytes(ptr);
    }
}

emptySource :: (ctx: usize, offset: i64, dst: [*]u8, cap: i64) -> i64 { 0 }

encodedCase :: (encoding: wire.Encoding, failAt: i64) -> (bool, i64) {
    gpa := GPA.init();
    failing : FailingAllocator = .{ parent = gpa, failAt = failAt };
    state := wire.createEncodedProducer(encoding, 6, emptySource, 0, failing);
    success := state != null;
    if state != null { wire.destroyEncodedProducer(state, failing); }
    expected := if failAt == 0 then success and failing.failures == 0
                else !success and failing.failures == 1;
    return expected and failing.live == 0 and gpa.allocCount == 0, failing.sequence;
}

encodedSweep :: (encoding: wire.Encoding) -> bool {
    baseline, count := encodedCase(encoding, 0);
    if !baseline or count <= 1 { return false; }
    at : i64 = 1;
    while at <= count {
        ok, _ := encodedCase(encoding, at);
        if !ok { return false; }
        at += 1;
    }
    true
}

outChanCase :: (lp: event.Loop, failAt: i64) -> (bool, i64) {
    gpa := GPA.init();
    failing : FailingAllocator = .{ parent = gpa, failAt = failAt };
    channel := wire.createOutChan(failing, lp);
    success := channel != null;
    if channel != null { channel.release(); }
    expected := if failAt == 0 then success and failing.failures == 0
                else !success and failing.failures == 1;
    return expected and failing.live == 0 and gpa.allocCount == 0, failing.sequence;
}

outChanSweep :: () -> bool {
    lp, le := event.Loop.init();
    if le { return false; }
    baseline, count := outChanCase(lp, 0);
    ok := baseline and count >= 2;
    at : i64 = 1;
    while ok and at <= count {
        passed, _ := outChanCase(lp, at);
        ok = passed;
        at += 1;
    }
    lp.close();
    ok
}

serializationCase :: (chunked: bool, fail: bool) -> bool {
    gpa := GPA.init();
    failing : FailingAllocator = .{ parent = gpa, failAt = if fail then 1 else 0 };
    resp : http.Response = .{ body = "body" };
    date := "Thu, 01 Jan 1970 00:00:00 GMT";
    output := if chunked
        then wire.serializeChunkedHead(*resp, true, failing, date, "")
        else wire.serializeBytes(*resp, true, failing, false, date, "");
    success := output.buf != null;
    if output.buf != null { failing.deallocBytes(output.buf); }
    expected := if fail then !success and failing.failures == 1 else success;
    expected and failing.live == 0 and gpa.allocCount == 0
}

writeAll :: (fd: i32, data: string) -> bool {
    at : i64 = 0;
    while at < data.len {
        n := c.write(fd, *data.ptr[at], (data.len - at));
        if n <= 0 { return false; }
        at += n;
    }
    true
}

clientDecoderAllocation :: (packed: string, failAt: i64) -> bool {
    gpa := GPA.init();
    failing : FailingAllocator = .{ parent = gpa, failAt = failAt };
    pair : [2]i32 = ---;
    if socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM, 0, *pair[0]) != 0 { return false; }
    head := "HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nConnection: close\r\n\r\n";
    sent := writeAll(pair[1], head) and writeAll(pair[1], packed);
    c.close(pair[1]);
    failure := false;
    push .{ allocator = failing } {
        response, e := http.Client.recv(pair[0]);
        if !e { response.deinit(); }
        failure = e == .Allocation;
    }
    c.close(pair[0]);
    sent and failure and failing.failures == 1 and failing.live == 0
        and gpa.allocCount == 0
}

main :: () -> i32 {
    gpa := GPA.init();
    packed := gzip.encode("allocation-probe", .{}, .{}, gpa) catch { return 2; };
    ok := encodedSweep(.gzip) and encodedSweep(.deflate)
        and outChanSweep()
        and serializationCase(false, false)
        and serializationCase(false, true)
        and serializationCase(true, false)
        and serializationCase(true, true)
        and clientDecoderAllocation(packed, 1)
        and clientDecoderAllocation(packed, 2);
    gpa.deallocBytes(packed.ptr);
    if !ok or gpa.allocCount != 0 {
        print("http content-encoding allocation sweep failed; leaks={}\n", gpa.allocCount);
        return 1;
    }
    print("http content-encoding allocation failures cleanly unwind\n");
    0
}
