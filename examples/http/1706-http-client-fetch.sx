// std.http — client conveniences: URL fetch, redirect following, and
// keep-alive connection pooling.
//
//   Client.fetch(method, url, body, opts, buf, cap)
//       — parse the URL (http/https, host, optional :port, path), open
//         (https requires opts.tls — `ClientErr.Tls` without), send, receive,
//         and follow redirects up to opts.maxRedirects: 301/302/303
//         switch to GET and drop the body; 307/308 keep method + body;
//         a cross-host Location re-resolves and re-dials. Exceeding the
//         cap is `ClientErr.Redirect`.
//   ClientOpts.maxRedirects (default 5; 0 = return the 3xx as-is)
//   ClientPool
//       — single-threaded keep-alive reuse keyed host:port:
//         pool.fetch(...) reuses an open conn when one exists; a REUSED
//         conn that faults at send/first-read is retried ONCE on a fresh
//         dial (the stale-keep-alive race); pool.close() closes all.
//
// Cases (servers on background threads; the client is blocking):
//   A. plain fetch → 200.
//   B. redirect chain /r1 → /r2 → /final (302s) lands 200 with the hop
//      count visible to the server; 303 after POST arrives as a GET with
//      no body; 307 after POST arrives as a POST with the body intact.
//   C. a 302 loop errors with `ClientErr.Redirect` after maxRedirects; with
//      maxRedirects = 0 the 302 itself is returned un-followed.
//   D. https fetch through opts.tls → 200; the SAME url without a dialer
//      → `ClientErr.Tls` (never plaintext-to-a-TLS-port).
//   E. pooling: five pooled fetches ride ONE server connection
//      (acceptedTotal == 1); after the server evicts the idle conn
//      (short keep-alive timeout), the next pooled fetch transparently
//      redials (acceptedTotal == 2, still 200).
//   F. cross-host redirect: server A 302s to server B (different port) —
//      fetch follows, re-resolves, lands 200 on B.
//   + net-zero GPA gate.
@import "modules/std.sx";
socket :: @import "modules/std/socket.sx";
http   :: @import "modules/std/http.sx";
tlsp   :: @import "modules/std/http/tls_mbedtls.sx";

PORT_A   :: 19027;   // main plaintext server
PORT_B   :: 19028;   // cross-host redirect target
PORT_TLS :: 19029;   // TLS server (case D)

handlerA :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    _ := ctx;
    if req.path == "/hello" { resp.body = "fetched"; return; }
    if req.path == "/r1" {
        resp.status = 302;
        resp.addHeader("Location", "/r2");
        resp.body = "hop";
        return;
    }
    if req.path == "/r2" {
        resp.status = 302;
        resp.addHeader("Location", "/final");
        resp.body = "hop";
        return;
    }
    if req.path == "/final" {
        // echo the arriving method + whether a body came along — the
        // redirect-semantics cases assert on this
        if req.method == "GET" and req.body.len == 0 { resp.body = "final-get"; return; }
        if req.method == "POST" { resp.body = concat("final-post:", req.body); return; }
        resp.body = "final-other";
        return;
    }
    if req.path == "/r303" {
        resp.status = 303;
        resp.addHeader("Location", "/final");
        resp.body = "see-other";
        return;
    }
    if req.path == "/r307" {
        resp.status = 307;
        resp.addHeader("Location", "/final");
        resp.body = "preserve";
        return;
    }
    if req.path == "/loop" {
        resp.status = 302;
        resp.addHeader("Location", "/loop");
        resp.body = "again";
        return;
    }
    if req.path == "/xhost" {
        resp.status = 302;
        resp.addHeader("Location", "http://localhost:19028/final");
        resp.body = "hop-host";
        return;
    }
    resp.body = "pong";
}

handlerB :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    _ := ctx;
    if req.path == "/final" { resp.body = "b-final"; return; }
    resp.status = 404;
    resp.body = "b-404";
}

srvEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = xx arg;
    gpa := GPA.init();
    push .{ allocator = gpa } {
        srv.run();
    }
    return null;
}

main :: () -> i32 {
    gpa := GPA.init();
    rc : i32 = 1;
    push .{ allocator = gpa } { rc = run(); }
    leaked := gpa.allocCount;
    if rc != 0 { print("FAIL: case rc={}\n", rc); return rc; }
    if leaked != 0 { print("LEAK: {} outstanding allocations\n", leaked); return 7; }
    print("fetch ok: url round-trip, 302 chain + 303-to-GET + 307-preserves-POST, loop capped + uncapped-returns-3xx, https gated on a dialer, pool reused one conn + redialed after eviction, cross-host followed; net-zero GPA\n");
    0
}

run :: () -> i32 {
    // Short keep-alive so the eviction leg (C) proves expiry+redial without
    // dominating the 1s corpus run budget; still wide vs. the back-to-back
    // pooled fetches whose reuse it must NOT interrupt.
    cfgA : http.Config = .{ port = PORT_A, timeoutRequestMs = 5000,
                             timeoutKeepaliveMs = 250, maxConn = 16 };
    srvA, seA := http.Server.init(cfgA, handlerA, 0);
    if seA { return 2; }
    ta, tae := thread.Thread.spawn(srvEntry, *srvA);
    if tae { return 3; }
    // dual-stack: the cross-host Location names "localhost", which the
    // resolver may answer with ::1 — B must serve either family.
    cfgB : http.Config = .{ port = PORT_B, bindAddr = "::", timeoutRequestMs = 5000, maxConn = 8 };
    srvB, seB := http.Server.init(cfgB, handlerB, 0);
    if seB { srvA.stop(); ta.join(); return 4; }
    tb, tbe := thread.Thread.spawn(srvEntry, *srvB);
    if tbe { srvA.stop(); ta.join(); return 5; }

    opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 3000 };
    buf : [8192]u8 = ---;

    // ── A. plain fetch ──
    r1, e1 := http.Client.fetch("GET", "http://127.0.0.1:19027/hello", "", opts, *buf[0], 8192);
    if e1 { return teardown(90, *srvA, *ta, *srvB, *tb); }
    if r1.status != 200 or r1.body != "fetched" { return teardown(10, *srvA, *ta, *srvB, *tb); }

    // ── B. redirects: chain, 303→GET, 307 preserves POST ──
    r2, e2 := http.Client.fetch("GET", "http://127.0.0.1:19027/r1", "", opts, *buf[0], 8192);
    if e2 { return teardown(91, *srvA, *ta, *srvB, *tb); }
    if r2.status != 200 or r2.body != "final-get" { return teardown(11, *srvA, *ta, *srvB, *tb); }
    r3, e3 := http.Client.fetch("POST", "http://127.0.0.1:19027/r303", "payload", opts, *buf[0], 8192);
    if e3 { return teardown(92, *srvA, *ta, *srvB, *tb); }
    if r3.status != 200 or r3.body != "final-get" { return teardown(12, *srvA, *ta, *srvB, *tb); }
    r4, e4 := http.Client.fetch("POST", "http://127.0.0.1:19027/r307", "payload", opts, *buf[0], 8192);
    if e4 { return teardown(93, *srvA, *ta, *srvB, *tb); }
    if r4.status != 200 or r4.body != "final-post:payload" { return teardown(13, *srvA, *ta, *srvB, *tb); }

    // ── C. loop capped; maxRedirects = 0 returns the 3xx ──
    _, e5 := http.Client.fetch("GET", "http://127.0.0.1:19027/loop", "", opts, *buf[0], 8192);
    if e5 != .Redirect { return teardown(14, *srvA, *ta, *srvB, *tb); }
    opts0 := opts;
    opts0.maxRedirects = 0;
    r6, e6 := http.Client.fetch("GET", "http://127.0.0.1:19027/r1", "", opts0, *buf[0], 8192);
    if e6 { return teardown(94, *srvA, *ta, *srvB, *tb); }
    if r6.status != 302 { return teardown(15, *srvA, *ta, *srvB, *tb); }

    // ── F. cross-host redirect (A → B) ──
    r7, e7 := http.Client.fetch("GET", "http://127.0.0.1:19027/xhost", "", opts, *buf[0], 8192);
    if e7 { return teardown(95, *srvA, *ta, *srvB, *tb); }
    if r7.status != 200 or r7.body != "b-final" { return teardown(16, *srvA, *ta, *srvB, *tb); }

    // ── E. pooling: five fetches, one conn; redial after eviction ──
    acceptsBefore := srvA.stats().acceptedTotal;
    pool := http.ClientPool.init(opts);
    k : i64 = 0;
    while k < 5 {
        rp, ep := pool.fetch("GET", "http://127.0.0.1:19027/hello", "", *buf[0], 8192);
        if ep { pool.close(); return teardown(96, *srvA, *ta, *srvB, *tb); }
        if rp.status != 200 or rp.body != "fetched" { pool.close(); return teardown(17, *srvA, *ta, *srvB, *tb); }
        k += 1;
    }
    st1 := srvA.stats();
    // the direct fetches above used their own conns; the POOLED five must
    // have added exactly ONE accept
    if st1.acceptedTotal != acceptsBefore + 1 { pool.close(); return teardown(21, *srvA, *ta, *srvB, *tb); }
    base := st1.acceptedTotal;
    rp2, ep2 := pool.fetch("GET", "http://127.0.0.1:19027/hello", "", *buf[0], 8192);
    if ep2 { pool.close(); return teardown(97, *srvA, *ta, *srvB, *tb); }
    _ := rp2;
    st2 := srvA.stats();
    if st2.acceptedTotal != base { pool.close(); return teardown(18, *srvA, *ta, *srvB, *tb); }   // reused, no new accept
    // let the server evict the idle pooled conn (keepalive 250ms; 2x margin)...
    sleepMs(500);
    // ...then the pool must transparently redial.
    rp3, ep3 := pool.fetch("GET", "http://127.0.0.1:19027/hello", "", *buf[0], 8192);
    if ep3 { pool.close(); return teardown(98, *srvA, *ta, *srvB, *tb); }
    if rp3.status != 200 or rp3.body != "fetched" { pool.close(); return teardown(19, *srvA, *ta, *srvB, *tb); }
    st3 := srvA.stats();
    if st3.acceptedTotal != base + 1 { pool.close(); return teardown(20, *srvA, *ta, *srvB, *tb); }
    pool.close();

    // ── D. https gated on a dialer ──
    ts : tlsp.TlsServer = .{};
    if !ts.setupFiles("examples/http/1705-http-client-transport/cert.pem",
                       "examples/http/1705-http-client-transport/key.pem",
                       context.allocator) { return teardown(30, *srvA, *ta, *srvB, *tb); }
    cfgT : http.Config = .{ port = PORT_TLS, timeoutRequestMs = 5000, maxConn = 8 };
    cfgT.tls = xx *ts;
    srvT, seT := http.Server.init(cfgT, handlerA, 0);
    if seT { return teardown(31, *srvA, *ta, *srvB, *tb); }
    tt, tte := thread.Thread.spawn(srvEntry, *srvT);
    if tte { return teardown(32, *srvA, *ta, *srvB, *tb); }
    tcc : tlsp.TlsClientConfig = .{};
    if !tcc.setupFiles("examples/http/1705-http-client-transport/cert.pem", context.allocator) {
        srvT.stop(); tt.join(); srvT.close();
        return teardown(33, *srvA, *ta, *srvB, *tb);
    }
    optsTls := opts;
    optsTls.tls = xx *tcc;
    optsTls.tlsHost = "client-transport.test";
    rt, et := http.Client.fetch("GET", "https://127.0.0.1:19029/hello", "", optsTls, *buf[0], 8192);
    if et { tcc.deinit(); srvT.stop(); tt.join(); srvT.close(); return teardown(99, *srvA, *ta, *srvB, *tb); }
    if rt.status != 200 or rt.body != "fetched" {
        tcc.deinit(); srvT.stop(); tt.join(); srvT.close();
        return teardown(34, *srvA, *ta, *srvB, *tb);
    }
    // pooled https: two pooled fetches must ride ONE TLS conn.
    tlsAccepts0 := srvT.stats().acceptedTotal;
    tpool := http.ClientPool.init(optsTls);
    rq1, eq1 := tpool.fetch("GET", "https://127.0.0.1:19029/hello", "", *buf[0], 8192);
    if eq1 { tpool.close(); tcc.deinit(); srvT.stop(); tt.join(); srvT.close(); return teardown(36, *srvA, *ta, *srvB, *tb); }
    rq2, eq2 := tpool.fetch("GET", "https://127.0.0.1:19029/hello", "", *buf[0], 8192);
    if eq2 { tpool.close(); tcc.deinit(); srvT.stop(); tt.join(); srvT.close(); return teardown(37, *srvA, *ta, *srvB, *tb); }
    if rq1.status != 200 or rq2.status != 200 { tpool.close(); tcc.deinit(); srvT.stop(); tt.join(); srvT.close(); return teardown(38, *srvA, *ta, *srvB, *tb); }
    if srvT.stats().acceptedTotal != tlsAccepts0 + 1 { tpool.close(); tcc.deinit(); srvT.stop(); tt.join(); srvT.close(); return teardown(39, *srvA, *ta, *srvB, *tb); }
    tpool.close();
    // the same https url WITHOUT a dialer must refuse loudly.
    _, en := http.Client.fetch("GET", "https://127.0.0.1:19029/hello", "", opts, *buf[0], 8192);
    srvT.stop();
    tt.join();
    srvT.close();
    tcc.deinit();
    ts.deinit();
    if en != .Tls { return teardown(35, *srvA, *ta, *srvB, *tb); }

    return teardown(0, *srvA, *ta, *srvB, *tb);
}

teardown :: (rc: i32, sa: *http.Server, ta: *thread.Thread, sb: *http.Server, tb: *thread.Thread) -> i32 {
    sa.stop();
    ta.join();
    sa.close();
    sb.stop();
    tb.join();
    sb.close();
    return rc;
}

clib :: @library "c";
usleep :: (usec: i64) -> i32 extern clib;

sleepMs :: (ms: i64) {
    usleep(ms * 1000);
}
