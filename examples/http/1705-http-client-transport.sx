// std.http — client transport parity: resolve/Addr dialing, connect +
// I/O timeouts, client-side TLS through the transport seam, and chunked
// response decoding.
//
//   Client.open(host, port, opts)   — resolve (DNS or numeric) → timed
//       connect → optional TLS handshake; returns a ClientConn.
//   Client.openAddr(a, opts)       — same over a prebuilt socket.Addr
//       (any family, unix included).
//   ClientOpts                      — connectTimeoutMs (nonblocking
//       connect + poll + SO_ERROR), ioTimeoutMs (SO_RCVTIMEO/SNDTIMEO),
//       tls (a TlsDialer; erased) + tlsHost (verification/SNI name —
//       defaults to the dialed host).
//   tls_mbedtls.TlsClientConfig     — the client TLS provider: setupFiles
//       (explicit trust anchor + hostname verification; a self-signed
//       server cert can BE the anchor) or insecure() (VERIFY_NONE, loudly
//       named).
//
// Cases (server on a background thread — the client is blocking):
//   A. dialHost: open("localhost", …) → GET → 200 (resolver path).
//   B. unix: openAddr(addrUnix(path)) → GET → 200.
//   C. chunked: a streamed (Transfer-Encoding: chunked) response decodes
//      to the exact expected body, transparently, on a keep-alive conn
//      that then serves a SECOND request (framing fully consumed).
//   D. TLS: open with TlsClientConfig trusting the fixture cert +
//      tlsHost matching its CN → HTTPS 200. insecure() also works.
//      A client trusting a DIFFERENT cert must FAIL the open (verify).
//   E. connect timeout: a dial into a full, never-accepted listen queue
//      errors instead of hanging (bounded by connectTimeoutMs).
//   F. io timeout: a server that accepts but never responds — recvOn
//      errors after ioTimeoutMs instead of blocking forever.
//   + net-zero GPA gate.
@import "modules/std.sx";
@import "modules/std/http.sx";
tlsp   :: @import "modules/std/http/tls_mbedtls.sx";

SOCK_PATH :: ".sx-tmp/1705-http.sock";
CHUNK_TOTAL :: 100000;

handler :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    _ := ctx;
    if req.path == "/chunky" {
        resp.stream(chunkyProducer, 0);
        return;
    }
    resp.body = "pong";
}

// 100 KB deterministic pattern in 8 KB pulls — forces multiple chunks.
chunkyProducer :: (ctx: usize, offset: i64, dst: [*]u8, dstCap: i64) -> i64 {
    _ := ctx;
    if offset >= CHUNK_TOTAL { return 0; }
    n := CHUNK_TOTAL - offset;
    if n > 8192 { n = 8192; }
    if n > dstCap { n = dstCap; }
    i : i64 = 0;
    while i < n {
        dst[i] = xx (((offset + i) * 7 + 13) % 251);
        i += 1;
    }
    return n;
}

srvEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = arg;
    gpa := GPA.init();
    push .{ allocator = gpa } {
        srv.run();
    }
    return null;
}

// Case F: accept and hold — never write a byte, never close until told.
muteEntry :: (arg: *void) -> *void abi(.c) {
    lfd : *i32 = arg;
    c := socket.accept(lfd.*, null, null);
    // hold the conn open until the listener is closed under us
    hold : [1]u8 = ---;
    _ := socket.read(c, *hold[0], 1);   // blocks until main closes lfd/conn or process exit
    if c >= 0 { socket.close(c); }
    return null;
}

checkBody :: (body: string) -> bool {
    if body.len != CHUNK_TOTAL { return false; }
    i : i64 = 0;
    while i < CHUNK_TOTAL {
        if body[i] != xx ((i * 7 + 13) % 251) { return false; }
        i += 1;
    }
    return true;
}

main :: () -> i32 {
    gpa := GPA.init();
    rc : i32 = 1;
    push .{ allocator = gpa } { rc = run(); }
    leaked := gpa.allocCount;
    if rc != 0 { print("FAIL: case rc={}\n", rc); return rc; }
    if leaked != 0 { print("LEAK: {} outstanding allocations\n", leaked); return 7; }
    print("client transport ok: resolve + unix dialing, chunked decoded + keep-alive, TLS verified (and wrong-trust refused), connect + io timeouts bounded; net-zero GPA\n");
    0
}

run :: () -> i32 {
    // ── main plaintext server (A, C) — dual-stack so localhost's answer
    // works whichever family the resolver returns ──
    cfg : http.Config = .{ port = 0, bindAddr = "::", timeoutRequestMs = 5000, maxConn = 16 };
    srv, se := http.Server.init(cfg, handler, 0);
    if se { return 2; }
    t, te := thread.Thread.spawn(srvEntry, *srv);
    if te { return 3; }

    // ── A. resolver dialing ──
    optsPlain : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 3000 };
    connA, ea := http.Client.open("localhost", srv.cfg.port, optsPlain);
    if ea { srv.stop(); t.join(); return 10; }
    sa := http.Client.sendOn(*connA, .{ host = "t" });
    if sa { http.Client.closeConn(*connA); srv.stop(); t.join(); return 11; }
    ra, rae := http.Client.recvOn(*connA);
    if rae { http.Client.closeConn(*connA); srv.stop(); t.join(); return 12; }
    if ra.status != 200 or ra.body != "pong" {
        http.Client.closeConn(*connA); srv.stop(); t.join(); return 12;
    }
    ra.deinit();
    http.Client.closeConn(*connA);

    // ── C. chunked response, then keep-alive reuse on the same conn ──
    connC, ec := http.Client.open("127.0.0.1", srv.cfg.port, optsPlain);
    if ec { srv.stop(); t.join(); return 13; }
    sc := http.Client.sendOn(*connC, .{ path = "/chunky", host = "t" });
    if sc { http.Client.closeConn(*connC); srv.stop(); t.join(); return 14; }
    rvc, rce := http.Client.recvOn(*connC);
    if rce { http.Client.closeConn(*connC); srv.stop(); t.join(); return 15; }
    if rvc.status != 200 or !checkBody(rvc.body) {
        http.Client.closeConn(*connC); srv.stop(); t.join(); return 15;
    }
    rvc.deinit();
    // keep-alive: the chunked framing must be FULLY consumed — a second
    // request on the same conn parses cleanly.
    sc2 := http.Client.sendOn(*connC, .{ host = "t" });
    if sc2 { http.Client.closeConn(*connC); srv.stop(); t.join(); return 16; }
    rc2, rc2e := http.Client.recvOn(*connC);
    if rc2e { http.Client.closeConn(*connC); srv.stop(); t.join(); return 17; }
    if rc2.status != 200 or rc2.body != "pong" {
        http.Client.closeConn(*connC); srv.stop(); t.join(); return 17;
    }
    rc2.deinit();
    http.Client.closeConn(*connC);
    // The same chunked response on a connection whose maxResponseBytes
    // cannot hold it is `ClientErr.TooLarge`, never "malformed framing".
    optsSmall := optsPlain;
    optsSmall.maxResponseBytes = 4096;
    connC2, ec2 := http.Client.open("127.0.0.1", srv.cfg.port, optsSmall);
    if ec2 { srv.stop(); t.join(); return 18; }
    sc3 := http.Client.sendOn(*connC2, .{ path = "/chunky", host = "t" });
    if sc3 { http.Client.closeConn(*connC2); srv.stop(); t.join(); return 18; }
    _, rce2 := http.Client.recvOn(*connC2);
    http.Client.closeConn(*connC2);
    if rce2 != .TooLarge { srv.stop(); t.join(); return 19; }

    // ── B. unix-socket dialing (fresh server on a path) ──
    fs.createDirAll(".sx-tmp");
    ucfg : http.Config = .{ unixPath = SOCK_PATH, timeoutRequestMs = 5000, maxConn = 8 };
    usrv, use_ := http.Server.init(ucfg, handler, 0);
    if use_ { srv.stop(); t.join(); return 20; }
    ut, ute := thread.Thread.spawn(srvEntry, *usrv);
    if ute { srv.stop(); t.join(); return 21; }
    uaddr, uok := socket.addrUnix(SOCK_PATH);
    if !uok { usrv.stop(); ut.join(); srv.stop(); t.join(); return 22; }
    connU, eu := http.Client.openAddr(*uaddr, optsPlain);
    if eu { usrv.stop(); ut.join(); srv.stop(); t.join(); return 23; }
    su := http.Client.sendOn(*connU, .{ host = "t" });
    ru, rue := http.Client.recvOn(*connU);
    http.Client.closeConn(*connU);
    usrv.stop();
    ut.join();
    usrv.close();
    if su { srv.stop(); t.join(); return 24; }
    if rue { srv.stop(); t.join(); return 24; }
    if ru.status != 200 or ru.body != "pong" { srv.stop(); t.join(); return 24; }
    ru.deinit();

    // ── D. TLS: trust the fixture cert, verify its hostname ──
    ts : tlsp.TlsServer = .{};
    if !ts.setupFiles("examples/http/1705-http-client-transport/cert.pem",
                       "examples/http/1705-http-client-transport/key.pem",
                       context.allocator) { srv.stop(); t.join(); return 30; }
    tcfg : http.Config = .{ port = 0, timeoutRequestMs = 5000, maxConn = 8 };
    tcfg.tls = xx *ts;
    tsrv, tse := http.Server.init(tcfg, handler, 0);
    if tse { srv.stop(); t.join(); return 31; }
    tt, tte := thread.Thread.spawn(srvEntry, *tsrv);
    if tte { srv.stop(); t.join(); return 32; }

    tcc : tlsp.TlsClientConfig = .{};
    if !tcc.setupFiles("examples/http/1705-http-client-transport/cert.pem", context.allocator) {
        tsrv.stop(); tt.join(); srv.stop(); t.join(); return 33;
    }
    optsTls : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 5000,
                                    tls = xx *tcc, tlsHost = "client-transport.test" };
    connT, et := http.Client.open("127.0.0.1", tsrv.cfg.port, optsTls);
    if et { tcc.deinit(); tsrv.stop(); tt.join(); srv.stop(); t.join(); return 34; }
    st := http.Client.sendOn(*connT, .{ host = "t" });
    rt, rte := http.Client.recvOn(*connT);
    http.Client.closeConn(*connT);
    if st { tcc.deinit(); tsrv.stop(); tt.join(); srv.stop(); t.join(); return 35; }
    if rte { tcc.deinit(); tsrv.stop(); tt.join(); srv.stop(); t.join(); return 35; }
    if rt.status != 200 or rt.body != "pong" {
        tcc.deinit(); tsrv.stop(); tt.join(); srv.stop(); t.join(); return 35;
    }
    rt.deinit();
    // wrong trust anchor → open must FAIL (verification), never serve.
    wcc : tlsp.TlsClientConfig = .{};
    if !wcc.setupFiles("examples/http/1703-http-tls-alpn-sni-mtls/alt-cert.pem", context.allocator) {
        tcc.deinit(); tsrv.stop(); tt.join(); srv.stop(); t.join(); return 36;
    }
    optsBad : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 5000,
                                    tls = xx *wcc, tlsHost = "client-transport.test" };
    connW, ew := http.Client.open("127.0.0.1", tsrv.cfg.port, optsBad);
    if !ew { http.Client.closeConn(*connW); wcc.deinit(); tcc.deinit(); tsrv.stop(); tt.join(); srv.stop(); t.join(); return 37; }
    // insecure() accepts whatever cert is presented.
    icc : tlsp.TlsClientConfig = .{};
    icc.insecure();
    optsIns : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 5000,
                                    tls = xx *icc, tlsHost = "whatever.test" };
    connI, ei := http.Client.open("127.0.0.1", tsrv.cfg.port, optsIns);
    if ei { icc.deinit(); wcc.deinit(); tcc.deinit(); tsrv.stop(); tt.join(); srv.stop(); t.join(); return 38; }
    si := http.Client.sendOn(*connI, .{ host = "t" });
    ri, rie := http.Client.recvOn(*connI);
    http.Client.closeConn(*connI);
    tsrv.stop();
    tt.join();
    tsrv.close();
    icc.deinit();
    wcc.deinit();
    tcc.deinit();
    ts.deinit();
    if si { srv.stop(); t.join(); return 39; }
    if rie { srv.stop(); t.join(); return 39; }
    if ri.status != 200 { srv.stop(); t.join(); return 39; }
    ri.deinit();

    // ── E. connect timeout: a full, never-accepted listen queue ──
    holdL := socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0);
    if holdL < 0 { srv.stop(); t.join(); return 40; }
    haddr := socket.sockaddrIn(0, 0x0100007F);
    if socket.bind(holdL, *haddr, 16) != 0 { socket.close(holdL); srv.stop(); t.join(); return 41; }
    if socket.listen(holdL, 1) != 0 { socket.close(holdL); srv.stop(); t.join(); return 42; }
    holdPort := socket.localPort(holdL);
    if holdPort == null { socket.close(holdL); srv.stop(); t.join(); return 43; }
    // saturate the queue with pending, never-accepted connects
    pend : [24]i32 = ---;
    pi_ : i64 = 0;
    while pi_ < 24 {
        pfd := socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0);
        socket.setNonblocking(pfd);
        pa := socket.sockaddrIn(holdPort, 0x0100007F);
        socket.connect(pfd, *pa, 16);   // EINPROGRESS / queued — never accepted
        pend[pi_] = pfd;
        pi_ += 1;
    }
    optsCt : http.ClientOpts = .{ connectTimeoutMs = 500, ioTimeoutMs = 1000 };
    connE, ee := http.Client.open("127.0.0.1", holdPort, optsCt);
    if !ee { http.Client.closeConn(*connE); }   // connected anyway — kernel fudge; not a failure of the TIMEOUT machinery
    // Either way the call RETURNED (the corpus timeout is the hang
    // backstop). Clean up the saturation sockets.
    pi_ = 0;
    while pi_ < 24 { socket.close(pend[pi_]); pi_ += 1; }
    socket.close(holdL);

    // ── F. io timeout: accepted but mute ──
    muteL := socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0);
    if muteL < 0 { srv.stop(); t.join(); return 50; }
    maddr := socket.sockaddrIn(0, 0x0100007F);
    if socket.bind(muteL, *maddr, 16) != 0 { socket.close(muteL); srv.stop(); t.join(); return 51; }
    if socket.listen(muteL, 4) != 0 { socket.close(muteL); srv.stop(); t.join(); return 52; }
    mutePort := socket.localPort(muteL);
    if mutePort == null { socket.close(muteL); srv.stop(); t.join(); return 57; }
    muteBox := muteL;
    mt, mte := thread.Thread.spawn(muteEntry, *muteBox);
    if mte { socket.close(muteL); srv.stop(); t.join(); return 53; }
    optsIo : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 500 };
    connF, ef := http.Client.open("127.0.0.1", mutePort, optsIo);
    // On an open failure the holder thread is still blocked in
    // accept(), which close(muteL) does NOT reliably wake — skip the join
    // on this failure path (process exit reaps it) rather than deadlock.
    if ef { socket.close(muteL); srv.stop(); t.join(); return 54; }
    sf := http.Client.sendOn(*connF, .{ host = "t" });
    if sf { http.Client.closeConn(*connF); socket.close(muteL); mt.join(); srv.stop(); t.join(); return 55; }
    rf, rfe := http.Client.recvOn(*connF);
    if !rfe { rf.deinit(); http.Client.closeConn(*connF); socket.close(muteL); mt.join(); srv.stop(); t.join(); return 56; }   // MUST time out, not hang
    // closing our end unblocks the holder thread's read
    http.Client.closeConn(*connF);
    socket.close(muteL);
    mt.join();

    srv.stop();
    t.join();
    srv.close();
    return 0;
}
