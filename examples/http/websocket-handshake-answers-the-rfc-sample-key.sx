// The handshake answers RFC 6455's sample key (§1.3) with its sample accept
// value. From the same accept call, a request for another protocol version
// gets 426 naming version 13, and a malformed key gets 400.
@import "modules/std.sx";
@import "modules/std/http.sx";
@import "modules/std/http/websocket.sx";

LOOPBACK :u32: 0x0100007F;

hWs :: (rc: *http.RouteCtx) { websocket.accept(rc, .{}); }

srvEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = arg;
    gpa := GPA.init();
    push .{ allocator = gpa } { srv.run(); }
    return null;
}

upgrade :: (key: string, version: string) -> string {
    return concat("GET /ws HTTP/1.1\r\nHost: t\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n",
        "Sec-WebSocket-Key: ", key, "\r\nSec-WebSocket-Version: ", version, "\r\n\r\n");
}

// Send `request` on a fresh connection and print the response's status line
// and its `name` field.
show :: (port: i64, request: string, name: string) {
    fd := socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0);
    a := socket.sockaddrIn(port, LOOPBACK);
    if socket.connect(fd, *a, 16) != 0 { print("connect failed\n"); return; }
    socket.setIoTimeout(fd, 3000);
    socket.write(fd, request.ptr, request.len);
    buf := mem.alloc(context.allocator, u8, 4096);
    defer mem.free(context.allocator, buf);
    got := 0;
    head := 0;
    while head == 0 and got < buf.len {
        n := socket.read(fd, *buf[got], buf.len - got);
        if n <= 0 { break; }
        got += n;
        i := 0;
        while i + 3 < got {
            if buf[i] == '\r' and buf[i + 1] == '\n' and buf[i + 2] == '\r' and buf[i + 3] == '\n' { head = i + 2; break; }
            i += 1;
        }
    }
    socket.close(fd);
    line := 0;
    while line < head and buf[line] != '\r' { line += 1; }
    print("{}\n", string{ ptr = buf.ptr, len = line });
    if name.len == 0 { return; }
    req : http.Request = .{ headersRaw = string{ ptr = *buf[line + 2], len = head - line - 2 } };
    print("{}: {}\n", name, http.findHeader(*req, name));
}

main :: () -> i32 {
    router := http.Router.init(0);
    router.get("/ws", hWs);
    cfg : http.Config = .{ port = 0, threadPoolCount = 1, streamRequestBody = true };
    srv, se := http.Server.init(cfg, http.dispatch, @reinterpret(usize, *router));
    if se { return 1; }
    t, te := thread.Thread.spawn(srvEntry, *srv);
    if te { return 1; }
    sample := upgrade("dGhlIHNhbXBsZSBub25jZQ==", "13");
    show(srv.cfg.port, sample, "sec-websocket-accept");
    other := upgrade("dGhlIHNhbXBsZSBub25jZQ==", "12");
    show(srv.cfg.port, other, "sec-websocket-version");
    bad := upgrade("not-a-key", "13");
    show(srv.cfg.port, bad, "");
    srv.stop();
    t.join();
    srv.close();
    router.deinit();
    0
}
