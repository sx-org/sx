// std.http content-encoding invariants across inline, pool, and fiber modes.
// Pins same-connection no-body framing, negotiation edge cases, range and
// validator policy, producer-fault wire semantics, and cooperative progress.

@import "modules/std.sx";
@import "modules/std/atomic.sx";
@import "modules/std/http.sx";
fiberSched :: @import "modules/std/http/fiber_sched.sx";
@import "modules/std/mem.sx";

BODY_LEN :: 32768;
HUGE_CALLS :: 1000000;

App :: struct {
    body: string;
    gzipBody: string;
    deflateBody: string;
    streamCalls: atomic.Atomic(i64);
    hugeCalls: atomic.Atomic(i64);
    pingSeen: atomic.Atomic(i64);
}

same :: (a: string, b: string) -> bool {
    if a.len != b.len { return false; }
    i : i64 = 0;
    while i < a.len { if a[i] != b[i] { return false; } i += 1; }
    true
}

contains :: (value: string, needle: string) -> bool {
    if needle.len == 0 { return true; }
    at : i64 = 0;
    while at + needle.len <= value.len {
        i : i64 = 0;
        while i < needle.len and value[at + i] == needle[i] { i += 1; }
        if i == needle.len { return true; }
        at += 1;
    }
    false
}

endsWith :: (value: string, suffix: string) -> bool {
    if suffix.len > value.len { return false; }
    same(value[value.len - suffix.len..], suffix)
}

countOccurrences :: (value: string, needle: string) -> i64 {
    result : i64 = 0;
    at : i64 = 0;
    while at + needle.len <= value.len {
        if same(value[at..at + needle.len], needle) {
            result += 1;
            at += needle.len;
        } else { at += 1; }
    }
    result
}

streamBody :: (ctx: usize, offset: i64, dst: [*]u8, cap: i64) -> i64 {
    app : *App = @reinterpret(*App, ctx);
    _ := app.streamCalls.fetchAdd(1, .relaxed);
    if offset >= app.body.len { return 0; }
    n := app.body.len - offset;
    if n > 4093 { n = 4093; }
    if n > cap { n = cap; }
    i : i64 = 0;
    while i < n { dst[i] = app.body[offset + i]; i += 1; }
    n
}

faultBefore :: (ctx: usize, offset: i64, dst: [*]u8, cap: i64) -> i64 { -1 }

faultAfter :: (ctx: usize, offset: i64, dst: [*]u8, cap: i64) -> i64 {
    if offset >= 7001 { return -1; }
    n := 7001 - offset;
    if n > cap { n = cap; }
    i : i64 = 0;
    while i < n { dst[i] = 'x'; i += 1; }
    n
}

hugeTinyPieces :: (ctx: usize, offset: i64, dst: [*]u8, cap: i64) -> i64 {
    app : *App = @reinterpret(*App, ctx);
    if offset >= HUGE_CALLS { return 0; }
    _ := app.hugeCalls.fetchAdd(1, .relaxed);
    dst[0] = 'a';
    1
}

route :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    app : *App = @reinterpret(*App, ctx);
    if req.path == "/fixed" { resp.body = app.body; return; }
    if req.path == "/stream" { resp.stream(streamBody, ctx); return; }
    if req.path == "/n204-fixed" { resp.status = 204; resp.body = app.body; return; }
    if req.path == "/n204-stream" { resp.status = 204; resp.stream(streamBody, ctx); return; }
    if req.path == "/n304-fixed" { resp.status = 304; resp.body = app.body; return; }
    if req.path == "/n304-stream" { resp.status = 304; resp.stream(streamBody, ctx); return; }
    if req.path == "/existing-gzip" {
        resp.addHeader("Content-Encoding", "gzip"); resp.body = app.gzipBody; return;
    }
    if req.path == "/existing-stacked" {
        resp.addHeader("Content-Encoding", "br");
        resp.addHeader("Content-Encoding", "gzip");
        resp.body = "stacked";
        return;
    }
    if req.path == "/coded-deflate-206" {
        resp.status = 206;
        resp.addHeader("Content-Range", "bytes 0-9/99");
        resp.addHeader("Content-Encoding", "deflate");
        resp.body = app.deflateBody;
        return;
    }
    if req.path == "/coded-deflate-416" {
        resp.status = 416;
        resp.addHeader("Content-Range", "bytes */99");
        resp.addHeader("Content-Encoding", "deflate");
        resp.body = app.deflateBody;
        return;
    }
    if req.path == "/strong" {
        resp.addHeader("ETag", "\"identity-only\"");
        resp.body = app.body;
        return;
    }
    if req.path == "/fault-before" { resp.stream(faultBefore, ctx); return; }
    if req.path == "/fault-after" { resp.stream(faultAfter, ctx); return; }
    if req.path == "/huge" { resp.stream(hugeTinyPieces, ctx); return; }
    app.pingSeen.store(app.hugeCalls.load(.relaxed), .relaxed);
    resp.body = "pong";
}

serverEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = arg;
    gpa := GPA.init();
    push .{ allocator = gpa } { srv.run(); }
    null
}

requestOn :: (conn: *http.ClientConn, method: string, path: string,
               headers: string) -> (http.ClientResponse, !http.ClientErr) {
    try http.Client.sendOn(conn, .{ method = method, path = path, host = "mode.test", extraHeaders = headers });
    return http.Client.recvOn(conn);
}

pingOn :: (conn: *http.ClientConn) -> bool {
    response, e := requestOn(conn, "GET", "/ping", "Accept-Encoding: identity\r\n");
    !e and response.status == 200 and response.body == "pong"
}

bodylessFollowed :: (app: *App, conn: *http.ClientConn, method: string,
                      path: string, status: i64, streamed: bool) -> bool {
    before := app.streamCalls.load(.relaxed);
    response, e := requestOn(conn, method, path, "");
    ok := !e and response.status == status and response.body.len == 0
        and response.decodedFrom == null;
    if streamed { ok = ok and app.streamCalls.load(.relaxed) == before; }
    if ok { ok = pingOn(conn); }
    ok
}

policyCases :: (app: *App, port: i64) -> bool {
    opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 5000 };
    conn, oe := http.Client.open("127.0.0.1", port, opts);
    if oe { return false; }
    ok := true;

    wildcard, we := requestOn(*conn, "GET", "/fixed",
        "Accept-Encoding: *;q=0.7, identity;q=0\r\n");
    if we or wildcard.decodedFrom == null
        or wildcard.decodedFrom?! != http.ContentCoding.gzip
        or !same(wildcard.body, app.body) { ok = false; }

    duplicate, de := requestOn(*conn, "GET", "/fixed",
        "Accept-Encoding: gzip;q=1, identity;q=0\r\nAccept-Encoding: gzip;q=0, deflate;q=0.5\r\n");
    if de or duplicate.decodedFrom == null
        or duplicate.decodedFrom?! != http.ContentCoding.deflate
        or !same(duplicate.body, app.body) { ok = false; }

    duplicateQ, dqe := requestOn(*conn, "GET", "/fixed",
        "Accept-Encoding: gzip;q=1;q=0, deflate;q=0.4, identity;q=0\r\n");
    if dqe or duplicateQ.decodedFrom == null
        or duplicateQ.decodedFrom?! != http.ContentCoding.deflate { ok = false; }

    malformed, me := requestOn(*conn, "GET", "/fixed",
        "Accept-Encoding: gzip;q=1.1, deflate;q=bogus, identity;q=0\r\n");
    if me or malformed.status != 406 or malformed.body.len != 0 { ok = false; }

    refused, re := requestOn(*conn, "GET", "/existing-gzip",
        "Accept-Encoding: gzip;q=0, identity;q=1\r\n");
    if re or refused.status != 406 { ok = false; }

    partial, pe := requestOn(*conn, "GET", "/coded-deflate-206", "");
    if pe or partial.status != 206 or partial.decodedFrom != null
        or partial.header("content-encoding") != "deflate"
        or !same(partial.body, app.deflateBody) { ok = false; }
    unsatisfied, ue := requestOn(*conn, "GET", "/coded-deflate-416", "");
    if ue or unsatisfied.status != 416 or unsatisfied.decodedFrom != null
        or unsatisfied.header("content-encoding") != "deflate"
        or !same(unsatisfied.body, app.deflateBody) { ok = false; }

    strong, se := requestOn(*conn, "GET", "/strong",
        "Accept-Encoding: deflate, identity;q=0.5\r\n");
    if se or strong.decodedFrom != null or strong.header("etag") != "\"identity-only\""
        or !same(strong.body, app.body) { ok = false; }
    strongRefused, sre := requestOn(*conn, "GET", "/strong",
        "Accept-Encoding: deflate, identity;q=0\r\n");
    if sre or strongRefused.status != 406 { ok = false; }
    http.Client.closeConn(*conn);

    rawOpts : http.ClientOpts = .{
        connectTimeoutMs = 2000, ioTimeoutMs = 5000, acceptCompression = false,
    };
    raw, roe := http.Client.open("127.0.0.1", port, rawOpts);
    if roe { return false; }
    stacked, ste := requestOn(*raw, "GET", "/existing-stacked",
        "Accept-Encoding: *;q=0.5, identity;q=0\r\n");
    if ste or stacked.status != 200 or stacked.body != "stacked"
        or !contains(stacked.headersRaw, "Content-Encoding: br")
        or !contains(stacked.headersRaw, "Content-Encoding: gzip") { ok = false; }
    http.Client.closeConn(*raw);
    ok
}

dialPort :: (port: i64) -> i32 {
    fd := socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0);
    if fd < 0 { return -1; }
    addr := socket.sockaddrIn(port, 0x0100007F);
    if socket.connect(fd, *addr, 16) != 0 { socket.close(fd); return -1; }
    socket.setIoTimeout(fd, 5000);
    fd
}

writeAll :: (fd: i32, data: string) -> bool {
    at : i64 = 0;
    while at < data.len {
        n := socket.write(fd, *data.ptr[at], (data.len - at));
        if n <= 0 { return false; }
        at += n;
    }
    true
}

faultWireCase :: (port: i64, path: string, accept: string) -> bool {
    fd := dialPort(port);
    if fd < 0 { return false; }
    arena := mem.Arena.init(context.allocator, 4096);
    ok := false;
    push .{ allocator = arena } {
        first := concat("GET ", concat(path, concat(" HTTP/1.1\r\nHost: mode.test\r\nAccept-Encoding: ",
            concat(accept, "\r\n\r\n"))));
        pipelined := concat(first, "GET /ping HTTP/1.1\r\nHost: mode.test\r\nConnection: close\r\n\r\n");
        ok = writeAll(fd, pipelined);
    }
    arena.deinit();
    storage : [65536]u8 = ---;
    total : i64 = 0;
    while ok and total < storage.len {
        n := socket.read(fd, *storage[total], (storage.len - total));
        if n <= 0 { break; }
        total += n;
    }
    socket.close(fd);
    wire : string = .{ ptr = *storage[0], len = total };
    ok and contains(wire, "Transfer-Encoding: chunked")
        and countOccurrences(wire, "HTTP/1.1 ") == 1
        and !contains(wire, "pong")
        and !endsWith(wire, "0\r\n\r\n")
}

fairnessCase :: (app: *App, port: i64) -> bool {
    app.hugeCalls.store(0, .relaxed);
    app.pingSeen.store(-1, .relaxed);
    opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 5000 };
    streamConn, se := http.Client.open("127.0.0.1", port, opts);
    if se { return false; }
    sendError := http.Client.sendOn(*streamConn, .{ path = "/huge", host = "mode.test" });
    if sendError { http.Client.closeConn(*streamConn); return false; }

    waits : i64 = 0;
    while app.hugeCalls.load(.relaxed) == 0 and waits < 20000 {
        c.usleep(100);
        waits += 1;
    }
    if app.hugeCalls.load(.relaxed) == 0 { http.Client.closeConn(*streamConn); return false; }

    pingConn, pe := http.Client.open("127.0.0.1", port, opts);
    if pe { http.Client.closeConn(*streamConn); return false; }
    ok := pingOn(*pingConn);
    seen := app.pingSeen.load(.relaxed);
    ok = ok and seen > 0 and seen < HUGE_CALLS;
    http.Client.closeConn(*pingConn);
    http.Client.closeConn(*streamConn);
    ok
}

runMode :: (app: *App, mode: i64) -> bool {
    runner := fiberSched.SchedRunner.init();
    cfg : http.Config = .{
        port = 0,
        maxConn = 16,
        requestCount = 64,
        timeoutRequestMs = 5000,
        timeoutKeepaliveMs = 5000,
        compressResponses = true,
        compressMinSize = 32,
    };
    if mode == 1 { cfg.threadPoolCount = 2; }
    if mode == 2 { cfg.fibers = runner; }
    srv, se := http.Server.init(cfg, route, @reinterpret(usize, app));
    if se { runner.deinit(); return false; }
    port := srv.cfg.port;
    t, te := thread.Thread.spawn(serverEntry, *srv);
    if te { srv.close(); runner.deinit(); return false; }

    // Every response below is read into this arena and returned with it.
    arena := mem.Arena.init(context.allocator, 65536);
    ok := true;
    push .{ allocator = arena } {
        opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 5000 };
        conn, oe := http.Client.open("127.0.0.1", port, opts);
        if oe { ok = false; }
        else {
            ok = bodylessFollowed(app, *conn, "HEAD", "/fixed", 200, false)
                and bodylessFollowed(app, *conn, "HEAD", "/stream", 200, true)
                and bodylessFollowed(app, *conn, "GET", "/n204-fixed", 204, false)
                and bodylessFollowed(app, *conn, "GET", "/n204-stream", 204, true)
                and bodylessFollowed(app, *conn, "GET", "/n304-fixed", 304, false)
                and bodylessFollowed(app, *conn, "GET", "/n304-stream", 304, true);
            http.Client.closeConn(*conn);
        }
        if ok and mode == 0 { ok = policyCases(app, port); }
        if ok and mode != 2 {
            ok = faultWireCase(port, "/fault-before", "identity")
                and faultWireCase(port, "/fault-after", "identity")
                and faultWireCase(port, "/fault-before", "gzip, identity;q=0")
                and faultWireCase(port, "/fault-after", "gzip, identity;q=0");
        }
        if ok { ok = fairnessCase(app, port); }
    }
    arena.deinit();
    srv.stop();
    t.join();
    srv.close();
    runner.deinit();
    ok
}

main :: () -> i32 {
    gpa := GPA.init();
    ok := true;
    push .{ allocator = gpa } {
        raw := context.allocator.allocBytes(BODY_LEN);
        if raw == null { return 2; }
        body : string = .{ ptr = raw.([*]u8), len = BODY_LEN };
        i : i64 = 0;
        while i < body.len { body.ptr[i] = ('a' + ((i / 97) % 17)).(u8); i += 1; }
        gz := gzip.encode(body) catch { context.allocator.deallocBytes(raw); return 2; };
        zl := zlib.encode(body) catch {
            context.allocator.deallocBytes(gz.ptr);
            context.allocator.deallocBytes(raw);
            return 2;
        };
        app : App = .{
            body = body,
            gzipBody = gz,
            deflateBody = zl,
            streamCalls = atomic.Atomic(i64).init(0),
            hugeCalls = atomic.Atomic(i64).init(0),
            pingSeen = atomic.Atomic(i64).init(-1),
        };
        ok = runMode(*app, 0);
        if ok { ok = runMode(*app, 1); }
        if ok { ok = runMode(*app, 2); }
        context.allocator.deallocBytes(zl.ptr);
        context.allocator.deallocBytes(gz.ptr);
        context.allocator.deallocBytes(raw);
    }
    if !ok or gpa.allocCount != 0 {
        print("http content-encoding mode matrix failed; leaks={}\n", gpa.allocCount);
        return 1;
    }
    print("http content-encoding inline/pool/fiber framing, faults, policy, fairness ok\n");
    0
}
