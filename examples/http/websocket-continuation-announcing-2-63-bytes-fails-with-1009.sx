// A continuation frame announcing 2^63-1 bytes, past what the reassembled
// message's length plus the frame's can sum to in an i64, fails the server's
// connection with 1009.
@import "modules/std.sx";
@import "modules/std/http.sx";
@import "modules/std/http/websocket.sx";

LOOPBACK :u32: 0x0100007F;

closedCode : i64 = 0;

onClose :: (c: *websocket.Conn, code: i64, ctx: *void) { @atomicStore(i64, *closedCode, code, .release); }

hWs :: (rc: *http.RouteCtx) { websocket.accept(rc, .{ onClose = onClose }); }

srvEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = arg;
    gpa := GPA.init();
    push .{ allocator = gpa } { srv.run(); }
    return null;
}

readAll :: (fd: i32, dst: [*]u8, n: i64) -> bool {
    got := 0;
    while got < n {
        k := socket.read(fd, *dst[got], n - got);
        if k <= 0 { return false; }
        got += k;
    }
    true
}

main :: () -> i32 {
    router := http.Router.init(0);
    router.get("/ws", hWs);
    cfg : http.Config = .{ port = 0, threadPoolCount = 1, streamRequestBody = true };
    srv, se := http.Server.init(cfg, http.dispatch, @reinterpret(usize, *router));
    if se { return 1; }
    t, te := thread.Thread.spawn(srvEntry, *srv);
    if te { return 1; }

    fd := socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0);
    a := socket.sockaddrIn(srv.cfg.port, LOOPBACK);
    if socket.connect(fd, *a, 16) != 0 { print("no connection\n"); return 1; }
    socket.setIoTimeout(fd, 3000);
    req := "GET /ws HTTP/1.1\r\nHost: t\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n";
    socket.write(fd, req.ptr, req.len);
    tail : [4]u8 = .[0, 0, 0, 0];
    one : [1]u8 = ---;
    while !(tail[0] == '\r' and tail[1] == '\n' and tail[2] == '\r' and tail[3] == '\n') {
        if socket.read(fd, *one[0], 1) != 1 { print("no upgrade\n"); return 1; }
        tail[0] = tail[1];
        tail[1] = tail[2];
        tail[2] = tail[3];
        tail[3] = one[0];
    }

    // A text frame without FIN carrying "a", then its continuation with FIN
    // and the 64-bit length 0x7FFFFFFFFFFFFFFF, both under a zero mask.
    frames : [21]u8 = .[0x01, 0x81, 0, 0, 0, 0, 0x61,
                        0x80, 0xFF, 0x7F, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0, 0, 0, 0];
    socket.write(fd, *frames[0], 21);
    reply : [4]u8 = ---;
    if !readAll(fd, *reply[0], 4) or reply[0] != 0x88 { print("no close frame\n"); return 1; }
    print("the server's close frame: {}\n", (reply[2].(i64) << 8) | reply[3].(i64));
    waited := 0;
    while @atomicLoad(i64, *closedCode, .acquire) == 0 and waited < 300 { c.usleep(10000); waited += 1; }
    print("onClose: {}\n", closedCode);
    socket.close(fd);

    srv.stop();
    t.join();
    srv.close();
    router.deinit();
    0
}
