// A redirect hop sends the header block and the body passed to fetch, though
// they view the buffer each response overwrites.
@import "modules/std.sx";
@import "modules/std/http.sx";

answer :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    if req.path == "/echo" { resp.body = req.body; return; }
    if req.path == "/to-whoami" {
        resp.status = 302;
        resp.addHeader("Location", "/whoami");
        return;
    }
    if req.path == "/to-echo" {
        resp.status = 307;
        resp.addHeader("Location", "/echo");
        return;
    }
    resp.body = format("auth={}", http.findHeader(req, "authorization"));
}

srvEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = arg;
    gpa := GPA.init();
    push .{ allocator = gpa } {
        srv.run();
    }
    return null;
}

main :: () -> i32 {
    srv, se := http.Server.init(.{ port = 0, timeoutRequestMs = 5000 }, answer, 0);
    if se { return 1; }
    t, te := thread.Thread.spawn(srvEntry, *srv);
    if te { return 1; }
    opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 3000 };
    echo := format("http://127.0.0.1:{}/echo", srv.cfg.port);
    buf : [8192]u8 = ---;

    h, he := http.Client.fetch("POST", echo, "", "Authorization: tok\r\n", opts, *buf[0], 8192);
    if he { print("{}\n", he); } else {
        r, e := http.Client.fetch("GET", format("http://127.0.0.1:{}/to-whoami", srv.cfg.port), h.body, "", opts, *buf[0], 8192);
        if e { print("{}\n", e); } else { print("{}\n", r.body); }
    }

    b, be := http.Client.fetch("POST", echo, "", "payload-0123456789", opts, *buf[0], 8192);
    if be { print("{}\n", be); } else {
        pool := http.ClientPool.init(opts);
        r, e := pool.fetch("POST", format("http://127.0.0.1:{}/to-echo", srv.cfg.port), "", b.body, *buf[0], 8192);
        pool.close();
        if e { print("{}\n", e); } else { print("{}\n", r.body); }
    }

    srv.stop();
    t.join();
    srv.close();
    0
}
