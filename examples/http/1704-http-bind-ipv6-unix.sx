// std.http — listener address surface: IPv6, explicit bind addresses,
// Unix-domain sockets, and the getaddrinfo resolver primitive.
//
//   Config.bindAddr  — a NUMERIC address literal ("127.0.0.1", "::",
//                       "::1"); "" keeps the default v4 INADDR_ANY. A
//                       garbage value is `HttpErr.Bind` — never a fallback.
//   Config.unixPath  — non-empty = an AF_UNIX listener on that path
//                       (mutually exclusive with bindAddr / reusePort —
//                       `HttpErr.Config`). A stale socket file is unlinked
//                       before bind; Server.close removes the file.
//   Config.ipv6Only  — every AF_INET6 listener sets IPV6_V6ONLY
//                       explicitly from this (deterministic dual-stack,
//                       never the OS default).
//   socket.Addr       — generic address value: parseAddr (numeric,
//                       inet_pton v4→v6), addrUnix, resolve (getaddrinfo,
//                       first SOCK_STREAM result), connectTo/bindTo,
//                       addrFamily.
//
// Cases:
//   A. bind "::1"  → v6 client 200; a v4 loopback connect is REFUSED
//      (nothing bound on v4 — proves the family took).
//   B. bind "127.0.0.1" → v4 client 200.
//   C. bind "::" ipv6Only=false → BOTH a v4 and a v6 client get 200;
//      resolve("localhost") round-trips too (either family answer works).
//   D. bind "::" ipv6Only=true → v6 200, v4 connect REFUSED.
//   E. unixPath → 200 over the socket file; the file EXISTS while
//      serving and is GONE after close().
//   F. guards: unixPath+reusePort and unixPath+bindAddr are
//      `HttpErr.Config`; bindAddr="not-an-ip" is `HttpErr.Bind`.
//   + net-zero GPA gate across the whole run.
@import "modules/std.sx";
socket :: @import "modules/std/socket.sx";
fs     :: @import "modules/std/fs.sx";
http   :: @import "modules/std/http.sx";

PORT_A :: 19019;
PORT_B :: 19020;
PORT_C :: 19021;
PORT_D :: 19022;
SOCK_PATH :: ".sx-tmp/1704-http.sock";

handler :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    _ := req;
    _ := ctx;
    resp.body = "pong";
}

contains :: (hay: string, needle: string) -> bool {
    if needle.len > hay.len { return false; }
    i := 0;
    while i + needle.len <= hay.len {
        j := 0; ok := true;
        while j < needle.len { if hay[i+j] != needle[j] { ok = false; break; } j += 1; }
        if ok { return true; }
        i += 1;
    }
    return false;
}

// Connect a client socket to `a` (blocking connect, then nonblocking for
// the tick-driven read). -1 = connect refused/failed.
dialAddr :: (a: *socket.Addr) -> i32 {
    fd := socket.socket(socket.addrFamily(a), socket.SOCK_STREAM, 0);
    if fd < 0 { return -1; }
    if socket.connectTo(fd, a) != 0 { socket.close(fd); return -1; }
    if !socket.setNonblocking(fd) { socket.close(fd); return -1; }
    return fd;
}

// One GET → expect a 200 "pong" within the tick budget.
roundtrip :: (srv: *http.Server, fd: i32) -> bool {
    req := "GET / HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n";
    socket.write(fd, req.ptr, req.len);
    rbuf : [2048]u8 = ---;
    total : i64 = 0;
    t : i64 = 0;
    while t < 2000 {
        srv.tick(1) catch {};
        n, re := socket.readNb(fd, *rbuf[total], (2048 - total));
        if !re { total += n; }
        else if re == .Closed { break; }
        s := string{ ptr = *rbuf[0], len = total };
        if contains(s, "HTTP/1.1 200 OK") and contains(s, "pong") { return true; }
        t += 1;
    }
    s := string{ ptr = *rbuf[0], len = total };
    return contains(s, "HTTP/1.1 200 OK") and contains(s, "pong");
}

// Serve one client dialed at `a` on a fresh server built from `cfg`;
// then close the server. 0 ok, else the case-distinct code.
serveOne :: (cfg: http.Config, a: *socket.Addr, code: i32) -> i32 {
    srv, se := http.Server.init(cfg, handler, 0);
    if se { return code; }
    fd := dialAddr(a);
    if fd < 0 { srv.close(); return code + 1; }
    ok := roundtrip(*srv, fd);
    socket.close(fd);
    srv.close();
    if !ok { return code + 2; }
    return 0;
}

main :: () -> i32 {
    gpa := GPA.init();
    rc : i32 = 1;
    push .{ allocator = gpa } { rc = run(); }
    leaked := gpa.allocCount;
    if rc != 0 { print("FAIL: case rc={}\n", rc); return rc; }
    if leaked != 0 { print("LEAK: {} outstanding allocations\n", leaked); return 7; }
    print("bind ok: [::1] v6-only-loopback, 127.0.0.1, dual-stack both families + localhost resolve, ipv6Only refuses v4, unix socket served + unlinked, guards loud; net-zero GPA\n");
    0
}

run :: () -> i32 {
    // ── A. [::1]: v6 serves; v4 loopback is refused ──
    a6, ok6 := socket.parseAddr("::1", PORT_A);
    if !ok6 { return 10; }
    cfgA : http.Config = .{ port = PORT_A, bindAddr = "::1", timeoutRequestMs = 3000, maxConn = 8 };
    ra := serveOneWithV4Refusal(cfgA, *a6, PORT_A, 11);
    if ra != 0 { return ra; }

    // ── B. 127.0.0.1 ──
    a4, ok4 := socket.parseAddr("127.0.0.1", PORT_B);
    if !ok4 { return 20; }
    cfgB : http.Config = .{ port = PORT_B, bindAddr = "127.0.0.1", timeoutRequestMs = 3000, maxConn = 8 };
    rb := serveOne(cfgB, *a4, 21);
    if rb != 0 { return rb; }

    // ── C. dual-stack "::": BOTH families + resolve("localhost") ──
    cfgC : http.Config = .{ port = PORT_C, bindAddr = "::", timeoutRequestMs = 3000, maxConn = 8 };
    srvC, seC := http.Server.init(cfgC, handler, 0);
    if seC { return 30; }
    c6, cok6 := socket.parseAddr("::1", PORT_C);
    if !cok6 { srvC.close(); return 31; }
    fd6 := dialAddr(*c6);
    if fd6 < 0 { srvC.close(); return 32; }
    if !roundtrip(*srvC, fd6) { socket.close(fd6); srvC.close(); return 33; }
    socket.close(fd6);
    c4, cok4 := socket.parseAddr("127.0.0.1", PORT_C);
    if !cok4 { srvC.close(); return 34; }
    fd4 := dialAddr(*c4);
    if fd4 < 0 { srvC.close(); return 35; }
    if !roundtrip(*srvC, fd4) { socket.close(fd4); srvC.close(); return 36; }
    socket.close(fd4);
    // resolve("localhost") → whichever family comes back, the dual-stack
    // listener answers.
    lh, lok := socket.resolve("localhost", PORT_C);
    if !lok { srvC.close(); return 37; }
    fdl := dialAddr(*lh);
    if fdl < 0 { srvC.close(); return 38; }
    if !roundtrip(*srvC, fdl) { socket.close(fdl); srvC.close(); return 39; }
    socket.close(fdl);
    srvC.close();

    // ── D. "::" with ipv6Only=true: v6 serves, v4 refused ──
    d6, dok6 := socket.parseAddr("::1", PORT_D);
    if !dok6 { return 40; }
    cfgD : http.Config = .{ port = PORT_D, bindAddr = "::", ipv6Only = true, timeoutRequestMs = 3000, maxConn = 8 };
    rd := serveOneWithV4Refusal(cfgD, *d6, PORT_D, 41);
    if rd != 0 { return rd; }

    // ── E. Unix-domain socket: serve + unlink on close ──
    fs.createDirAll(".sx-tmp");
    cfgE : http.Config = .{ unixPath = SOCK_PATH, timeoutRequestMs = 3000, maxConn = 8 };
    srvE, seE := http.Server.init(cfgE, handler, 0);
    if seE { return 50; }
    if !fs.exists(SOCK_PATH) { srvE.close(); return 51; }
    ua, uok := socket.addrUnix(SOCK_PATH);
    if !uok { srvE.close(); return 52; }
    fdu := dialAddr(*ua);
    if fdu < 0 { srvE.close(); return 53; }
    if !roundtrip(*srvE, fdu) { socket.close(fdu); srvE.close(); return 54; }
    socket.close(fdu);
    srvE.close();
    if fs.exists(SOCK_PATH) { return 55; }   // close() must remove the file

    // ── F. loud guards ──
    cfgF1 : http.Config = .{ unixPath = SOCK_PATH, reusePort = true };
    _, ef1 := http.Server.init(cfgF1, handler, 0);
    if ef1 != .Config { return 60; }
    cfgF2 : http.Config = .{ unixPath = SOCK_PATH, bindAddr = "127.0.0.1" };
    _, ef2 := http.Server.init(cfgF2, handler, 0);
    if ef2 != .Config { return 61; }
    cfgF3 : http.Config = .{ port = PORT_B, bindAddr = "not-an-ip" };
    _, ef3 := http.Server.init(cfgF3, handler, 0);
    if ef3 != .Bind { return 62; }
    // an out-of-range port must be `HttpErr.Bind` — not a
    // silent htons truncation onto a kernel-chosen ephemeral port.
    cfgF4 : http.Config = .{ port = 65536, bindAddr = "127.0.0.1" };
    _, ef4 := http.Server.init(cfgF4, handler, 0);
    if ef4 != .Bind { return 63; }

    return 0;
}

// A server that must SERVE `a` (v6) and REFUSE a plain v4 loopback
// connect on the same port — proves the bound family. `code` is this
// case's error base.
serveOneWithV4Refusal :: (cfg: http.Config, a: *socket.Addr, port: i64, code: i32) -> i32 {
    srv, se := http.Server.init(cfg, handler, 0);
    if se { return code; }
    fd := dialAddr(a);
    if fd < 0 { srv.close(); return code + 1; }
    ok := roundtrip(*srv, fd);
    socket.close(fd);
    if !ok { srv.close(); return code + 2; }
    // v4 loopback must be REFUSED (nothing bound on the v4 side).
    v4, vok := socket.parseAddr("127.0.0.1", port);
    if !vok { srv.close(); return code + 3; }
    fdr := socket.socket(socket.addrFamily(*v4), socket.SOCK_STREAM, 0);
    if fdr < 0 { srv.close(); return code + 4; }
    refused := socket.connectTo(fdr, *v4) != 0;
    socket.close(fdr);
    srv.close();
    if !refused { return code + 5; }
    return 0;
}
