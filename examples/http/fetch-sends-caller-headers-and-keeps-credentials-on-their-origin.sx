// fetch sends the caller's header lines on every hop, Authorization only to
// the first URL's origin, and refuses a malformed block before it connects.
// The origin holds when the URL views the buffer a previous fetch filled.
@import "modules/std.sx";
@import "modules/std/http.sx";

// `ctx` is the other origin's port.
echo :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    if req.path == "/link" {
        resp.body = format("http://127.0.0.1:{}/same", ctx);
        return;
    }
    if req.path == "/same" {
        resp.status = 302;
        resp.addHeader("Location", "/whoami");
        return;
    }
    if req.path == "/away" {
        resp.status = 302;
        resp.addHeader("Location", format("http://127.0.0.1:{}/whoami", ctx));
        return;
    }
    resp.body = format("auth={} trace={}", http.findHeader(req, "authorization"), http.findHeader(req, "x-trace"));
}

srvEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = arg;
    gpa := GPA.init();
    push .{ allocator = gpa } {
        srv.run();
    }
    return null;
}

main :: () -> i32 {
    other, oe := http.Server.init(.{ port = 0, timeoutRequestMs = 5000 }, echo, 0);
    if oe { return 1; }
    srv, se := http.Server.init(.{ port = 0, timeoutRequestMs = 5000 }, echo, other.cfg.port.(usize));
    if se { return 1; }
    to, toe := thread.Thread.spawn(srvEntry, *other);
    if toe { return 1; }
    ts, tse := thread.Thread.spawn(srvEntry, *srv);
    if tse { return 1; }
    rc := run(*srv);
    srv.stop();
    ts.join();
    srv.close();
    other.stop();
    to.join();
    other.close();
    rc
}

run :: (srv: *http.Server) -> i32 {
    port := srv.cfg.port;
    headers := "Authorization: Bearer t0k\r\nX-Trace: 7\r\n";
    opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 3000 };
    buf : [8192]u8 = ---;

    pool := http.ClientPool.init(opts);
    rp, ep := pool.fetch("GET", format("http://127.0.0.1:{}/whoami", port), headers, "", *buf[0], 8192);
    pool.close();
    if ep { print("pooled: {}\n", ep); return 1; }
    print("pooled: {}\n", rp.body);

    rl, el := http.Client.fetch("GET", format("http://127.0.0.1:{}/link", port), "", "", opts, *buf[0], 8192);
    if el { print("link: {}\n", el); return 1; }
    rs, es := http.Client.fetch("GET", rl.body, headers, "", opts, *buf[0], 8192);
    if es { print("same-origin redirect: {}\n", es); return 1; }
    print("same-origin redirect: {}\n", rs.body);

    ra, ea := http.Client.fetch("GET", format("http://127.0.0.1:{}/away", port), headers, "", opts, *buf[0], 8192);
    if ea { print("other-origin redirect: {}\n", ea); return 1; }
    print("other-origin redirect: {}\n", ra.body);

    accepted := srv.stats().acceptedTotal;
    _, eb := http.Client.fetch("GET", format("http://127.0.0.1:{}/whoami", port),
        "X-Trace: 7\nInjected: 1\r\n", "", opts, *buf[0], 8192);
    print("bare LF in a value: {}, connections opened: {}\n", eb, srv.stats().acceptedTotal - accepted);
    0
}
