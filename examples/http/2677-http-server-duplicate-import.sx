// std.http: a request is served when a second, unreferenced module also
// imports the server module.
@import "modules/std.sx";
http :: @import "modules/std/http.sx";
side :: @import "2677-http-server-duplicate-import-side.sx";

PORT :: 19131;

handler :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    resp.body = "served";
}

contains :: (hay: string, needle: string) -> bool {
    if needle.len > hay.len { return false; }
    i := 0;
    while i + needle.len <= hay.len {
        j := 0;
        ok := true;
        while j < needle.len {
            if hay[i + j] != needle[j] { ok = false; break; }
            j += 1;
        }
        if ok { return true; }
        i += 1;
    }
    return false;
}

dial :: () -> i32 {
    fd := socket.socket(socket.AF_INET, socket.SOCK_STREAM, 0);
    if fd < 0 { return -1; }
    addr := socket.sockaddrIn(PORT, 0x0100007F);
    if socket.connect(fd, *addr, 16) != 0 { socket.close(fd); return -1; }
    if !socket.setNonblocking(fd) { socket.close(fd); return -1; }
    return fd;
}

main :: () -> i32 {
    cfg : http.Config = .{ port = PORT, bindAddr = "127.0.0.1", maxConn = 4 };
    srv, se := http.Server.init(cfg, handler, 0);
    if se { print("server init failed\n"); return 1; }

    fd := dial();
    if fd < 0 { print("dial failed\n"); return 1; }

    req :: "GET /x HTTP/1.1\r\nHost: t\r\n\r\n";
    socket.write(fd, req.ptr, req.len);

    buf : [4096]u8 = ---;
    total : i64 = 0;
    tries := 0;
    while tries < 400 {
        srv.tick(5) catch {};
        n, re := socket.readNb(fd, *buf[total], 4096 - total);
        if !re { total += n; }
        if total > 0 and contains(string{ ptr = *buf[0], len = total }, "served") { break; }
        tries += 1;
    }
    resp := string{ ptr = *buf[0], len = total };
    print("served {} bytes\n", total);
    if !contains(resp, "HTTP/1.1 200 OK") { print("bad status\n"); socket.close(fd); srv.close(); return 1; }
    if !contains(resp, "served") { print("bad body\n"); socket.close(fd); srv.close(); return 1; }

    socket.close(fd);
    srv.close();
    print("duplicate server import: request served\n");
    return 0;
}
