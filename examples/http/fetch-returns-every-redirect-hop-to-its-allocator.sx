// Each fetch hop reads its response into storage from the fetch's allocator: a
// redirect's is returned once its Location is copied out, the final one when
// the caller deinits it. Header blocks and bodies viewing earlier responses
// are sent on every hop of an absolute-then-relative chain, by the free fetch
// and by a pool.
@import "modules/std.sx";
@import "modules/std/http.sx";

port : i64 = 0;

answer :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    if req.path == "/echo" { resp.body = req.body; return; }
    if req.path == "/absolute" {
        resp.status = 302;
        resp.addHeader("Location", format("http://127.0.0.1:{}/to-whoami", port));
        return;
    }
    if req.path == "/to-whoami" {
        resp.status = 302;
        resp.addHeader("Location", "/whoami");
        return;
    }
    if req.path == "/to-echo" {
        resp.status = 307;
        resp.addHeader("Location", "/echo");
        return;
    }
    resp.body = format("auth={}", http.findHeader(req, "authorization"));
}

srvEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = arg;
    gpa := GPA.init();
    push .{ allocator = gpa } {
        srv.run();
    }
    return null;
}

main :: () -> i32 {
    srv, se := http.Server.init(.{ port = 0, timeoutRequestMs = 5000 }, answer, 0);
    if se { return 1; }
    port = srv.cfg.port;
    t, te := thread.Thread.spawn(srvEntry, *srv);
    if te { return 1; }
    opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 3000 };
    echo := format("http://127.0.0.1:{}/echo", port);
    absolute := format("http://127.0.0.1:{}/absolute", port);
    toEcho := format("http://127.0.0.1:{}/to-echo", port);

    tracker := mem.TrackingAllocator.init(context.allocator);
    whoami := "";
    echoed := "";
    push .{ allocator = tracker } {
        h, he := http.Client.fetch("POST", echo, "", "Authorization: tok\r\n", opts);
        if he { whoami = "header fetch failed"; } else {
            r, e := http.Client.fetch("GET", absolute, h.body, "", opts);
            if e { whoami = "redirect fetch failed"; } else {
                whoami = if r.body == "auth=tok" then "auth=tok" else "wrong body";
                r.deinit();
            }
            h.deinit();
        }

        b, be := http.Client.fetch("POST", echo, "", "payload-0123456789", opts);
        if be { echoed = "body fetch failed"; } else {
            pool := http.ClientPool.init(opts);
            r, e := pool.fetch("POST", toEcho, "", b.body);
            if e { echoed = "pooled fetch failed"; } else {
                echoed = if r.body == "payload-0123456789" then "payload-0123456789" else "wrong body";
                r.deinit();
            }
            pool.close();
            b.deinit();
        }
    }
    print("{}\n", whoami);
    print("{}\n", echoed);
    print("allocated: {}, outstanding: {}\n", tracker.allocCount > 0, tracker.leakCount());

    srv.stop();
    t.join();
    srv.close();
    0
}
