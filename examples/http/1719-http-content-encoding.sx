// std.http negotiated gzip/deflate content encoding.
//
// Pins:
//   - automatic client advertisement and transparent fixed-body decode;
//   - qvalue selection, explicit identity, Vary, media/floor/response opt-out;
//   - bounded gzip + deflate over Transfer-Encoding: chunked, including
//     keep-alive reuse and caller-output exhaustion;
//   - inline and pool-mode server parity;
//   - malformed/unknown/truncated content coding and framing rejection;
//   - public std.gzip is sufficient for a .tgs payload (no shell/dependency).

@import "modules/std.sx";
@import "modules/std/http.sx";
ClientResponse :: http.ClientResponse;

BODY_LEN :: 200000;
FIXED_LEN :: 65536;
TGS_JSON :: "{\"v\":\"5.7.4\",\"fr\":60,\"ip\":0,\"op\":120,\"layers\":[]}";

App :: struct {
    body: string;
    packed: string;
}

same :: (a: string, b: string) -> bool {
    if a.len != b.len { return false; }
    i : i64 = 0;
    while i < a.len {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    true
}

contains :: (value: string, needle: string) -> bool {
    if needle.len == 0 { return true; }
    at : i64 = 0;
    while at + needle.len <= value.len {
        i : i64 = 0;
        while i < needle.len and value[at + i] == needle[i] { i += 1; }
        if i == needle.len { return true; }
        at += 1;
    }
    false
}

streamBody :: (ctx: usize, offset: i64, dst: [*]u8, cap: i64) -> i64 {
    app : *App = @reinterpret(*App, ctx);
    if offset >= app.body.len { return 0; }
    n := app.body.len - offset;
    if n > 7001 { n = 7001; }
    if n > cap { n = cap; }
    i : i64 = 0;
    while i < n { dst[i] = app.body[offset + i]; i += 1; }
    n
}

faultBefore :: (ctx: usize, offset: i64, dst: [*]u8, cap: i64) -> i64 { -1 }

faultAfter :: (ctx: usize, offset: i64, dst: [*]u8, cap: i64) -> i64 {
    app : *App = @reinterpret(*App, ctx);
    if offset >= 7001 { return -1; }
    n := 7001 - offset;
    if n > cap { n = cap; }
    i : i64 = 0;
    while i < n { dst[i] = app.body[offset + i]; i += 1; }
    n
}

handler :: (req: *http.Request, resp: *http.Response, ctx: usize) {
    app : *App = @reinterpret(*App, ctx);
    if req.path == "/stream" {
        resp.stream(streamBody, ctx);
        return;
    }
    if req.path == "/fixed" {
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/small" {
        resp.body = "small";
        return;
    }
    if req.path == "/png" {
        resp.contentType = "image/png";
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/jsonp" {
        resp.contentType = "application/jsonp";
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/disabled" {
        resp.disableCompression();
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/partial" {
        resp.status = 206;
        resp.addHeader("Content-Range", "bytes 0-65535/200000");
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/content-range" {
        resp.addHeader("Content-Range", "bytes 0-65535/200000");
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/unsatisfied" {
        resp.status = 416;
        resp.addHeader("Content-Range", "bytes */200000");
        resp.body = "range unsatisfied";
        return;
    }
    if req.path == "/no-transform" {
        resp.addHeader("Cache-Control", "public, no-transform");
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/no-transform-repeat" {
        resp.addHeader("Cache-Control", "public");
        resp.addHeader("Cache-Control", "private, no-transform");
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/strong-etag" {
        resp.addHeader("ETag", "\"identity-v1\"");
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/weak-etag" {
        resp.addHeader("ETag", "W/\"semantic-v1\"");
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/digest" {
        resp.addHeader("Content-Digest", "sha-256=:identity:");
        resp.body = app.body[..FIXED_LEN];
        return;
    }
    if req.path == "/range-request" {
        if http.findHeader(req, "range") == "bytes=0-99" and http.findHeader(req, "accept-encoding").len == 0 { resp.body = "range-no-ae"; }
        else { resp.body = "range-bad"; }
        return;
    }
    if req.path == "/coded-partial" {
        resp.status = 206;
        resp.addHeader("Content-Range", "bytes 0-9/100");
        resp.addHeader("Content-Encoding", "gzip");
        resp.body = app.packed;
        return;
    }
    if req.path == "/coded-unsatisfied" {
        resp.status = 416;
        resp.addHeader("Content-Range", "bytes */100");
        resp.addHeader("Content-Encoding", "gzip");
        resp.body = app.packed;
        return;
    }
    if req.path == "/existing" {
        resp.addHeader("Content-Encoding", "gzip");
        resp.body = app.packed;
        return;
    }
    if req.path == "/stacked" {
        resp.addHeader("Content-Encoding", "br");
        resp.addHeader("Content-Encoding", "gzip");
        resp.body = "raw-stacked";
        return;
    }
    if req.path == "/framing-cl" {
        resp.addHeader("Content-Length", "999");
        resp.body = "bad framing";
        return;
    }
    if req.path == "/framing-te" {
        resp.addHeader("Transfer-Encoding", "chunked");
        resp.body = "bad framing";
        return;
    }
    if req.path == "/fault-before" { resp.stream(faultBefore, ctx); return; }
    if req.path == "/fault-after" { resp.stream(faultAfter, ctx); return; }
    if req.path == "/bad" {
        resp.addHeader("Content-Encoding", "gzip");
        resp.body = "not a gzip stream";
        return;
    }
    resp.body = "pong";
}

serverEntry :: (arg: *void) -> *void abi(.c) {
    srv : *http.Server = arg;
    gpa := GPA.init();
    push .{ allocator = gpa } { srv.run(); }
    null
}

requestOn :: (conn: *http.ClientConn, path: string, headers: string, a: Allocator) -> (ClientResponse, !http.ClientErr) {
    try http.Client.sendOn(conn, "GET", path, "content.test", headers, "");
    return http.Client.recvOn(conn, a);
}

writeAll :: (fd: i32, data: string) -> bool {
    at : i64 = 0;
    while at < data.len {
        n := socket.write(fd, *data.ptr[at], (data.len - at));
        if n <= 0 { return false; }
        at += n;
    }
    true
}

malformedResponseFails :: (wire: string) -> bool {
    pair : [2]i32 = ---;
    if socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM, 0, *pair[0]) != 0 { return false; }
    if !writeAll(pair[1], wire) {
        socket.close(pair[0]); socket.close(pair[1]); return false;
    }
    socket.close(pair[1]);
    response, e := http.Client.recv(pair[0]);
    if !e { response.deinit(); }
    socket.close(pair[0]);
    e == .Recv
}

exactCapacityDecodes :: (plain: string, packed: string) -> bool {
    pair : [2]i32 = ---;
    if socket.socketpair(socket.AF_UNIX, socket.SOCK_STREAM, 0, *pair[0]) != 0 { return false; }
    head := "HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nConnection: close\r\n\r\n";
    if !writeAll(pair[1], head) or !writeAll(pair[1], packed) {
        socket.close(pair[0]); socket.close(pair[1]); return false;
    }
    socket.close(pair[1]);
    response, e := http.Client.recv(pair[0], "GET", head.len + plain.len);
    socket.close(pair[0]);
    if e { return false; }
    ok := response.decodedFrom != null and response.decodedFrom?! == http.ContentCoding.gzip
        and response.header("content-encoding").len == 0
        and same(response.body, plain);
    response.deinit();
    ok
}

faultedStreamRejected :: (port: i64, path: string, headers: string) -> bool {
    opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 5000 };
    conn, oe := http.Client.open("127.0.0.1", port, opts);
    if oe { return false; }
    se := http.Client.sendOn(*conn, "GET", path, "content.test", headers, "");
    if se { http.Client.closeConn(*conn); return false; }
    response, re := http.Client.recvOn(*conn);
    if !re { response.deinit(); }
    http.Client.closeConn(*conn);
    re == .Recv
}

runServerCases :: (app: *App, poolCount: i64) -> bool {
    cfg : http.Config = .{
        port = 0,
        maxConn = 16,
        timeoutRequestMs = 5000,
        timeoutKeepaliveMs = 5000,
        threadPoolCount = poolCount,
        compressResponses = true,
        compressMinSize = 1024,
        compressLevel = 6,
    };
    srv, se := http.Server.init(cfg, handler, @reinterpret(usize, app));
    if se { return false; }
    port := srv.cfg.port;
    t, te := thread.Thread.spawn(serverEntry, *srv);
    if te { srv.close(); return false; }

    opts : http.ClientOpts = .{ connectTimeoutMs = 2000, ioTimeoutMs = 5000 };
    conn, oe := http.Client.open("127.0.0.1", port, opts);
    if oe { srv.stop(); t.join(); srv.close(); return false; }
    // Every response below is read into this arena and returned with it.
    arena := mem.Arena.init(context.allocator, 65536);
    ok := true;

    // The default client advertises both codings; the server tie-breaks gzip.
    fixed, fe := requestOn(*conn, "/fixed", "", arena);
    if fe or fixed.status != 200 or fixed.decodedFrom == null or fixed.decodedFrom?! != http.ContentCoding.gzip
        or fixed.header("content-encoding").len != 0
        or fixed.header("content-length").len != 0
        or fixed.header("vary") != "Accept-Encoding"
        or !same(fixed.body, app.body[..FIXED_LEN]) { ok = false; }
    // Header normalization + decoded metadata make accidental double decode
    // visible and prevent a compressed Content-Length from sizing plain data.
    if !fe {
        doubleBytes, doubleDecode := gzip.decode(fixed.body, BODY_LEN);
        if !doubleDecode {
            context.allocator.deallocBytes(doubleBytes.ptr);
            ok = false;
        }
    }

    // Explicit weights select RFC 9110 `deflate` (zlib framing).
    deflated, de := requestOn(*conn, "/fixed",
        "Accept-Encoding: deflate, gzip;q=0.5\r\n", arena);
    if de or deflated.decodedFrom == null or deflated.decodedFrom?! != http.ContentCoding.deflate
        or deflated.header("content-encoding").len != 0
        or !same(deflated.body, app.body[..FIXED_LEN]) { ok = false; }

    // Identity has a higher default q than a lower-weight gzip offer.
    identity, ie := requestOn(*conn, "/fixed",
        "Accept-Encoding: gzip;q=0.5\r\n", arena);
    if ie or identity.header("content-encoding").len != 0
        or identity.decodedFrom != null
        or identity.header("vary") != "Accept-Encoding"
        or !same(identity.body, app.body[..FIXED_LEN]) { ok = false; }

    small, sme := requestOn(*conn, "/small", "", arena);
    if sme or small.header("content-encoding").len != 0 or small.body != "small"
        or small.header("vary") != "Accept-Encoding" { ok = false; }

    png, pe := requestOn(*conn, "/png", "", arena);
    if pe or png.header("content-encoding").len != 0
        or !same(png.body, app.body[..FIXED_LEN]) { ok = false; }

    jsonp, jpe := requestOn(*conn, "/jsonp", "", arena);
    if jpe or jsonp.header("content-encoding").len != 0
        or !same(jsonp.body, app.body[..FIXED_LEN]) { ok = false; }

    disabled, die := requestOn(*conn, "/disabled", "", arena);
    if die or disabled.header("content-encoding").len != 0
        or !same(disabled.body, app.body[..FIXED_LEN]) { ok = false; }

    partial, pae := requestOn(*conn, "/partial", "", arena);
    if pae or partial.status != 206 or partial.decodedFrom != null
        or partial.header("content-encoding").len != 0
        or partial.header("content-range") != "bytes 0-65535/200000"
        or !same(partial.body, app.body[..FIXED_LEN]) { ok = false; }

    unchanged, ute := requestOn(*conn, "/no-transform", "", arena);
    if ute or unchanged.decodedFrom != null or unchanged.header("content-encoding").len != 0
        or unchanged.header("cache-control") != "public, no-transform"
        or !same(unchanged.body, app.body[..FIXED_LEN]) { ok = false; }

    repeated, rce := requestOn(*conn, "/no-transform-repeat", "", arena);
    if rce or repeated.decodedFrom != null or repeated.header("content-encoding").len != 0
        or !same(repeated.body, app.body[..FIXED_LEN]) { ok = false; }

    strong, see := requestOn(*conn, "/strong-etag", "", arena);
    if see or strong.decodedFrom != null or strong.header("etag") != "\"identity-v1\""
        or !same(strong.body, app.body[..FIXED_LEN]) { ok = false; }

    weak, wee := requestOn(*conn, "/weak-etag", "", arena);
    if wee or weak.decodedFrom == null or weak.decodedFrom?! != http.ContentCoding.gzip
        or weak.header("etag") != "W/\"semantic-v1\""
        or !same(weak.body, app.body[..FIXED_LEN]) { ok = false; }

    digest, dge := requestOn(*conn, "/digest", "", arena);
    if dge or digest.decodedFrom != null or digest.header("content-digest").len == 0
        or !same(digest.body, app.body[..FIXED_LEN]) { ok = false; }

    ranged, rge := requestOn(*conn, "/range-request", "Range: bytes=0-99\r\n",
        arena);
    if rge or ranged.body != "range-no-ae" { ok = false; }

    rangedMeta, rme := requestOn(*conn, "/content-range", "", arena);
    if rme or rangedMeta.decodedFrom != null
        or rangedMeta.header("content-range") != "bytes 0-65535/200000"
        or !same(rangedMeta.body, app.body[..FIXED_LEN]) { ok = false; }

    unsatisfied, use := requestOn(*conn, "/unsatisfied", "", arena);
    if use or unsatisfied.status != 416 or unsatisfied.decodedFrom != null
        or unsatisfied.header("content-range") != "bytes */200000" { ok = false; }

    codedPartial, cpe := requestOn(*conn, "/coded-partial", "", arena);
    if cpe or codedPartial.status != 206 or codedPartial.decodedFrom != null
        or codedPartial.header("content-encoding") != "gzip"
        or !same(codedPartial.body, app.packed) { ok = false; }

    codedUnsat, cue := requestOn(*conn, "/coded-unsatisfied", "", arena);
    if cue or codedUnsat.status != 416 or codedUnsat.decodedFrom != null
        or codedUnsat.header("content-encoding") != "gzip"
        or !same(codedUnsat.body, app.packed) { ok = false; }

    existing, exe := requestOn(*conn, "/existing", "", arena);
    if exe or existing.decodedFrom == null or existing.decodedFrom?! != http.ContentCoding.gzip
        or !same(existing.body, app.body) { ok = false; }

    refused, re := requestOn(*conn, "/fixed",
        "Accept-Encoding: gzip;q=0, deflate;q=0, identity;q=0\r\n",
        arena);
    if re or refused.status != 406 or refused.body.len != 0 { ok = false; }

    refusal := "Accept-Encoding: gzip, identity;q=0\r\n";
    floorRefused, fre := requestOn(*conn, "/small", refusal, arena);
    disabledRefused, dre := requestOn(*conn, "/disabled", refusal, arena);
    mediaRefused, mre := requestOn(*conn, "/png", refusal, arena);
    transformRefused, tre := requestOn(*conn, "/no-transform-repeat", refusal, arena);
    rangeRefused, rre := requestOn(*conn, "/partial", refusal, arena);
    validatorRefused, vre := requestOn(*conn, "/strong-etag", refusal, arena);
    if fre or dre or mre or tre or rre or vre
        or floorRefused.status != 406 or disabledRefused.status != 406
        or mediaRefused.status != 406 or transformRefused.status != 406
        or rangeRefused.status != 406 or validatorRefused.status != 406 { ok = false; }

    framingCl, fce := requestOn(*conn, "/framing-cl", "", arena);
    if fce or framingCl.status != 500 or framingCl.header("content-length") == "999" { ok = false; }
    framingTe, fte := requestOn(*conn, "/framing-te", "", arena);
    if fte or framingTe.status != 500 or framingTe.header("transfer-encoding") == "chunked" { ok = false; }

    // Chunked transfer framing is removed before incremental gzip decode.
    streamed, stre := requestOn(*conn, "/stream", "", arena);
    if stre or streamed.header("transfer-encoding") != "chunked"
        or streamed.header("content-encoding").len != 0
        or streamed.decodedFrom == null or streamed.decodedFrom?! != http.ContentCoding.gzip
        or !same(streamed.body, app.body) { ok = false; }

    // The entire compressed transfer was consumed; keep-alive remains clean.
    pong, poe := requestOn(*conn, "/small", "Accept-Encoding: identity\r\n",
        arena);
    if poe or pong.body != "small" { ok = false; }
    http.Client.closeConn(*conn);

    // A negative producer result is a fault, never clean EOF. Exercise before
    // and after output, both raw and through the gzip encoder. A clean zero
    // chunk would make the raw cases succeed, so Recv proves truncation.
    if !faultedStreamRejected(port, "/fault-before", "Accept-Encoding: identity\r\n")
        or !faultedStreamRejected(port, "/fault-after", "Accept-Encoding: identity\r\n")
        or !faultedStreamRejected(port, "/fault-before", "")
        or !faultedStreamRejected(port, "/fault-after", "") { ok = false; }

    // Opting out leaves the content-coded representation and its headers
    // intact. The caller can decode it explicitly exactly once.
    rawOpts : http.ClientOpts = .{
        connectTimeoutMs = 2000,
        ioTimeoutMs = 5000,
        acceptCompression = false,
    };
    rawConn, roe := http.Client.open("127.0.0.1", port, rawOpts);
    if roe { ok = false; }
    else {
        rawFixed, rfe := requestOn(*rawConn, "/fixed",
            "Accept-Encoding: gzip\r\n", arena);
        if rfe or rawFixed.decodedFrom != null or rawFixed.header("content-encoding") != "gzip"
            or rawFixed.header("content-length").len == 0 { ok = false; }
        else {
            explicit := gzip.decode(rawFixed.body, BODY_LEN) catch { ok = false; "" };
            if ok { ok = same(explicit, app.body[..FIXED_LEN]); }
            if explicit.ptr != null { context.allocator.deallocBytes(explicit.ptr); }
        }
        rawStacked, rse := requestOn(*rawConn, "/stacked",
            "Accept-Encoding: br, gzip\r\n", arena);
        if rse or rawStacked.decodedFrom != null or rawStacked.body != "raw-stacked"
            or rawStacked.header("content-encoding") != "br"
            or !contains(rawStacked.headersRaw, "Content-Encoding: gzip") { ok = false; }
        http.Client.closeConn(*rawConn);
    }

    // Decoded size, not compressed size, is bounded by maxResponseBytes.
    shortOpts := opts;
    shortOpts.maxResponseBytes = 4096;
    shortConn, soe := http.Client.open("127.0.0.1", port, shortOpts);
    if soe { ok = false; }
    else {
        trySend := http.Client.sendOn(*shortConn, "GET", "/stream", "content.test", "", "");
        if trySend { ok = false; }
        else {
            shortResponse, shortError := http.Client.recvOn(*shortConn, arena);
            if !shortError { ok = false; shortResponse.deinit(); }
            else if shortError != .TooLarge { ok = false; }
        }
        http.Client.closeConn(*shortConn);
    }

    // A handler-provided coding is never double-encoded; malformed payloads
    // fail in the client rather than surfacing undecoded bytes.
    badConn, boe := http.Client.open("127.0.0.1", port, opts);
    if boe { ok = false; }
    else {
        badSend := http.Client.sendOn(*badConn, "GET", "/bad", "content.test", "", "");
        if badSend { ok = false; }
        else {
            badResponse, badError := http.Client.recvOn(*badConn, arena);
            if !badError { ok = false; badResponse.deinit(); }
            else if badError != .Recv { ok = false; }
        }
        http.Client.closeConn(*badConn);
    }

    arena.deinit();
    srv.stop();
    t.join();
    srv.close();
    ok
}

main :: () -> i32 {
    gpa := GPA.init();
    result : i32 = 1;
    push .{ allocator = gpa } {
        raw := context.allocator.allocBytes(BODY_LEN);
        if raw == null { return 2; }
        body : string = .{ ptr = raw.([*]u8), len = BODY_LEN };
        i : i64 = 0;
        while i < body.len {
            // Compressible but not constant: catches ordering/copy mistakes.
            body.ptr[i] = ('a' + ((i / 97) % 17)).(u8);
            i += 1;
        }
        bodyPacked := gzip.encode(body) catch { context.allocator.deallocBytes(raw); return 2; };
        app : App = .{ body = body, packed = bodyPacked };

        ok := runServerCases(*app, 0);
        if ok { ok = runServerCases(*app, 2); }

        if ok {
            ok = malformedResponseFails(
                "HTTP/1.1 200 OK\r\nContent-Length: 3\r\nContent-Encoding: gzip\r\nConnection: close\r\n\r\nbad");
        }
        if ok {
            ok = malformedResponseFails(
                "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Encoding: gzip\r\nConnection: close\r\n\r\n3\r\nbadX\r\n0\r\n\r\n");
        }
        if ok {
            ok = malformedResponseFails(
                "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Encoding: br\r\nConnection: close\r\n\r\nx");
        }
        if ok {
            ok = malformedResponseFails(
                "HTTP/1.1 200 OK\r\nContent-Length: 4x\r\nContent-Encoding: gzip\r\nConnection: close\r\n\r\nbad!");
        }

        // Telegram animated stickers are gzip-compressed JSON. This public
        // codec path is allocation-aware and needs no gzip executable.
        if ok {
            packed := gzip.encode(TGS_JSON) catch { ok = false; "" };
            if ok {
                unpacked := gzip.decode(packed, 4096) catch { ok = false; "" };
                if ok { ok = same(unpacked, TGS_JSON); }
                if unpacked.ptr != null { context.allocator.deallocBytes(unpacked.ptr); }
            }
            if ok { ok = exactCapacityDecodes(TGS_JSON, packed); }
            if packed.ptr != null { context.allocator.deallocBytes(packed.ptr); }
        }

        context.allocator.deallocBytes(bodyPacked.ptr);
        context.allocator.deallocBytes(raw);
        if ok { result = 0; }
    }
    if result != 0 { print("std.http content encoding failed\n"); return result; }
    if gpa.allocCount != 0 {
        print("std.http content encoding leaked {} allocations\n", gpa.allocCount);
        return 3;
    }
    print("std.http gzip/deflate fixed+streamed ok; identity/malformed/.tgs ok; net-zero GPA\n");
    0
}
