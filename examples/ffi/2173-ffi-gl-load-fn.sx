// loadFn writes getProc(name).(T) into *slot. loadGl fills every
// GL entry that way — a null stub is enough to exercise the loader.
@import "modules/std.sx";
@import "modules/ffi/opengl.sx";

stub :: (name: cstring) -> *void abi(.c) {
    return null;
}

main :: () {
    loadGl(stub);
    print("loaded\n");
}
