// load_fn writes get_proc(name).(T) into *slot. load_gl fills every
// GL entry that way — a null stub is enough to exercise the loader.
@import "modules/std.sx";
@import "modules/ffi/opengl.sx";

stub :: (name: cstring) -> *void abi(.c) {
    return null;
}

main :: () {
    load_gl(stub);
    print("loaded\n");
}
