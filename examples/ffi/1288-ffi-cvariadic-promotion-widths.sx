// Every argument at or past the fixed count crosses a C-variadic tail under the
// C default argument promotions, so an integer narrower than 32 bits arrives as
// `i32` — at every width `@int` forms, 1 through 31 in both signs.
//
// Each width is read back three ways: through the sx definition by name, through
// an `abi(.c)` function VALUE of the same signature, and through the
// `<stdarg.h>` twin in the companion C file. The values are the ones that
// separate sign extension from zero extension — a signed width's minimum and its
// all-ones pattern, an unsigned width's maximum — so a wrong extension changes
// the number printed instead of hiding in the top bits.

@import "modules/std.sx";

@import c {
    @source "1288-ffi-cvariadic-promotion-widths.c";
};

c_probe :: (n: i32, ..) -> i64 extern;

probe :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @va_start(*ap);
    defer @va_end(*ap);
    return @va_arg(i32, *ap);
}

Probe :: (i32, ..) -> i64 abi(.c);

main :: () -> i32 {
    through: Probe = probe;

    s1_min: @int(1, .signed) = -1;
    s1_ones: @int(1, .signed) = -1;
    print("i1 sx={},{} fn={},{} c={},{}\n", probe(1, s1_min), probe(1, s1_ones), through(1, s1_min), through(1, s1_ones), c_probe(1, s1_min), c_probe(1, s1_ones));
    s2_min: @int(2, .signed) = -2;
    s2_ones: @int(2, .signed) = -1;
    print("i2 sx={},{} fn={},{} c={},{}\n", probe(1, s2_min), probe(1, s2_ones), through(1, s2_min), through(1, s2_ones), c_probe(1, s2_min), c_probe(1, s2_ones));
