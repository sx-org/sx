// An `extern` data global: reference a symbol
// defined elsewhere (here libSystem's __stdinp) via the bare `extern`
// linkage modifier on a typed var decl — the `<name> : <type> extern;`
// form (see examples/1205). The optional
// `extern [LIB] ["csym"]` tail mirrors the fn form; bare here (the sx name
// IS the C symbol, resolved against the default-linked libSystem).
@import "modules/std.sx";

__stdinp : *void extern;

main :: () -> i32 {
    addrBits : u64 = xx *__stdinp;
    print("stdin extern global non-null: {}\n", addrBits != 0);
    0
}
