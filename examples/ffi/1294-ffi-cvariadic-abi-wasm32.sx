// The C-variadic tail and the `@VaList` boundary, compiled for wasm32:
// a one-word `va_list` the C parameter carries directly.
//
// A `.build` sidecar names one target, so the matrix is one file per target,
// 1289 through 1294. The file whose target matches the host runs; the rest
// compile. The import is core-only — `modules/std.sx` carries no clock or errno
// values for every target here, and none of the shapes below need it.

@import "modules/std/core.sx";

sum_ints :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @vaStart(*ap);
    defer @vaEnd(*ap);
    total: i64 = 0;
    for i in 0..n {
        total += @vaArg(i32, *ap);
    }
    return total;
}

// The C boundary parameter. Whatever the target's `va_list` is, one place
// crosses and the callee reads it exactly as it reads a local's storage.
readInts :: (n: i32, ap: @VaList) -> i64 abi(.c) {
    total: i64 = 0;
    for i in 0..n {
        total += @vaArg(i32, *ap);
    }
    return total;
}

forward :: (n: i32, ap: *@VaList) -> i64 {
    return readInts(n, ap.*);
}

ownForward :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @vaStart(*ap);
    defer @vaEnd(*ap);
    return forward(n, *ap);
}

twice :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @vaStart(*ap);
    defer @vaEnd(*ap);
    dup: @VaList = ---;
    @vaCopy(*dup, *ap);
    defer @vaEnd(*dup);

    first: i64 = 0;
    for i in 0..n {
        first += @vaArg(i32, *ap);
    }
    second: i64 = 0;
    for i in 0..n {
        second += @vaArg(i32, *dup);
    }
    return first * 100 + second;
}

Summer :: (i32, ..) -> i64 abi(.c);

// `isize` and `usize` are the target's address width, which is 32 bits here and
// 64 on every other target in the matrix. Each crosses and is read at that
// width, so the reader names it rather than a fixed one.
sumAddresses :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @vaStart(*ap);
    defer @vaEnd(*ap);
    total: i64 = 0;
    for i in 0..n {
        total += @vaArg(isize, *ap);
    }
    return total;
}

main :: () -> i32 {
    a: i32 = 4;
    b: i32 = 5;
    c: i32 = 6;
    if sum_ints(3, a, b, c) != 15 { return 1; }
    if ownForward(3, a, b, c) != 15 { return 2; }
    if twice(3, a, b, c) != 1515 { return 3; }

    through: Summer = sum_ints;
    if through(3, a, b, c) != 15 { return 4; }

    narrow: u8 = 7;
    signedNarrow: i16 = -3;
    if sum_ints(2, narrow, signedNarrow) != 4 { return 5; }

    offset: isize = 9;
    count: usize = 11;
    if sumAddresses(2, offset, xx count) != 20 { return 6; }
    return 0;
}
