// C's `char *` is `[*:0]u8`: ONE pointer to a null-terminated u8 buffer.
// It crosses extern boundaries verbatim in both directions; `?[*:0]u8` is
// the nullable case (null pointer = absent); a terminated value reaches it
// through the type, while an arbitrary string materializes via toCstring;
// fromCstring is the zero-copy view back.
@import "modules/std.sx";

libc :: @library "c";
strerrorC :: (code: i32) -> [*:0]u8 extern libc "strerror";
getenvC   :: (name: [*:0]u8) -> ?[*:0]u8 extern libc "getenv";
dlerrorC  :: () -> ?[*:0]u8 extern libc "dlerror";

main :: () -> i32 {
    // literal -> C param; C pointer return -> view
    e := strerrorC(2);
    v := fromCstring(e);
    if v.len < 5 { print("BUG: strerror short\n"); return 1; }
    print("strerror ok\n");

    // ?[*:0]u8: present, absent, and null-returning C call
    p := getenvC("PATH");
    if p == null { print("BUG: PATH null\n"); return 2; }
    if cstringLen(p?!) < 1 { print("BUG: PATH empty\n"); return 3; }
    q := getenvC("NO_SUCH_VAR_ZZZ");
    if q != null { print("BUG: missing not null\n"); return 4; }
    d := dlerrorC();
    if d != null { print("BUG: dlerror non-null\n"); return 5; }
    print("optional ok\n");

    // round trip: built string -> owned C string -> view -> equality
    s := concat("hi-", "there");
    c := toCstring(s);
    r := fromCstring(c);
    if r != "hi-there" { print("BUG: round trip\n"); return 6; }
    if cstringLen(c) != 8 { print("BUG: len\n"); return 7; }
    print("round trip ok\n");
    return 0;
}
