// Default-convention function pointers pass large aggregates as SSA values.

@import "modules/std.sx";

Wide :: struct {
    a: i64; b: i64; c: i64; d: i64;
}

accept :: (w: Wide) -> i64 {
    w.a + w.b + w.c + w.d
}

main :: () -> i32 {
    w := Wide{ a = 1, b = 10, c = 100, d = 1000 };
    direct := accept(w);
    if direct != 1111 { return 1; }

    fnPtr : (Wide) -> i64 = accept;
    indirect := fnPtr(w);
    if indirect != 1111 { return 2; }

    0
}
