// A trailing `..args: []T` on an `extern` fn is the homogeneous constraint over
// the C tail: the author asserts every tail argument is a `T`. At a direct call
// each argument at or past the fixed count coerces to `T` first, then takes the
// default argument promotions, and each crosses the C variadic slot on its own
// — never packed into an sx slice.
//
// The emitted operands therefore carry `T`'s width, not the argument's written
// one: an integer literal reaches a `[]i32` tail as `i32`.

#import "modules/std.sx";

#import c {
    #source "1229-ffi-extern-cvariadic.c";
};

sx_ext_sum_ints    :: (n: i32, ..args: []i32) -> i64 extern;
sx_ext_avg_doubles :: (n: i32, ..args: []f64) -> f64 extern;

main :: () -> i32 {
    print("sum_ints(3, 10, 20, 30) = {}\n", sx_ext_sum_ints(3, 10, 20, 30));
    print("sum_ints(0)             = {}\n", sx_ext_sum_ints(0));
    print("avg_doubles(2)          = {}\n", sx_ext_avg_doubles(2, 1.5, 2.5));
    print("avg_doubles(3)          = {}\n", sx_ext_avg_doubles(3, 1.0, 2.0, 3.0));
    0
}
