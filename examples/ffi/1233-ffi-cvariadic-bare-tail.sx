// A C-variadic signature ends its parameter list in a bare `..`. The tail binds
// no name and no type, so it is a property of the signature rather than a
// parameter, and the fixed count is the number of entries before it — zero
// when the list is just `(..)`.
//
// The tail is legal on an effective-C signature only: a definition carrying
// `abi(.c)` or `export`, or an `extern` declaration. Each emits the C shape
// with no implicit sx context, so the LLVM type is exactly what a C compiler
// builds for the same prototype.
//
// Every argument at or past the fixed count crosses the tail under the default
// argument promotions: `f32` widens to `f64`, and an integer narrower than 32
// bits widens to `i32` — every width, not just the builtin ones.
//
// An integer literal keeps ordinary sx typing, so it crosses the tail as `i64`.
// A C `%d` slot reads an `int`, so the width is stated where C expects one, and
// a C `%s` slot reads one pointer, so text crosses as `cstring`.
//
// A definition READS its tail through a `@VaList` cursor: `@vaStart` opens one
// over the arguments past the fixed count, `@vaArg` reads the next under the
// same promotions the caller applied, `@vaCopy` forks a second cursor, and
// `@vaEnd` closes each. Every function below has a `<stdarg.h>` twin in the
// companion C file, called with the same arguments — the two answers are the
// differential.

@import "modules/std.sx";

@import c {
    @source "1233-ffi-cvariadic-bare-tail.c";
};

printf :: (fmt: cstring, ..) -> i32 extern;

c_sum_ints :: (n: i32, ..) -> i64 extern;
c_sum_doubles :: (n: i32, ..) -> f64 extern;
c_total_text :: (n: i32, ..) -> i64 extern;
c_twice :: (n: i32, ..) -> i64 extern;

tally :: (n: i32, ..) -> i64 abi(.c) {
    return n;
}

// Zero fixed parameters: every argument is a tail argument, and a call with
// none at all passes an empty tail.
constant :: (..) -> i64 abi(.c) {
    return 7;
}

// The cursor argument is the local's address in every statement position — a
// direct `@vaEnd` here, a deferred one in `sumDoubles`.
sumInts :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @vaStart(*ap);
    total: i64 = 0;
    for i in 0..n {
        total += @vaArg(i32, *ap);
    }
    @vaEnd(*ap);
    return total;
}

sumDoubles :: (n: i32, ..) -> f64 abi(.c) {
    ap: @VaList = ---;
    @vaStart(*ap);
    defer @vaEnd(*ap);
    total: f64 = 0;
    for i in 0..n {
        total += @vaArg(f64, *ap);
    }
    return total;
}

// A borrowed `*@VaList` reads on behalf of the owner and leaves the ending to
// it.
takeText :: (ap: *@VaList) -> i64 {
    return cstringLen(@vaArg(cstring, ap));
}

totalText :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @vaStart(*ap);
    defer @vaEnd(*ap);
    total: i64 = 0;
    for i in 0..n {
        total += takeText(*ap);
    }
    return total;
}

// `@vaCopy` forks an independent cursor at the original's position, so the two
// traversals read the same arguments. Both are ended.
twice :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @vaStart(*ap);
    dup: @VaList = ---;
    @vaCopy(*dup, *ap);

    first: i64 = 0;
    for i in 0..n {
        first += @vaArg(i32, *ap);
    }
    @vaEnd(*ap);

    second: i64 = 0;
    for i in 0..n {
        second += @vaArg(i32, *dup);
    }
    @vaEnd(*dup);
    return first * 100 + second;
}

main :: () -> i32 {
    single: f32 = 1.5;
    narrow: u8 = 7;
    signedNarrow: i16 = -3;
    whole: i32 = 42;
    text: cstring = "text";

    printf("heterogeneous: %d %s %f\n", whole, text, 3.25);
    printf("promoted: %f %d %d\n", single, narrow, signedNarrow);

    oddSigned: @int(24, .signed) = -1000;
    oddUnsigned: @int(7, .unsigned) = 100;
    printf("odd widths: %d %d\n", oddSigned, oddUnsigned);

    print("tally={}\n", tally(3, 1, 2, 3));
    print("constantEmpty={}\n", constant());
    print("constantTail={}\n", constant(1, 2));

    a: i32 = 4;
    b: i32 = 5;
    c: i32 = 6;
    print("ints sx={} c={}\n", sumInts(3, a, b, c), c_sum_ints(3, a, b, c));

    // The narrow widths the caller promotes are read at the width C promoted
    // them to.
    print("promoted sx={} c={}\n", sumInts(2, narrow, signedNarrow), c_sum_ints(2, narrow, signedNarrow));

    x: f64 = 1.25;
    print("doubles sx={} c={}\n", sumDoubles(3, x, 2.5, single), c_sum_doubles(3, x, 2.5, single));

    one: cstring = "abc";
    two: cstring = "defgh";
    print("text sx={} c={}\n", totalText(2, one, two), c_total_text(2, one, two));

    print("copy sx={} c={}\n", twice(3, a, b, c), c_twice(3, a, b, c));
    return 0;
}
