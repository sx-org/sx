// C function pointers pass large non-HFA aggregates through the C byval ABI.

@import "modules/std.sx";

Wide :: struct {
    a: i64;
    b: i64;
    c: i64;
    d: i64;
}

acceptC :: (w: Wide) -> i64 abi(.c) {
    w.a + w.b + w.c + w.d
}

main :: () -> i32 {
    w := Wide{ a = 1, b = 10, c = 100, d = 1000 };
    if acceptC(w) != 1111 { return 1; }

    fnPtr : (Wide) -> i64 abi(.c) = acceptC;
    if fnPtr(w) != 1111 { return 2; }

    0
}
