// `?!` after passing the binding to a pointer parameter compiles: it reads what
// the call stored, and stops the program at the null.
@import "modules/std.sx";

clear :: (p: *?i64) { p.* = null; }

passed :: (x: ?i64) -> i64 {
    if x == null { return 0; }
    clear(x);
    x?!
}

main :: () {
    print("{}\n", passed(5));
}
