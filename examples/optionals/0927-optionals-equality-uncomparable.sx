// Optional equality requires the PAYLOAD to have value-equality — a `union`
// payload has none — and two distinct optional types never compare. Optional
// equality defines `?T == ?T` / `?T == T`; it does not widen what T itself
// may be.
@import "modules/std.sx";

Shape0927 :: union { circle: i64; rect: i64; }

main :: () {
    a : ?Shape0927 = null;
    b : ?Shape0927 = null;
    ok := a == b;          // error: union payload has no value-equality
    x : ?f32 = null;
    y : ?f64 = null;
    ok2 := x == y;         // error: distinct types
    print("{} {}\n", ok, ok2);
}
