// A `?cstring` is the cstring's own 16 bytes — a null `ptr` IS absent — so a
// struct field costs no flag word, and the same presence test answers alike
// at runtime and in the comptime VM.

@import "modules/std.sx";

S :: struct { a: ?cstring; b: i64; }

GPU :: interface {
  ping :: (self: *Self) -> i64;
}

Impl :: struct {}
impl GPU for Impl {
  ping :: (self: *Impl) -> i64 { 42 }
}

present :: (c: ?cstring) -> bool { return c != null; }

protocolPresent :: () -> bool {
    impl := Impl{};
    g : ?GPU = impl.(GPU);
    return g != null;
}

COMPTIME_CSTRING  :: @run present("hi");
COMPTIME_PROTOCOL :: @run protocolPresent();

main :: () -> i32 {
    print("{}\n", @sizeOf(S));
    with    := S{ a = "hi", b = 7 };
    without := S{ a = null, b = 9 };
    print("{} {}\n", with.b, without.b);
    print("{} {}\n", present("hi"), COMPTIME_CSTRING);
    print("{}\n", COMPTIME_PROTOCOL);
    return 0;
}
