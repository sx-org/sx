// A `for` over an optional no guard proves present is refused, and `?!` on a
// `for` source a guard proves present is refused as redundant.
@import "modules/std.sx";

unguarded :: (xs: ?[]i64) -> i64 {
    s : i64 = 0;
    for x in xs { s += x; }
    s
}

forced :: (xs: ?[]i64) -> i64 {
    if xs == null { return 0; }
    s : i64 = 0;
    for x in xs?! { s += x; }
    s
}

main :: () { print("{} {}\n", unguarded(null), forced(null)); }
