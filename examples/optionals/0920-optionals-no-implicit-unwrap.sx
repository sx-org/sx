// An un-narrowed `?T` does NOT implicitly unwrap to its concrete payload in a
// value position — it is a compile error pointing at the explicit forms. The
// rule covers the whole `?T → concrete` family, incl. `?bool → bool`.
//
// The legal extractions are `!` / `??` / binding / `case` / a `!= null` guard
// (see 0919); everything else is rejected.
@import "modules/std.sx";

takes_i32 :: (x: i32) { print("got {}\n", x); }

main :: () {
    n : ?i64 = null;
    takes_i32(n);    // error: optional does not implicitly unwrap
}
