// `?!` after a write through the binding's address compiles: it reads what the
// write stored, and stops the program at a null.
@import "modules/std.sx";

clear :: (p: *?i64) { p.* = null; }

passed :: (x: ?i64) -> i64 {
    if x == null { return 0; }
    clear(*x);
    x?!
}

kept :: (x: ?i64) -> i64 {
    p := *x;
    if x == null { return 0; }
    p.* = 7;
    x?!
}

main :: () {
    print("{}\n", kept(5));
    print("{}\n", passed(5));
}
