// any_to_string handles optionals through a `case optional:` arm and a dispatch
// table entry mapping `?T` TypeIds to the optional category. Without them a
// struct field of type `?T` prints as `<?>`, any_to_string's "no case matched"
// default.
//
// The variadic auto-unwrap path (packVariadicCallArgs) hides that for direct
// `print("{}\n", opt)` calls — it stringifies optionals to either the inner
// value's repr or `"null"` BEFORE boxing as any. Everywhere else that boxes an
// optional and reads it back through any_to_string (struct field printing,
// `xx opt : any`) hits the `<?>` floor.
//
// Each ?T variant routes through `case optional:` — the repr-classified
// table walk — to either the inner value's `any_to_string` representation
// or the literal `"null"`.

#import "modules/std.sx";

S :: struct {
    a: ?i64;
    b: ?string;
    c: ?bool;
}

main :: () {
    filled := S{ a = 42, b = "hi", c = true };
    print("{}\n", filled);
    empty := S{ a = null, b = null, c = null };
    print("{}\n", empty);
    0;
}
