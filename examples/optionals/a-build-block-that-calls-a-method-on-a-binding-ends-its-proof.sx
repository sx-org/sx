// A method a build block's body calls on one of the forming frame's optionals
// may clear it: the binding is not proven present after the call that receives
// the block, nor in a loop that forms it.
@import "modules/std.sx";

Sink :: struct {
    total: i64;
    expression :: (self: *Sink, v: i64) { self.total += v; }
}

collect :: (content: $B/@BuildBlock(i64)) -> i64 {
    sink := Sink{ total = 0 };
    content.run(*sink);
    sink.total
}

wipe :: ufcs (self: *?i64) { self.* = null; }

after :: (x: ?i64) -> i64 {
    if x == null { return 0; }
    t := collect() { x.wipe(); 1; };
    x + t
}

repeated :: (x: ?i64) -> i64 {
    if x == null { return 0; }
    sum := 0;
    for i in 0..2 {
        sum += x;
        sum += collect() { x.wipe(); 1; };
    }
    sum
}

main :: () {
    print("{}\n", after(5));
    print("{}\n", repeated(5));
}
