// Guard-narrowing reaches INDEXABLE payloads. After `if o == null
// { return; }` — and inside `if o != null` — a narrowed optional over an
// indexable payload (`?[]T`, `?[N]T`, `?*[N]T`, `?*[]T`) IS that payload at
// every container use site:
// - index reads (`o[i]` is the element, not `?Elem`);
// - index writes, compound writes, element addresses, element field writes,
//   and index targets of a multi-assign;
// - subslices (`o[0..n]` is `[]T`, viewing the payload's own storage);
// - generic binding, so a `[]$T` ufcs receiver binds `[]i64`.
// Un-narrowed, `o[i]` stays the optional chain `?Elem`; `q := o` keeps the
// declared `?[]T` (only guarded locals narrow — spell `q := o?!`).
@import "modules/std.sx";

P :: struct { n: i64 = 0; }
head :: ufcs (xs: []$T, k: i64) -> $T { return xs[k]; }

readElem :: (o: ?[]i64) -> i64 {
    if o == null { return -1; }
    return o[0];
}
readInArm :: (o: ?[]i64) -> i64 {
    if o != null { return o[1]; }
    return -1;
}
writeElem :: (o: ?[]i64) {
    if o == null { return; }
    o[0] = 9;
}
compoundElem :: (o: ?[]i64) {
    if o == null { return; }
    o[1] += 1;
}
elemAddr :: (o: ?[]i64) -> *i64 {
    if o == null { return null; }
    return *o[2];
}
elemField :: (o: ?[]P) {
    if o == null { return; }
    o[0].n = 5;
}
subslice :: (o: ?[]i64) -> i64 {
    if o == null { return 0; }
    s := o[1..3];
    return s.len + s[0];
}
genericBind :: (o: ?[]i64) -> i64 {
    if o == null { return -1; }
    return o.head(1);
}
arrayPayload :: (o: ?[4]i64) -> i64 {
    if o == null { return -1; }
    o[3] = 40;             // the payload writes IN PLACE, not through a copy
    s := o[1..3];          // and its subslice views that same storage
    return o[3] + s.len;
}
ptrToArray :: (o: ?*[4]i64) -> i64 {
    if o == null { return -1; }
    o[0] = 50;
    return o[0];
}
ptrToSlice :: (o: ?*[]i64) -> i64 {
    if o == null { return -1; }
    o[1] = 60;
    return o[1];
}
multiTarget :: (o: ?[]i64) {
    if o == null { return; }
    o[0], o[1] = 100, 200;
}
lenThroughGuard :: (o: ?[]i64) -> i64 {
    if o == null { return 0; }
    return o.len;
}
stillChains :: (o: ?[]i64) -> ?i64 {
    return o[0];           // un-narrowed: the optional chain keeps `?i64`
}
keepsStaticType :: (o: ?[]i64) -> ?[]i64 {
    if o == null { return null; }
    q := o;                // `q` is `?[]i64`, not `[]i64`
    return q;
}

main :: () {
    a: [4]i64 = .{ 1, 2, 3, 4 };
    process.assert(readElem(a[0..4]) == 1 and readElem(null) == -1, "read");
    process.assert(readInArm(a[0..4]) == 2, "read in != null arm");

    writeElem(a[0..4]);
    process.assert(a[0] == 9, "write");
    compoundElem(a[0..4]);
    process.assert(a[1] == 3, "compound write");
    p := elemAddr(a[0..4]);
    p.* = 30;
    process.assert(a[2] == 30, "element address");

    ps: [2]P = .{ .{}, .{} };
    elemField(ps[0..2]);
    process.assert(ps[0].n == 5, "element field write");

    process.assert(subslice(a[0..4]) == 5, "subslice");
    process.assert(genericBind(a[0..4]) == 3, "ufcs generic bind");
    process.assert(arrayPayload(a) == 42, "array payload write and subslice");

    b: [4]i64 = .{ 1, 2, 3, 4 };
    process.assert(ptrToArray(*b) == 50 and b[0] == 50, "pointer-to-array payload");
    bs := b[0..4];
    process.assert(ptrToSlice(*bs) == 60 and b[1] == 60, "pointer-to-slice payload");

    multiTarget(a[0..4]);
    process.assert(a[0] == 100 and a[1] == 200, "multi-assign targets");
    process.assert(lenThroughGuard(a[0..4]) == 4, "len");

    c := stillChains(a[0..4]);
    process.assert(c != null and c?! == 100, "un-narrowed index chains");
    process.assert(stillChains(null) == null, "null receiver chains to null");

    q := keepsStaticType(a[0..4]);
    process.assert(q != null and q?!.len == 4, "declared type preserved");

    print("ok\n");
}
