// A `*void` slot takes a guard-narrowed `?*T` exactly as it takes the `*T`:
// the guard's proof carries the unwrap, and the payload's own address
// conversion carries the rest.

@import "modules/std.sx";

Node :: struct { n: i64 = 5; }

asAddr :: (v: *void) -> bool { return v != null; }

reach :: (p: ?*Node) -> bool {
    if p == null { return false; }
    return asAddr(p);
}

main :: () {
    node := Node{};
    print("{} {}\n", reach(*node), reach(null));
}
