// A guard-narrowed optional stays unwrapped inside a nested arithmetic
// operand and under negation: `a * 16` and `-a` type at the payload, so the
// enclosing `+` sees an `i64`.

@import "modules/std.sx";

scale :: (a: ?i64) -> i64 {
    if a == null { return -1; }
    a * 16 + 1
}

flip :: (a: ?i64) -> i64 {
    if a == null { return 0; }
    -a + 1
}

main :: () {
    print("{} {} {} {}\n", scale(3), scale(null), flip(3), flip(null));
}
