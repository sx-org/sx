// An un-narrowed `?T` used directly as a binary-op operand is a compile error
// — it does not implicitly unwrap. The legal forms are `!` / `??` / a
// `!= null` guard (see 0921).
@import "modules/std.sx";

main :: () {
    a : ?i64 = null;
    b : i64 = 10;
    c := a + b;            // error: optional operand does not implicitly unwrap
    print("c = {}\n", c);
}
