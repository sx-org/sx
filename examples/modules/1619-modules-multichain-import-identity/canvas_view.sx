@import "modules/std.sx";
@import "document.sx";
@import "layer.sx";

CanvasView :: struct {
    doc: *Document;
}

cvActiveId :: (c: *CanvasView) -> i64 {
    layerAt(c.doc, c.doc.active).id
}

// Takes a `*Layer` directly — a value produced by ANOTHER chain (main's
// direct `document.sx` import) must typecheck here: single type identity.
cvIdOf :: (l: *Layer) -> i64 {
    l.id
}
