@import "modules/std.sx";
@import "document.sx";

Toolbar :: struct {
    doc: *Document;
    hoverTool: i64;
}

// Uses `Document`'s field type (`List(Layer)`) only INDIRECTLY through
// `layerAt` — resolving it must land on the same `Layer` identity the other
// chains see.
tbActiveId :: (t: *Toolbar) -> i64 {
    layerAt(t.doc, t.doc.active).id
}
