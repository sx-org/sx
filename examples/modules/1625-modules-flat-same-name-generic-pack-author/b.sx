// b.sx authors its OWN `ident` / `tally`. Both are monomorphized from the
// declaration, so the bare call must monomorphize b.sx's declaration.
ident :: (v: $T) -> i64 { return 2; }
tally :: (..$args) -> i64 { return 20; }

bGeneric :: () -> i64 { return ident(5); }
bPack    :: () -> i64 { return tally(1, 2); }
