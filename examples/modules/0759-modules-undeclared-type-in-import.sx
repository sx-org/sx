// A genuinely-undeclared type name used in an IMPORTED (non-main) module emits
// a clean "unknown type" diagnostic.
//
// The `UnknownTypeChecker` only walks MAIN-file decls — imported / library
// modules are trusted and never checked. The source-aware nominal leaf is what
// covers them: it poisons a genuinely-undeclared name with the `.unresolved`
// sentinel and emits the diagnostic at the reference, rather than letting the
// type leaf's empty-struct stub fabricate a 0-field type and mis-size `Thing`
// downstream. Here `lib.sx` references the non-existent type `Coordnate`.
#import "modules/std.sx";

#import "0759-modules-undeclared-type-in-import/lib.sx";

main :: () -> i32 {
    print("thing.x = {}\n", make_thing());
    return 0;
}
