// issue 0330: a bare TYPE-FUNCTION head instantiates the author visible where
// the head is written. Both flat-imported modules author `Make :: ($T) -> Type`
// with different layouts; b.sx also names its own through an alias. Each
// module's `Make(i64)` must be its own author's type — proving one visible
// author and then reading the body from the name-keyed map built the wrong
// layout (and the alias head was rejected as not visible).
#import "modules/std.sx";
#import "1626-modules-flat-same-name-type-fn-author/a.sx";
#import "1626-modules-flat-same-name-type-fn-author/b.sx";

report :: (label: string, ok: bool) {
    if ok { print("{}: ok\n", label); } else { print("{}: FAIL\n", label); }
}

main :: () -> i32 {
    report("b head binds b.Make (mark)", b_head() == 2);
    report("b alias head binds b.Make (mark)", b_alias_head() == 3);
    report("a head binds a.Make (tag)", a_head() == 1);
    0
}
