// Top-level `inline if @host.os == .X { ... }` body decls are spliced into
// module scope by expansion: import resolution leaves the driver opaque, and
// only the selected group becomes declarations, in the driver's own place.
//
// Three patterns covered: a global `var_decl`, an `@import`, and a
// nested `inline if` whose else arm fires on host macOS.

@import "modules/std.sx";

inline if @host.os == .android {
    @import "modules/std.sx";
    g_value : i64 = 99;
} else {
    g_value : i64 = 42;
}

main :: () { print("{}\n", g_value); }
