// JSON value model + writer from `modules/std/json.sx`.
//
// Builds a representative value — a nested object holding a string with
// every escape kind (quote, newline, tab, backslash, a raw control byte),
// integers spanning zero / a small negative / a small positive / i64 MIN
// (-9223372036854775808) / i64 MAX (9223372036854775807), a bool, null, an
// array, and a nested object — then serializes it three ways and asserts the
// EXACT bytes:
//
//   1. into a roomy caller-owned buffer through a `FixedWriter`,
//   2. into a file, built through a `StringBuilder` and written whole,
//   3. into a `FixedWriter` whose buffer is exactly the document's length.
//
// All three must yield byte-for-byte the same pinned document, with keys in
// INSERTION ORDER. A too-small buffer yields no document, and `len` names the
// size that would fit. The model is built through an explicit Arena allocator
// and freed in one `deinit`; `JsonWriter` itself allocates nothing.

@import "modules/std.sx";
@import "modules/std/mem.sx"; // `Allocator` is non-transitive: name it, import it.
@import "modules/std/json.sx";
@import "modules/std/fs.sx";

// The exact document the writer must produce (insertion order, escaping).
EXPECT :: "{\"name\":\"a\\\"b\\n\",\"tab\":\"x\\ty\",\"bs\":\"c\\\\d\",\"ctrl\":\"\\u0001\",\"n\":-7,\"zero\":0,\"pos\":7,\"min\":-9223372036854775808,\"max\":9223372036854775807,\"ok\":true,\"nil\":null,\"xs\":[1,-2,3],\"nested\":{\"k\":\"v\"}}";

report :: (label: string, ok: bool) {
    if ok { print("{}: ok\n", label); } else { print("{}: FAIL\n", label); }
}

build :: (alloc: Allocator) -> Value {
    // A raw control byte (0x01) viewed as a 1-byte string — exercises the
    // `\u00XX` path that has no named shorthand. String values are VIEWS,
    // so the bytes must outlive the writes: back them with `alloc` (the
    // arena), not a local that dies when `build` returns.
    cbytes : [*]u8 = xx alloc.allocBytes(1);
    cbytes[0] = 1;
    ctrl := string{ ptr = cbytes, len = 1 };

    nested : Object = .{};
    nested.put("k", .str("v"), alloc);

    xs : List(Value) = .{};
    xs.append(.int(1), alloc);
    xs.append(.int(0 - 2), alloc);
    xs.append(.int(3), alloc);

    obj : Object = .{};
    obj.put("name", .str("a\"b\n"), alloc);   // quote + newline
    obj.put("tab",  .str("x\ty"),   alloc);    // tab
    obj.put("bs",   .str("c\\d"),   alloc);    // backslash
    obj.put("ctrl", .str(ctrl),     alloc);    // raw control byte -> 
    obj.put("n",    .int(0 - 7),   alloc);    // small negative int
    obj.put("zero", .int(0),       alloc);    // zero
    obj.put("pos",  .int(7),       alloc);    // small positive int
    // i64 MIN: its magnitude (9223372036854775808) is not a representable
    // positive i64 literal, so build it from MAX-positive minus one.
    obj.put("min",  .int(0 - 9223372036854775807 - 1), alloc);
    obj.put("max",  .int(9223372036854775807),         alloc);  // i64 MAX
    obj.put("ok",   .bool(true),   alloc);
    obj.put("nil",  .null,         alloc);
    obj.put("xs",   .array(xs),     alloc);
    obj.put("nested", .object(nested), alloc);

    return .object(obj);
}

main :: () -> ! {
    gpa := GPA.init();
    arena := Arena.init(gpa, 4096);
    defer arena.deinit();

    root := build(arena);

    // 1. Write into a roomy caller buffer; assert exact bytes.
    buf : [512]u8 = ---;
    fw := FixedWriter.init(buf[..]);
    jw := JsonWriter.init(fw);
    try jw.write(root);
    view := fw.written()?!;
    print("doc: {}\n", view);
    report("buffer-exact", view == EXPECT);

    // A buffer one byte too small yields no document and names the size.
    tight := FixedWriter.init(buf[256..256 + EXPECT.len - 1]);
    tjw := JsonWriter.init(tight);
    try tjw.write(root);
    report("overflow-detected", tight.written() == null and tight.len == EXPECT.len);

    // 2. Write the document to a file and read it back. Write into the
    //    repo-local, gitignored scratch dir and unlink afterwards so nothing
    //    leaks and concurrent runs don't fight over a shared /tmp name.
    if !createDirAll(".sx-tmp") { print("mkdir: FAIL\n"); return; }
    path := ".sx-tmp/sx_0713_json.json";
    fsb := StringBuilder.init(arena);
    fjw := JsonWriter.init(fsb);
    try fjw.write(root);
    if !writeFile(path, fsb.finish()) { print("write: FAIL\n"); return; }

    back := readFile(path);
    deleteFile(path);
    if back == null { print("file-read: FAIL\n"); return; }
    report("file-exact", back?! == EXPECT);

    // 3. A buffer of exactly the document's length holds all of it.
    exact := FixedWriter.init(buf[256..256 + EXPECT.len]);
    ejw := JsonWriter.init(exact);
    try ejw.write(root);
    report("exact-fit", exact.written()?! == EXPECT);
    return;
}
