// a.sx is imported first, so its `go` alias owns the name-keyed slot. Its own
// uses select its own author — the same declaration the winner names.
@import "consume.sx";

target :: (x: i64 = 7) -> i64 { return x; }
go     :: target;

aCall     :: () -> i64 { return go(); }
aValue    :: () -> i64 { g : (i64) -> i64 = go; return g(7); }
aConsumed :: () -> i64 { return applySeeded(go, 7); }
