// b.sx reaches its own `target` through a two-hop alias chain. Every use — a
// call with the trailing default omitted, a function value, a capture, and a
// generic consumer's argument — must terminate at b.sx's `target`.
#import "consume.sx";

target :: (x: i64 = 20) -> i64 { return x + 100; }
hop    :: target;
go     :: hop;

b_call     :: () -> i64 { return go(); }
b_value    :: () -> i64 { g : (i64) -> i64 = go; return g(20); }
b_capture  :: () -> i64 { f := go; return f(20); }
b_consumed :: () -> i64 { return apply_seeded(go, 20); }
