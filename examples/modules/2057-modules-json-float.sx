@import "modules/std.sx";
@import "modules/std/mem.sx"; // `Allocator` is non-transitive: name it, import it.
@import "modules/std/json.sx";

// Multiplication preserves zero's sign.
neg_zero :: () -> f64 { 0.0 * (0.0 - 1.0) }

report :: (label: string, ok: bool) {
    if ok { print("{}: ok\n", label); } else { print("{}: FAIL\n", label); }
}

emits :: (f: f64, want: string) -> bool {
    buf : [64]u8 = ---;
    n, e := write_to_buffer(.float(f), string{ ptr = *buf[0], len = 64 });
    if e { return false; }
    string{ ptr = *buf[0], len = n } == want
}

// Reciprocals distinguish -0.0 from 0.0.
reads :: (src: string, want: f64, alloc: Allocator) -> bool {
    v, e := parse(src, alloc);
    if e { return false; }
    if v.float != want { return false; }
    (1.0 / v.float) == (1.0 / want)
}

raises :: (src: string, want: JsonParseError, alloc: Allocator) -> bool {
    _, e := parse(src, alloc);
    e == want
}

write_raises :: (f: f64, want: JsonError) -> bool {
    buf : [64]u8 = ---;
    _, e := write_to_buffer(.float(f), string{ ptr = *buf[0], len = 64 });
    e == want
}

round_trips :: (f: f64, alloc: Allocator) -> bool {
    buf : [64]u8 = ---;
    n, we := write_to_buffer(.float(f), string{ ptr = *buf[0], len = 64 });
    if we { return false; }
    v, pe := parse(string{ ptr = *buf[0], len = n }, alloc);
    if pe { return false; }
    if v.float != f { return false; }
    (1.0 / v.float) == (1.0 / f)
}

FAR_ZEROS :: 12000;

// Fractional leading zeros count toward the scale without entering the
// significand.
far_overflow_raises :: (alloc: Allocator) -> bool {
    tail := "1e999999999";
    len := 2 + FAR_ZEROS + tail.len;
    src : [*]u8 = xx alloc.alloc_bytes(len);
    src[0] = '0';
    src[1] = '.';
    i := 0;
    while i < FAR_ZEROS { src[2 + i] = '0'; i += 1; }
    j := 0;
    while j < tail.len { src[2 + FAR_ZEROS + j] = tail[j]; j += 1; }
    _, e := parse(string{ ptr = src, len = len }, alloc);
    e == .BadNumber
}

MIXED :: "{\"n\":-7,\"ratio\":1.5,\"xs\":[0.1,-0.5,3.0],\"scale\":1e-7,\"big\":1000000000.0}";

main :: () -> ! {
    gpa := GPA.init();
    arena := Arena.init(gpa, 8192);
    defer arena.deinit();

    report("half-writes-plain",     emits(1.5, "1.5"));
    report("negative-writes-sign",  emits(0.0 - 0.5, "-0.5"));
    report("tenth-writes-shortest", emits(0.1, "0.1"));
    report("integer-float-keeps-point", emits(3.0, "3.0"));
    report("padded-integer-keeps-point", emits(12300.0, "12300.0"));
    report("billion-keeps-point",   emits(1000000000.0, "1000000000.0"));
    report("mixed-digits-preserved", emits(123.456, "123.456"));
    report("small-writes-leading-zero", emits(0.000123, "0.000123"));
    report("tiny-writes-exponent",  emits(0.0000001, "1e-7"));
    report("pi-digits-preserved",   emits(3.141592653589793, "3.141592653589793"));
    report("zero-keeps-point",      emits(0.0, "0.0"));
    report("negative-zero-keeps-sign", emits(neg_zero(), "-0.0"));

    report("fraction-is-float",     reads("1.5", 1.5, arena));
    report("exponent-is-float",     reads("1e9", 1000000000.0, arena));
    report("capital-exponent-accepted", reads("2.5E-3", 0.0025, arena));
    report("positive-exponent-accepted", reads("1.5e+2", 150.0, arena));
    report("negative-zero-reads-signed", reads("-0.0", neg_zero(), arena));
    // A magnitude below half the smallest subnormal rounds to zero.
    report("underflow-rounds-to-zero", reads("1e-400", 0.0, arena));
    // 53 bits hold no odd number above 2^53, so 9007199254740993 reads as
    // its even neighbour.
    report("large-integer-rounds-even", reads("9007199254740993.0", 9007199254740992.0, arena));
    // This literal is the exact decimal expansion of the f64 value 0.1.
    report("exact-expansion-reads-tenth",
        reads("0.1000000000000000055511151231257827021181583404541015625", 0.1, arena));
    // Half an ulp above 1.0 is a tie; round-to-even takes 1.0.
    report("midpoint-rounds-even",
        reads("1.00000000000000011102230246251565404236316680908203125", 1.0, arena));

    report("max-round-trips",        round_trips(f64.max, arena));
    report("min-round-trips",        round_trips(f64.min, arena));
    report("min-normal-round-trips", round_trips(f64.min_positive, arena));
    report("true-min-round-trips",   round_trips(f64.true_min, arena));
    report("epsilon-round-trips",    round_trips(f64.epsilon, arena));
    report("negative-zero-round-trips", round_trips(neg_zero(), arena));

    report("overflow-is-bad-number", raises("1e400", .BadNumber, arena));
    report("missing-fraction-digit-is-bad-number", raises("1.", .BadNumber, arena));
    report("missing-exponent-digit-is-bad-number", raises("1e", .BadNumber, arena));
    report("leading-zero-is-bad-number", raises("01.5", .BadNumber, arena));
    // No JSON value starts with a point, so `.5` never reaches the number
    // grammar.
    report("bare-point-is-unexpected", raises(".5", .UnexpectedToken, arena));
    report("far-exponent-overflows", far_overflow_raises(arena));
    report("infinity-is-non-finite", write_raises(f64.inf, .NonFinite));
    report("nan-is-non-finite", write_raises(f64.nan, .NonFinite));

    tree := try parse(MIXED, arena);
    buf : [256]u8 = ---;
    n := try write_to_buffer(tree, string{ ptr = *buf[0], len = 256 });
    report("mixed-document-round-trips", string{ ptr = *buf[0], len = n } == MIXED);
    o := tree.object;
    report("bare-integer-stays-int", o.items[0].val.int == 0 - 7);
    report("fraction-becomes-float", o.items[1].val.float == 1.5);
    report("array-float-is-preserved", o.items[2].val.array.items[0].float == 0.1);
    print("=== DONE ===\n");
}
