// A MODULE-QUALIFIED struct literal — `m.Cfg{ ...}` — in a `:=`-inferred
// declaration resolves to the imported type `m.Cfg` (not an empty `{}` stub),
// so the value passes correctly to a function taking that type.
//
// The parser carries the qualified prefix as a `type_expr` NODE, and the type
// resolver handles a `field_access` in type position by resolving it the way a
// `: m.Cfg` annotation does (namespace alias → leaf in its module). Flattening
// the prefix to an "m.Cfg" struct_name STRING instead makes
// `findByName`/`resolveNominalLeaf` look it up as a bare type name, fabricate
// an empty-fields struct literally named "m.Cfg", and emit invalid LLVM IR
// (`call use({} ...)`) in both JIT and AOT.

m :: #import "0799-modules-qualified-struct-literal/lib.sx";

main :: () -> i32 {
    c := m.Cfg{ p = 1, q = 2 };   // qualified Type{} via := → resolves to m.Cfg
    return xx m.use(c);            // 1 + 2 + 0 = 3
}
