// A bare name is asked of the file that wrote it (specs: Modules — the namespace
// surface).
//
// Two modules each declare a `Panel` and join the same set. Inside either one, the
// bare name reaches its OWN declaration — for an annotation, and equally for the
// target of a downcast, which is the same question asked in another position. A
// module asking about its own value must not be answered with somebody else's
// type, however many other modules spell that name.
@import "modules/std.sx";
a :: @import "1635-modules-name-reaches-its-own/alpha/panel.sx";
b :: @import "1635-modules-name-reaches-its-own/beta/panel.sx";

main :: () -> i32 {
    // Each module's downcast reaches the `Panel` that module declares — both
    // temperaments, since both ask the one question.
    print("{} {}\n", a.own(), b.own());
    print("{} {}\n", a.own_hard(), b.own_hard());

    // And a bound head spelled bare inside the module that declares the set.
    print("{}\n", b.hold(b.Panel{ tag = "through a bound" }));
    0
}

// ** stdout **
// alpha value beta value
// alpha hard beta hard
// through a bound
//
