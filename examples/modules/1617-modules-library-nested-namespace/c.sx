// Innermost module: owns the @library and its extern fn.
@import "modules/std.sx";

pcaplib :: @library "pcap";
pcapLibVersion :: () -> ?cstring extern pcaplib "pcap_lib_version";

pcapVersion :: () -> string {
    p := pcapLibVersion();
    if p == null { return ""; }
    return fromCstring(p?!);
}
