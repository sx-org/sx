// Issue 0346, cross-module production shape: the imported module
// declares `impl Into(*DeadBox) for string` but imports nothing, so
// `Into` is not nameable in ITS scope. Dropping the impl silently
// degrades `xx "abc"` here to the reinterpret
// spill (b.v reads the string's header bytes; pointer targets then
// segfault — the objc.sx NSString bridge fails exactly this way).
// The build rejects the dead impl at its declaration.
#import "modules/std.sx";
#import "1621-modules-impl-needs-protocol-in-scope/dead_impl.sx";

main :: () {
    b : *DeadBox = xx "abc";
    print("b.v = {}\n", b.v);
}
