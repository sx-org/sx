// Cross-module name isolation. A callable local binding (fn pointer / closure)
// shadows any same-named top-level fn in call position, matching value-position
// resolution and spec §Variable Shadowing. Consulting the program-wide fn table
// before the lexical scope breaks an imported module's own `h := ...; h(...)`
// sites with "'h' is not visible" whenever the IMPORTER declares a module-scope
// fn named like that local.
@import "modules/std.sx";
lib :: @import "1618-modules-importer-fn-name-vs-importee-local/lib.sx";

// Module-scope fn named like the importee's LOCAL `h`.
h :: (x: i64) -> i64 { return x + 1; }

shadowTarget :: (x: i64) -> void { print("local fnptr {}\n", x); }

main :: () -> i32 {
    cfg : lib.Cfg = .{ onEvent = lib.hook };
    lib.emit(cfg, 41);
    print("h(1) = {}\n", h(1));

    // Same-module shadow: a local fn-pointer named `h` shadows THIS
    // module's own `h` in both call and value position.
    {
        h : (x: i64) -> void = shadowTarget;
        h(7);
        f := h;
        f(8);
    }
    // Shadow gone — the module-scope `h` is back.
    print("h(2) = {}\n", h(2));

    // Nested-fn shadowing is by DEPTH across
    // both local namespaces — an INNER nested fn beats an outer callable
    // var, and an INNER callable var beats an outer nested fn.
    {
        h : (x: i64) -> i64 = doubleIt;                // outer callable var
        {
            h :: (x: i64) -> i64 { return x + 100; }    // inner nested fn wins
            print("inner nested fn: {}\n", h(3));       // 103
        }
        print("outer var: {}\n", h(3));                 // 6
    }
    {
        h :: (x: i64) -> i64 { return x + 100; }        // outer nested fn
        {
            h : (x: i64) -> i64 = doubleIt;            // inner var wins
            print("inner var: {}\n", h(3));             // 6
        }
        print("outer nested fn: {}\n", h(3));           // 103
    }
    0
}

doubleIt :: (x: i64) -> i64 { return x * 2; }
