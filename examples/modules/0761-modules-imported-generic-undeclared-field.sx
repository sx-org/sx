// A genuinely-undeclared type in an IMPORTED GENERIC struct field emits
// "unknown type" even when the struct is instantiated from the main file —
// 0759 covers the non-generic imported struct instantiated in-module. The
// template's fields resolve in the TEMPLATE's own source context, not the
// main-file instantiation context, so the undeclared name surfaces instead of
// being trusted as a main-file decl.
@import "modules/std.sx";
@import "0761-modules-imported-generic-undeclared-field/lib.sx";

main :: () -> i32 {
    b : Bad(i32) = .{ x = 1, y = 2 };
    print("{}\n", b.x);
    return 0;
}
