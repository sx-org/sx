// CLI argument PARSER from `modules/std/cli.sx` — subcommand
// dispatch + `--flag` parsing over an EXPLICIT logical argv (`[]string`).
//
// Every argv vector below is an explicit `[]string` literal (the caller's
// logical args, program name already removed). The suite proves:
//
//   1. DISPATCH    — `<group> <command>` selects the right command in the
//                    caller's table; group/command are VIEWS into argv.
//   2. FLAGS       — `--out VALUE` (value-taking) binds a VIEW of the next
//                    token; `--verbose` (boolean) records presence; the
//                    reserved `--json` mode flag surfaces as `parsed.json`.
//   3. SEPARATORS  — `--` and the first bare operand both stop flag
//                    parsing; the remainder is `parsed.rest` (operand VIEWS).
//   4. OWNERSHIP   — flag values / group / command / rest all point INSIDE
//                    the input argv (zero copy); each `Parsed` holds its flag
//                    table in the `context.allocator` current at `parse`,
//                    and `deinit` or a raise returns it there.
//   5. FAILURES    — unknown command, unknown flag, missing required flag,
//                    and a value-flag with no value each raise the specific
//                    `cli.Error` variant on the error channel, and the
//                    caller-owned `Diag` names the offending token.

@import "modules/std.sx";

report :: (label: string, ok: bool) {
    if ok { print("{}: ok\n", label); } else { print("{}: FAIL\n", label); }
}

// Half-open containment [lo, hi) — proves a view points into argv.
inRange :: (x: i64, lo: i64, hi: i64) -> bool {
    return x >= lo and x < hi;
}

// True when `cli.parse(args, cmds)` raised exactly `want`. Destructure binds
// the error tag without `try`, so a bad vector never aborts the example;
// the failing token is captured in the caller-owned `Diag`.
raises :: (args: []string, cmds: []cli.Command, want: cli.Error) -> bool {
    d : cli.Diag = .{};
    _, e := cli.parse(args, cmds, *d);
    return e == want;
}

suite :: () -> ! {

    // ── Command table (caller storage; flag specs passed as views) ────
    publishFlags : []cli.FlagSpec = .[
        cli.FlagSpec{ name = "out",     takesValue = true,  required = true  },
        cli.FlagSpec{ name = "verbose", takesValue = false, required = false },
    ];
    statusFlags : []cli.FlagSpec = .[
        cli.FlagSpec{ name = "verbose", takesValue = false, required = false },
    ];
    cmds : []cli.Command = .[
        cli.Command{ group = "ci", command = "publish", flags = publishFlags },
        cli.Command{ group = "ci", command = "status",  flags = statusFlags  },
    ];

    // ── 1. Valid: <group> <command> --flag v --bool --json ───────────
    d : cli.Diag = .{};
    argv : []string = .["ci", "publish", "--out", "dist", "--verbose", "--json"];
    p := try cli.parse(argv, cmds, *d);
    defer p.deinit();

    report("dispatch-group",   p.group == "ci");
    report("dispatch-command", p.command == "publish");
    report("dispatch-index",   p.cmdIndex == 0);
    report("flag-value",       p.valueOf("out") == "dist");
    report("flag-value-set",   p.isSet("out"));
    report("bool-set",         p.isSet("verbose"));
    report("json-set",         p.json);
    report("no-rest",          p.rest.len == 0);

    // ── 2. Ownership: flag value is a VIEW into argv ──────────────────
    // "dist" is argv[3]; its bytes must lie inside that very element.
    src   : i64 = @reinterpret(isize, argv[3].ptr).(i64);
    stop  := src + argv[3].len;
    pview : i64 = @reinterpret(isize, p.valueOf("out").ptr).(i64);
    report("value-is-view", inRange(pview, src, stop) or pview == src);
    // group/command are argv[0]/argv[1] verbatim (same pointer, no copy).
    g0 : i64 = @reinterpret(isize, argv[0].ptr).(i64);
    gp : i64 = @reinterpret(isize, p.group.ptr).(i64);
    report("group-is-view", gp == g0);

    // ── 3. Dispatch to a different command in the table ──────────────
    sArgv : []string = .["ci", "status", "--verbose"];
    sp := try cli.parse(sArgv, cmds, *d);
    defer sp.deinit();
    report("dispatch-2nd",   sp.command == "status" and sp.cmdIndex == 1);
    report("2nd-bool",       sp.isSet("verbose"));
    report("2nd-json-unset", !sp.json);

    // ── 4. `--` separator: rest are operand views, flags stop there ──
    sepArgv : []string = .["ci", "publish", "--out", "dist", "--", "--raw", "x"];
    spv := try cli.parse(sepArgv, cmds, *d);
    defer spv.deinit();
    report("sep-value",   spv.valueOf("out") == "dist");
    report("sep-rest-len", spv.rest.len == 2);
    report("sep-rest-0",  spv.rest.len == 2 and spv.rest[0] == "--raw");
    report("sep-rest-1",  spv.rest.len == 2 and spv.rest[1] == "x");
    report("sep-no-bool", !spv.isSet("verbose"));

    // ── 5. First bare operand also stops flag parsing ────────────────
    bareArgv : []string = .["ci", "publish", "--out", "dist", "extra", "tail"];
    bpv := try cli.parse(bareArgv, cmds, *d);
    defer bpv.deinit();
    report("bare-rest-len", bpv.rest.len == 2);
    report("bare-rest-0",  bpv.rest.len == 2 and bpv.rest[0] == "extra");

    // ── 6. Value-flag accepts a single-dash value (not a long flag) ──
    dashArgv : []string = .["ci", "publish", "--out", "-5", "--verbose"];
    dpv := try cli.parse(dashArgv, cmds, *d);
    defer dpv.deinit();
    report("dash-value", dpv.valueOf("out") == "-5" and dpv.isSet("verbose"));

    // ── 7. Failures: each surfaces the specific variant ──────────────
    aZeroArgs     : []string = .[];                                       // nothing at all
    aUnknownCmd   : []string = .["ci", "deploy", "--out", "x"];
    aUnknownGroup : []string = .["zz", "publish", "--out", "x"];
    aTooFew       : []string = .["ci"];
    aUnknownFlag  : []string = .["ci", "publish", "--out", "x", "--nope"];
    aMissingValue : []string = .["ci", "publish", "--out"];
    aValueEats    : []string = .["ci", "publish", "--out", "--verbose"];
    aMissingReq   : []string = .["ci", "publish", "--verbose"];

    // A command declaring 17 flags parses, its last flag included.
    manyFlags : []cli.FlagSpec = .[
        cli.FlagSpec{ name = "f00", takesValue = false, required = false },
        cli.FlagSpec{ name = "f01", takesValue = false, required = false },
        cli.FlagSpec{ name = "f02", takesValue = false, required = false },
        cli.FlagSpec{ name = "f03", takesValue = false, required = false },
        cli.FlagSpec{ name = "f04", takesValue = false, required = false },
        cli.FlagSpec{ name = "f05", takesValue = false, required = false },
        cli.FlagSpec{ name = "f06", takesValue = false, required = false },
        cli.FlagSpec{ name = "f07", takesValue = false, required = false },
        cli.FlagSpec{ name = "f08", takesValue = false, required = false },
        cli.FlagSpec{ name = "f09", takesValue = false, required = false },
        cli.FlagSpec{ name = "f10", takesValue = false, required = false },
        cli.FlagSpec{ name = "f11", takesValue = false, required = false },
        cli.FlagSpec{ name = "f12", takesValue = false, required = false },
        cli.FlagSpec{ name = "f13", takesValue = false, required = false },
        cli.FlagSpec{ name = "f14", takesValue = false, required = false },
        cli.FlagSpec{ name = "f15", takesValue = false, required = false },
        cli.FlagSpec{ name = "f16", takesValue = false, required = false },
    ];
    manyCmds : []cli.Command = .[ cli.Command{ group = "big", command = "cmd", flags = manyFlags } ];
    manyArgs : []string  = .["big", "cmd", "--f16"];
    mp := try cli.parse(manyArgs, manyCmds, *d);
    defer mp.deinit();
    report("seventeen-flags", mp.isSet("f16") and !mp.isSet("f15"));

    report("err-zero-args",       raises(aZeroArgs,     cmds, .UnknownCommand));
    report("err-unknown-cmd",     raises(aUnknownCmd,   cmds, .UnknownCommand));
    report("err-unknown-group",   raises(aUnknownGroup, cmds, .UnknownCommand));
    report("err-too-few",         raises(aTooFew,       cmds, .UnknownCommand));
    report("err-unknown-flag",    raises(aUnknownFlag,  cmds, .UnknownFlag));
    report("err-missing-value",   raises(aMissingValue, cmds, .MissingValue));
    report("err-value-eats-flag", raises(aValueEats,    cmds, .MissingValue));
    report("err-missing-req",     raises(aMissingReq,   cmds, .MissingRequired));

    // ── 8. Diag pins the offending (token, index) for EVERY raise site ─
    // Each failure records the exact offending token (a VIEW into `args`,
    // except missing-required, which names the spec's flag) plus its `args`
    // index, so a caller can report which token failed. This covers every
    // raise site in cli.sx, both UnknownCommand sub-branches included:
    //   - zero-arg     -> index -1, token ""        (args.len == 0)
    //   - too-few      -> index  0, token args[0]   (args.len == 1)
    //   - unknown pair -> index  1, token command   (group OR command wrong)
    //   - unknown flag -> index  i, token flag tok
    //   - missing val  -> index  i, token flag tok
    //   - missing req  -> index -1, token flag name
    // The two index==-1 cases (zero-arg, missing-req) COINCIDE
    // with `Diag`'s `.{}` defaults (index -1, token ""), so those Diags are
    // seeded with a sentinel first: the assertion then proves `parse`
    // actually WROTE the value, not that it merely left the default.
    de : cli.Diag = .{};
    _, ue := cli.parse(aUnknownFlag, cmds, *de);
    report("diag-flag-tag",     ue == .UnknownFlag);
    report("diag-flag-token",   de.token == "--nope" and de.index == 4);

    dc : cli.Diag = .{};
    _, ce := cli.parse(aUnknownCmd, cmds, *dc);
    report("diag-cmd-tag",      ce == .UnknownCommand);
    report("diag-cmd-token",    dc.token == "deploy" and dc.index == 1);

    dg : cli.Diag = .{};
    _, ge := cli.parse(aUnknownGroup, cmds, *dg);
    report("diag-group-tag",    ge == .UnknownCommand);
    report("diag-group-token",  dg.token == "publish" and dg.index == 1);

    df : cli.Diag = .{};
    _, fe := cli.parse(aTooFew, cmds, *df);
    report("diag-too-few-tag",   fe == .UnknownCommand);
    report("diag-too-few-token", df.token == "ci" and df.index == 0);

    d0 : cli.Diag = .{ index = 999, token = "<unset>" };           // sentinel: -1/"" are defaults
    _, z0e := cli.parse(aZeroArgs, cmds, *d0);
    report("diag-zero-args-tag",   z0e == .UnknownCommand);
    report("diag-zero-args-token", d0.token == "" and d0.index == -1);

    dv : cli.Diag = .{};
    _, ve := cli.parse(aMissingValue, cmds, *dv);
    report("diag-missing-value-tag",   ve == .MissingValue);
    report("diag-missing-value-token", dv.token == "--out" and dv.index == 2);

    dz : cli.Diag = .{};
    _, ze := cli.parse(aValueEats, cmds, *dz);
    report("diag-value-eats-tag",   ze == .MissingValue);
    report("diag-value-eats-token", dz.token == "--out" and dz.index == 2);

    dm : cli.Diag = .{ index = 999, token = "<unset>" };           // sentinel: -1 is the default
    _, me := cli.parse(aMissingReq, cmds, *dm);
    report("diag-req-tag",    me == .MissingRequired);
    report("diag-req-token",  dm.token == "out");
    report("diag-req-index",  dm.index == -1);

    return;
}

main :: () -> ! {
    tracker := mem.TrackingAllocator.init(context.allocator);
    push .{ allocator = tracker } { try suite(); }
    report("flag-tables-returned", tracker.allocCount > 0 and tracker.leakCount() == 0);
    print("=== DONE ===\n");
    return;
}
