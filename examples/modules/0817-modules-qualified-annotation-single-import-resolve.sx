// A plain qualified `ns.Type` type ANNOTATION resolves to the namespace
// target module's OWN member type. `a.Box` parses as a single dotted
// `type_expr`, so it reaches the bare nominal-leaf path, where
// `resolveNominalLeaf` dot-splits the name and routes it through the
// namespace-author selector (`qualifiedNamedTypeTid`), binding `a`'s real
// `Box { a }`. Without the split the path fabricates an empty-struct stub
// literally named "a.Box" and `x.a` fails with
// `field 'a' not found on type 'a.Box'` — even with this SINGLE namespace
// import and NO same-name flat author.

#import "modules/std.sx";
a :: #import "0817-modules-qualified-annotation-single-import-resolve/dep.sx";

main :: () -> i32 {
    x : a.Box = ---;
    x.a = 4;
    print("x.a={}\n", x.a);
    0
}
