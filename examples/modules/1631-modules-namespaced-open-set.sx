// An open set reached through a module NAME (specs: Modules — the namespace
// surface; Open Sets — membership).
//
// A set is a named type like any other, so a module that owns one publishes it:
// `pkg.View` names it in an annotation, as a type argument, and as the head of a
// membership bound. Its members join it wherever the declaring module is reached
// from — membership is what the program declares, not how a consumer spelled the
// import that reached it, so the set has the same size and the same members either
// way.

@import "modules/std.sx";
@import "modules/std/list.sx";
pkg :: @import "1631-modules-namespaced-open-set/pkg/view.sx";

// A membership bound whose head is the set reached by name.
renderOne :: (v: $V/pkg.View) -> string => v.render();

main :: () -> i32 {
    // The set as an annotation, and a member through the same name.
    v: pkg.View = pkg.Label{ text = "through a name" };
    print("{} {}\n", v.render(), @typeOf(v));

    // The set as a TYPE ARGUMENT, and its size measured inside its own module and
    // out here: one set, one layout.
    xs : List(pkg.View) = .{};
    xs.append(v);
    print("size in {} out {} held {}\n", pkg.sizeHere(), @sizeOf(pkg.View), xs.len);

    // The bound head, taking the member and the set itself.
    print("bound {} {}\n", renderOne(pkg.Label{ text = "member" }), renderOne(v));

    // A value formed out here, given to a signature written in the set's own module.
    print("crossed {}\n", pkg.describe(v));
    0
}

// ** stdout **
// through a name Label
// size in 24 out 24 held 1
// bound member through a name
// crossed through a name
//
