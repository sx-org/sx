@import "modules/std.sx";
// b.sx authors its OWN `tag` returning i64. `showB`'s `v.tag()` is both
// dispatched AND typed as b.tag (i64 = 110), not the first-wins winner from a.sx
// (string). `print` types each arg from the call plan, so the two must agree.
tag :: ufcs (x: i64) -> i64 { return x + 100; }
showB :: () { v : i64 = 10; print("b: v.tag() = {}\n", v.tag()); }
