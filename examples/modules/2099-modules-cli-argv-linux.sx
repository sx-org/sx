// Std/cli LINUX argv lock (cross-target). compile_only on a non-linux dev host
// (the `target` sidecar mismatches host arch+os → the runner asserts .exit +
// .stderr from `sx ir --target`); runs the assertions end-to-end (exit 0) on a
// linux runner. `inline if @host.os` prunes the linux backend away on any other host,
// so compiling for linux is what type-checks it.
@import "modules/std/cli.sx";
@import "modules/std/mem.sx";

main :: () -> i32 {
    argc := cli.osArgc();
    if argc < 1 { return 1; }

    args := cli.osArgs();
    defer mem.free(context.allocator, args);
    if args.len != argc { return 2; }
    if args[0].len == 0 { return 3; }
    return 0;
}
