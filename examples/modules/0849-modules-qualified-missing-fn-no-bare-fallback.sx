// `empty.abs` must not fall through to the unrelated bare libc `abs` imported
// through native. A qualified call is pinned to the named namespace.

empty :: @import "0849-modules-qualified-missing-fn-no-bare-fallback/empty.sx";
native :: @import "0849-modules-qualified-missing-fn-no-bare-fallback/native.sx";

main :: () -> i32 {
    empty.abs(7)
}
