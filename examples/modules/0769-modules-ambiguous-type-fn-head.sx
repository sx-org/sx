// A type-returning FUNCTION head (`Make(i64)` where `Make :: ($T) -> Type`) is
// NON-transitive AND ambiguity-checked, exactly like the parameterized generic-
// struct / protocol heads (0767) and the nominal leaf (0755). `main` flat-imports
// two modules that each author a same-name `Make` type-fn with a different body
// and authors none itself, so the bare `Make(i64)` head is a genuine collision —
// it emits the LOUD "type 'Make' is ambiguous" diagnostic and poisons, never
// instantiating whichever single author `fn_ast_map` happens to hold.
//
// `headFnLeak` runs bare-call ambiguity selection rather than an `isNameVisible`
// check, which both authors satisfy.

#import "modules/std.sx";
#import "0769-modules-ambiguous-type-fn-head/a.sx";
#import "0769-modules-ambiguous-type-fn-head/b.sx";

main :: () -> i32 {
    print("size={}\n", size_of(Make(i64)));
    0
}
