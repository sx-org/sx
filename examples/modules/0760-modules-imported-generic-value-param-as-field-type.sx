// A generic struct's VALUE param (`$N: u32`) named in a TYPE position emits
// a clean diagnostic even when the struct is declared in an IMPORTED module —
// not just the main file (examples/0172 covers the main-file case). The field
// type leaf diagnoses the imported value-param misuse at the reference, the same
// way the main-file `UnknownTypeChecker` does, so the field never carries the
// `.unresolved` sentinel into LLVM emission.
@import "modules/std.sx";
@import "0760-modules-imported-generic-value-param-as-field-type/lib.sx";

main :: () -> i32 {
    b : Bad(3) = .{ x = 1 };
    print("{}\n", b.x);
    return 0;
}
