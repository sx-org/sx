// Per-decl nominal identity for ERROR-SET decls. A bare ERROR-SET reference
// is non-transitive AND ambiguity-checked at every site, exactly like the struct
// leaf (0755) and the enum/union leaves (0795/0797). `main` flat-imports two
// modules that each author a same-name `IoErr` error set and authors none itself,
// so EACH of the following bare ERROR-SET forms is a genuine collision the source
// cannot disambiguate — and each emits the LOUD "type 'IoErr' is ambiguous"
// diagnostic and poisons the result, never picking a global `findByName`
// last-wins author:
//
//   - reflection / type-arg slot     `size_of(IoErr)`
//   - typed error-value annotation    `e : IoErr = error.Disk`
//   - type-as-value                   `t : Type = IoErr`
//   - type-category match arm         `case IoErr:`
//   - `!Named` failable channel       `-> !IoErr`   (audited use surface)
//
// `type_bridge.resolveInlineErrorSet` routes through the source-aware author
// selection, and the `!IoErr` channel reaches it through
// `resolveErrorType -> resolveTypeName` rather than a global slot.

#import "modules/std.sx";
#import "0811-modules-same-name-error-set-ambiguous/a.sx";
#import "0811-modules-same-name-error-set-ambiguous/b.sx";

describe :: ($T: Type) -> i32 {
    r := if T == {
        case IoErr: 1;
        else: 0;
    }
    r
}

fail_io :: () -> !IoErr {
    raise error.Disk;
}

main :: () -> i32 {
    sz := size_of(IoErr);
    e : IoErr = error.Disk;
    t : Type = IoErr;
    k := describe(i64);
    0
}
