// b.sx is the SHADOW author for both names, with the OPPOSITE shapes:
// `combine` is VARIADIC, `pick` is FIXED. Each `fromB*` bare call packs
// against b's OWN author's signature — combine sums its variadic pack, pick
// subtracts its two fixed args.
combine :: (..xs: []i64) -> i64 {
    result := 0;
    for it in xs { result = result + it; }
    result
}
pick :: (a: i64, b: i64) -> i64 { return b - a; }
fromBCombine :: () -> i64 { return combine(1, 2, 3, 4); }
fromBPick :: () -> i64 { return pick(2, 7); }
