// Declares Wrap + an impl Into for it, for 0703-modules-into-import-scope.sx.
// No paired expected/ file — not executed standalone by the runner.

@import "modules/std.sx";

Wrap :: struct { v: i64 = 0; }

impl Into(Wrap) for i64 {
  convert :: (self: i64, alloc: Allocator = context.allocator) -> Wrap {
    _ = alloc;
    .{ v = self * 10 }
  }
}
