// Issue 0325 positive + target identity. `direct` owns its inner alias while
// `carried` receives the same alias spelling through exactly one flat hop.
// Both engines author the same terminal names with different
// layouts/values/variant ordinals, so every surface keeps the exact inner
// target rather than collapsing through a global name or monomorph cache.

direct :: @import "0910-modules-nested-namespace-noncall-identity/direct.sx";
carried :: @import "0910-modules-nested-namespace-noncall-identity/carried.sx";

ARecord :: direct.engineAlias.Record;
BRecord :: carried.engineAlias.Record;
AValue :: direct.engineAlias.COUNT;
BValue :: carried.engineAlias.COUNT;
ABox :: direct.engineAlias.Box(i64);
BBox :: carried.engineAlias.Box(i64);
AMade :: direct.engineAlias.Make(i64);
BMade :: carried.engineAlias.Make(i64);

main :: () -> i32 {
    ar : direct.engineAlias.Record = .{ aOnly = 1 };
    br : carried.engineAlias.Record = .{ bOnly = 2 };
    arLiteral := direct.engineAlias.Record{ aOnly = 3 };
    brLiteral := carried.engineAlias.Record{ bOnly = 4 };
    if ar.aOnly != 1 or br.bOnly != 2 or arLiteral.aOnly != 3 or brLiteral.bOnly != 4 { return 1; }

    aa : ARecord = .{ aOnly = 5 };
    ba : BRecord = .{ bOnly = 6 };
    if aa.aOnly != 5 or ba.bOnly != 6 { return 2; }

    if direct.engineAlias.COUNT != 11 or carried.engineAlias.COUNT != 22 { return 3; }
    if AValue != 11 or BValue != 22 { return 4; }
    aCounted : [direct.engineAlias.COUNT]u8 = ---;
    bCounted : [carried.engineAlias.COUNT]u8 = ---;
    if aCounted.len != 11 or bCounted.len != 22 { return 9; }
    if direct.engineAlias.Kind.selected.(i64) != 0 { return 5; }
    if carried.engineAlias.Kind.selected.(i64) != 1 { return 6; }

    direct.engineAlias.STATE = 31;
    carried.engineAlias.STATE = 42;
    direct.engineAlias.STATE += 1;
    carried.engineAlias.STATE += 2;
    if direct.engineAlias.STATE != 32 or carried.engineAlias.STATE != 44 { return 10; }

    ag : direct.engineAlias.Box(i64) = .{ aBox = 7 };
    bg : carried.engineAlias.Box(i64) = .{ bBox = 8 };
    aga : ABox = .{ aBox = 9 };
    bga : BBox = .{ bBox = 10 };
    if ag.aBox != 7 or bg.bBox != 8 or aga.aBox != 9 or bga.bBox != 10 { return 7; }

    am : direct.engineAlias.Make(i64) = .{ aMade = 12 };
    bm : carried.engineAlias.Make(i64) = .{ bMade = 13 };
    ama : AMade = .{ aMade = 14 };
    bma : BMade = .{ bMade = 15 };
    if am.aMade != 12 or bm.bMade != 13 or ama.aMade != 14 or bma.bMade != 15 { return 8; }
    0
}
