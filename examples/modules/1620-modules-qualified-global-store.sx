// Store through a QUALIFIED module global reached via a namespace-import alias:
// `lib.g = v` and the compound `lib.g += v`. The READ (`x := lib.g`) and the
// qualified CALL (`lib.fn()`) share the path. The store mirrors the read: it
// resolves the member as a mutable global in the imported module's context and
// emits `global_set`. Resolving the base `lib` as a VALUE expression — a module
// alias is not one — fails with "unresolved 'lib'".

@import "modules/std.sx";
lib :: @import "1620-modules-qualified-global-store/lib.sx";

main :: () -> i32 {
    print("{}\n", lib.libG);   // read: 0
    lib.libG = 5;              // qualified plain store
    print("{}\n", lib.libG);   // 5
    lib.libG += 10;            // qualified compound store (load-op-store)
    print("{}\n", lib.libG);   // 15
    lib.libG *= 2;             // 30
    print("{}\n", lib.libG);   // 30
    if lib.libG != 30 { return 1; }
    0
}
