// Two flat FILE imports each author a same-name
// free function `pick` (a.sx returns 1, b.sx returns 2). Each module takes
// `pick` as a function VALUE — both as `f := pick` and as a bare-name
// fn-pointer binding (`g : () -> i64 = pick`). The captured FuncId must be the
// RESOLVED author's (own-author wins), not the first-wins winner's: without
// per-source function-value conversion (closure + func_ref), b.sx's
// `pick`-as-value spellings both capture a.sx's winner (1).
@import "modules/std.sx";
@import "0731-modules-flat-same-name-closure/a.sx";
@import "0731-modules-flat-same-name-closure/b.sx";

report :: (label: string, ok: bool) {
    if ok { print("{}: ok\n", label); } else { print("{}: FAIL\n", label); }
}

main :: () -> i32 {
    report("fromA closure binds a.pick (1)", fromAClosure() == 1);
    report("fromB closure binds b.pick (2)", fromBClosure() == 2);
    report("fromA fn-value binds a.pick (1)", fromAValue() == 1);
    report("fromB fn-value binds b.pick (2)", fromBValue() == 2);
    0
}
