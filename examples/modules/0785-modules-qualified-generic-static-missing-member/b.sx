// Namespace B authors a generic `Box($T)` with `make`. It wins the global
// last-wins `struct_template_map`, and the qualified head `a.Box(..)` still does
// not reach it when namespace `a` lacks `Box`.
Box :: struct($T: Type) {
    x: T;

    make :: (value: T) -> Box(T) {
        .{ x = value }
    }
}
