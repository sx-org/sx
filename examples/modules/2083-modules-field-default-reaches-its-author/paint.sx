// The module that declares the structs, and the names their defaults reach.
@import "modules/std.sx";

Ink :: struct {
    name: string = "";

    dark :: () -> Ink => .{ name = "dark" };
}

INK_DEFAULT :: Ink{ name = "graphite" };
HAIRLINE :: 0.5;
STEP :: 7;
GRID :: 2.0;

Pen :: struct {
    ink: Ink = INK_DEFAULT;
    width: f32 = HAIRLINE;
}

Sheet :: struct {
    ground: Ink = Ink.dark();
    margin: f32 = HAIRLINE * 4.0;
}

// An integer field taking an integral-float default narrows through the fold
// that runs ahead of ordinary lowering.
Rule :: struct {
    count: i64 = STEP;
    span: i64 = GRID;
}

Slot :: struct ($T: Type) {
    value: T;
    ink: Ink = INK_DEFAULT;
}
