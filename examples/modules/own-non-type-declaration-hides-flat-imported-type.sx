// A file's own value `N` and function `M` hide a flat import's types `N` and
// `M`, so each is refused as that own declaration where a type is expected.
@import "modules/std.sx";
@import "own-non-type-declaration-hides-flat-imported-type/dep.sx";

N :: 5;
M :: () -> i64 { 1 }

main :: () -> i32 {
    x : N = ---;
    s := @sizeOf(M);
    0
}
