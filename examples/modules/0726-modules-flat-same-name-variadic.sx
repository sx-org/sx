// Two flat FILE imports each author same-name free
// functions whose VARIADIC SHAPE differs. `combine` is fixed-arity in a.sx
// (the first-wins winner) but variadic in b.sx (the shadow); `pick` is the
// reverse. Each module's bare call must pack arguments against ITS OWN
// author's signature — not the first-wins author's. A call path that
// re-fetches the first-wins AST by name to drive variadic packing packs b.sx's
// variadic `combine` as if fixed (and its fixed `pick` as if
// variadic) → wrong lowering.
@import "modules/std.sx";
@import "0726-modules-flat-same-name-variadic/a.sx";
@import "0726-modules-flat-same-name-variadic/b.sx";

report :: (label: string, ok: bool) {
    if ok { print("{}: ok\n", label); } else { print("{}: FAIL\n", label); }
}

main :: () -> i32 {
    report("fromA combine fixed", fromACombine() == 30);
    report("fromB combine variadic", fromBCombine() == 10);
    report("fromA pick variadic", fromAPick() == 6);
    report("fromB pick fixed", fromBPick() == 5);
    0
}
