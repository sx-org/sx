// The package's own set and one member, in the module that owns them.
@import "modules/std.sx";

View :: @OpenSet(.{ max = 128, align = 8 }) {
    render :: (self: *Self) -> string;
}

Label :: @OpenVariant(View) {
    text: string = "";
    render :: (self: *Label) -> string => self.text;
}

// Measured HERE, inside the declaring module: what the set is here is what it is
// anywhere, however a consumer reached this module.
sizeHere :: () -> i64 => @sizeOf(View);

// A signature written in the set's own terms, for a value formed elsewhere.
describe :: (v: View) -> string => v.render();
