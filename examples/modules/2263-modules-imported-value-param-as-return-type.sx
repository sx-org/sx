// An imported function whose comptime VALUE param (`$N: u32`) is named as the
// RETURN type diagnoses at the call: `N` is a compile-time integer, not a type.
@import "modules/std.sx";
@import "2263-modules-imported-value-param-as-return-type/lib.sx";

main :: () -> i32 {
    xs : []i64 = .{ 1, 2, 3 };
    print("{}\n", nth(xs, 1));
    return 0;
}
