// Companion module for the regression. An `xx <int>` argument to
// a variadic `format` (a comptime `..$args` pack), inside a function living
// in an IMPORTED module, auto-boxes to `any`: lowering pack args clears the
// enclosing fn's `target_type` (here `string`), which would otherwise
// monomorphize `__pack_string` and ABI-coerce the 4-byte int as a 16-byte
// string fat pointer.

#import "modules/std.sx";

build :: (n: i32) -> string {
    result := "items:\n";
    i : i32 = 0;
    while i < n {
        line := format("  item {}\n", xx i);   // <-- the xx-to-any pack arg
        result = concat(result, line);
        i = i + 1;
    }
    result
}
