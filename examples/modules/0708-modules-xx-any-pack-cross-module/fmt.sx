// Companion module. An `xx <int>` argument to
// a variadic `format` (a comptime `..$args` pack), inside a function living
// in an IMPORTED module, auto-boxes to `any`: lowering pack args clears the
// enclosing fn's `target_type` (here `string`), so the 4-byte int is not
// forced through `__pack_string`'s 16-byte fat-pointer ABI.

#import "modules/std.sx";

build :: (n: i32) -> string {
    result := "items:\n";
    i : i32 = 0;
    while i < n {
        line := format("  item {}\n", xx i);   // <-- the xx-to-any pack arg
        result = concat(result, line);
        i = i + 1;
    }
    result
}
