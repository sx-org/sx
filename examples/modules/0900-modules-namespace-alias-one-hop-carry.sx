// Namespace aliases are authored members of their own module and carry over
// exactly one direct flat-import edge. The transitive gate must keep both of
// these supported forms while rejecting a second flat hop.

internal :: @import "0900-modules-namespace-alias-one-hop-carry/internal.sx";
bridge :: @import "0900-modules-namespace-alias-one-hop-carry/bridge.sx";

main :: () -> i32 {
    if internal.engineAlias.secret() != 9 { return 1; }
    if bridge.engineAlias.secret() != 9 { return 2; }
    0
}
