@import "modules/std.sx";
@import "modules/ffi/objc.sx";

// A second view of the SAME runtime class under the same sx name,
// declaring a different method. A last-wins registry would drop one
// view, failing that module's calls at resolution.
Probe :: @ObjcClass("NSString") extern {
    length :: (self: *Self) -> u64;
}

probeLen :: (p: *void) -> u64 {
    s : *Probe = xx p;
    s.length()
}
