// A source site names the module the call is AUTHORED in, and the import path
// that reaches it is not part of its identity. `engine.report` calls `probe`
// in its own file; this program reaches that one call through two different
// importers, and both read the same site — engine's file, engine's declaration
// path.

@import "modules/std.sx";
@import "modules/std/core.sx";

eng :: @import "2088-modules-namespaced-site-names-its-module/engine.sx";
fac :: @import "2088-modules-namespaced-site-names-its-module/facade.sx";

main :: () -> i32 {
    direct := eng.report();
    throughFacade := fac.via();

    print("{}\n", direct.file);
    print("{}\n", direct.declaration);
    // A non-zero ordinal is what says the index answered: the unindexed
    // fall-back reports the enclosing declaration at ordinal 0.
    print("ordinal {}\n", direct.ordinal);
    print("same {} {}\n", direct.id == throughFacade.id, direct.ordinal == throughFacade.ordinal);
    0
}
