// The pass side of 0765: a DIRECTLY imported module's types are bare-visible in
// reflection / type-arg slots (`@sizeOf(Nums)`, `@sizeOf(*COnly)`) and in a
// typed array-literal annotation (`Nums.[...]`) — single-hop visibility.
// The visibility gate only rejects the 2-hop case (0765), never a
// directly-imported reference.

@import "modules/std.sx";
@import "0766-modules-reflection-type-direct-ok/c.sx";

main :: () -> i32 {
    print("{}\n", @sizeOf(Nums));
    print("{}\n", @sizeOf(*COnly));
    xs := Nums.[1, 2];
    print("{} {}\n", xs[0], xs[1]);
    0
}
