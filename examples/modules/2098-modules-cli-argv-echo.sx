// AOT gives this example its own process argv.
// argv[0] is normalized to presence because its value varies by invocation.

#import "modules/std.sx";
#import "modules/std/cli.sx";

main :: () {
    buf : [64]string = ---;
    args := os_args(buf[0..64]);

    print("argc={}\n", os_argc());
    print("filled={}\n", args.len);
    if args.len >= 1 and args[0].len > 0 { print("argv0: present\n"); }
    else { print("argv0: MISSING\n"); }

    i := 1;
    while i < args.len {
        print("argv[{}]={}\n", i, args[i]);
        i += 1;
    }
}
