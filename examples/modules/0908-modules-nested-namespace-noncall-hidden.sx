// Issue 0325 negative: an inner namespace alias carried across two flat-import
// edges is not part of the facade target's qualified surface. Every non-call
// consumer must stop at `facade.engineAlias` before a same-spelled global
// type/template/function/constant can be selected.

facade :: @import "0908-modules-nested-namespace-noncall-hidden/facade.sx";

main :: () -> i32 {
    annotated : facade.engineAlias.Record = ---;
    literal := facade.engineAlias.Record{ value = 1 };
    constant := facade.engineAlias.COUNT;
    variant := facade.engineAlias.Kind.selected;
    generic : facade.engineAlias.Box(i64) = ---;
    made : facade.engineAlias.Make(i64) = ---;
    facade.engineAlias.STATE = 1;
    0
}
