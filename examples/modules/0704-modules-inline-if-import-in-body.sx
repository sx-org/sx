// `@import` inside the body of a top-level `inline if @host.os == .X { ... }` block.
// Module-scope expansion surfaces those declarations to the top level before
// resolution, and `parseStmt` accepts them on every target — including where
// the branch is dead, as in `inline if @host.os == .android { @import "modules/platform/android.sx"; }`.
//
// The body also carries a global decl alongside the import, so the arm is
// exercised for the import itself and not just for a body that happens to
// contain declarations.

@import "modules/std.sx";

inline if @host.os == .android {
    @import "modules/std.sx";
    gAndroidOnly : i32 = 0;
}

main :: () { print("ok\n"); }
