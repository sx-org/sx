// One of two modules writing a `Panel`, over the set they both reach.
@import "modules/std.sx";
v :: @import "../view.sx";

Panel :: @OpenVariant(v.View) {
    tag: string = "twinB";
    render :: (self: *Panel) -> string => self.tag;
}

mk :: () -> v.View {
    p : Panel = .{ tag = "twinB value" };
    x : v.View = p;
    return x;
}
