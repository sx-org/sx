// a.sx authors `pick` returning 1. Imported first → first-wins winner.
// `fromAClosure` / `fromAValue` take a.sx's own author (own == winner →
// existing path, byte-for-byte unchanged).
pick :: () -> i64 { return 1; }
fromAClosure :: () -> i64 { f := pick; return f(); }
fromAValue   :: () -> i64 { g : () -> i64 = pick; return g(); }
