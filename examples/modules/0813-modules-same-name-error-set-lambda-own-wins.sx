// Own-wins for an ERROR-SET name in a CLOSURE-LITERAL return annotation
// (`() -> !IoErr { … }`). `main` flat-imports `dep.sx` (which authors
// `IoErr { Net }`) AND authors its OWN `IoErr { Disk }`. The closure literal's
// `-> !IoErr` channel must resolve to `main`'s OWN author (own-wins), so the
// `raise .Disk` inside the closure body validates against main's `{ Disk }`;
// meanwhile `depErr` keeps dep's DISTINCT `IoErr { Net }`.
//
// Resolving the explicit `lam.return_type` in `lowerLambda`
// through the STATELESS `type_bridge.resolveAstType` binds the closure's `!IoErr`
// channel to the global last-wins author (dep's `{ Net }`); `.Disk` is then
// then "not in error set 'IoErr'" and the program exited 1.
//
// The lambda return annotation routes through the source-aware
// `resolveTypeWithBindings` (same path as the regular function-return channel),
// main's own `IoErr` wins, `.Disk` validates, exit 0.

@import "modules/std.sx";
@import "0813-modules-same-name-error-set-lambda-own-wins/dep.sx";

IoErr :: error { Disk }

main :: () -> i32 {
    failOwn := || -> !IoErr { raise .Disk; };
    failOwn() catch |e| {
        if e == .Disk { print("own=Disk\n"); }
    };
    d := depErr();
    print("dep={}\n", d);
    return 0;
}
