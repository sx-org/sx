// A QUALIFIED generic head `a.Box(i64)` where namespace `a` exists but authors
// NO member named `Box` DIAGNOSES the missing member — it does not fall back to
// the bare last-wins `struct_template_map` and instantiate an unrelated module's
// same-name `Box`.
//
// `a.sx` authors only `Other` (no `Box`); `b.sx` authors a generic `Box($T)`.
// The qualified reference `a.Box(i64)` reports that `a` has no member `Box`.

@import "modules/std.sx";
a :: @import "0775-modules-qualified-generic-missing-member/a.sx";
b :: @import "0775-modules-qualified-generic-missing-member/b.sx";

main :: () -> i32 {
    x : a.Box(i64) = .{ x = 1, y = 2 };
    print("{}\n", x.x);
    0
}
