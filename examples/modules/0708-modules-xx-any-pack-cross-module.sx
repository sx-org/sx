// A variadic `format` arg inside an imported-module function boxes to `any`.
// Pack-arg lowering clears the enclosing fn's return type rather than typing
// the argument with it.
// The companion module is
// examples/modules/0708-modules-xx-any-pack-cross-module/fmt.sx.

@import "modules/std.sx";
@import "0708-modules-xx-any-pack-cross-module/fmt.sx";

main :: () -> i32 {
    print("{}", build(3));
    return 0;
}
