// `xx <int>` as a variadic `format` arg inside an
// imported-module function auto-boxes to any like the bare form. Mis-typing it
// as the enclosing fn's return type monomorphizes __pack_string and
// ABI-coerces the int as a 16-byte string fat pointer — a segfault.
// The companion module is examples/242-xx-any-pack-cross-module/fmt.sx.

#import "modules/std.sx";
#import "0708-modules-xx-any-pack-cross-module/fmt.sx";

main :: () -> i32 {
    print("{}", build(3));
    return 0;
}
