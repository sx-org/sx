// Product baseline probe: anonymous positional products store pack materialization.

@import "modules/std.sx";

PairI32 :: struct { a: i32; b: i32 };
Combined   :: struct { sources: PairI32; }

swap :: (a: i64, b: i64) -> (i64, i64) { return b, a; }
fst  :: (t: $T) -> i64 { t.0 }

main :: () -> i32 {
    pair := .{40, 2};
    print("A.idx     {} {}\n", pair.0, pair.1);
    named := .{x = 10, y = 20};
    print("A.named   {} {}\n", named.x, named.y);
    one := .{42};
    print("A.one     {}\n", one.0);
    a : i64 = pair.0;
    print("A.local   {}\n", a);

    c : Combined = ---;
    c.sources = .{a = 7, b = 9};
    print("B.field   {} {}\n", c.sources.a, c.sources.b);

    s := swap(1, 2);
    print("C.ret     {} {}\n", s.0, s.1);
    print("C.pass    {}\n", fst(.{11, 22}));
    print("C.eq      {}\n", .{1, 2} == .{1, 2});
    0
}
