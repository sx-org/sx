// The app-boot idiom for MetalGPU: `allocBytes` + `memset(0)` (struct
// field defaults are NOT applied on this path) + two-phase
// `init(null, 0, 0)`, then shader compilation before any layer exists.
// `init` establishes the layer-mode pixel format explicitly: the memset value 0
// is MTLPixelFormatInvalid, which every pipeline creation rejects ("No valid
// pixelFormats set").
@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/gpu/types.sx";
@import "modules/gpu/api.sx";
@import "modules/gpu/metal.sx";

MSL_MIN :: @string MSL
#include <metal_stdlib>
using namespace metal;
vertex float4 vmain(uint vid [[vertex_id]]) { return float4(0.0); }
fragment float4 fmain() { return float4(1.0); }
MSL;

main :: () -> i32 {
    inline if @host.os != .macos { print("format ok, shader handle: 1\n"); return 0; }

    gpu : *MetalGPU = xx context.allocator.allocBytes(@sizeOf(MetalGPU));
    c.memset(gpu, 0, @sizeOf(MetalGPU));
    if !gpu.init(null, 0, 0) { return 1; }

    // The invariant itself: the host driver tolerates format 0 until draw
    // time (only the sim's validation layer aborts), so pin the field, not
    // the pipeline call.
    if gpu.targetFormat != MTL_PIXEL_FORMAT_BGRA8_UNORM {
        print("target_format after init: {}\n", gpu.targetFormat);
        return 1;
    }

    sh := gpu.createShader(MSL_MIN, "");
    print("format ok, shader handle: {}\n", sh);
    if sh == 0 { return 1; }
    0
}
