@import "modules/std.sx";
@import "modules/build.sx";

// `@addAssetDir(src, dest)` records a pair; `@assetDirSrcAt(i)` reads the disk
// path and `@assetDirDestAt(i)` the in-bundle destination. The build fails if
// either half answers the other one's string.

configure :: () {
    opts := @buildOptions();
    @addAssetDir(opts, "art", "Resources/art");
    @addAssetDir(opts, "levels", "Resources/levels");
}
@run configure();

build :: (opt: BuildOptions) -> bool {
    if @assetDirCount(opt) != 2 { return false; }
    if @assetDirSrcAt(opt, 0) != "art" { return false; }
    if @assetDirDestAt(opt, 0) != "Resources/art" { return false; }
    if @assetDirSrcAt(opt, 1) != "levels" { return false; }
    if @assetDirDestAt(opt, 1) != "Resources/levels" { return false; }
    return defaultPipeline(opt);
}
@run @onBuild(build);

main :: () { print("asset dirs verified\n"); }
