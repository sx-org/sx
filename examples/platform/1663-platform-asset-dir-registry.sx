@import "modules/std.sx";
@import "modules/build.sx";

// `addAssetDir(src, dest)` records an `AssetDir` on `assetDirs`; the build
// fails if either half answers the other one's string.

configure :: () {
    opts := @buildOptions();
    opts.addAssetDir("art", "Resources/art");
    opts.addAssetDir("levels", "Resources/levels");
}
@run configure();

build :: (opt: *@BuildOptions) -> bool {
    if opt.assetDirs.len != 2 { return false; }
    if opt.assetDirs.items[0].src != "art" { return false; }
    if opt.assetDirs.items[0].dest != "Resources/art" { return false; }
    if opt.assetDirs.items[1].src != "levels" { return false; }
    if opt.assetDirs.items[1].dest != "Resources/levels" { return false; }
    return defaultPipeline(opt);
}
@run @onBuild(build);

main :: () { print("asset dirs verified\n"); }
