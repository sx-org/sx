// iOS-only: a fluent TextField on a UIKitPlatform in Metal mode. The
// example owns the session the field views, and drives the soft keyboard
// off the focus router: a tap on the field focuses it and raises the
// keyboard, a tap on the background clears the focus and lowers it. The
// field rides `safeInsets().bottom`, so the keyboard's own animation is
// what lifts it.
//
// The session reports its edits on the platform's IME queue, which the
// event batch carries out — never the root's intake.
//
// Build + run:
//   sx build --target ios-sim examples/platform/2282-platform-uikit-text-field.sx \
//     -o /tmp/SxTextField --bundle /tmp/SxTextField.app \
//     --bundle-id co.swipelab.sxtextfield
//   codesign --force --sign - --timestamp=none /tmp/SxTextField.app
//   xcrun simctl install booted /tmp/SxTextField.app
//   xcrun simctl launch --terminate-running-process booted co.swipelab.sxtextfield

@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/std/fs.sx";
@import "modules/build.sx";
@import "modules/gpu/types.sx";
@import "modules/gpu/api.sx";
@import "modules/gpu/metal.sx";
@import "modules/platform/api.sx";
@import "modules/platform/uikit.sx";
@import "modules/platform/uikit_app.sx";
@import "modules/ui/glyph_cache.sx";
@import "modules/ui/renderer.sx";
@import "modules/ui/fluent.sx";

@framework "UIKit";
@framework "QuartzCore";
@framework "OpenGLES";

// The face is the host's, never the repo's: AppleGothic carries Latin and
// Hangul in one file, so one face covers both scripts.
HOST_FACE :: "/System/Library/Fonts/Supplemental/AppleGothic.ttf";
STAGE_DIR :: ".sx-tmp/2282-uikit-text-field";
STAGE_FACE :: ".sx-tmp/2282-uikit-text-field/AppleGothic.ttf";
BUNDLE_FACE :: "assets/AppleGothic.ttf";

// A host without the face builds an app without one; the runtime answers
// that with a non-zero exit.
configure :: () {
    opts := buildOptions();
    opts.addAssetDir(STAGE_DIR, "assets");
    if !exists(HOST_FACE) { return; }
    if !createDirAll(STAGE_DIR) { return; }
    copyFile(HOST_FACE, STAGE_FACE);
}
@run configure();

FONT_SIZE :: 20.0;
FIELD_WIDTH :: 260.0;
FIELD_HEIGHT :: 44.0;
FIELD_LIFT :: 24.0;

gPlat     : *UIKitPlatform      = null;
gGpu      : *MetalGPU           = null;
gRenderer : *UIRenderer         = null;
gGlyphs   : *GlyphCache         = null;
gRoot     : *UiRoot             = null;
gLoop     : *FrameLoop          = null;
gSession  : *TextInputSession   = null;
gInsetBottom : f32  = 0.0;
// The keyboard this vehicle asked for, and the keyboard on screen.
gKeyboardUp   : bool = false;
gKeyboardSeen : bool = false;

frame :: () {
    fc := gPlat.beginFrame();

    // The layer is created during the scene connect, which fires after
    // main() has returned into UIApplicationMain.
    if gGpu.layer == null {
        glLayer := gPlat.glLayer;
        if glLayer == null { return; }
        if !gGpu.init(glLayer, gPlat.pixelW, gPlat.pixelH) { return; }
        gGlyphs.setDpiScale(fc.dpiScale);
        gRenderer.dpiScale = fc.dpiScale;
    }

    // The session already applied the edits it reports, so its own arms
    // stop here; the intake would apply them a second time.
    events := gPlat.pollEvents();
    i : i64 = 0;
    while i < events.len {
        match events.ptr[i] {
            case .input: |ie| {
                match ie {
                    case .text: |_| {}
                    case .composition: |_| {}
                    case .deleteBackward: |_| {}
                    else: { gRoot.queue.push(ie); }
                }
            }
            else: {}
        }
        i += 1;
    }

    gInsetBottom = gPlat.safeInsets().bottom;
    gRoot.viewport = Size{ width = fc.viewportW, height = fc.viewportH };
    gLoop.frame();

    // A swipe dismisses the keyboard without passing through the focus
    // router, so the field lets its focus go with it.
    if gPlat.keyboard().visible {
        gKeyboardSeen = true;
    } else if gKeyboardSeen {
        gKeyboardSeen = false;
        gKeyboardUp = false;
        gRoot.focus.clearFocus();
    }

    wants := gRoot.focus.wantsKeyboard();
    if wants != gKeyboardUp {
        if wants { gPlat.showKeyboard(); } else { gPlat.hideKeyboard(); }
        gKeyboardUp = wants;
    }

    // Published after the dismissal, which abandons the run the session
    // is still holding. This vehicle declares one field, so a live focus
    // is that field's.
    gPlat.session = null;
    if gRoot.focus.current() != null { gPlat.session = gSession; }

    bg : ClearColor = .{ r = 0.07, g = 0.09, b = 0.13, a = 1.0 };
    if !gGpu.beginFrame(bg) { return; }
    gRenderer.begin(fc.viewportW, fc.viewportH, gGlyphs.textureId);
    gRenderer.process(*gRoot.snapshot.scene);
    gGlyphs.uploadAtlasToGpu();
    gRenderer.flush();
    gGpu.endFrame(fc.targetPresentTime);
    gPlat.endFrame();
}

main :: () -> i32 {
    inline if @host.os != .ios { return 0; }

    plat := context.allocator.make(UIKitPlatform{ gpuMode = .metal });
    if !plat.init("Sx Text Field", 0, 0) { return 1; }
    gPlat = plat;

    // Device and queue come up without a layer, so the UI pipeline and the
    // atlas are built here — and the font, whose path resolves against the
    // bundle the platform init already chdir'd into.
    gGpu = context.allocator.make(MetalGPU{});
    if !gGpu.init(null, 0, 0) { return 1; }

    gRenderer = context.allocator.make(UIRenderer{});
    gRenderer.gpu = gGpu.(GPU);
    gRenderer.init();

    gGlyphs = context.allocator.make(GlyphCache{});
    gGlyphs.gpu = gGpu.(GPU);
    if !gGlyphs.init(BUNDLE_FACE, FONT_SIZE) { return 1; }
    setGlobalFont(gGlyphs);

    gSession = context.allocator.make(TextInputSession.init(*plat.imeQueue));
    gRoot = context.allocator.make(UiRoot.init(Size{ width = 0.0, height = 0.0 }, context.allocator));

    doc := gSession;
    gLoop = context.allocator.make(FrameLoop.init(gRoot, closure(||_{ doc } -> View {
        // The background declares its region FIRST, so the field's own
        // region — declared later — wins the points it covers and only a
        // tap outside reaches this one.
        v : View = zstack(ALIGN_BOTTOM) {
            tappable(Rect{ fill = Color.rgb(18, 23, 33) }, closure(|| {
                context.fluentFocus.clearFocus()
            }));
            place(textField(doc, FONT_SIZE), Mod{
                width = FIELD_WIDTH,
                height = FIELD_HEIGHT,
                bg = Color.rgb(38, 46, 62),
                corner = 8.0,
                margin = EdgeInsets{ top = 0.0, left = 0.0,
                    bottom = gInsetBottom + FIELD_LIFT, right = 0.0 },
            })
        };
        v
    }), context.allocator));

    uikitAppRun(plat, frame);
    plat.shutdown();
    0
}
