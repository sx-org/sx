// The `<name>.build` JSON config, `--target` threading, and the host-match
// EXECUTE path of the corpus runner. The companion `.build` pins the HOST
// target (`{ "target": "macos" }` resolves to the host arch+os), so the runner
// threads `--target` and still runs the example natively — its stdout is
// asserted as usual.
@import "modules/std.sx";
main :: () {
    print("target-host ok\n");
}
