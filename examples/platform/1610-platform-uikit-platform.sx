// UIKitPlatform end-to-end smoke: boots the AppDelegate, installs an
// SxGLView with a CAEAGLLayer + GLES3 context + CADisplayLink, polls
// UITouch events into the platform stream, and on every vsync clears
// the screen
// to a color that advances on each tap. Each tap also toggles the
// on-screen keyboard so safeInsets.bottom can be observed growing /
// shrinking under it.
//
// To visualize the safe-area / keyboard inset, the frame draws a red
// bar at the bottom whose height equals `safeInsets.bottom`. The
// platform interpolates `keyboardHeight` over the keyboard's own
// animation duration, so the bar slides in lockstep with iOS's
// keyboard.
//
// Build + run:
//   sx build --target ios-sim examples/platform/1610-platform-uikit-platform.sx \
//     -o /tmp/SxUIKitBoot --bundle /tmp/SxUIKitBoot.app \
//     --bundle-id co.swipelab.sxuikit -F ~/Library/Frameworks
//   xcrun simctl install booted /tmp/SxUIKitBoot.app
//   xcrun simctl launch booted co.swipelab.sxuikit

@import "modules/std.sx";
@framework "UIKit";
@framework "OpenGLES";
@framework "QuartzCore";
@import "modules/ffi/opengl.sx";
@import "modules/ui/types.sx";
@import "modules/ui/input.sx";
@import "modules/platform/uikit.sx";
@import "modules/platform/uikit_app.sx";

GL_SCISSOR_TEST :u32: 0x0C11;
glEnable_  : (u32) -> void = ---;
glDisable_ : (u32) -> void = ---;
glScissor_ : (i32, i32, i32, i32) -> void = ---;

gColorIndex : i64 = 0;
gKeyboardUp : bool = false;
gLoaded : bool = false;

tapFrame :: () {
    fc := gUikitPlat.beginFrame();

    if !gLoaded {
        // Cache the GL fn-ptrs we use beyond what modules/ffi/opengl.sx loads.
        glEnable_  = xx iosGlProc("glEnable".ptr);
        glDisable_ = xx iosGlProc("glDisable".ptr);
        glScissor_ = xx iosGlProc("glScissor".ptr);
        gLoaded = true;
    }

    events := gUikitPlat.pollEvents();
    i : i64 = 0;
    while i < events.len {
        ev := events.ptr[i];
        match ev {
            case .input: |ie| { match ie { case .pointerDown: {
                gColorIndex += 1;
                if gKeyboardUp {
                    gUikitPlat.hideKeyboard();
                    gKeyboardUp = false;
                } else {
                    gUikitPlat.showKeyboard();
                    gKeyboardUp = true;
                }
            } } }
        }
        i += 1;
    }

    phase := gColorIndex % 3;
    r : f32 = if phase == 0 then 0.8 else 0.1;
    g : f32 = if phase == 1 then 0.8 else 0.1;
    b : f32 = if phase == 2 then 0.8 else 0.1;

    glViewport(0, 0, fc.pixelW, fc.pixelH);
    glClearColor(r, g, b, 1.0);
    glClear(GL_COLOR_BUFFER_BIT);

    // Bottom bar = the interpolated safe-area bottom inset.
    insets := gUikitPlat.safeInsets();
    barHPx : i32 = xx (insets.bottom * fc.dpiScale);
    if barHPx > 0 {
        glEnable_(GL_SCISSOR_TEST);
        glScissor_(0, 0, fc.pixelW, barHPx);
        glClearColor(0.95, 0.25, 0.25, 1.0);
        glClear(GL_COLOR_BUFFER_BIT);
        glDisable_(GL_SCISSOR_TEST);
    }

    gUikitPlat.endFrame();
}

main :: () -> void {
    // iOS-only example (see the build+run header). The host seam gates
    // here — uikit.sx itself carries no per-function OS guards.
    inline if @host.os != .ios { return; }
    plat : *UIKitPlatform = xx c.libcMalloc(@sizeOf(UIKitPlatform));
    plat.init("SxUIKitPlatform", 0, 0);
    uikitAppRun(plat, tapFrame);
}
