@import "modules/std.sx";
@import "modules/build.sx";

// The `onBuild` override. A user `@run onBuild(build);` replaces the
// stdlib `defaultPipeline` as the build driver; the compiler invokes it after
// codegen with the `BuildOptions` handle. This build GROWS a `List` on the build
// VM then DELEGATES to `defaultPipeline` for the real emit + link, so a
// working binary is still produced → "runtime main".

build :: (opt: BuildOptions) -> bool {
    names := List(string){};
    names.append("alpha");
    names.append("beta");
    names.append("gamma");
    if names.len != 3 { return false; }
    return defaultPipeline(opt);
}
@run onBuild(build);

main :: () { print("runtime main\n"); }
