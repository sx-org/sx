// GLES3 backend compile gate for the Android target. Erasing
// `Gles3Gpu` to `GPU` pulls every impl method body into type-checking,
// so an unresolved GL call in any impl method fails this example.
//
// Compile-only: the Android target cannot execute on the host.

#import "modules/std.sx";
#import "modules/build.sx";
#import "modules/gpu/types.sx";
#import "modules/gpu/api.sx";
#import "modules/gpu/gles3.sx";

Bundle :: #jni_class("android/os/Bundle") extern {}

SxApp :: #jni_main #jni_class("co/swipelab/sxgles3build/SxApp") {
    onCreate :: (self: *Self, b: *Bundle) {
        super.onCreate(b);
    }
}

main :: () -> i32 {
    backend : Gles3Gpu = .{};
    gpu := backend.(GPU);
    gpu.resize(1080, 1920);
    0
}
