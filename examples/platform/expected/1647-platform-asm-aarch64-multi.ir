  %sg = extractvalue { i64, i64 } %asm, 0
  %sgN = extractvalue { i64, i64 } %asm, 1
  %si = insertvalue { i64, i64 } undef, i64 %sg, 0
  %siN = insertvalue { i64, i64 } %si, i64 %sgN, 1
  ret { i64, i64 } %siN
}

; Function Attrs: nounwind
