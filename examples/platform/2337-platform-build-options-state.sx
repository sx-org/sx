@import "modules/std.sx";
@import "modules/build.sx";

// The state set in `@run` is the state the next evaluation reads: a string
// field and an appended link flag survive the hop, a second `@run` appends to
// the list it inherited, and the callback sees both next to the `binaryPath`
// the compiler fills in before it runs.

configure :: () {
    opts := @buildOptions();
    opts.keystorePath = "probe.keystore";
    opts.addLinkFlag("-lm");
}
@run configure();

extend :: () { @buildOptions().addLinkFlag("-lm"); }
@run extend();

build :: (opt: *@BuildOptions) -> bool {
    if opt.keystorePath != "probe.keystore" { return false; }
    if opt.linkFlags.len != 2 or opt.linkFlags.items[0] != "-lm" or opt.linkFlags.items[1] != "-lm" { return false; }
    if opt.binaryPath.len == 0 { return false; }
    return defaultPipeline(opt);
}
@run @onBuild(build);

main :: () { print("state round-trips\n"); }
