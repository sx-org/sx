// BuildOptions.addFramework registers an Apple framework at comptime,
// equivalent to a top-level `@framework "Name"` directive. The advantage:
// you can gate it with `inline if @host.os == .ios { ... }` or similar logic,
// keeping the framework off non-Apple builds.

@import "modules/std.sx";
@import "modules/build.sx";

configureBuild :: () {
    opts := buildOptions();
    opts.addFramework("CoreFoundation");
}
@run configureBuild();

CFAbsoluteTimeGetCurrent :: () -> f64 extern;

main :: () -> i32 {
    t := CFAbsoluteTimeGetCurrent();
    return if t > 0.0 then 0 else 1;
}
