// Show something on screen — a UIWindow with a colored UIViewController root.
//
// Builds on 1607's AppDelegate and adds the iOS 13+ scene delegate named by the
// generated Info.plist. Inside `scene:willConnectToSession:options:`:
//   1. [[UIWindow alloc] initWithWindowScene:scene]
//   2. [[UIViewController alloc] init]; set view.backgroundColor
//   3. window.rootViewController = vc
//   4. [window makeKeyAndVisible]
//
// `gWindow` is a module-level global so the window outlives the IMP scope
// (no ARC; UIKit retains it as the key window anyway).

@import "modules/std.sx";
@import "modules/ffi/objc.sx";

@framework "UIKit";

UIApplicationMain :: (argc: i32, argv: *void, principalClass: *NSString, delegateClass: *NSString) -> i32 extern;

gWindow : *void = ---;

// SxSceneDelegate's `window` property. UIKit retains the delegate, and the
// module global keeps the window alive.
windowGetter :: (self: *void, _cmd: *void) -> *void abi(.c) {
    return gWindow;
}
windowSetter :: (self: *void, _cmd: *void, w: *void) abi(.c) {
    gWindow = w;
}

sceneWillConnect :: (self: *void, _cmd: *void, scene: *void, session: *void, options: *void) abi(.c) {
    _ := self;
    _ := _cmd;
    _ := session;
    _ := options;

    UIWindow         := objc_getClass("UIWindow".ptr);
    UIViewController := objc_getClass("UIViewController".ptr);
    UIColor          := objc_getClass("UIColor".ptr);

    selAlloc            := sel_registerName("alloc".ptr);
    selInit             := sel_registerName("init".ptr);
    selInitWithScene  := sel_registerName("initWithWindowScene:".ptr);
    selView             := sel_registerName("view".ptr);
    selSystemBlue      := sel_registerName("systemBlueColor".ptr);
    selSetBg           := sel_registerName("setBackgroundColor:".ptr);
    selSetRootVc      := sel_registerName("setRootViewController:".ptr);
    selMakeKeyVisible := sel_registerName("makeKeyAndVisible".ptr);

    msgO   : (*void, *void)               -> *void abi(.c) = xx objc_msgSend;
    msgV   : (*void, *void)               -> void abi(.c) = xx objc_msgSend;
    msgOo  : (*void, *void, *void)        -> void abi(.c) = xx objc_msgSend;
    msgOoo : (*void, *void, *void)        -> *void abi(.c) = xx objc_msgSend;

    // UIKit invokes this callback only after the UIWindowScene exists, unlike
    // application:didFinishLaunchingWithOptions: where connectedScenes is still
    // empty on current iOS releases.
    if scene == xx 0 { NSLog(nsstring("[sx] scene NULL\n")); return; }
    NSLog(nsstring("[sx] scene: ok\n"));

    winRaw := msgO(UIWindow, selAlloc);
    gWindow = msgOoo(winRaw, selInitWithScene, scene);
    NSLog(nsstring("[sx] window: ok\n"));

    vcRaw := msgO(UIViewController, selAlloc);
    vc     := msgO(vcRaw, selInit);
    msgOo(gWindow, selSetRootVc, vc);

    blue := msgO(UIColor, selSystemBlue);
    view := msgO(vc, selView);
    msgOo(view, selSetBg, blue);
    msgOo(gWindow, selSetBg, blue);

    msgV(gWindow, selMakeKeyVisible);
    NSLog(nsstring("[sx] makeKeyAndVisible done\n"));
}

didFinishLaunching :: (self: *void, _cmd: *void, app: *void, opts: *void) -> u8 abi(.c) {
    _ := self;
    _ := _cmd;
    _ := app;
    _ := opts;
    NSLog(nsstring("[sx] application:didFinishLaunchingWithOptions: called\n"));
    return 1;
}

main :: () -> i32 {
    UIResponder := objc_getClass("UIResponder".ptr);
    SxAppDelegate := objc_allocateClassPair(UIResponder, "SxAppDelegate".ptr, 0);

    class_addMethod(SxAppDelegate,
        sel_registerName("application:didFinishLaunchingWithOptions:".ptr),
        xx didFinishLaunching, "c@:@@".ptr);
    objc_registerClassPair(SxAppDelegate);

    // The bundler's UIApplicationSceneManifest names `SxSceneDelegate`.
    // Register it before UIApplicationMain reads the scene configuration.
    SxSceneDelegate := objc_allocateClassPair(UIResponder, "SxSceneDelegate".ptr, 0);
    sceneProto := objc_getProtocol("UISceneDelegate".ptr);
    windowSceneProto := objc_getProtocol("UIWindowSceneDelegate".ptr);
    if sceneProto != null { class_addProtocol(SxSceneDelegate, sceneProto); }
    if windowSceneProto != null { class_addProtocol(SxSceneDelegate, windowSceneProto); }
    class_addMethod(SxSceneDelegate,
        sel_registerName("scene:willConnectToSession:options:".ptr),
        xx sceneWillConnect, "v@:@@@".ptr);
    class_addMethod(SxSceneDelegate,
        sel_registerName("window".ptr),
        xx windowGetter, "@@:".ptr);
    class_addMethod(SxSceneDelegate,
        sel_registerName("setWindow:".ptr),
        xx windowSetter, "v@:@".ptr);
    objc_registerClassPair(SxSceneDelegate);

    return UIApplicationMain(0, xx 0, xx 0, nsstring("SxAppDelegate"));
}
