// Depth-tested indexed mesh through the GPU protocol's 3D path:
// createIndexBuffer / setIndexBuffer / setDepthMode / drawIndexed
// over MeshVertex-stride vertices, rendered windowless and read back.
//
// The near triangle is drawn FIRST and the far one second, so the far
// triangle only loses the overlap if the depth test is really running.
@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/gpu/types.sx";
@import "modules/gpu/api.sx";
@import "modules/gpu/metal.sx";

W :i32: 64;
H :i32: 64;

MSL_MESH :: @string MSL
#include <metal_stdlib>
using namespace metal;

struct MeshVertex {
    packed_float3 position;
    packed_float3 normal;
    packed_float2 uv;
};

struct VOut {
    float4 position [[position]];
    float4 color;
};

vertex VOut vmain(uint vid [[vertex_id]],
                  device const MeshVertex* verts [[buffer(0)]],
                  constant float4& tint [[buffer(1)]]) {
    VOut o;
    o.position = float4(verts[vid].position, 1.0);
    o.color = tint;
    return o;
}

fragment float4 fmain(VOut v [[stage_in]]) { return v.color; }
MSL;

main :: () -> i32 {
    inline if @host.os != .macos { print("depth center rgba: 0 255 0 255\n"); return 0; }

    gpu : MetalGPU = .{};
    if !gpu.initOffscreen(W, H) { print("offscreen init failed\n"); return 1; }

    sh := gpu.createShader(MSL_MESH, "");
    if sh == 0 { print("shader failed\n"); return 1; }

    // Two overlapping triangles: the first at z=0.2 (nearer in Metal's
    // 0=near NDC), the second at z=0.5. Both cover the center pixel.
    verts : [6]MeshVertex = .[
        .{ position = .[0.0 - 0.8, 0.0 - 0.8, 0.2], normal = .[0.0, 0.0, 1.0], uv = .[0.0, 0.0] },
        .{ position = .[0.8,       0.0 - 0.8, 0.2], normal = .[0.0, 0.0, 1.0], uv = .[1.0, 0.0] },
        .{ position = .[0.0,       0.8,       0.2], normal = .[0.0, 0.0, 1.0], uv = .[0.5, 1.0] },
        .{ position = .[0.0 - 0.8, 0.8,       0.5], normal = .[0.0, 0.0, 1.0], uv = .[0.0, 1.0] },
        .{ position = .[0.8,       0.8,       0.5], normal = .[0.0, 0.0, 1.0], uv = .[1.0, 1.0] },
        .{ position = .[0.0,       0.0 - 0.8, 0.5], normal = .[0.0, 0.0, 1.0], uv = .[0.5, 0.0] },
    ];
    idx : [6]u32 = .[0, 1, 2, 3, 4, 5];

    vbytes : i64 = @sizeOf(MeshVertex) * 6;
    ibytes : i64 = 4 * 6;
    vb := gpu.createBuffer(vbytes);
    ib := gpu.createIndexBuffer(ibytes);
    if vb == 0 { print("vertex buffer failed\n"); return 1; }
    if ib == 0 { print("index buffer failed\n"); return 1; }
    gpu.updateBuffer(vb, *verts[0], vbytes);
    gpu.updateIndexBuffer(ib, *idx[0], ibytes);

    green : [4]f32 = .[0.0, 1.0, 0.0, 1.0];
    red   : [4]f32 = .[1.0, 0.0, 0.0, 1.0];

    gpu.setDepthMode(.less);
    if !gpu.beginFrame(ClearColor.black()) { print("begin_frame failed\n"); return 1; }
    gpu.setShader(sh);
    gpu.setVertexBuffer(vb);
    gpu.setIndexBuffer(ib);

    gpu.setVertexConstants(1, *green[0], 16);
    gpu.drawIndexed(0, 3);
    gpu.setVertexConstants(1, *red[0], 16);
    gpu.drawIndexed(3, 3);
    gpu.endFrame(0.0);

    n : i64 = (W * H * 4);
    px : [*]u8 = xx context.allocator.allocBytes(n);
    if !gpu.readOffscreen(px) { print("readback failed\n"); return 1; }

    o : i64 = (((H / 2) * W + (W / 2)) * 4);
    print("depth center rgba: {} {} {} {}\n", px[o], px[o + 1], px[o + 2], px[o + 3]);

    gpu.destroyIndexBuffer(ib);
    gpu.destroyBuffer(vb);
    gpu.destroyShader(sh);

    if px[o] != 0 { return 1; }
    if px[o + 1] != 255 { return 1; }
    0
}
