@import "modules/std.sx";
@import "vendors/stb_image/stb_image.sx";

main :: () -> i32 {
    w: i32 = 0;
    h: i32 = 0;
    ch: i32 = 0;
    img := stb_image.stbi_load("test.png", *w, *h, *ch, 4);
    if img != null {
        print("loaded {}x{} ({} channels)\n", w, h, ch);
        stb_image.stbi_image_free(img);
    } else {
        print("no image (expected in test)\n");
    }
    0
}
