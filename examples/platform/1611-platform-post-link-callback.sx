#import "modules/std.sx";
#import "modules/build.sx";

// Post-link callback registration. The compiler invokes `post_link`
// after `target.link()` returns (sx build). Under `sx run` (JIT) the
// callback is registered but never invoked because there is no link
// phase, so this file prints `runtime main` alone; `sx build` is what
// exercises the post-link path.

puts :: (s: [:0]u8) -> i32 extern libc;

post_link :: (opt: BuildOptions) -> bool {
    puts("[post-link] callback fired");
    true
}

configure :: () {
    opts := build_options();
    on_build(post_link);
}
@run configure();

main :: () {
    print("runtime main\n");
}
