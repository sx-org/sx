// Writing a `@Vector` lane by letter — `.x`/`.y`/`.z`/`.w` and the colour
// aliases `.r`/`.g`/`.b` — reads back the written value.

@import "modules/std.sx";

main :: () {
    // `.[…]`-init, then write each lane of a 4-lane vector.
    v : @Vector(4, f32) = .[0.0, 0.0, 0.0, 0.0];
    v.x = 1.0;
    v.y = 2.0;
    v.z = 3.0;
    v.w = 4.0;
    print("x={}\n", v.x);
    print("y={}\n", v.y);
    print("z={}\n", v.z);
    print("w={}\n", v.w);

    // `= ---` (undefined) init, then write every lane.
    u : @Vector(4, f32) = ---;
    u.x = 10.0;
    u.y = 20.0;
    u.z = 30.0;
    u.w = 40.0;
    print("u={} {} {} {}\n", u.x, u.y, u.z, u.w);

    // Colour aliases on a 3-lane vector.
    col : @Vector(3, f32) = .[0.0, 0.0, 0.0];
    col.r = 0.5;
    col.g = 0.25;
    col.b = 0.125;
    print("col={} {} {}\n", col.r, col.g, col.b);

    // Compound lane assignment.
    col.r += 0.5;
    col.g *= 4.0;
    print("col2={} {}\n", col.r, col.g);
}
