// A `@Vector` lane count that is not a compile-time integer (here a runtime
// function call) is a hard error — a clean sx diagnostic with a non-zero exit,
// NOT a fabricated `<0 x float>` lane that crashes LLVM verification.
//
// A hand-rolled `else => 0` switch in the vector lane
// resolver silently fabricates a 0-lane vector for a non-const lane. The
// resolver folds the lane through the shared const-int evaluator and, when that
// yields no compile-time integer, emits this diagnostic and halts the build.
#import "modules/std.sx";

lanes :: () -> u32 { return 3; }

main :: () {
    v : @Vector(lanes(), f32) = ---;
    print("unreachable: {}\n", v.x);
}
