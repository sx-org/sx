// A `@Vector` lane count that is not a compile-time integer (here a runtime
// function call) is a hard error — a clean sx diagnostic with a non-zero exit.
//
// The resolver folds the lane through the shared const-int evaluator and, when
// that yields no compile-time integer, emits this diagnostic and halts the
// build. The diagnostic points at the lane expression, and the process exits
// non-zero. A non-const lane never produces a vector value.
//
@import "modules/std.sx";

lanes :: () -> u32 { return 3; }

main :: () {
    v : @Vector(lanes(), f32) = ---;
    print("unreachable: {}\n", v.x);
}
