MemorySource :: struct {
    data: string;
    maxChunk: i64 = i64.max;
    largestRequest: i64 = 0;
    calls: i64 = 0;
    failAt: i64 = -1;
    failure: Error = .Io;
}

impl ZipSource for MemorySource {
    size :: (self: *MemorySource) -> i64 { self.data.len }

    readAt :: (self: *MemorySource, offset: i64, output: string) -> (string, !Error) {
        self.calls += 1;
        if output.len > self.largestRequest { self.largestRequest = output.len; }
        if offset < 0 or offset > self.data.len { raise .InvalidData; }
        if self.failAt >= 0 and offset >= self.failAt { raise self.failure; }
        take := self.data.len - offset;
        if take > output.len { take = output.len; }
        if take > self.maxChunk { take = self.maxChunk; }
        i := 0;
        while i < take { output[i] = self.data[offset + i]; i += 1; }
        output[..take]
    }
}

Collector :: struct {
    bytes: [16384]u8 = .{};
    len: i64 = 0;
    calls: i64 = 0;
    failAfter: i64 = -1;
    failure: Error = .Io;
}

impl ZipSink for Collector {
    write :: (self: *Collector, data: string) -> !Error {
        if self.failAfter >= 0 and self.calls >= self.failAfter { raise self.failure; }
        self.calls += 1;
        if data.len > self.bytes.len - self.len { raise .OutputLimit; }
        i := 0;
        while i < data.len { self.bytes[self.len + i] = data[i]; i += 1; }
        self.len += data.len;
    }
}

TrackingAllocator :: struct {
    parent: Allocator;
    live: i64 = 0;
}

impl Allocator for TrackingAllocator {
    allocBytes :: (self: *TrackingAllocator, size: i64) -> *void {
        raw := self.parent.allocBytes(size);
        if raw != null { self.live += 1; }
        raw
    }

    deallocBytes :: (self: *TrackingAllocator, ptr: *void) {
        if ptr == null { return; }
        self.live -= 1;
        self.parent.deallocBytes(ptr);
    }
}

same :: (left: string, right: string) -> bool {
    if left.len != right.len { return false; }
    i := 0;
    while i < left.len {
        if left[i] != right[i] { return false; }
        i += 1;
    }
    true
}

centralHeaderAt :: (archive: string, index: i64) -> i64 {
    at := 0;
    found := 0;
    while at + 4 <= archive.len {
        if archive[at] == 0x50 and archive[at + 1] == 0x4b and archive[at + 2] == 0x01 and archive[at + 3] == 0x02 {
            if found == index { return at; }
            found += 1;
        }
        at += 1;
    }
    -1
}

streamReportsChecksum :: (stream: *zip.EntryReader) -> bool {
    scratch : [17]u8 = ---;
    while true {
        part, failure := stream.read(scratch[..]);
        if failure { return failure == .ChecksumMismatch; }
        if part.len == 0 { return false; }
    }
    false
}

metadataLimitRejected :: (source: ZipSource, limit: i64, alloc: Allocator) -> bool {
    reader := zip.openSource(source, .{ maxMetadata = limit }, alloc) catch |e| { return e == .OutputLimit; };
    reader.deinit();
    false
}

makeArchive :: (alloc: Allocator, archiveComment: string = "archive comment") -> string {
    repeated := "miniz exact miniz exact miniz exact miniz exact miniz exact";
    localExtra : [7]u8 = .[0xfe, 0xca, 3, 0, 'a', 'b', 'c'];
    centralExtra : [6]u8 = .[0xef, 0xbe, 2, 0, 'X', 'Y'];
    local : string = localExtra[..];
    central : string = centralExtra[..];
    writer := zip.Writer.init(.{}, alloc) catch { return .{ ptr = null, len = 0 }; };
    writer.add("stored.txt", "stored payload", .{
        method = .store,
        extra = local,
        centralExtra = central,
        comment = "stored comment",
    }) catch { writer.deinit(); return .{ ptr = null, len = 0 }; };
    writer.add("deflated.txt", repeated, .{ method = .deflate, level = 6 }) catch {
        writer.deinit(); return .{ ptr = null, len = 0 };
    };
    writer.add("empty/", "", .{ method = .store }) catch {
        writer.deinit(); return .{ ptr = null, len = 0 };
    };
    writer.finish(archiveComment) catch { writer.deinit(); return .{ ptr = null, len = 0 }; };
    archive := writer.take() catch { writer.deinit(); return .{ ptr = null, len = 0 }; };
    writer.deinit();
    archive
}

testExactMinizBytes :: (alloc: Allocator) -> bool {
    archive := makeArchive(alloc, "");
    if archive.ptr == null { return false; }
    exact := same(archive, MINIZ_EXACT_ARCHIVE[..]);
    alloc.deallocBytes(archive.ptr);
    exact
}

testMemoryReader :: (alloc: Allocator) -> bool {
    repeated := "miniz exact miniz exact miniz exact miniz exact miniz exact";
    archive := makeArchive(alloc);
    if archive.ptr == null { return false; }
    reader := zip.open(archive, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    if reader.len() != 3 or reader.comment() != "archive comment" or reader.isZip64() {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }
    stored := reader.entry(0) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    deflated := reader.entry(1) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    directory := reader.entry(2) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    if stored.name != "stored.txt" or stored.method != .store or stored.size != 14 or
       stored.comment != "stored comment" or !stored.supported or !stored.safePath or
       deflated.method != .deflate or directory.name != "empty/" or !directory.directory {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }
    if (reader.find("deflated.txt") catch { -1 }) != 1 { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; }
    wrongCaseFailed := false;
    ignoredIndex := reader.find("DEFLATED.TXT") catch |e| { wrongCaseFailed = e == .NotFound; -1 };
    if !wrongCaseFailed { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; }

    output : [128]u8 = ---;
    plain := reader.extractInto(1, output[..], alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    if !same(plain, repeated) or plain.ptr != *output[0] { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; }
    limited := false;
    unexpected := reader.extract(1, repeated.len - 1, alloc) catch |e| {
        limited = e == .OutputLimit;
        string{ ptr = null, len = 0 }
    };
    if !limited {
        if unexpected.ptr != null { alloc.deallocBytes(unexpected.ptr); }
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }

    compressed := reader.extractCompressed(1, 1024, alloc) catch {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    decoded := deflate.decode(compressed, 1024, alloc) catch {
        alloc.deallocBytes(compressed.ptr); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    compressedOk := same(decoded, repeated);
    alloc.deallocBytes(decoded.ptr);
    alloc.deallocBytes(compressed.ptr);
    if !compressedOk { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; }

    sink := Collector{};
    made := reader.extractTo(1, xx sink, 1024, alloc) catch {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    if made != repeated.len or !same(sink.bytes[..sink.len], repeated) {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }
    reader.validate(false, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    reader.deinit();
    reader.deinit();
    alloc.deallocBytes(archive.ptr);
    true
}

testSourcesAndSinks :: (alloc: Allocator) -> bool {
    archive := makeArchive(alloc);
    if archive.ptr == null { return false; }
    source := MemorySource{ data = archive };
    reader := zip.openSource(xx source, .{ maxMetadata = 65536 }, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    plain := reader.extractName("stored.txt", 64, alloc) catch {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    sourceOk := same(plain, "stored payload") and source.calls > 0 and source.largestRequest <= 65536;
    alloc.deallocBytes(plain.ptr);
    reader.deinit();
    if !sourceOk { alloc.deallocBytes(archive.ptr); return false; }

    limitedSource := MemorySource{ data = archive };
    tinyLimitFailed := metadataLimitRejected(xx limitedSource, 1, alloc);
    if !tinyLimitFailed { alloc.deallocBytes(archive.ptr); return false; }

    payload := "source source source source source source";
    input := MemorySource{ data = payload, maxChunk = 5 };
    output := Collector{};
    writer := zip.Writer.initSink(xx output, .{}, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    writer.addSource("source.txt", xx input, .{ method = .deflate, level = 6, storeSmall = false }) catch {
        writer.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    writer.finish() catch { writer.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    writer.deinit();
    streamed := zip.open(output.bytes[..output.len], alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    streamedPlain := streamed.extractName("source.txt", 1024, alloc) catch {
        streamed.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    streamedOk := same(streamedPlain, payload) and input.calls > 1;
    alloc.deallocBytes(streamedPlain.ptr);
    streamed.deinit();
    alloc.deallocBytes(archive.ptr);
    streamedOk
}

testEntryStreams :: (alloc: Allocator) -> bool {
    repeated := "miniz exact miniz exact miniz exact miniz exact miniz exact";
    archive := makeArchive(alloc);
    if archive.ptr == null { return false; }

    source := MemorySource{ data = archive, maxChunk = 7 };
    reader := zip.openSource(xx source, .{ maxMetadata = 65536 }, alloc) catch {
        alloc.deallocBytes(archive.ptr); return false;
    };
    stream := reader.streamName("deflated.txt", 1024, alloc) catch {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    if stream.len() != repeated.len or stream.offset() != 0 {
        stream.deinit(); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }

    first : [9]u8 = ---;
    firstBytes := stream.read(first[..]) catch {
        stream.deinit(); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    if !same(firstBytes, repeated[..first.len]) or stream.offset() != first.len {
        stream.deinit(); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }
    stream.seek(20) catch {
        stream.deinit(); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    middle : [11]u8 = ---;
    middleBytes := stream.read(middle[..]) catch {
        stream.deinit(); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    if !same(middleBytes, repeated[20..31]) {
        stream.deinit(); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }
    stream.seek(0) catch {
        stream.deinit(); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };

    restored : [128]u8 = ---;
    restoredLen := 0;
    reading := true;
    while reading {
        end := restoredLen + 5;
        if end > restored.len { end = restored.len; }
        part := stream.read(restored[restoredLen..end]) catch {
            stream.deinit(); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
        };
        restoredLen += part.len;
        if part.len == 0 { reading = false; }
    }
    streamOk := restoredLen == repeated.len and same(restored[..restoredLen], repeated) and
                 stream.offset() == repeated.len and stream.len() == repeated.len and source.calls > 0;
    stream.deinit();
    if !streamOk { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; }

    expectedRaw := reader.extractCompressed(1, 1024, alloc) catch {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    rawStream := reader.streamCompressed(1, 1024, alloc) catch {
        alloc.deallocBytes(expectedRaw.ptr); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    raw : [128]u8 = ---;
    rawLen := 0;
    reading = true;
    while reading {
        end := rawLen + 3;
        if end > raw.len { end = raw.len; }
        part := rawStream.read(raw[rawLen..end]) catch {
            rawStream.deinit(); alloc.deallocBytes(expectedRaw.ptr);
            reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
        };
        rawLen += part.len;
        if part.len == 0 { reading = false; }
    }
    rawOk := same(raw[..rawLen], expectedRaw);
    rawStream.deinit();
    alloc.deallocBytes(expectedRaw.ptr);
    reader.deinit();
    alloc.deallocBytes(archive.ptr);
    rawOk
}

testTerminalChecksumErrors :: (alloc: Allocator) -> bool {
    archive := makeArchive(alloc);
    if archive.ptr == null { return false; }
    storedAt := centralHeaderAt(archive, 0);
    deflatedAt := centralHeaderAt(archive, 1);
    if storedAt < 0 or deflatedAt < 0 {
        alloc.deallocBytes(archive.ptr); return false;
    }

    archive[storedAt + 16] ^= 1;
    storedReader := zip.open(archive, alloc) catch {
        archive[storedAt + 16] ^= 1; alloc.deallocBytes(archive.ptr); return false;
    };
    storedStream := storedReader.stream(0, 1024, alloc) catch {
        storedReader.deinit(); archive[storedAt + 16] ^= 1; alloc.deallocBytes(archive.ptr); return false;
    };
    storedOk := streamReportsChecksum(*storedStream);
    storedStream.deinit(); storedStream.deinit();
    storedReader.deinit();
    archive[storedAt + 16] ^= 1;
    if !storedOk { alloc.deallocBytes(archive.ptr); return false; }

    archive[deflatedAt + 16] ^= 1;
    deflatedReader := zip.open(archive, alloc) catch {
        archive[deflatedAt + 16] ^= 1; alloc.deallocBytes(archive.ptr); return false;
    };
    deflatedStream := deflatedReader.stream(1, 1024, alloc) catch {
        deflatedReader.deinit(); archive[deflatedAt + 16] ^= 1; alloc.deallocBytes(archive.ptr); return false;
    };
    deflatedOk := streamReportsChecksum(*deflatedStream);
    deflatedStream.deinit(); deflatedStream.deinit();
    deflatedReader.deinit();
    archive[deflatedAt + 16] ^= 1;
    if !deflatedOk { alloc.deallocBytes(archive.ptr); return false; }

    archive[deflatedAt + 16] ^= 1;
    source := MemorySource{ data = archive, maxChunk = 7 };
    sourceReader := zip.openSource(xx source, .{ maxMetadata = 65536 }, alloc) catch {
        archive[deflatedAt + 16] ^= 1; alloc.deallocBytes(archive.ptr); return false;
    };
    archive[deflatedAt + 16] ^= 1;
    sourceStream := sourceReader.stream(1, 1024, alloc) catch {
        sourceReader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    sourceOk := streamReportsChecksum(*sourceStream);
    sourceStream.deinit(); sourceStream.deinit();
    sourceReader.deinit();
    if !sourceOk { alloc.deallocBytes(archive.ptr); return false; }

    archive[deflatedAt + 16] ^= 1;
    seekReader := zip.open(archive, alloc) catch {
        archive[deflatedAt + 16] ^= 1; alloc.deallocBytes(archive.ptr); return false;
    };
    seekStream := seekReader.stream(1, 1024, alloc) catch {
        seekReader.deinit(); archive[deflatedAt + 16] ^= 1; alloc.deallocBytes(archive.ptr); return false;
    };
    seekFailure := seekStream.seek(seekStream.len());
    seekOk := !seekFailure and streamReportsChecksum(*seekStream);
    seekStream.deinit(); seekStream.deinit();
    seekReader.deinit();
    archive[deflatedAt + 16] ^= 1;
    alloc.deallocBytes(archive.ptr);
    seekOk
}

testTransferErrorsAndCleanup :: (alloc: Allocator) -> bool {
    archive := makeArchive(alloc);
    if archive.ptr == null { return false; }
    source := MemorySource{ data = archive };
    reader := zip.openSource(xx source, .{ maxMetadata = 65536 }, alloc) catch {
        alloc.deallocBytes(archive.ptr); return false;
    };

    tracking := TrackingAllocator{ parent = alloc };
    before := tracking.live;
    source.failAt = 0;
    source.failure = .UnexpectedEnd;
    provisional, provisionalFailure := zip.Writer.fromReader(*reader, .{}, tracking);
    if !provisionalFailure { provisional.deinit(); }
    fromReaderOk := provisionalFailure == .UnexpectedEnd and tracking.live == before;
    if !fromReaderOk {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }

    memoryWriter := zip.Writer.init(.{}, alloc) catch {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    sourceFailure := memoryWriter.addFrom(*reader, 0);
    memoryWriter.deinit();
    if sourceFailure != .UnexpectedEnd {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }

    source.failAt = -1;
    target := Collector{ failAfter = 0, failure = .OutputLimit };
    sinkWriter := zip.Writer.initSink(xx target, .{}, alloc) catch {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    targetFailure := sinkWriter.addFrom(*reader, 0);
    source.failAt = 0;
    source.failure = .UnexpectedEnd;
    bothFailure := sinkWriter.addFrom(*reader, 0);
    sinkWriter.deinit();
    reader.deinit();
    alloc.deallocBytes(archive.ptr);
    targetFailure == .OutputLimit and bothFailure == .OutputLimit
}

testEmptyUnsupportedEntries :: (alloc: Allocator) -> bool {
    writer := zip.Writer.init(.{}, alloc) catch { return false; };
    writer.add("empty.bin", "", .{ method = .store }) catch { writer.deinit(); return false; };
    writer.finish("") catch { writer.deinit(); return false; };
    archive := writer.take() catch { writer.deinit(); return false; };
    writer.deinit();
    central := centralHeaderAt(archive, 0);
    if central < 0 { alloc.deallocBytes(archive.ptr); return false; }
    originalFlags := archive[central + 8];
    originalMethod := archive[central + 10];
    empty : [1]u8 = ---;

    archive[central + 8] = originalFlags | 1;
    encryptedReader := zip.open(archive, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    _, encryptedFailure := encryptedReader.extractInto(0, empty[..0], alloc);
    encryptedReader.deinit();
    archive[central + 8] = originalFlags | 0x20;
    patchedReader := zip.open(archive, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    _, patchedFailure := patchedReader.extractInto(0, empty[..0], alloc);
    patchedReader.deinit();
    archive[central + 8] = originalFlags;
    archive[central + 10] = 99;
    unknownReader := zip.open(archive, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    _, decodedFailure := unknownReader.extractInto(0, empty[..0], alloc);
    raw := unknownReader.extractCompressedInto(0, empty[..0], alloc) catch {
        unknownReader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    unknownReader.deinit();
    archive[central + 10] = originalMethod;
    ok := encryptedFailure == .Unsupported and patchedFailure == .Unsupported and
          decodedFailure == .Unsupported and raw.len == 0;
    alloc.deallocBytes(archive.ptr);
    ok
}

testUpdateAndTransfer :: (alloc: Allocator) -> bool {
    archive := makeArchive(alloc);
    if archive.ptr == null { return false; }
    source := zip.open(archive, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };

    updater := zip.Writer.fromReader(*source, .{}, alloc) catch {
        source.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    updater.add("added.txt", "new payload", .{ method = .deflate }) catch {
        updater.deinit(); source.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    updater.finish() catch { updater.deinit(); source.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    updatedBytes := updater.take() catch {
        updater.deinit(); source.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    updater.deinit();
    updated := zip.open(updatedBytes, alloc) catch {
        source.deinit(); alloc.deallocBytes(updatedBytes.ptr); alloc.deallocBytes(archive.ptr); return false;
    };
    if updated.len() != 4 or updated.comment() != "archive comment" {
        updated.deinit(); source.deinit(); alloc.deallocBytes(updatedBytes.ptr); alloc.deallocBytes(archive.ptr); return false;
    }
    added := updated.extractName("added.txt", 128, alloc) catch {
        updated.deinit(); source.deinit(); alloc.deallocBytes(updatedBytes.ptr); alloc.deallocBytes(archive.ptr); return false;
    };
    updateOk := same(added, "new payload");
    alloc.deallocBytes(added.ptr);
    updated.deinit();
    alloc.deallocBytes(updatedBytes.ptr);
    if !updateOk { source.deinit(); alloc.deallocBytes(archive.ptr); return false; }

    transfer := zip.Writer.init(.{}, alloc) catch { source.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    transfer.addFrom(*source, 1) catch { transfer.deinit(); source.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    transfer.finish("") catch { transfer.deinit(); source.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    transferBytes := transfer.take() catch { transfer.deinit(); source.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    transfer.deinit();
    transferred := zip.open(transferBytes, alloc) catch {
        source.deinit(); alloc.deallocBytes(transferBytes.ptr); alloc.deallocBytes(archive.ptr); return false;
    };
    originalRaw := source.extractCompressed(1, 1024, alloc) catch {
        transferred.deinit(); source.deinit(); alloc.deallocBytes(transferBytes.ptr); alloc.deallocBytes(archive.ptr); return false;
    };
    copiedRaw := transferred.extractCompressed(0, 1024, alloc) catch {
        alloc.deallocBytes(originalRaw.ptr); transferred.deinit(); source.deinit();
        alloc.deallocBytes(transferBytes.ptr); alloc.deallocBytes(archive.ptr); return false;
    };
    transferOk := same(originalRaw, copiedRaw);
    alloc.deallocBytes(copiedRaw.ptr);
    alloc.deallocBytes(originalRaw.ptr);
    transferred.deinit();
    alloc.deallocBytes(transferBytes.ptr);
    if !transferOk { source.deinit(); alloc.deallocBytes(archive.ptr); return false; }

    forced := zip.Writer.fromReader(*source, .{ forceZip64 = true }, alloc) catch {
        source.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    forced.finish() catch { forced.deinit(); source.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    forcedBytes := forced.take() catch { forced.deinit(); source.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    forced.deinit();
    forcedReader := zip.open(forcedBytes, alloc) catch {
        source.deinit(); alloc.deallocBytes(forcedBytes.ptr); alloc.deallocBytes(archive.ptr); return false;
    };
    forcedOk := forcedReader.isZip64() and forcedReader.len() == 3;
    forcedReader.validate(false, alloc) catch { forcedOk = false; };
    forcedReader.deinit();
    alloc.deallocBytes(forcedBytes.ptr);

    source.deinit();
    alloc.deallocBytes(archive.ptr);
    forcedOk
}

testPrefixAndDuplicates :: (alloc: Allocator) -> bool {
    writer := zip.Writer.init(.{}, alloc) catch { return false; };
    writer.reservePrefix(7) catch { writer.deinit(); return false; };
    writer.add("duplicate", "first", .{ method = .store }) catch { writer.deinit(); return false; };
    writer.add("duplicate", "second", .{ method = .store }) catch { writer.deinit(); return false; };
    writer.add("../unsafe", "x", .{ method = .store, modifiedSeconds = 1700000000 }) catch {
        writer.deinit(); return false;
    };
    writer.finish("duplicates") catch { writer.deinit(); return false; };
    archive := writer.take() catch { writer.deinit(); return false; };
    writer.deinit();
    if archive.len < 7 { alloc.deallocBytes(archive.ptr); return false; }
    i := 0;
    while i < 7 { if archive[i] != 0 { alloc.deallocBytes(archive.ptr); return false; } i += 1; }
    reader := zip.openEmbedded(archive, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    if reader.len() != 3 or reader.comment() != "duplicates" or (reader.find("duplicate") catch { -1 }) != 0 {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }
    unsafe := reader.entry(2) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    if unsafe.safePath or unsafe.modifiedSeconds == null or unsafe.modifiedSeconds?! != 1700000000 {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    }
    reader.validate(false, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    first := reader.extractName("duplicate", 16, alloc) catch {
        reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    ok := same(first, "first");
    alloc.deallocBytes(first.ptr);
    reader.deinit();
    alloc.deallocBytes(archive.ptr);
    ok
}

testFiles :: (alloc: Allocator) -> bool {
    archivePath := "/tmp/sx_std_zip_public.zip";
    inputPath := "/tmp/sx_std_zip_input.txt";
    extractedPath := "/tmp/sx_std_zip_extracted.txt";
    fs.deleteFile(archivePath); fs.deleteFile(inputPath); fs.deleteFile(extractedPath);
    if !fs.writeFile(inputPath, "file payload") or !fs.setModifiedSeconds(inputPath, 1700000000) { return false; }

    writer := zip.Writer.initFile(archivePath, .{}, alloc) catch { fs.deleteFile(inputPath); return false; };
    writer.add("base.txt", "base", .{ method = .store }) catch {
        writer.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    };
    writer.addFile("from-file.txt", inputPath, .{ method = .deflate, useFileModifiedTime = true }) catch {
        writer.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    };
    writer.finish("file comment") catch {
        writer.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    };
    writer.deinit();

    append := zip.Writer.appendFile(archivePath, .{ maxMetadata = 65536 }, alloc) catch {
        fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    };
    append.add("added.txt", "added", .{ method = .deflate }) catch {
        append.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    };
    append.finish() catch { append.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false; };
    append.deinit();

    reader := zip.openFile(archivePath, .{ maxMetadata = 65536 }, alloc) catch {
        fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    };
    if reader.len() != 3 or reader.comment() != "file comment" {
        reader.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    }
    fileEntry := reader.entry(1) catch {
        reader.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    };
    if fileEntry.modifiedSeconds == null or fileEntry.modifiedSeconds?! != 1700000000 {
        reader.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    }
    made := reader.extractFile(2, extractedPath, 64, alloc) catch {
        reader.deinit(); fs.deleteFile(archivePath); fs.deleteFile(inputPath); return false;
    };
    reader.deinit();
    maybeFile := fs.openFile(extractedPath, .read);
    if maybeFile == null {
        fs.deleteFile(archivePath); fs.deleteFile(inputPath); fs.deleteFile(extractedPath); return false;
    }
    file := maybeFile?!;
    buffer : [16]u8 = ---;
    read := file.read(buffer[..]);
    closed := file.close();
    ok := made == 5 and read == 5 and closed and same(buffer[..read], "added");
    fs.deleteFile(archivePath); fs.deleteFile(inputPath); fs.deleteFile(extractedPath);
    ok
}

testErrorsAndPoison :: (alloc: Allocator) -> bool {
    invalidLevel := zip.Writer.init(.{}, alloc) catch { return false; };
    levelFailed := false;
    invalidLevel.add("bad", "x", .{ level = 11 }) catch |e| { levelFailed = e == .InvalidOptions; };
    invalidLevel.deinit();
    if !levelFailed { return false; }

    oldTime := zip.Writer.init(.{}, alloc) catch { return false; };
    timeFailed := false;
    oldTime.add("old", "x", .{ modifiedSeconds = 0 }) catch |e| { timeFailed = e == .InvalidOptions; };
    oldTime.deinit();
    if !timeFailed { return false; }

    failing := Collector{ failAfter = 1 };
    writer := zip.Writer.initSink(xx failing, .{}, alloc) catch { return false; };
    firstFailed := false;
    writer.add("payload", "payload payload payload", .{ storeSmall = false }) catch |e| { firstFailed = e == .Io; };
    callsAfterFailure := failing.calls;
    secondFailed := false;
    writer.add("again", "again", .{}) catch |e| { secondFailed = e == .Io; };
    poisoned := firstFailed and secondFailed and failing.calls == callsAfterFailure;
    writer.deinit();
    poisoned
}

// Explicit fallible finalization: EntryReader.finish validates completion +
// checksum (clean after the terminal read, raising when the stream was
// abandoned early); Writer.close reports backend flush/close failures and is
// idempotent, with take() extracted first for memory writers.
testFinalization :: (alloc: Allocator) -> bool {
    inputs : [1]zip.Input = .[ .{ name = "a.txt", data = "finalization coverage payload" } ];
    archive := zip.create(inputs[..], .{}, "", alloc) catch { return false; };
    reader := zip.open(archive, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    ok := true;

    complete := reader.stream(0, 1024, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    buf : [64]u8 = ---;
    while true {
        got, ge := complete.read(buf[..]);
        if ge { ok = false; break; }
        if got.len == 0 { break; }
    }
    complete.finish() catch { ok = false; };
    complete.deinit();

    abandoned := reader.stream(0, 1024, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    partial, pe := abandoned.read(buf[..8]);
    if pe { ok = false; }
    if partial.len == 0 { ok = false; }
    earlyRaised := false;
    abandoned.finish() catch { earlyRaised = true; };
    if !earlyRaised { ok = false; }
    abandoned.deinit();

    writer := zip.Writer.init(.{}, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    writer.add("x", "y", .{}) catch { ok = false; };
    writer.finish(null) catch { ok = false; };
    taken, te := writer.take();
    if te { ok = false; }
    writer.close() catch { ok = false; };
    writer.close() catch { ok = false; };
    writer.deinit();
    if taken.ptr != null { alloc.deallocBytes(taken.ptr); }

    reader.deinit();
    alloc.deallocBytes(archive.ptr);
    ok
}

FailingAllocator :: struct {
    parent: Allocator;
    failAt: i64 = -1;
    count: i64 = 0;
}

impl Allocator for FailingAllocator {
    allocBytes :: (self: *FailingAllocator, size: i64) -> *void {
        if self.failAt >= 0 and self.count >= self.failAt { return null; }
        self.count += 1;
        self.parent.allocBytes(size)
    }

    deallocBytes :: (self: *FailingAllocator, ptr: *void) {
        self.parent.deallocBytes(ptr);
    }
}

// addFrom failure boundaries: the transfer emits the local header BEFORE the
// payload reads, so a mid-entry source failure leaves physically advanced
// output. A truncating backend (memory/file) must truly roll back — the
// writer stays reusable and produces bytes IDENTICAL to a writer that never
// saw the failure. A borrowed sink cannot un-emit and must poison. When the
// target sink and the source both fail, the TARGET error wins (it fires at
// the emit that observed it). The fromReader allocation sweep forces every
// init failure point — including replacement-writer init — under the
// net-zero leak gate.
testAddFromFailures :: (alloc: Allocator) -> bool {
    // fail.txt is FIRST so its local record sits at offset 0, and the source
    // entries carry NO data descriptor — otherwise the descriptor pre-read
    // (past the payload) fails before anything is emitted and the rollback
    // path is never exercised. With failAt = 30 the 30-byte header read
    // (offset 0) succeeds, the header is EMITTED, and the following
    // name/payload chunk read (offset 30) is the first to fail — exactly the
    // after-emission boundary.
    inputs : [2]zip.Input = .[
        .{ name = "fail.txt", data = "fail-payload", options = .{ method = .store, dataDescriptor = false } },
        .{ name = "keep.txt", data = "keep-payload", options = .{ method = .store, dataDescriptor = false } },
    ];
    archive := zip.create(inputs[..], .{}, "with-comment", alloc) catch { return false; };
    ok := true;

    // Rollback + reuse: memory writer, source fails on the payload read
    // (offset 32 allows the 30-byte local header at offset 0, blocks the
    // name/payload reads that follow).
    flaky := MemorySource{ data = archive, failure = .NotFound };
    reader := zip.openSource(xx *flaky, .{}, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    keepIndex := reader.find("keep.txt") catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    failIndex := reader.find("fail.txt") catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };

    testWriter := zip.Writer.init(.{}, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    testWriter.add("front", "front-data", .{ method = .store }) catch { ok = false; };
    flaky.failAt = 30;
    sourceErrorSeen := false;
    testWriter.addFrom(*reader, failIndex) catch |e| {
        sourceErrorSeen = e == .NotFound;
    };
    if !sourceErrorSeen { ok = false; }
    flaky.failAt = -1;
    testWriter.addFrom(*reader, keepIndex) catch { ok = false; };
    testWriter.finish("") catch { ok = false; };
    testBytes, testTe := testWriter.take();
    if testTe { ok = false; }
    testWriter.deinit();

    control := zip.Writer.init(.{}, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    control.add("front", "front-data", .{ method = .store }) catch { ok = false; };
    control.addFrom(*reader, keepIndex) catch { ok = false; };
    control.finish("") catch { ok = false; };
    controlBytes, controlTe := control.take();
    if controlTe { ok = false; }
    control.deinit();

    if testBytes.len != controlBytes.len { ok = false; }
    else {
        i := 0;
        while i < testBytes.len {
            if testBytes[i] != controlBytes[i] { ok = false; break; }
            i += 1;
        }
    }
    if testBytes.ptr != null { alloc.deallocBytes(testBytes.ptr); }
    if controlBytes.ptr != null { alloc.deallocBytes(controlBytes.ptr); }

    // Borrowed sink cannot roll back: the writer poisons; further adds and
    // finish raise instead of emitting over a half-written record.
    sink := Collector{};
    sinkWriter := zip.Writer.initSink(xx *sink, .{}, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    flaky.failAt = 30;
    poisonedError := false;
    sinkWriter.addFrom(*reader, failIndex) catch |e| { poisonedError = e == .NotFound; };
    if !poisonedError { ok = false; }
    addAfterPoison := false;
    sinkWriter.add("later", "x", .{ method = .store }) catch { addAfterPoison = true; };
    if !addAfterPoison { ok = false; }
    finishAfterPoison := false;
    sinkWriter.finish("") catch { finishAfterPoison = true; };
    if !finishAfterPoison { ok = false; }
    sinkWriter.deinit();
    flaky.failAt = -1;

    // Simultaneous target + source failure: the sink rejects the header emit
    // before the payload read can fail — the TARGET error surfaces.
    dualSink := Collector{ failAfter = 0 };
    dualWriter := zip.Writer.initSink(xx *dualSink, .{}, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    flaky.failAt = 30;
    targetWon := false;
    dualWriter.addFrom(*reader, failIndex) catch |e| { targetWon = e == .Io; };
    if !targetWon { ok = false; }
    dualWriter.deinit();
    flaky.failAt = -1;

    // File backend: the same post-emission failure must truly roll back on
    // disk (ftruncate behind std.fs) — the file writer stays reusable and
    // the finished archive matches a control file that never saw the failure.
    filePath := "/tmp/sx_zip_addfrom_rollback";
    controlPath := "/tmp/sx_zip_addfrom_control";
    fs.deleteFile(filePath); fs.deleteFile(controlPath);
    fw := zip.Writer.initFile(filePath, .{}, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    fw.add("front", "front-data", .{ method = .store }) catch { ok = false; };
    flaky.failAt = 30;
    fileSourceError := false;
    fw.addFrom(*reader, failIndex) catch |e| { fileSourceError = e == .NotFound; };
    if !fileSourceError { ok = false; }
    flaky.failAt = -1;
    fw.addFrom(*reader, keepIndex) catch { ok = false; };
    fw.finish("") catch { ok = false; };
    fw.close() catch { ok = false; };
    fw.deinit();

    cf := zip.Writer.initFile(controlPath, .{}, alloc) catch { reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    cf.add("front", "front-data", .{ method = .store }) catch { ok = false; };
    cf.addFrom(*reader, keepIndex) catch { ok = false; };
    cf.finish("") catch { ok = false; };
    cf.close() catch { ok = false; };
    cf.deinit();

    fileBuf : [4096]u8 = ---;
    controlBuf : [4096]u8 = ---;
    fileLen := -1;
    controlLen := -1;
    maybeFile := fs.openFile(filePath, .read);
    if maybeFile != null {
        handle := maybeFile?!;
        fileLen = handle.read(fileBuf[..]);
        handle.close();
    }
    maybeControl := fs.openFile(controlPath, .read);
    if maybeControl != null {
        handle := maybeControl?!;
        controlLen = handle.read(controlBuf[..]);
        handle.close();
    }
    if fileLen <= 0 or controlLen <= 0 or fileLen != controlLen { ok = false; }
    else {
        i := 0;
        while i < fileLen {
            if fileBuf[i] != controlBuf[i] { ok = false; break; }
            i += 1;
        }
    }
    fs.deleteFile(filePath); fs.deleteFile(controlPath);

    // fromReader allocation sweep: every init failure point — including
    // replacement-writer initialization — must clean up fully (the caller's
    // net-zero gate catches any leaked comment/prefix copy).
    n := 0;
    sawFailure := false;
    sawSuccess := false;
    while n < 128 {
        failing := FailingAllocator{ parent = alloc, failAt = n };
        provisional, pe := zip.Writer.fromReader(*reader, .{}, xx *failing);
        if pe { sawFailure = true; }
        else {
            sawSuccess = true;
            provisional.deinit();
        }
        n += 1;
        if sawSuccess { break; }
    }
    if !sawFailure { ok = false; }
    if !sawSuccess { ok = false; }

    // The createFile convenience: writes a whole archive to a path in one
    // call; read it back through openFile (create() itself is exercised by
    // the failure tests above).
    conveniencePath := "/tmp/sx_zip_create_file_convenience";
    fs.deleteFile(conveniencePath);
    convInputs : [1]zip.Input = .[ .{ name = "conv.txt", data = "convenience payload", options = .{ method = .store } } ];
    zip.createFile(conveniencePath, convInputs[..], .{}, "", alloc) catch { ok = false; };
    convReader := zip.openFile(conveniencePath, .{}, alloc) catch { fs.deleteFile(conveniencePath); reader.deinit(); alloc.deallocBytes(archive.ptr); return false; };
    convExtracted := convReader.extractName("conv.txt", 4096, alloc) catch {
        convReader.deinit(); fs.deleteFile(conveniencePath); reader.deinit(); alloc.deallocBytes(archive.ptr); return false;
    };
    convOk := convExtracted.len == 19;
    convAt := 0;
    convExpect := "convenience payload";
    while convOk and convAt < convExtracted.len {
        if convExtracted[convAt] != convExpect[convAt] { convOk = false; }
        convAt += 1;
    }
    if !convOk { ok = false; }
    alloc.deallocBytes(convExtracted.ptr);
    convReader.deinit();
    fs.deleteFile(conveniencePath);

    reader.deinit();
    alloc.deallocBytes(archive.ptr);
    ok
}

main :: () -> i32 {
    alloc := mem.GPA.init();
    if !testExactMinizBytes(alloc) { print("miniz byte identity failed\n"); return 1; }
    if !testMemoryReader(alloc) { print("memory reader failed\n"); return 2; }
    if !testSourcesAndSinks(alloc) { print("source/sink failed\n"); return 3; }
    if !testEntryStreams(alloc) { print("entry stream failed\n"); return 4; }
    if !testTerminalChecksumErrors(alloc) { print("terminal checksum failed\n"); return 5; }
    if !testTransferErrorsAndCleanup(alloc) { print("transfer errors/cleanup failed\n"); return 6; }
    if !testEmptyUnsupportedEntries(alloc) { print("empty unsupported entry failed\n"); return 7; }
    if !testUpdateAndTransfer(alloc) { print("update/transfer failed\n"); return 8; }
    if !testPrefixAndDuplicates(alloc) { print("prefix/duplicates failed\n"); return 9; }
    if !testFiles(alloc) { print("file integration failed\n"); return 10; }
    if !testErrorsAndPoison(alloc) { print("errors/poison failed\n"); return 11; }
    if !testFinalization(alloc) { print("finalization failed\n"); return 12; }
    if !testAddFromFailures(alloc) { print("addFrom failure boundaries failed\n"); return 13; }
    if alloc.allocCount != 0 { print("std.zip leaked {} allocations\n", alloc.allocCount); return 14; }
    print("std.zip ok\n");
    0
}
