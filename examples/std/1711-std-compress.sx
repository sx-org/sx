// Idiomatic std.compress + raw DEFLATE/zlib/gzip facade coverage.
// The fixtures are byte-for-byte outputs from pinned miniz 3.1.2.

@import "modules/std.sx";

PLAIN :: "fixed fixed fixed fixed fixed fixed!";

RAW : [12]u8 = .[
    75, 203, 172, 72, 77, 81, 72, 195, 71, 42, 2, 0,
];

ZLIB : [18]u8 = .[
    120, 156, 75, 203, 172, 72, 77, 81, 72,
    195, 71, 42, 2, 0, 247, 117, 13, 34,
];

GZIP : [30]u8 = .[
    31, 139, 8, 0, 0, 0, 0, 0, 0, 255,
    75, 203, 172, 72, 77, 81, 72, 195, 71, 42, 2, 0,
    103, 66, 48, 97, 36, 0, 0, 0,
];

// Pinned miniz 3.1.2 MZ_FIXED outputs. The first fixture requires the level-1
// fast parser; the second requires fixed Huffman to retain tdefl's adaptive
// stored-block fallback when the compressed block would expand.
FIXED_FAST_PLAIN :: "abcdefghijkabcde";
FIXED_FAST_ZLIB : [20]u8 = .[
    120, 1, 75, 76, 74, 78, 73, 77, 75, 207,
    200, 204, 202, 6, 51, 1, 53, 155, 6, 82,
];

FIXED_STORED_PLAIN : [16]u8 = .[
    0, 17, 34, 51, 68, 85, 102, 119,
    136, 153, 170, 187, 204, 221, 238, 255,
];
FIXED_STORED_ZLIB : [27]u8 = .[
    120, 94, 1, 16, 0, 239, 255, 0, 17,
    34, 51, 68, 85, 102, 119, 136, 153,
    170, 187, 204, 221, 238, 255, 45, 56, 7, 249,
];

same :: (left: string, right: string) -> bool {
    if left.len != right.len { return false; }
    i := 0;
    while i < left.len {
        if left[i] != right[i] { return false; }
        i += 1;
    }
    true
}

rawFixture :: () -> string { RAW[..] }
zlibFixture :: () -> string { ZLIB[..] }
gzipFixture :: () -> string { GZIP[..] }

testFixedStrategyExact :: (alloc: Allocator) -> bool {
    fast := zlib.encode(FIXED_FAST_PLAIN, .{ level = 1, strategy = .fixed }, alloc) catch { return false; };
    stored := zlib.encode(FIXED_STORED_PLAIN[..], .{ level = 2, strategy = .fixed }, alloc) catch {
        alloc.deallocBytes(fast.ptr);
        return false;
    };
    ok := same(fast, FIXED_FAST_ZLIB[..]) and same(stored, FIXED_STORED_ZLIB[..]);
    alloc.deallocBytes(stored.ptr);
    alloc.deallocBytes(fast.ptr);
    ok
}

testExactAndBuffers :: (alloc: Allocator) -> bool {
    raw := deflate.encode(PLAIN, .{ level = 6 }, alloc) catch { return false; };
    framed := zlib.encode(PLAIN, .{ level = 6 }, alloc) catch { alloc.deallocBytes(raw.ptr); return false; };
    gz := gzip.encode(PLAIN, .{ level = 6 }, .{}, alloc) catch {
        alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    };
    if !same(raw, rawFixture()) or !same(framed, zlibFixture()) or !same(gz, gzipFixture()) {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    }

    rawStorage : [64]u8 = ---;
    rawBorrowed := deflate.encodeInto(PLAIN, rawStorage[..], .{ level = 6 }, alloc) catch {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    };
    zlibStorage : [64]u8 = ---;
    zlibBorrowed := zlib.encodeInto(PLAIN, zlibStorage[..], .{ level = 6 }, alloc) catch {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    };
    gzipStorage : [64]u8 = ---;
    gzipBorrowed := gzip.encodeInto(PLAIN, gzipStorage[..], .{ level = 6 }, .{}, alloc) catch {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    };
    if !same(rawBorrowed, raw) or !same(zlibBorrowed, framed) or !same(gzipBorrowed, gz) {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    }

    plainStorage : [64]u8 = ---;
    rawPrefix := deflate.decodeIntoPrefix(raw, plainStorage[..], alloc) catch {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    };
    if rawPrefix.consumed != raw.len or !same(rawPrefix.bytes, PLAIN) {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    }
    rawPlain := deflate.decodeInto(raw, plainStorage[..], alloc) catch {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    };
    if !same(rawPlain, PLAIN) {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    }
    zlibPlain := zlib.decodeInto(framed, plainStorage[..], alloc) catch {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    };
    if !same(zlibPlain, PLAIN) {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    }
    gzipPlain := gzip.decodeInto(gz, plainStorage[..], alloc) catch {
        alloc.deallocBytes(gz.ptr); alloc.deallocBytes(framed.ptr); alloc.deallocBytes(raw.ptr); return false;
    };
    ok := same(gzipPlain, PLAIN);
    alloc.deallocBytes(gz.ptr);
    alloc.deallocBytes(framed.ptr);
    alloc.deallocBytes(raw.ptr);
    ok
}

testPrefixAndErrors :: (alloc: Allocator) -> bool {
    rawTrailing : [13]u8 = ---;
    rawAt := 0;
    while rawAt < RAW.len { rawTrailing[rawAt] = RAW[rawAt]; rawAt += 1; }
    rawTrailing[RAW.len] = 0xaa;

    rawPrefix := deflate.decodePrefix(rawTrailing[..], 128, alloc) catch { return false; };
    rawPrefixOk := rawPrefix.consumed == RAW.len and same(rawPrefix.bytes, PLAIN);
    alloc.deallocBytes(rawPrefix.bytes.ptr);
    if !rawPrefixOk { return false; }

    rawStrictFailed := false;
    rawStrict := deflate.decode(rawTrailing[..], 128, alloc) catch |e| {
        rawStrictFailed = e == .InvalidData;
        ""
    };
    if !rawStrictFailed {
        if rawStrict.ptr != null { alloc.deallocBytes(rawStrict.ptr); }
        return false;
    }

    rawOutput : [64]u8 = ---;
    rawIntoStrictFailed := false;
    rawIntoStrict := deflate.decodeInto(rawTrailing[..], rawOutput[..], alloc) catch |e| {
        rawIntoStrictFailed = e == .InvalidData;
        ""
    };
    if !rawIntoStrictFailed { return false; }

    trailing : [19]u8 = ---;
    i := 0;
    while i < ZLIB.len { trailing[i] = ZLIB[i]; i += 1; }
    trailing[ZLIB.len] = 0xaa;

    prefix := zlib.decodePrefix(trailing[..], 128, alloc) catch { return false; };
    prefixOk := prefix.consumed == ZLIB.len and same(prefix.bytes, PLAIN);
    alloc.deallocBytes(prefix.bytes.ptr);
    if !prefixOk { return false; }

    strictFailed := false;
    strict := zlib.decode(trailing[..], 128, alloc) catch |e| {
        strictFailed = e == .InvalidData;
        ""
    };
    if !strictFailed {
        if strict.ptr != null { alloc.deallocBytes(strict.ptr); }
        return false;
    }

    invalidLevel := false;
    invalid := deflate.encode(PLAIN, .{ level = 11 }, alloc) catch |e| {
        invalidLevel = e == .InvalidOptions;
        ""
    };
    if !invalidLevel {
        if invalid.ptr != null { alloc.deallocBytes(invalid.ptr); }
        return false;
    }

    shortFailed := false;
    shortStorage : [4]u8 = ---;
    ignored := gzip.decodeInto(gzipFixture(), shortStorage[..], alloc) catch |e| {
        shortFailed = e == .OutputLimit;
        ""
    };
    shortFailed
}

testStreaming :: (alloc: Allocator) -> bool {
    encoder := deflate.Encoder.init(.{ level = 6 }, alloc) catch { return false; };
    encoded : [64]u8 = ---;
    inputAt := 0;
    outputAt := 0;
    turns := 0;
    while turns < 256 {
        inputEnd := inputAt + 2;
        if inputEnd > PLAIN.len { inputEnd = PLAIN.len; }
        input : string = "";
        if inputAt < inputEnd { input = PLAIN[inputAt..inputEnd]; }
        outputEnd := outputAt + 1;
        if outputEnd > encoded.len { outputEnd = encoded.len; }
        output : string = "";
        if outputAt < outputEnd { output = encoded[outputAt..outputEnd]; }
        mode : compress.Flush = if inputEnd == PLAIN.len then .finish else .none;
        progress := encoder.flush(input, output, mode) catch { encoder.deinit(); return false; };
        inputAt += progress.consumed;
        outputAt += progress.produced;
        if progress.status == .done { break; }
        turns += 1;
    }
    if inputAt != PLAIN.len or !same(encoded[..outputAt], rawFixture()) { encoder.deinit(); return false; }
    encoder.deinit();

    decoder := deflate.Decoder.init(PLAIN.len, alloc) catch { return false; };
    decoded : [64]u8 = ---;
    inputAt = 0;
    outputAt = 0;
    turns = 0;
    while turns < 256 {
        inputEnd := inputAt + 1;
        if inputEnd > RAW.len { inputEnd = RAW.len; }
        input : string = "";
        if inputAt < inputEnd { input = rawFixture()[inputAt..inputEnd]; }
        outputEnd := outputAt + 2;
        if outputEnd > decoded.len { outputEnd = decoded.len; }
        output : string = "";
        if outputAt < outputEnd { output = decoded[outputAt..outputEnd]; }
        progress := decoder.read(input, output) catch { decoder.deinit(); return false; };
        inputAt += progress.consumed;
        outputAt += progress.produced;
        if progress.status == .done { break; }
        turns += 1;
    }
    if inputAt != RAW.len or !same(decoded[..outputAt], PLAIN) { decoder.deinit(); return false; }
    decoder.deinit();

    protocolEncoder := deflate.Encoder.init(.{}, alloc) catch { return false; };
    erased : *compress.StreamingEncoder = *protocolEncoder;
    emptyOutput : [8]u8 = ---;
    progress := erased.finish(emptyOutput[..]) catch { erased.deinit(); return false; };
    erased.deinit();
    progress.status == .done
}

testGzipMetadata :: (alloc: Allocator) -> bool {
    header : gzip.Header = .{
        modifiedSeconds = 123456,
        filename = "data.txt",
        comment = "sx",
        extra = "ab",
        operatingSystem = 3,
        text = true,
        headerChecksum = true,
    };
    owned := gzip.encode(PLAIN, .{ level = 9 }, header, alloc) catch { return false; };
    capacity := gzip.bound(PLAIN.len, header) catch { alloc.deallocBytes(owned.ptr); return false; };
    storageRaw := alloc.allocBytes(capacity);
    if storageRaw == null { alloc.deallocBytes(owned.ptr); return false; }
    storage := string{ ptr = xx storageRaw, len = capacity };
    borrowed := gzip.encodeInto(PLAIN, storage, .{ level = 9 }, header, alloc) catch {
        alloc.deallocBytes(storageRaw); alloc.deallocBytes(owned.ptr); return false;
    };
    if !same(owned, borrowed) {
        alloc.deallocBytes(storageRaw); alloc.deallocBytes(owned.ptr); return false;
    }
    plain := gzip.decode(owned, 128, alloc) catch {
        alloc.deallocBytes(storageRaw); alloc.deallocBytes(owned.ptr); return false;
    };
    ok := same(plain, PLAIN);
    alloc.deallocBytes(plain.ptr);
    alloc.deallocBytes(storageRaw);
    alloc.deallocBytes(owned.ptr);
    ok
}

main :: () -> i32 {
    alloc := mem.GPA.init();
    if !testExactAndBuffers(alloc) { print("std.compress exact/buffer failure\n"); return 1; }
    if !testFixedStrategyExact(alloc) { print("std.compress fixed-strategy failure\n"); return 1; }
    if !testPrefixAndErrors(alloc) { print("std.compress error-contract failure\n"); return 1; }
    if !testStreaming(alloc) { print("std.compress streaming failure\n"); return 1; }
    if !testGzipMetadata(alloc) { print("std.compress gzip-metadata failure\n"); return 1; }
    if alloc.allocCount != 0 { print("std.compress leaked {} allocations\n", alloc.allocCount); return 1; }
    print("std.compress ok\n");
    0
}
