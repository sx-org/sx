// A child's exit code survives the reap: /bin/sh -c "exit 3" decodes to 3.
@import "modules/std.sx";

main :: () -> i32 {
    child, e := process.spawn(.["/bin/sh", "-c", "exit 3"], .{});
    if e { print("spawn failed\n"); return 1; }

    code := child.wait(true);
    if code == null { print("wait produced no status\n"); return 1; }
    print("exit: {}\n", code!);
    if code! != 3 { return 1; }
    return 0;
}
