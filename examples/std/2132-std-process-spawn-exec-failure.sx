// `spawn` raises `.Exec` when the child cannot exec the program: it reaps the
// child, and errno holds the child's execvp error. An absolute path skips the
// PATH search, so that error is ENOENT on every host.
@import "modules/std.sx";

main :: () -> i32 {
    _, e := process.spawn(.["/sx-no-such-program-anywhere"], .{ stderr = .null });
    errno := posix.errno();
    if e != .Exec { print("spawn: {}\n", e); return 1; }
    if errno != posix.ENOENT { print("errno: {}\n", errno); return 1; }
    raw : i32 = 0;
    if c.waitpid(-1, *raw, process.WNOHANG) >= 0 { print("a child remains\n"); return 1; }
    print("spawn: {}, ENOENT, no child\n", e);
    return 0;
}
