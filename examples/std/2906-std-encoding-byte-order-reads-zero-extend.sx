// The byte-order readers assemble the word at an offset and return it
// zero-extended, a set top bit included.
@import "modules/std.sx";

main :: () -> i32 {
    b : [6]u8 = .[0x00, 0x12, 0x34, 0x56, 0xF8, 0xFF];
    print("{} {} {}\n", encoding.readU16Le(b, 4), encoding.readU32Le(b, 2), encoding.readU32Be(b, 1));
    return 0;
}
