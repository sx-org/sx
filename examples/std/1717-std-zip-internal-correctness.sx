@import "modules/std.sx";
fs :: @import "modules/std/fs.sx";
zip :: @import "modules/std/internal/zip.sx";
codec :: @import "modules/std/internal/compress.sx";

CappedAllocator :: struct {
    parent: Allocator;
    maximum: i64;
    largest: i64 = 0;
    live: i64 = 0;
}

impl Allocator for CappedAllocator {
    allocBytes :: (self: *CappedAllocator, size: i64) -> *void {
        if size > self.largest { self.largest = size; }
        if size > self.maximum { return null; }
        raw := self.parent.allocBytes(size);
        if raw != null { self.live += 1; }
        raw
    }

    deallocBytes :: (self: *CappedAllocator, ptr: *void) {
        if ptr == null { return; }
        self.live -= 1;
        self.parent.deallocBytes(ptr);
    }
}

SinkState :: struct { out: codec.ByteWriter; }

sinkWrite :: (ctx: *void, data: string) -> bool {
    state : *SinkState = xx ctx;
    state.out.putBytes(data);
    !state.out.failed
}

SourceState :: struct {
    data: string;
    chunk: i64 = 65536;
    oversizedRequest: bool = false;
}

sourceRead :: (ctx: *void, offset: i64, output: string) -> i64 {
    state : *SourceState = xx ctx;
    if offset < 0 or offset >= state.data.len { return 0; }
    remaining := state.data.len - offset;
    if output.len > remaining { state.oversizedRequest = true; }
    take := remaining;
    if take > output.len { take = output.len; }
    if take > state.chunk { take = state.chunk; }
    i := 0;
    while i < take { output.ptr[i] = state.data[offset + i]; i += 1; }
    take
}

same :: (left: string, right: string) -> bool {
    if left.len != right.len { return false; }
    i := 0;
    while i < left.len {
        if left[i] != right[i] { return false; }
        i += 1;
    }
    true
}

makeArchive :: (data: string, method: zip.ZipMethod, alloc: Allocator) -> string {
    sink := SinkState{ out = codec.ByteWriter.init(alloc) };
    writer := zip.ZipStreamWriter.init(.{ ctx = *sink, write = sinkWrite }, alloc);
    writer.addOptions("data.bin", data, .{
        method = method,
        level = 6,
        dataDescriptor = true,
        autoStoreSmall = false,
        timeMode = .none,
    }) catch { writer.deinit(); sink.out.deinit(); return .{ ptr = null, len = 0 }; };
    writer.finish() catch { writer.deinit(); sink.out.deinit(); return .{ ptr = null, len = 0 }; };
    writer.deinit();
    sink.out.take()
}

testBoundedValidation :: (alloc: Allocator) -> bool {
    plain : [262144]u8 = ---;
    i := 0;
    while i < plain.len { plain[i] = ('a' + (i % 7)).(u8); i += 1; }
    archive := makeArchive(plain[..], .deflate, alloc);
    if archive.ptr == null { return false; }
    reader := zip.openZip(archive) catch { alloc.deallocBytes(archive.ptr); return false; };
    capped := CappedAllocator{ parent = alloc, maximum = 65536 };
    reader.validateEntry(0, false, false, capped) catch {
        alloc.deallocBytes(archive.ptr);
        return false;
    };
    ok := capped.live == 0 and capped.largest > 0 and capped.largest <= capped.maximum;
    alloc.deallocBytes(archive.ptr);
    ok
}

testValidationModes :: (alloc: Allocator) -> bool {
    archive := makeArchive("checksum payload", .store, alloc);
    if archive.ptr == null { return false; }
    reader := zip.openZip(archive) catch { alloc.deallocBytes(archive.ptr); return false; };
    entry, payloadAt := reader.payloadInfo(0) catch { alloc.deallocBytes(archive.ptr); return false; };
    archive.ptr[payloadAt] ^= 1;
    fullFailed := false;
    reader.validateEntry(0, false, false, alloc) catch |e| { fullFailed = e == .ChecksumMismatch; };
    headersOk := true;
    reader.validateEntry(0, true, false, alloc) catch { headersOk = false; };
    skippedOk := true;
    reader.validateEntry(0, false, true, alloc) catch { skippedOk = false; };
    archive.ptr[payloadAt] ^= 1;
    alloc.deallocBytes(archive.ptr);
    fullFailed and headersOk and skippedOk
}

checkUpgraded :: (archive: string, expected: string, alloc: Allocator) -> bool {
    reader := zip.openZip(archive) catch { return false; };
    if !reader.isZip64() { return false; }
    entry := reader.entry(0) catch { return false; };
    if !entry.hasZip64Extra { return false; }
    reader.validateEntry(0, false, false, alloc) catch { return false; };
    plain := reader.extract(0, 4096, alloc) catch { return false; };
    ok := same(plain, expected);
    alloc.deallocBytes(plain.ptr);
    ok
}

testForceZip64 :: (alloc: Allocator) -> bool {
    payload := "forced zip64 descriptor payload forced zip64 descriptor payload";
    base := makeArchive(payload, .deflate, alloc);
    if base.ptr == null { return false; }
    source := zip.openZip(base) catch { alloc.deallocBytes(base.ptr); return false; };
    localSize := source.centralRelativeOffset;

    sinkState := SinkState{ out = codec.ByteWriter.init(alloc) };
    sinkState.out.putBytes(base[..localSize]);
    stream := zip.ZipStreamWriter.initFromReader(
        *source,
        .{ ctx = *sinkState, write = sinkWrite },
        true,
        alloc,
    ) catch {
        sinkState.out.deinit(); alloc.deallocBytes(base.ptr); return false;
    };
    stream.finish() catch {
        stream.deinit(); sinkState.out.deinit(); alloc.deallocBytes(base.ptr); return false;
    };
    stream.deinit();
    streamed := sinkState.out.take();
    streamPrefixOk := same(streamed[..localSize], base[..localSize]);
    streamOk := streamPrefixOk and checkUpgraded(streamed, payload, alloc);

    alloc.deallocBytes(streamed.ptr);
    alloc.deallocBytes(base.ptr);
    streamOk
}

testSourceContract :: (alloc: Allocator) -> bool {
    strictState := SourceState{ data = "abc", chunk = 2 };
    strictSource := zip.ZipInputSource{ ctx = *strictState, size = 3, read = sourceRead };
    sinkState := SinkState{ out = codec.ByteWriter.init(alloc) };
    writer := zip.ZipStreamWriter.init(.{ ctx = *sinkState, write = sinkWrite }, alloc);
    writer.addSource("tiny", strictSource, .{
        method = .deflate,
        level = 6,
        autoStoreSmall = false,
        dataDescriptor = true,
        timeMode = .none,
    }) catch { writer.deinit(); sinkState.out.deinit(); return false; };
    writer.finish() catch { writer.deinit(); sinkState.out.deinit(); return false; };
    writer.deinit();
    archive := sinkState.out.take();
    reader := zip.openZip(archive) catch { alloc.deallocBytes(archive.ptr); return false; };
    entry := reader.entry(0) catch { alloc.deallocBytes(archive.ptr); return false; };
    plain := reader.extract(0, 16, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    exactOk := !strictState.oversizedRequest and entry.method == .deflate and same(plain, "abc");
    alloc.deallocBytes(plain.ptr);
    alloc.deallocBytes(archive.ptr);

    earlyState := SourceState{ data = "abc" };
    earlySource := zip.ZipInputSource{ ctx = *earlyState, size = 5, read = sourceRead };
    earlySink := SinkState{ out = codec.ByteWriter.init(alloc) };
    early := zip.ZipStreamWriter.init(.{ ctx = *earlySink, write = sinkWrite }, alloc);
    storeFailed := false;
    early.addSource("short-store", earlySource, .{ method = .store, timeMode = .none }) catch |e| {
        storeFailed = e == .Io;
    };
    early.deinit();
    earlySink.out.deinit();

    deflateState := SourceState{ data = "abc" };
    deflateSource := zip.ZipInputSource{ ctx = *deflateState, size = 5, read = sourceRead };
    deflateSink := SinkState{ out = codec.ByteWriter.init(alloc) };
    deflateWriter := zip.ZipStreamWriter.init(.{ ctx = *deflateSink, write = sinkWrite }, alloc);
    deflateFailed := false;
    deflateWriter.addSource("short-deflate", deflateSource, .{
        method = .deflate, autoStoreSmall = false, timeMode = .none,
    }) catch |e| { deflateFailed = e == .Io; };
    deflateWriter.deinit();
    deflateSink.out.deinit();
    exactOk and storeFailed and deflateFailed
}

testEmptyDescriptorModes :: (alloc: Allocator) -> bool {
    options : zip.ZipEntryOptions = .{
        method = .store,
        dataDescriptor = true,
        autoStoreSmall = false,
        timeMode = .none,
    };
    expectedSink := SinkState{ out = codec.ByteWriter.init(alloc) };
    memory := zip.ZipStreamWriter.init(.{ ctx = *expectedSink, write = sinkWrite }, alloc);
    memory.addOptions("empty", "", options) catch { memory.deinit(); expectedSink.out.deinit(); return false; };
    memory.finish() catch { memory.deinit(); expectedSink.out.deinit(); return false; };
    memory.deinit();
    expected := expectedSink.out.take();

    directSink := SinkState{ out = codec.ByteWriter.init(alloc) };
    direct := zip.ZipStreamWriter.init(.{ ctx = *directSink, write = sinkWrite }, alloc);
    direct.addOptions("empty", "", options) catch {
        direct.deinit(); directSink.out.deinit(); alloc.deallocBytes(expected.ptr); return false;
    };
    direct.finish() catch {
        direct.deinit(); directSink.out.deinit(); alloc.deallocBytes(expected.ptr); return false;
    };
    direct.deinit();
    directBytes := directSink.out.take();
    directExact := same(directBytes, expected);

    callbackSink := SinkState{ out = codec.ByteWriter.init(alloc) };
    callback := zip.ZipStreamWriter.init(.{ ctx = *callbackSink, write = sinkWrite }, alloc);
    emptySource := zip.ZipInputSource{ ctx = null, size = 0, read = null };
    callback.addSource("empty", emptySource, options) catch {
        callback.deinit(); callbackSink.out.deinit(); alloc.deallocBytes(directBytes.ptr); alloc.deallocBytes(expected.ptr); return false;
    };
    callback.finish() catch {
        callback.deinit(); callbackSink.out.deinit(); alloc.deallocBytes(directBytes.ptr); alloc.deallocBytes(expected.ptr); return false;
    };
    callback.deinit();
    callbackBytes := callbackSink.out.take();
    callbackReader := zip.openZip(callbackBytes) catch {
        alloc.deallocBytes(callbackBytes.ptr); alloc.deallocBytes(directBytes.ptr); alloc.deallocBytes(expected.ptr); return false;
    };
    callbackEntry := callbackReader.entry(0) catch {
        alloc.deallocBytes(callbackBytes.ptr); alloc.deallocBytes(directBytes.ptr); alloc.deallocBytes(expected.ptr); return false;
    };
    callbackDescriptor := (callbackEntry.flags & 8) != 0 and callbackBytes.len == expected.len + 16;

    alloc.deallocBytes(callbackBytes.ptr);
    alloc.deallocBytes(directBytes.ptr);
    alloc.deallocBytes(expected.ptr);
    directExact and callbackDescriptor
}

testExtraValidation :: (alloc: Allocator) -> bool {
    malformed : [1]u8 = .[0];
    memorySink := SinkState{ out = codec.ByteWriter.init(alloc) };
    memory := zip.ZipStreamWriter.init(.{ ctx = *memorySink, write = sinkWrite }, alloc);
    malformedFailed := false;
    memory.addOptions("bad", "x", .{ method = .store, extra = malformed[..], timeMode = .none }) catch |e| {
        malformedFailed = e == .InvalidOptions;
    };
    memoryUntouched := memorySink.out.bytes.len == 0 and memory.entries.len == 0;
    memory.deinit();
    memorySink.out.deinit();

    reserved : [4]u8 = .[1, 0, 0, 0];
    reservedSink := SinkState{ out = codec.ByteWriter.init(alloc) };
    reservedWriter := zip.ZipStreamWriter.init(.{ ctx = *reservedSink, write = sinkWrite }, alloc);
    reservedFailed := false;
    reservedWriter.addOptions("bad", "x", .{ method = .store, extra = reserved[..], timeMode = .none }) catch |e| {
        reservedFailed = e == .InvalidOptions;
    };
    reservedUntouched := reservedSink.out.bytes.len == 0 and reservedWriter.entries.len == 0;
    reservedWriter.deinit();
    reservedSink.out.deinit();

    large : [65524]u8 = ---;
    at := 0;
    while at < large.len {
        large[at] = 2; large[at + 1] = 0; large[at + 2] = 0; large[at + 3] = 0;
        at += 4;
    }
    largeSink := SinkState{ out = codec.ByteWriter.init(alloc) };
    largeWriter := zip.ZipStreamWriter.init(.{ ctx = *largeSink, write = sinkWrite }, alloc);
    largeWriter.offset = 0xffffffff;
    combinedFailed := false;
    largeWriter.addOptions("wide", "", .{
        method = .store,
        centralExtra = large[..],
        separateCentralExtra = true,
        timeMode = .none,
    }) catch |e| { combinedFailed = e == .TooLarge; };
    combinedUntouched := largeSink.out.bytes.len == 0 and largeWriter.entries.len == 0;
    largeWriter.deinit();
    largeSink.out.deinit();

    malformedFailed and memoryUntouched and reservedFailed and reservedUntouched and combinedFailed and combinedUntouched
}

testSafePaths :: (alloc: Allocator) -> bool {
    archive := makeArchive("x", .store, alloc);
    if archive.ptr == null { return false; }
    reader := zip.openZip(archive) catch { alloc.deallocBytes(archive.ptr); return false; };
    entry := reader.entry(0) catch { alloc.deallocBytes(archive.ptr); return false; };
    entry.name = "dir/file";
    if !entry.isSafePath() { alloc.deallocBytes(archive.ptr); return false; }
    unsafe : [7]string = .["../x", "a/../b", "a\\..\\b", "C:x", "C:/x", "//host/x", "file:fork"];
    i := 0;
    while i < unsafe.len {
        entry.name = unsafe[i];
        if entry.isSafePath() { alloc.deallocBytes(archive.ptr); return false; }
        i += 1;
    }
    nulName : [3]u8 = .['a', 0, 'b'];
    entry.name = nulName[..];
    ok := !entry.isSafePath();
    alloc.deallocBytes(archive.ptr);
    ok
}

metadataLimitRejected :: (source: zip.ZipReadSource, limit: i64, alloc: Allocator) -> bool {
    owned := zip.openZipSource(source, false, alloc, limit) catch |e| {
        return e == .OutputLimit;
    };
    owned.deinit();
    false
}

testMetadataBound :: (alloc: Allocator) -> bool {
    archive := makeArchive("metadata", .store, alloc);
    if archive.ptr == null { return false; }
    memoryReader := zip.openZip(archive) catch { alloc.deallocBytes(archive.ptr); return false; };
    sourceState := SourceState{ data = archive };
    source := zip.ZipReadSource{ ctx = *sourceState, size = archive.len, read = sourceRead };
    if !metadataLimitRejected(source, memoryReader.centralSize - 1, alloc) {
        alloc.deallocBytes(archive.ptr); return false;
    }
    owned := zip.openZipSource(source, false, alloc) catch { alloc.deallocBytes(archive.ptr); return false; };
    owned.deinit();
    alloc.deallocBytes(archive.ptr);
    true
}

testTimestamps :: (alloc: Allocator) -> bool {
    ignoredTime, ignoredDate, epochValid := zip.zipUnixTimeToDos(0);
    validTime, validDate, modernValid := zip.zipUnixTimeToDos(1700000000);
    if epochValid or !modernValid { return false; }

    specifiedSink := SinkState{ out = codec.ByteWriter.init(alloc) };
    specified := zip.ZipStreamWriter.init(.{ ctx = *specifiedSink, write = sinkWrite }, alloc);
    specifiedFailed := false;
    specified.addOptions("old", "x", .{
        method = .store,
        timeMode = .specified,
        modifiedUnixSeconds = 0,
    }) catch |e| { specifiedFailed = e == .InvalidOptions; };
    specifiedUntouched := specifiedSink.out.bytes.len == 0;
    specified.deinit();
    specifiedSink.out.deinit();

    path := "/tmp/sx_zip_old_timestamp";
    fs.deleteFile(path);
    if !fs.writeFile(path, "x") { return false; }
    if !fs.setModifiedSeconds(path, 0) { fs.deleteFile(path); return false; }
    fromFileSink := SinkState{ out = codec.ByteWriter.init(alloc) };
    fromFile := zip.ZipStreamWriter.init(.{ ctx = *fromFileSink, write = sinkWrite }, alloc);
    fileFailed := false;
    fromFile.addFile("old", path, .{ method = .store }) catch |e| { fileFailed = e == .InvalidOptions; };
    fromFile.deinit();
    fromFileSink.out.deinit();
    fs.deleteFile(path);

    missing := "/tmp/sx_zip_missing_mtime_target";
    fs.deleteFile(missing);
    restoreFailureVisible := !zip.zipSetFileTime(missing, 1700000000);
    specifiedFailed and specifiedUntouched and fileFailed and restoreFailureVisible
}

main :: () -> i32 {
    alloc := mem.GPA.init();
    if !testBoundedValidation(alloc) { print("bounded validation failed\n"); return 1; }
    if !testValidationModes(alloc) { print("validation modes failed\n"); return 2; }
    if !testForceZip64(alloc) { print("force zip64 failed\n"); return 3; }
    if !testSourceContract(alloc) { print("source contract failed\n"); return 4; }
    if !testEmptyDescriptorModes(alloc) { print("empty descriptor modes failed\n"); return 10; }
    if !testExtraValidation(alloc) { print("extra validation failed\n"); return 5; }
    if !testSafePaths(alloc) { print("safe paths failed\n"); return 6; }
    if !testMetadataBound(alloc) { print("metadata bound failed\n"); return 7; }
    if !testTimestamps(alloc) { print("timestamps failed\n"); return 8; }
    if alloc.allocCount != 0 { print("zip internal leaked {} allocations\n", alloc.allocCount); return 9; }
    print("std.zip internal correctness ok\n");
    0
}
