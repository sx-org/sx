// `last` answers a slice's final element, and null for an empty slice. The
// kernel is generic over the element type; a `string` IS a `[]u8`, so it
// binds that element type directly.
@import "modules/std.sx";

main :: () -> i32 {
    xs : []i64 = .[10, 20, 30];
    if v := xs.last() { print("{}\n", v); }

    empty : []i64 = .[];
    if v := empty.last() { print("{}\n", v); } else { print("null\n"); }

    if b := "sx".last() { print("{}\n", b); }
    return 0;
}
