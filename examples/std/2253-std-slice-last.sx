// `last` answers a slice's final element, and null for an empty slice. The
// kernel is generic over the element type; a string reaches it through its
// `[]u8` view.
@import "modules/std.sx";

main :: () -> i32 {
    xs : []i64 = .[10, 20, 30];
    if v := xs.last() { print("{}\n", v); }

    empty : []i64 = .[];
    if v := empty.last() { print("{}\n", v); } else { print("null\n"); }

    if b := "sx".([]u8).last() { print("{}\n", b); }
    return 0;
}
