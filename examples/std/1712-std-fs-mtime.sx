@import "modules/std/core.sx";
@import "modules/std/target.sx";

fs :: @import "modules/std/fs.sx";
c :: @import "modules/std/c.sx";

inline if @host.os != .windows {
    posixAbi :: @import "modules/std/fs/posix_abi.sx";

    readTimes :: (file: *fs.File) -> (i64, i64, bool) {
        raw : [256]u8 = .{};
        if c.fstat(file.fd.(i32), *raw[0]) != 0 { return 0, 0, false; }

        accessOffset := 0;
        modifiedOffset := 0;
        inline if @host.os == .macos or @host.os == .ios {
            accessOffset = 32;
            modifiedOffset = 48;
        } else if @host.os == .linux or @host.os == .android {
            accessOffset = 72;
            modifiedOffset = 88;
        } else {
            return 0, 0, false;
        }

        access : i64 = 0;
        modified : i64 = 0;
        c.memcpy(*access, *raw[accessOffset], @sizeOf(i64));
        c.memcpy(*modified, *raw[modifiedOffset], @sizeOf(i64));
        return access, modified, true;
    }
}

main :: () -> i32 {
    inline if @host.os == .windows { return 0; }
    else {
        path := "/tmp/sx_std_fs_mtime_test";
        fs.deleteFile(path);
        if !fs.writeFile(path, "mtime") { return 1; }

        initialAccess : i64 = 1700000001;
        initialModified : i64 = 1700000002;
        targetModified : i64 = 1700000100;
        initial : [2]posixAbi.FsPosixTimespec = .[
            .{ sec = initialAccess, nsec = 0 },
            .{ sec = initialModified, nsec = 0 },
        ];
        if posixAbi.fsPosixUtimensat(posixAbi.FS_POSIX_AT_FDCWD, path, *initial[0], 0) != 0 {
            fs.deleteFile(path);
            return 2;
        }
        if !fs.setModifiedSeconds(path, targetModified) {
            fs.deleteFile(path);
            return 3;
        }

        maybe := fs.openFile(path, .read);
        if maybe == null { fs.deleteFile(path); return 4; }
        file := maybe?!;
        publicModified, publicOk := fs.modifiedSeconds(*file);
        access, modified, rawOk := readTimes(*file);
        closeOk := file.close();
        deleteOk := fs.deleteFile(path);

        if !publicOk or publicModified != targetModified { return 5; }
        if !rawOk or access != initialAccess { return 6; }
        if modified != targetModified { return 7; }
        if !closeOk or !deleteOk { return 8; }

        missing := "/tmp/sx_std_fs_mtime_missing";
        fs.deleteFile(missing);
        if fs.setModifiedSeconds(missing, targetModified) { return 9; }
        return 0;
    }
}
