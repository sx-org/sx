// Type alias resolution through `@sizeOf` / `@alignOf` — a const-decl
// alias (`MyInt :: i32;`, `MyChain :: MyInt;`, `WideAlias :: Wide;`)
// resolves through `type_alias_map` when used as a `$T: Type` argument.
// Covers chains and struct-name aliases, not just structural-type
// aliases (those land in `examples/182-compound-type-in-expression.sx`).
@import "modules/std.sx";

MyInt   :: i32;
MyChain :: MyInt;
Wide    :: struct { a: i64; b: i64; }
WideAlias :: Wide;

main :: () -> i32 {
    print("direct i32:        {}\n", @sizeOf(i32));
    print("alias i32:         {}\n", @sizeOf(MyInt));
    print("chain i32:         {}\n", @sizeOf(MyChain));
    print("align alias:       {}\n", @alignOf(MyInt));
    print("align chain:       {}\n", @alignOf(MyChain));
    print("size struct-alias: {}\n", @sizeOf(WideAlias));
    print("align struct-alias:{}\n", @alignOf(WideAlias));
    0
}
