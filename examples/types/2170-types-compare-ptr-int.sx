// Comparisons meet at a comparison type: a pointer vs an integer uses the
// integer as an address-sized bit pattern (`region == -1`, `p != 0`), and
// two pointers of any pointees compare by address.
@import "modules/std.sx";

main :: () {
    x := 1;
    p := *x;
    print("failed={}\n", p == -1);
    print("nonzero={}\n", p != 0);
    q : *void = p;
    print("same={}\n", p == q);
    end := p + 1;
    print("ordered={}\n", p < end);
}
