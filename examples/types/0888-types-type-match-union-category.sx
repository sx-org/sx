// The `union` category in the runtime type-category match: `case union:`
// matches unions; `case enum:` matches enums, with or without payloads.
// Arms claim tags FIRST-WINS — a tag belongs to the first arm that names
// it — and a specific user type name claims its tag ahead of the category
// that contains it. Unions box into `any` and their tags classify like
// every other registered type.
@import "modules/std.sx";

TU :: union { i: i64; f: f64; }
E  :: enum { a; b; }
Shape :: enum { circle: f32; rect: i32; none; }
Point :: struct { x, y: i64; }
Size2 :: struct { w, h: i64; }

onlyUnion :: (t: Type) -> string {
    match t {
        case union: return "union";
        else:       return "other";
    }
    "unreached"
}

both :: (t: Type) -> string {
    match t {
        case union: return "union-first";
        case enum:  return "enum";
        else:       return "other";
    }
    "unreached"
}

pick :: (t: Type) -> string {
    match t {
        case Point:  return "Point";
        case struct: return "struct";
        else:        return "other";
    }
    "unreached"
}

// the static classifier agrees arm for arm
kind :: (x: $T) -> string {
    inline match T {
        case union: return "union";
        else:       return "other";
    }
}

main :: () {
    tu := TU{ i = 5 };
    print("union: {}\n", onlyUnion(@typeOf(tu)));
    print("enum: {}\n", onlyUnion(@typeOf(E.a)));
    print("payload enum: {}\n", onlyUnion(@typeOf(Shape.none)));

    print("both union: {}\n", both(@typeOf(tu)));
    print("both payload enum: {}\n", both(@typeOf(Shape.none)));
    print("both enum: {}\n", both(@typeOf(E.a)));

    print("concrete first: {}\n", pick(@typeOf(Point{ x = 1, y = 2 })));
    print("category rest: {}\n", pick(@typeOf(Size2{ w = 3, h = 4 })));

    print("static union: {}\n", kind(tu));
    print("static enum: {}\n", kind(E.a));

    av : any = tu;
    print("boxed: {}\n", @typeOf(av) == TU);
}
