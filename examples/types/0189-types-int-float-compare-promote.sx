// A comparison with mismatched scalar operands (int vs float, or two float
// widths) promotes both operands to the common type before emitting the
// compare — `lowerBinaryOp` coerces each operand to the promoted float
// type for the ordering/equality arms, as the arithmetic arms do, so the
// cast materializes and LLVM gets a well-typed fcmp.
@import "modules/std.sx";

// i32 < f32: the comparison meets at f32, so the int side widens.
ceil_half :: (v: f32) -> i32 {
    t := v - 0.5;
    i : i32 = xx t;
    if i < t {        // 1.0 < 1.8 -> true
        i += 1;
    }
    i
}

// f64 vs f32 sibling: `xx y + 0.5` infers f64; comparing to an f32 must FPExt.
ge :: (y: i32, lo: f32) -> i32 {
    sy := xx y + 0.5;    // 3.5 (f64)
    if sy >= lo { return 1; }
    0
}

main :: () -> i32 {
    print("{}\n", ceil_half(2.3));   // 2
    print("{}\n", ge(3, 2.0));       // 1
    0
}
