// int ↔ payload-less enum is a MODELED conversion (issue 0396): the
// integer converts through the enum's backing type and the result takes
// the OTHER side's type, so `n.(Zone)` is a `Zone` value everywhere —
// wrapped into `?Zone`, passed as an argument, matched on, compared.
//
// It is the CONVERSION regime, not the checked-assertion regime: the
// three temperaments (`.(T)` panic / `.(?T)` null / `try .(T)` raise)
// belong to type-ERASED receivers, which carry a runtime type word to
// check against. A statically-typed integer carries none, so — exactly
// like `1000.(i8)` — the conversion is WELL-DEFINED, not
// value-preserving: an integer outside the variant set converts to that
// raw enum value (a flags enum makes such bit patterns legal anyway),
// and `n.(?Zone)` is the plain optional wrap, always present.
@import "modules/std.sx";

Zone :: enum { floating; fill; center; top; }
Small :: enum u8 { a; b; c; }
Perms :: enum flags { read; write; exec; }

// The issue-0396 shape: a tail-position cast flowing into `?E`.
zoneOf :: (n: i64) -> ?Zone {
    if n < 0 { return null; }
    n.(Zone)
}

nameOf :: (z: Zone) -> string {
    match z {
        case .floating: "floating";
        case .fill: "fill";
        case .center: "center";
        case .top: "top";
    }
}

main :: () {
    i : i64 = 3;
    // The cast result IS the enum type, both spellings.
    z := i.(Zone);
    x : Zone = xx i;
    print("type: {} {}\n", @typeOf(z), @typeOf(x));
    print("value: {} {}\n", z, x);

    // Optional wrap.
    print("wrap: {} {}\n", zoneOf(2), zoneOf(-1));
    // An optional TARGET is the ordinary wrap, never a check.
    print("opt-target: {}\n", i.(?Zone));

    // The cast result flows on: argument, match subject, comparison.
    print("arg: {}\n", nameOf(i.(Zone)));
    print("match: {}\n", match i.(Zone) {
        case .floating: 0;
        case .fill: 1;
        case .center: 2;
        case .top: 3;
    });
    print("cmp: {}\n", i.(Zone) == Zone.top);

    // Out of the variant set: well-defined, not value-preserving — the
    // raw value converts, exactly as `1000.(i8)` truncates.
    o : i64 = 9;
    print("out-of-set: {}\n", o.(Zone).(i64));

    // A narrower backing runs the integer ladder first (i64 → u8).
    m : i64 = 2;
    s := m.(Small);
    print("backed: {} {}\n", @typeOf(s), s);
    // A narrower SOURCE widens into the backing.
    b : u8 = 2;
    print("widen: {}\n", b.(Zone));

    // enum → int is the dual: the value takes the integer type.
    k := Zone.top.(i64);
    print("to-int: {} {}\n", @typeOf(k), k);
    print("round-trip: {}\n", k.(Zone) == Zone.top);
    ks := Small.c.(i64);
    print("backed-to-int: {} {}\n", @typeOf(ks), ks);
    // A flags enum keeps its bit value across the round trip.
    p := Perms.write.(i64) | Perms.exec.(i64);
    print("flags: {} {}\n", p, p.(Perms).(i64));
}
