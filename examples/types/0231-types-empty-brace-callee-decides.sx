// A brace group after a call is settled by TYPES (specs: Trailing Blocks): a
// generic type head constructs, a `$F/() -> void` last parameter takes the block.
// Body shape, the gap before the `{`, and names — the callee's case, an
// argument's — decide nothing. A function-local head is settled the same way,
// where its own scope is in hand.
@import "modules/std.sx";

pair :: struct { a: i64; b: i64; }
Move :: struct { d: i64; }

Box :: struct ($T: Type) { v: T = ---; }
Buf :: struct ($N: i64) { xs: [N]i64 = ---; }

run :: (n: i64, body: $F/() -> void) { body(); }
Group :: (n: i64, body: $F/() -> void) { body(); }

main :: () -> i64 {
    b := Box(pair){};             // lowercase user type arg
    v := Buf(16){};               // pure value parameter
    ms := List(Move){};           // bare PascalCase name
    xs := List(i64) {};           // spaced: the same construction
    ys := List(i64)     {};       // the gap is ignored

    b.v.a = 3;
    ms.append(Move{ d = 4 });
    xs.append(5);
    ys.append(6);
    print("{} {} {} {} {}\n", b.v.a, v.xs.len, ms.len, xs.len, ys.len);

    n := 2;
    run(n) { print("run\n"); };
    Group(n) {};                  // spaced: an empty trailing block
    run(n){};                     // tight: the same block

    // A function-LOCAL type constructs the same way.
    LocalBox :: struct ($T: Type) { v: T = ---; }
    Pt :: struct { x: i64; }
    lb := LocalBox(i64){};
    lp := Pt { x = 7 };
    lb.v = 8;
    print("local {} {}\n", lb.v, lp.x);
    return 0;
}
