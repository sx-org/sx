// A string literal takes the shape its destination names: the `[N:0]u8` array
// (a copy of its bytes plus the terminator), the `[:0]u8` view, or a
// `[*:0]u8` pointer. Where no shape is named it is `string`. A `::` constant
// bound to a literal stays untyped: `@typeOf` reports `string`, and each use
// takes the shape its own destination names.

@import "modules/std.sx";

libc :: @library "c";
puts :: (s: [*:0]u8) -> i32 extern libc;

GREETING :: "abc";
HEADER : string : "abc";

takesString :: (s: string) -> i64 { s.len }

main :: () -> i32 {
    b : [3:0]u8 = "abc";
    b[0] = 'X';
    print("array: {} len {} size {} term {} first {}\n", @typeName(@typeOf(b)), b.len, @sizeOf([3:0]u8), b[3], b[0]);

    v : [:0]u8 = "abc";
    print("view: len {} term {}\n", v.len, v.ptr[3]);

    s := "abc";
    print("default: {} {} len {}\n", @typeName(@typeOf(s)), s, s.len);

    y := GREETING;
    print("constant: {} {} {}\n", @typeName(@typeOf(GREETING)), @typeName(@typeOf(y)), y);
    LOCAL :: "abc";
    print("body-local: {} {}\n", @typeName(@typeOf(LOCAL)), takesString(LOCAL));
    KEPT : [3:0]u8 : "abc";
    print("body-local annotated: {} {}\n", @typeName(@typeOf(KEPT)), KEPT[3]);
    print("annotated: {} {}\n", @typeName(@typeOf(HEADER)), takesString(HEADER));

    _ = puts("a literal reaches C");
    _ = puts(GREETING);
    _ = puts(LOCAL);
    0
}
