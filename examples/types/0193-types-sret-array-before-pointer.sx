// Assigning `null` / `---` to a struct field stores a FIELD-typed value, not one
// typed by an enclosing `target_type` (e.g. the function's return type while
// lowering its body): `needs_target` in lowerAssignment covers null and undef
// literals. The array-before-pointer field order puts the pointer at a non-zero
// offset.
#import "modules/std.sx";
S :: struct {
    arr: [2]u64;   // fixed-array field FIRST
    p:   *i64;     // pointer field AFTER the array
    n:   i64;
}
mk :: () -> S {
    s : S = ---;
    s.p = null;     // must store a *i64 null, not a whole-struct null
    s.n = 0;
    return s;
}
main :: () -> i64 {
    s := mk();
    print("n {}\n", s.n);   // n 0
    return 0;
}
