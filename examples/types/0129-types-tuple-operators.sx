@import "modules/std.sx";
@import "modules/std/mem.sx"; // `Allocator` is non-transitive: name it, import it.
@import "modules/math";
@import "modules/build.sx";
@import "modules/std/test.sx";
pkg :: @import "tests/fixtures/testpkg";

Point :: struct { x, y: i32; }

OptNode :: struct {
    value: i32;
    next: ?i32;
}

OptInner :: struct { val: i32; }

OptOuter :: struct { inner: ?OptInner; }

add :: (a: i32, b: i32) -> i32 { a + b }

mul :: (a: i32, b: i32) -> i32 { a * b }

identity :: (x: $T) -> T { x }

apply :: (f: (i32, i32) -> i32, x: i32, y: i32) -> i32 {
    f(x, y)
}

Chained :: constraint {
    base :: (self: *Self, msg: string) -> i32;
    wrap :: (self: *Self, msg: string) -> i32 {
        self.base(msg) + 1
    }
    doubleWrap :: (self: *Self, msg: string) -> i32 {
        self.wrap(msg) + self.wrap(msg)
    }
}

main :: () {

    // --- Product equality ---
    {
        print("=== Product equality ===\n");

        t12 := .{1, 2};
        t13 := .{1, 3};

        print("{}\n", t12 == t12);     // true
        print("{}\n", t12 == t13);     // false
        print("{}\n", t12 != t13);     // true
        print("{}\n", t12 != t12);     // false
    }

    // --- Directory imports ---
    {
        print("--- directory imports ---\n");
        print("{}\n", pkg.add(3, 4));         // 7
        print("{}\n", pkg.mul(5, 6));         // 30
        print("{}\n", pkg.hello());           // hello from testpkg
        print("{}\n", pkg.cwdGreet());        // cwd-import-ok
    }

    // ── allocSlice ──────────────────────────────────────────
    {
        items := allocSlice(i64, 5);
        items[0] = 10;
        items[1] = 20;
        items[2] = 30;
        items[3] = 40;
        items[4] = 50;
        print("alloc len: {}\n", items.len);         // alloc len: 5
        print("alloc[0]: {}\n", items[0]);            // alloc[0]: 10
        print("alloc[4]: {}\n", items[4]);            // alloc[4]: 50

        // allocSlice with u8
        bytes := allocSlice(u8, 3);
        bytes[0] = 65;
        bytes[1] = 66;
        bytes[2] = 67;
        print("bytes len: {}\n", bytes.len);          // bytes len: 3
    }

    // ========================================================
    // ALLOCATORS
    // ========================================================
    print("--- allocators ---\n");

    // ── GPA ─────────────────────────────────────────────────
    {
        gpa := GPA.init();
        a : Allocator = gpa;
        p1 := a.allocBytes(64);
        p2 := a.allocBytes(128);
        print("gpa allocs: {}\n", gpa.allocCount);         // gpa allocs: 2
        a.deallocBytes(p1);
        a.deallocBytes(p2);
        print("gpa final: {}\n", gpa.allocCount);          // gpa final: 0
    }

    // ── Arena backed by GPA (multi-chunk) ───────────────────
    {
        gpa3 := GPA.init();
        arena := Arena.init(gpa3, 32);
        a : Allocator = arena;
        // First chunk fits 80 usable bytes
        a1 := a.allocBytes(40);
        a2 := a.allocBytes(40);
        // Counts: just the first chunk = 1. Arena.init returns the
        // state by value; the local IS the Arena struct, no parent
        // allocation for the state itself.
        print("arena chunks: {}\n", gpa3.allocCount);        // arena chunks: 1
        // Overflow → new chunk
        a3 := a.allocBytes(16);
        print("arena overflow: {}\n", gpa3.allocCount);      // arena overflow: 2
        // Verify memory works across chunks
        p1 : [*]u8 = xx a1;
        p3 : [*]u8 = xx a3;
        p1[0] = 42;
        p3[0] = 99;
        print("arena a1: {}\n", p1[0]);                       // arena a1: 42
        print("arena a3: {}\n", p3[0]);                       // arena a3: 99
        // Reset retains the first chunk
        arena.reset();
        print("arena reset idx: {}\n", arena.endIndex);      // arena reset idx: 0
        print("arena reset gpa: {}\n", gpa3.allocCount);     // arena reset gpa: 1
        // Deinit frees all chunks (caller's local is the state — no
        // dealloc of the struct itself).
        arena.deinit();
        print("arena deinit: {}\n", gpa3.allocCount);        // arena deinit: 0
    }

    // ── BufAlloc from stack array ───────────────────────────
    {
        stackBuf : [128]u8 = ---;
        buf := BufAlloc.init(*stackBuf[0], 128);
        a : Allocator = buf;
        b1 := a.allocBytes(24);
        b2 := a.allocBytes(24);
        print("buf pos: {}\n", buf.pos);                    // buf pos: 48
        b3 := a.allocBytes(200);
        b3I : i64 = xx b3;
        print("buf overflow: {}\n", b3I);                  // buf overflow: 0
        buf.reset();
        print("buf reset: {}\n", buf.pos);                  // buf reset: 0
    }

    // ========================================================
    // OPTIONALS
    // ========================================================
    print("--- optionals ---\n");

    // Basic optional creation and null
    {
        x: ?i32 = 42;
        y: ?i32 = null;
        print("opt x: {}\n", x);                           // opt x: 42
        print("opt y: {}\n", y);                            // opt y: null
    }

    // Force unwrap
    {
        x: ?i32 = 10;
        val := x?!;
        print("unwrap: {}\n", val);                         // unwrap: 10
    }

    // Null coalescing
    {
        x: ?i32 = 42;
        y: ?i32 = null;
        a := x ?? 0;
        b := y ?? 99;
        print("coalesce a: {}\n", a);                       // coalesce a: 42
        print("coalesce b: {}\n", b);                       // coalesce b: 99

        // Chained ?? (right-associative): a ?? b ?? c
        z: ?i32 = null;
        c := x ?? y ?? 0;
        d := z ?? y ?? 99;
        e := z ?? z ?? 0;
        print("chained ?? c: {}\n", c);                     // chained ?? c: 42
        print("chained ?? d: {}\n", d);                     // chained ?? d: 99
        print("chained ?? e: {}\n", e);                     // chained ?? e: 0
    }

    // If-binding (safe unwrap)
    {
        x: ?i32 = 7;
        y: ?i32 = null;
        if val := x {
            print("if-bind x: {}\n", val);                  // if-bind x: 7
        }
        if val := y {
            print("if-bind y: should not print\n");
        } else {
            print("if-bind y: none\n");                     // if-bind y: none
        }
    }

    // Pattern matching on optionals
    {
        check :: (v: ?i32) -> i32 {
            return match v {
                case .some: |val| { val }
                case .none: { 0 }
            };
        }
        a: ?i32 = 55;
        b: ?i32 = null;
        print("match some: {}\n", check(a));                // match some: 55
        print("match none: {}\n", check(b));                // match none: 0
    }

    // Optional with implicit wrapping
    {
        optWrap :: (n: i32) -> ?i32 {
            if n > 0 {
                return n;
            }
            return null;
        }
        r1 := optWrap(5);
        r2 := optWrap(0);
        print("wrap pos: {}\n", r1);                        // wrap pos: 5
        print("wrap neg: {}\n", r2);                        // wrap neg: null
    }

    // Struct field defaults for ?T
    {
        n := OptNode{ value = 10 };
        print("opt field default: {}\n", n.next);           // opt field default: null
        m := OptNode{ value = 20, next = 42 };
        print("opt field set: {}\n", m.next);               // opt field set: 42
    }

    // ?T as function parameter
    {
        optProcess :: (val: ?i32) -> i32 {
            return val ?? 0;
        }
        a: ?i32 = 42;
        b: ?i32 = null;
        print("opt param a: {}\n", optProcess(a));         // opt param a: 42
        print("opt param b: {}\n", optProcess(b));         // opt param b: 0
        print("opt param 7: {}\n", optProcess(7));         // opt param 7: 7
    }

    // Assignment to optional variable (f32 → ?f32)
    {
        iw: ?f32 = null;
        w: f32 = 42.5;
        iw = w;
        print("opt reassign: {}\n", iw ?? 0.0);                // opt reassign: 42.5

        // Assignment of computed value to optional
        iw2: ?f32 = null;
        a: ?f32 = 10.0;
        if v := a { iw2 = v + 5.0; }
        print("opt compute assign: {}\n", iw2 ?? 0.0);         // opt compute assign: 15.0

        // Re-assign optional back to null
        iw2 = null;
        print("opt re-null: {}\n", iw2 ?? 99.0);               // opt re-null: 99.0
    }

    // Generic function with ?T return
    {
        firstPos :: ($T: Type, a: T, b: T) -> ?T {
            if a > 0 { return a; }
            if b > 0 { return b; }
            return null;
        }
        print("generic opt 1: {}\n", firstPos(i32, 5, 10));  // generic opt 1: 5
        print("generic opt 2: {}\n", firstPos(i32, 0, 7));   // generic opt 2: 7
        print("generic opt 3: {}\n", firstPos(i32, 0, 0));   // generic opt 3: null
    }

    // Optional chaining (?.)
    {
        p: ?OptNode = OptNode{ value = 10, next = 20 };
        q: ?OptNode = null;
        print("chain some: {}\n", p?.value ?? 0);           // chain some: 10
        print("chain none: {}\n", q?.value ?? 0);           // chain none: 0
        print("chain print: {}\n", p?.next);                 // chain print: 20
        print("chain null: {}\n", q?.next);                  // chain null: null

        // Chained: obj.field?.field
        o1 := OptOuter{ inner = OptInner{ val = 99 } };
        o2 := OptOuter{ inner = null };
        print("deep chain 1: {}\n", o1.inner?.val ?? 0);    // deep chain 1: 99
        print("deep chain 2: {}\n", o2.inner?.val ?? 0);    // deep chain 2: 0
    }

    // Flow-sensitive narrowing
    {
        x: ?i32 = 42;
        y: ?i32 = null;

        // if x != null → x is narrowed to i32
        if x != null {
            print("narrow x: {}\n", x);                        // narrow x: 42
        }

        // if y != null → not entered
        if y != null {
            print("should not print\n");
        } else {
            print("narrow y else: null\n");                    // narrow y else: null
        }

        // if x == null ... else → else-branch narrowed
        if x == null {
            print("should not print\n");
        } else {
            print("narrow else x: {}\n", x);                  // narrow else x: 42
        }
    }

    // Guard narrowing
    {
        guardFn :: (v: ?i32) -> i32 {
            if v == null { return 0; }
            return v;
        }
        print("guard some: {}\n", guardFn(42));               // guard some: 42
        print("guard none: {}\n", guardFn(null));             // guard none: 0
    }

    // Compound narrowing: && chains
    {
        a: ?i32 = 10;
        b: ?i32 = 20;
        c: ?i32 = null;
        if a != null and b != null {
            print("and both: {} {}\n", a, b);                  // and both: 10 20
        }
        if a != null and c != null {
            print("should not print\n");
        } else {
            print("and one null\n");                           // and one null
        }
    }

    // Compound guard narrowing: || chains
    {
        guard2 :: (a: ?i32, b: ?i32) -> i32 {
            if a == null or b == null { return 0; }
            return a + b;
        }
        print("or guard: {}\n", guard2(3, 4));                 // or guard: 7
        print("or guard null: {}\n", guard2(3, null));         // or guard null: 0
    }

    // Nested if narrowing
    {
        a: ?i32 = 10;
        b: ?i32 = 20;
        if a != null {
            if b != null {
                print("nested narrow: {} {}\n", a, b);         // nested narrow: 10 20
            }
        }
    }

    // Guard narrowing used in loop
    {
        guardLoop :: (v: ?i32) -> i32 {
            if v == null { return 0; }
            sum := 0;
            i := 0;
            while i < v {
                sum = sum + 1;
                i = i + 1;
            }
            return sum;
        }
        print("guard loop: {}\n", guardLoop(3));              // guard loop: 3
    }

    // --- block-body lambdas ---
    {
        // block-body lambda with return type
        clamp := |x: i64, lo: i64, hi: i64| -> i64 {
            if x < lo { return lo; }
            if x > hi { return hi; }
            return x;
        };
        print("block-lambda: {}\n", clamp(50, 0, 100));   // block-lambda: 50
        print("block-lambda: {}\n", clamp(-10, 0, 100));  // block-lambda: 0
        print("block-lambda: {}\n", clamp(999, 0, 100));  // block-lambda: 100

        // block-body lambda without return type annotation
        greet := |name: string| {
            print("hello {}\n", name);
        };
        greet("block");  // hello block
    }

    // --- named params in function types ---
    {
        // Named params are documentation only — ignored for type identity
        applyNamed :: (f: (x: i32, y: i32) -> i32, a: i32, b: i32) -> i32 {
            return f(a, b);
        }
        add :: (a: i32, b: i32) -> i32 { return a + b; }
        print("named-fn-type: {}\n", applyNamed(add, 3, 4));  // named-fn-type: 7
    }

    // --- xx on function pointers ---
    {
        MyEnv :: struct { n: i32; }
        typedFn :: (e: *MyEnv, x: i32) -> i32 {
            return x + e.n;
        }
        // xx cast: (*MyEnv, i32) -> i32  →  (*void, i32) -> i32
        f : (*void, i32) -> i32 = xx typedFn;
        env := MyEnv{ n = 100 };
        print("xx-fnptr: {}\n", f(*env, 42));  // xx-fnptr: 142
    }

    // --- closure type: construct and access fields ---
    {
        dummyFn :: (env: *void, x: i32) -> i32 {
            return x * 2;
        }
        fnPtr : *void = xx dummyFn;
        nullEnv : *void = xx 0;
        c : Closure(i32) -> i32 = .{ fnPtr = fnPtr, env = nullEnv };
        print("closure-type: fnPtr-nonnull={}\n", c.fnPtr != nullEnv);
        print("closure-type: env-null={}\n", c.env == nullEnv);
    }

    // --- closure calling convention ---
    {
        Env :: struct { n: i32; }
        implFn :: (env: *void, x: i32) -> i32 {
            e : *Env = xx env;
            return x + e.n;
        }
        env := Env{ n = 5 };
        fnPtr : *void = xx implFn;
        envPtr : *void = *env;
        c : Closure(i32) -> i32 = .{ fnPtr = fnPtr, env = envPtr };
        print("closure-call: {}\n", c(10));
    }

    // --- auto-promotion: bare fn → Closure ---
    {
        double :: (x: i32) -> i32 { return x * 2; }
        apply :: (f: Closure(i32) -> i32, x: i32) -> i32 { return f(x); }
        print("auto-promote: {}\n", apply(double, 10));

        // Named function to Closure variable
        f : Closure(i32) -> i32 = double;
        print("auto-promote-var: {}\n", f(5));
    }

    // ---  intrinsic ---
    {
        // capture scalar
        n := 42;
        f := |x: i32|_{ n = n } x + n;
        print("closure-capture: {}\n", f(10));

        // capture by value is a snapshot
        m := 5;
        g := |x: i32|_{ m = m } x + m;
        m = 100;
        print("closure-snapshot: {}\n", g(10));

        // no captures (null env)
        h := |x: i32| x * 2;
        print("closure-nocap: {}\n", h(7));

        // multiple captures
        a := 10;
        b := 20;
        multi := |x: i32|_{ a = a, b = b } x + a + b;
        print("closure-multi: {}\n", multi(3));

        // block-body closure with return
        offset := 50;
        clamp := |x: i64|_{ offset = offset } -> i64 {
            if x < 0 { return 0; }
            if x > 100 { return 100; }
            return x + offset;
        };
        r1 : i64 = clamp(10);
        r2 : i64 = clamp(0 - 5);
        r3 : i64 = clamp(999);
        print("closure-block: {}\n", r1);
        print("closure-block: {}\n", r2);
        print("closure-block: {}\n", r3);

        // void closure
        tag := "LOG";
        logger := |msg: string|_{ tag = tag } {
            print("[{}] {}\n", tag, msg);
        };
        logger("hello");

        // pass closure to higher-order function
        dbl :: (x: i32) -> i32 { return x * 2; }
        applyCl :: (f2: $F/(i32) -> i32, x: i32) -> i32 { return f2(x); }
        factor : i32 = 3;
        print("closure-hof: {}\n", applyCl(|x: i32|_{ factor = factor } -> i32 x * factor, 10));

        // a bare fn answers the same bound out of its own shape
        print("closure-hof-bare: {}\n", applyCl(dbl, 10));

        scale := 2.5;
        fF32 := |x: f32|_{ scale = scale } -> f32 x * scale;
        print("closure-f32: {}\n", fF32(4.0));

        verbose := true;
        fBool := |msg: string|_{ verbose = verbose } {
            if verbose { print("closure-bool: {}\n", msg); }
        };
        fBool("hello");

        base : i32 = 100;
        f2p := |x: i32, y: i32|_{ base = base } -> i32 x + y + base;
        print("closure-2p: {}\n", f2p(3, 4));

        bias : i32 = 1;
        f3p := |a: i32, b: i32, c2: i32|_{ bias = bias } -> i32 a + b + c2 + bias;
        print("closure-3p: {}\n", f3p(10, 20, 30));

        extra : i32 = 5;
        fMix := |name: string, age: i32|_{ extra = extra } {
            print("closure-mix: {} is {}\n", name, age + extra);
        };
        fMix("Alice", 30);

        threshold : i32 = 100;
        fRbool := |x: i32|_{ threshold = threshold } -> bool { return x > threshold; };
        print("closure-rbool: {} {}\n", fRbool(50), fRbool(200));

        reduce :: (arr: []i32, f3: $F/(i32, i32) -> i32, init: i32) -> i32 {
            acc := init;
            i : i64 = 0;
            while i < arr.len { acc = f3(acc, arr[i]); i += 1; }
            return acc;
        }
        rNums : []i32 = .[1, 2, 3, 4, 5];
        rBonus : i32 = 100;
        rTotal := reduce(rNums, |acc: i32, x: i32| -> i32 acc + x, rBonus);
        print("closure-reduce: {}\n", rTotal);

        makeAdder :: (n: i32) -> $F/(i32) -> i32 {
            return |x: i32|_{ n = n } -> i32 x + n;
        }
        add5 := makeAdder(5);
        add10 := makeAdder(10);
        print("closure-factory: {} {}\n", add5(100), add10(100));

        origin := Point{ x = 10, y = 20 };
        fSt := ||_{ origin = origin } {
            print("closure-struct: {} {}\n", origin.x, origin.y);
        };
        fSt();

        innerN := 10;
        innerCl := |x: i64|_{ innerN = innerN } -> i64 x + innerN;
        outerCl := |x: i64|_{ innerCl = innerCl } -> i64 innerCl(x) * 2;
        print("closure-compose: {}\n", outerCl(5));

        shared : i32 = 10;
        clA := |x: i32|_{ shared = shared } -> i32 x + shared;
        clB := |x: i32|_{ shared = shared } -> i32 x * shared;
        print("closure-indep: {} {}\n", clA(5), clB(5));

        fNone : ?Closure(i64) -> i64 = null;
        if h := fNone {
            print("should not print: {}\n", h(1));
        } else {
            print("opt-closure: none\n");
        }

        optN := 10;
        fSome : ?Closure(i64) -> i64 = closure(|x: i64|_{ optN } -> i64 x + optN);
        if h := fSome {
            print("opt-closure: {}\n", h(5));
        } else {
            print("should not print\n");
        }

        // Struct with optional closure callback
        Btn :: struct { label: string; onClick: ?Closure(i64) -> void; }
        btnX := 99;
        btnCl : ?Closure(i64) -> void = closure(|id: i64|_{ btnX } {
            print("opt-closure-btn: {} {}\n", id, btnX);
        });
        btn1 := Btn{ label = "OK", onClick = btnCl };
        btn2 := Btn{ label = "Cancel", onClick = null };
        if h := btn1.onClick { h(1); }
        if h := btn2.onClick { h(2); } else { print("opt-closure-btn: null\n"); }

        countA6 : i32 = 0;
        pA6 := *countA6;
        incFn := ||_{ pA6 = pA6 } { pA6.* += 1; };
        incFn(); incFn(); incFn();
        print("closure-ptr: {}\n", countA6);

        cA9 : i32 = 2;  // simulate enum tag
        fA9 := ||_{ cA9 = cA9 } -> i32 cA9;
        print("closure-enum: {}\n", fA9());

        tagC4 := "INFO";
        fC4 := |msg: string|_{ tagC4 = tagC4 } -> string format("[{}] {}", tagC4, msg);
        print("closure-rstr: {}\n", fC4("ok"));

        offC5 := Point{ x = 10, y = 20 };
        fC5 := |p: Point|_{ offC5 = offC5 } -> Point Point{ x = p.x + offC5.x, y = p.y + offC5.y };
        resC5 := fC5(Point{ x = 1, y = 2 });
        print("closure-rstruct: {} {}\n", resC5.x, resC5.y);

        makeLinear :: (m: i32, b: i32) -> $F/(i32) -> i32 {
            return |x: i32|_{ m = m, b = b } -> i32 m * x + b;
        }
        lin := makeLinear(3, 7);
        print("closure-linear: {}\n", lin(10));

        makeClamper :: (lo: i32, hi: i32) -> $F/(i32) -> i32 {
            return |x: i32|_{ lo = lo, hi = hi } -> i32 {
                if x < lo { return lo; }
                if x > hi { return hi; }
                return x;
            };
        }
        clampFn := makeClamper(0, 255);
        cv1 : i32 = -10;
        cv2 : i32 = 100;
        cv3 : i32 = 999;
        print("closure-clamp: {} {} {}\n", clampFn(cv1), clampFn(cv2), clampFn(cv3));

        compose :: (fH2: $F/(i32) -> i32, gH2: $G/(i32) -> i32) -> $H/(i32) -> i32 {
            return |x: i32|_{ fH2 = fH2, gH2 = gH2 } -> i32 fH2(gH2(x));
        }
        oneH2 : i32 = 1;
        twoH2 : i32 = 2;
        add1H2 : Closure(i32) -> i32 = closure(|x: i32|_{ oneH2 } -> i32 x + oneH2);
        mul2H2 : Closure(i32) -> i32 = closure(|x: i32|_{ twoH2 } -> i32 x * twoH2);
        composed := compose(mul2H2, add1H2);
        print("closure-compose2: {}\n", composed(5));

        chK1 : i32 = 1;
        chK2 : i32 = 2;
        chK10 : i32 = 10;
        chA := |x: i32|_{ chK1 = chK1 } -> i32 x + chK1;
        chB := |x: i32|_{ chA = chA, chK2 = chK2 } -> i32 chA(x) * chK2;
        chC := |x: i32|_{ chB = chB, chK10 = chK10 } -> i32 chB(x) + chK10;
        print("closure-chain: {}\n", chC(5));

        mapCl :: (arr: [*]i32, cnt: i64, fMap: $F/(i32) -> i32, result: [*]i32) {
            i := 0;
            while i < cnt { result[i] = fMap(arr[i]); i += 1; }
        }
        mapSrc : [5]i32 = .[1, 2, 3, 4, 5];
        mapDst : [5]i32 = .[0, 0, 0, 0, 0];
        factorD1 : i32 = 3;
        mapCl(xx *mapSrc, 5, |x: i32|_{ factorD1 = factorD1 } -> i32 x * factorD1, xx *mapDst);
        print("closure-map: {} {} {} {} {}\n", mapDst[0], mapDst[1], mapDst[2], mapDst[3], mapDst[4]);

        filterCl :: (arr: [*]i32, cnt: i64, pred: $F/(i32) -> bool, result: [*]i32) -> i64 {
            j := 0;
            i := 0;
            while i < cnt {
                if pred(arr[i]) { result[j] = arr[i]; j += 1; }
                i += 1;
            }
            return j;
        }
        minVal : i32 = 3;
        filtDst : [5]i32 = .[0, 0, 0, 0, 0];
        kept := filterCl(xx *mapSrc, 5, |x: i32|_{ minVal = minVal } -> bool x >= minVal, xx *filtDst);
        print("closure-filter: {} [{} {} {}]\n", kept, filtDst[0], filtDst[1], filtDst[2]);

        sortCl :: (arr: [*]i32, cnt: i64, less: $F/(i32, i32) -> bool) {
            i := 0;
            while i < cnt {
                j := 0;
                while j < cnt - 1 - i {
                    if less(arr[j + 1], arr[j]) {
                        tmp := arr[j];
                        arr[j] = arr[j + 1];
                        arr[j + 1] = tmp;
                    }
                    j += 1;
                }
                i += 1;
            }
        }
        sortArr : [5]i32 = .[5, 3, 1, 4, 2];
        descending := true;
        sortCl(xx *sortArr, 5, |a: i32, b: i32|_{ descending = descending } -> bool {
            if descending { return a > b; }
            return a < b;
        });
        print("closure-sort: {} {} {} {} {}\n", sortArr[0], sortArr[1], sortArr[2], sortArr[3], sortArr[4]);

        forEachCl :: (arr: [*]i32, cnt: i64, fFe: $F/(i32, i64) -> void) {
            i : i64 = 0;
            while i < cnt { fFe(arr[i], i); i += 1; }
        }
        feLabel := "item";
        feArr : [3]i32 = .[10, 20, 30];
        forEachCl(xx *feArr, 3, |val: i32, idx: i64|_{ feLabel = feLabel } {
            print("closure-fe: {} {}={}\n", feLabel, idx, val);
        });

        findCl :: (arr: [*]i32, cnt: i64, predF: $F/(i32) -> bool) -> i64 {
            i : i64 = 0;
            while i < cnt {
                if predF(arr[i]) { return i; }
                i += 1;
            }
            return -1;
        }
        target : i32 = 30;
        foundIdx := findCl(xx *feArr, 3, |x: i32|_{ target = target } -> bool x == target);
        print("closure-find: {}\n", foundIdx);

        anyCl :: (arr: [*]i32, cnt: i64, predA: $F/(i32) -> bool) -> bool {
            i : i64 = 0;
            while i < cnt {
                if predA(arr[i]) { return true; }
                i += 1;
            }
            return false;
        }
        hasBig := anyCl(xx *feArr, 3, |x: i32| -> bool x > 100);
        has20 := anyCl(xx *feArr, 3, |x: i32| -> bool x == 20);
        print("closure-any: {} {}\n", hasBig, has20);

        Widget :: struct { transform: Closure(i32) -> i32; }
        negateFn :: (x: i32) -> i32 { return 0 - x; }
        wE4 := Widget{ transform = negateFn };
        print("closure-struct-field: {}\n", wE4.transform(5));

        Button :: struct {
            label: string;
            onPress: Closure(i32) -> void;
        }
        btnX2 := 99;
        btnCb : Closure(i32) -> void = closure(|id: i32|_{ btnX2 } {
            print("closure-btn: {} {}\n", id, btnX2);
        });
        btn3 := Button{ label = "OK", onPress = btnCb };
        btn3.onPress(1);

        stateJ1 : i32 = 0;
        pJ1 := *stateJ1;
        incJ1 := ||_{ pJ1 = pJ1 } -> i32 { pJ1.* += 1; return pJ1.*; };
        print("closure-counter: {} {} {}\n", incJ1(), incJ1(), incJ1());

        stateJ2 : i32 = 100;
        pJ2 := *stateJ2;
        accJ2 := |x: i32|_{ pJ2 = pJ2 } -> i32 { pJ2.* += x; return pJ2.*; };
        print("closure-acc: {} {}\n", accJ2(5), accJ2(10));

        baseK2 : i32 = 100;
        sumFn := |items: [*]i32, cnt: i64|_{ baseK2 = baseK2 } -> i32 {
            total : i32 = 0;
            i : i64 = 0;
            while i < cnt {
                total += items[i];
                i += 1;
            }
            return total + baseK2;
        };
        k2Arr : [5]i32 = .[1, 2, 3, 4, 5];
        print("closure-loop: {}\n", sumFn(xx *k2Arr, 5));

        nM3 : i32 = 1;
        fM3 : Closure(i32) -> i32 = closure(|x: i32|_{ nM3 } -> i32 x + nM3);
        print("closure-reassign: {}\n", fM3(10));
        mM3 : i32 = 2;
        fM3 = closure(|x: i32|_{ mM3 } -> i32 x * mM3);
        print("closure-reassign: {}\n", fM3(10));

        // the capture is a copy: reassigning ptM6 leaves fM6 on the old values
        ptM6 := Point{ x = 5, y = 10 };
        fM6 := ||_{ ptM6 = ptM6 } -> i32 ptM6.x + ptM6.y;
        ptM6 = Point{ x = 99, y = 99 };
        print("closure-snapstruct: {}\n", fM6());

        doubleM2 :: (x: i32) -> i32 { return x * 2; }
        baseM2 : Closure(i32) -> i32 = doubleM2;
        nM2 : i32 = 1;
        fM2 := |x: i32|_{ baseM2 = baseM2, nM2 = nM2 } -> i32 baseM2(x) + nM2;
        print("closure-cap-promoted: {}\n", fM2(5));

        nM5 : i32 = 5;
        iife := |x: i32|_{ nM5 = nM5 } -> i32 x + nM5;
        resultM5 := iife(10);
        print("closure-iife: {}\n", resultM5);

        Toggle :: struct { onChange: ?Closure(bool) -> void; }
        tF2 := Toggle{ onChange = null };
        if h := tF2.onChange { h(true); } else { print("closure-toggle: none\n"); }

        tF3Cb := |enabled: bool| { print("closure-toggle: {}\n", enabled); };
        tF3 := Toggle{ onChange = tF3Cb };
        if h := tF3.onChange { h(true); }

        Panel :: struct {
            title: string;
            onResize: Closure(string, i32, i32) -> void;
        }
        pF5Cb := |title: string, w: i32, h: i32| {
            print("closure-panel: {} {}x{}\n", title, w, h);
        };
        pF5 := Panel{ title = "main", onResize = pF5Cb };
        pF5.onResize(pF5.title, 800, 600);

        step3 :: (a: Allocator) -> *void { a.allocBytes(8) }
        step2 :: (a: Allocator) -> *void { step3(a) }
        step1 :: (a: Allocator) -> *void { step2(a) }
        gpaE6 := GPA.init();
        aE6 : Allocator = gpaE6;
        ptrE6 := step1(aE6);
        print("closure-chain-call: {}\n", ptrE6 != null);
        aE6.deallocBytes(ptrE6);

        // TEMPORARILY DISABLED — closure-in-loop causes infinite loop (index_gep element size issue?)
        // clArr : [5]Closure(i32) -> i32 = ---;
        // iLoop := 0;
        // while iLoop < 5 {
        //     valLoop : i32 = xx (iLoop * 10);
        //     clArr[iLoop] = |x: i32| -> i32 x + valLoop;
        //     iLoop += 1;
        // }
        // tmpCl := clArr[0]; print("closure-loop-0: {}\n", tmpCl(1));
        // tmpCl = clArr[1]; print("closure-loop-1: {}\n", tmpCl(1));
        // tmpCl = clArr[4]; print("closure-loop-4: {}\n", tmpCl(1));

        useFast := true;
        kFast: i32 = 2;
        kSlow: i32 = 10;
        fFast: Closure(i32) -> i32 = closure(|x: i32|_{ kFast } -> i32 x * kFast);
        fSlow: Closure(i32) -> i32 = closure(|x: i32|_{ kSlow } -> i32 x + kSlow);
        fCond: Closure(i32) -> i32 = if useFast then fFast else fSlow;
        print("closure-cond: {}\n", fCond(5));

        Form :: struct {
            onSubmit: ?Closure() -> void;
            onCancel: ?Closure() -> void;
        }
        msgF4 := "submitted";
        subCb : ?Closure() -> void = closure(||_{ msgF4 } { print("closure-form: {}\n", msgF4); });
        formF4 := Form{ onSubmit = subCb, onCancel = null };
        if h := formF4.onSubmit { h(); }
        if h := formF4.onCancel { h(); } else { print("closure-form: no cancel\n"); }

        doubleL3 :: (x: i32) -> i32 { return x * 2; }
        fL3 : Closure(i32) -> i32 = doubleL3;
        print("closure-null-env: {}\n", fL3.env == null);

        slA7 : [3]i32 = .[10, 20, 30];
        ptrA7 : [*]i32 = xx *slA7;
        fA7 := |i: i64|_{ ptrA7 = ptrA7 } -> i32 ptrA7[i];
        print("closure-slice: {} {} {}\n", fA7(0), fA7(1), fA7(2));

        gpaL1 := GPA.init();
        arenaL1 := Arena.init(gpaL1, 4096);
        push .{ allocator = arenaL1 } {
            nL1 : i32 = 5;
            fL1 := |x: i32|_{ nL1 = nL1 } -> i32 x + nL1;
            print("closure-arena: {}\n", fL1(10));
        }
        arenaL1.deinit();

        gpaL2 := GPA.init();
        aL2 : Allocator = gpaL2;
        nL2 : i32 = 7;
        resultL2 : i32 = 0;
        push .{ allocator = aL2 } {
            fL2 : Closure(i32) -> i32 = closure(|x: i32|_{ nL2 } -> i32 x + nL2);
            resultL2 = fL2(10);
            aL2.deallocBytes(fL2.env);
        }
        print("closure-gpa: {} allocs={}\n", resultL2, gpaL2.allocCount);

        valA10 : ?i32 = 42;
        fA10 := ||_{ valA10 = valA10 } -> i32 {
            if v := valA10 { return v; }
            return 0;
        };
        print("closure-opt: {}\n", fA10());

        limitC6 : i32 = 100;
        fC6 := |x: i32|_{ limitC6 = limitC6 } -> ?i32 {
            if x > limitC6 { return null; }
            return x;
        };
        r1C6 := fC6(50);
        r2C6 := fC6(200);
        if v := r1C6 { print("closure-ropt: {}\n", v); }
        if v := r2C6 { print("should-not-print\n"); } else { print("closure-ropt: none\n"); }

        doubleM8 :: (x: i32) -> i32 { return x * 2; }
        nM8 : i32 = 10;
        fnsM8 : [3]Closure(i32) -> i32 = ---;
        fnsM8[0] = doubleM8;                                // auto-promoted
        fnsM8[1] = closure(|x: i32|_{ nM8 } -> i32 x + nM8);  // captured
        fnsM8[2] = |x: i32| -> i32 x * x;       // no capture
        tmpM8 := fnsM8[0]; print("closure-mixed: {}\n", tmpM8(5));
        tmpM8 = fnsM8[1]; print("closure-mixed: {}\n", tmpM8(5));
        tmpM8 = fnsM8[2]; print("closure-mixed: {}\n", tmpM8(5));

        mkE1 :: (n: i32) -> $F/(i32) -> i32 {
            return |x: i32|_{ n = n } -> i32 x * n;
        }
        f1E1 := mkE1(2);
        f2E1 := mkE1(3);
        f3E1 := mkE1(4);
        print("closure-factory-indep: {} {} {}\n", f1E1(10), f2E1(10), f3E1(10));

        vE2 : i32 = 1;
        k2E2 : i32 = 2;
        k100E2 : i32 = 100;
        f0E2 := |x: i32|_{ vE2 = vE2 } -> i32 x + vE2;
        f1E2 := |x: i32|_{ f0E2 = f0E2, k2E2 = k2E2 } -> i32 f0E2(x) * k2E2;
        f2E2 := |x: i32|_{ f1E2 = f1E2, k100E2 = k100E2 } -> i32 f1E2(x) + k100E2;
        print("closure-deep-chain: {}\n", f2E2(10));

        c1E3 : i32 = 1;
        c2E3 : i32 = 2;
        c3E3 : i32 = 3;
        c4E3 : i32 = 4;
        c5E3 : i32 = 5;
        c6E3 : i32 = 6;
        c7E3 : i32 = 7;
        c8E3 : i32 = 8;
        bigEnv := ||_{ c1E3 = c1E3, c2E3 = c2E3, c3E3 = c3E3, c4E3 = c4E3, c5E3 = c5E3, c6E3 = c6E3, c7E3 = c7E3, c8E3 = c8E3 } -> i32 c1E3 + c2E3 + c3E3 + c4E3 + c5E3 + c6E3 + c7E3 + c8E3;
        print("closure-8cap: {}\n", bigEnv());

        multiParam := |a: i32, b: i32, c: i32, d: i32| -> i32 a + b + c + d;
        aE5 : i32 = 1; bE5 : i32 = 2; cE5 : i32 = 3; dE5 : i32 = 4;
        print("closure-4param: {}\n", multiParam(aE5, bE5, cE5, dE5));

        shared : i32 = 0;
        sharedP := *shared;
        incShared := ||_{ sharedP = sharedP } { sharedP.* += 1; };
        add5Shared := ||_{ sharedP = sharedP } { sharedP.* += 5; };
        incShared();
        add5Shared();
        incShared();
        print("closure-shared-ptr: {}\n", shared);

        piE8 : f64 = 3.14159;
        areaFn := |r: f64|_{ piE8 = piE8 } -> f64 piE8 * r * r;
        aE8 := areaFn(10.0);
        print("closure-f64: {}\n", aE8 > 314.0);

        noCap := |x: i32| -> i32 x * x;
        print("closure-zerocap: {} {}\n", noCap(7), noCap.env == null);

        ptE10 := Point{ x = 3, y = 4 };
        pE10 := *ptE10;
        getXy := ||_{ pE10 = pE10 } -> i32 pE10.x + pE10.y;
        print("closure-struct-method: {}\n", getXy());

        fnsE11 : [3]Closure(i32) -> i32 = ---;
        iE11 := 0;
        while iE11 < 3 {
            multiplier : i32 = xx (iE11 + 1);
            fnsE11[iE11] = closure(|x: i32|_{ multiplier } -> i32 x * multiplier);
            iE11 += 1;
        }
        tE11 := fnsE11[0]; print("closure-multi-factory: {}\n", tE11(10));
        tE11 = fnsE11[1]; print("closure-multi-factory: {}\n", tE11(10));
        tE11 = fnsE11[2]; print("closure-multi-factory: {}\n", tE11(10));

        flagE12 := true;
        checkFn := |x: i32|_{ flagE12 = flagE12 } -> bool {
            if flagE12 { return x > 0; }
            return x < 0;
        };
        posE12 : i32 = 5;
        negE12 : i32 = -3;
        print("closure-bool-cap: {} {}\n", checkFn(posE12), checkFn(negE12));

        applyFn := |fApp: Closure(i32) -> i32, val: i32| -> i32 fApp(val);
        kE13 : i32 = 100;
        innerFn : Closure(i32) -> i32 = closure(|x: i32|_{ kE13 } -> i32 x + kE13);
        print("closure-as-arg: {}\n", applyFn(innerFn, 42));

        prefixE14 := "hello";
        greetFn := |name: string|_{ prefixE14 = prefixE14 } -> string format("{} {}", prefixE14, name);
        print("closure-strfmt: {}\n", greetFn("world"));

        valE15 : i32 = 10;
        pE15 := *valE15;
        readFn := ||_{ pE15 = pE15 } -> i32 pE15.*;
        print("closure-ptr-before: {}\n", readFn());
        valE15 = 42;
        print("closure-ptr-after: {}\n", readFn());

        offE16 : i32 = 100;
        negFn := |x: i32|_{ offE16 = offE16 } -> i32 x - offE16;
        valE16 : i32 = 30;
        print("closure-neg: {}\n", negFn(valE16));

        gpaE17 := GPA.init();
        aE17 : Allocator = gpaE17;
        allocFn := |size: i64|_{ aE17 = aE17 } -> *void aE17.allocBytes(size);
        ptrE17 := allocFn(32);
        print("closure-proto-cap: {}\n", ptrE17 != null);
        aE17.deallocBytes(ptrE17);

        makeScaler :: (factor: i32) -> $F/(i32) -> i32 {
            return |x: i32|_{ factor = factor } -> i32 x * factor;
        }
        makeOffset :: (off: i32) -> $F/(i32) -> i32 {
            return |x: i32|_{ off = off } -> i32 x + off;
        }
        sFn := makeScaler(3);
        oFn := makeOffset(7);
        // manually compose: scale then offset
        print("closure-chain-factory: {}\n", oFn(sFn(10)));

        threshold : i32 = 50;
        aboveFn := |x: i32|_{ threshold = threshold } -> bool x >= threshold;
        valsE19 : [5]i32 = .[10, 30, 50, 70, 90];
        countAbove : i32 = 0;
        idxE19 : i64 = 0;
        while idxE19 < 5 {
            if aboveFn(valsE19[idxE19]) { countAbove += 1; }
            idxE19 += 1;
        }
        print("closure-while-cond: {}\n", countAbove);

        // ---- Inferred closure parameter types ----

        // CI.1: inferred params from typed variable
        fCi1 : Closure(i32, i32) -> i32 = |a, b| a + b;
        aCi1 : i32 = 3;
        bCi1 : i32 = 4;
        print("closure-infer: {}\n", fCi1(aCi1, bCi1));

        // CI.2: inferred params from function argument
        applyCi :: (f: $F/(i32) -> i32, x: i32) -> i32 { return f(x); }
        kCi : i32 = 10;
        vCi : i32 = 5;
        print("closure-infer-arg: {}\n", applyCi(|x|_{ kCi = kCi } x + kCi, vCi));

        // CI.3: inferred with block body
        hCi : Closure(i32, i32) -> i32 = |a, b| { return a * b; };
        print("closure-infer-block: {}\n", hCi(aCi1, bCi1));

        // CI.4: inferred with captures
        capCi : i32 = 100;
        print("closure-infer-cap: {}\n", applyCi(|x|_{ capCi } x + capCi, vCi));

        // CI.5: inferred in factory return
        mkCi :: (n: i32) -> $F/(i32) -> i32 { return |x|_{ n = n } x * n; }
        fCi5 := mkCi(7);
        print("closure-infer-factory: {}\n", fCi5(vCi));

        // CI.6: inferred with higher-order (closure taking closure)
        composeCi :: (f: $F/(i32) -> i32, g: $G/(i32) -> i32) -> $H/(i32) -> i32 {
            return |x: i32|_{ f = f, g = g } -> i32 f(g(x));
        }
        oneCi : i32 = 1;
        twoCi : i32 = 2;
        cCi := composeCi(|x|_{ oneCi = oneCi } x + oneCi, |x|_{ twoCi = twoCi } x * twoCi);
        print("closure-infer-compose: {}\n", cCi(vCi));

        // CI.7: inferred void return
        cbCi : Closure(i32) -> void = |x| { print("closure-infer-void: {}\n", x); };
        cbCi(42);
    }
}
