// `@len`, `@field`, and `@elementAt` read a boxed value's parts in place.
// Each view borrows the boxed storage — the walk copies nothing.

@import "modules/std.sx";

Point :: struct { x: i32; y: i32 }

members :: (v: any) -> string {
    r := "";
    i := 0;
    while i < @len(v) {
        if i > 0 { r = concat(r, " "); }
        r = concat(r, format("{}", @field(v, i)));
        i += 1;
    }
    r
}

elements :: (v: any) -> string {
    r := "";
    i := 0;
    while i < @len(v) {
        if i > 0 { r = concat(r, " "); }
        r = concat(r, format("{}", @elementAt(v, i)));
        i += 1;
    }
    r
}

STATIC :: @run members(Point{ x = 3, y = -4 });

main :: () -> i32 {
    p := Point{ x = 3, y = -4 };
    print("struct {} {}\n", @len(p), members(p));

    arr : [4]i16 = .[10, -20, 30, -40];
    print("array {} {}\n", @len(arr), elements(arr));

    s := arr[1..3];
    print("slice {} {}\n", @len(s), elements(s));

    lanes := @Vector(3, f32).[1.0, 3.0, 2.0];
    print("vector {} {}\n", @len(lanes), elements(lanes));

    // A narrow length word: the count is masked to its own bit width.
    bytes : [4]u8 = .[1, 2, 3, 4];
    narrow : @Slice(u8, u8) = bytes[0..];
    print("narrow {} {}\n", @len(narrow), elements(narrow));

    // Views alias the boxed storage.
    arr[0] = 99;
    print("aliased {}\n", @elementAt(arr, 0));
    print("static {}\n", STATIC);
    return 0;
}
