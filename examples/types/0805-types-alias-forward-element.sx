// A composite type alias whose element is declared LATER in the file is ADOPTED
// once the forward-alias fixpoint reaches that decl, so it has the correct
// layout — for array / slice / optional / pointer / function RHS alike. A
// generic-instantiation element (`List(i64)`) instantiates for REAL, so its
// `@sizeOf` matches the inline spelling.
@import "modules/std.sx";

// Element alias declared AFTER the array alias — adopted via the fixpoint.
ArrLater :: [2]B;
B        :: i64;

// Nested composite, all forward: `[2][]C` -> array of slices of C.
NestLater :: [2]D;
D         :: []C;
C         :: i64;

// Forward pointer / optional / function elements.
PtrLater :: *E;
OptLater :: ?E;
FnLater  :: (E) -> E;
E        :: i64;

// Generic-instantiation element — real instantiation, correct @sizeOf.
ListArr :: [2]List(i64);

main :: () -> i32 {
    a : ArrLater = ---;
    a[0] = 10; a[1] = 20;
    print("a = {} {}\n", a[0], a[1]);

    print("@sizeOf ArrLater  = {}\n", @sizeOf(ArrLater));   // 2 * 8 = 16
    print("@sizeOf NestLater = {}\n", @sizeOf(NestLater));  // 2 * 16 = 32
    print("@sizeOf PtrLater  = {}\n", @sizeOf(PtrLater));   // 8
    print("@sizeOf OptLater  = {}\n", @sizeOf(OptLater));   // 16
    print("@sizeOf FnLater   = {}\n", @sizeOf(FnLater));    // 8

    // A generic-instantiation element instantiates for real: the alias
    // @sizeOf matches the inline `[2]List(i64)` spelling exactly.
    print("@sizeOf ListArr   = {}\n", @sizeOf(ListArr));
    print("@sizeOf inline    = {}\n", @sizeOf([2]List(i64)));
    print("list-elem parity  = {}\n", @sizeOf(ListArr) == @sizeOf([2]List(i64)));
    0
}
