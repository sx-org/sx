// A positional literal `.{ a, b }` whose target is a named product coerces each
// element to the per-position field type — so an optional field gets a
// properly wrapped `{T,i1}` value, an int element narrows/widens to a float
// field, etc.
@import "modules/std.sx";

main :: () {
    // Optional + float fields.
    t : struct { a: ?i64; b: f64 } = .{ a = 7, b = 3.0 };
    print("{} {}\n", t.a ?? -1, t.b);          // 7 3.000000

    // int -> float coercion on a product element.
    u : struct { a: f64; b: i64 } = .{ a = 3, b = 4 };
    print("{} {}\n", u.a, u.b);                // 3.000000 4

    // Named product.
    n : struct { x: ?i64; y: f64 } = .{ x = 5, y = 2.5 };
    print("{} {}\n", n.x ?? -1, n.y);          // 5 2.500000

    // Variable elements flowing into an optional product field.
    a := 9;
    b := 1.5;
    v : struct { a: ?i64; b: f64 } = .{ a = a, b = b };
    print("{} {}\n", v.a ?? -1, v.b);          // 9 1.500000

    // A bare `null` element into an optional product field.
    w : struct { a: ?i64; b: i64 } = .{ a = null, b = 8 };
    print("{} {}\n", w.a ?? -1, w.b);          // -1 8
}
