// A cast converts its own operand's value, truncating an untyped one. An `if`
// in a callee or in a call argument still takes its destination's type.

@import "modules/std.sx";

main :: () -> i32 {
    c := true;
    n := 0;
    print("{}\n", later(c).(u8));
    print("{}\n", g(if c then 3 else 4).(u8));
    print("{}\n", (300 << n).(u8));
    return 0;
}

later :: (c: bool) -> i64 {
    x : i8 = if c then 5 else 6;
    x
}

g :: (x: i8) -> i64 { x }
