// The scalar reflection family accepts RUNTIME `Type` values: @sizeOf /
// @alignOf / structFieldCount / variantCount / isFlags read tag-indexed
// tables; @typeEq compares tags. Includes the parity pins: for each shape the
// RUNTIME answer equals the COMPTIME fold (padded, nested, union — the layouts
// most likely to diverge).
@import "modules/std.sx";

Padded  :: struct { a: u8; b: i64; c: u16; }        // tail+interior padding
Inner   :: struct { x: u16; }
Nested  :: struct { i: Inner; j: Inner; k: u8; }
Overlay :: union { asInt: i64; asBytes: [8]u8; }
Color   :: enum { red; green; blue; }
Flags   :: enum flags { vsync; fullscreen; }

check :: (label: string, rt: i64, ct: i64) {
    print("{}: {} parity={}\n", label, rt, rt == ct);
}

main :: () {
    tp : Type = Padded;
    tn : Type = Nested;
    to : Type = Overlay;
    tc : Type = Color;
    tf : Type = Flags;

    check("padded-size", @sizeOf(tp), @sizeOf(Padded));
    check("padded-align", @alignOf(tp), @alignOf(Padded));
    check("nested-size", @sizeOf(tn), @sizeOf(Nested));
    check("union-size", @sizeOf(to), @sizeOf(Overlay));
    check("padded-sfc", structFieldCount(tp), structFieldCount(Padded));
    check("union-sfc", structFieldCount(to), structFieldCount(Overlay));
    check("color-vc", variantCount(tc), variantCount(Color));

    print("eq={} neq={}\n", @typeEq(tp, Padded), @typeEq(tp, Nested));
    print("flags: color={} flags={}\n", isFlags(tc), isFlags(tf));

    av : any = Color.green;
    print("any-tag: vc={} size={}\n", variantCount(@typeOf(av)), @sizeOf(@typeOf(av)));
}
