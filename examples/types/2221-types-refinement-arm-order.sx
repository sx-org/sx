// A refinement above its umbrella splits by first-wins: `case unsigned:`
// claims the unsigned tags, and `case int:` keeps what is left. Both an `any`
// subject and a `Type` subject follow the one rule.
@import "modules/std.sx";

byTag :: (av: any) -> string {
    match av {
        case unsigned: return "unsigned";
        case int:      return "int";
        else:          return "other";
    }
    "unreached"
}

byType :: (t: Type) -> string {
    match t {
        case unsigned: return "unsigned";
        case int:      return "int";
        else:          return "other";
    }
    "unreached"
}

main :: () {
    u : u32 = 7;
    i : i32 = -7;
    f : f64 = 1.5;
    print("tag:  {} {} {}\n", byTag(u), byTag(i), byTag(f));
    print("type: {} {} {}\n", byType(u32), byType(i32), byType(f64));
}
