// Runtime `structFieldType(t, 0)` answers an ELEMENT/CHILD row for every
// element-carrying kind: struct fields, array/vector elements, and — the
// kinds with no static member count — a slice's element, a string's byte,
// and an optional's child (one table row each, index 0). The master
// member-type tables and the static type-position fold answer from the same
// TypeTable query, so the two can never diverge (pinned by the parity lines).
@import "modules/std.sx";

Pair :: struct { a: i32; b: f64; }

main :: () {
    p := Pair{ a = 1, b = 2.5 };
    pv : any = p;
    print("struct: {} -> {}\n", @typeName(@typeOf(pv)), @typeName(structFieldType(@typeOf(pv), 0)));

    ar : [4]i16 = .[1, 2, 3, 4];
    arv : any = ar;
    print("array: {} -> {}\n", @typeName(@typeOf(arv)), @typeName(structFieldType(@typeOf(arv), 0)));

    v : @Vector(3, f32) = .[1.0, 2.0, 3.0];
    vv : any = v;
    print("vector: {} -> {}\n", @typeName(@typeOf(vv)), @typeName(structFieldType(@typeOf(vv), 0)));

    s : []i64 = .[10, 20, 30];
    sv : any = s;
    print("slice: {} -> {}\n", @typeName(@typeOf(sv)), @typeName(structFieldType(@typeOf(sv), 0)));

    str : string = "hi";
    strv : any = str;
    print("string: {} -> {}\n", @typeName(@typeOf(strv)), @typeName(structFieldType(@typeOf(strv), 0)));

    o : ?u8 = 7;
    ov : any = o;
    print("optional: {} -> {}\n", @typeName(@typeOf(ov)), @typeName(structFieldType(@typeOf(ov), 0)));

    // parity: the runtime table rows == the static type-position folds
    st : Type = @typeOf(sv);
    ot : Type = @typeOf(ov);
    strt : Type = @typeOf(strv);
    print("parity: {} {} {}\n",
        @typeEq(structFieldType(st, 0), structFieldType([]i64, 0)),
        @typeEq(structFieldType(ot, 0), structFieldType(?u8, 0)),
        @typeEq(structFieldType(strt, 0), structFieldType(string, 0)));
}
