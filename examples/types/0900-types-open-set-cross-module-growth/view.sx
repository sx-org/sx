// The set, and the only member its own module declares.
@import "modules/std.sx";

View :: @OpenSet(.{ max = 256, align = 8 }) {
    render :: (self: *Self) -> string;
}

Label :: @OpenVariant(View) {
    text: string = "";
    render :: (self: *Label) -> string => self.text;
}

// Measured in the set's OWN module, which declares nothing but `Label` — and still
// answers with the size the whole program settled on.
here :: () -> i64 => size_of(View);
