// A malformed `@int` used as a numeric-limit receiver or as an `is` subject
// reports the constructor diagnostic (width, signedness, arity) — the same
// wording a type-position `@int` reports.
@import "modules/std.sx";

main :: () -> i32 {
    a := @int(0, .signed).max;
    b := @int(3, .foo).max;
    c := @int(3).max;
    d := @int(0, .signed) is int;
    return 0;
}
