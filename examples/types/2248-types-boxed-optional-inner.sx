// `@inner` views a boxed optional's payload — null when the optional is
// absent. The view borrows the boxed storage, so it copies nothing.

@import "modules/std.sx";

flagged :: (v: any) -> string {
    if p := @inner(v) { format("{}", @unbox(p, i32)) } else { "null" }
}

sentinel :: (v: any) -> string {
    if p := @inner(v) { format("{}", @unbox(p, *i32).*) } else { "null" }
}

main :: () -> i32 {
    n : ?i32 = 7;
    noN : ?i32 = null;
    print("flagged {} {}\n", flagged(n), flagged(noN));

    x : i32 = 41;
    p : ?*i32 = *x;
    noP : ?*i32 = null;
    print("sentinel {} {}\n", sentinel(p), sentinel(noP));

    // The view aliases the payload it borrows.
    x = 99;
    print("aliased {}\n", sentinel(p));
    return 0;
}
