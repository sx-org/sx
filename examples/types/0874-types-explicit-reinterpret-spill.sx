// Same-size aggregate pun: a string and `@Slice` are the same two words.
// Aggregate↔scalar reinterpret is a hard error (no spill).
@import "modules/std.sx";

main :: () {
    s := "hi";
    raw := s.(@Slice);
    print("view={} {}\n", raw.len, raw.ptr != null);
    back := raw.(string);
    print("back={}\n", back);
}
