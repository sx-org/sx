// Two top-level structs each carry an inline anonymous-struct field named
// `inner`, but of DIFFERENT shapes. Each `inner` resolves to its OWN
// anonymous type (`A.inner` has `x`; `B.inner` has `y, z`) — they do not
// cross-bind on the shared field spelling. The per-parent anon rename keys
// each `inner` separately.
@import "modules/std.sx";

A :: struct { inner: struct { x: i64; }; }
B :: struct { inner: struct { y: i64; z: i64; }; }

main :: () -> i32 {
    a := A{ inner = .{ x = 1 } };
    b := B{ inner = .{ y = 2, z = 3 } };
    print("{} {} {}\n", a.inner.x, b.inner.y, b.inner.z);
    0
}
