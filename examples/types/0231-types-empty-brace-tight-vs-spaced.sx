// Empty `{}` after a call has no body shape, so the brace spelling decides
// (specs: Trailing Blocks — Empty block). Tight `){}` is a parameterized
// aggregate; a spaced `) {}` is a trailing block unless an argument can only
// be a type. Names carry no signal either way: `pair` is a type, `n` a value.
#import "modules/std.sx";

pair :: struct { a: i64; b: i64; }
Move :: struct { d: i64; }

Box :: struct ($T: Type) { v: T = ---; }
Buf :: struct ($N: i64) { xs: [N]i64 = ---; }

run :: (n: i64, body: Closure()) { body(); }
Group :: (n: i64, body: Closure()) { body(); }

main :: () -> i64 {
    b := Box(pair){};             // lowercase user type arg
    v := Buf(16){};               // pure value parameter
    ms := List(Move){};           // bare PascalCase name
    xs := List(i64) {};           // type-expr arg: aggregate even when spaced

    b.v.a = 3;
    ms.append(Move{ d = 4 });
    xs.append(5);
    print("{} {} {} {}\n", b.v.a, v.xs.len, ms.len, xs.len);

    n := 2;
    run(n) { print("run\n"); }
    Group(n) {}                   // spaced, name arg: an empty trailing block
    run(n) {}
    return 0;
}
