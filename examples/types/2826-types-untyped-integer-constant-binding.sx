// An untyped integer constant, and integer constant arithmetic, bind after
// the typed values beside them, as an integer literal does.

@import "modules/std.sx";

N :: 7;

pair :: (a: $T, b: T) -> T { b }

main :: () -> i32 {
    x : i32 = 5;
    print("{} {}\n", @typeName(@typeOf(pair(N, x))), @typeName(@typeOf(pair(x, N))));
    print("{} {}\n", @typeName(@typeOf(pair(1 + 1, x))), @typeName(@typeOf(pair(x, 1 + 1))));
    print("{} {}\n", @typeName(@typeOf(.[N, x])), @typeName(@typeOf(.[x, N])));
    print("{} {}\n", pair(N, x), .[N, x]);
    0
}
