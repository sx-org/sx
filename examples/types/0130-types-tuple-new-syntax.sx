// Anonymous products:
//   - positional VALUE `.{a, b}` with `.0` access
//   - named VALUE `.{x = a, y = b}` with `.x` access
//   - a `-> (i64, i64)` multi-return with a `.{b, a}` body
//   - product equality over two `.{...}` literals

@import "modules/std.sx";

swap :: (a: i64, b: i64) -> (i64, i64) {
    .{b, a}
}

main :: () -> i32 {
    // Positional value + index access.
    p := .{1, 2};
    print("p {} {}\n", p.0, p.1);

    // Named value (`=`) + name access.
    n := .{x = 10, y = 20};
    print("n {} {}\n", n.x, n.y);

    // 1-element positional product.
    one := .{7};
    print("one {}\n", one.0);

    // Multi-return with a `.{...}` body.
    s := swap(3, 4);
    print("swap {} {}\n", s.0, s.1);

    // Named product TYPE annotation, filled by a named `.{...}` literal.
    nt : struct { x: i64; y: i64 } = .{x = 5, y = 6};
    print("named-type {} {}\n", nt.x, nt.y);

    // Product equality over two `.{...}` literals.
    print("eq {}\n", .{1, 2} == .{1, 2});

    0
}
