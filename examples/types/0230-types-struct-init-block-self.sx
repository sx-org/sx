// Struct self-trailing: after a named aggregate, `.{ stmts }` binds `self`, and
// a `|name|` header binds that name instead — a `*T` either way. A brace group
// with no leading dot does not stack: the `;` ends the construction and the
// group after it is a scope of its own.

#import "modules/std.sx";

Button :: struct {
    label: string = "";
    n: i64 = 0;
}

bump :: (b: *Button) { b.n = b.n + 1; }

main :: () -> i64 {
    b := Button{ label = "x", n = 1 }.{
        self.n = self.n + 1;
        self.label = "y";
    };
    print("{} {}\n", b.label, b.n); // y 2

    // A header names the binding; `self` is not in scope under it.
    h := Button{ label = "h", n = 4 }.{ |btn|
        btn.n = btn.n * 2;
        btn.label = "hh";
    };
    print("{} {}\n", h.label, h.n); // hh 8

    // The value the header binds is a pointer, so a method takes it directly.
    p := Button{ label = "p", n = 1 }.{ |btn| bump(btn); };
    print("{} {}\n", p.label, p.n); // p 2

    // A brace group does not stack on a juxtaposition: the `;` ends the
    // construction and the group after it is a plain scope.
    outer : i64 = 0;
    c := Button{ label = "a" };
    {
        outer = 7;
    }
    print("{} {}\n", c.label, outer); // a 7

    return 0;
}
