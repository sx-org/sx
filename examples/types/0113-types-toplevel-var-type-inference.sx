// `lowerVarDecl` at the top level mirrors the local-scope path: explicit
// annotation → resolveType; no annotation → infer from the initializer's
// type, exactly as `:=` does for locals.
@import "modules/std.sx";

gCount := 42;        // inferred i64
gPi    := 3.14;      // inferred f64 — never i64
gFlag  := true;      // inferred bool

main :: () -> i32 {
    print("count = {}\n", gCount);
    print("pi    = {}\n", gPi);
    print("flag  = {}\n", gFlag);
    return 0;
}
