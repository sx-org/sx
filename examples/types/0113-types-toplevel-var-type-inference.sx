// `lowerVarDecl` at the top level mirrors the local-scope path: explicit
// annotation → resolveType; no annotation → infer from the initializer's
// type, exactly as `:=` does for locals.
//
// Falling back to `resolveType(null)`'s `.i64` types every un-annotated
// top-level var as `i64` whatever its initializer: `g_pi := 3.14;` assigns
// the float literal to an i64 slot, a wrong value or the wrong codegen shape.
#import "modules/std.sx";

g_count := 42;        // inferred i64
g_pi    := 3.14;      // inferred f64 — never i64
g_flag  := true;      // inferred bool

main :: () -> i32 {
    print("count = {}\n", g_count);
    print("pi    = {}\n", g_pi);
    print("flag  = {}\n", g_flag);
    return 0;
}
