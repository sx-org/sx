// Reserved-name MEMBER positions are EXEMPT from the reserved-type-name rule:
// a bare reserved spelling (`i32`, `u8`, `i8`, …) is legal as a struct FIELD
// name, a union TAG name, and a protocol METHOD-SIGNATURE name. These are
// unambiguous — the name sits in a member slot and is reached via `obj.name`
// (or dispatched by string), so it is never type-classified. The backtick form
// is optional there and resolves to the same member. Backtick access
// (`obj.`i32`) and bare access (`obj.i32`) both work.
//
// The exemption stops at member SIGNATURES: an `impl` method DEFINITION is a
// real function, so its name is a declaration site (like a free function) and a
// reserved spelling still needs the backtick (`` `i32 :: (self) ``). A bare
// reserved VALUE binding / declaration name still errors (see examples/1119,
// 1141, 1142).
@import "modules/std.sx";

// Struct fields spelled with reserved type names — bare is legal.
Holder :: struct {
    i32: i64;
    u8: i64;
}

// Union tags spelled with reserved type names — bare is legal.
Tag :: union {
    i8: i32;
    u16: f64;
}

// Protocol method SIGNATURE spelled with a reserved type name — bare is legal.
Speaker :: interface {
    i32 :: (self: *Self) -> i64;
}

Dog :: struct { n: i64; }
impl Speaker for Dog {
    `i32 :: (self: *Dog) -> i64 { self.n }   // impl DEFINITION → backtick required
}

main :: () -> i32 {
    h := Holder{ i32 = 10, u8 = 20 };
    print("fields bare = {} {}\n", h.i32, h.u8);       // bare member access
    print("fields tick = {} {}\n", h.`i32, h.`u8);     // backtick member access
    h.i32 = 11;
    h.`u8 = 21;                                        // backtick write
    print("fields set  = {} {}\n", h.i32, h.u8);

    t : Tag = ---;
    t.i8 = 5;
    print("union       = {} {}\n", t.i8, t.`i8);      // bare + backtick — same tag

    items : List(Speaker) = .{};
    d := Dog{ n = 7 };
    items.append(d.(Speaker));
    print("dispatch    = {}\n", items.items[0].i32()); // bare reserved-name method call
    return 0;
}
