// A genuinely-undeclared type name used as a field type inside a MAIN-file
// GENERIC struct emits a clean "unknown type" diagnostic.
//
// The checker walks generic-struct fields with the struct's own type params
// (`$T`) in scope: `good: T` resolves (it IS a param) while `bad: MissingType`
// is reported. A value-param position (a `Vector` lane count, a `$N: u32` arg)
// is skipped, so a valid generic struct keeps compiling.
#import "modules/std.sx";

Box :: struct($T: Type) {
    good: T;
    bad: MissingType;
}

main :: () -> i32 {
    b : Box(i64) = .{ good = 7, bad = 0 };
    print("{}\n", b.good);
    return 0;
}
