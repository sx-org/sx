// The rendered function-signature string is built in owned dynamic storage:
// a legal signature whose printed form runs well past 512 bytes must come out
// complete, byte for byte, with every parameter and the return type intact.
@import "modules/std.sx";

VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesOne :: struct { v: i64; }
VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesTwo :: struct { v: i64; }
VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesThree :: struct { v: i64; }
VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesFour :: struct { v: i64; }
VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesFive :: struct { v: i64; }
VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesRet :: struct { v: i64; }

show :: (a: any) { print("{}\n", a); }

wide :: (p0: VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesOne, p1: VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesTwo, p2: VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesThree, p3: VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesFour, p4: VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesFive) -> VeryLongNominalTypeNamePaddingSoTheRenderedSignatureRunsWellPastFiveHundredAndTwelveBytesRet {
    return .{ v = p0.v + p1.v + p2.v + p3.v + p4.v };
}

main :: () -> i32 {
    show(wide);
    0
}
