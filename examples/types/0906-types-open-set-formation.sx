// Forming an open-set value, in every spelling the language has for it (spec:
// Open Sets — formation; a member value becomes a set value).
//
// Formation is TYPE-DIRECTED and allocator-free. A member value where the set is
// the expected type becomes a complete set value — the member's tag in the tag
// word, a copy of its bytes in the payload — and that is the whole story for a
// local, an assignment, an argument, a return, and a field. `value.(View)` is the
// explicit spelling of the same conversion, never required when the expected type
// already supplies it. No allocator appears anywhere: the payload is inline.
//
// A set value is an ordinary value of its size, so copying one copies the SLOT.
// Two set values never share the member they carry.
@import "modules/std.sx";

View :: @OpenSet(.{ max = 128, align = 8 }) {
    render :: (self: *Self) -> string;
    bump :: (self: *Self, by: i64) -> i64;
}

Label :: @OpenVariant(View) {
    text: string = "";
    n: i64 = 0;
    render :: (self: *Label) -> string => self.text;
    bump :: (self: *Label, by: i64) -> i64 {
        self.n = self.n + by;
        return self.n;
    }
}

Panel :: @OpenVariant(View) {
    title: string = "";
    n: i64 = 0;
    render :: (self: *Panel) -> string => self.title;
    bump :: (self: *Panel, by: i64) -> i64 {
        self.n = self.n + by * 2;
        return self.n;
    }
}

Holder :: struct {
    v: View = ---;
}

// Expected type at a parameter and at a return.
describe :: (v: View) -> string => v.render();
make :: () -> View { return Label{ text = "returned" }; }

// A by-value set parameter is a COPY: what it does to the slot stays inside.
poke :: (v: View) -> i64 => v.bump(100);

// `@Init(View)` — a fixed target. A member expression is type-checked at expected
// `View`, so what the initializer writes is a complete slot (§5.2, §5.4).
store_view :: (value: $I/@Init(View)) -> string {
    slot: View = ---;
    value.write(*slot);
    slot.render()
}

// An OPEN type argument takes the expression's own type, writes THAT, and the set
// is reached afterwards by ordinary expected-type formation (§5.4).
store_as_view :: (value: $I/@Init($V/View)) -> View {
    item: V = ---;
    value.write(*item);
    item
}

main :: () -> i32 {
    // Expected type: a local, then an assignment of a different member.
    v: View = Label{ text = "local", n = 1 };
    print("local {}\n", v.render());
    v = Panel{ title = "assigned" };
    print("assigned {}\n", v.render());

    // Expected type: argument, return, field.
    print("argument {}\n", describe(Label{ text = "argument" }));
    print("return {}\n", make().render());
    h := Holder{ v = Label{ text = "field" } };
    print("field {}\n", h.v.render());

    // The explicit spelling, and the same value it would have formed implicitly.
    explicit := Label{ text = "explicit" }.(View);
    print("explicit {}\n", explicit.render());

    // Slot copy: `b` is an independent View. Mutating the member inside `a`
    // through dispatch does not reach `b`, and passing `a` by value mutates only
    // the callee's copy.
    a: View = Label{ text = "a", n = 1 };
    b := a;
    _ = a.bump(10);
    print("copy a={} b={}\n", a.bump(0), b.bump(0));
    print("by value {} then a={}\n", poke(a), a.bump(0));

    // `@Init(View)`: the member lifts at a fixed target; a value that already IS a
    // View is written as a plain slot copy (identity).
    print("init lifted {}\n", store_view(Label{ text = "lifted" }));
    already: View = Panel{ title = "identity" };
    print("init identity {}\n", store_view(already));
    // Open `$V`: writes `*Label`, then the return lifts it into a View.
    print("init open {}\n", store_as_view(Label{ text = "open" }).render());
    0
}

// ** stdout **
// local local
// assigned assigned
// argument argument
// return returned
// field field
// explicit explicit
// copy a=11 b=1
// by value 111 then a=11
// init lifted lifted
// init identity identity
// init open open
//
