// Compound assignment operators on global variables: += -= *= /= %= &= |= ^=
// <<= >>= all do load-modify-store.

@import "modules/std.sx";

gAdd : i64 = 10;
gSub : i64 = 10;
gMul : i64 = 10;
gDiv : i64 = 100;
gMod : i64 = 10;
gAnd : i64 = 0xff;
gOr  : i64 = 0x0f;
gXor : i64 = 0xff;
gShl : i64 = 1;
gShr : i64 = 256;

main :: () -> void {
    // += repeated: should accumulate, not reset
    gAdd += 1;
    gAdd += 1;
    gAdd += 1;
    print("add: {}\n", gAdd);  // 13

    gSub -= 3;
    gSub -= 2;
    print("sub: {}\n", gSub);  // 5

    gMul *= 2;
    gMul *= 3;
    print("mul: {}\n", gMul);  // 60

    gDiv /= 5;
    gDiv /= 4;
    print("div: {}\n", gDiv);  // 5

    gMod %= 3;
    print("mod: {}\n", gMod);  // 1

    gAnd &= 0x0f;
    print("and: {}\n", gAnd);  // 15

    gOr |= 0xf0;
    print("or: {}\n", gOr);   // 255

    gXor ^= 0x0f;
    print("xor: {}\n", gXor); // 240

    gShl <<= 4;
    gShl <<= 2;
    print("shl: {}\n", gShl); // 64

    gShr >>= 3;
    gShr >>= 2;
    print("shr: {}\n", gShr); // 8
}
