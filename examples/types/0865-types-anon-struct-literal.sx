@import "modules/std.sx";

main :: () -> i64 {
    t := .{ 1, 2 };
    print("{} {}\n", @field(t, 0), @field(t, 1));

    // Named.
    p := .{ x = 10, y = 2.5 };
    print("{} {}\n", p.x, p.y);               // 10 2.500000

    // Shorthand is NAMED; parenthesizing is the positional escape.
    x := 7;
    s := .{ x };
    e := .{ (x) };
    print("{} {}\n", s.x, @field(e, 0));               // 7 7

    // Structural identity: same shape → same type, cross-site.
    q := .{ x = 99, y = 0.5 };
    print("{} {}\n", @typeEq(@typeOf(p), @typeOf(q)), @typeEq(@typeOf(t), @typeOf(p)));  // true false

    u := .{ ..t, 3 };
    print("{} {} {}\n", @field(u, 0), @field(u, 1), @field(u, 2));       // 1 2 3

    // Struct-value printing (anonymous display name).
    print("{}\n", p);                          // __anon{ x: 10, y: 2.500000}

    // Reflection composes: anon structs are ordinary structs.
    print("{} {}\n", @typeInfo(@typeOf(u)).struct.fields.len, @typeInfo(@typeOf(p)).struct.fields[0].name);  // 3 x

    // Self-typing reaches every untyped position: an inferred return, an
    // array-literal element, and a global `::` const (immutable — a write
    // through K is the const-assign compile error).
    print("{}\n", @field(mk(), 0));                    // 5
    arr := .[ .{ 1 }, .{ 2 } ];
    print("{} {}\n", @field(arr[0], 0), @field(arr[1], 0));     // 1 2
    print("{} {} {}\n", @field(K, 0), @field(K, 1), @field(K, 2));      // 1 2 3
    return 0;
}

mk :: () { return .{ 5 }; }

K :: .{ 1, 2, 3 };
