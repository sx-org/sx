// Type-category match recognition covers every runtime category: a match
// whose ONLY pattern is `optional` or `error` is still a TYPE match.
// The categories themselves classify like any other.
@import "modules/std.sx";

ParseErr :: error { BadDigit; Overflow };

onlyOpt :: (t: Type) -> string {
    match t {
        case optional: return "optional";
        else:          return "other";
    }
    "unreached"
}

onlyErr :: (t: Type) -> string {
    match t {
        case error: return "error";
        else:           return "other";
    }
    "unreached"
}

mixed :: (t: Type) -> string {
    match t {
        case optional:  return "optional";
        case error: return "error";
        case void:      return "void";
        case struct:    return "struct";
        else:           return "other";
    }
    "unreached"
}

main :: () {
    o : ?i64 = 5;
    print("only optional: {}\n", onlyOpt(@typeOf(o)));
    print("only error: {}\n", onlyErr(ParseErr));
    print("only neg: {}\n", onlyOpt(i64));
    print("mixed opt: {}\n", mixed(@typeOf(o)));
    print("mixed err: {}\n", mixed(ParseErr));
    print("mixed void: {}\n", mixed(void));
    print("mixed other: {}\n", mixed(f64));
}
