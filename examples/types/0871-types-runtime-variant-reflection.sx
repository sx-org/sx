// Runtime variant reflection: off a runtime `Type`, `@typeInfo(t).enum.fields`
// carries explicit values, explicit tags and the ordinal default, and a tagged
// union reflects its DECLARED tag where a plain enum reflects its value;
// `isFlags(t)` answers at runtime; `@len` counts a boxed value's variants and
// `@field` views its payload at a runtime index. Printing a boxed variant
// resolves the LIVE one by scanning those reflected values against the value's
// tag word, so the printed name pins the tag -> ordinal reverse map: explicit
// tags, a signed backing, and a layout-struct union whose tag slot is narrower
// than its header.
@import "modules/std.sx";

Color :: enum { red; green; blue; }
Flag :: enum flags { A; B; C; D; }
Prio :: enum { low :: 10; mid :: 20; high :: 30; }
Neg :: enum i8 { minus :: -3; zero :: 0; plus :: 3; }
Shape :: enum { circle: f64; square: i64; point; }
Wire :: enum { ping :: 0x10; pong :: 0x20; data :: 0x100: i64; }
Ev :: enum struct { tag: u32; _: u32; payload: [4]u32; } { quit :: 0x100; key :: 0x300: i32; }

main :: () {
    // static `.value` on a tagged union with explicit tags
    print("static wire: {} {} {}\n", @typeInfo(Wire).enum.fields[0].value, @typeInfo(Wire).enum.fields[1].value, @typeInfo(Wire).enum.fields[2].value);

    // runtime `.value`: ordinals, explicit values, flags
    cv : any = Color.green;
    ct := @typeOf(cv);
    print("rt vv color: {} {} {}\n", @typeInfo(ct).enum.fields[0].value, @typeInfo(ct).enum.fields[1].value, @typeInfo(ct).enum.fields[2].value);
    pv : any = Prio.mid;
    pt := @typeOf(pv);
    print("rt vv prio: {} {} {}\n", @typeInfo(pt).enum.fields[0].value, @typeInfo(pt).enum.fields[1].value, @typeInfo(pt).enum.fields[2].value);
    fv : any = Flag.B;
    ft := @typeOf(fv);
    print("rt vv flags: {} {} {} {}\n", @typeInfo(ft).enum.fields[0].value, @typeInfo(ft).enum.fields[1].value, @typeInfo(ft).enum.fields[2].value, @typeInfo(ft).enum.fields[3].value);
    print("rt isFlags: {} {}\n", isFlags(ft), isFlags(ct));

    print("rt count: {}\n", @len(cv));

    print("rt live color: {}\n", cv);
    print("rt live prio: {}\n", pv);
    nv : any = Neg.minus;
    nt := @typeOf(nv);
    print("rt live neg: {} (vv {})\n", nv, @typeInfo(nt).enum.fields[0].value);

    // tagged union with payload + explicit tags
    w : Wire = .data(42);
    wv : any = w;
    print("rt live wire: {}\n", wv);

    // `@field` views the payload at a RUNTIME index
    s : Shape = .circle(2.5);
    sv : any = s;
    st := @typeOf(sv);
    si := 0;
    print("shape name: {} payload: {}\n", @typeInfo(st).enum.fields[si].name, @field(sv, si));

    // layout-struct union: u32 tag narrower than the 8-byte header
    e : Ev = .key(7);
    ev : any = e;
    print("ev live: {}\n", ev);

    // static/runtime parity
    print("parity: {}\n", @typeInfo(pt).enum.fields[2].value == @typeInfo(Prio).enum.fields[2].value);
}
