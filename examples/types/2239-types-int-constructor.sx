// `@int(N, .signed)` / `@int(N, .unsigned)` is the N-bit integer type, N in
// 1..=64. `@int(8, .signed)` IS `i8`. The width is any compile-time integer.

@import "modules/std.sx";

W :: 3;

MyInt :: @int(3, .signed);
Flag  :: @int(1, .unsigned);

Holder :: struct { small: @int(5, .unsigned); }

widen :: (v: @int(12, .signed)) -> i32 { v }

main :: () -> i32 {
    print("alias={} spaced={} const={}\n",
        @typeEq(i8, @int(8, .signed)),
        @typeEq(u64, @int (64, .unsigned)),
        @typeEq(MyInt, @int(W, .signed)));

    x : @int(3, .signed) = -4;
    y : Flag = 1;
    print("x={} y={} flag_is_bool={}\n", x, y, @typeEq(Flag, bool));

    h : Holder = ---;
    h.small = 31;
    print("small={} name={}\n", h.small, @typeName(Holder));

    print("widen={} name={}\n", widen(-2048), @typeName(@int(12, .signed)));
    print("sizes={} {}\n", @sizeOf(@int(64, .unsigned)), @sizeOf(MyInt));

    f := || -> @int(8, .signed) { 0 };
    print("lambda={}\n", @typeEq(@typeOf(f()), i8));

    0
}
