// `@field` reads THROUGH the boxed view via the runtime reflection tables —
// the result is
//   { the tag's i-th member type,  av.data + that member's offset }
// so member access composes by repeated calls with no copies, aliasing the
// boxed value's storage. For a tagged union the offset table answers the
// payload offset, so a variant's payload composes the same way.

@import "modules/std.sx";

Header :: struct { magic: u16; flags: u8; }
Packet :: struct { header: Header; name: string; kind: i16; }
Shape :: enum { circle: f64; square: i64; }
Pair :: struct { a: i64; b: i64; }

readB :: (p: Pair) -> i64 {
    av : any = p;
    @field(av, 1).(i64)
}

main :: () -> i64 {
    pkt := Packet{ header = .{ magic = 0x1234, flags = 255 }, name = "hello", kind = -2 };
    av : any = pkt;

    print("{}\n", @field(av, 1));    // hello
    print("{}\n", @field(av, 2));    // -2

    // Nested composition: field 0's view is Header-tagged; read through it.
    hv := @field(av, 0);
    print("{} {}\n", @field(hv, 0), @field(hv, 1));  // 4660 255

    // The whole chain aliases pkt (av borrows its storage).
    pkt.kind = 77;
    print("{}\n", @field(av, 2));    // 77

    // Tagged-union live payload through an any view.
    s := Shape.square(42);
    sv : any = s;
    print("{}\n", @field(sv, 1));    // 42

    // Comptime parity: the same composition on the comptime VM.
    K :: @run readB(Pair{ a = 1, b = 41 });
    print("{}\n", K + 1);                        // 42
    return 0;
}
