// `@typeEq` is type identity and `@unbox` is the typed read of a boxed value's
// storage. They pair: identity decides which read is legal, and `@unbox` itself
// checks nothing.

@import "modules/std.sx";

Point :: struct { x: i32; y: i32 }

describe :: (v: any) -> string {
    if @typeEq(@typeOf(v), i64) { return format("i64 {}", @unbox(v, i64)); }
    if @typeEq(@typeOf(v), Point) {
        p := @unbox(v, Point);
        return format("Point {} {}", p.x, p.y);
    }
    if @typeEq(@typeOf(v), []i16) {
        s := @unbox(v, []i16);
        return format("slice {} {} {}", s.len, s[0], s[1]);
    }
    "other"
}

// The comptime VM reads the same storage.
STATIC :: @run describe(Point{ x = 3, y = -4 });

main :: () -> i32 {
    n : i64 = 42;
    p := Point{ x = 3, y = -4 };
    arr : [4]i16 = .[10, -20, 30, -40];
    s := arr[1..3];

    print("{}\n", describe(n));
    print("{}\n", describe(p));
    print("{}\n", describe(s));
    print("{}\n", describe(1.5));
    print("static {}\n", STATIC);

    // Two static operands fold; the `describe` calls compare tags at runtime.
    print("identity {} {}\n", @typeEq(Point, @typeOf(p)), @typeEq(i64, i32));
    return 0;
}
