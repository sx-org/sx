// The dynamic reflection paths that work with a runtime `Type` value (an i64
// tag at runtime, spec §Type): @typeOf on values and any, @typeName and
// `is unsigned` through locals, params, and []Type elements.
@import "modules/std.sx";

Point :: struct { x: i64; y: i64; }

describe :: (tp: Type) -> string { @typeName(tp) }

main :: () {
    x : u16 = 9;
    tp := @typeOf(x);                       // runtime Type value
    print("local:  {} unsigned={}\n", @typeName(tp), tp is unsigned);
    print("param:  {}\n", describe(tp));

    p := Point{ x = 1, y = 2 };
    tps : [2]Type = .[@typeOf(x), @typeOf(p)];
    print("elem0:  {}\n", @typeName(tps[0]));
    print("elem1:  {}\n", @typeName(tps[1]));

    av : any = p;
    print("anytag: {}\n", @typeName(@typeOf(av)));
}
