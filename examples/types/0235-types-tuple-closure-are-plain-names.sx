// `Closure` builds a type only where a type is demanded — an annotation, a
// parameter, a return, or the RHS of `::`. `Tuple` is an ordinary identifier
// everywhere: a function may carry that name and is called without a backtick
// escape.

@import "modules/std.sx";

NT :: struct { a: i64; b: bool };
CB :: Closure(i32) -> i32;         // `::` RHS: a closure alias, `-> R` included

Closure :: (n: i32) -> i32 { n * 2 }
Tuple   :: (n: i64) -> i64 { n + 1 }

swap :: (t: NT) -> (bool, i64) { return t.b, t.a; }

apply :: (f: CB, x: i32) -> i32 { return f(x); }

main :: () -> i32 {
    print("Closure(5)={} Tuple(5)={}\n", Closure(5), Tuple(5));

    x : NT = .{a = 1, b = true};
    print("x.a={} x.b={}\n", x.a, x.b);

    s := swap(x);
    print("s.0={} s.1={}\n", s.0, s.1);

    dbl := |v: i32| -> i32 v * 2;
    print("apply={}\n", apply(dbl, 21));
    0
}
