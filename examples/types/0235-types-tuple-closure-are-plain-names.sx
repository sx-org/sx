// `Tuple` and `Closure` build a type only where a type is demanded — an
// annotation, a parameter, a return, or the RHS of `::`. In expression position
// they are ordinary identifiers, so a function may carry either name and is
// called without a backtick escape, in the same file whose signatures spell the
// type constructors.

@import "modules/std.sx";

NT :: Tuple(a: i64, b: bool);      // `::` RHS: a tuple alias
CB :: Closure(i32) -> i32;         // `::` RHS: a closure alias, `-> R` included

Closure :: (n: i32) -> i32 { n * 2 }
Tuple   :: (n: i64) -> i64 { n + 1 }

// Parameter and return position keep the constructors while the same-named
// functions are in scope.
swap :: (t: Tuple(i64, bool)) -> Tuple(bool, i64) { .{t.1, t.0} }

apply :: (f: CB, x: i32) -> i32 { return f(x); }

main :: () -> i32 {
    print("Closure(5)={} Tuple(5)={}\n", Closure(5), Tuple(5));

    x : NT = .{a = 1, b = true};
    print("x.a={} x.b={}\n", x.a, x.b);

    s := swap(.{7, false});
    print("s.0={} s.1={}\n", s.0, s.1);

    dbl := |v: i32| -> i32 v * 2;
    print("apply={}\n", apply(dbl, 21));
    0
}
