// Anonymous positional products: construction, element access, struct-field
// storage, and return. An inferred `:=` `.{…}` literal lowers its elements
// under their own inferred types, not the enclosing fn's return `target_type`.

@import "modules/std.sx";

PairI32 :: struct { a: i32; b: i32; }
Box :: struct { xs: PairI32; }

swap :: (a: i64, b: i64) -> (i64, i64) { return b, a; }
fst  :: (t: $T) -> i64 { @field(t, 0) }

main :: () -> i32 {
    // Inferred positional product + numeric field access.
    pair := .{40, 2};
    print("pair {} {}\n", @field(pair, 0), @field(pair, 1));

    named : struct { x: i64; y: i64 } = .{x = 10, y = 20};
    print("named {} {}\n", named.x, named.y);

    // Element into a typed local (access path, not just print).
    a : i64 = @field(pair, 0);
    b : i64 = @field(pair, 1);
    print("locals {} {}\n", a, b);

    // Product-typed struct field: store, read both elements by name.
    box : Box = ---;
    box.xs = .{a = 7, b = 9};
    print("field {} {}\n", box.xs.a, box.xs.b);

    // Multi-return from a function.
    s := swap(1, 2);
    print("ret {} {}\n", @field(s, 0), @field(s, 1));

    // Pass a positional product by value.
    print("pass {}\n", fst(.{11, 22}));

    print("eq {}\n", pair == .{40, 2});

    // Mixed-size fields: a product with both an i64 and a string (16-byte fat
    // pointer). Field types are tracked per-position, so reading each back is
    // typed correctly (i64 prints as a number, string as text).
    mixed := .{42, "hi"};
    print("mixed {} {}\n", @field(mixed, 0), @field(mixed, 1));
    0
}
