// A scalar shift's amount is a separate operand: neither the shift's
// destination nor a cast of the shift types it. A vector shift's amount takes
// the shift's destination, as a vector operator's operands do.

@import "modules/std.sx";

main :: () -> i32 {
    c := true;
    x : i64 = 3;
    v : u8 = 1 << (if c then x else 2);
    print("{}\n", v);
    print("{}\n", (1 << ({ 300 } - 295)).(u8));
    lanes : @Vector(4, u32) = .[1, 1, 1, 1];
    w : @Vector(4, u32) = lanes << .[1, 2, 3, 4];
    print("{}\n", w);
    print("{}\n", lanes << xx x);
    return 0;
}
