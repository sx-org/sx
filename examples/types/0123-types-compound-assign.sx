@import "modules/std.sx";
@import "modules/math";
@import "modules/build.sx";
@import "modules/std/test.sx";
pkg :: @import "tests/fixtures/testpkg";

main :: () {

    // ========================================================
    // 16. COMPOUND ASSIGNMENT TYPE CONVERSION
    // ========================================================
    print("=== 16. Compound Assign ===\n");
    {
        caA : f64 = 10.0;
        caB : f32 = 3.0;
        caA += caB;
        print("f64+=f32: {}\n", caA);

        caC : i64 = 100;
        caD : i32 = 7;
        caC -= caD;
        print("i64-=i32: {}\n", caC);
    }
}
