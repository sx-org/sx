// Structural product aliases: a `::` alias of an anonymous named struct
// behaves like the inline `struct { … }` form — field access, comptime
// reflection (struct_field_count / struct_field_name), use as a fn param /
// return type, alias-of-alias, forward-declared element aliases, and
// generic-instantiation elements all resolve to the same structural TypeId.
@import "modules/std.sx";

NT :: struct { a: i64; b: bool };
NT2 :: NT;

// Element referencing an alias declared LATER: registration is
// deferred past the forward-alias fixpoint, so FwdB binds i64 — never a stub.
FwdT :: struct { a: FwdB; c: bool };
FwdB :: i64;

// Generic-instantiation element: List(i64) instantiates for REAL (the same
// stateful resolver the inline annotation form uses).
TL :: struct { a: List(i64); b: string };

// The same two shapes spelled with their elements written directly — layout
// equality against these pins the deferred and stateful element resolutions.
FwdDirect :: struct { a: i64; c: bool };
TLDirect  :: struct { a: List(i64); b: string };

// Forward product-in-product chain: Inner is itself a product alias declared later.
Outer :: struct { a: Inner; c: bool };
Inner :: struct { d: i64 };

// Alias as fn param type.
sum_nt :: (t: NT) -> i64 {
    r := t.a;
    if t.b { r = r + 1; }
    return r;
}

// Alias as fn param AND return type.
bump_nt :: (p: NT) -> NT {
    return .{a = p.a + 1, b = p.b};
}

main :: () -> i32 {
    // Named alias: construction + field access by name.
    x : NT = .{a = 1, b = true};
    print("x.a={} x.b={}\n", x.a, x.b);

    // Reflection through the named alias.
    print("fcNT={} n0={} n1={}\n", struct_field_count(NT), struct_field_name(NT, 0), struct_field_name(NT, 1));

    // Alias as fn param / return type.
    print("sum={}\n", sum_nt(x));
    q := bump_nt(x);
    print("q.a={} q.b={}\n", q.a, q.b);

    // Alias-of-alias resolves to the same structural product.
    y : NT2 = .{a = 9, b = false};
    print("y.a={} fcNT2={}\n", y.a, struct_field_count(NT2));

    // Forward element alias: FwdB (declared after FwdT) is i64, not a stub —
    // the alias layout matches the direct spelling exactly.
    f : FwdT = .{a = 5, c = true};
    print("f.a={} fcFwd={} fwd_so_eq={}\n", f.a, struct_field_count(FwdT), size_of(FwdT) == size_of(FwdDirect));

    // Generic-instantiation element: field access through the instantiated
    // List works and size_of matches the direct spelling (no stub layout).
    t : TL = ---;
    t.a = .{};
    t.a.append(4);
    t.b = "hi";
    print("t.a0={} t.b={} fcTL={} tl_so_eq={}\n", t.a.items[0], t.b, struct_field_count(TL), size_of(TL) == size_of(TLDirect));

    // Forward product-in-product chain.
    n : Outer = .{a = .{d = 3}, c = true};
    print("n.a.d={} fcOuter={}\n", n.a.d, struct_field_count(Outer));
    return 0;
}
