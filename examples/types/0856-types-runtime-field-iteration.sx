// `@typeInfo` accepts a RUNTIME Type value: its record carries the member list,
// so a full metadata walk runs off a Type obtained at runtime (incl. via an
// any's tag). The record is built from the same TypeTable queries the comptime
// folds answer from, pinned by the parity lines.
@import "modules/std.sx";

Header  :: struct { magic: u16; flags: u8; }
Packet  :: struct { header: Header; name: string; kind: i16; }
Color   :: enum { red; green; blue; }

describe :: (tp: Type) {
    print("{} (size {}, align {})\n", @typeName(tp), @sizeOf(tp), @alignOf(tp));
    match @typeInfo(tp) {
        case .struct: |si| {
            i := 0;
            while i < si.fields.len {
                print("  +{} {}: {}\n", si.fields[i].offset, si.fields[i].name, @typeName(si.fields[i].type));
                i += 1;
            }
        }
        case .enum: |ei| {
            j := 0;
            while j < ei.fields.len {
                print("  .{}\n", ei.fields[j].name);
                j += 1;
            }
        }
        else: {}
    }
}

main :: () {
    describe(@typeOf(Packet{ header = .{ magic = 1, flags = 2 }, name = "x", kind = -1 }));
    describe(@typeOf(Color.red));
    av : any = Header{ magic = 7, flags = 9 };
    describe(@typeOf(av));
    // parity: runtime answers == comptime folds
    tp : Type = Packet;
    match @typeInfo(tp) {
        case .struct: |si| {
            print("parity: {} {} {}\n",
                si.fields[1].offset == @typeInfo(Packet).struct.fields[1].offset,
                si.fields[2].name == @typeInfo(Packet).struct.fields[2].name,
                @typeEq(si.fields[0].type, @typeInfo(Packet).struct.fields[0].type));
        }
        else: {}
    }
}
