// The field family accepts RUNTIME Type values: structFieldName/type/offset
// and variantName/type read master-index tables ([N x ptr] by tag → per-type
// arrays) — a full metadata walk from a Type value obtained at runtime (incl.
// via an any's tag). Layout matches the comptime folds by construction (same
// TypeTable queries), pinned by the parity lines. An index >= the member count
// is undefined behavior (the caller gates on the counts, exactly like the
// static forms).
@import "modules/std.sx";

Header  :: struct { magic: u16; flags: u8; }
Packet  :: struct { header: Header; name: string; kind: i16; }
Color   :: enum { red; green; blue; }

describe :: (tp: Type) {
    print("{} (size {}, align {})\n", @typeName(tp), @sizeOf(tp), @alignOf(tp));
    i := 0;
    while i < structFieldCount(tp) {
        print("  +{} {}: {}\n", structFieldOffset(tp, i), structFieldName(tp, i), @typeName(structFieldType(tp, i)));
        i += 1;
    }
    j := 0;
    while j < variantCount(tp) {
        print("  .{}\n", variantName(tp, j));
        j += 1;
    }
}

main :: () {
    describe(@typeOf(Packet{ header = .{ magic = 1, flags = 2 }, name = "x", kind = -1 }));
    describe(@typeOf(Color.red));
    av : any = Header{ magic = 7, flags = 9 };
    describe(@typeOf(av));
    // parity: runtime answers == comptime folds
    tp : Type = Packet;
    print("parity: {} {} {}\n",
        structFieldOffset(tp, 1) == structFieldOffset(Packet, 1),
        structFieldName(tp, 2) == structFieldName(Packet, 2),
        @typeEq(structFieldType(tp, 0), structFieldType(Packet, 0)));
}
