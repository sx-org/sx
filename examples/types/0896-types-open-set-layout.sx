// `@OpenSet` / `@OpenVariant` — an inline tagged slot whose members declare
// themselves into it (spec: Open Sets).
//
// The set states a payload CEILING and the methods every member must have. A
// member is an ordinary standalone struct — constructible, with its own layout —
// that additionally joins the set by declaring itself into it. There is no
// registry API and no enrollment statement: the declarations are the registry.
//
// `max` is a ceiling, not a reservation. The slot is laid out to the largest
// member the program declares:
//
//     payload   = max(@sizeOf(member))          — never more than `max`
//     alignment = the DECLARED align            — not a max over members
//     @sizeOf(P) = align_up(align_up(tag, align) + payload, align)
//
// so a set whose largest member is 24 bytes is 32 (8 tag + 24), whatever `max`
// says. A member is checked at its OWN declaration, which is why a type that
// cannot fit is never a member — and why importing a module with a larger member
// can grow the set (an accepted, documented cost).
@import "modules/std.sx";
@import "modules/std/list.sx";

View :: @OpenSet(.{ max = 256, align = 8 }) {
    render :: (self: *Self) -> string;
}

// The smallest member: one string.
Label :: @OpenVariant(View) {
    text: string = "";
    render :: (self: *Label) -> string => self.text;
}

// The largest declared member, so the payload is its size.
Panel :: @OpenVariant(View) {
    title: string = "";
    width: i64 = 0;
    height: i64 = 0;
    render :: (self: *Panel) -> string => self.title;
}

// A member may hold the set behind a POINTER (fixed size, whatever it points at)
// and in a list whose elements live outside the value — neither embeds the set in
// this member's own layout.
Frame :: @OpenVariant(View) {
    child: *View = ---;
    kids: List(View) = .{};
    render :: (self: *Frame) -> string => "frame";
}

// A generic member is a separate member per instantiation, measured at the
// instantiation the program materializes.
Padded :: @OpenVariant(View) ($T: Type) {
    inner: $T = ---;
    pad: i64 = 0;
    render :: (self: *Padded) -> string => "padded";
}

// A member with no `align` option of its own: the set's is what the slot uses.
Tiny :: @OpenVariant(View) {
    n: i64 = 0;
    render :: (self: *Tiny) -> string => "tiny";
}

main :: () -> i32 {
    // Every member is an ordinary value with its own size and methods.
    l := Label{ text = "hello" };
    p := Panel{ title = "panel", width = 3, height = 4 };
    t := Tiny{ n = 7 };
    pad := Padded(i64){ inner = 5 };

    print("members {} {} {} {}\n", @sizeOf(Label), @sizeOf(Panel), @sizeOf(Tiny), @sizeOf(Padded(i64)));
    print("frame {}\n", @sizeOf(Frame));
    // 8 tag + the largest member's payload, aligned to the declared 8.
    print("set {} align {}\n", @sizeOf(View), @alignOf(View));
    print("render {} {} {} {}\n", l.render(), p.render(), t.render(), pad.render());
    0
}

// ** stdout **
// members 16 32 8 16
// frame 32
// set 40 align 8
// render hello panel tiny padded
//
