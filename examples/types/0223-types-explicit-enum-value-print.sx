// Printing a payload-less enum variant that carries an EXPLICIT value
// (`K :: 7`). The formatter recovers the name by scanning the reflected
// `.fields[i].value` for the value's tag, so the name is read at the
// SEQUENTIAL ordinal `i` and never at the raw explicit value.
//
// `K :: 7` inside an enum body is an explicit-valued variant (specs.md §7,
// `esc :: '\x1b'`), not an associated constant.

@import "modules/std.sx";

// Mix of auto (A=0, B=1) and explicit (K=7) values.
E :: enum { A; B; K :: 7; }

// Every variant explicit, none coinciding with its ordinal.
F :: enum { X :: 3; Y :: 7; Z :: 11; }

main :: () {
    // Read each variant by name.
    print("{} {} {}\n", E.A, E.B, E.K);        // .A .B .K
    print("{} {} {}\n", F.X, F.Y, F.Z);        // .X .Y .Z

    // The explicit value is still readable via `xx` (unchanged).
    ek : i64 = xx E.K;
    fz : i64 = xx F.Z;
    print("{} {}\n", ek, fz);                  // 7 11

    // Round-trip through a typed local, then print.
    v : E = E.K;
    print("{}\n", v);                          // .K
}
