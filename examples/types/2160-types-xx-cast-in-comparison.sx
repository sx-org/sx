// A comparison's value is `bool`, and the expected type of that bool never
// reaches the operands: an `xx` cast inside a comparison takes its target from
// the comparison's OTHER side. So `a == xx b` reads the same in an inferred
// declaration, an `if` condition, a `bool` declaration, a `bool` argument and a
// `bool` return — each agreeing with the hoisted `t : <peer> = xx b; a == t`.

@import "modules/std.sx";

take :: (cond: bool) -> bool => cond;
ret :: (a: i32, b: i64) -> bool { a == b }

main :: () -> i32 {
    a : i32 = 5;
    b : i64 = 5;

    inferred := a == b;
    print("inferred : {}\n", inferred);

    if a == b { print("if       : true\n"); }
    else         { print("if       : false\n"); }

    typed : bool = a == b;
    print("typed    : {}\n", typed);
    print("argument : {}\n", take(a == b));
    print("return   : {}\n", ret(a, b));

    hoisted : i32 = b.(i32);
    print("hoisted  : {}\n", a == hoisted);

    // Either operand position takes the peer's type.
    lhsCast : bool = b.(i32) == a;
    print("lhs cast : {}\n", lhsCast);

    // The peer is the target, so the cast truncates to `i32` here — the
    // full-width `i64` compare would read false.
    wide : i64 = 4294967295;
    neg : i32 = -1;
    narrow : i32 = wide.(i32);
    print("truncate : {} {}\n", neg == wide.(i32), neg == narrow);

    // A float peer converts the integer operand.
    f : f32 = 2.5;
    n : i64 = 2;
    print("float    : {}\n", f > n);

    lo : i32 = -2;
    chained : bool = lo < neg == wide.(i32);
    print("chained  : {}\n", chained);
    0
}
