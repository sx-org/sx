// An open set's last member can come from the CONVERGENCE FIXPOINT (spec: Open
// Sets — when the layout is final).
//
// A member's implementation of a dispatched method is lowered when its arm is
// materialized, which happens after every ordinary body is lowered. If that body
// instantiates a generic member, the set grows there — later than any source-order
// reading of the program suggests.
//
// The set therefore freezes in a fixpoint that accounts for the growth, and every
// reader agrees afterwards: the function lowered first, the arm itself, and `main`.
@import "modules/std.sx";

Set :: @OpenSet(.{ max = 256, align = 8 }) {
    measure :: (self: *Self) -> i64;
}

Label :: @OpenVariant(Set) {
    n: i64 = 0;
    // `Padded(Big)` becomes a member HERE — while this arm is being materialized.
    measure :: (self: *Label) -> i64 {
        p := Padded(Big){ n = 0 };
        return size_of(Set) + self.n + p.n;
    }
}

Padded :: @OpenVariant(Set) ($T: Type) {
    inner: $T = ---;
    n: i64 = 0;
    measure :: (self: *Padded) -> i64 => self.n;
}

Big :: struct {
    a: i64 = 0; b: i64 = 0; c: i64 = 0; d: i64 = 0;
    e: i64 = 0; f: i64 = 0; g: i64 = 0; h: i64 = 0;
}

// Lowered long before that arm exists.
before :: () -> i64 => size_of(Set);

main :: () -> i32 {
    v: Set = Label{ n = 1 };
    print("before {} in-arm {} after {}\n", before(), v.measure(), size_of(Set));
    print("members {} {}\n", size_of(Label), size_of(Padded(Big)));
    0
}

// ** stdout **
// before 80 in-arm 81 after 80
// members 8 72
//
