// `@len(T)` — a type's part count, the count `@len` reads off a boxed value:
// struct fields, enum variants, array elements, vector lanes. A vector's lane
// count is the one length the size tables cannot answer (ABI size is
// pow2-rounded: 3 lanes occupy 4). A spelled type folds at lower time; a
// runtime `Type` reads the member-count table, where a partless kind answers
// 0; a spelled partless type is a compile error.
@import "modules/std.sx";

main :: () {
    // spelled type folds
    print("static: {}\n", @len(@Vector(3, f32)));

    // runtime tag: 3 lanes but ABI size 16 — size/elem_size would say 4
    v : @Vector(3, f32) = .[1.0, 2.0, 3.0];
    av : any = v;
    t := @typeOf(av);
    print("runtime: {} (size {})\n", @len(t), @sizeOf(t));

    // parity: runtime table == static fold
    print("parity: {}\n", @len(t) == @len(@Vector(3, f32)));

    // exact-fit and wide vectors
    w : @Vector(8, u8) = .[1, 2, 3, 4, 5, 6, 7, 8];
    aw : any = w;
    print("w8: {}\n", @len(@typeOf(aw)));

    // a partless runtime tag answers 0
    x := 5;
    ax : any = x;
    print("nonvec: {}\n", @len(@typeOf(ax)));

    // comptime VM parity
    K :: @run @len(@Vector(4, i32));
    print("comptime: {}\n", K);
}
