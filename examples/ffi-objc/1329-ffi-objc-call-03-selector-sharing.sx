// Multiple `@ObjcCall` sites with the same selector: each site emits
// its own `call @sel_registerName(<"init">)`, so the SEL handle is
// recomputed per call.
//
// The IR snapshot at
// `tests/expected/ffi-objc-call-03-selector-sharing.ir` locks
// that shape in (4 `call ptr @sel_registerName` instructions,
// one per call site) plus
// a static `@OBJC_SELECTOR_REFERENCES_<sel>` global and loads at
// the call sites.

@import "modules/std.sx";
@import "modules/build.sx";

main :: () -> i32 {
    inline if @host.os == .macos {
        // Three calls, same selector, same nil receiver. These
        // emit three `sel_registerName("init")` calls. After 1.5 the
        // emit collapses to one (cached SEL global).
        @ObjcCall(void, null, "init");
        @ObjcCall(void, null, "init");
        @ObjcCall(void, null, "init");

        // A different selector — should remain distinct after 1.5
        // (one cached SEL per unique string, not per call site).
        @ObjcCall(void, null, "release");

        print("ok\n");
    }
    inline if @host.os != .macos {
        print("skipped (not macos)\n");
    }
    0
}
