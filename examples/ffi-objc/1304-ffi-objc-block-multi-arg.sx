// `blockCreate` at an arbitrary block signature. The comptime builder emits the
// `abi(.c)` trampoline matching `void (^)(int, void*)` — the shape Apple's
// runtime calls — and forwards both arguments to the sx callable.

@import "modules/std.sx";
@import "modules/ffi/objc_block.sx";

// Side-effect capture so we can observe both args reached the
// callable body.
gSum: i32 = 0;
gTag: *void = null;

main :: () -> i32 {
    record :: (n: i32, tag: *void) { gSum = n + 1; gTag = tag; }
    b := blockCreate(record);

    invokeFn : (*Block, i32, *void) -> void abi(.c) = b.invoke.((*Block, i32, *void) -> void abi(.c));
    sentinel: i32 = 42;
    invokeFn(b, 41, *sentinel);

    if gSum != 42 { print("FAIL: gSum expected 42, got {}\n", gSum); return 1; }
    if gTag == null { print("FAIL: gTag null\n"); return 1; }

    print("block multi-arg ok: sum={}\n", gSum);
    blockRelease(b);
    0
}
