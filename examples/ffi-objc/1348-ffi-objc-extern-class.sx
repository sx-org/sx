// Postfix `extern` on an aggregate (`@ObjcClass`) imports the class.
// Mirrors 1306's runtime-class chained dispatch:
//   Name :: @ObjcClass("X") extern { … }   ==   Name :: @ObjcClass(…) extern("X") { … }

#import "modules/std.sx";
#import "modules/build.sx";

NSObject :: @ObjcClass("NSObject") extern {
    alloc :: () -> *NSObject;
    init :: (self: *Self) -> *Self;
}

main :: () -> i32 {
    inline if OS == .macos {
        a := NSObject.alloc().init();
        if a != null {
            print("extern-class dispatch ok\n");
        }
    }
    inline if OS != .macos {
        print("extern-class dispatch ok\n");
    }
    0
}
