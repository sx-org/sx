// Keyword count must equal call-site arity (excluding
// self). `something_extra(x)` — name split gives ["something", "extra"]
// = 2 keywords; arity = 1. Compiler must diagnose at the call site.
//
// The diagnostic names the mismatch: the keyword count derived from the
// method name against the arity the call site supplies.
//
#import "modules/std.sx";
#import "modules/build.sx";

SxProbeMismatch :: @ObjcClass("SxProbeMismatch") extern {
    something_extra :: (self: *Self, x: i32) -> i32;
}

main :: () -> i32 {
    inline if OS == .macos {
        inst : *SxProbeMismatch = null;
        n := inst.something_extra(7);
        print("n = {}\n", n);
    }
    inline if OS != .macos {
        print("skipped (not macos)\n");
    }
    0
}
