// An `@ObjcClass` method whose return type is a type-alias chain to a
// builtin (`MYB2 :: MYB; MYB :: i8`) accepts an integer literal when the
// class sits in a taken `inline if` and the alias module is also imported
// at the enclosing module.

@import "modules/std.sx";

inline if true {
    @import "modules/ffi/objc.sx";
    @import "2210-ffi-objc-chained-alias-return/aliases.sx";
    ChainAliasHost :: @ObjcClass("ChainAliasHost", extends = NSObject) export {
        yes :: (self: *Self) -> MYB2 {
            return 1;
        }
    }
}

@import "2210-ffi-objc-chained-alias-return/aliases.sx";

main :: () {
    print("ok\n");
}
