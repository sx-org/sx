// Multi-instance allocator threading.
//
// EACH sx-defined-class instance captures its OWN allocator and
// round-trips through it: the capture lives in that instance's state
// struct (not one global slot), every instance's alloc captures the
// allocator live at its own call, and each dealloc reads its own
// state[0].
//
// Three instances → three alloc events → three dealloc events. The
// tracker observes exactly +3 / +3 deltas.

@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/ffi/objc.sx";
@import "modules/build.sx";

SxMultiProbe :: @ObjcClass("SxMultiProbe", extends = NSObject) {
    a: i32;
    b: i32;
    alloc :: () -> *SxMultiProbe;
}

main :: () -> i32 {
    inline if @host.os == .macos {
        gpa := GPA.init();
        tracker := TrackingAllocator.init(gpa);

        push .{ allocator = tracker } {
            allocBefore   := tracker.allocCount;
            deallocBefore := tracker.deallocCount;

            f1 := SxMultiProbe.alloc();
            f2 := SxMultiProbe.alloc();
            f3 := SxMultiProbe.alloc();

            allocAfterThree := tracker.allocCount - allocBefore;

            f1.release();
            f2.release();
            f3.release();

            allocDelta   := tracker.allocCount   - allocBefore;
            deallocDelta := tracker.deallocCount - deallocBefore;

            // allocDelta MAY include extras from autorelease/etc. but
            // each SxMultiProbe.alloc contributes at least 1. Check the
            // BALANCE: every alloc paired with a dealloc.
            if deallocDelta != allocDelta {
                print("FAIL: alloc/dealloc unbalanced; alloc={} dealloc={}\n",
                      allocDelta, deallocDelta);
                return 1;
            }
            if allocAfterThree < 3 {
                print("FAIL: 3 SxMultiProbe.alloc()s should produce >= 3 tracker allocs; saw {}\n",
                      allocAfterThree);
                return 1;
            }
            if deallocDelta < 3 {
                print("FAIL: 3 release()s should produce >= 3 tracker deallocs; saw {}\n",
                      deallocDelta);
                return 1;
            }
        }

        print("multi-instance round-trip: ok\n");
    }
    inline if @host.os != .macos {
        print("skipped (not macos)\n");
    }
    0
}
