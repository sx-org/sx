// All-double HFA returns through `@ObjcCall`. 4×f64 = 32 B, staying in
// v0..v3 on AAPCS64 and xmm0..xmm3 on SysV AMD64 — the UIEdgeInsets /
// NSRect / CGRect shape, where an f32-vs-f64 slip mis-reads every field.
//
// ffi-objc-call-05's nil-recv NSRect case only checks that zeros come
// back. This installs a real IMP returning specific non-zero values and
// verifies each field comes through the float-register file intact.

@import "modules/std.sx";
@import "modules/build.sx";
@import "modules/ffi/objc.sx";

UIEdgeInsets :: struct {
    top: f64;
    left: f64;
    bottom: f64;
    right: f64;
}

insetsImp :: (self: *void, _cmd: *void) -> UIEdgeInsets abi(.c) {
    UIEdgeInsets{ top = 1.5, left = 2.5, bottom = 3.5, right = 4.5 }
}

main :: () -> i32 {
    inline if @host.os == .macos {
        nsObject := objc_getClass("NSObject".ptr);
        myCls := objc_allocateClassPair(nsObject, "SxInsetsProbe".ptr, 0);
        sel := sel_registerName("safeAreaInsets".ptr);
        // Method type encoding: {UIEdgeInsets=dddd}@: → returns 4×f64,
        // implicit (self: id, _cmd: SEL). `d` = double.
        ok := class_addMethod(myCls, sel, xx insetsImp, "{UIEdgeInsets=dddd}@:".ptr);
        print("addMethod = {}\n", ok);
        objc_registerClassPair(myCls);

        instance := class_createInstance(myCls, 0);
        ins := @ObjcCall(UIEdgeInsets, instance, "safeAreaInsets");
        print("insets = ({}, {}, {}, {})\n", ins.top, ins.left, ins.bottom, ins.right);
    }
    inline if @host.os != .macos {
        print("skipped (not macos)\n");
    }
    0
}
