// `@ObjcProperty(weak)` on a sx-defined class.
//
// Weak contract:
// - setter calls objc_storeWeak — does NOT retain.
// - getter calls objc_loadWeakRetained + autorelease — auto-nils
//   if the target has been deallocated.
// - -dealloc calls objc_destroyWeak on each weak ivar.
//
// Observation: assign a target to the weak property. Drop the
// caller's strong reference. Read back via the weak getter — the read
// is `null`, because the target deallocated when its last strong ref
// dropped and the weak slot auto-niled. Comparing the read result to
// null is what makes the auto-nil observable.

@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/ffi/objc.sx";
@import "modules/build.sx";

SxWeakTarget :: @ObjcClass("SxWeakTarget", extends = NSObject) {
    tag: i32;
    alloc :: () -> *SxWeakTarget;
}

SxWeakHolder :: @ObjcClass("SxWeakHolder", extends = NSObject) {
    target: @ObjcProperty(*SxWeakTarget, ownership = weak);
    alloc :: () -> *SxWeakHolder;
}

main :: () -> i32 {
    inline if @host.os == .macos {
        gpa := GPA.init();
        tracker := TrackingAllocator.init(gpa);

        push .{ allocator = tracker } {
            holder := SxWeakHolder.alloc();
            target := SxWeakTarget.alloc();
            holder.target = target;
            target.release();

            // After release: target's refcount → 0 → target deallocates.
            // With weak: holder.target should read as null (auto-niled).
            // Without weak: holder.target reads as the stale pointer.
            read_back := holder.target;
            if read_back != null {
                print("FAIL: weak property didn't auto-nil after target dealloc\n");
                return 1;
            }

            holder.release();
        }

        print("weak property: ok\n");
    }
    inline if @host.os != .macos {
        print("skipped (not macos)\n");
    }
    0
}
