// `nsstring` is total over `string`: it copies exactly `s.len` bytes, so a
// slice of a larger buffer — which has no NUL at `len` — converts to just its
// own bytes.
@import "modules/std.sx";
@import "modules/build.sx";
@import "modules/ffi/objc.sx";

cstrLen :: (p: [*]u8) -> i64 {
    n := 0;
    while p[n] != 0 {
        n += 1;
    }
    n
}

show :: (label: string, ns: *NSString) {
    back := ns.UTF8String();
    s : string = ---;
    s.ptr = back;
    s.len = cstrLen(back);
    print("{}: \"{}\" len {}\n", label, s, s.len);
}

main :: () -> i32 {
    inline if @host.os == .macos {
        autoreleasepool(|| {
            src := "hello world";
            show("sliced", nsstring(src[0..5]));
            show("literal", nsstring("hello world"));
            show("empty", nsstring(""));
            show("tail", nsstring(src[6..11]));
        });
    }
    inline if @host.os != .macos {
        print("skipped (not macos)\n");
    }
    0
}
