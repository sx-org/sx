// The `@ObjcCall` shape `@ObjcCall(ReturnT, receiver, "selector:", args...)`
// parses — return type in the first parens, then a normal call. Parse-only.

@import "modules/std.sx";

main :: () -> i32 {
    // `@ObjcCall(void)` with a null receiver — never executed; the
    // `inline if false` arm keeps the node in the AST.
    inline if false {
        @ObjcCall(void, null, "init");
    }
    print("parse-only ok\n");
    0
}
