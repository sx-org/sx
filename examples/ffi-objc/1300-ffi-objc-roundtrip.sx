// objc_msgSend dispatches through a signature matching the selector ABI.

@import "modules/std.sx";
@import "modules/ffi/objc.sx";

main :: () -> i32 {
    nsClass      := objc_getClass("NSString".ptr);
    selWithUtf8  := sel_registerName("stringWithUTF8String:".ptr);
    selUtf8      := sel_registerName("UTF8String".ptr);

    msg3 : (*void, *void, [*]u8) -> *void abi(.c) = @reinterpret((*void, *void, [*]u8) -> *void abi(.c), objc_msgSend);
    nsStr := msg3(nsClass, selWithUtf8, "hi".ptr);

    msg2 : (*void, *void) -> [*]u8 abi(.c) = @reinterpret((*void, *void) -> [*]u8 abi(.c), objc_msgSend);
    back := msg2(nsStr, selUtf8);

    return (back[0] + back[1]); // 'h' + 'i' = 104 + 105 = 209
}
