// Two classes that `extends =` each other have no root; the declaration
// closing the cycle is refused at its `extends =` alias.
@import "modules/std.sx";
@import "modules/ffi/objc.sx";

SxCycA :: @ObjcClass("SxCycA", extends = SxCycB) export {
    alloc :: () -> *SxCycA;
}

SxCycB :: @ObjcClass("SxCycB", extends = SxCycA) export {
    alloc :: () -> *SxCycB;
}

main :: () -> i32 { 0 }
