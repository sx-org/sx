// `@ObjcCall` inside an
// `inline if @host.os == .ios { ... }` arm cross-compiles cleanly to
// Android. The comptime gate strips the arm BEFORE the
// `objc_msg_send` lowering runs, so no call to `@objc_msgSend` /
// `@sel_registerName` — symbols absent from Bionic + libGLESv3 —
// reaches the linker.
//
// On macOS the iOS arm is also stripped (the host is not iOS) so the
// runtime test just prints "host stripped both", proving the
// `inline match @host.os` form works around `@ObjcCall`
// sites the same way it does elsewhere.

@import "modules/std.sx";
@import "modules/build.sx";

// Empty stub class — Android cross-compile requires a `main = true`
// declaration to satisfy the entry-point check. This file is testing
// `inline if @host.os` gating around `@ObjcCall`, not Activity wiring.
SxObjcOsGateStub :: @JniClass("co/swipelab/sxobjcosgate/SxObjcOsGateStub", main = true) {}

main :: () -> i32 {
    inline match @host.os {
        case .ios: {
            // Stripped on macOS + Android. Compiled on iOS / ios-sim.
            @ObjcCall(void, null, "init");
            print("ios path\n");
        }
        case .android: {
            // Stripped on macOS + iOS. Compiled on Android.
            // Nothing @ObjcCall-shaped here — just text — so we
            // exercise the gate symmetrically across targets.
            print("android path\n");
        }
        else: {
            print("host stripped both\n");
        }
    }
    0
}
