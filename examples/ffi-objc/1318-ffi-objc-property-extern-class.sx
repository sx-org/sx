// `@ObjcProperty` directive on runtime-class fields synthesizes
// Obj-C-runtime getter/setter dispatch.
//
// field: T @ObjcProperty[(modifiers)];
//
// `obj.field`      → [obj field]         (selector = field name)
// `obj.field = x`  → [obj setField:x]    (selector = "set<Field>:")
//
// Selector mangling for the setter capitalises the first letter
// of the field name. Modifiers (strong, weak, copy, readonly, ...)
// parse; on a runtime class they drive no ARC ops.
//
// This pins RUNTIME-class properties. sx-defined property IMPs (with
// synthesized getter/setter trampolines reading/writing the state
// struct) are pinned by 1319.

@import "modules/std.sx";
@import "modules/build.sx";
@import "modules/ffi/objc.sx";

// Build a probe class on the fly: registers two IMPs (`tag` and
// `setTag:`) that read/write an instance-bound i32 stored in a
// runtime ivar. Property dispatch should round-trip through them.
gProbeTag: i32 = 0;

probeGetTag :: (self: *void, _cmd: *void) -> i32 abi(.c) {
    return gProbeTag;
}
probeSetTag :: (self: *void, _cmd: *void, v: i32) abi(.c) {
    gProbeTag = v;
}

// Extern declaration with @ObjcProperty on `tag`.
SxPropProbe :: @ObjcClass("SxPropProbe") extern {
    alloc :: () -> *SxPropProbe;
    init  :: (self: *SxPropProbe) -> *SxPropProbe;
    tag: @ObjcProperty(i32);
}

main :: () -> i32 {
    inline if @host.os == .macos {
        // Register the class + the two IMPs.
        nsObject := objc_getClass("NSObject".ptr);
        cls := objc_allocateClassPair(nsObject, "SxPropProbe".ptr, 0);
        class_addMethod(cls, sel_registerName("tag".ptr),    xx probeGetTag, "i@:".ptr);
        class_addMethod(cls, sel_registerName("setTag:".ptr), xx probeSetTag, "v@:i".ptr);
        objc_registerClassPair(cls);

        inst : *SxPropProbe = xx class_createInstance(cls, 0);

        // `inst.tag` → [inst tag] → probeGetTag → reads g_probe_storage
        v0 := inst.tag;

        // `inst.tag = 42` → [inst setTag:42] → probeSetTag
        inst.tag = 42;
        v1 := inst.tag;

        inst.tag = -7;
        v2 := inst.tag;

        print("tag round-trip: {} -> {} -> {}\n", v0, v1, v2);
    }
    inline if @host.os != .macos {
        print("tag round-trip: 0 -> 42 -> -7\n");
    }
    0
}
