// An untagged union is a nominal conformer: `impl Show for U` is the impl,
// and `$T/Show` asks that question.
@import "modules/std.sx";

Show :: constraint { show :: (self: *Self) -> string; }

U :: union { a: i64; b: f64; }

impl Show for U {
    show :: (self: *U) -> string { "u" }
}

f :: (x: $T/Show) -> i64 { 1 }

main :: () {
    u : U = ---;
    u.a = 1;
    print("{}\n", f(u));
}
