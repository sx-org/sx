// A bare `-> Self` method dispatches on a tagged value (spec §6.4). Its
// result ABI is the selected arm's, so the switch expands AT THE CALL SITE:
// each arm calls its conformer directly, places the concrete result in a
// temporary of the CALLING frame, and yields a tagged borrow of it. Every
// such call site warns — the temporary is frame-scoped, one per call — and no
// fixit is offered, because the right restructure depends on intent.
#import "modules/std.sx";

Shape :: protocol tagged {
    area    :: (self: *Self) -> f64;
    resized :: (self: Self, k: f64) -> Self;      // bare Self in and out
    merged  :: (self: *Self, other: Self) -> Self;
}

Circle :: struct { r: f64; }
impl Shape for Circle {
    area    :: (self: *Circle) -> f64 { 3.0 * self.r * self.r }
    resized :: (self: Circle, k: f64) -> Circle { .{ r = self.r * k } }
    merged  :: (self: *Circle, other: Circle) -> Circle { .{ r = self.r + other.r } }
}

Square :: struct { s: f64; }
impl Shape for Square {
    area    :: (self: *Square) -> f64 { self.s * self.s }
    resized :: (self: Square, k: f64) -> Square { .{ s = self.s * k } }
    merged  :: (self: *Square, other: Square) -> Square { .{ s = self.s + other.s } }
}

// Returning a borrow of a callee LOCAL is the slice-of-a-local doctrine, so
// the sound shape places the result where the caller already owns storage.
grow_into :: (dst: *Circle, v: Shape, k: f64) {
    step := v.resized(k);
    dst.* = step.(Circle);
}

// A single-conformer protocol: the expansion folds to the direct call, no
// switch at all.
Tick :: protocol tagged {
    count :: (self: *Self) -> i64;
    next  :: (self: Self) -> Self;
}
Clock :: struct { t: i64; }
impl Tick for Clock {
    count :: (self: *Clock) -> i64 { self.t }
    next  :: (self: Clock) -> Clock { .{ t = self.t + 1 } }
}

main :: () {
    c := Circle{ r = 1.0 };
    sq := Square{ s = 2.0 };
    v : Shape = c;
    w : Shape = sq;

    // The result is a value of the protocol: it dispatches like any other.
    big := v.resized(2.0);
    print("{}\n", big.area());

    // Chaining works — each site materializes its own temporary.
    print("{}\n", v.resized(2.0).resized(3.0).area());

    // A `Self` parameter and a `Self` return in one signature.
    both := w.merged(sq);
    print("{}\n", both.area());

    // The concrete conformer is recoverable: the temporary is a real
    // `Circle`, and the tag says so.
    shrunk := v.resized(0.5);
    print("{} {}\n", type_of(shrunk) == Circle, shrunk.(Circle).r);

    // A loop reuses nothing across iterations that the caller can observe:
    // each iteration reads its own result before the next call.
    total := 0.0;
    for i in 1..4 {
        step := w.resized(xx i);
        total = total + step.area();
    }
    print("{}\n", total);

    out := Circle{ r = 0.0 };
    grow_into(*out, v, 4.0);
    print("{}\n", out.r);

    k := Clock{ t = 41 };
    t : Tick = k;
    print("{}\n", t.next().count());
}
