// issue 0329: a parameterized protocol instance is keyed by the protocol
// DECLARATION's identity, not by its spelling. Two modules author `P($T)` with
// different method sets; each module's own erasure and each qualified `P(i64)`
// head must reach its own instance type, impl set, thunks and vtable.
#import "modules/std.sx";
a :: #import "0901-protocols-param-protocol-author-identity/a.sx";
b :: #import "0901-protocols-param-protocol-author-identity/b.sx";

report :: (label: string, ok: bool) {
    if ok { print("{}: ok\n", label); } else { print("{}: FAIL\n", label); }
}

main :: () -> i32 {
    report("a own dispatch", a.own_tag() == 101);
    report("b own dispatch", b.own_first() == 7 and b.own_tag() == 201);

    pa : a.P(i64) = xx a.Cell.{ v = 2 };
    pb : b.P(i64) = xx b.Cell.{ v = 2 };
    report("qualified a head", pa.tag() == 102);
    report("qualified b head", pb.first() == 7 and pb.tag() == 202);
    0
}
