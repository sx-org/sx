@import "modules/std.sx";
@import "modules/std/mem.sx";

Sizable :: interface {
    size :: (self: *Self) -> i64;
}

Leaf :: struct { value: i64; }
impl Sizable for Leaf {
    size :: (self: *Leaf) -> i64 { self.value }
}

add :: (items: *List(Sizable), w: Leaf) {
    items.append(mem.make(context.allocator, w));
}

dispatchFn :: (items: *List(Sizable)) {
    @printf("dispatchFn: about to dispatch\n");
    s := items.items[0].size();
    print("dispatchFn: result = {}\n", s);
}

main :: () -> void {
    items : List(Sizable) = .{};
    add(*items, Leaf{ value = 42 });

    // Direct dispatch twice
    @printf("=== Direct 1 ===\n");
    r1 := items.items[0].size();
    print("r1 = {}\n", r1);

    @printf("=== Direct 2 ===\n");
    r2 := items.items[0].size();
    print("r2 = {}\n", r2);

    // Then from function
    @printf("=== From function ===\n");
    dispatchFn(*items);
    @printf("=== OK ===\n");
}
