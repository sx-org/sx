// Right author of the same display name, with a different conformer. Nothing
// about the spelling is shared with the left module's family.
#import "modules/std.sx";

Series :: protocol(T: Type) tagged { at :: (self: *Self, i: i64) -> T; }

RightCell :: struct { v: i64; }
impl Series(i64) for RightCell { at :: (self: *RightCell, i: i64) -> i64 { self.v * i } }

right_at :: (s: Series(i64), i: i64) -> i64 { s.at(i) }
right    :: () -> i64 { c := RightCell.{ v = 10 }; right_at(c, 3) }
