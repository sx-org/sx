// Direct `Self` positions on a TEMPLATED tagged protocol. Each canonical
// argument tuple is its own protocol with its own conformer set and tag space
// (§6.7), so a `Self` parameter and a `-> Self` return are resolved per
// instantiation: the tag check compares within one space, and the call-site
// switch expands over that instantiation's members only. Blanket impls
// contribute members the same way.
#import "modules/std.sx";

Scale :: protocol(T: Type) tagged {
    value  :: (self: *Self) -> T;
    scaled :: (self: Self, k: T) -> Self;
    equal  :: (self: *Self, other: Self) -> bool;
}

Cell :: struct($T: Type) { v: $T; }
impl Scale($T) for Cell($T) {
    value  :: (self: *Cell) -> $T { self.v }
    scaled :: (self: Cell, k: $T) -> Cell { .{ v = self.v * k } }
    equal  :: (self: *Cell, other: Cell) -> bool { self.v == other.v }
}

Fixed :: struct { n: i64; }
impl Scale(i64) for Fixed {
    value  :: (self: *Fixed) -> i64 { self.n }
    scaled :: (self: Fixed, k: i64) -> Fixed { .{ n = self.n * k } }
    equal  :: (self: *Fixed, other: Fixed) -> bool { self.n == other.n }
}

// The conformer of one instantiation is reached only through that
// instantiation's own dispatch.
twice :: (s: Scale(i64)) -> i64 {
    d := s.scaled(2);
    d.value()
}

main :: () {
    f := Fixed{ n = 5 };
    ci := Cell(i64){ v = 3 };
    cf := Cell(f64){ v = 1.5 };

    a : Scale(i64) = f;
    b : Scale(i64) = ci;
    c : Scale(f64) = cf;

    print("{} {}\n", twice(a), twice(b));

    // `-> Self` in the f64 space: a different set, a different tag space.
    d := c.scaled(4.0);
    print("{}\n", d.value());

    // The tag check is per instantiation: two `Cell(i64)` handles agree,
    // and a `Fixed` handle is a different conformer of the SAME space.
    ci2 := Cell(i64){ v = 3 };
    b2 : Scale(i64) = ci2;
    print("{}\n", b.equal(b2));
    print("{}\n", a.equal(f));
}
