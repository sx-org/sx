// The third driver class the worklist owns: comptime reached by the
// monomorphization of an open set's arm.
//
// Nothing calls `Box.draw` directly — its body is written when the convergence
// fixpoint materializes `Draw`'s arm for that member. The `@insert` in that body
// therefore runs from INSIDE a drained round, and what it reaches — an erasure
// into a protocol — is lowered there too, so the round re-registers and the drain
// continues until nothing new is reached.
@import "modules/std.sx";

Draw :: @OpenSet(.{ max = 64, align = 8 }) { draw :: (self: *Self) -> i64; }
Mark :: interface { mark :: (self: *Self) -> i64; }

Dot :: struct { n: i64; }
impl Mark for Dot { mark :: (self: *Dot) -> i64 { self.n * 3 } }

// Reached only from the arm body below, so it is evaluated while the fixpoint
// is running — and it dispatches through `Mark`.
tally :: () -> string {
    d := Dot{ n = 2 };
    m : *Mark = d;
    if m.mark() == 6 { return "bonus := 10;"; }
    return "bonus := 0;";
}

Box :: @OpenVariant(Draw) {
    n: i64 = 0;
    draw :: (self: *Box) -> i64 {
        @insert tally();
        return self.n + bonus;
    }
}

main :: () {
    d : Draw = Box{ n = 1 };
    print("{}\n", d.draw());
}
