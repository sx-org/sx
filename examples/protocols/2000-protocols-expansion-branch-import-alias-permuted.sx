// The same program as 1999, written in the other order.
//
// Read first, the reader waits on the import's counted surface; imported
// first, it waits on the module's own driver, which the splice registered as
// it handed the module over. The wait is on a different ledger entry each
// time, and the answer is the same one.
#import "modules/std.sx";
#import "./1999-protocols-expansion-branch-import-alias-kinds.sx";

inline if has_impl(Mark, Slot) { ADMITTED :: 1; } else { ADMITTED :: 0; }

inline if POINTER_SIZE == 8 {
    alias :: #import "./1999-protocols-expansion-branch-import-alias-mod.sx";
} else {
    NARROW :: 1;
}

main :: () {
    s := Slot{ n = 2 };
    m := s.(Mark, context.allocator);
    print("{} {}\n", ADMITTED, m.tag());
}
