// What an impl question owes the discipline, per kind (§7.9).
//
// Impls are DECLARATIONS, so an undecided driver that mentions `impl P for …`
// is what any answer about `P` waits on. Which POLARITY owes that wait differs
// by kind. A `constraint` partition only ever grows: a visible impl is a fact
// no later declaration can take back, so a positive is readable on the spot.
// An ERASED target reads impl MULTIPLICITY — the conversion resolves through
// the program-unique impl (§7.4) — and multiplicity is monotone in neither
// direction: a later impl repairs a miss exactly as readily as it destroys a
// unique success. So BOTH of its polarities wait.
//
// Every answer below is asked while the unroll that could change it is still
// undecided, and folded only once that unroll retired.
#import "modules/std.sx";

Show :: protocol vtable { fmt :: (self: *Self) -> i64; }
Ord :: protocol constraint { cmp :: (self: *Self, o: *Self) -> i64; }

Item :: struct { n: i64; }
Note :: struct { n: i64; }

impl Show for Note { fmt :: (self: *Note) -> i64 { self.n } }
impl Ord for Note { cmp :: (self: *Note, o: *Note) -> i64 { self.n - o.n } }

// Erased, a MISS right now — the unroll repairs it.
inline if has_impl(Show, Item) { REPAIRED :: 1; } else { REPAIRED :: 0; }
// Erased, a program-unique HIT right now — still held until nothing can add a
// second `impl Show for Note`.
inline if has_impl(Show, Note) { UNIQUE :: 1; } else { UNIQUE :: 0; }
// Constraint, a HIT: answered immediately, though `Ord` is just as open.
inline if has_impl(Ord, Note) { PARTITION :: 1; } else { PARTITION :: 0; }

SHAPES :: .[Item];
inline for T in SHAPES {
    impl Show for T { fmt :: (self: *T) -> i64 { self.n * 3 } }
    impl Ord for T { cmp :: (self: *T, o: *T) -> i64 { self.n - o.n } }
}

main :: () {
    i := Item{ n = 2 };
    s := i.(Show, context.allocator);
    print("{} {} {} {}\n", REPAIRED, UNIQUE, PARTITION, s.fmt());
}
