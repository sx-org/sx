// Owning protocol erase funds from `context.allocator`. `dog.(Speaker)` is
// legal; `dog.(Speaker, alloc)` names another fund.
@import "modules/std.sx";
@import "modules/std/mem.sx";

Speaker :: protocol vtable {
    speak :: (self: *Self) -> i64;
}

Dog :: struct { n: i64 }

impl Speaker for Dog {
    speak :: (self: *Dog) -> i64 { self.n }
}

main :: () {
    dog := Dog{ n = 3 };
    shape := dog.(Speaker);
    print("{}\n", shape.speak());
    free(shape);
}
