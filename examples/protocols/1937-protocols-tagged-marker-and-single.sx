// Two ends of the ladder. A MARKER tagged protocol (empty body) erases like
// any other — downcast and the type switch are its whole interface. A
// SINGLE-conformer tagged protocol devirtualizes completely inside its
// dispatch routine: one member means one arm, so the outlined switch folds
// to a direct call.
#import "modules/std.sx";

// Marker: no methods at all, so the set membership IS the information.
Tracked :: protocol tagged { }

Node :: struct { id: i64; }
impl Tracked for Node { }
Edge :: struct { from: i64; to: i64; }
impl Tracked for Edge { }

// Single conformer: the set has exactly one member for the whole program.
Clock :: protocol tagged { now :: (self: *Self) -> i64; }
Steady :: struct { t: i64; }
impl Clock for Steady { now :: (self: *Steady) -> i64 { self.t * 2 } }

kind_of :: (t: Tracked) -> string {
    if t == {
        case Node: { return "node"; }
        case Edge: { return "edge"; }
    }
    "?"
}

tick :: (c: Clock) -> i64 { c.now() }

main :: () {
    n := Node.{ id = 1 };
    e := Edge.{ from = 1, to = 2 };
    print("{} {}\n", kind_of(n), kind_of(e));

    // The marker still carries full RTTI and a downcast.
    tn : Tracked = n;
    print("{} {}\n", type_name(type_of(tn)), tn.(Node).id);
    print("{}\n", size_of(Tracked));

    s := Steady.{ t = 21 };
    print("{}\n", tick(s));
    c : Clock = s;
    print("{} {}\n", c.now(), c.(Steady).t);
}
