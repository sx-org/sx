// A protocol method-signature concrete return type resolves SOURCE-AWARE, so a
// genuinely ambiguous same-name type poisons LOUDLY at the protocol
// declaration rather than silently picking a global `findByName` last-wins
// author. `main` flat-imports two `Box` authors and declares none itself, so
// the `Provider.get` return `Box` is an unresolvable collision and the build
// exits 1.

@import "modules/std.sx";
@import "0821-protocols-same-name-method-ambiguous/a.sx";
@import "0821-protocols-same-name-method-ambiguous/b.sx";

Provider :: constraint {
    get :: (self: *Self) -> Box;
}

main :: () -> i32 {
    0
}
