// Left author of the display name `Series` — its own protocol family, its own
// conformer, and (once instantiated) its own tag space.
#import "modules/std.sx";

Series :: protocol(T: Type) tagged { at :: (self: *Self, i: i64) -> T; }

LeftCell :: struct { v: i64; }
impl Series(i64) for LeftCell { at :: (self: *LeftCell, i: i64) -> i64 { self.v + i } }

left_at :: (s: Series(i64), i: i64) -> i64 { s.at(i) }
left    :: () -> i64 { c := LeftCell{ v = 10 }; left_at(c, 1) }
