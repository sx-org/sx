// A comptime protocol value that escapes into the image resolves per its
// referent (specs.md §6.9). A referent that IS a declared global relocates to
// that global's symbol: nothing is copied, the image keeps the global's own
// initializer — so compile-time mutations of it vanish — and the referent stays
// exactly as mutable at runtime as it was written.
//
// The escape is also a VALUE USE of the instantiation: `View` is named nowhere
// else in runtime code, and its dispatch machinery exists anyway because the
// escaped handle carries one of its conformers.
@import "modules/std.sx";

View :: interface {
    area :: (self: *Self) -> i64;
}

Widget :: struct { n: i64; }
Native :: struct { n: i64; }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n * 10 } }
impl View for Native { area :: (self: *Native) -> i64 { self.n + 1 } }

gWidget := Widget{ n = 4 };
gNative := Native{ n = 100 };

// The comptime mutation is execution-local: it lands on the VM's own copy of
// the global, which is discarded with the evaluation.
pickWidget :: () -> View {
    gWidget.n = 99;
    return gWidget;
}

// Two evaluations that diverged on the same global both relocate to the one
// symbol, and neither state wins — the global's declared initializer does.
pickNative :: () -> View {
    gNative.n = -1;
    return gNative;
}

// An instantiation whose ONLY value use in runtime code is the escape itself:
// nothing dispatches through `Slot`, and its type record exists — the RTTI read
// below answers through it — because the escaped handle carries a conformer.
Slot :: interface { id :: (self: *Self) -> i64; }
Anchor :: struct { k: i64; }
impl Slot for Anchor { id :: (self: *Anchor) -> i64 { self.k } }
gAnchor := Anchor{ k = 9 };
pickSlot :: () -> Slot { return gAnchor; }

W :: @run pickWidget();
N :: @run pickNative();
S :: @run pickSlot();

main :: () {
    print("{} {}\n", W.area(), gWidget.n);
    print("{} {}\n", N.area(), gNative.n);

    // The relocated referent is the global itself: a runtime write through the
    // name is a write through the escaped handle.
    gWidget.n = 7;
    gNative.n = 41;
    print("{} {}\n", W.area(), N.area());

    print("{}\n", @typeName(@typeOf(S)));
}
