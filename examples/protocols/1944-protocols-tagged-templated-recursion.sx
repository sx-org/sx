// A conformer of `Series(T)` may itself hold `Series(T)` values: the 16-byte
// handle is the indirection, so no size equation arises and the collection
// fixpoint converges with the recursive shape in the set. Admitting `Scaled`
// reaches the instantiations its fields mention, which is how a chain of
// handles materializes each space it touches.
#import "modules/std.sx";

Series :: protocol(T: Type) tagged {
    count :: (self: *Self) -> i64;
    at    :: (self: *Self, i: i64) -> T;
}

Buffer :: struct($T: Type) { items: []$T; }
impl Series($T) for Buffer($T) {
    count :: (self: *Buffer) -> i64 { self.items.len }
    at    :: (self: *Buffer, i: i64) -> $T { self.items[i] }
}

Scaled :: struct($T: Type) {
    inner:  Series($T);              // a handle — not an inline payload
    factor: $T;
}
impl Series($T) for Scaled($T) {
    count :: (self: *Scaled) -> i64 { self.inner.count() }
    at    :: (self: *Scaled, i: i64) -> $T { self.inner.at(i) * self.factor }
}

Pulse :: struct { v: f32; }
impl Series(f32) for Pulse {
    count :: (self: *Pulse) -> i64 { 1 }
    at    :: (self: *Pulse, i: i64) -> f32 { self.v }
}

depth :: (s: Series(f32)) -> f32 { s.at(1) }

main :: () {
    fa : [3]f32 = .[1.0, 2.0, 3.0];
    ia : [3]i64 = .[4, 5, 6];
    bf := Buffer(f32).{ items = fa[0..] };
    bi := Buffer(i64).{ items = ia[0..] };

    // Arbitrary depth: each hop is one handle into the same tag space.
    s1 := Scaled(f32).{ inner = bf, factor = 10.0 };
    s2 := Scaled(f32).{ inner = s1, factor = 2.0 };
    print("{} {}\n", depth(s1), depth(s2));

    // The i64 space recurses independently — its own set, its own tags.
    t1 := Scaled(i64).{ inner = bi, factor = 3 };
    v  : Series(i64) = t1;
    print("{} {}\n", v.count(), v.at(2));

    // A downcast to a member of THIS instantiation is one compare against
    // the target's constant tag; the soft temperament answers null for
    // another member of the same set.
    a : Series(f32) = s2;
    print("{}\n", a.(Scaled(f32)).factor);
    print("{}\n", (a.(?Pulse)) == null);

    // The type switch is the opening construct — arms name concrete
    // conformers of the subject's own instantiation.
    p : Series(f32) = Pulse.{ v = 5.0 };
    if p == {
        case Pulse: (x) { print("pulse {}\n", x.v); }
    }
    print("{}\n", type_of(p) == Pulse);
}
