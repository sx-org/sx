// `List(Sizable)` appended from inside a helper function, dispatched
// repeatedly from `main` after the helper returns: the helper funds its
// referent with `Allocator.make`, so the appended handle outlives that frame.

@import "modules/std.sx";

Sizable :: interface {
    size :: (self: *Self) -> i64;
}

Leaf :: struct { value: i64; }
impl Sizable for Leaf {
    size :: (self: *Leaf) -> i64 { self.value }
}

add :: (items: *List(Sizable), w: Leaf) {
    // The handle borrows, so the referent is funded here to outlive the frame.
    items.append(context.allocator.make(w));
}

main :: () -> void {
    // Works: protocol value created in main, appended to list
    out("=== Created in main ===\n");
    listA : List(Sizable) = .{};
    leaf := Leaf{ value = 42 };
    s := leaf.(Sizable);
    listA.append(s);
    r1 := listA.items[0].size();
    print("first:  {} (expected 42)\n", r1);
    r2 := listA.items[0].size();
    print("second: {} (expected 42)\n", r2);

    // The handle is created inside add(); both dispatches read the `make`
    // storage, not add()'s frame.
    out("=== Created in add() ===\n");
    listB : List(Sizable) = .{};
    add(*listB, Leaf{ value = 99 });
    r3 := listB.items[0].size();
    print("first:  {} (expected 99)\n", r3);
    r4 := listB.items[0].size();
    print("second: {} (expected 99)\n", r4);

    out("=== OK ===\n");
}
