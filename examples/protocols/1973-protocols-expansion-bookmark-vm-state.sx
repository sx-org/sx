// A real bookmark: an evaluation parks mid-flight, its VM-local state stays
// exactly as it left it, and the resume lands at the awaiting instruction.
//
// The `inline if` at the bottom can still write a `@context_extend` — in the
// branch it takes or the branch it does not — so the program Context cannot
// publish while it is undecided, and the run below awaits it at the read. The
// fact is answered by deciding that driver while the evaluation stays
// suspended, and the same continuation runs on.
//
// The `Dot` the evaluation built is mutated BEFORE the park, so the value the
// resumed dispatch reads proves both halves at once: 13 is the preserved state
// (`n` 2 raised to 5, doubled by the impl, plus the depth 3), 7 would be state
// lost across the park, and 19 would be the pre-park mutation running a second
// time.
@import "modules/std.sx";

Draw :: interface { draw :: (self: *Self) -> i64; }

Dot :: struct { n: i64; }
impl Draw for Dot { draw :: (self: *Dot) -> i64 { self.n * 2 } }

probe :: () -> i64 {
    d := Dot{ n = 2 };
    d.n = d.n + 3;
    v : *Draw = d;
    return context.depth + v.draw();
}

SUM :: @run probe();

inline if POINTER_SIZE == 8 {
    @context_extend depth: i64 = 3;
} else {
    @context_extend depth: i64 = 9;
}

main :: () {
    print("{}\n", SUM);
}
