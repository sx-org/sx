// Comptime-expanded conformance: a top-level `inline for` unrolls ONE
// declaration group per element of a curated type list, flattened into module
// scope. Each iteration is an ordinary impl with a concrete `T` — membership,
// dispatch, and every downstream rule apply to the expanded program unchanged.
// The cursor binds in type position exactly like a `$T: Type` binding, so the
// reflection builtins supply the field-wise body.
@import "modules/std.sx";

Point  :: struct { x: i64; y: i64; }
Rect   :: struct { w: i64; h: i64; }
Color  :: struct { r: i64; g: i64; b: i64; }

Serialize :: protocol vtable {
    write :: (self: *Self);
}

// The curated list is the supported spelling for "one body, a deliberate set
// of types" — the set stays intentional.
SERIALIZABLE :: .[Point, Rect, Color];

inline for T in SERIALIZABLE {
    impl Serialize for T {
        write :: (self: *T) {
            inline for i in 0..struct_field_count(T) {
                print("{}={} ", struct_field_name(T, i), struct_field_value(self.*, i));
            }
            print("\n");
        }
    }
}

// An expanded impl is an ordinary impl: its methods also register as methods
// of the type, so a concrete call never pays dispatch.
render :: (s: *Serialize) { s.write(); }

main :: () {
    p := Point{ x = 1, y = 2 };
    r := Rect{ w = 3, h = 4 };
    c := Color{ r = 5, g = 6, b = 7 };

    // A view at a protocol-typed position — the pair conforms through
    // expansion, like any hand-written impl.
    render(p);
    render(r);
    render(c);

    // Concrete call on the same generated method.
    p.write();

    // A protocol value in an aggregate, dispatched element-wise.
    vs : [3]*Serialize = .[p, r, c];
    for v in vs { v.write(); }
}
