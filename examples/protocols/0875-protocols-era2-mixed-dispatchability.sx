// Dispatchable interface methods work through an owned handle and through a
// `*P` view. A method that mentions Self past the receiver lives on a
// constraint, where Self stays known at the bound. Empty-impl adoption
// resolves by concrete identity at conformance/dispatch time, not by scan
// order.
@import "modules/std.sx";

Shape :: interface {
    area :: (self: *Self) -> i64;
    name :: (self: *Self) -> string;
}

Adopted :: interface {
    area :: (self: *Self) -> i64;
    name :: (self: *Self) -> string;
}

Combineable :: constraint {
    combine :: (self: *Self, other: Self) -> i64;
}

Sq :: struct { side: i64; }
impl Adopted for Sq {}
impl Shape for Sq {
    area :: (self: *Sq) -> i64 { return self.side * self.side; }
    name :: (self: *Sq) -> string { return "square"; }
}
impl Combineable for Sq {
    combine :: (self: *Sq, other: Sq) -> i64 { return self.side + other.side; }
}

combineBound :: (a: $T/Combineable, b: T) -> i64 {
    return a.combine(b);
}

main :: () {
    sq := Sq{ side = 4 };

    s := sq.(Shape);
    print("owned:  {} {}\n", s.area(), s.name());

    i := sq.(Adopted);
    print("adopt:  {} {}\n", i.area(), i.name());

    pv : *Shape = *s;
    print("view:   {} {}\n", pv.area(), pv.name());

    print("direct: {}\n", sq.combine(Sq{ side = 1 }));
    print("bound:  {}\n", combineBound(sq, Sq{ side = 6 }));
}
