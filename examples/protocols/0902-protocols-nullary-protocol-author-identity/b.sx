// The other author of `Q` — same spelling, a two-slot vtable.
Q :: interface { first :: (self: *Self) -> i64; tag :: (self: *Self) -> i64; }
Holder :: struct { v: i64; }
impl Q for Holder { first :: (self: *Holder) -> i64 => 7; tag :: (self: *Holder) -> i64 => 200 + self.v; }
ownFirst :: () -> i64 { h := Holder{ v = 1 }; x := h.(Q); return x.first(); }
ownTag :: () -> i64 { h := Holder{ v = 1 }; x := h.(Q); return x.tag(); }
