// A protocol method's `*void` parameter takes the pointer VALUE from every
// single-pointer source — `*T`, `[*]T`, and `cstring` alike, since `xx`
// bit-casts a cstring to a pointer value (spec, "cstring"). Only a
// NON-pointer value is spilled to a stack slot whose address crosses, so the
// callee reads it back through a typed pointer.
#import "modules/std.sx";

Take :: protocol vtable #identity {
    take :: (self: *Self, ptr: *void);
}

Sink :: struct { seen: usize = 0; }
impl Take for Sink {
    take :: (self: *Sink, ptr: *void) { self.seen = xx ptr; }
}

plain :: (ptr: *void) -> usize { return xx ptr; }

main :: () {
    a := context.allocator;

    s : Sink = .{};
    t : Take = xx s;

    many : [*]u8 = xx a.alloc_bytes(8);
    truth : usize = xx many;
    one : *u8 = xx many;
    raw : *void = xx many;
    cs : cstring = xx many;

    print("plain {}\n", plain(xx cs) == truth);

    t.take(xx many);
    print("many {}\n", s.seen == truth);
    t.take(one);
    print("single {}\n", s.seen == truth);
    t.take(raw);
    print("void {}\n", s.seen == truth);
    t.take(xx cs);
    print("cstring {}\n", s.seen == truth);

    // A non-pointer argument still crosses as the address of its slot.
    n : i64 = 42;
    t.take(n);
    slot : *i64 = xx s.seen;
    print("scalar {}\n", slot.* == 42);

    a.dealloc_bytes(raw);
}
