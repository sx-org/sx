// A protocol method's `*void` parameter takes the pointer VALUE from every
// single-pointer source — `*T` and `[*]T` alike. Only a NON-pointer value is
// spilled to a stack slot whose address crosses, so the callee reads it back
// through a typed pointer.
@import "modules/std.sx";

Take :: interface {
    take :: (self: *Self, ptr: *void);
}

Sink :: struct { seen: usize = 0; }
impl Take for Sink {
    take :: (self: *Sink, ptr: *void) { self.seen = xx ptr; }
}

plain :: (ptr: *void) -> usize { return xx ptr; }

main :: () {
    a := context.allocator;

    s : Sink = .{};
    t : Take = s;

    many : [*]u8 = a.allocBytes(8);
    truth : usize = xx many;
    one : *u8 = many;
    raw : *void = many;

    print("plain {}\n", plain(many) == truth);

    t.take(many);
    print("many {}\n", s.seen == truth);
    t.take(one);
    print("single {}\n", s.seen == truth);
    t.take(raw);
    print("void {}\n", s.seen == truth);

    // A non-pointer argument still crosses as the address of its slot.
    n : i64 = 42;
    t.take(n);
    slot : *i64 = xx s.seen;
    print("scalar {}\n", slot.* == 42);

    a.deallocBytes(raw);
}
