// A protocol method's `*void` parameter takes the pointer VALUE from every
// single-pointer source — `*T`, `[*]T`, and `cstring` alike, since `xx`
// bit-casts a cstring to a pointer value (spec, "cstring"). Only a
// NON-pointer value is spilled to a stack slot whose address crosses, so the
// callee reads it back through a typed pointer.
#import "modules/std.sx";

Inline :: protocol inline #identity {
    take :: (self: *Self, ptr: *void);
}

Vtable :: protocol vtable #identity {
    take :: (self: *Self, ptr: *void);
}

Sink :: struct { seen: usize = 0; }
impl Inline for Sink {
    take :: (self: *Sink, ptr: *void) { self.seen = xx ptr; }
}

Relay :: struct { seen: usize = 0; }
impl Vtable for Relay {
    take :: (self: *Relay, ptr: *void) { self.seen = xx ptr; }
}

plain :: (ptr: *void) -> usize { return xx ptr; }

main :: () {
    a := context.allocator;

    s : Sink = .{};
    inl : Inline = xx s;
    r : Relay = .{};
    vt : Vtable = xx r;

    many : [*]u8 = xx a.alloc_bytes(8);
    truth : usize = xx many;
    one : *u8 = xx many;
    raw : *void = xx many;
    cs : cstring = xx many;

    print("plain {}\n", plain(xx cs) == truth);

    inl.take(xx many);
    print("inline many {}\n", s.seen == truth);
    inl.take(one);
    print("inline single {}\n", s.seen == truth);
    inl.take(raw);
    print("inline void {}\n", s.seen == truth);
    inl.take(xx cs);
    print("inline cstring {}\n", s.seen == truth);

    vt.take(xx many);
    print("vtable many {}\n", r.seen == truth);
    vt.take(xx cs);
    print("vtable cstring {}\n", r.seen == truth);

    // A non-pointer argument still crosses as the address of its slot.
    n : i64 = 42;
    inl.take(n);
    slot : *i64 = xx s.seen;
    print("inline scalar {}\n", slot.* == 42);

    a.dealloc_bytes(raw);
}
