// A comptime `[N]Type` list holds TYPES. A value element is the element-kind
// error, diagnosed at the element itself — never inferred into a numeric
// array whose `inline for` then fails somewhere else.
@import "modules/std.sx";

Point :: struct { x: i64; y: i64; }

SHAPES :: .[Point, 42];

main :: () {
    inline for T in SHAPES {
        print("{}\n", size_of(T));
    }
}
