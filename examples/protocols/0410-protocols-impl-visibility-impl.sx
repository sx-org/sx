// Defines the impl. 0410-protocols-impl-visibility.sx does NOT import this
// directly — the impl must still be visible there.
@import "modules/std.sx";
@import "./0410-protocols-impl-visibility-types.sx";

impl Into(Wrap) for i64 {
  convert :: (self: i64, alloc: Allocator = context.allocator) -> Wrap {
    _ = alloc;
    .{ v = self * 10 }
  }
}
