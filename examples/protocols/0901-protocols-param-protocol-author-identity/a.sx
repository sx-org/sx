// One author of the parameterized `P` — a single dispatchable method.
P :: interface(T: Type) { tag :: (self: *Self) -> T; }
Cell :: struct { v: i64; }
impl P(i64) for Cell { tag :: (self: *Cell) -> i64 => 100 + self.v; }
cell : Cell = .{ v = 1 };
erase :: () -> P(i64) { return cell; }
own_tag :: () -> i64 { return erase().tag(); }
