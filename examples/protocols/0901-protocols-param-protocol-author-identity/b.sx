// The other author of `P` — same spelling, a two-method vtable.
P :: interface(T: Type) { first :: (self: *Self) -> T; tag :: (self: *Self) -> T; }
Cell :: struct { v: i64; }
impl P(i64) for Cell { first :: (self: *Cell) -> i64 => 7; tag :: (self: *Cell) -> i64 => 200 + self.v; }
cell : Cell = .{ v = 1 };
erase :: () -> P(i64) { return cell; }
own_first :: () -> i64 { return erase().first(); }
own_tag :: () -> i64 { return erase().tag(); }
