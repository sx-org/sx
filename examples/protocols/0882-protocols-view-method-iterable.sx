// A method call on a `*P` view in ITERABLE position: `for *x in v.items()`
// classifies like the owned-receiver form — the call plan resolves the
// protocol method's return type through the view (and through `?P`/`?*P`
// receivers), so the for-iterable classifier sees the `[]T`.
@import "modules/std.sx";

P :: interface {
    items :: (self: *Self) -> []i32;
}

C :: struct { a : [3]i32 = .[1, 2, 3]; }

impl P for C {
    items :: (self: *C) -> []i32 {
        r : []i32 = ---;
        r.ptr = *self.a[0];
        r.len = 3;
        r
    }
}

main :: () {
    c := C{};
    v : *P = c;
    for *x in v.items() { print("{}\n", x.*); }
    // Parenthesized spelling too.
    total := 0;
    for x in (v.items()) { total += x; }
    print("total: {}\n", total);
    // Owned-receiver parity.
    o := c.(P, context.allocator);
    for x in o.items() { total += x; }
    print("both:  {}\n", total);
}
