// The two declaration heads. `constraint` and `interface` are CONTEXTUAL
// words: heads only in the `::`-head slot, ordinary identifiers everywhere
// else. `P is interface` reports which one a contract is, and folds.
@import "modules/std.sx";
@import "modules/std/mem.sx";

Ord :: constraint {
    less :: (self: *Self, other: Self) -> bool;
}
impl Ord for i64 { less :: (self: *i64, other: i64) -> bool { self.* < other } }

Into2 :: constraint(Target: Type) {   // parameterized
    convert :: (self: *Self) -> Target;
}

Show :: interface { fmt :: (self: *Self) -> string; }
Rng :: interface { next :: (self: *Self) -> u64; }
Slot :: interface(T: Type) { get :: (self: *Self) -> T; }

Point :: struct { x: i64; }
impl Show for Point { fmt :: (self: *Point) -> string { "pt" } }
impl Slot(i64) for Point { get :: (self: *Point) -> i64 { self.x } }

Xorshift :: struct { state: u64; }
impl Rng for Xorshift { next :: (self: *Xorshift) -> u64 { self.state + 1 } }

kind_name :: ($P: Type) -> string {
    inline if P is interface { return "interface"; }
    "constraint"
}

smaller :: (a: $T/Ord, b: T) -> T { if a.less(b) { a } else { b } }

main :: () {
    print("{} {}\n", kind_name(Ord), kind_name(Show));
    print("{} {} {}\n", Ord is struct, Show is struct, Rng is interface);

    // A constraint protocol still bounds generics — that is its whole job.
    print("{}\n", smaller(3, 7));

    // A parameterized head carries its kind into every instantiation:
    // `Slot(i64)` erases and borrows, like any interface.
    p := Point{ x = 5 };
    sl : Slot(i64) = p;
    print("{}\n", sl.get());

    // The unparameterized interface head, borrowing `p` in place.
    s := p.(Show);
    print("{}\n", s.fmt());

    r := Xorshift{ state = 41 };
    rng : Rng = r;
    print("{}\n", rng.next());

    // The kind words stay ordinary identifiers outside the slot.
    constraint := 1;
    vtable := 2;
    print("{}\n", constraint + vtable);
}
