// The VM materializes a declared global as an instance of its own and keeps
// the mapping back to the global, so a carried allocator handle survives the
// escape: `context.allocator` is a borrow of the process-wide `cAllocator`
// instance, and the escaped handle relocates to that global's symbol with its
// method words resolved to their thunks. Allocating through the escaped handle
// at runtime is allocating through the real allocator.
@import "modules/std.sx";
@import "modules/std/mem.sx";

Holder :: struct { a: Allocator; k: i64; }

capture :: () -> Holder {
    return Holder{ a = context.allocator, k = 3 };
}

// The default Context itself is a declared global; a handle borrowed from its
// allocator field relocates the same way, whichever field it came out of.
fromContext :: () -> Allocator {
    return context.allocator;
}

H :: @run capture();
A :: @run fromContext();

main :: () {
    p := mem.create(H.a, i64);
    p.* = 41 + H.k;
    print("{}\n", p.*);
    mem.destroy(H.a, p);

    xs := mem.alloc(A, i64, 3);
    for i in 0..3 { xs[i] = i * 2; }
    print("{} {} {}\n", xs[0], xs[1], xs[2]);
    mem.free(A, xs);
}
