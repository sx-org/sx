// A protocol method call must arity-check like a
// plain call. `Allocator.deallocBytes` declares (ptr); calling it with
// an extra argument must not compile and drop the extra.
@import "modules/std.sx";

main :: () -> i32 {
    gpa := GPA.init();
    a : Allocator = gpa;
    p := a.allocBytes(64);
    a.deallocBytes(p, 12345);
    return 0;
}
