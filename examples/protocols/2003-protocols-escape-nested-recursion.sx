// Materialization is TYPE-DIRECTED (specs.md §6.9): the referent's bytes are
// walked by its concrete layout, so nested protocol handles recurse — their
// referents materialize and both of their words resolve — interior pointers
// recurse, and function references relocate to their symbols. An ERASED handle
// resolves the same way: its `ctx` per its referent, its type id as stamped,
// and its impl's vtable to the symbol it was erased with.
@import "modules/std.sx";

View :: protocol vtable @identity {
    area :: (self: *Self) -> i64;
}

Leaf :: struct { n: i64; }
impl View for Leaf { area :: (self: *Leaf) -> i64 { self.n } }

// A conformer that carries another handle: materializing it recurses.
Scaled :: struct { child: View; by: i64; }
impl View for Scaled { area :: (self: *Scaled) -> i64 { self.child.area() * self.by } }

Show :: protocol vtable { label :: (self: *Self) -> i64; }
Marker :: struct { k: i64; }
impl Show for Marker { label :: (self: *Marker) -> i64 { self.k * 3 } }

g_marker := Marker{ k = 5 };

add :: (a: i64, b: i64) -> i64 { a + b }
pick_fn :: () -> (i64, i64) -> i64 { return add; }

Tree :: struct { top: View; cell: *i64; seen: *Show; }

build :: () -> Tree {
    leaf := context.allocator.create(Leaf);
    leaf.n = 6;
    node := context.allocator.create(Scaled);
    node.child = leaf;
    node.by = 7;
    cell := context.allocator.create(i64);
    cell.* = 100;
    view : *Show = *g_marker;
    return Tree{ top = node, cell = cell, seen = view };
}

T  :: @run build();
FN :: @run pick_fn();

main :: () {
    print("{} {} {}\n", T.top.area(), T.cell.*, T.seen.label());
    // The interior pointer's referent is writable data of its own.
    T.cell.* = T.cell.* + 1;
    print("{}\n", T.cell.*);
    // The escaped function reference IS the function's symbol.
    print("{}\n", FN(3, 4));
}
