// Direct `Self` PARAMETERS dispatch on a tagged value (spec §6.4): every arm
// knows `Self`, so a bare later `Self` parameter is expressible — the caller
// passes a `P` value and the arm takes its referent. Because the arm's `Self`
// is the receiver's conformer, the argument's tag must equal the receiver's;
// that compare is the one runtime check in tagged dispatch (its checked
// failure is example 1956). The signature stays set-independent at the call
// site, so these methods keep the ordinary outlined switch.
#import "modules/std.sx";

Shape :: protocol tagged {
    area  :: (self: *Self) -> f64;
    same  :: (self: *Self, other: Self) -> bool;
    wider :: (self: *Self, other: Self, slack: f64) -> f64;
}

Circle :: struct { r: f64; }
impl Shape for Circle {
    area  :: (self: *Circle) -> f64 { 3.0 * self.r * self.r }
    same  :: (self: *Circle, other: Circle) -> bool { self.r == other.r }
    wider :: (self: *Circle, other: Circle, slack: f64) -> f64 { self.r - other.r + slack }
}

Square :: struct { s: f64; }
impl Shape for Square {
    area  :: (self: *Square) -> f64 { self.s * self.s }
    same  :: (self: *Square, other: Square) -> bool { self.s == other.s }
    wider :: (self: *Square, other: Square, slack: f64) -> f64 { self.s - other.s + slack }
}

// A `Self` parameter is the PROTOCOL at the boundary: this takes two handles.
closer :: (a: Shape, b: Shape) -> bool { a.same(b) }

// `#identity` changes nothing here — the arm receives an existing referent,
// so nothing anonymous is created.
Handle :: protocol tagged #identity {
    id    :: (self: *Self) -> i64;
    beats :: (self: *Self, other: Self) -> bool;
}
Port :: struct { n: i64; }
impl Handle for Port {
    id    :: (self: *Port) -> i64 { self.n }
    beats :: (self: *Port, other: Port) -> bool { self.n > other.n }
}

main :: () {
    c1 := Circle{ r = 2.0 };
    c2 := Circle{ r = 2.0 };
    c3 := Circle{ r = 5.0 };
    sq := Square{ s = 4.0 };

    v : Shape = c1;

    // The argument erases at the call: a conformer lvalue borrows in place,
    // an already-erased handle passes through.
    print("{} {}\n", v.same(c2), v.same(c3));
    w : Shape = c3;
    print("{}\n", v.same(w));

    // Mixed with ordinary parameters, and through a `P`-typed parameter.
    print("{}\n", v.wider(c3, 0.5));
    print("{}\n", closer(sq, sq));

    // Mutating the referent is visible through the handle — the argument is
    // a borrow, never a copy.
    c2.r = 9.0;
    print("{}\n", v.same(c2));

    // A single-conformer set devirtualizes; `#identity` keeps `Self`
    // parameters dispatchable.
    p := Port{ n = 3 };
    q := Port{ n = 9 };
    h : Handle = p;
    g : Handle = q;
    print("{} {}\n", h.beats(g), g.beats(h));
}
