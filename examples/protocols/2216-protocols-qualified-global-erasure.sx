// A static interface-typed position folds a namespace-qualified global
// (`m.the_w`) the same way it folds a bare global: the handle borrows that
// symbol. A path rooted at a global VALUE (`g.field`) is refused.
@import "modules/std.sx";
@import "2216-protocols-qualified-global-erasure/mod.sx";
m :: @import "2216-protocols-qualified-global-erasure/mod.sx";

P :: interface { a :: (self: *Self) -> i64; }
impl P for W { a :: (self: *W) -> i64 { self.v } }
S :: struct { inner: P; }

g : S = .{ inner = m.the_w };

main :: () {
    print("{}\n", g.inner.a());
}
