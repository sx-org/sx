// Coercing an effectful operand evaluates the expression ONCE.
// `arr[next()].(I)` lowers the receiver a single time — the side-effectful
// index runs once, and the borrowed element is the one that single evaluation
// picked. It holds for every index base shape: a LOCAL array, a module-GLOBAL
// array, and a STRUCT-FIELD array — and for `?I` destinations.
// The handle BORROWS the element it picked, so mutations through it are
// visible in the array; a by-VALUE `for` capture is a per-iteration copy, and
// a handle over that copy leaves the array untouched.

@import "modules/std.sx";

P :: interface {
    get :: (self: *Self) -> i64;
    bump :: (self: *Self);
}

S :: struct { v: i64 = 0; }

impl P for S {
    get :: (self: *S) -> i64 { return self.v; }
    bump :: (self: *S) { self.v += 1; }
}

H :: struct { arr: [2]S; }

gArr : [2]S = .[ S{ v = 100 }, S{ v = 200 } ];

gCalls : i64 = 0;
nextRet : i64 = 1;

next :: () -> i64 {
    gCalls += 1;
    return nextRet;
}

main :: () -> i32 {
    fails : i64 = 0;

    arr : [3]S = ---;
    arr[0] = S{ v = 10 };
    arr[1] = S{ v = 20 };
    arr[2] = S{ v = 30 };

    // Plain I destination: one eval, right element, borrowed in place.
    gCalls = 0;
    p := arr[next()].(P);
    if gCalls != 1 { print("plain evals {}\n", gCalls); fails += 1; }
    if p.get() != 20 { print("plain element {}\n", p.get()); fails += 1; }
    p.bump();
    if p.get() != 21 { print("plain bump {}\n", p.get()); fails += 1; }
    if arr[1].v != 21 { print("handle did not borrow source {}\n", arr[1].v); fails += 1; }

    // ?I destination: one eval, same borrow.
    gCalls = 0;
    op : ?P = arr[next()].(P);
    if gCalls != 1 { print("opt evals {}\n", gCalls); fails += 1; }
    if op == null { print("opt null\n"); fails += 1; }
    if op.get() != 21 { print("opt element {}\n", op.get()); fails += 1; }

    // Module-GLOBAL array base: one eval, right element.
    nextRet = 0;
    gCalls = 0;
    pg := gArr[next()].(P);
    if gCalls != 1 { print("global evals {}\n", gCalls); fails += 1; }
    if pg.get() != 100 { print("global element {}\n", pg.get()); fails += 1; }

    // STRUCT-FIELD array base: one eval, right element.
    h : H = .{ arr = .[ S{ v = 300 }, S{ v = 400 } ] };
    gCalls = 0;
    pf := h.arr[next()].(P);
    if gCalls != 1 { print("field evals {}\n", gCalls); fails += 1; }
    if pf.get() != 300 { print("field element {}\n", pf.get()); fails += 1; }

    // By-VALUE for capture: x is a per-iteration copy, so the handle borrows
    // THE COPY — bumps land there and the array is untouched.
    warr : [2]S = .[ S{ v = 1 }, S{ v = 2 } ];
    total : i64 = 0;
    for x in warr {
        pv := x.(P);
        pv.bump();
        total += pv.get();
    }
    if total != 5 { print("byval total {}\n", total); fails += 1; }
    if warr[0].v != 1 or warr[1].v != 2 { print("byval capture aliased: {} {}\n", warr[0].v, warr[1].v); fails += 1; }

    // By-REF `*x` capture through a `*I` slot: writes reach the array.
    for *x in warr {
        pr : *P = x;
        pr.bump();
    }
    if warr[0].v != 2 or warr[1].v != 3 { print("byref not written: {} {}\n", warr[0].v, warr[1].v); fails += 1; }

    if fails != 0 { return 1; }
    print("ok\n");
    return 0;
}
