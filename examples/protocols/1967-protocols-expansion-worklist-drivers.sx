// One worklist drains every expansion driver, and what an undecided driver
// could still declare is what finality reads.
//
// Each driver registers before it folds, carrying the contributions a
// conservative syntactic sweep of its unexpanded branches found: an
// `impl P for …` written anywhere inside contributes to `P`. Taking a driver —
// or rejecting it, or running its iterations out — gives exactly those
// contributions back.
//
// So an impl read is answerable once no undecided driver could still write one,
// a `@run` a condition names is registered and drained by the same worklist, and
// an answer stands even while other drivers are still open, because a driver
// that contributes to a DIFFERENT protocol never held this one open.
@import "modules/std.sx";

View :: interface { area :: (self: *Self) -> i64; }
Tally :: interface { count :: (self: *Self) -> i64; }

Widget :: struct { n: i64; }
Panel :: struct { n: i64; }
Loose :: struct { n: i64; }

impl View for Widget { area :: (self: *Widget) -> i64 { self.n } }

// A condition that queries no impl folds on the spot, and the branch it takes
// writes another conformer into the same protocol.
inline if POINTER_SIZE == 8 {
    impl View for Panel { area :: (self: *Panel) -> i64 { self.n + 100 } }
}

// The condition names a `@run`; the run registers on the worklist, drains
// there, and its value decides the branch. What it sees includes the impl the
// driver above spliced — a taken group is module scope.
HAS_PANEL :: @run Panel is View;
inline if HAS_PANEL { WIDTH :: 3; } else { WIDTH :: 0; }

// Every iteration of an `inline for` contributes, so `Tally` stays open until
// the whole unroll is drained; then the impls it spliced are simply in.
SHAPES :: .[Widget, Panel];
inline for T in SHAPES {
    impl Tally for T { count :: (self: *T) -> i64 { self.n } }
}
inline if Panel is Tally { COUNTED :: 1; } else { COUNTED :: 0; }

// Nothing implements `View` for `Loose`, and the one driver still undecided
// contributes to `Tally` alone — so `View`'s impls are closed here and the
// negative is uttered rather than parked.
inline if Loose is View { SEEN :: 1; } else { SEEN :: 0; }

inline if POINTER_SIZE == 8 {
    impl Tally for Loose { count :: (self: *Loose) -> i64 { self.n * 2 } }
}

main :: () {
    w := Widget{ n = 4 };
    p := Panel{ n = 5 };
    l := Loose{ n = 6 };
    v : *View = p;
    t : *Tally = w;
    u : *Tally = l;
    print("{} {} {} {} {} {}\n", WIDTH, COUNTED, SEEN, v.area(), t.count(), u.count());
}
