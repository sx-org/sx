// An interface-typed field default is the identity erasure of a named global,
// and it lands identically whether the aggregate is built on a frame or
// serialized into the image. Absence of `?I` is `null`.
@import "modules/std.sx";

P :: interface { a :: (self: *Self) -> i64; }
W :: struct { v: i64; }
impl P for W { a :: (self: *W) -> i64 { self.v } }

theW : W = .{ v = 7 };
S :: struct { inner: P = theW; }

staticDefault : S = .{};
// The same borrow written out: a static aggregate field takes the bare name of
// a module-scope global, and the handle it folds to dispatches.
staticNamed : S = .{ inner = theW };

main :: () {
    frameDefault : S = .{};
    print("{} {} {}\n", frameDefault.inner.a(), staticDefault.inner.a(), staticNamed.inner.a());

    // Both handles borrow the one global, so a write through it is visible
    // from either.
    theW.v = 11;
    print("{} {} {}\n", frameDefault.inner.a(), staticDefault.inner.a(), staticNamed.inner.a());

    opt : ?P = null;
    print("absent: {}\n", opt == null);
}
