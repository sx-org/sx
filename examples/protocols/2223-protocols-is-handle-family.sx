// Three doors onto one erased value, three answers. The HANDLE answers from
// its static type — it is its own interface, no other interface, no concrete
// type, and satisfies a constraint exactly when the bridge `impl C for I` is
// visible. `type_of(h)` and an `any` over the same referent are runtime tags
// naming the CONCRETE type, so they classify the referent instead: never
// `interface`, and conformance through the per-pair table.
@import "modules/std.sx";

I :: interface { a :: (self: *Self) -> i64; }
Q :: interface { q :: (self: *Self) -> i64; }
C :: constraint { c :: (self: *Self) -> i64; }

W :: struct { v: i64; }
impl I for W { a :: (self: *W) -> i64 { self.v } }
impl Q for W { q :: (self: *W) -> i64 { self.v + 1 } }
impl C for I { c :: (self: *I) -> i64 { self.a() } }

main :: () {
    w := W{ v = 3 };
    h : I = w;
    av : any = w;

    print("is interface: {} {} {}\n", h is interface, av is interface, type_of(h) is interface);
    print("handle:       {} {} {} {}\n", h is I, h is Q, h is C, h is W);
    print("referent:     {} {} {} {}\n", type_of(h) is I, type_of(h) is Q, av is Q, av is W);
    print("dispatch:     {} {}\n", h.a(), h.c());
}
