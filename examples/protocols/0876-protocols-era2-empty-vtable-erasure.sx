// An empty-vtable interface (no methods) erases. The handle carries
// {ctx, __type_id}, so type_of, the checked downcast, the type switch, and
// the @Protocol view all work with zero dispatchable methods.
@import "modules/std.sx";
@import "modules/std/mem.sx";

Marker :: interface {}

Sq :: struct { side: i64; }
impl Marker for Sq {}

main :: () {
    sq := Sq{ side = 4 };

    m := sq.(Marker);
    print("marker type: {}\n", type_of(m) == Sq);
    print("marker raw:  {}\n", m.(@Protocol).type_id == Sq);

    back := m.(Sq);
    print("downcast:    {}\n", back.side);

    match m {
        case Sq: |v| { print("switch:      {}\n", v.side); }
        else: { print("switch:      miss\n"); }
    }

    sq9 := Sq{ side = 9 };
    mo := sq9.(Marker);
    print("erased {}\n", type_of(mo) is Marker);
}
