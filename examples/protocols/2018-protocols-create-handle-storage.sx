// An interface handle is an ordinary copyable value, so heap storage FOR one
// is ordinary storage: `mem.create(a, I)` reinterprets the allocator's raw `*void`
// as `*I` exactly like `mem.alloc(a, I, n)` reinterprets it as `[]I`. The `*void`
// source carries no type identity, so neither is a handle built over a value
// of some conformer type — the handle is written into the storage afterwards,
// and dispatch goes through the stored handle.
@import "modules/std.sx";
@import "modules/std/mem.sx";

Shape :: interface {
    area :: (self: *Self) -> i64;
}

Tally :: interface {
    push :: (self: *Self, n: i64) -> i64;
}

Box :: struct { w: i64; h: i64; }
impl Shape for Box {
    area :: (self: *Box) -> i64 { self.w * self.h }
}

Disc :: struct { r: i64; }
impl Shape for Disc {
    area :: (self: *Disc) -> i64 { 3 * self.r * self.r }
}

Counter :: struct { total: i64; }
impl Tally for Counter {
    push :: (self: *Counter, n: i64) -> i64 { self.total = self.total + n; self.total }
}

main :: () {
    a := context.allocator;

    // A borrowing handle: create storage, store one in it, dispatch through it.
    b := Box{ w = 4, h = 5 };
    sp := mem.create(a, Shape);
    sp.* = b;
    print("{}\n", sp.area());
    mem.free(a, sp);

    // A handle over a local: the storage holding the handle is what is freed;
    // the referent outlives it on the frame.
    c := Counter{ total = 10 };
    kp := mem.create(a, Tally);
    kp.* = c.(Tally);
    print("{}\n", kp.push(7));
    mem.free(a, kp);

    // The slice path stays working, and a handle copied out of a slice element
    // into created storage dispatches identically from there.
    d := Disc{ r = 3 };
    xs := mem.alloc(a, Shape, 2);
    xs[0] = b;
    xs[1] = d;
    sp2 := mem.create(a, Shape);
    sp2.* = xs[1];
    print("{} {} {}\n", xs[0].area(), xs[1].area(), sp2.area());
    mem.free(a, sp2);
    mem.free(a, xs);
}
