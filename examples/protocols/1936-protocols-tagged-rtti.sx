// A tagged value answers RTTI through its protocol's `tag → type_id` table:
// `type_of` reports the CONCRETE receiver, `.(T)` downcasts to a conformer,
// `.(ProtocolRaw)` builds the {ctx, type_id} pair field-wise (one table
// load), and the type switch is the opening construct.
#import "modules/std.sx";

Shape :: protocol tagged { area :: (self: *Self) -> i64; }

Square :: struct { side: i64; }
impl Shape for Square { area :: (self: *Square) -> i64 { self.side * self.side } }

Rect :: struct { w: i64; h: i64; }
impl Shape for Rect { area :: (self: *Rect) -> i64 { self.w * self.h } }

describe :: (s: Shape) {
    // The type switch opens the value: each concrete arm binds the receiver
    // at its own type, exactly as a downcast would.
    if s == {
        case Square: (q) { print("square side {} area {}\n", q.side, s.area()); }
        case Rect:   (r) { print("rect {}x{} area {}\n", r.w, r.h, s.area()); }
    }
}

main :: () {
    q := Square{ side = 4 };
    r := Rect{ w = 2, h = 6 };
    a : Shape = q;
    b : Shape = r;

    print("{} {}\n", type_name(type_of(a)), type_name(type_of(b)));

    // Downcast to a conformer. Unconsumed panics on a mismatch, `?T` is the
    // soft form, and `try` routes a mismatch through the error channel.
    print("{}\n", a.(Square).side);
    if v := b.(?Rect) { print("soft {}\n", v.w); }
    if v := b.(?Square) { print("unreachable {}\n", v.side); } else { print("soft miss\n"); }

    // ProtocolRaw is the kind-agnostic view: ctx plus the concrete type id.
    raw := b.(ProtocolRaw);
    print("raw {}\n", type_name(raw.type_id));

    describe(a);
    describe(b);
}
