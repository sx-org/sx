// The one runtime check in tagged dispatch (spec §6.4): a bare `Self`
// argument must be of the receiver's own conformer, because the arm the
// receiver selects takes the argument's referent as its own concrete type. A
// mismatch is a CHECKED failure — it names the method and both conformers and
// exits, never reinterprets the referent.
#import "modules/std.sx";

Shape :: protocol tagged {
    area :: (self: *Self) -> f64;
    same :: (self: *Self, other: Self) -> bool;
}

Circle :: struct { r: f64; }
impl Shape for Circle {
    area :: (self: *Circle) -> f64 { 3.0 * self.r * self.r }
    same :: (self: *Circle, other: Circle) -> bool { self.r == other.r }
}

Square :: struct { s: f64; }
impl Shape for Square {
    area :: (self: *Square) -> f64 { self.s * self.s }
    same :: (self: *Square, other: Square) -> bool { self.s == other.s }
}

main :: () {
    c := Circle{ r = 1.0 };
    sq := Square{ s = 2.0 };
    v : Shape = c;
    w : Shape = sq;

    print("{}\n", v.same(c));
    print("{}\n", v.same(w));
    print("unreached\n");
}
