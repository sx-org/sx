// A driver `#run` in a program that has no Context at all.
//
// Context-ready is a fact about a program that HAS an implicit context. This
// one calls libc directly and never declares one, so the implicit-context
// machinery stays disabled, the run's wrapper takes no context parameter, and
// the evaluation has nothing to wait for — it registers the decided
// declaration space and runs. The scheduling discipline is the same either
// way; only the fact list differs.
puts :: (s: [*]u8) -> i32 extern;

PICK :: #run { a := 3; a * 3 > 8 };

inline if PICK {
    LABEL :: "wide";
} else {
    LABEL :: "narrow";
}

main :: () {
    puts(xx LABEL);
}
