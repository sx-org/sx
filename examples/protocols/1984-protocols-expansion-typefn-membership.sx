// A conformance question about a type that does not exist until it is MINTED.
//
// `Chosen` is bound to a type function, so the name denotes nothing a spelling
// can resolve: the constructor has to run first. That makes the question a
// driver-class evaluation like a `@run` — the decided declaration space
// registers, the constructor executes on the comptime VM, and only then does
// the query have a type to ask about.
//
// The answer itself follows the ordinary rule for an erased kind: an impl read
// waits while an undecided driver could still write one, and the only driver
// here declares no impl at all — so the answer is readable on the spot.
@import "modules/std.sx";

Show :: interface { fmt :: (self: *Self) -> i64; }

Wide :: struct { n: i64; }

pick :: () -> Type {
    return Wide;
}

Chosen :: pick();

impl Show for Wide { fmt :: (self: *Wide) -> i64 { self.n * 2 } }

inline if has_impl(Show, Chosen) {
    OK :: 1;
} else {
    OK :: 0;
}

main :: () {
    w := Wide{ n = 3 };
    v : *Show = w;
    print("{} {}\n", OK, v.fmt());
}
