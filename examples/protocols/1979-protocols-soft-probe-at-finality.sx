// What a SOFT probe answers once the sets are final (§7.9).
//
// A probe is the question, not the conversion: at finality every miss is an
// answer rather than a failure, and the answer is `null`. That holds for both
// families of miss — a tagged pair outside a set, and a concrete type with no
// visible impl of an erased protocol — and it holds for the FINAL-EMPTY set
// too: a tagged protocol nothing implements anywhere answers `null` rather than
// erroring, which is what lets conformance-conditional expansion bootstrap.
//
// The hard spellings of the same three misses are the ordinary diagnostics —
// see 1980.
#import "modules/std.sx";

Mark :: protocol tagged { tag :: (self: *Self) -> i64; }
View :: protocol tagged { area :: (self: *Self) -> i64; }
Show :: protocol vtable { fmt :: (self: *Self) -> i64; }

Widget :: struct { n: i64; }
Loose :: struct { n: i64; }

impl View for Widget { area :: (self: *Widget) -> i64 { self.n } }
impl Show for Widget { fmt :: (self: *Widget) -> i64 { self.n * 2 } }

main :: () {
    w := Widget{ n = 5 };
    l := Loose{ n = 1 };

    // Tagged, non-member of a NON-empty set.
    outside := l.(?View);
    // Tagged, final-EMPTY set — nothing implements `Mark` in this program.
    empty := w.(?Mark);
    // Erased, no visible impl for this concrete type.
    unshown := l.(?Show);

    print("{} {} {} {}\n", outside != null, empty != null, unshown != null, has_impl(Show, Widget));
}
