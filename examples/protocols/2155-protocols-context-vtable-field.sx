// An interface types a Context field (specs.md §6.6): the default folds to the
// erasure of a NAMED global instance — a borrow of that global's storage, never
// null — and the dispatch word is the pair's shared vtable symbol, so the
// constant is `{ &instance, __type_id, &vtable }`.
//
// Both accepted spellings of the default appear below: the bare name (the
// declared type states the conversion) and the explicit `xx`.
@import "modules/std.sx";

Sink :: interface { emit :: (self: *Self, n: i64) -> i64; }
Mark :: interface { mark :: (self: *Self) -> i64; }
Plain :: interface { plain :: (self: *Self) -> i64; }

Doubler :: struct { k: i64; }
impl Sink for Doubler { emit :: (self: *Doubler, n: i64) -> i64 { n * self.k } }
impl Mark for Doubler { mark :: (self: *Doubler) -> i64 { self.k } }
impl Plain for Doubler { plain :: (self: *Doubler) -> i64 { self.k + 1 } }

Tripler :: struct { k: i64; }
impl Sink for Tripler { emit :: (self: *Tripler, n: i64) -> i64 { n * self.k + 1 } }

the_sink : Doubler = .{ k = 3 };
the_mark : Doubler = .{ k = 9 };
loud : Tripler = .{ k = 7 };

@contextExtend sink: Sink = the_sink;
@contextExtend note: Mark = xx the_mark;

// An ordinary global takes the same static form at either vtable spelling —
// the Context is one client of the fold, not a special case.
standing : Plain = the_mark;

// The same body either side of the phase line: the comptime evaluation reads
// the VM's copy of the default context and dispatches against the conformer
// the handle carries; the runtime call goes through the vtable slot.
through_default :: () -> i64 { context.sink.emit(5) + context.note.mark() }

// A `push` installs another conformer of the same protocol; the dispatch
// inside follows the value, not the declaration.
through_push :: () -> i64 {
    push .{ sink = loud } { return context.sink.emit(5); }
}

// The borrowed referent is the declared global itself, so a write through it
// is visible to the next dispatch — the fold is a borrow, not a copy.
retuned :: () -> i64 {
    the_sink.k = 4;
    return context.sink.emit(5);
}

CT :: @run through_default();
CT_PUSH :: @run through_push();

main :: () {
    print("{} {}\n", CT, through_default());
    print("{} {}\n", CT_PUSH, through_push());
    print("{}\n", retuned());
    print("{}\n", standing.plain());
}
