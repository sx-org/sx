// A protocol method declared `-> *void` (literal void-pointer return,
// NOT `Self`) returns the underlying impl's pointer to the caller
// unchanged. The dispatch path must NOT auto-load from the result —
// `*void` outside a `Self`-disguise is a real pointer whose pointee
// size is unknown, and the ambient `target_type` (e.g. the enclosing
// function's return type) says nothing about it.

@import "modules/std.sx";
@import "modules/std/mem.sx";

main :: () -> i32 {
    gpa := GPA.init();
    alloc : Allocator = gpa;

    pDirect := gpa.allocBytes(64);
    print("direct: null? {}\n", pDirect == null);

    pProtocol := alloc.allocBytes(64);
    print("protocol: null? {}\n", pProtocol == null);

    print("allocCount: {}\n", gpa.allocCount);

    0
}
