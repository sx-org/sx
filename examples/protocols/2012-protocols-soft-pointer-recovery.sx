// `p.(?*T)` is the SOFT ctx recovery: the downcast's conformance question,
// answered with the receiver's own ctx typed as `*T`. It BORROWS — a write
// through the recovered pointer lands in the storage the handle points at —
// where `p.(?T)` copies the value out and `p.(*T)` recovers ctx unchecked.
// An erased value answers it by its `Type` word, and a handle borrows however
// it was formed, so the write lands in the concrete storage either way.
@import "modules/std.sx";

Bound :: interface { area :: (self: *Self) -> i64; }
Cast :: interface { area :: (self: *Self) -> i64; }

Rect :: struct { w: i64; h: i64; }
impl Bound for Rect { area :: (self: *Rect) -> i64 { self.w * self.h } }
impl Cast for Rect { area :: (self: *Rect) -> i64 { self.w * self.h } }

Square :: struct { side: i64; }
impl Bound for Square { area :: (self: *Square) -> i64 { self.side * self.side } }
impl Cast for Square { area :: (self: *Square) -> i64 { self.side * self.side } }

main :: () {
    r := Rect{ w = 2, h = 6 };

    // --- annotated target: the handle borrows `r` in place ---
    t : Bound = r;
    // The three temperaments agree on the MATCHING type.
    print("bound hard {}\n", t.(*Rect).w);
    if v := t.(?Rect) { print("bound value {}\n", v.w); }
    if p := t.(?*Rect) { print("bound ptr {}\n", p.w); } else { print("bound ptr null\n"); }
    // A conformer that is not the handle's own type answers null.
    if p := t.(?*Square) { print("bound miss {}\n", p.side); } else { print("bound ptr miss null\n"); }
    // The recovery is a BORROW: the write is seen through `r`.
    if p := t.(?*Rect) { p.w = 9; }
    print("bound borrowed {}\n", r.w);
    r.w = 2;

    // --- postfix cast: the same borrow, formed by `.(Cast)` ---
    b := r.(Cast);
    print("cast hard {}\n", b.(*Rect).w);
    if v := b.(?Rect) { print("cast value {}\n", v.w); }
    if p := b.(?*Rect) { print("cast ptr {}\n", p.w); } else { print("cast ptr null\n"); }
    if p := b.(?*Square) { print("cast miss {}\n", p.side); } else { print("cast ptr miss null\n"); }
    if p := b.(?*Rect) { p.h = 7; }
    print("cast borrowed {}\n", b.area());
}
