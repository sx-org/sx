// `p.(?*T)` is the SOFT ctx recovery: the downcast's conformance question,
// answered with the receiver's own ctx typed as `*T`. It BORROWS — a write
// through the recovered pointer lands in the storage the handle points at —
// where `p.(?T)` copies the value out and `p.(*T)` recovers ctx unchecked.
// An erased value answers it by its `Type` word, and what the write is seen
// through is the ownership class: an identity handle points at the concrete
// lvalue, an owning one at its own copy.
@import "modules/std.sx";

Ident :: interface { area :: (self: *Self) -> i64; }
Boxed :: interface { area :: (self: *Self) -> i64; }

Rect :: struct { w: i64; h: i64; }
impl Ident for Rect { area :: (self: *Rect) -> i64 { self.w * self.h } }
impl Boxed for Rect { area :: (self: *Rect) -> i64 { self.w * self.h } }

Square :: struct { side: i64; }
impl Ident for Square { area :: (self: *Square) -> i64 { self.side * self.side } }
impl Boxed for Square { area :: (self: *Square) -> i64 { self.side * self.side } }

main :: () {
    r := Rect{ w = 2, h = 6 };

    // --- identity: the handle borrows `r` in place ---
    t : Ident = r;
    // The three temperaments agree on the MATCHING type.
    print("ident hard {}\n", t.(*Rect).w);
    if v := t.(?Rect) { print("ident value {}\n", v.w); }
    if p := t.(?*Rect) { print("ident ptr {}\n", p.w); } else { print("ident ptr null\n"); }
    // A conformer that is not the handle's own type answers null.
    if p := t.(?*Square) { print("ident miss {}\n", p.side); } else { print("ident ptr miss null\n"); }
    // The recovery is a BORROW: the write is seen through `r`.
    if p := t.(?*Rect) { p.w = 9; }
    print("ident borrowed {}\n", r.w);
    r.w = 2;

    // --- vtable: the erasure owns a copy, the recovery points INTO it ---
    b := r.(Boxed, context.allocator);
    print("vtable hard {}\n", b.(*Rect).w);
    if v := b.(?Rect) { print("vtable value {}\n", v.w); }
    if p := b.(?*Rect) { print("vtable ptr {}\n", p.w); } else { print("vtable ptr null\n"); }
    if p := b.(?*Square) { print("vtable miss {}\n", p.side); } else { print("vtable ptr miss null\n"); }
    if p := b.(?*Rect) { p.h = 7; }
    print("vtable borrowed {}\n", b.area());
}
