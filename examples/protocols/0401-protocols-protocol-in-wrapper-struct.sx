// Interface value as a field of a wrapper struct, filled inside a function
// and appended to a `List`.

@import "modules/std.sx";

Sizable :: interface {
    size :: (self: *Self) -> i64;
}

Widget :: struct { value: i64; }
impl Sizable for Widget {
    size :: (self: *Widget) -> i64 { self.value }
}

// Wrapper struct with a protocol field (like ViewChild)
Item :: struct {
    view: Sizable;
}

Container :: struct {
    items: List(Item);

    add :: (self: *Container, w: Widget) {
        // The handle borrows, so the referent is funded here to outlive the frame.
        self.items.append(Item{ view = context.allocator.make(w) });

        out("inside add: ");
        print("{}\n", self.items.items[self.items.len - 1].view.size());
    }
}

main :: () -> void {
    c : Container = .{};
    c.add(Widget{ value = 42 });
    c.add(Widget{ value = 99 });

    // Each entry borrows its own heap referent, so the two dispatch
    // independently.
    r0 := c.items.items[0].view.size();
    r1 := c.items.items[1].view.size();
    print("items[0] = {} (expected 42)\n", r0);
    print("items[1] = {} (expected 99)\n", r1);
}
