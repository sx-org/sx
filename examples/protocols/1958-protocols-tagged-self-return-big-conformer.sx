// A `-> Self` arm places its concrete result BY VALUE in a caller-frame
// temporary, so a large conformer travels through the arm's return. This is
// the shape issue 0360 records for large aggregates in an optimized build, so
// the pairing is pinned: a multi-kilobyte conformer dispatched through
// `-> Self`, built optimized (the `.build` sidecar makes this an AOT example)
// and run.
#import "modules/std.sx";

N :: 2048;

Bulk :: protocol tagged {
    total  :: (self: *Self) -> i64;
    scaled :: (self: Self, k: i64) -> Self;
}

// ~16 KB of conformer, well past the size at which a first-class aggregate
// return stops being a couple of registers.
Wide :: struct { head: i64; cells: [N]i64; tail: i64; }
impl Bulk for Wide {
    total  :: (self: *Wide) -> i64 { self.head + self.cells[N - 1] + self.tail }
    scaled :: (self: Wide, k: i64) -> Wide {
        out := self;
        out.head = self.head * k;
        out.cells[N - 1] = self.cells[N - 1] * k;
        out.tail = self.tail * k;
        out
    }
}

Narrow :: struct { n: i64; }
impl Bulk for Narrow {
    total  :: (self: *Narrow) -> i64 { self.n }
    scaled :: (self: Narrow, k: i64) -> Narrow { .{ n = self.n * k } }
}

main :: () {
    w := Wide.{ head = 2, tail = 3 };
    w.cells[N - 1] = 5;
    n := Narrow.{ n = 7 };

    b : Bulk = w;
    c : Bulk = n;

    big := b.scaled(4);
    small := c.scaled(4);
    print("{} {}\n", big.total(), small.total());

    // The temporary is the caller's: the original is untouched.
    print("{} {}\n", b.total(), c.total());
}
