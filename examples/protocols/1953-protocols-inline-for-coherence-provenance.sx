// Expansion-generated impls are ordinary impls of the expanded program: two
// expansions landing on one `(protocol, type)` pair are the ordinary tagged
// coherence error, and it names both unrolled sites.
#import "modules/std.sx";

Point :: struct { x: i64; y: i64; }
Rect  :: struct { w: i64; h: i64; }

Show :: protocol tagged { show :: (self: *Self) -> i64; }

inline for T in .[Point, Rect] {
    impl Show for T { show :: (self: *T) -> i64 { 1 } }
}

inline for T in .[Rect] {
    impl Show for T { show :: (self: *T) -> i64 { 2 } }
}

main :: () {
    r := Rect{ w = 1, h = 2 };
    s : Show = r;
    print("{}\n", s.show());
}
