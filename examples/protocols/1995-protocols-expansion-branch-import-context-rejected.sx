// A rejected branch gives the Context back.
//
// The same shape as 1994 with the condition inverted. While the branch is
// undecided the imported `@context_extend` holds the layout open and the run
// below cannot start; rejecting the branch retires exactly that contribution,
// Context-ready fires, and the run executes against the layout the program
// really has. A contribution that did not come back would leave the run
// waiting forever — an expansion deadlock instead of an answer.
@import "modules/std.sx";

DEEP :: @run { budget() > 8 };

inline if DEEP { MODE :: 1; } else { MODE :: 0; }

inline if POINTER_SIZE == 0 {
    @import "./1994-protocols-expansion-branch-import-ctx.sx";
} else {
    NARROW :: 1;
}

budget :: () -> i64 {
    p := context.allocator.alloc_bytes(64);
    context.allocator.dealloc_bytes(p);
    return 12;
}

main :: () {
    print("{}\n", MODE);
}
