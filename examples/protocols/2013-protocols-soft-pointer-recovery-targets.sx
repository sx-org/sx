// The soft ctx recovery `p.(?*T)` tests T, so its pointee must NAME a
// concrete type. A protocol pointee is the type lie the hard recovery refuses,
// and `void` names nothing to test.
// The diagnostics are the success criterion.
@import "modules/std.sx";

Boxed :: interface { area :: (self: *Self) -> i64; }

Rect :: struct { w: i64; h: i64; }
impl Boxed for Rect { area :: (self: *Rect) -> i64 { self.w * self.h } }

main :: () {
    r := Rect{ w = 2, h = 6 };
    b := r.(Boxed);

    if p := b.(?*Boxed) { print("{}\n", p.area()); }
    if p := b.(?*void) { print("raw\n"); }
}
