// A parameterised protocol type parameter parses and lowers without error.
// The protocol `Into(Target: Type)` and the matching
// `impl Into(Block) for Closure() -> void` declarations are registered but
// unused — resolution is what makes the impl reachable from `xx`.

#import "modules/std.sx";

MyTag :: struct { value: i64 = 0; }

impl Into(MyTag) for i64 {
  convert :: (self: i64, alloc: Allocator = context.allocator) -> MyTag {
    _ = alloc;
    .{ value = self }
  }
}

main :: () -> i32 {
  print("ok\n");
  0
}
