@import "modules/std.sx";
@import "modules/math";
@import "modules/build.sx";
@import "modules/std/test.sx";
pkg :: @import "tests/fixtures/testpkg";

Point :: struct { x, y: i32; }

Color :: enum { red; green; blue; }

Shape :: enum {
    circle: f32;
    rect: struct { w, h: f32; };
    none;
}

Overlay :: union {
    f: f32;
    i: i32;
}

Vec2 :: union {
    data: [2]f32;
    struct { x, y: f32; };
}

Defaults :: struct {
    a: i32;
    b: i32 = 99;
    c: i32 = ---;
}

OptNode :: struct {
    value: i32;
    next: ?i32;
}

OptInner :: struct { val: i32; }

OptOuter :: struct { inner: ?OptInner; }

MyFloat :: f64;

Perms :: enum flags { read; write; execute; }

Status :: enum u8 { ok; err; timeout; }

WindowFlags :: enum flags u32 { vsync :: 64; resizable :: 4; hidden :: 128; }

// --- Top-level functions ---

add :: (a: i32, b: i32) -> i32 { a + b }

mul :: (a: i32, b: i32) -> i32 { a * b }

identity :: (x: $T) -> T { x }

pairAdd :: (a: $T, b: $U) -> i64 {
    a.(i64) + b.(i64)
}

typedSum :: (..args: []i32) -> i32 {
    result := 0;
    for it in args { result = result + it; }
    result
}

apply :: (f: (i32, i32) -> i32, x: i32, y: i32) -> i32 {
    f(x, y)
}

voidReturn :: () {
    return;
}

implicitReturn :: (x: i32) -> i32 {
    x * 2
}

earlyReturn :: (x: i32) -> i32 {
    if x > 10 { return 99; }
    x
}

vec3 :: (x: f32, y: f32, z: f32) -> @Vector(3, f32) {
    .[x, y, z]
}

pointSum :: (p: Point) -> i32 { p.x + p.y }

// @run compile-time constants
CT_VAL :: @run add(10, 15);

CT_MUL :: @run mul(6, 7);

CT_CHAIN :: @run add(CT_VAL, 5);

// @run compile-time optional tests
ctOptCoalesce :: () -> i32 {
    x: ?i32 = 42;
    y: ?i32 = null;
    return (x ?? 0) + (y ?? 99);
}

ctOptUnwrap :: () -> i32 {
    x: ?i32 = 77;
    return x?!;
}

ctOptGuard :: () -> i32 {
    x: ?i32 = 10;
    if x == null { return -1; }
    return x;
}

CT_OPT_COALESCE :: @run ctOptCoalesce();

CT_OPT_UNWRAP :: @run ctOptUnwrap();

CT_OPT_GUARD :: @run ctOptGuard();

// @insert helpers
genCode :: () -> string {
    return "print(\"insert-ok\\n\");";
}

genVal :: () -> string {
    return "print(\"insert-gen: {}\\n\", 42);";
}

// --- Error handling (failable functions: sets, raise/try/catch/or) ---

SmokeErr :: error { Empty; BadDigit; Overflow }
CheckErr :: error { NotReady }
AcquireErr :: error { Acquire }

// value-carrying, named set: raise three tags or succeed
smParse :: (n: i32) -> (i32, !SmokeErr) {
    if n < 0  { raise .BadDigit; }
    if n == 0 { raise .Empty; }
    if n > 99 { raise .Overflow; }
    return n * 2;
}

// pure failable, inferred set
smCheck :: (ok: bool) -> ! {
    if !ok { raise CheckErr.NotReady; }
    return;
}

// multi-value, inferred set: `try` propagates; the SCC pass absorbs SmokeErr
smPair :: (a: i32, b: i32) -> (i32, i32, !) {
    x := try smParse(a);
    y := try smParse(b);
    return .{x, y};
}

// `catch` block that diverges (logs the tag, then returns a fallback)
smOrDefault :: (n: i32) -> i32 {
    return smParse(n) catch |e| {
        print("  logged {}\n", e);
        return -1;
    };
}

// guarded + plain `defer` interleave: the rollback runs only on the error path
smAcquire :: (fail: bool) -> (i32, !) {
    handed := false;
    defer print("  smoke defer A\n");
    defer if !handed print("  smoke rollback B\n");
    if fail { raise AcquireErr.Acquire; }
    handed = true;
    return 7;
}

// `or`-chain: try a, fall to try b; propagate if both fail
smFirst :: (a: i32, b: i32) -> (i32, !) {
    v := try smParse(a) or try smParse(b);
    return v;
}

// --- Extern function binding ---
libc :: @library "c";

cAbs :: (n: i32) -> i32 extern libc "abs";

// --- Protocol declarations (static dispatch only) ---

Counter :: interface {
    inc :: (self: *Self);
    get :: (self: *Self) -> i32;
}

Summable :: constraint {
    sum :: (self: *Self) -> i32;
}

SimpleCounter :: struct { val: i32; }

impl Counter for SimpleCounter {
    inc :: (self: *SimpleCounter) { self.val += 1; }
    get :: (self: *SimpleCounter) -> i32 { self.val }
}

impl Summable for Point {
    sum :: (self: *Point) -> i32 { self.x + self.y }
}

// `vtable`-kind protocol for dynamic dispatch
Adder :: interface {
    add :: (self: *Self, n: i32);
    value :: (self: *Self) -> i32;
}

Accumulator :: struct {
    total: i32;
}

impl Adder for Accumulator {
    add :: (self: *Accumulator, n: i32) { self.total += n; }
    value :: (self: *Accumulator) -> i32 { self.total }
}

Doubler :: struct { val: i32; }

impl Adder for Doubler {
    add :: (self: *Doubler, n: i32) { self.val = self.val + n + n; }
    value :: (self: *Doubler) -> i32 { self.val }
}

// default methods
Repeater :: interface {
    say :: (self: *Self, msg: string);
    sayTwice :: (self: *Self, msg: string) {
        self.say(msg);
        self.say(msg);
    }
}

Printer :: struct { count: i32; }

impl Repeater for Printer {
    say :: (self: *Printer, msg: string) {
        self.count += 1;
        out(msg);
    }
}

// Chained default→default calls
Chained :: interface {
    base :: (self: *Self, msg: string) -> i32;
    wrap :: (self: *Self, msg: string) -> i32 {
        self.base(msg) + 1
    }
    doubleWrap :: (self: *Self, msg: string) -> i32 {
        self.wrap(msg) + self.wrap(msg)
    }
}

ChainImpl :: struct { val: i32; }
impl Chained for ChainImpl {
    base :: (self: *ChainImpl, msg: string) -> i32 {
        self.val += 1;
        msg.len
    }
}

// Self type
Eq :: constraint {
    eq :: (self: *Self, other: Self) -> bool;
}

impl Eq for Point {
    eq :: (self: *Point, other: Point) -> bool {
        self.x == other.x and self.y == other.y
    }
}

Cloneable :: constraint {
    clone :: (self: *Self) -> Self;
}

impl Cloneable for Point {
    clone :: (self: *Point) -> Point {
        Point{ x = self.x, y = self.y }
    }
}

impl Eq for i64 {
    eq :: (self: *i64, other: i64) -> bool {
        self.* == other
    }
}

// Generic constraints
areEqual :: ($T: Type/Eq, a: T, b: T) -> bool {
    a.eq(b)
}

Hashable :: constraint {
    hash :: (self: *Self) -> i64;
}

impl Hashable for Point {
    hash :: (self: *Point) -> i64 {
        self.x * 31 + self.y
    }
}

eqAndHash :: ($T: Type/Eq/Hashable, a: T, b: T) -> bool {
    if a.hash() != b.hash() { return false; }
    a.eq(b)
}

// inline constraint syntax ($T/Protocol)
sumOfInline :: (a: $T/Summable, b: T) -> i32 {
    a.sum() + b.sum()
}

// Generic struct impls
Pair :: struct ($T: Type) {
    a: T;
    b: T;
}

impl Summable for Pair($T) {
    sum :: (self: *Pair(T)) -> i32 {
        self.a + self.b
    }
}

// Struct type param constraints
SumBox :: struct ($T: Type/Summable) {
    val: T;
}

// ============================================================
// Struct constants test

// ============================================================
// Struct constants test
Phys :: struct {
    x, y: f32;
    GRAVITY :f32: 9.81;
    MAX_SPEED :: 100;
}

// Init block test struct
Builder :: struct {
    total: i32;
    count: i32;

    add :: (self: *Builder, val: i32) {
        self.total += val;
        self.count += 1;
    }
}

// Global variable for address-of test
gSmokeVal : i32 = 42;

writeToPtr :: (p: *i32) {
    p.* = 99;
}

main :: () {

    // ========================================================
    // PROTOCOLS (static dispatch)
    // ========================================================
    print("=== Protocols ===\n");

    // Basic protocol + impl, direct call on concrete type
    {
        sc := SimpleCounter{ val = 0 };
        sc.inc();
        sc.inc();
        sc.inc();
        print("P1.1: {}\n", sc.get());
    }

    // impl in separate scope (retroactive conformance)
    {
        p := Point{ x = 10, y = 20 };
        print("P1.2: {}\n", p.sum());
    }

    // `vtable`-kind protocol — xx conversion + dynamic dispatch
    {
        acc := Accumulator{ total = 0 };
        a := acc.(Adder);
        a.add(10);
        a.add(20);
        a.add(12);
        print("P2.1: {}\n", a.value());
    }

    // pass protocol value to function
    {
        useAdder :: (a: Adder, n: i32) -> i32 {
            a.add(n);
            a.value()
        }
        acc := Accumulator{ total = 100 };
        result := useAdder(acc.(Adder), 50);
        print("P2.2: {}\n", result);
    }

    // different impls through same protocol type
    {
        acc := Accumulator{ total = 0 };
        dbl := Doubler{ val = 0 };
        a1 := acc.(Adder);
        a2 := dbl.(Adder);
        a1.add(5);
        a2.add(5);
        print("P2.3: {} {}\n", a1.value(), a2.value());
    }

    // vtable-pointer protocol
    {
        sc := SimpleCounter{ val = 0 };
        c := sc.(Counter);
        c.inc();
        c.inc();
        c.inc();
        c.inc();
        c.inc();
        print("P3.1: {}\n", c.get());
    }

    // interface handle passed to function
    {
        useCounter :: (c: Counter) -> i32 {
            c.inc();
            c.inc();
            c.get()
        }
        sc := SimpleCounter{ val = 10 };
        result := useCounter(sc.(Counter));
        print("P3.2: {}\n", result);
    }

    // default method calls required method (static dispatch)
    {
        pr := Printer{ count = 0 };
        pr.sayTwice("hi ");
        print("\nP4.1: {}\n", pr.count);
    }

    // default method via dynamic dispatch (vtable)
    {
        pr := Printer{ count = 0 };
        r : *Repeater = *pr;          // borrowed VIEW — mutations reach pr
        r.sayTwice("yo ");
        print("\nP4.2: {}\n", pr.count);
    }

    // chained default→default calls via vtable
    {
        ci := ChainImpl{ val = 0 };
        ch : *Chained = *ci;          // view — ci.val is asserted below
        // doubleWrap calls wrap twice, wrap calls base once each
        // base("hi") returns 2 (len), wrap adds 1 → 3, doubleWrap = 3 + 3 = 6
        result := ch.doubleWrap("hi");
        // base was called 2 times (once per wrap call)
        print("P4.3: {} {}\n", result, ci.val);
    }

    // Self type in protocol — static dispatch
    {
        p1 := Point{ x = 1, y = 2 };
        p2 := Point{ x = 1, y = 2 };
        p3 := Point{ x = 3, y = 4 };
        print("P5.1: {} {}\n", p1.eq(p2), p1.eq(p3));
    }

    // Self in return position
    {
        p := Point{ x = 10, y = 20 };
        p2 := p.clone();
        print("P5.2: {} {}\n", p2.x, p2.y);
    }

    // impl for primitive type
    {
        x := 42;
        y := 42;
        z := 99;
        r1 := x.eq(y);
        r2 := x.eq(z);
        print("P5.5: {} {}\n", r1, r2);
    }

    // Self-typed argument via a generic bound. Eq mentions Self past the
    // receiver, so it is a constraint; the bound keeps Self known.
    {
        p1 := Point{ x = 1, y = 2 };
        p2 := Point{ x = 1, y = 2 };
        p3 := Point{ x = 3, y = 4 };
        print("P5.3: {} {}\n", areEqual(p1, p2), areEqual(p1, p3));
    }

    // Single constraint — constrained generic function
    {
        p1 := Point{ x = 1, y = 2 };
        p2 := Point{ x = 1, y = 2 };
        p3 := Point{ x = 3, y = 4 };
        print("P6.1: {} {}\n", areEqual(p1, p2), areEqual(p1, p3));
    }

    // Constraint with primitive type
    {
        print("P6.2: {} {}\n", areEqual(42, 42), areEqual(42, 99));
    }

    // Multiple constraints
    {
        p1 := Point{ x = 1, y = 2 };
        p2 := Point{ x = 1, y = 2 };
        p3 := Point{ x = 3, y = 4 };
        print("P6.3: {} {}\n", eqAndHash(p1, p2), eqAndHash(p1, p3));
    }

    // inline constraint syntax ($T/Protocol)
    {
        // sumOfInline uses $T/Summable inline (not $T: Type/Summable)
        p1 := Point{ x = 10, y = 20 };
        p2 := Point{ x = 3, y = 7 };
        print("P6.4: {}\n", sumOfInline(p1, p2));
    }

    // Struct type param constraints ($T: Type/Summable)
    {
        box := SumBox(Point){ val = Point{ x = 5, y = 15 } };
        print("P6.5: {}\n", box.val.sum());
    }

    // impl for generic struct
    {
        p := Pair(i32){ a = 10, b = 20 };
        print("P7.1: {}\n", p.sum());
    }

    // generic struct impl with different type arg
    {
        p1 := Pair(i32){ a = 3, b = 7 };
        p2 := Pair(i64){ a = 100, b = 200 };
        print("P7.2: {} {}\n", p1.sum(), p2.sum());
    }

    // xx in function return position (tested in standalone test_return.sx)
    // Covered by: makeAdder :: (acc: *Accumulator) -> Adder { xx acc; }

    // Protocol values in arrays — each element copies the handle and aliases
    // the named source.
    {
        acc := Accumulator{ total = 0 };
        dbl := Doubler{ val = 0 };
        adders : [2]Adder = .[acc.(Adder), dbl.(Adder)];
        i := 0;
        while i < 2 {
            adders[i].add(5);
            i += 1;
        }
        print("P2.6: {} {}\n", adders[0].value(), adders[1].value());
    }

    // postfix erasure of a named local at an interface argument
    {
        useAdder :: (a: Adder) -> i32 { a.add(10); a.value() }
        acc := Accumulator{ total = 5 };
        result := useAdder(acc.(Adder));
        print("P2.7: {}\n", result);
    }

    // named local at an interface argument
    {
        useCounter :: (c: Counter) -> i32 { c.inc(); c.inc(); c.get() }
        sc := SimpleCounter{ val = 100 };
        result := useCounter(sc.(Counter));
        print("P3.3: {}\n", result);
    }
}
