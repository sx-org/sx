// A failable slot accepts only values whose error members its channel holds.

@import "modules/std.sx";
lib :: @import "lib.sx";

B :: error { Y }
IoErr :: error { Failed }

main :: () -> i32 {
    sourceA: (i32, !lib.A) = .{0, lib.A.X};
    sourceIo: (i32, !lib.IoErr) = .{0, lib.IoErr.Down};
    v: (i32, !B) = sourceA;
    w: (i32, !IoErr) = sourceIo;
    a := v catch |e| -1;
    b := w catch |e| -1;
    print("{} {}\n", a, b);
    0
}
