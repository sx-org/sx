// Error type names retain their declaration spelling through reflection.
@import "modules/std.sx";
@import "2278-errors-typename-is-the-declared-name/lib.sx";

ZigZagErr :: error { Kink }

zag :: (n: i32) -> (i32, !ZigZagErr) { if n < 0 { raise ZigZagErr.Kink; } return n; }

main :: () {
    print("set:   {}\n", @typeName(ZigZagErr));
    tp : Type = ZigZagErr;
    print("local: {}\n", @typeName(tp));
    _, err := zag(1);
    box : any = err;
    print("box:   {}\n", @typeName(@typeOf(box)));
}
