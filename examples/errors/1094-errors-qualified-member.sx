// The qualified member spelling `Set.Member`: the member is checked against its
// OWN set, and the value's static type is `Set`.
//
// Into a NAMED channel only the member named at the site has to belong to that
// channel — `Wide.Fault` reaches `-> !Narrow` though `Wide.Extra` could not.
// Into an inferred `!` the whole static type contributes, so `spread` converges
// to Wide and only a caller set covering both members accepts it.

@import "modules/std.sx";

Wide   :: error { Fault; Extra }
Narrow :: error { Fault }

pick :: (n: i32) -> !Narrow {
    if n < 0 { raise Wide.Fault; }
    return;
}

spread :: (n: i32) -> ! {
    if n < 0 { raise Wide.Extra; }
    return;
}

relay :: (n: i32) -> !Wide {
    try spread(n);
    return;
}

main :: () -> i32 {
    r : i32 = 0;
    e := pick(-1);
    if e == Narrow.Fault { r = r + 4; }          // true  -> +4
    if e == Wide.Extra   { r = r + 1; }           // false (Fault was raised)

    t := Wide.Extra;
    f := relay(-1);
    if f == t { r = r + 16; }                     // true  -> +16

    print("qualified: {}\n", r);                  // -> 20
    return 0;
}
