// The spelled assertion `@cast(av, T)` is the unconsumed temperament: a
// match yields the value, a mismatch stops the program naming the call site.
@import "modules/std.sx";

main :: () {
    n : any = 7;
    f : any = 2.5;

    print("cast {}\n", @cast(n, i64));
    v := @cast(f, i64);
    print("unreached {}\n", v);
}
