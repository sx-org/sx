// The spelled assertion `@cast(T, av)` is the unconsumed temperament: a
// match yields the value, a mismatch stops the program naming the call site.
@import "modules/std.sx";

main :: () {
    n : any = 7;
    f : any = 2.5;

    print("cast {}\n", @cast(i64, n));
    v := @cast(i64, f);
    print("unreached {}\n", v);
}
