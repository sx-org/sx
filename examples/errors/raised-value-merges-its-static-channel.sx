// `raise VALUE` merges VALUE's static channel into an inferred `!`. A catch
// binding or an error slot holds the failure of the failable it attempted,
// so the caller's `.X` names the member that arrives.
@import "modules/std.sx";

AErr :: error { Exec; }
BErr :: error { NotFound; }

exec :: () -> ! { raise AErr.Exec; }
missing :: () -> ! { raise BErr.NotFound; }
named :: (n: i32) -> (i32, !BErr) { if n == 0 { raise BErr.NotFound; } return n; }

reraises :: (n: i32) -> ! {
    if n == 0 { try missing(); }
    exec() catch |e| { raise e; };
    return;
}
forwards :: (e: BErr) -> ! { raise e; }
shadows :: () -> ! { exec() catch |e| { e := BErr.NotFound; raise e; }; return; }
binds :: () -> ! { err := missing(); if err { raise err; } return; }
destructures :: (n: i32) -> ! { _, err := named(n); if err { raise err; } return; }

main :: () {
    reraises(0) catch |e| { print("{} {}\n", e, e == .NotFound); };
    reraises(1) catch |e| { print("{} {}\n", e, e == .Exec); };
    forwards(BErr.NotFound) catch |e| { print("{} {}\n", e, e == .NotFound); };
    shadows() catch |e| { print("{} {}\n", e, e == .NotFound); };
    binds() catch |e| { print("{} {}\n", e, e == .NotFound); };
    destructures(0) catch |e| { print("{} {}\n", e, e == .NotFound); };
}
