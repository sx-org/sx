@import "modules/std.sx";
m :: @import "2540-errors-local-receiver-channel/mod.sx";

Other :: error { Wrong; }
Decoy :: struct {
    go :: (self: *Decoy) -> !Other { raise Other.Wrong; }
}

go :: () -> !Other { raise Other.Wrong; }

forward :: (b: *Decoy) -> ! {
    {
        b : m.Box = .{};
        alias := *b;
        return alias.go();
    }
}

tail :: () -> ! {
    b : m.Box = .{};
    { b : Decoy = .{}; }
    b.go()
}

pair :: () -> (i32, m.Box) { return 7, m.Box{}; }

destructured :: () -> ! {
    n, b := pair();
    try b.go();
}

iterated :: () -> ! {
    boxes : [1]m.Box = .{};
    b : Decoy = .{};
    for b in boxes { try b.go(); }
}

optional_if :: (b: ?m.Box) -> ! {
    if b := b { b.go() }
}

optional_while :: (b: ?m.Box) -> ! {
    while b := b { try b.go(); }
}

main :: () -> i32 {
    b : Decoy = .{};
    first := forward(*b);
    second := tail();
    third := destructured();
    fourth := iterated();
    fifth := optional_if(m.Box{});
    sixth := optional_while(m.Box{});
    print("shadow={} tail={} destructured={} iterated={} if={} while={}\n", first == .Missing, second == .Missing, third == .Missing, fourth == .Missing, fifth == .Missing, sixth == .Missing);
    if first == .Missing and second == .Missing and third == .Missing and fourth == .Missing and fifth == .Missing and sixth == .Missing { return 0; }
    1
}
