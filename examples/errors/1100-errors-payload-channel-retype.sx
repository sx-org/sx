// A channel retype carries the tag word into the destination channel's shape.

@import "modules/std.sx";

Narrow :: error { B: i32 };
Wide   :: error { C: i64 };
Both   :: Narrow | Wide;

fromNarrow :: (n: i32) -> (i32, !Narrow) {
    if n < 0 { raise Narrow.B{3}; }
    return n;
}

intoBoth :: (n: i32) -> (i32, !Both) {
    return fromNarrow(n);
}

intoBare :: (n: i32) -> (i32, !) {
    return fromNarrow(n);
}

main :: () -> i32 {
    a := intoBoth(-1) catch |e| { if e == Narrow.B { 1 } else { 2 } };
    print("a={}\n", a);

    b := intoBare(-1) catch { 7 };
    print("b={}\n", b);

    _, e := fromNarrow(-1);
    c : Both = e;
    print("c={}\n", if c == Narrow.B { 3 } else { 4 });
    return 0;
}
