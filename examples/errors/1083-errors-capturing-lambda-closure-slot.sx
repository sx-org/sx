// A capturing lambda needs explicit storage before erasure.

@import "modules/std.sx";

apply :: (f: Closure(i64) -> i64, x: i64) -> i64 { return f(x); }

main :: () -> i32 {
    n := 7;
    h : Closure(i64) -> i64 = |x: i64|_{ n = n } x + n;
    g := |x: i64|_{ n = n } x + n;
    _ := apply(g, 1);

    print("empty {}\n", apply(|x: i64|_{ } x + 1, 1));
    return 0;
}
