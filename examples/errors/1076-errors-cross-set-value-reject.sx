// Cross-set error-set VALUE rejections: a member of `Broad` cannot reach a
// `Narrow` slot implicitly. A member's identity is the pair `(set, member)`, so
// `Broad.Wide` is no more a member of `Narrow` than `Broad.Extra` is, even
// though `Narrow` spells a member `Wide` too. Both sets are u32-backed, so these
// stores are same-width and the reinterpret guard lets them through — the
// membership check is what rejects them.
// The positive cases live in `examples/errors/1075-errors-cross-set-value-coercion.sx`.

@import "modules/std.sx";

Narrow :: error { Wide }
Broad  :: error { Wide; Extra }

broadSrc :: () -> (i32, !Broad) { raise .Extra; }

takeNarrow :: (n: Narrow) -> void { print("{}\n", n); }

Holder :: struct { e: Narrow; }

main :: () -> i32 {
    v, be := broadSrc();

    narrowed : Narrow = be;      // error: neither Broad member is in Narrow
    takeNarrow(be);             // error: same, in argument position
    h := Holder{ e = be };      // error: same, in field-init position

    short : Narrow = .Extra;     // error: Extra not in Narrow
    takeNarrow(.Extra);         // error: same, in argument position
    hs := Holder{ e = .Extra }; // error: same, in field-init position
    if short == .Extra { return 1; }  // error: same, in comparison position
    badRaise() catch {};        // force badRaise to lower
    return 0;
}

// A shorthand raise is membership-checked against the declared channel.
badRaise :: () -> !Narrow {
    raise .Extra;                // error: Extra not in Narrow
}
