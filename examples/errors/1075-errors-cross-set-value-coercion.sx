// Error-set VALUE membership. A member's identity is the pair `(set, member)`,
// so an error-set value reaches a differently-typed slot only when every member
// it can carry is a member of the destination — two sets that merely share a
// member spelling do not.
//
// The rejections live in `examples/errors/1076-errors-cross-set-value-reject.sx`.

@import "modules/std.sx";

Broad  :: error { Wide; Extra }
Other  :: error { Wide }

broadSrc :: () -> (i32, !Broad) { raise .Extra; }
wideSrc  :: () -> (i32, !Broad) { raise .Wide; }

takeBroad :: (b: Broad) -> void { print("param: {}\n", b); }

Holder :: struct { e: Broad; }

main :: () -> i32 {
    v, be := wideSrc();
    same : Broad = be;
    print("decl: {}\n", same);
    takeBroad(be);
    h := Holder{ e = be };
    print("field: {}\n", h.e);

    // `xx` is the escape hatch for a deliberate cross-set store.
    w, xe := broadSrc();
    forced : Other = xx xe;
    print("xx: {}\n", forced);

    // The contextual `.Name` shorthand types itself from the destination set
    // and is membership-checked against it.
    short : Broad = .Extra;
    print("shorthand decl: {}\n", short);
    takeBroad(.Wide);
    sh := Holder{ e = .Extra };
    print("shorthand field: {}\n", sh.e);
    opt : ?Broad = .Wide;
    print("shorthand optional: {}\n", opt?!);
    raisesShorthand() catch |e| { print("shorthand return: {}\n", e); };
    raisesWide() catch |e| { print("shorthand raise: {}\n", e); };

    // A `try` through a same-set channel.
    x := viaBroad() catch |e| { print("propagated: {}\n", e); return 0; };
    return 0;
}

// A pure-failable `return` takes the shorthand; `raisesWide` raises one.
raisesShorthand :: () -> !Broad {
    return .Wide;
}

// `try` on a Broad callee escaping through a Broad channel.
viaBroad :: () -> (i32, !Broad) {
    n := try wideSrc();
    return n;
}

raisesWide :: () -> !Broad {
    raise .Wide;
}
