// Error-set VALUE membership. A member's identity is the pair `(set, member)`,
// so an error-set value reaches a differently-typed slot only when every member
// it can carry is a member of the destination — two sets that merely share a
// member spelling do not.
//
// The rejections live in `examples/errors/1076-errors-cross-set-value-reject.sx`.

@import "modules/std.sx";

Broad  :: error { Wide; Extra }
Other  :: error { Wide }

broad_src :: () -> (i32, !Broad) { raise error.Extra; }
wide_src  :: () -> (i32, !Broad) { raise error.Wide; }

take_broad :: (b: Broad) -> void { print("param: {}\n", b); }

Holder :: struct { e: Broad; }

main :: () -> i32 {
    // Every position takes a value of the channel's own set.
    v, be := wide_src();
    same : Broad = be;
    print("decl: {}\n", same);
    take_broad(be);
    h := Holder{ e = be };
    print("field: {}\n", h.e);

    // `xx` is the escape hatch for a deliberate cross-set store.
    w, xe := broad_src();
    forced : Other = xx xe;
    print("xx: {}\n", forced);

    // The tag literal spelling is membership-checked against the set.
    lit : Broad = error.Extra;
    print("literal: {}\n", lit);

    // The contextual `.Name` shorthand types itself from the destination set
    // in every position `error.Name` does, and means exactly the same member.
    short : Broad = .Extra;
    print("shorthand decl: {}\n", short);
    take_broad(.Wide);
    sh := Holder{ e = .Extra };
    print("shorthand field: {}\n", sh.e);
    opt : ?Broad = .Wide;
    print("shorthand optional: {}\n", opt?!);
    if short == error.Extra { print("spellings agree: {}\n", short == .Extra); }
    raises_shorthand() catch |e| { print("shorthand return: {}\n", e); };
    raises_wide() catch |e| { print("shorthand raise: {}\n", e); };

    // Propagation through a channel of the same set keeps working.
    x := via_broad() catch |e| { print("propagated: {}\n", e); return 0; };
    return 0;
}

// A pure-failable `return` takes the shorthand; `raises_wide` raises one.
raises_shorthand :: () -> !Broad {
    return .Wide;
}

// `try` on a Broad callee escaping through a Broad channel.
via_broad :: () -> (i32, !Broad) {
    n := try wide_src();
    return n;
}

raises_wide :: () -> !Broad {
    raise .Wide;
}
