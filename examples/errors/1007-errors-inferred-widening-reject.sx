// Inferred-set widening rejection. When a named caller (`-> !A`) `try`s a
// bare-`!` callee, the callee's WHOLE-PROGRAM-CONVERGED inferred set must
// be a subset of A. The check reads the SCC-converged tags: an empty
// bare-`!` placeholder would pass it trivially as a false negative.
// `deep`'s converged set is {Foo} (raised transitively through `via`),
// which is not in A = {Bar}. The positive case lives in
// `examples/errors/1006-errors-inferred-error-sets.sx`.

#import "modules/std.sx";

A :: error { Bar }

deep :: () -> ! {
    raise error.Foo;                 // deep's inferred set = {Foo}
}

via :: () -> ! {
    try deep();                      // via absorbs {Foo}
    return;
}

caller :: () -> !A {
    try via();                       // error: Foo (via's converged set) not in A
    return;
}

main :: () -> i32 {
    e := caller();
    return 0;
}
