@import "modules/std.sx";
E :: error { Bad; }
F :: error { Other; }

fail :: () -> (i64, !E) { raise E.Bad; }
pass :: () -> (i64, !E) { return 41; }
zero :: () -> (i64, !E) { return 0; }
other :: () -> (i64, !F) { raise F.Other; }
plain :: () -> i64 { 1 }

run :: (g: () -> (i64, !E)) -> i64 {
    try { x := try g(); x + 1 } catch { -1 }
}

bad :: (g: () -> (i64, !E)) -> bool {
    try { x := try g(); if x > 0 { raise E.Bad; } false } catch |e| { e == .Bad }
}

level :: (g: () -> (i64, !E), h: () -> i64) -> (i64, !) {
    x := try g();
    if x > 0 { raise E.Bad; }
    {
        g : () -> (i64, !F) = other;
        y := try g();
    }
    h()
}

caught :: (g: () -> (i64, !E)) -> i64 {
    level(g, plain) catch |e| { if e == .Bad { 1 } else if e == F.Other { 2 } else { 0 } }
}

main :: () -> i32 {
    print("fail={} pass={} bad={} level={} shadow={}\n", run(fail), run(pass), bad(pass), caught(pass) == 1, caught(zero) == 2);
    0
}
