// `{}` on an error renders the owner and the member it carries (`E.BadDigit`),
// not the raw member id. Works for a bound member, a caught one, and inside
// text.

@import "modules/std.sx";

E :: error { BadDigit; Empty; Overflow }

parse :: (n: i32) -> (i32, !E) {
    if n < 0  { raise .BadDigit; }
    if n == 0 { raise .Empty; }
    return n * 2;
}

main :: () -> i32 {
    a : E = .BadDigit;
    b : E = .Overflow;
    print("a={} b={}\n", a, b);              // a=E.BadDigit b=E.Overflow

    // A tag bound by `catch` interpolates too (diverging handler).
    v := parse(0) catch |e| {
        print("parse failed with {}\n", e);   // parse failed with E.Empty
        return 0;
    };
    print("v={}\n", v);                       // not reached (parse(0) raises E.Empty)
    return 0;
}
