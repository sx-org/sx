// `!` on an error binding is the truthiness complement of `if e`: `!x ≡ x == 0`,
// never a bitwise not — which would leave a nonzero error tag nonzero. Integer
// operands get the same semantics.
@import "modules/std.sx";

E :: error { Boom }

f :: (fail: bool) -> (i64, !E) {
    if fail { raise .Boom; }
    return 42;
}

main :: () -> i32 {
    // set error: `if e` holds, `if !e` must NOT
    v, e := f(true);
    tookE := false;
    if e { tookE = true; }
    if !e { print("BUG: !e held on a set error (v={})\n", v); return 1; }
    if !tookE { print("BUG: if e did not hold on a set error\n"); return 2; }

    // success: `if !e` holds and the value is real
    v2, e2 := f(false);
    if e2 { print("BUG: e2 set on success\n"); return 3; }
    if !e2 { print("ok: !e2 on success, v2={}\n", v2); }

    // integers: `!n` is `n == 0`, not a bit flip
    n := 7;
    if !n { print("BUG: !7 held\n"); return 4; }
    z := 0;
    if !z { print("ok: !0 holds\n"); }

    print("done\n");
    return 0;
}
