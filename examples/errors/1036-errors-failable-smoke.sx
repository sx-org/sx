// End-to-end error handling: failable functions (named + inferred sets) consumed
// through every absorbing form — destructure, `try` (in helpers), `catch` (bare-
// expr / match-body / diverging block / no-binding), `or` value-terminator,
// guarded `defer` cleanup, plus a member as a value and `{}` tag-name
// interpolation.

@import "modules/std.sx";

SmokeErr :: error { Empty; BadDigit; Overflow }
CheckErr :: error { NotReady }
AcquireErr :: error { Acquire }

// value-carrying, named set
smParse :: (n: i32) -> (i32, !SmokeErr) {
    if n < 0  { raise .BadDigit; }
    if n == 0 { raise .Empty; }
    if n > 99 { raise .Overflow; }
    return n * 2;
}

// pure failable, inferred set
smCheck :: (ok: bool) -> ! {
    if !ok { raise CheckErr.NotReady; }
    return;
}

// multi-value, inferred set: `try` propagates; SCC absorbs SmokeErr
smPair :: (a: i32, b: i32) -> (i32, i32, !) {
    x := try smParse(a);
    y := try smParse(b);
    return x, y;
}

// catch with a diverging block body
smOrDefault :: (n: i32) -> i32 {
    return smParse(n) catch |e| {
        print("  logged {}\n", e);
        return -1;
    };
}

// guarded + plain defer interleave: the rollback runs only on the error path
smAcquire :: (fail: bool) -> (i32, !) {
    handed := false;
    defer print("  defer A\n");
    defer if !handed print("  rollback B\n");
    if fail { raise AcquireErr.Acquire; }
    handed = true;
    return 7;
}

// or-chain: try a, fall to try b; propagate if both fail
smFirst :: (a: i32, b: i32) -> (i32, !) {
    v := try smParse(a) ?? try smParse(b);
    return v;
}

// --- Composition: failable closures, widening, generics ---

// Closure(...) param, try-propagated (the env is carried)
smRun :: (cb: Closure(i32) -> (i32, !SmokeErr), n: i32) -> (i32, !SmokeErr) {
    return try cb(n);
}

// bare fn-type param: a NON-failable closure literal widens into the failable
// slot (the ∅-widening adapter wraps `{value, 0}`)
smWiden :: (cb: (i32) -> (i32, !SmokeErr), n: i32) -> i32 {
    return cb(n) catch |e| -1;
}

// generic ($T) value-carrying failable composition, monomorphized per call
smWrap :: ($T: Type, f: Closure() -> (T, !SmokeErr)) -> (T, !SmokeErr) {
    return try f();
}

main :: () {
    // a member as a typed value + {} interpolation renders owner and member
    e0 : SmokeErr = .BadDigit;
    print("tag: {}\n", e0);

    // success destructure + error inspect
    v1, err1 := smParse(5);
    if !err1 { print("parsed: {}\n", v1); }
    v2, err2 := smParse(-1);
    if err2 == .BadDigit { print("got: {}\n", err2); }

    // catch — bare-expr body
    ce := smParse(0) catch |e| 100;
    print("catch-expr: {}\n", ce);

    // catch — match-body per-tag dispatch
    cm := smParse(200) catch |e| match e {
        case .Overflow: 1;
        case .Empty:    2;
        else:           3;
    };
    print("catch-match: {}\n", cm);

    // catch — diverging block (in helper)
    print("or-default ok: {}\n", smOrDefault(5));
    print("or-default err: {}\n", smOrDefault(-5));

    // ?? — value terminator (bare LHS; non-failable result)
    ov := smParse(0) ?? 55;
    print("or-value: {}\n", ov);

    // or-chain via helper (first ok wins; propagation absorbed by destructure)
    g, gerr := smFirst(0, 8);
    if !gerr { print("or-chain: {}\n", g); }

    // multi-value failable consumed by catch (tuple body)
    p, q := smPair(0, 3) catch |e| .{0, 0};
    print("pair-catch: {} {}\n", p, q);
    p2, q2 := smPair(4, 5) catch |e| .{0, 0};
    print("pair-ok: {} {}\n", p2, q2);

    // pure failable: absorb with no-binding catch
    smCheck(false) catch { print("check absorbed\n"); };

    // cleanup interleave on error vs success
    print("acquire fail:\n");
    hv, herr := smAcquire(true);
    print("acquire ok:\n");
    iv, ierr := smAcquire(false);

    // composition: inline failable closure literal through a Closure(...) param
    cl := smRun(|x: i32| -> (i32, !SmokeErr) { if x < 0 { raise .BadDigit; } return x * 2; }, 6) catch |e| -1;
    print("closure-run: {}\n", cl);                                                     // 12
    print("closure-run-err: {}\n", smRun(|x: i32| -> (i32, !SmokeErr) { raise .Empty; }, 1) catch |e| -9); // -9

    // non-failable closure literal widened into the failable bare slot
    print("widen: {}\n", smWiden(|x: i32| -> i32 x + 1, 9));               // 10

    // generic failable composition (monomorphized at i32)
    print("wrap: {}\n", smWrap(i32, || -> (i32, !SmokeErr) { return 42; }) catch |e| 0); // 42

    print("errors ok\n");
}
