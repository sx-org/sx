// Entry-point exit-code truncation (non-failable integer main).
// `main :: () -> T` (integer) exits with the return value truncated to u8 —
// matching C `main` / the OS exit-status byte, so the JIT (`sx run`) and an AOT
// binary agree. Here 1105 & 0xFF == 81, so this program exits 81, not the 1 an
// "out of 0..255 range -> failure" rule would give.

#import "modules/std.sx";

main :: () -> i32 {
    print("returning 1105 -> exit {}\n", 1105 & 0xFF);   // 81
    return 1105;
}
