// A payload-free subset returned into `Bare | Wide` (Wide: i64) is the tag
// in the composition's channel.

@import "modules/std.sx";

Bare :: error { A };
Wide :: error { B: i64 };
Both :: Bare | Wide;

fromBare :: (n: i32) -> (i32, !Bare) {
    if n < 0 { raise Bare.A; }
    return n;
}

intoBoth :: (n: i32) -> (i32, !Both) {
    return fromBare(n);
}

main :: () -> i32 {
    a := intoBoth(-1) catch |e| {
        if e == Bare.A { 1 } else { 2 }
    };
    print("fwd={}\n", a);
    ok := intoBoth(5) catch { -1 };
    print("ok={}\n", ok);
    return 0;
}
