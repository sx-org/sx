// A match (`match subject { case ... }`) whose arms ALL diverge (each
// `return`s) produces no merge phi at all, and a mixed match (some arms
// diverge, some yield values) materializes the merge only from the
// value-producing arms — so no phi operand or fallback `const` is ever
// emitted into a block that has already terminated.

@import "modules/std.sx";

// All arms diverge — the match is `noreturn`, no merge phi.
classify :: (n: i32) -> i32 {
    match n {
        case 0: return 10;
        case 1: return 20;
        else:   return 90;
    }
    return 0;                       // unreachable
}

// Mixed: value arms + a diverging arm.
pick :: (n: i32) -> i32 {
    v := match n {
        case 0: 1;
        case 1: return 100;         // diverging arm — no fallback const after its `ret`
        else:   3;
    };
    return v + 5;
}

main :: () -> i32 {
    r : i32 = 0;
    r = r + classify(0);            // 10
    r = r + classify(1);            // 20
    r = r + classify(7);            // 90
    r = r + pick(0);                // 1 + 5 = 6
    r = r + pick(9);                // 3 + 5 = 8  (else arm)
    print("match result: {}\n", r); // 10+20+90+6+8 = 134
    return r;
}
