// Failable calls in cleanup bodies must be absorbed locally. A `defer` body
// runs while the block is already exiting, so a failable it calls has nowhere
// to propagate — it must be handled in place with `catch` or a `?? <value>`
// terminator. This file shows the accepted forms; the bare (un-absorbed) form
// is rejected in 1049.

@import "modules/std.sx";

E :: error { Bad }

failing :: () -> !E { raise .Bad; }
recover :: () -> (i32, !E) { raise .Bad; }

work :: (n: i32) -> !E {
    defer { failing() catch |e| print("cleanup: caught (catch)\n"); }  // catch absorbs
    defer { x := recover() ?? 7; print("cleanup: x={} (??)\n", x); }   // ??-value absorbs
    if n < 0 { raise .Bad; }
    return;
}

main :: () -> i32 {
    a := work(-1);
    return 0;
}
