// A dot-call on an optional dispatches to the payload's method where narrowing
// proves the optional present, and otherwise to a ufcs taking the optional, so
// where both answer the call's channel has no static member set. A ufcs whose
// receiver refuses the optional leaves the payload's method selected.
@import "modules/std.sx";
A :: error { Bad; }
B :: error { Worse; }
F :: struct {
    close :: (self: *F) -> ! { raise A.Bad; }
    flush :: (self: *F) -> ! { raise A.Bad; }
}
close :: ufcs (o: ?F) -> ! { raise B.Worse; }
flush :: ufcs (f: *F, n: i64) -> ! { if n > 0 { raise B.Worse; } }

shut :: (o: ?F) -> ! { try o.close(); }

drain :: (o: ?F) -> ! {
    if o == null { return; }
    f := o;
    try f.flush();
}

run :: (o: ?F) -> !A { try shut(o); }
runDrain :: (o: ?F) -> !A { try drain(o); }

main :: () {
    o : ?F = F{};
    r := run(o);
    d := runDrain(o);
    print("{} {}\n", r == .Bad, d == .Bad);
}
