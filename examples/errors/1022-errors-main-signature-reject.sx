// Entry-point signature gate. `main` must take no parameters
// and have one of: void, an integer (POSIX exit code), `-> !` (failable, no
// value), or `-> (int, !)` (failable + integer exit code). Anything else is a
// clean diagnostic; the JIT calls main as `() -> i32`, so an unchecked
// `main :: () -> string` would be read as garbage. Accepted shapes are
// exercised elsewhere (238 integer-exit truncation, 244 `-> !`,
// 245 `-> (int, !)`).

@import "modules/std.sx";

main :: () -> string {        // ERROR: return type must be void, an integer, or `!`
    return "not an exit code";
}
