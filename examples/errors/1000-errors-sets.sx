// Error-set declarations + member values + enum-like `==` typing.
// A declared `error { ... }` set is a real type with a u32 runtime layout;
// `.X` is its member value against a set-typed destination
// (membership-checked). Members compare with a `.X` shorthand or another
// error-set value, and `xx` coerces one to its raw id. The rejections live in
// `examples/218-error-set-typing.sx`.

@import "modules/std.sx";

ParseErr :: error { BadDigit; Overflow; Empty }

main :: () -> i32 {
    c : ParseErr = .BadDigit;
    d : ParseErr = .Overflow;
    r : i32 = 0;
    if c == .BadDigit { r = r + 1; }    // true  -> +1
    if c == .Overflow { r = r + 2; }     // false
    if c == d              { r = r + 4; }     // false (BadDigit != Overflow)
    if d == .Overflow { r = r + 8; }     // true  -> +8
    tag : u32 = xx ParseErr.Empty;            // `xx` coerces to the raw member id
    if tag != 0 { r = r + 16; }               // tag ids are >= 1 -> +16
    print("error-set result: {}\n", r);       // -> 25
    return r;
}
