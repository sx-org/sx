// Forwarding a failable result across error sets via `return callee(...)`.
//
// Every error channel is one shared u32 repr — a member id, 0 = "no error" —
// so a concrete error set forwards soundly through the open bare-`!` channel:
// the compiler re-packs the value slots plus the raw member. Covered here:
// - concrete `!MyErr` → bare `!`, success value forwards;
// - concrete → bare, ERROR forwards and the member keeps its identity
//   (`catch` sees `MyErr.Boom`);
// - matched-set forward (`!MyErr` → `!MyErr`) still works;
// - multi-value `(i64, i64, !MyErr)` → `(i64, i64, !)`;
// - pure failable `!MyErr` → `!` and `!MyErr` → `!MyErr`;
// - `try` / `or` interop with a forwarded result;
// - the arity/slot-fit TIE-BREAK: a returned VALUE tuple whose last element
//   is error-set-typed (`return v, e` into `(i64, MyErr, !)`) is the value
//   list, NOT a forward.
// (Bare `!` → NAMED set is rejected — the inferred set can't be proven ⊆;
// see examples/diagnostics/1222-diagnostics-failable-forward-mixtures.sx.)

@import "modules/std.sx";

MyErr :: error { Boom }

inner :: (x: i64) -> (i64, !MyErr) {
    if x < 0 { raise .Boom; }
    return x;
}

// concrete → bare `!`
fwd :: (x: i64) -> (i64, !) {
    return inner(x);
}

// matched set: concrete → same concrete
fwdSame :: (x: i64) -> (i64, !MyErr) {
    return inner(x);
}

// multi-value concrete → bare
inner2 :: (x: i64) -> (i64, i64, !MyErr) {
    if x < 0 { raise .Boom; }
    return x, x + 1;
}
fwd2 :: (x: i64) -> (i64, i64, !) {
    return inner2(x);
}

// pure failable concrete → bare
check :: (x: i64) -> !MyErr {
    if x < 0 { raise .Boom; }
}
fwdPure :: (x: i64) -> ! {
    return check(x);
}

// pure same-set forward (concrete → concrete)
checkSame :: (x: i64) -> !MyErr {
    return check(x);
}

// TIE-BREAK: `return v, e` where the second VALUE slot is error-set-typed —
// the tuple fits the value slots exactly, so it is the value list, not a
// forward (the type is indistinguishable from a failable `(i64, !MyErr)`).
pair :: () -> (i64, MyErr, !) {
    v, e := inner(-1);
    if e { return 0, e; }
    return v, e;
}

// `try` on a forwarded result propagates through the caller's bare channel
useTry :: (x: i64) -> (i64, !) {
    v := try fwd(x);
    return v + 1;
}

main :: () -> i32 {
    // success value forwards
    v, e := fwd(5);
    if e { return 1; }
    print("fwd(5) = {}\n", v);

    // error forwards; the member keeps its identity through bare `!`
    _, e2 := fwd(-1);
    if !e2 { return 2; }
    if e2 != MyErr.Boom { return 3; }
    print("fwd(-1) raises Boom\n");

    // catch interop on the forwarded result
    c := fwd(-1) catch |ce| {
        if ce != MyErr.Boom { return 4; }
        print("caught Boom\n");
        -7
    };
    print("catch fallback = {}\n", c);

    // matched-set forward untouched
    s, es := fwdSame(6);
    if es { return 5; }
    print("fwdSame(6) = {}\n", s);

    // multi-value forward, both slots + error path
    a, b, em := fwd2(10);
    if em { return 8; }
    print("fwd2(10) = {}, {}\n", a, b);
    _, _, em2 := fwd2(-1);
    if em2 != MyErr.Boom { return 9; }

    // pure failable forward
    ep := fwdPure(1);
    if ep { return 10; }
    ep2 := fwdPure(-1);
    if ep2 != MyErr.Boom { return 11; }
    print("fwdPure ok\n");

    // pure same-set forward
    eq := checkSame(-1);
    if eq != MyErr.Boom { return 13; }
    if checkSame(1) { return 15; }
    print("pure same ok\n");

    // tie-break: value tuple with an error-set-typed slot is the value list
    pv, pe, pee := pair();
    if pee { return 17; }
    if pe != .Boom { return 18; }
    print("pair = {}, Boom-as-value\n", pv);

    // try / ?? interop
    t, et := useTry(4);
    if et { return 12; }
    o := fwd(-1) ?? 90;
    print("try = {}, ?? = {}\n", t, o);

    return xx v;   // 5
}
