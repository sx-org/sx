// A dot-call on a generic-instance receiver contributes the method its own
// module's template authors: `a.Box(i64)` selects `a`'s `go`, `b.Box(i64)`
// selects `b`'s, through a parameter, an annotated local and a `for` capture.
// The free `go` is not declared `ufcs`, so it contributes to none of them.

@import "modules/std.sx";
a :: @import "2692-errors-generic-receiver-selects-its-own-method/a.sx";
b :: @import "2692-errors-generic-receiver-selects-its-own-method/b.sx";

Other :: error { Wrong; }
go :: (x: i64) -> (i64, !Other) { raise Other.Wrong; }

viaA :: (x: *a.Box(i64)) -> ! { r := try x.go(); }
viaB :: (x: *b.Box(i64)) -> ! { r := try x.go(); }
locA :: () -> ! { x : a.Box(i64) = .{ v = 1 }; r := try x.go(); }
locB :: () -> ! { x : b.Box(i64) = .{ v = 1 }; r := try x.go(); }
loopB :: (xs: []b.Box(i64)) -> ! { for x in xs { r := try x.go(); } }

main :: () -> i32 {
    ba : a.Box(i64) = .{ v = 1 };
    bb : b.Box(i64) = .{ v = 1 };
    arr : [1]b.Box(i64) = .[bb];
    ea := viaA(*ba);
    eb := viaB(*bb);
    la := locA();
    lb := locB();
    fb := loopB(arr);
    print("viaA={} {}\nviaB={} {}\nlocA={} {}\nlocB={} {}\nloopB={} {}\n", ea, ea == .Alpha, eb, eb == .Beta, la, la == .Alpha, lb, lb == .Beta, fb, fb == .Beta);
    if ea == .Alpha and eb == .Beta and la == .Alpha and lb == .Beta and fb == .Beta { return 0; }
    1
}
