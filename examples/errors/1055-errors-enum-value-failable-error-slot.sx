// Enum-valued value-carrying failable: the SUCCESS path zeroes the trailing
// error slot. A `-> (Enum, !E)` `return .variant` resolves the enum literal
// against the function's VALUE type (the enum), not the failable tuple, so the
// success-return lowering never mistakes it for a forwarded full tuple.
//
// This pins the slot at RUNTIME on the success path (e.(i64), bare `if e`,
// and `e == .X`) — not only via the `if !e` proof that the compiler can
// fold away. It also exercises a non-zero ordinal (`.blue` = 2) so a value slot
// that collapses to 0 is caught, and asserts the error PATH still carries the
// right tag and `@errorName`.

@import "modules/std.sx";

Color :: enum { red; green; blue; }
E :: error { Nope }

pick :: (s: string) -> (Color, !E) {
    if s == "red"  { return .red; }
    if s == "blue" { return .blue; }       // non-zero ordinal (2)
    raise .Nope;
}

main :: () -> i32 {
    // ── success path: error slot MUST read 0 at runtime ──
    c, e := pick("red");
    print("success err int = {}\n", e.(i64));             // 0
    if e { print("bare-if e: ERROR (WRONG)\n"); } else { print("bare-if e: ok\n"); }
    if e == .Nope { print("e == Nope (WRONG)\n"); } else { print("e != Nope (ok)\n"); }
    if !e { print("guard !e: c = {}\n", c.(i64)); }        // 0 (red)

    // ── non-zero ordinal: value slot must carry the real ordinal ──
    c2, e2 := pick("blue");
    if !e2 { print("blue: err int = {}, c = {}\n", e2.(i64), c2.(i64)); }  // 0, 2

    // ── error path: the right tag flows through ──
    c3, e3 := pick("xxx");
    print("error err nonzero = {}\n", e3.(i64) != 0);     // true (ordinal is program-global, not pinned)
    if e3 == .Nope { print("error: is Nope (ok)\n"); } else { print("error: not Nope (WRONG)\n"); }
    print("error tag name = {}\n", @errorName(e3));       // E.Nope

    return 0;
}
