// `try { block }` is an error boundary of its own: the `try`s and `raise`s
// inside it converge to the block's channel and exit there rather than through
// the enclosing function, and the block's last expression is the success value.
// `caught` therefore converges to IoErr alone and forwards into a `!IoErr`
// return, while the uncaught boundary in `escapes` propagates FooError to its
// caller. `catch` is that `try`'s own fallback, so `try g(-1) catch { … }` and
// `g(-1) catch { … }` are the same expression; `must(-1) catch {}` absorbs.
// A boundary is a cleanup boundary too — its `defer`s run on the way out — and
// the enclosing function need not be failable at all. The boundary is the error
// exit a propagating `??` takes, and a `try { … }` is itself a failable `??`
// operand. A block with no tail value is a pure failable, so its `catch` stands
// as a statement. A nested boundary hands the outer one back, so the `try`
// after it exits through the outer block. A `catch` absorbs exactly what it
// attempts, so a `try` sitting in its operand exits through the enclosing
// channel.

@import "modules/std.sx";

FooError :: error { A }
IoErr    :: error { Failed; Canceled }

g :: (n: i32) -> (i32, !FooError) {
    if n < 0 { raise FooError.A; }
    return n;
}

h :: (x: i32) -> (i32, !IoErr) {
    if x == 9 { raise IoErr.Failed; }
    return x;
}

must :: (n: i32) -> !FooError {
    if n < 0 { raise FooError.A; }
}

caught :: (n: i32) -> (i32, !) {
    v := try {
        if n == 0 { raise FooError.A; }
        try g(n);
        5
    } catch { -1 };
    if n == 7 { raise IoErr.Failed; }
    return v;
}

narrowed :: (n: i32) -> (i32, !IoErr) {
    return caught(n);
}

escapes :: (n: i32) -> (i32, !FooError) {
    return try { try g(n); n * 2 };
}

forwarded :: (n: i32) -> (i32, !) {
    return h(try g(n)) catch { 0 };
}

boundaryArg :: (n: i32) -> i32 {
    return try { h(try g(n)) catch { 0 } } catch { -1 };
}

withDefer :: (n: i32, seen: *i32) -> i32 {
    return try {
        defer { seen.* = seen.* + 1; }
        try g(n);
        n
    } catch { -1 };
}

pure :: (n: i32) -> i32 {
    try { try must(n); } catch {};
    return 1;
}

nested :: (n: i32) -> i32 {
    return try {
        inner := try { try g(n); 2 } catch { 3 };
        try g(n);
        inner + 10
    } catch { -1 };
}

parse :: (n: i32) -> (i32, i32, !FooError) {
    if n < 0 { raise FooError.A; }
    return .{n * 2, n + 1};
}

raiseTail :: () -> i32 {
    return try { raise FooError.A; 5 } catch { -1 };
}

slots :: (n: i32) -> i32 {
    v, b := try { try parse(n) } catch { .{0, 0} };
    return v + b;
}

orInside :: () -> i32 {
    return try { try g(-1) ?? try g(-2) } catch { -1 };
}

orOperand :: (n: i32) -> i32 {
    return try { try g(n); 5 } ?? 9;
}

main :: () -> i32 {
    print("caughtRaise={}\n", caught(0) catch { -9 });
    print("caughtTry={}\n", caught(-1) catch { -9 });
    print("caughtOk={}\n", caught(3) catch { -9 });
    print("narrowed={}\n", narrowed(7) catch |e| { if e == IoErr.Failed { 70 } else { 71 } });
    print("escapesOk={}\n", escapes(4) catch { -9 });
    print("escapesErr={}\n", escapes(-1) catch |e| { if e == FooError.A { 40 } else { 41 } });
    print("forwardedOk={}\n", forwarded(3) catch { -9 });
    print("forwardedAbsorbed={}\n", forwarded(9) catch { -9 });
    print("forwardedErr={}\n", forwarded(-1) catch { -9 });
    print("boundaryArgOk={}\n", boundaryArg(3));
    print("boundaryArgErr={}\n", boundaryArg(-1));

    seen := 0;
    print("deferErr={} seen={}\n", withDefer(-1, *seen), seen);
    print("deferOk={} seen={}\n", withDefer(6, *seen), seen);

    print("pure={}\n", pure(-1));
    print("nestedErr={}\n", nested(-1));
    print("nestedOk={}\n", nested(1));

    print("raiseTail={}\n", raiseTail());
    print("slotsOk={}\n", slots(5));
    print("slotsErr={}\n", slots(-1));
    print("orInside={}\n", orInside());
    print("orOperand={}\n", orOperand(-1));

    print("marked={}\n", try g(-1) catch { -1 });
    print("bare={}\n", g(-1) catch { -1 });
    must(-1) catch {};
    return 0;
}
