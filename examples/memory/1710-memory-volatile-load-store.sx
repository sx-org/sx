// Volatile load/store: the access is emitted exactly as written. Three reads
// and a write share one address with nothing between them, so a plain
// load/store pair would collapse to a single register value — each volatile
// access survives instead, and none of them carries an atomic ordering
// (volatile is not atomic; see modules/std/core.sx).
// The intrinsics resolve with no import, like `size_of`; `out` is what needs one.
#import "modules/std/core.sx";

Point :: struct {
    x: i32;
    y: i32;
}

main :: () {
    slot: i32 = 41;
    address := *slot;

    first := @volatile_load(i32, address);
    second := @volatile_load(i32, address);
    @volatile_store(i32, address, second + 1);
    third := @volatile_load(i32, address);

    if first == 41 and second == 41 and third == 42 {
        out("scalar: 41 41 42\n");
    } else {
        out("scalar: WRONG\n");
    }

    // Aggregates travel as one typed access, not field by field.
    point := Point{ x = 3, y = 4 };
    snapshot := @volatile_load(Point, *point);
    @volatile_store(Point, *point, Point{ x = snapshot.y, y = snapshot.x });

    if point.x == 4 and point.y == 3 {
        out("aggregate: 4 3\n");
    } else {
        out("aggregate: WRONG\n");
    }
}
