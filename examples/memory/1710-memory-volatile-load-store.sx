// The access is emitted exactly as written. Three reads and a write share one
// address with nothing between them, so a plain load/store pair would collapse
// to a single register value — each volatile access survives instead, and none
// of them carries an atomic ordering (volatile is not atomic; see
// modules/std/core.sx).
@import "modules/std/core.sx";

Point :: struct {
    x: i32;
    y: i32;
}

main :: () {
    out := FdWriter.init(.stdout);
    slot: i32 = 41;
    address := *slot;

    first := @volatileLoad(i32, address);
    second := @volatileLoad(i32, address);
    @volatileStore(i32, address, second + 1);
    third := @volatileLoad(i32, address);

    if first == 41 and second == 41 and third == 42 {
        out.write("scalar: 41 41 42\n");
    } else {
        out.write("scalar: WRONG\n");
    }

    // `value: T` converts like any typed parameter, so a signed i32 widens by
    // sign rather than by its 32-bit pattern.
    wide: i64 = 0;
    narrow: i32 = -1;
    @volatileStore(i64, *wide, narrow);

    if @volatileLoad(i64, *wide) == -1 {
        out.write("widened: -1\n");
    } else {
        out.write("widened: WRONG\n");
    }

    // `T` alone fixes the access width. The address is a narrower view of the
    // same slot, and the store through it still writes all eight bytes.
    viewed: i64 = 0;
    view: *i32 = @reinterpret(*i32, *viewed);
    @volatileStore(i64, view, -1);

    if @volatileLoad(i64, view) == -1 {
        out.write("viewed: -1\n");
    } else {
        out.write("viewed: WRONG\n");
    }

    // Aggregates travel as one typed access, not field by field.
    point := Point{ x = 3, y = 4 };
    snapshot := @volatileLoad(Point, *point);
    @volatileStore(Point, *point, Point{ x = snapshot.y, y = snapshot.x });

    if point.x == 4 and point.y == 3 {
        out.write("aggregate: 4 3\n");
    } else {
        out.write("aggregate: WRONG\n");
    }
}
