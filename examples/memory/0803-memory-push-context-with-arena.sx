// `push <Context>` of a WHOLE Context value whose `allocator` field is an
// `inline`-kind protocol carrying an `Arena` upcast. The value is seeded from the
// ambient context (`newCtx := context`) so every other capability — builtin
// or `@context.extend`ed — carries through, then the one field is overwritten.
// Exercises save/restore of the boxed context across the push.

@import "modules/std.sx";
@import "modules/std/mem.sx";

main :: () -> void {
    arena := Arena.init(context.allocator, 4096);

    newCtx := context;
    newCtx.allocator = arena;
    push newCtx {
        ptr := context.allocator.allocBytes(128);
        out("inside push\n");
    }
    out("after push\n");
}
