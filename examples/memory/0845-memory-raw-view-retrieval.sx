// Raw-view retrieval through the shared xx/.(T) conversion engine: the
// fat-value views @Closure {fnPtr, env}, @Slice {ptr, len} (slices AND
// strings), and @Protocol {ctx, typeId} come back via `v.(@Protocol)` or
// `xx v`. The protocol pair is a MODELED conversion built field-wise —
// {ctx, typeId} is the prefix BOTH protocol layouts share (default
// {ctx, typeId, vtable} and `inline` {ctx, typeId, fn_ptrs…}),
// byte-identical to an any {data, typeId} — never a bit reinterpret, so
// an `inline`-kind value can't leak a wrong word and the result is a real value
// that works in ARG POSITION (a reinterpret width-mismatched there).
// Recovery targets are exempt from the phase-2 downcast refusal; other
// concrete targets on a protocol receiver go through the downcast.
@import "modules/std.sx";
@import "modules/std/mem.sx";

Sizable :: interface { size :: (self: *Self) -> i64; }
Widget :: struct { value: i64; }
impl Sizable for Widget { size :: (self: *Widget) -> i64 { self.value } }

take_raw :: (r: @Protocol) -> *void { r.ctx }

main :: () {
    // closure -> @Closure, both spellings
    n := 10;
    cl : Closure(i64) -> i64 = closure(|x: i64|_{ n } -> i64 { x + n });
    r1 : @Closure = xx cl;
    r2 := cl.(@Closure);
    print("closure: {} {}\n", r1.fnPtr == r2.fnPtr, r1.env == r2.env);

    // slice and string -> @Slice
    s : []i64 = .[1, 2, 3];
    print("slice: {} {}\n", s.(@Slice).ptr == xx s.ptr, s.(@Slice).len);
    t := "hey";
    print("string: {}\n", t.(@Slice).len);

    // interface handle -> @Protocol, both spellings. The handle BORROWS, so
    // the recovered pointer IS w's address.
    w := Widget{ value = 7 };
    sz := w.(Sizable);
    pr : @Protocol = xx sz;
    wc : *Widget = xx sz.(@Protocol).ctx;
    print("default: {} {}\n", wc.value == 7 and sz.(@Protocol).ctx == *w, pr.ctx == sz.(@Protocol).ctx);
    print("default typeId: {}\n", sz.(@Protocol).typeId == @typeOf(sz));

    // protocol (`inline` layout, Allocator) — correct ctx, no layout lie
    ga := GPA.init();
    a : Allocator = ga;
    print("inline: {}\n", a.(@Protocol).ctx == *ga);
    print("inline typeId: {}\n", a.(@Protocol).typeId == @typeOf(a));

    // a real constructed value: passes through call args
    print("arg: {}\n", take_raw(a.(@Protocol)) == *ga);

    // parity with the typed ctx-pointer recovery
    p : *void = xx a;
    print("parity: {}\n", a.(@Protocol).ctx == p);
}
