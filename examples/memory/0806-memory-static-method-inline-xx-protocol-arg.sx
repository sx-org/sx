// Inline `xx` cast as the first argument to a struct static method takes its
// target type from the leading param, so an `xx ptr` targeting a protocol
// param erases to that protocol rather than falling back to i64.
//
// Three call shapes:
// 1. Named-variable receiver: `a : Allocator = xx p; T.init(a, ...)`
// 2. Free function with inline xx: `makeT(xx p, ...)`
// 3. Static method with inline xx: `T.init(xx p, ...)`

@import "modules/std.sx";
@import "modules/std/mem.sx";

Box :: struct {
    parent: Allocator;
    firstPtr: *void;

    init :: (parentAlloc: Allocator, size: i64) -> *Box {
        self : *Box = xx c.libcMalloc(@sizeOf(Box));
        self.parent = parentAlloc;
        self.firstPtr = self.parent.allocBytes(size);
        self
    }
}

makeBox :: (parentAlloc: Allocator, size: i64) -> *Box {
    self : *Box = xx c.libcMalloc(@sizeOf(Box));
    self.parent = parentAlloc;
    self.firstPtr = self.parent.allocBytes(size);
    self
}

main :: () -> i32 {
    gGpa : GPA = .{ allocCount = 0 };

    a : Allocator = xx *gGpa;
    b1 := Box.init(a, 64);
    print("Box.init (named-var):  ok\n");

    b2 := makeBox(xx *gGpa, 64);
    print("makeBox (inline-xx):  ok\n");

    b3 := Box.init(xx *gGpa, 64);
    print("Box.init (inline-xx):  ok\n");

    0
}
