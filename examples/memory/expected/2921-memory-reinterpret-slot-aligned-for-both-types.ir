
@kDefaultContext = internal constant {} zeroinitializer

; Function Attrs: nounwind
define i32 @main() #0 {
entry:
  %alloca = alloca [4 x i8], align 1
  store [4 x i8] c"\01\00\00\00", ptr %alloca, align 1
  %load = load [4 x i8], ptr %alloca, align 1
  %allocaN = alloca i32, align 4
  store [4 x i8] %load, ptr %allocaN, align 1
  %loadN = load i32, ptr %allocaN, align 4
  ret i32 %loadN
}
