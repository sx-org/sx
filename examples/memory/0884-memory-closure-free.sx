// `mem.free(a, cl)` releases a closure's heap `env` — the environment
// `mem.closure(f)` copied out through the then-current `context.allocator` —
// through `a`. A capture-free closure carries a null env, so freeing it
// reaches no allocator.
@import "modules/std.sx";
@import "modules/std/mem.sx";

main :: () {
    gpa := mem.GPA.init();
    ta := mem.TrackingAllocator.init(gpa);

    // `mem.closure` funds the env from the pushed tracker, which is still
    // `context.allocator` at the free.
    r := 0;
    push .{ allocator = ta } {
        n := 40;
        cl : Closure(i64) -> i64 = mem.closure(|x: i64|_{ n } -> i64 { x + n });
        r = cl(2);
        mem.free(context.allocator, cl);
    }
    print("call: {}\n", r);
    print("context form: allocs {} outstanding {}\n", ta.allocCount, ta.leakCount());

    // The env is funded under the push and freed after it, through `ta`.
    cl2 := |x: i64| -> i64 { x };
    push .{ allocator = ta } {
        m := 7;
        cl2 = mem.closure(|x: i64|_{ m } -> i64 { x * m });
    }
    r2 := cl2(6);
    mem.free(ta, cl2);
    print("call: {}\n", r2);
    print("explicit form: allocs {} outstanding {}\n", ta.allocCount, ta.leakCount());

    // A capture-free closure's env is null: no dealloc reaches `ta`.
    before := ta.deallocCount;
    k := |x: i64| -> i64 { x * 2 };
    mem.free(ta, k);
    print("null env: no-op {}\n", ta.deallocCount == before);
}
