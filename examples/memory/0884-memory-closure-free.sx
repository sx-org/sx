// An explicit allocator pairs closure release across a context change.
@import "modules/std.sx";
@import "modules/std/mem.sx";

main :: () {
    gpa := mem.GPA.init();
    ta := mem.TrackingAllocator.init(gpa);

    r := 0;
    push .{ allocator = ta } {
        n := 40;
        cl : Closure(i64) -> i64 = mem.closure(|x: i64|_{ n } -> i64 { x + n });
        r = cl(2);
        mem.free(cl);
    }
    print("call: {}\n", r);
    print("context form: allocs {} outstanding {}\n", ta.allocCount, ta.leakCount());

    cl2 := |x: i64| -> i64 { x };
    push .{ allocator = ta } {
        m := 7;
        cl2 = mem.closure(|x: i64|_{ m } -> i64 { x * m });
    }
    r2 := cl2(6);
    mem.free(cl2, ta);
    print("call: {}\n", r2);
    print("explicit form: allocs {} outstanding {}\n", ta.allocCount, ta.leakCount());

    before := ta.deallocCount;
    k := |x: i64| -> i64 { x * 2 };
    mem.free(k, ta);
    print("null env: no-op {}\n", ta.deallocCount == before);
}
