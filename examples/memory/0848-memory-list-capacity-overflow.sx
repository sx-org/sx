// A capacity past `i64.max / @sizeOf(T)` has no representable byte count, so
// `growTo` aborts instead of multiplying into a wrapped allocation size.
//
// aborts (exit 134) after the message — macOS-pinned.
@import "modules/std.sx";

main :: () {
    xs : List(i64) = .{};
    xs.ensureCapacity(i64.max / @sizeOf(i64) + 1);
}
