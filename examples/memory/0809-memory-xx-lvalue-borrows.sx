// A named allocator at an `Allocator` slot borrows the operand's storage.
// Mutations through the protocol are visible to the original.
//
// The witness is TrackingAllocator: incrementing the parent allocator's
// counter happens through the Allocator protocol value, and the local sees
// the increments because they ARE the local's.
@import "modules/std.sx";
@import "modules/std/mem.sx";

main :: () -> i32 {
    gpa := GPA.init();
    tracker := TrackingAllocator.init(gpa);

    push .{ allocator = tracker } {
        p := context.allocator.allocBytes(128);
        context.allocator.deallocBytes(p);
    }

    print("allocCount   = {}\n", tracker.allocCount);
    print("deallocCount = {}\n", tracker.deallocCount);
    return 0;
}
