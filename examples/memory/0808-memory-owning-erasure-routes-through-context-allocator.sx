// The compiler-internal heap-copy that backs the owning erasure
// `expr.(P)` dispatches through `context.allocator`, not libc malloc
// directly. So when a `push .{ allocator = tracer }` block is active,
// a `StructLiteral{}.(P)` inside it is allocated by the tracker.
//
// Only the postfix owning spellings allocate; an implicit erasure
// (bare operand or `xx`) never does — every shape at a value/own
// target is the demand error, pinned in diagnostics/1256.
#import "modules/std.sx";
#import "modules/std/mem.sx"; // `Allocator` is non-transitive: name it, import it.

Tracer :: struct {
    count: i64;

    init :: () -> *Tracer {
        t : *Tracer = xx c.libc_malloc(size_of(Tracer));
        t.count = 0;
        t
    }
}

impl Allocator for Tracer {
    alloc_bytes :: (self: *Tracer, size: i64) -> *void {
        self.count += 1;
        return c.libc_malloc(size);
    }
    dealloc_bytes :: (self: *Tracer, ptr: *void) {
        c.libc_free(ptr);
    }
}

// The owning-erasure target must be a VALUE/OWN protocol — `Allocator`
// itself is `#identity` (borrow-only; rvalue erasure to it refuses,
// pinned in diagnostics/1255), and erasure is impl-driven,
// so a small owning protocol impl'd by Tracer stands in.
Boxed :: protocol vtable { count_of :: (self: *Self) -> i64; }
impl Boxed for Tracer {
    count_of :: (self: *Tracer) -> i64 { self.count }
}

main :: () -> i32 {
    tracer := Tracer.init();
    push .{ allocator = tracer } {
        // Struct-literal receiver: the owning copy allocates through
        // context.allocator — i.e. through the pushed tracer.
        ignore := Tracer{ count = 0 }.(Boxed);
        _ = ignore;
    }
    print("Tracer.count = {}\n", tracer.count);
    0
}
