// Zero is the empty request and null is the empty answer: every allocator
// returns null for `allocBytes(0)` and allocates nothing, and
// `deallocBytes(null)` does nothing. So `create` / `make` of a zero-sized
// type hand back null, `make` writes no initializer into it, and nothing is
// funded — which is what lets a capture-free environment be erased without
// reaching the heap.

@import "modules/std.sx";
@import "modules/std/mem.sx";

Empty :: struct {}
Cell :: struct { v: i64; }

main :: () {
    gpa := GPA.init();
    a := gpa.(Allocator);

    raw := a.allocBytes(0);
    a.deallocBytes(null);
    one := create(a, Empty);
    two := make(a, Empty{});
    many := alloc(a, Empty, 4);
    print("bytes {} create {} make {} alloc {}\n", raw == null, one == null, two == null, many.ptr == null);
    print("outstanding {}\n", gpa.allocCount);

    // A refused allocation is the same shape: no write into a null destination.
    buf : [8]u8 = ---;
    small := BufAlloc.init(*buf[0], 8);
    first := make(small, Cell{ v = 1 });
    print("granted {}\n", first != null and first.v == 1);
    print("refused {}\n", make(small, Cell{ v = 2 }) == null);

    arena := Arena.init(a, 256);
    print("arena {}\n", arena.allocBytes(0) == null);
    arena.deinit();

    tracker := TrackingAllocator.init(a);
    tracker.deallocBytes(null);
    print("tracked {} {}\n", tracker.allocCount, tracker.deallocCount);
}
