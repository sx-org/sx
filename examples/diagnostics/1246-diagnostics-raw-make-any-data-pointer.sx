// rawMakeAny REFUSES a non-pointer 'data' operand at compile time —
// welding a plain value (or an `any` box) into the view's data slot is
// never meaningful, and the runtime contract (data points at a live,
// aligned value of tp) could not catch it.

@import "modules/std.sx";

main :: () -> i64 {
    x : i64 = 42;
    bad := rawMakeAny(i64, x);        // error: data must be a pointer
    ax : any = x;
    bad2 := rawMakeAny(i64, ax);      // error: an any is not a data pointer
    ok := rawMakeAny(i64, *x);       // fine: the value's address
    print("{}\n", ok.(i64));
    if @typeOf(bad) == @typeOf(bad2) {}
    return 0;
}
