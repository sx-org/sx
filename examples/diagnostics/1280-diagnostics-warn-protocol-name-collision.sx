// The second `.warn` producer: a protocol whose type-arg and method share a
// name is legal, and the warning tells the reader that `..pack.value`
// resolves by position. Like every warning it must render on a clean
// compile. This one carries no span, so it renders as a bare
// header line with no source excerpt.

@import "modules/std.sx";

Boxed :: constraint(value: Type) {
    value :: (self: *Self) -> i64;
}

main :: () -> i32 {
    print("ok\n");
    0
}
