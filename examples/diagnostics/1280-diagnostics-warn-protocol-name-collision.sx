// A constraint whose type-arg and method share a name is legal, and the
// warning tells the reader that `..pack.value` resolves by position. Like
// every warning it renders on a clean compile, located at the method's name.

@import "modules/std.sx";

Boxed :: constraint(value: Type) {
    value :: (self: *Self) -> i64;
}

main :: () -> i32 {
    print("ok\n");
    0
}
