// `#expand` names WHERE a tagged protocol's dispatch switch stands. The
// erased kinds have no switch — an `inline` value carries its fn-ptrs and
// calls one indirectly — so the attribute is refused at the declaration.
#import "modules/std.sx";

Hasher :: protocol inline #expand {
    put :: (self: *Self, byte: u8);
}

main :: () { print("unreachable\n"); }
