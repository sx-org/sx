// Slicing a TEMPORARY (non-addressable) array is rejected. A slice is a zero-copy
// view into an array's backing storage (specs.md §Subslicing), and a temporary —
// here the result of a call returning `[3]i64` — has none, so the view would
// dangle the moment the statement ends. The diagnostic steers the user to bind the
// array to a local first.
#import "modules/std.sx";

make_arr :: () -> [3]i64 {
    a : [3]i64 = ---;
    a[0] = 1; a[1] = 2; a[2] = 3;
    return a;
}

main :: () -> i32 {
    sl : []i64 = make_arr()[0..2];   // error: cannot slice a temporary array
    print("{}\n", sl[0]);
    0
}
