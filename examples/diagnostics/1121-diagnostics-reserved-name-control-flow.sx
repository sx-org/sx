// Reserved/builtin type names are rejected as binding NAMES across every
// control-flow and destructuring form: a destructure name (`i2`), an `if`/`while`
// optional binding (`u8`/`i16`), a `for` capture and index name (`bool`/`i32`),
// and a match-arm capture (`string`). One exhaustive binding-name walk covers
// every syntactic binding form, so each offending name gets its own error.
#import "modules/std.sx";

pair :: () -> Tuple(i64, i64) { .{1, 2} }
maybe :: () -> ?i64 { return null; }

main :: () -> i32 {
    i2, rest := pair();                  // destructure name
    if u8 := maybe() { }                 // if optional binding
    while i16 := maybe() { break; }      // while optional binding
    xs: [3]i64 = .{ 10, 20, 30 };
    for bool in xs { }                   // for capture name
    for v, i32 in xs, 0.. { }            // for index name
    opt: ?i64 = 5;
    r := match opt {                     // match-arm capture
        case .some: |string| { 0 }
        case .none: { 0 }
    };
    return 0;
}
