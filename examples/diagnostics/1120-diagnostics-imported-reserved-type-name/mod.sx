@import "modules/std.sx";

Box :: struct { total: i64 = 0; count: i64 = 0; }

update :: ufcs (self: *Box, n: i64) {
    self.total += n;
    self.count += 1;
}

run_imported_reserved_name :: () -> i32 {
    i8 := Box{ total = 0, count = 0 };
    update(*i8, 5);
    i8.update(7);
    print("imported i8 total={} count={}\n", i8.total, i8.count);
    return 0;
}
