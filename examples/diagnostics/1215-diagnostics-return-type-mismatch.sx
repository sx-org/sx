// Returning a value whose type has NO coercion to the declared return type is a
// compile error. Both the trailing-expression and the explicit-`return` forms
// diagnose.
@import "modules/std.sx";

bad_trailing :: () -> i64 { "not an int" }
bad_explicit :: () -> i64 { return "also not an int"; }

main :: () {
    print("{}\n", bad_trailing());
    print("{}\n", bad_explicit());
}
