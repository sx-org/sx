// Passing a default-conv sx function as a abi(.c) fn-pointer
// silently mismatches ABIs — the C-side caller supplies no `__sx_ctx`
// slot 0 and the sx-side body reads garbage.
// The compiler rejects the coercion outright with a "call-convention
// mismatch" diagnostic.

#import "modules/std.sx";

sx_handler :: (arg: *void) -> *void { return arg; }

main :: () -> i32 {
    fp : (*void) -> *void abi(.c) = sx_handler;
    return 0;
}
