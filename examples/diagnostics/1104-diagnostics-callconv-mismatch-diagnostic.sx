// A default-conv sx function passed as an `abi(.c)` fn-pointer is rejected with a
// call-convention mismatch diagnostic: the C caller supplies no `__sx_ctx` slot.

#import "modules/std.sx";

sx_handler :: (arg: *void) -> *void { return arg; }

main :: () -> i32 {
    fp : (*void) -> *void abi(.c) = sx_handler;
    return 0;
}
