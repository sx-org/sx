// A module-scope `inline if` whose condition does not
// fold is a diagnostic, never a silent drop — a live function, import, or asm
// block would otherwise vanish and resurface as a distant unresolved name.
//
// Lowering owns the fold, so target facts (`@host` fields) AND module
// constants both select a group (example 0668). `flag1236` is a mutable global
// — a runtime value — so there is nothing to fold and the group is refused.
@import "modules/std.sx";
flag1236 : bool = true;
inline if flag1236 { helper1236 :: () -> i64 { return 1; } }
main :: () {}
