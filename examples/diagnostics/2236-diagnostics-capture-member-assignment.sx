// A MEMBER or ELEMENT write through a by-value capture is refused exactly as
// the bare `x = v` spelling is: the capture is a read-only copy, so `e.n = ...`
// reaches no container storage. Auto-deref through a pointer field of the copy
// (`h.p.n`) is the same refusal — the copy has no address to GEP; the recovery
// is the by-ref capture `*h`. Taking the address of a field (`*e.n`) and a
// pack-element member write are the same class. Every write form is covered —
// plain, compound, element index, multi-assign, pre-decrement, address-of — and
// each carries the shape-aware message of the binding it roots at. Only the
// for-loop ELEMENT form suggests the `*e` by-ref spelling, since its container
// storage exists. A type-switch capture over an `any` subject binds the unboxed
// value itself, so it has no address to GEP either and refuses the same way.
//
// A chain that addresses pointee memory writes shared storage, not the copy,
// and stays allowed — see 2237-basic-capture-member-writes.

@import "modules/std.sx";

Item :: struct {
    n: i64 = 0;
    tags: [2]i64;
}

Cell :: struct { n: i64 = 0; }
Holder :: struct { p: *Cell; }

Shape :: enum { box: Item; none; }

takes :: (p: *i64) {}

packMut :: (..xs: Item) {
    inline for x in xs { x.n = 1; }
}

main :: () -> i32 {
    items : [2]Item = .[
        .{ n = 1, tags = .[0, 0] },
        .{ n = 2, tags = .[0, 0] },
    ];

    // 1. for-loop element capture — field write
    for e in items { e.n = e.n + 10; }

    // 2. compound field write, paired index capture
    for e, i in items, 0.. { e.n += 10; }

    // 3. element write into an array field of the copy
    for e in items { e.tags[0] = 7; }

    // 4. multi-assign spelling — member target
    a := 0;
    for e in items { a, e.n = 5, 6; }

    // 5. pre-decrement of a member
    for e in items { --e.n; }

    // 6. auto-deref through a pointer field of the copy
    cell : Cell = .{ n = 1 };
    holders : [1]Holder = .[.{ p = *cell }];
    for h in holders { h.p.n = 7; }

    // 7. address of a field of the copy
    for e in items { takes(*e.n); }

    // 8. match-arm payload capture — field write
    s : Shape = .box(.{ n = 3, tags = .[0, 0] });
    match s {
        case .box: |b| { b.n = 4; }
        case .none: {}
    }

    // 9. type-switch capture over an `any` subject — field write
    v : any = Item{ n = 5, tags = .[0, 0] };
    match v {
        case Item: |t| { t.n = 6; }
        else: {}
    }

    // 10. function-local '::' const — constant-family message
    c :: Item{ n = 8, tags = .[0, 0] };
    c.n = 9;

    // 11. inline-for pack-element alias — member write
    packMut(.{ n = 1, tags = .[0, 0] });

    0
}
