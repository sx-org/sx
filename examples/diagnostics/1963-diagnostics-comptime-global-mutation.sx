// The other side of the VM-local Context (specs.md §6.9): comptime code
// cannot mutate globals. The VM reads a global into a VM-local copy and never
// writes back, so a store to one has nowhere to land and the evaluation is
// refused — the compile-time world stays sealed off from the image's data.
@import "modules/std.sx";

counter : i64 = 0;

bump :: () -> i64 {
    counter = counter + 1;
    return counter;
}

FIRST :: @run bump();

main :: () {
    print("{} {}\n", FIRST, counter);
}
