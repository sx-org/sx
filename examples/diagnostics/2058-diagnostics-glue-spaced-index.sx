// Glue rule (specs: Whitespace is Syntax): `[` indexes only when it is GLUED
// to what it indexes. The `[` half of the rule the spaced call pins for `(`
// (2057), and it reports the same way. Expected: exit 1.
#import "modules/std.sx";

main :: () -> i32 {
    xs : [3]i64 = .[10, 20, 30];
    print("{}\n", xs [0]);
    return 0;
}
