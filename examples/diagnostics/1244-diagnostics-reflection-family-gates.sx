// The split value-reflection families are kind-gated: `structFieldValue` serves
// structs/tuples (and untagged unions); `variantPayload` serves enums/tagged
// unions; arrays/vectors use native indexing. Each wrong-kind call is a loud
// compile error naming the right builtin — never a silently-wrong member.
@import "modules/std.sx";

Point :: struct { x: i64; y: i64; }

main :: () {
    print("{}\n", variantPayload(Point{ x = 1, y = 2 }, 0));  // struct value → structFieldValue
    v : @Vector(3, f32) = .[1.0, 2.0, 3.0];
    print("{}\n", structFieldValue(v, 0));      // vector → index natively
}
