// Match arms whose result types have NO safe coercion in either direction (the
// store guard's `noneReinterpretIsUnsafe` lattice) are a true mismatch: each
// offending arm gets a located "match arms have incompatible types" diagnostic.
// Covers the value-position literal shape, a capture-typed arm against a string
// arm, and a match whose arm tails are calls.
#import "modules/std.sx";

Color :: enum { red; green; }
V :: enum { num: f64; other; }

gi :: () -> i64 { return 4; }
gs :: () -> string { return "s"; }

main :: () {
    c : Color = .red;

    // Value position, literal arms: i64 vs string.
    r := match c { case .red: { 1 } case .green: { "hi" } };
    print("{}\n", r);

    // Capture-typed arm (f64 payload) vs string arm.
    v : V = .num(2.5);
    s := match v { case .num: |x| { x } case .other: { "nope" } };
    print("{}\n", s);

    // Arm tails are calls with incompatible result types.
    w := match c { case .red: { gi() } case .green: { gs() } };
    print("{}\n", w);
}
