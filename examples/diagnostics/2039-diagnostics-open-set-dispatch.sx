// What set dispatch refuses (spec: Open Sets — dispatch).
//
// The switch is total over the frozen members, every arm returns through one
// slot, and each arm hands the member its own storage. Each refusal here is one of
// those three sentences failing:
//
//   - nothing is a member, so no receiver value can exist;
//   - a member answers the method at other types, so it is not an arm of this
//     switch;
//   - the method's signature names `Self`, which denotes the MEMBER — a set value
//     is not any one member, so there is no caller-side type for it.
// Expected: exit 1.
#import "modules/std.sx";

// Nothing declares itself into this one.
Empty :: @OpenSet(.{ max = 64 }) {
    name :: (self: *Self) -> string;
}

Shown :: @OpenSet(.{ max = 64 }) {
    render :: (self: *Self) -> string;
}

Good :: @OpenVariant(Shown) {
    text: string = "";
    render :: (self: *Good) -> string => self.text;
}

// Answers at its own types instead of the set's.
Loud :: @OpenVariant(Shown) {
    n: i64 = 0;
    render :: (self: *Loud) -> i64 => self.n;
}

// A required method whose signature mentions `Self` past the receiver.
Fold :: @OpenSet(.{ max = 64 }) {
    merge :: (self: *Self, other: Self) -> i64;
}

Pair :: @OpenVariant(Fold) {
    n: i64 = 0;
    merge :: (self: *Pair, other: Pair) -> i64 => self.n + other.n;
}

main :: () -> i32 {
    e: Empty = ---;
    print("{}\n", e.name());

    s: Shown = Good{ text = "good" };
    print("{}\n", s.render());

    f: Fold = Pair{ n = 1 };
    print("{}\n", f.merge(Pair{ n = 2 }));
    0
}
