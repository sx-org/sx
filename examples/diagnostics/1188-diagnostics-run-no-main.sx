// `sx run` on a program with no `main` emits a diagnostic and exits non-zero. A
// pre-JIT entry-point check in main.zig and a `main_addr == 0` backstop in
// target.zig's runJITFromObject both guard the call into a garbage JIT address.
#import "modules/std.sx";

// Intentionally no `main` — only a helper.
greet :: () {
    print("unreachable\n");
}
