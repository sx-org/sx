// An array dimension that is not a compile-time integer constant is a hard error.
// Here a type alias's dimension is the runtime call `get()`, which the
// registration-time resolver cannot evaluate; it yields the `.unresolved`
// sentinel and alias registration surfaces this diagnostic.
//
// A const-FOLDABLE expression dimension such as `[M + 1]` folds instead — see
// examples/0144-types-const-expr-array-dim.sx.
#import "modules/std.sx";

get :: () -> i64 { return 5; }
BadArr :: [get()]i64;

main :: () {
    a : BadArr = ---;
    a[0] = 7;
    print("a0={}\n", a[0]);
}
