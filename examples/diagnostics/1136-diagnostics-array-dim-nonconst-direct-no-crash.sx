// A DIRECT array dimension that is genuinely not a compile-time integer (a
// runtime call) reports ONE diagnostic and aborts the build. `resolveArrayLen`
// returns null → the `.unresolved` sentinel, and the binding's lowering bails on
// it, so the downstream element store, read and `.len` add no cascade errors and
// no fabricated length.
#import "modules/std.sx";

get :: () -> i64 { return 5; }

main :: () {
    a : [get()]i64 = ---;
    a[0] = 7;
    print("unreachable: {} {}\n", a.len, a[0]);
}
