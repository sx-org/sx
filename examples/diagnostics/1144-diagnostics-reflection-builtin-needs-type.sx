// The type-introspection builtins (size_of, align_of, struct_field_count,
// @typeName, @typeEq, is_flags) take ONLY types. The strict
// `$T: Type` guard (`Lowering.reflectionTypeArgGuard`) rejects an argument whose
// static type is not `Type` with "<builtin> expects a type, got '<type>'" at that
// argument.
//
// Reject cases use `true`/`1.5`, whose types (bool/f64) are stable, so the pinned
// diagnostics do not move with the int-literal default type.

@import "modules/std.sx";

main :: () {
    print("{}\n", size_of(true));          // bool, not a type
    print("{}\n", align_of(1.5));          // f64, not a type
    print("{}\n", struct_field_count(true));      // bool, not a type
    print("{}\n", @typeName(1.5));         // f64, not a type
    print("{}\n", @typeEq(true, false));   // both bool — both rejected
    print("{}\n", is_flags(1.5));          // f64, not a type
}
