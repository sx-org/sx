// A direct call to a generic fn whose arguments cannot bind a TYPE param is
// diagnosed at the call site rather than monomorphized with the param unbound. A
// scalar argument at a `[]$T` param is the canonical uninferrable shape.

@import "modules/std.sx";

first :: (xs: []$T) -> T {
    return xs[0];
}

main :: () -> i32 {
    print("{}\n", first(42));
    return 0;
}
