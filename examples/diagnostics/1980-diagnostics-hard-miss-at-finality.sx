// The hard half of the same two misses (§7.9): at finality a HARD
// operation — a dispatch, an unconsumed conversion, an erasure — takes the
// ordinary diagnostic at the operation's own site, where the soft probe of
// 1979 answers `null`.
@import "modules/std.sx";

Mark :: interface { tag :: (self: *Self) -> i64; }
Show :: interface { fmt :: (self: *Self) -> i64; }

Widget :: struct { n: i64; }
Loose :: struct { n: i64; }

impl Show for Widget { fmt :: (self: *Widget) -> i64 { self.n * 2 } }

main :: () {
    w := Widget{ n = 5 };
    l := Loose{ n = 1 };

    // No visible impl for this concrete type.
    unshown := l.(Show);
    // Final-empty — nothing implements `Mark` in this program.
    empty := w.(Mark);

    print("{} {}\n", unshown.fmt(), empty.tag());
}
