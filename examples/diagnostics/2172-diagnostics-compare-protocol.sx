// A protocol value does not compare with a foreign type. Unbox or recover
// the concrete value first.
@import "modules/std.sx";

Speaker :: protocol vtable @identity {
    speak :: (self: *Self) -> i64;
}

Dog :: struct { n: i64; }

impl Speaker for Dog {
    speak :: (self: *Dog) -> i64 { self.n }
}

main :: () {
    d := Dog{ n = 1 };
    s : Speaker = d;
    if s == 1 { print("no\n"); }
}
