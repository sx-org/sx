// One C symbol bound twice with DIFFERENT sx signatures is diagnosed. Equal
// signatures share one registration silently (std's read/write are bound by
// several modules).
//
// The C-variadic tail is part of a signature: a fixed prototype and a variadic
// one over the same fixed parameters are different ABIs, so binding both to one
// symbol disagrees. Two variadic views that match share a registration the way
// two fixed ones do.
@import "modules/std.sx";

libc :: @library "c";
// std/process.sx already binds getenv as `-> *u8`; this view disagrees.
getenvOpt :: (name: [:0]u8) -> ?[:0]u8 extern libc "getenv";

fixedView    :: (fmt: cstring) -> i32 extern libc "printf";
variadicView :: (fmt: cstring, ..) -> i32 extern libc "printf";

tailView   :: (fmt: cstring, ..) -> i32 extern libc "fprintf";
sameTail   :: (fmt: cstring, ..) -> i32 extern libc "fprintf";

main :: () -> i32 {
    p := getenvOpt("PATH");
    if p == null { return 1; }
    n := fixedView("x\n") + variadicView("%d\n", 1);
    n += tailView("%d\n", 2) + sameTail("%d %d\n", 3, 4);
    if n < 0 { return 2; }
    return 0;
}
