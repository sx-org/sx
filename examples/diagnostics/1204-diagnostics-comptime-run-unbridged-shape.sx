// A body-local `#run` const whose comptime function returns a shape the comptime
// VM cannot BRIDGE to a host value — here `[2][]i64`, an array of slices — fails
// the build with a located `comptime init of '<name>' failed: <reason>`, the same
// failure a GLOBAL `#run` const produces.
//
// An EXECUTION bail — a body the VM cannot run but the runtime computes correctly,
// e.g. `0.0/0.0` → NaN — still falls through to the runtime call. Only an
// unbridgeable RESULT fails here.
#import "modules/std.sx";

mk :: () -> [2][]i64 {
    a : []i64 = ---;
    r : [2][]i64 = ---;
    r[0] = a;
    r[1] = a;
    return r;
}

main :: () {
    L :: #run mk();          // unbridgeable comptime result → clean build error
    print("{}\n", L[0][0]);
}
