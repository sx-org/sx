// A reserved/builtin type name is rejected as the error-tag binding of a `catch`
// (`u8`) and of an `onfail` (`i64`), reported at the binding's declaration.
@import "modules/std.sx";

E :: error { Bad }

must :: (n: i32) -> !E {
    if n < 0 { raise error.Bad; }
    return;
}

classify :: (n: i32) -> !E {
    onfail |i64| { }                  // onfail tag binding
    must(n) catch |u8| { return; };   // catch tag binding
    return;
}

main :: () -> i32 {
    classify(-1) catch {};
    return 0;
}
