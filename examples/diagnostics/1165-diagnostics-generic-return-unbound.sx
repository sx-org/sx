// A `$T`-generic RETURN type with no parameter mentioning `$T` is rejected at the
// declaration: type params derive from params, so the fn is not a template and no
// call site could bind the return. All three declaration surfaces diagnose — a
// top-level fn, a struct-body method, and a non-parameterised impl method — even
// when the fn is never called.

@import "modules/std.sx";

make :: () -> $T { 0 }

Foo :: struct {
    x: i64;
    weird :: (self: *Foo) -> $T { 0 }
}

Show2 :: constraint { show2 :: (self: *Self) -> string; }
IntBox :: struct { v: i64; }
impl Show2 for IntBox {
    show2 :: (self: *IntBox) -> string { "x" }
    leak :: (self: *IntBox) -> $T { 0 }
}

main :: () { print("ok\n"); }
