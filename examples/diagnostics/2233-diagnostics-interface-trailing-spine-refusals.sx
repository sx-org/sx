// A body's trailing expression is its return operand, so a concrete rvalue at
// an I-typed target is refused there just as under an explicit `return`.
// `.{ }` is a struct literal, not a handle. Absence of `?I` is `null`.
@import "modules/std.sx";

P :: interface { a :: (self: *Self) -> i64; }
W :: struct { v: i64; }
impl P for W { a :: (self: *W) -> i64 { self.v } }
S :: struct { inner: P; }

trailing_cast :: () -> P { W{ v = 1 }.(P) }
trailing_in_literal :: () -> S { S{ inner = W{ v = 2 } } }
trailing_empty_literal :: () -> P { .{} }

take :: (v: P) -> P { v }
through_argument :: () -> P { take(W{ v = 3 }) }
through_binding :: () -> P { r : P = ---; r = W{ v = 4 }; r }
absent :: () -> ?P { null }

main :: () {
    _ = trailing_cast();
    _ = trailing_in_literal();
    _ = trailing_empty_literal();
    _ = through_argument();
    _ = through_binding();
    _ = absent();
}
