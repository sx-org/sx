// A body's trailing expression is its return operand, so a concrete rvalue at
// an I-typed target is refused there just as under an explicit `return`.
// `.{ }` is a struct literal, not a handle. Absence of `?I` is `null`.
@import "modules/std.sx";

P :: interface { a :: (self: *Self) -> i64; }
W :: struct { v: i64; }
impl P for W { a :: (self: *W) -> i64 { self.v } }
S :: struct { inner: P; }

trailingCast :: () -> P { W{ v = 1 }.(P) }
trailingInLiteral :: () -> S { S{ inner = W{ v = 2 } } }
trailingEmptyLiteral :: () -> P { .{} }

take :: (v: P) -> P { v }
throughArgument :: () -> P { take(W{ v = 3 }) }
throughBinding :: () -> P { r : P = ---; r = W{ v = 4 }; r }
absent :: () -> ?P { null }

main :: () {
    _ = trailingCast();
    _ = trailingInLiteral();
    _ = trailingEmptyLiteral();
    _ = throughArgument();
    _ = throughBinding();
    _ = absent();
}
