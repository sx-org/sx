// Assignment to an undeclared identifier is a compile error: a plain `=` or a
// compound `OP=` whose LHS name resolves to no local and no visible global fails
// the build, so a typo'd variable name (`totl` for `total`) never ships as a dead
// assignment.
//
// The same lowering arm pins two more shapes, and diagnostics accumulate so none
// masks another:
// - a by-ref loop capture (`for *x in xs`) assigned WITHOUT `.*` — there is no
// store path through the bare name; the error points at `x.* = ...`;
// - `_ OP= expr` — the discard has no value to read; only the plain `_ = expr`
// discard idiom is allowed.

#import "modules/std.sx";

main :: () -> i32 {
    totl = 42;          // typo of `total` — plain `=` to an undeclared name
    cnt += 1;           // compound assign to an undeclared name
    xs : [2]i64 = .[1, 2];
    for *x in xs {
        x = 99;         // by-ref capture assigned without `.*`
    }
    _ += 1;             // compound assign to the discard
    total := 0;
    total = total + 1;
    print("{}\n", total);
    0
}
