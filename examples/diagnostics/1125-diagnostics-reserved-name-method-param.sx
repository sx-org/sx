// A reserved/builtin type name used as a PARAMETER name is rejected in the two
// method-with-body forms that carry their params as bare name lists rather than
// `Param` nodes: a protocol default-body method (`u8`) and a `#objc_class` method
// (`i16`). Each method's `param_name_spans` puts the caret on the offending
// parameter token, not on the enclosing block.
#import "modules/std.sx";
#import "modules/build.sx";

Greeter :: protocol {
    greet :: (self: *Self, u8: i64) -> i64 {
        return u8;
    }
}

SxFoo :: #objc_class("SxFoo") {
    counter: i32;

    bump :: (self: *Self, i16: i32) {
        self.counter += i16;
    }
}

main :: () -> i32 {
    return 0;
}
