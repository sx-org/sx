// `==` / `!=` between two untagged-`union` VALUES is a located diagnostic. An
// untagged union is a raw byte aggregate (`[N x i8]` storage) whose
// inactive-variant and padding bytes are unspecified, so byte-wise equality is
// undefined; the binary-op equality lowering (src/ir/lower/expr.zig) hints at
// comparing a specific variant field instead. The same guard covers fixed arrays,
// also raw element aggregates with no `==` semantics.
#import "modules/std.sx";

Shape :: union { circle: i64; rect: i64; }

main :: () -> i32 {
    a : Shape = .{ circle = 5 };
    b : Shape = .{ circle = 5 };
    if a == b { print("eq\n"); }   // rejected: cannot compare 'Shape' with '=='
    0
}
