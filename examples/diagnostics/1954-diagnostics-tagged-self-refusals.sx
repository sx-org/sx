// The static refusals around direct-`Self` tagged dispatch (spec §6.4):
//   - a `Self` mention at DEPTH has no caller-side type on any kind, so it
//     stays excluded from dispatch through a value;
//   - a bare `-> Self` result is a borrow of a temporary in the CALLER's
//     frame, so returning it directly is refused exactly as erasing an rvalue
//     at a `return` is (§6.2);
//   - on an `#identity` tagged protocol a `Self`-RETURNING arm would mint the
//     anonymous instance the naming discipline refuses.
// Each stays callable on a concrete receiver and through a generic bound.
#import "modules/std.sx";

Shape :: protocol tagged {
    area    :: (self: *Self) -> f64;
    resized :: (self: Self, k: f64) -> Self;
    nearest :: (self: *Self, others: []Self) -> f64;
    maybe   :: (self: *Self) -> ?Self;
    twin    :: (self: *Self, other: *Self) -> bool;
}

Circle :: struct { r: f64; }
impl Shape for Circle {
    area    :: (self: *Circle) -> f64 { 3.0 * self.r * self.r }
    resized :: (self: Circle, k: f64) -> Circle { .{ r = self.r * k } }
    nearest :: (self: *Circle, others: []Circle) -> f64 { xx others.len }
    maybe   :: (self: *Circle) -> ?Circle { self.* }
    twin    :: (self: *Circle, other: *Circle) -> bool { self.r == other.r }
}

Handle :: protocol tagged #identity {
    id      :: (self: *Self) -> i64;
    rebound :: (self: *Self, k: i64) -> Self;
}
Port :: struct { n: i64; }
impl Handle for Port {
    id      :: (self: *Port) -> i64 { self.n }
    rebound :: (self: *Port, k: i64) -> Port { .{ n = self.n * k } }
}

// The borrow's referent is a temporary of THIS frame — refused.
grow :: (v: Shape) -> Shape { return v.resized(2.0); }

// Every excluded method stays callable through a bound, where `Self` IS the
// bound type.
bound_ok :: (a: $T/Shape) -> bool { a.twin(*a) }

main :: () {
    c := Circle{ r = 1.0 };
    arr : [1]Circle = .[c];
    v : Shape = c;

    v.nearest(arr[0..1]);
    v.maybe();
    v.twin(*c);

    p := Port{ n = 3 };
    h : Handle = p;
    h.rebound(2);

    print("{} {}\n", grow(v).area(), bound_ok(c));
}
