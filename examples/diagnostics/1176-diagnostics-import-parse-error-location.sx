// A parse error in an IMPORTED file is located in THAT file, not the importer.
// `import_sources` is wired to the diagnostics BEFORE import resolution runs, so a
// parse error raised mid-resolution still resolves the imported file's source and
// pins the diagnostic's `source_file` and offset to it.
//
// The companion's error sits several lines down, so a caret mislocated against
// this importer would be unmistakable.
@import "1176-diagnostics-import-parse-error-location/broken.sx";

main :: () {}
