// A module-global aggregate may hold a NULL pointer field (null is a compile-time
// constant); a sibling field initialized from a runtime call still reports
// `global 'boxes' must be initialized by a compile-time constant`.

@import "modules/std.sx";

runtimeMarker :: () -> i64 { return 7; }

Box :: struct { p: *i64; marker: i64; }
boxes : [1]Box = .[ .{ p = null, marker = runtimeMarker() } ];

main :: () -> i32 {
    print("marker={}\n", boxes[0].marker);
    return 0;
}
