// The glue rule is uniform: it holds even where the grammar MANDATES the
// argument list, so `Closure (i64) -> i64` is a spacing error rather than a
// tolerated spelling. The same holds for `@Init(P)` / `@BuildBlock(P)`,
// `@OpenVariant(View)`, and `@OpenSet(.{ … })` — a space before `(` is always
// fatal.
#import "modules/std.sx";

apply :: (f: Closure (i64) -> i64, n: i64) -> i64 => f(n);

main :: () -> i32 {
    print("{}\n", apply(|x: i64| x + 1, 41));
    return 0;
}
