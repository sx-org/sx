// Passing an optional (`?T`) where a `bool` is expected is a type error at the
// coercion site, with a `!= null` fix-it. The language has no implicit
// optional→bool coercion — only `T → ?T` wrapping and flow-sensitive narrowing —
// so the coercion classifier's "optional → concrete (unwrap+narrow)" rule does not
// admit `?i64 → bool`, whose payload is not itself a bool. The `if opt {}` presence
// test is a separate path.

#import "modules/std.sx";

takes_bool :: (b: bool) { if b { print("true\n"); } else { print("false\n"); } }

main :: () {
  a : ?i64 = 42;
  takes_bool(a);   // <- '?i64' cannot be used where 'bool' is expected
}
