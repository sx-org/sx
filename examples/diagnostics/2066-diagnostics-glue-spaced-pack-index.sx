// Glue rule (specs: Whitespace is Syntax): a pack index is an index like any
// other, in an expression as in a type — the `[` binds only when GLUED to the
// pack. Expected: exit 1.
#import "modules/std.sx";

show :: (..$args) -> string => type_name($args [0]);

main :: () -> i32 {
    print("{}\n", show(1));
    return 0;
}
