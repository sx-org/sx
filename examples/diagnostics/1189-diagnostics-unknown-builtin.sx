// A bodiless `@` declaration carrying a `$T: Type` parameter whose name the
// compiler does not recognize fails with an "unknown intrinsic" diagnostic at
// the declaration, never a fall-through into a zero body.
@import "modules/std.sx";

@mystery :: ($T: Type, x: T) -> T;

main :: () {
    print("mystery(42) = {}\n", @mystery(i64, 42));
}
