// A module constant whose call produces no value is refused at its initializer
// where it is read; the unread one is never checked, and a void field read
// binds, `@field` included.
@import "modules/std.sx";
hello :: () { print("hi\n"); }
S :: struct { v: void; }
s :: S{};
Unread :: hello();
Statement :: hello();
Argument :: hello();
Field :: s.v;
Projection :: @field(s, 0);
main :: () { Statement; Field; Projection; print("{}\n", Argument); }
