// A value-position block `match` — a `:=` RHS here — whose arms are MIXED, one
// yielding a real value while a sibling yields void through a bare-statement tail,
// is a located compile-time error: every arm of a value `match` produces a value.
// It mirrors the value-`if`-without-`else` diagnostic.
//
// A `match` used purely as a STATEMENT, with all arms void, and a diverging arm in
// a value `match` both stay valid; only the value/void MIX is rejected.
@import "modules/std.sx";

E :: enum { A; B; }

main :: () {
    e := E.A;
    y := match e {
        case .A: { print("x\n"); }   // void tail — no value
        case .B: { 2 }               // i64 value
    };
    print("{}\n", y);
}
