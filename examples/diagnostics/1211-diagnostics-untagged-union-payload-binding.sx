// A match-style `match x { case .variant: |v| { ... } }` payload binding is valid
// only on a tagged union (an enum with payloads). Two non-bindable subjects are
// rejected at lowering:
// - a plain UNTAGGED `union` (no discriminant) and a POINTER to one, where the
// subject-level match gate rejects the whole match up front (1220 covers the
// no-binding forms);
// - a payload-less enum, where the arm-level binding rejection fires with the
// generic wording.
@import "modules/std.sx";

Shape :: union { circle: i64; rect: i64; }
Color :: enum { red; green; }

main :: () {
    s : Shape = .{ circle = 5 };
    r := match s { case .circle: |v| { v } case .rect: |v| { v * 2 } };
    print("{}\n", r);

    p := *s;
    q := match p { case .circle: |v| { v } else: { 0 } };
    print("{}\n", q);

    c := Color.red;
    w := match c { case .red: |v| { v } case .green: { 0 } };
    print("{}\n", w);
}
