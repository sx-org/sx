// A multi-assign target that resolves to no assignable storage is a compile error:
// an identifier target in `a, b = x, y;` with no local slot and no visible global
// diagnoses, in parity with single-assign (1212).
//
// The same lowering arm pins two more shapes, and diagnostics accumulate so none
// masks another:
// - a by-ref loop capture (`for xs (*x)`) as a multi-assign target WITHOUT `.*`;
// the error points at `x.* = ...`, and the capture SHADOWS a same-named global,
// so the store never resolves past it to different storage;
// - a `::` constant as a multi-assign target, which the global fallback rejects
// as single-assign does.
//
// examples/basic/0060-basic-multi-assign-global.sx pins the positive global case.

#import "modules/std.sx";

GC :: 5;
g : i64 = 0;

main :: () -> i32 {
    a := 1;
    b := 2;
    a, undeclared_b = b, a;     // typo'd target — plain multi-assign to an undeclared name
    xs : [2]i64 = .[1, 2];
    for xs (*x) {
        x, a = 9, 9;            // by-ref capture target assigned without `.*`
    }
    for xs (*g) {
        g, a = 9, 9;            // capture shadows the module global `g` — same diagnostic
    }
    GC, a = 1, 2;               // `::` const as a multi-assign target
    print("a={} b={}\n", a, b);
    0
}
