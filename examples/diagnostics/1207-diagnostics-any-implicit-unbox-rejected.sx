// An `any` does not IMPLICITLY unbox to a concrete type — an unbox carries no
// runtime tag check. The rejection sits in `coerceMode` (`.unbox_any` arm,
// mode == .implicit), like the no-implicit-optional-unwrap rule, and directs the
// user to `match` on the value's type or an explicit `xx`. The `xx` escape hatch
// and the compiler-generated type-dispatch / pack-extraction unboxes are
// unaffected.

@import "modules/std.sx";

S :: struct { a: i64; }

main :: () -> i64 {
    x : any = 5;
    n : i64 = x;            // error: 'any' does not implicitly unbox to 'i64'
    s : S = x;              // error: 'any' does not implicitly unbox to 'S'
    return 0;
}
