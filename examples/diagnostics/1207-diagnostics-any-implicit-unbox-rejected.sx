// An `any` does not implicitly unbox to a
// concrete type because unboxing does not
// check the runtime tag. The diagnostic
// directs the user to dispatch on the boxed
// type with `match` or assert the boxed
// type with `.(T)`.

@import "modules/std.sx";

S :: struct { a: i64; }

main :: () -> i64 {
    x : any = 5;
    n : i64 = x;            // error: 'any' does not implicitly unbox to 'i64'
    s : S = x;              // error: 'any' does not implicitly unbox to 'S'
    return 0;
}
