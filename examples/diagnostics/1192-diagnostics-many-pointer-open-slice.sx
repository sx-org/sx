// Slicing an unterminated many-pointer `[*]T` requires an explicit upper bound:
// it carries no length and no terminator, so an open-ended `mp[lo..]` has no
// bound to resolve.
// examples/types/0195 covers the valid explicit-bound form.
@import "modules/std.sx";

main :: () -> i64 {
    a : [4]u8 = .[5, 6, 7, 8];
    mp : [*]u8 = *a[0];
    s := mp[1..];          // ERROR: many-pointer slice needs an explicit hi
    return s.len;
}
