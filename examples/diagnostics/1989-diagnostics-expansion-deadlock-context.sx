// The Context half of the expansion deadlock.
//
// The condition runs, and what it runs reads `context.depth` — so it needs the
// program Context to be settled. It is not: both branches of this very driver
// declare a `#context_extend`, so the layout the run would read is one only
// this driver could finish. The fact never fires, the drain quiesces with the
// bookmark down, and the expansion is refused with every waiting unit named.
@import "modules/std.sx";

inline if @run { context.depth > 2 } {
    @context_extend depth: i64 = 3;
} else {
    @context_extend depth: i64 = 9;
}

main :: () {
    print("{}\n", 1);
}
