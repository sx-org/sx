// A welded `compiler`-library function is comptime-only — the comptime interpreter
// dispatches it to a Zig handler and it has no runtime symbol. Calling one from
// runtime code is a build error, not an undefined-symbol link failure. A comptime
// use inside `#run` or a `::` is fine; see examples/0626.

#import "modules/std.sx";


StringId :: u32;

main :: () {
    id := raw_intern("called at runtime");
    print("{}\n", id);
}
