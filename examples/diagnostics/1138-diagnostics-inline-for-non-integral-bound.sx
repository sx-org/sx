// A NON-integral float (`4.5`) as an `inline for` range bound is a hard error —
// the loop cursor is a compile-time integer, so only an integral float (`4.0`,
// `-2.0`) folds. Range bounds accept negative endpoints; only the
// must-be-integer requirement applies.
#import "modules/std.sx";

main :: () {
    s := 0;
    inline for i in 0..4.5 { s += i; }
    print("unreachable: {}\n", s);
}
