// Blanket-impl shapes that are refused where they are written, because nothing
// could ever select them, plus the one carrier covered twice.
//
// These apply to a CONSTRAINT protocol, whose conformance is a keyed impl
// lookup. A tagged family collects members by whole-program membership, where
// the same spellings are ordinary (examples/protocols/1943).
#import "modules/std.sx";

Series :: protocol(T: Type) constraint {
    count :: (self: *Self) -> i64;
}

Buffer :: struct($T: Type) { n: i64; }
Plain :: struct { n: i64 = 0; }

// A binder in the protocol arguments with no carrier instantiation to bind it.
impl Series($U) for Plain {
    count :: (self: *Plain) -> i64 { self.n }
}

// A generic carrier whose binder the protocol arguments never mention.
impl Series(i64) for Buffer($T) {
    count :: (self: *Buffer) -> i64 { 1 }
}

main :: () {
    print("{}\n", 1);
}
