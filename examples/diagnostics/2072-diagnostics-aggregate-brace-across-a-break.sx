// Whitespace is syntax (specs §1), the binding layer: a named aggregate's `{`
// binds only on the same line as its head. Written on the line below, the head
// is an expression of its own and the brace opens a scope block — so the field
// list inside it is read as statements, and the `,` between them is the
// ordinary error a scope block gives.
// Expected: exit 1.
#import "modules/std.sx";

Pair :: struct { a: i64; b: i64 }

main :: () -> i32 {
    v := Pair
    { a = 1, b = 2 };
    print("{}\n", v.a);
    return 0;
}
