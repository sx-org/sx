// Whitespace is syntax (specs §1), the binding layer: a named aggregate's `{`
// binds only on the same line as its head. Written on the line below it does
// not bind, so the declaration above it is still open and the report names the
// terminator it is missing.
#import "modules/std.sx";

Pair :: struct { a: i64; b: i64 }

main :: () -> i32 {
    v := Pair
    { a = 1, b = 2 };
    print("{}\n", v.a);
    return 0;
}
