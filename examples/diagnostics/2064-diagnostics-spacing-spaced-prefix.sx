// Spacing rule, prefix half: a prefix `-` / `*` binds only when glued to its
// operand. A slot with no left operand admits only the prefix reading, so
// there the space leaves the `-` with no reading at all — here on the right of
// a `:=`, where nothing precedes the operator.
#import "modules/std.sx";

main :: () -> i32 {
    x := - 5;
    print("{}\n", x);
    return 0;
}
