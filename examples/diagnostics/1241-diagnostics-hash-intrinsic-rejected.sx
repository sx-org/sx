// `intrinsic` is a KEYWORD in body position, not a directive. `#intrinsic` is not a
// spelling of it and does not parse — there is exactly one way to write an
// intrinsic declaration.
//
// The message below is the GENERIC unknown-directive parse error (`#wibble`
// produces the same one): `#intrinsic` is simply not in the directive table. The
// error text points at the parameter list rather than the offending `#`, a wart of
// unknown-directive recovery rather than a property of intrinsics.
@import "modules/std.sx";

foo :: ($T: Type) -> i64 #intrinsic;

main :: () {
    print("{}\n", foo(i64));
}
