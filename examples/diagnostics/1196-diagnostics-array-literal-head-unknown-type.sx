// A typed array/slice literal head (`([N]T).[…]` / `([]T).[…]`) names its element
// type exactly like a declaration annotation, so an undefined element type name
// earns the same `unknown type '<name>'` diagnostic. The unknown-type checker
// (`semantic_diagnostics.zig` `walkBodyTypes`) validates the literal's `type_expr`
// head through the `checkTypeNodeForUnknown` walk a declaration annotation uses.
@import "modules/std.sx";

main :: () {
    arr := ([2]?Undefined).[ null, null ];
    print("ok\n");
}
