// A dotted construction head whose prefix is a type, not a namespace, names no
// type: sx has no `Type.NestedType` access, so the head fails through the same
// value-in-type-position path as the `x : Holder.Missing` annotation spelling.
@import "modules/std.sx";

Holder :: struct { v: i32 }

main :: () -> i32 {
    x := Holder.Missing{ v = 1 };
    return 0;
}
