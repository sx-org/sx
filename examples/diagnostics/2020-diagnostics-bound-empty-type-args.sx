// A bound's type-argument list carries the constraint or interface's type arguments, so an
// empty one names nothing — the bare head is spelled without the parens.
@import "modules/std.sx";

Eq :: constraint {
    eq :: (self: *Self, other: Self) -> bool;
}

same :: (a: $T/Eq(), b: T) -> bool { true }

main :: () {
    print("{}\n", same(1, 2));
}
