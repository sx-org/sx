// A failed value-param bind on a type-RETURNING FUNCTION emits its own diagnostic
// and nothing more: the type-fn binder poisons the binding to `.unresolved`, like
// the struct binder, so a later field access on it stays silent. Three failure
// modes, three diagnostics, zero field cascades:
// - value-param overflow via an aliased integer constraint (`$K: Count`),
// - a non-const value-param arg (`get()`),
// - an unknown TYPE arg (`NoSuchType`), which still reports the unknown type.
@import "modules/std.sx";

Count :: u32;
MakeC :: ($K: Count, $T: Type) -> Type { return [K]T; }
get  :: () -> u32 { return 4; }

main :: () {
    a : MakeC(5000000000, i64) = ---;
    b : MakeC(get(), i64) = ---;
    c : MakeC(3, NoSuchType) = ---;
    print("unreachable {} {} {}\n", a.len, b.len, c.len);
}
