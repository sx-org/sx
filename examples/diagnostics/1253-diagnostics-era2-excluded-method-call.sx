// An interface body refuses a signature that mentions Self past the receiver,
// both as an extra parameter and as a return.
@import "modules/std.sx";

Eq :: interface {
    eq :: (self: *Self, other: Self) -> bool;
}

Cloneable :: interface {
    clone :: (self: *Self) -> Self;
}

main :: () { print("unreachable\n"); }
