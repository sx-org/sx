// A compound assignment to a pointer target has a pointer form only for `+=`
// and `-=` by an integer. Scaling, masking or shifting an address, and folding
// a pointer difference (a count, not an address) back into the pointer, are
// rejected at compile time.

@import "modules/std.sx";

main :: () -> i32 {
    ints : [4]i32 = .[1, 2, 3, 4];
    p : [*]i32 = *ints[0];
    q : [*]i32 = *ints[2];

    p *= 2;    // scaled address
    p /= 2;    // divided address
    p &= 7;    // masked address
    p <<= 1;   // shifted address
    p -= q;    // pointer difference folded back into a pointer
    0
}
