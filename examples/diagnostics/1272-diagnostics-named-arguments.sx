// Named-argument mapping diagnostics (specs: Named Arguments): positional after
// named; a parameter bound at most once, through positional overlap and through a
// duplicate name; an unknown name with a did-you-mean suggestion, and without one
// when no param name is close; positional-only zones (the variadic tail); missing
// required params reported BY NAME with no arity-count cascade; and closure values,
// which bind positionally only.
@import "modules/std.sx";

f :: (alpha: i64, beta: i64 = 1, gamma: string = "g") -> i64 { alpha + beta + gamma.len }
v :: (n: i64, ..rest: []i64) -> i64 { n + rest.len }
need :: (a: i64, b: string, c: bool) {}

main :: () {
    _ = f(beta = 2, 1);
    _ = f(1, alpha = 2);
    _ = f(1, beta = 2, beta = 3);
    _ = f(1, betta = 2);
    _ = f(1, delta = 2);
    _ = v(1, rest = 2);
    _ = need(c = true);
    q := |a: i64| a + 1;
    _ = q(a = 1);
}
