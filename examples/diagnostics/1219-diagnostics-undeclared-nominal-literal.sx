// A struct literal naming an UNDECLARED type is diagnosed in both the named-field
// form (`NoSuchType{ a = 1 }`) and the empty form (`NoSuchType{}`): the main-file
// `UnknownTypeChecker` validates a named struct-literal head just like a
// declaration annotation.
@import "modules/std.sx";

main :: () {
    a := NoSuchType{ a = 1 };   // unknown type — named-field form
    b := AlsoMissing{};         // unknown type — empty form
    _ := a;
    _ := b;
    print("ok\n");
}
