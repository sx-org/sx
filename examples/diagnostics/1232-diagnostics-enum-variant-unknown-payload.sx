// A call-shaped enum construction `.Variant(payload)` with an UNKNOWN variant name
// is a hard error. `hasVariant` gates all three call-shaped construction sites in
// lower/call.zig, since `resolveVariantIndex` returns 0 for an unknown name.
@import "modules/std.sx";

V :: enum {
    a;
    b: i64;
}

main :: () {
    x : V = .nope(7);   // `nope` is not a variant of V — must be a compile error
    _ = x;
}
