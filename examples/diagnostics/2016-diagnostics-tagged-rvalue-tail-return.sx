// The return POSITION is the position, not the keyword. A tagged value is a
// borrow of its referent, so erasing an rvalue into one where the frame that
// holds the temp is about to die is refused (§6.2) — and a body that yields
// its value through a trailing expression or an arrow returns from exactly
// that position. All three spellings below are the same escape and carry the
// same message — the implicit spellings are caught too.
#import "modules/std.sx";

View :: protocol tagged { area :: (self: *Self) -> i64; }
Widget :: struct { n: i64; }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n } }

by_keyword :: () -> View { return Widget{ n = 1 }.(View); }

by_tail :: () -> View { Widget{ n = 2 }.(View) }

by_arrow :: () -> View => Widget{ n = 3 }.(View);

// A lambda is its own function: the same escape refuses for the same
// reason.
by_lambda_arrow :: () {
    f : Closure() -> View = () => Widget{ n = 5 }.(View);
    _ = f;
}

by_lambda_tail :: () {
    f : Closure() -> View = () {
        Widget{ n = 6 }.(View)
    };
    _ = f;
}

// A frame temp OFF the return position stays legal: the borrow dies with
// this frame, and nothing here outlives it.
local_temp :: () -> i64 {
    v := Widget{ n = 4 }.(View);
    v.area()
}

// A trailing no-else `if` is a valueless guard, not the returned value —
// erasing inside the guard must stay legal (the temp does not escape).
guard_ok :: () -> i64 {
    if true {
        v := Widget{ n = 7 }.(View);
        _ = v.area();
    }
    0
}

main :: () {
    print("{}\n", local_temp());
    print("{}\n", guard_ok());
    print("{} {} {}\n", by_keyword().area(), by_tail().area(), by_arrow().area());
    by_lambda_arrow();
    by_lambda_tail();
}
