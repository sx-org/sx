// An integer literal that does not fit its integer target type is a
// compile error (no silent wrap): both faces diagnosed in one run.
// Unchecked, `x : i8 = 300` binds 44 and `y : u8 = 256` binds 0.

#import "modules/std.sx";

main :: () {
    x : i8 = 300;
    print("x: {}\n", x);
    y : u8 = 256;
    print("y: {}\n", y);
}
