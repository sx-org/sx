// Rejected failable-forward mixtures (`return callee(...)`):
// 1. PURE callee → VALUE-CARRYING caller: 0 value slots where 1 is required, so
// the raw tag would land in the value slot;
// 2. VALUE-CARRYING callee → PURE caller: 1 value slot where 0 are required;
// 3. bare-`!` callee → NAMED-set caller: the callee's channel is the merge its
// body converged to, and each of its members the named set cannot name is
// reported.

@import "modules/std.sx";

MyErr :: error { Boom }
BareErr :: error { Odd; Big }

pure_cal :: (x: i64) -> !MyErr {
    if x < 0 { raise .Boom; }
}

val_cal :: (x: i64) -> (i64, !MyErr) {
    if x < 0 { raise .Boom; }
    return x;
}

bare_cal :: (x: i64) -> ! {
    if x < 0 { raise BareErr.Odd; }
}

// (1) pure → value-carrying: rejected (0 value slots vs 1)
f1 :: (x: i64) -> (i64, !) {
    return pure_cal(x);
}

// (2) value-carrying → pure: rejected (1 value slot vs 0)
f2 :: (x: i64) -> ! {
    if x > 100 { raise BareErr.Big; }
    return val_cal(x);
}

// (3) bare `!` → named set: rejected (BareErr ⊄ MyErr)
f3 :: (x: i64) -> !MyErr {
    return bare_cal(x);
}

main :: () -> i32 {
    v, e := f1(1);
    if e { return 1; }
    e2 := f2(1);
    if e2 { return 2; }
    e3 := f3(1);
    if e3 { return 3; }
    return xx v;
}
