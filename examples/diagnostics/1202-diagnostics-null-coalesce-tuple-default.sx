// A `??` default whose type cannot match an optional product payload is a
// diagnostic at the default. There is no implicit scalar→product coercion.
@import "modules/std.sx";

main :: () {
    o : ?struct { a: i32 } = null;
    x := o ?? 5; // default 'i64' vs payload struct → diagnostic
    print("{}\n", x.a);
}
