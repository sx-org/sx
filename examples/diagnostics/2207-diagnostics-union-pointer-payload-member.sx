// A union or tagged-enum variant whose payload is a POINTER to a struct does
// not promote the pointee's members: the union's bytes are the pointer, not
// the pointee, so `.a` is `field not found` — write and read, both kinds.

S :: struct {
    a: i64 = 5;
}

U :: union {
    p: *S;
    f: f64;
}

E :: enum {
    p: *S;
    n: i64;
}

main :: () -> i32 {
    u : U = ---;
    u.a = 3;
    e : E = ---;
    e.a = 4;
    return (u.a + e.a).(i32);
}
