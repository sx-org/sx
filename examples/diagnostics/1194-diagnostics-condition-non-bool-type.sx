// A branch condition (`if` / `while` / `and` / `or`) reduces to an i1, so its type
// must be bool, integer, pointer, or optional. A struct has no truthiness and is a
// located type error.
@import "modules/std.sx";

S :: struct { x: i64; }

main :: () -> i64 {
    s : S = .{ x = 1 };
    if s { return 1; }   // ERROR: condition must be a bool, integer, pointer, or optional
    return 0;
}
