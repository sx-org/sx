// A `$T` comptime-type-param sigil in a struct FIELD type is invalid — a
// generic struct declares its type params in the header (`struct ($T: Type)`)
// and references them WITHOUT `$` in fields. Writing `$T` as a field type
// leaves `T` unbound; resolving the field type to the `.unresolved`
// sentinel panics the LLVM backend ("unresolved type
// reached LLVM emission"). It must be a clean located diagnostic.
// Regression. Expected: one located error; exit 1; no panic.
#import "modules/std.sx";

Gen :: struct { v: $T; }

main :: () { print("hi\n"); }
