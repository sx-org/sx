// A `$T` comptime-type-param sigil in a struct FIELD type is invalid: a generic
// struct declares its type params in the header (`struct ($T: Type)`) and
// references them WITHOUT `$` in fields, so `$T` as a field type leaves `T`
// unbound. One located error.
@import "modules/std.sx";

Gen :: struct { v: $T; }

main :: () { print("hi\n"); }
