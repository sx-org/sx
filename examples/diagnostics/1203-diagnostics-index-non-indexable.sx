// Indexing a value whose type is not an indexable shape — a single-element pointer
// `*T`, a pointer-to-slice `*[]T`, or a plain struct — is a located type error at
// lowering. Indexable shapes are `[N]T` / `[]T` / `[*]T` / `string` / `Vector` /
// `*[N]T` and the optional-chain forms.
//
// A COMPTIME-constant index into a struct value (`s[0]`) is the field itself
// (tuple parity), so the struct arm below pins the RUNTIME-index rejection —
// there is no runtime `[ ]` on structs (use `struct_field_value(s, j)`).
//
// For a single pointer `*T` the message hints at the indexable alternatives (a
// many-pointer `[*]T`, or dereference first); other non-indexable types get the
// bare "cannot index a value of type '...'" form.

#import "modules/std.sx";

S :: struct { a: i64; }

main :: () {
    x := 5;
    p : *i64 = *x;
    print("{}\n", p[0]);    // error: '*i64' is not indexable (hint form)

    s := S{ a = 1 };
    j := 0;
    print("{}\n", s[j]);    // error: runtime index into 'S' (bare form)
}
