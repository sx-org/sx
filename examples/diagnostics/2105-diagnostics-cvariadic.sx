// A C-variadic tail carries neither a count nor types, so only what a C ABI can
// pass through `va_arg` may cross it: the 32- and 64-bit integers, `f64`, the
// pointer family and its nullable forms, and function values carrying the C
// convention. Everything else is refused at the call, naming the argument.
//
// The refusals accumulate: each inadmissible argument is reported on its own.
//
// Widths below 32 bits are NOT refused here — they promote to `i32` on the way
// across, as `f32` promotes to `f64`. What is refused is a width C has no
// variadic slot for, and every aggregate.
//
// Reading a tail is the same rule from the other side. `@va_start` needs a tail
// to open, `@va_arg` asks for the type the promotions LEAVE in the slot, and the
// `@VaList` cursor itself is opaque: it has no value form, no published layout,
// and no way out of the frame whose tail it reads.
//
// The C boundary has two spellings and neither substitutes for the other:
// `ap: @VaList` is the C parameter and belongs only to an effective-C signature,
// `ap: *@VaList` the sx-internal borrow and belongs only outside one. A boundary
// argument names a live list — `ap` or `ap.*` — and an incoming list is borrowed
// already open, so its callee neither starts nor ends it.

@import "modules/std.sx";

printf :: (fmt: cstring, ..) -> i32 extern;
c_reader :: (n: i32, ap: @VaList) -> i64 extern;

// `..name: []U` is the homogeneous constraint: every tail argument takes the
// ordinary implicit conversion to `U`, and a pair no conversion models is
// refused exactly as it is at a fixed parameter of that type.
libc :: @library "c";
sum_ints :: (n: i32, ..args: []i32) -> i64 extern libc;
flags :: (n: i32, ..args: []bool) -> i64 extern libc;
texts :: (n: i32, ..args: []string) -> i64 extern libc;

Pair :: struct {
    a: i64;
    b: i64;
}

Keeps :: struct {
    cursor: @VaList;
    borrow: *@VaList;
}

// The rules follow the cursor into whatever carries it. A wrapper's own bytes
// ARE the list's where it holds one by value, and address another frame's where
// it holds a borrow — so a field, a global, a return, a parameter, and a layout
// query each refuse the wrapper exactly as they refuse the bare spelling.
Wraps :: struct {
    row: [1]@VaList;
    pair: struct { a: @VaList; b: i64 };
    maybe: ?@VaList;
    lent: [2]*@VaList;
}

VaPair :: struct { a: @VaList; b: i64 };

wrapped_global: [1]@VaList;
wrapped_borrows: []*@VaList;

hands_back_wrapped :: (ap: *@VaList) -> [1]@VaList { return ---; }

takes_wrapped :: (rows: [1]@VaList) -> i64 abi(.c) { return 0; }

takes_wrapped_borrow :: (rows: []*@VaList) -> i64 { return 0; }

// The two boundary spellings, each on the wrong side.
by_value :: (ap: @VaList) -> i64 { return 0; }

c_borrow :: (ap: *@VaList) -> i64 abi(.c) { return 0; }

// The same pair as function TYPES: `abi(.c)` is the only spelling that makes a
// type's signature the C one, so the by-value list needs it and the borrow
// refuses it. Each is named at every declaration that carries it.
NotC    :: (i32, @VaList) -> i64;
CBorrow :: (i32, *@VaList) -> i64 abi(.c);

Signatures :: struct {
    plain: NotC;
}

// A cursor in a global outlives every frame that could open one.
stored: @VaList;
stored_borrow: *@VaList;

hands_one_back :: (ap: *@VaList) -> @VaList { return *ap; }

no_tail :: () -> i64 {
    ap: @VaList = ---;
    @va_start(*ap);
    return 0;
}

escapes :: (n: i32, ..) -> *@VaList abi(.c) {
    ap: @VaList = ---;
    @va_start(*ap);
    return *ap;
}

ends_a_borrow :: (ap: *@VaList) -> i64 {
    @va_end(ap);
    return 0;
}

reads :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @va_start(*ap);
    narrow := @va_arg(u8, *ap);   // a `u8` argument sits in the slot as `i32`
    single := @va_arg(f32, *ap);  // an `f32` argument sits in it as `f64`
    aggregate := @va_arg(Pair, *ap);
    printf("%d\n", *ap);          // the cursor cannot leave this frame
    copied := ap;                 // no value form to copy
    word := ap.w0;                // no published fields
    later := || -> i64 { return @va_arg(i64, *ap); }; // a closure may outlive the frame
    rows: [1]@VaList = ---;
    kept := || -> i64 { return rows.len; }; // a wrapper carries the same tail
    @va_end(*ap);
    return xx narrow;
}

// A `@VaList` parameter names a place, so its argument must name one too:
// neither a borrow nor a plain value is one. A local annotated with either
// mis-signed function type is refused where it is written.
boundary_actuals :: (n: i32, ..) -> i64 abi(.c) {
    ap: @VaList = ---;
    @va_start(*ap);
    defer @va_end(*ap);
    lent: *@VaList = *ap;
    unusable: NotC = ---;
    also_unusable: CBorrow = ---;
    return c_reader(n, *ap) + c_reader(n, lent) + c_reader(n, 7);
}

// An incoming list is borrowed already open: its caller started it and ends it.
walks_a_borrowed_list :: (n: i32, ap: @VaList) -> i64 export {
    @va_start(*ap);
    @va_end(*ap);
    return c_reader(n, ap);
}

main :: () -> i32 {
    wide: i48 = 5;
    pair: Pair = .{1, 2};
    nums: [2]i32 = .[1, 2];
    absent: ?*i32 = null;
    held: cstring = "de";

    flags(1, absent);            // the element type's own refusal, on the tail
    texts(1, held);

    printf("%d\n", wide);        // a width no C variadic slot holds
    printf("%s\n", "sx string"); // two words: pointer and length
    printf("%d\n", pair);        // an aggregate
    printf("%d\n", nums);        // an array
    printf("%d\n", nums[0..1]);  // a slice is two words too
    sum_ints(1, pair);           // the same refusal on a named typed tail

    printf("%d %d %d\n", size_of(@VaList), align_of(@VaList), struct_field_count(@VaList));
    printf("%d %d %d\n", size_of([1]@VaList), align_of(?@VaList), struct_field_count(VaPair));
    made := @VaList{};
    printf("%d\n", reads(1, 2) + no_tail() + ends_a_borrow(*made));
    printf("%d\n", boundary_actuals(1, 2) + walks_a_borrowed_list(1, made));
    return 0;
}
