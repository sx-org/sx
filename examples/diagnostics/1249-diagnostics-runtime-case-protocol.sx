// The `protocol` type category exists ONLY in the static fold (`inline if` over a
// bound generic type param). A protocol value carries no runtime type tag to switch
// on, so a runtime `case protocol:` arm would be silently dead; it is a pointed
// compile error instead.
@import "modules/std.sx";

main :: () {
    av : any = 5;
    t := type_of(av);
    match t {
        case protocol: print("?\n");
        case int: print("int\n");
    }
}
