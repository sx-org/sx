// What a tagged value REFUSES. It has no owning form, so `free` and the
// allocator-carrying erasure have nothing to do; it is already a borrow, so
// no `*P` view is ever built for it; and its lifetime is its referent's, so
// erasing an rvalue at a `return` — where the frame holding the temp is
// about to die — is a compile error. `#identity` adds one more: an rvalue
// refuses everywhere, not only at `return`.
#import "modules/std.sx";
#import "modules/std/mem.sx";

View :: protocol tagged { area :: (self: *Self) -> i64; }
Widget :: struct { n: i64; }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n } }

Collector :: protocol tagged #identity { put :: (self: *Self, v: i64); }
Accum :: struct { sum: i64; }
impl Collector for Accum { put :: (self: *Accum, v: i64) { self.sum = self.sum + v; } }

measure :: (v: *View) -> i64 { v.area() }

// The frame that would hold the temporary dies with the return.
escaping :: () -> View { return Widget.{ n = 1 }; }

main :: () {
    w := Widget.{ n = 3 };
    v : View = w;

    // No owned backing: nothing to release.
    free(v);

    // No owning form, so no allocator argument.
    y := w.(View, context.allocator);

    // A tagged value IS the borrow — `*View` never builds a view over a
    // concrete lvalue.
    print("{}\n", measure(w));

    // The identity naming discipline: an anonymous instance has no name to
    // borrow.
    s : Collector = Accum.{ sum = 0 };

    print("{}\n", escaping().area());
}
