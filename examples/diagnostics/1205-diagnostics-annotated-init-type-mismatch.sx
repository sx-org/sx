// Initializing or reassigning an explicitly-annotated slot with a value whose type
// has NO coercion to the annotation is a located type error. `checkAssignable`
// rejects it at every store-into-annotated-slot site — var-decl, body-local
// const-decl, and reassignment.
//
// The explicit `xx` / `.(T)` escape hatch is unaffected: an explicit
// reinterpretation (pointer↔int, etc.) still passes through.

#import "modules/std.sx";

main :: () -> i64 {
    x : i32 = "hi";        // error: cannot initialize 'x' (string ↛ i32)

    y : i32 = 0;
    y = "nope";            // error: cannot reassign 'y' (string ↛ i32)

    C : i32 : "also";      // error: cannot initialize 'C' (string ↛ i32)

    return 0;
}
