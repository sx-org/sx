// A diagnostic names a generic instance by its template applied to its
// arguments. A template whose name another declaration shares also carries the
// file that declares it.
a :: @import "2943-diagnostics-an-instance-is-named-by-its-template/a.sx";
b :: @import "2943-diagnostics-an-instance-is-named-by-its-template/b.sx";

Grid :: struct($N: i64, $T: Type) { cells: [N]T; }

main :: () {
    s : b.Series(i64) = a.series();
    g := Grid(2, i64){ cells = .[1, 2] };
    _ = g + 1;
}
