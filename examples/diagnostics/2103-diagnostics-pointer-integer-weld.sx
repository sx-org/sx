// Pointer/integer reinterpretation requires an explicit cast whose target is
// the destination type. The rule applies to calls, declarations, assignments,
// and returns, including optional pointer values.

@import "modules/std.sx";

Obj :: struct { v: i64 = 1; flush: i64 = 2; }

flush :: ufcs (v: i64) { print("PLAIN flush {}\n", v); }

take :: (v: i64) -> i64 { v }

give :: (p: *Obj) -> i64 { return p; }

main :: () -> i32 {
    o := Obj{};
    p := *o;

    p.flush();
    flush(p);
    n := take(p);

    m : i64 = p;
    m = p;
    r := give(p);

    q : *Obj = m;
    c : cstring = 5;

    wrongTarget : i64 = p.(*void);
    number : i64 = 5;
    wrongPointer : *Obj = number.(u64);

    maybeP : ?*Obj = p;
    maybeNumber : i64 = maybeP;
    maybeArg := take(maybeP);

    explicitXx : i64 = xx p;
    explicitPostfix : i64 = p.(i64);

    print("{} {} {} {} {} {} {} {} {} {}\n", n, r, q == null, c == null, wrongTarget, wrongPointer == null, maybeNumber, maybeArg, explicitXx, explicitPostfix);
    0
}
