// N48 (fluent spec §6.3): inside a build block, a statement-position block whose
// trailing expression has no `;` is an error when that value is non-void.
//
// Without it the value would be the inner block's value, which the enclosing
// statement discards — a child that vanishes with no signal at all. The two fixes
// are the two things the writer could have meant: publish it (`;`) or discard it
// (`_ = …;`).
//
// Three shapes are exempt, and this file has one of each so the rule cannot creep:
// a void trailing expression (nothing to publish), a value-POSITION block (its
// value is used), and the body's own top level, where a trailing expression is a
// child like any other and publishes — so there is nothing for the rule to catch.
// Expected: exit 1.
#import "modules/std.sx";
#import "modules/fluent.sx";

Drawable :: protocol tagged {
    draw :: (self: *Self) -> string;
}

Label :: struct { text: string = ""; }
impl Drawable for Label {
    draw :: (self: *Label) -> string => self.text;
}

Tally :: struct {
    n: i32 = 0;
    expression :: (self: *Tally, value: $I/@Init($V/Drawable)) { self.n += 1; }
}

side :: () {}

collect :: (content: $B/@BuildBlock(Drawable)) -> i32 {
    sink := Tally{};
    content.run(*sink);
    sink.n
}

main :: () -> i32 {
    show := true;
    rows := .["a", "b"];

    _n := collect() {
        if show {
            Label{ text = "in a branch" }   // refused: neither published nor used
        }

        for rows (row) {
            Label{ text = row }             // refused: same, per iteration
        }

        {
            Label{ text = "in bare braces" } // refused: same
        }

        if show {
            side()                          // exempt: void, nothing to publish
        }

        chosen := if show { Label{ text = "x" } } else { Label{ text = "y" } };
        chosen;                             // exempt: a value-position block, used

        Label{ text = "published" };        // the shape that was meant
    };
    0
}
