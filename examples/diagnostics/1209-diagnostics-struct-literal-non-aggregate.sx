// A struct literal `.{ ... }` whose resolved target type is a scalar (or any other
// non-aggregate) is a located type error at lowering — for the named form, the
// empty `.{}`, and through the optional `?T = .{...}` recursion, which unwraps to
// the scalar child. Aggregate targets — struct / tuple / array / vector / slice /
// `string`, the two {ptr,len} fat-pointer forms — are unaffected.

#import "modules/std.sx";

main :: () {
    x : i64 = .{ a = 1 };     // error: named literal against a scalar
    print("{}\n", x);

    y : i64 = .{};            // error: empty literal against a scalar (was silent garbage)
    print("{}\n", y);

    o : ?i64 = .{ a = 1 };    // error: optional path recurses with child 'i64'
    print("{}\n", o);
}
