A :: struct { pz: i64; }
Plain :: A{pz = Plain.pz};
Spread :: A{..Spread};
First :: A{..Second};
Second :: A{pz = First.pz};

apply :: (f: $F/(i64) -> i64, x: i64) -> i64 { return f(x); }
Lambda :: A{pz = apply(|x: i64| -> i64 x + Lambda.pz, 1)};

main :: () {
    plain := Plain;
    spread := Spread;
    mutual := First;
    lambda := Lambda;
}
