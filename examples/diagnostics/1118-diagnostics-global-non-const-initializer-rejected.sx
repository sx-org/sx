// A top-level global initialized from a non-constant expression — here the field
// access `K.x` on a module constant — reports `global 'g' must be initialized by
// a compile-time constant`.

@import "modules/std.sx";

Point :: struct { x: i32; y: i32; }
K : Point : Point{ x = 9, y = 4 };
g : i32 = K.x;

main :: () -> i32 {
    print("g={}\n", g);
    return g;
}
