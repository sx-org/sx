// A NON-integral float constant (`4.5`) as an array dimension is a hard error;
// an integral float (`4.0`) folds to a count. The dimension follows the unified
// float→int narrowing rule — the same `floatToIntExact` judgement the typed
// local/field/param/const sites use.
#import "modules/std.sx";

N : f64 : 4.5;

main :: () {
    a : [N]i64 = ---;
    print("unreachable: {}\n", a.len);
}
