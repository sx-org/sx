// The mirror of the lopsided `-` (2062), on the other glyph that carries a
// prefix reading. `a* b` is glued on its left and spaced on its right: it is
// not infix (the gaps do not match) and it is not a prefix `*` either (a
// prefix binds only when glued to its operand), so it has no reading at all.
#import "modules/std.sx";

main :: () -> i32 {
    a := 6;
    b := 7;
    x := a* b;
    print("{}\n", x);
    return 0;
}
