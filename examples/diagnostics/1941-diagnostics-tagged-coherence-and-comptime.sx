// Two consequences of "whole program, at link". COHERENCE is global on the
// tagged kind: one `(protocol, conformer)` pair may have exactly one impl,
// whatever the import visibility, because the switch arm the pair owns can
// only call one body. And a tagged value has no COMPTIME representation: its
// numeric word is assigned when the converged set is numbered, which happens
// after every compile-time evaluation has run.
#import "modules/std.sx";

View :: protocol tagged { area :: (self: *Self) -> i64; }

Widget :: struct { n: i64; }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n } }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n * 2 } }

// The concrete method stays callable at comptime — only the erased VALUE is
// staged out.
CONCRETE :: #run { w := Widget.{ n = 4 }; w.area() };

// A tagged value inside a `#run` refuses at the erasure and at the dispatch.
ERASED :: #run { w := Widget.{ n = 4 }; v : View = w; v.area() };

main :: () {
    w := Widget.{ n = 3 };
    v : View = w;
    print("{} {} {}\n", v.area(), CONCRETE, ERASED);
}
