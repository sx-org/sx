// A comptime-CONSTRUCTED enum (declare/define) that contains itself BY VALUE is
// infinitely sized and rejected: the `checkInfiniteSize` guard covers minted types
// as well as source decls (1178). A pointer payload (`*L`) breaks the cycle and is
// the fix the message suggests (0618 has the working recursive `*List`).
//
// Referencing a declared slot BY VALUE inside its own definition is the one
// self-reference shape that is illegal; a `*L` pointer needs no layout.
@import "modules/std.sx";
@import "modules/std/meta.sx";

make :: () -> Type {
    h := declare("L");
    return define(h, .enum(.{ variants = .[
        EnumVariant{ name = "cons", payload = L },     // by VALUE, not *L
        EnumVariant{ name = "nil",  payload = void },
    ] }));
}

L :: make();

main :: () -> i32 {
    x : L = .nil;
    return 0;
}
