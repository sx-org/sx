// A top-level VALUE constant (`NotAType :: 123`) used in a type position reports
// `unknown type 'NotAType'`. Only a const whose value introduces a type — a
// declaration or a type-expression alias — counts as a type name.

#import "modules/std.sx";

NotAType :: 123;

main :: () -> i32 {
    v: NotAType = ---;
    print("value = {}\n", v);
    return 0;
}
