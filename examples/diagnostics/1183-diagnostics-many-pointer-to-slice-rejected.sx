// A many-pointer `[*]T` carries NO length, so it does not coerce to a slice `[]T`
// implicitly — an 8-byte pointer where a 16-byte `{ptr,len}` fat pointer is
// expected. The diagnostic asks for the length via `ptr[0..len]`.
#import "modules/std.sx";

sum :: (s: []i64) -> i64 {
    total := 0;
    for x in s { total += x; }
    return total;
}

main :: () -> i32 {
    a : [4]i64 = .[10, 20, 30, 40];
    mp : [*]i64 = xx *a[0];   // a genuine many-pointer (carries no length)
    r := sum(mp);             // [*]i64 → []i64 — rejected; needs mp[0..len]
    print("{}\n", r);
    return 0;
}
