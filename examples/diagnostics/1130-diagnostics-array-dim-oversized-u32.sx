// An array dimension that folds to a valid compile-time integer but exceeds a
// `u32` (`[5_000_000_000]i64`) is a hard error — a clean sx diagnostic with a
// non-zero exit, NOT a compiler panic.
//
// The dimension folds to a valid i64 (5e9), so narrowing it with an unchecked
// `@intCast` to u32 aborts the COMPILER with "integer does not fit in
// destination type". Every dim/lane fold narrows through the single
// range-checked `program_index.foldDimU32`, which reports an out-of-u32-range
// dimension as this diagnostic and halts the build.
#import "modules/std.sx";

main :: () {
    a : [5000000000]i64 = ---;
    print("unreachable: {}\n", a.len);
}
