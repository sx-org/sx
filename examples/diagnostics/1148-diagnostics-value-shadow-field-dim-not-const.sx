// Field access on a raw value binding is an ordinary runtime field read, so
// `` `i8.max `` is a runtime value — not the builtin `i8.max` (127) and not a
// compile-time constant. Used as an array DIMENSION it earns the same diagnostic a
// plainly-named runtime field read (`b.max`) does; the backtick spelling changes
// nothing.
//
// Negative companion to 0169, the FLOAT-field narrowing half.
#import "modules/std.sx";

DimBox :: struct { max: i64; }

main :: () {
    `i8 := DimBox{ max = 3 };
    // Raw value-shadow field read → a runtime value, not the builtin `i8.max`
    // (127) and not a compile-time constant → rejected as a non-const dim.
    arr : [`i8.max]f32 = ---;
    print("len={}\n", arr.len);
}
