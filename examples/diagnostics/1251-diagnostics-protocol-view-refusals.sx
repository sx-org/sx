// `*P` view refusals: an RVALUE has no durable storage to borrow, so both the decl
// form and the argument form are compile errors.
@import "modules/std.sx";

Sizable :: interface { size :: (self: *Self) -> i64; }
Widget :: struct { value: i64; }
impl Sizable for Widget { size :: (self: *Widget) -> i64 { self.value } }

takeView :: (v: *Sizable) -> i64 { v.size() }
make :: () -> Widget { Widget{ value = 2 } }

main :: () {
    pv : *Sizable = Widget{ value = 1 };   // rvalue literal → refusal
    print("{}\n", takeView(make()));       // rvalue call result → refusal
}
