// A member's payload and its brace group answer to each other: a payload needs
// braces, and braces need a payload. Empty braces stand only for a struct
// payload's defaults, and a construction head names a member the set carries —
// as does a `match` arm binding one.

PayErr :: error {
    Bare;
    Wide: i64;
    Boxed: struct { v: i32; at: i64 };
}

bareMember   :: (n: i64) -> (i64, !PayErr) { if n < 0 { raise PayErr.Wide; }    return n; }
voidBraces   :: (n: i64) -> (i64, !PayErr) { if n < 0 { raise .Bare{1}; }       return n; }
emptyScalar  :: (n: i64) -> (i64, !PayErr) { if n < 0 { raise .Wide{}; }        return n; }
absent       :: (n: i64) -> (i64, !PayErr) { if n < 0 { raise PayErr.Gone{1}; } return n; }
sound        :: (n: i64) -> (i64, !PayErr) { if n < 0 { raise .Bare; }          return n; }
absentArm    :: (n: i64) -> i64 { return sound(n) catch |e| match e { case .Gone: |g| g; else: 0; }; }

main :: () -> i32 {
    a := bareMember(-1) catch { 0 };
    b := voidBraces(-1) catch { 0 };
    c := emptyScalar(-1) catch { 0 };
    d := absent(-1) catch { 0 };
    e := absentArm(-1);
    return xx (a + b + c + d + e);
}
