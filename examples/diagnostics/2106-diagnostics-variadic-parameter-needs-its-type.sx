// A variadic parameter carries its own type. There is nothing to infer one
// from: the slice form `..name: []T` IS the annotation, and the packs
// `..$name/P` and `..$name` take their element types from the call. A name with
// neither is refused at the parameter, ahead of any lowering.

f :: (n: i32, ..args) -> i32 {
    return n;
}

main :: () -> i32 {
    return f(1, 2);
}
