// A variadic parameter carries its own type. There is nothing to infer one
// from: the slice and constraint or interface forms ARE the annotation, and `..$name` is a
// comptime pack whose element types come from the call. A name with neither is
// refused at the parameter, ahead of any lowering.

f :: (n: i32, ..args) -> i32 {
    return n;
}

main :: () -> i32 {
    return f(1, 2);
}
