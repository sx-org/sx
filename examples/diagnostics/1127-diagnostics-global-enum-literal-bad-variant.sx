// A module-global enum-literal initializer naming a variant the enum does not
// have reports `'.purple' is not a variant of enum 'Color'` — never a silent
// zero-tag initializer.

#import "modules/std.sx";

Color :: enum u8 { red; green; blue; }
bad : Color = .purple;

main :: () -> i32 {
    print("{}\n", bad);
    return 0;
}
