// The terminator is a type guarantee, so nothing implicitly adds one: a
// `string` reaches a `cstring` slot only through `toCstring`'s owned copy.
// Dropping the guarantee needs no glyph — a `cstring` IS a `string` view.
@import "modules/std.sx";

main :: () -> i32 {
    s := concat("a", "b");
    c : cstring = s;            // error: an unterminated string -> cstring
    t : string = toCstring(s);
    print("{}{}\n", t, c.len);
    return 0;
}
