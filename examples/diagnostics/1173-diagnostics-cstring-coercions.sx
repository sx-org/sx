// cstring's coercion discipline: the terminator is a type guarantee, and a
// `string` carries none — materialize one with toCstring. The reverse is
// never implicit either: the length is an O(n) strlen the code asks for
// with fromCstring.
@import "modules/std.sx";

main :: () -> i32 {
    s := concat("a", "b");
    c : cstring = s;            // error: an unterminated string -> cstring
    t : string = c;             // error: cstring -> string
    print("{}{}\n", t, cstringLen(c));
    return 0;
}
