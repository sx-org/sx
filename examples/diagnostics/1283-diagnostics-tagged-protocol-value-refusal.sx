// A NULLARY `tagged` protocol has its full runtime model: it erases, stores
// in fields and parameters, and dispatches through its generated switch.
// A PARAMETERIZED one does not yet — each canonical argument tuple names its
// own protocol with its own conformer set and tag space, and that machinery
// is staged. Every position that would make a value of an instantiation
// refuses through the ordinary error path.
#import "modules/std.sx";

View :: protocol tagged {
    area :: (self: *Self) -> i64;
}
Series :: protocol(T: Type) tagged {
    at :: (self: *Self, i: i64) -> T;
}

Widget :: struct { n: i64; }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n } }
impl Series(i64) for Widget { at :: (self: *Widget, i: i64) -> i64 { self.n + i } }

Screen :: struct { root: View; }               // field — fine, 16 bytes
render :: (v: View) -> i64 { v.area() }        // parameter — fine

Feed :: struct { rows: Series(i64); }          // field of an instantiation
sample :: (s: Series(i64)) -> i64 { s.at(0) }  // parameter of an instantiation

main :: () {
    // The classifier answers for both heads.
    print("{}\n", protocol_kind(View) == .tagged);

    w := Widget.{ n = 3 };
    v : View = w;                              // the nullary erasure works
    print("{} {}\n", v.area(), render(w));
    print("{}\n", Screen.{ root = v }.root.area());

    s : Series(i64) = w;                       // the parameterized one is staged
}
