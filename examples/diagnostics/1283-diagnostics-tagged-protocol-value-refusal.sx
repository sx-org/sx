// A `tagged` protocol parses and classifies — `protocol_kind` answers
// `.tagged`, impls register, and it bounds generics like any other kind.
// What it does not have here is a runtime model: every position that would
// make a tagged VALUE refuses through the ordinary error path, naming the
// kinds that do erase.
#import "modules/std.sx";

View :: protocol tagged {
    area :: (self: *Self) -> i64;
}
Series :: protocol(T: Type) tagged {
    at :: (self: *Self, i: i64) -> T;
}

Widget :: struct { n: i64; }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n } }
impl Series(i64) for Widget { at :: (self: *Widget, i: i64) -> i64 { self.n + i } }

Screen :: struct { root: View; }               // field
render :: (v: View) -> i64 { v.area() }        // parameter

main :: () {
    // The classifier works — the kind is a fact about the declaration.
    print("{}\n", protocol_kind(View) == .tagged);

    w := Widget.{ n = 3 };
    v : View = w;                              // erasure into a value
    s : Series(i64) = w;                       // the parameterized instantiation
}
