// An UNKNOWN type name inside a NON-TUPLE composite type-alias RHS is a hard error
// at the alias declaration. Every composite RHS kind — array / slice / optional /
// pointer / many-pointer / function / closure, and nested combinations — routes the
// element/pointee/param/return through the `UnknownTypeChecker` walk, so
// `NoSuchType` earns the same "unknown type" diagnostic the inline annotation form
// does.
//
// Only the ARRAY form is exercised here, keeping one diagnostic per snapshot; the
// slice / optional / pointer / function / nested shapes are covered by the
// compiler's unit tests in src/ir/lower.test.zig.
@import "modules/std.sx";

Bad :: [3]NoSuchType;

main :: () -> i32 {
    b : Bad = ---;
    _ := b;
    print("unreachable\n");
    0
}
