// An interface handle borrows its referent, so there is no allocating
// erasure: naming an allocator in the postfix cast is refused.
@import "modules/std.sx";

Greeter :: interface { greet :: (self: *Self) -> i64; }

Hello :: struct { n: i64; }
impl Greeter for Hello { greet :: (self: *Hello) -> i64 { self.n } }

main :: () {
    h := Hello{ n = 7 };
    _ = h.(Greeter, context.allocator);
}
