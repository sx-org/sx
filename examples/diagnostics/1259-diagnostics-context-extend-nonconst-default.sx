// A `@context.extend` default folds to a compile-time constant: it is baked into
// `__sx_default_context`, which exists before `main` runs. A runtime call cannot
// initialize it, and the serializer rejects it rather than zero-filling the field.
@import "modules/std.sx";

nowMs :: () -> i64 { return 42; }

@context.extend startedAt: i64 = nowMs();

main :: () {}
