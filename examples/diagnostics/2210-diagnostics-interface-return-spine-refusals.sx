// A concrete rvalue at an I-typed target has no storage of its own to borrow.
// Binding, assignment, field init, call argument, and return all refuse it.
// `.{ }` is a struct literal, not a handle. Absence of `?I` is `null`.
@import "modules/std.sx";

P :: interface { a :: (self: *Self) -> i64; }
W :: struct { v: i64; }
impl P for W { a :: (self: *W) -> i64 { self.v } }
S :: struct { inner: P; }

rvalueDirect :: () -> P { return W{ v = 1 }; }
rvalueInLiteral :: () -> S { return S{ inner = W{ v = 2 } }; }
emptyLiteral :: () -> P { return .{}; }

take :: (v: P) -> P { v }
throughArgument :: () -> P { return take(W{ v = 3 }); }
throughBinding :: () -> P { r : P = ---; r = W{ v = 4 }; return r; }
absent :: () -> ?P { return null; }

main :: () {
    _ = rvalueDirect();
    _ = rvalueInLiteral();
    _ = emptyLiteral();
    _ = throughArgument();
    _ = throughBinding();
    _ = absent();
}
