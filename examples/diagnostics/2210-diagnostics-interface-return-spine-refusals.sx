// A concrete rvalue at an I-typed target has no storage of its own to borrow.
// Binding, assignment, field init, call argument, and return all refuse it.
// `.{ }` is a struct literal, not a handle. Absence of `?I` is `null`.
@import "modules/std.sx";

P :: interface { a :: (self: *Self) -> i64; }
W :: struct { v: i64; }
impl P for W { a :: (self: *W) -> i64 { self.v } }
S :: struct { inner: P; }

rvalue_direct :: () -> P { return W{ v = 1 }; }
rvalue_in_literal :: () -> S { return S{ inner = W{ v = 2 } }; }
empty_literal :: () -> P { return .{}; }

take :: (v: P) -> P { v }
through_argument :: () -> P { return take(W{ v = 3 }); }
through_binding :: () -> P { r : P = ---; r = W{ v = 4 }; return r; }
absent :: () -> ?P { return null; }

main :: () {
    _ = rvalue_direct();
    _ = rvalue_in_literal();
    _ = empty_literal();
    _ = through_argument();
    _ = through_binding();
    _ = absent();
}
