// Assigning to a field a struct does not have reports the same
// `field 'X' not found on type 'Y'` diagnostic as the read path (1100). All three
// lvalue sites emit it: the assignment-target path (`p.q`), the nested
// lvalue-pointer path (`o.missing.a`), and the multi-target store (`p.r, y`).

Point :: struct { x: i64; }
Inner :: struct { a: i64; }
Outer :: struct { inner: Inner; }

main :: () -> i32 {
    p := Point{ x = 1 };
    p.q = 2;                              // site 1: lowerAssignment target path

    o := Outer{ inner = Inner{ a = 1 } };
    o.missing.a = 5;                      // site 2: lowerExprAsPtr fallback

    y : i64 = 0;
    p.r, y = 3, 4;                        // site 3: lowerMultiAssign field path

    return 0;
}
