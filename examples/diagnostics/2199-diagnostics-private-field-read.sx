// A private field cannot be read by name from another file — including a
// callable field, which a call spelling reaches as a field and not as a method.

box :: @import "2199-diagnostics-private-field-read/box.sx";

main :: () -> i32 {
    x := box.make();
    x.fp(1);
    x.cl(1);
    return x.secret.(i32);
}
