// Passing a `*T` where a `T` value is expected is caught at the call site for any
// pointer, not only a `for xs (*m)` loop capture (see 215) — here a `*Move`
// parameter forwarded into a by-value parameter.

#import "modules/std.sx";

Move :: struct { flag: i64; }

take :: (m: Move) -> i64 { return m.flag; }

forward :: (m: *Move) -> i64 { return take(m); }

main :: () -> i32 {
    mv : Move = .{ flag = 7 };
    return xx forward(*mv);
}
