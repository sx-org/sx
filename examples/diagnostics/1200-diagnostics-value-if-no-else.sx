// A no-`else` block `if` in VALUE position is a located compile-time error. The
// `:=` RHS below is a value context whose `if` has no `else`, so it has no value:
// "an `if` used as a value must have an `else` branch".
//
// A no-`else` `if` used purely as a STATEMENT stays valid and is not exercised
// here.
@import "modules/std.sx";

main :: () {
    y := if true { 1 };
    print("{}\n", y);
}
