// An INLINED comptime body is diagnosed against ITS OWN declared return type,
// not against whichever caller it was inlined into. The body shares the caller's
// instruction stream, so without an exit context of its own it read the caller's
// signature: a `try` in a void callee borrowed the CALLER's error channel and
// propagated silently through it, and a `-> T` callee that produced no value
// filled the caller's slot with whatever its uninitialized alloca held.
//
// Both are the same rule the real body path already applies — the refusals name
// the callee's type because the callee's type is what the exit has to satisfy.
// Expected: exit 1.
Bad :: error { Nope }

fails :: () -> (i64, !Bad) {
    raise error.Nope;
}

// Refused: `try` needs a failable function to propagate INTO, and this callee
// is `-> void`. The failable caller below is not its channel.
absorbing :: ($tag: string) {
    v := try fails();
    v = v;
}

// Refused the same way: `raise` needs the same channel `try` does.
raising :: ($tag: string) {
    raise error.Nope;
}

// Refused: the body ends in a valueless statement, so nothing fills the `i64`.
novalue :: ($tag: string, n: i64) -> i64 {
    if n > 0 { n = n + 1; }
}

main :: () -> (i64, !Bad) {
    absorbing("a");
    raising("b");
    novalue("c", 1)
}
