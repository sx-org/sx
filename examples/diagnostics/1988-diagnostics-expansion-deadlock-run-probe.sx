// The design's flagship conformance-conditional: a `#run` that asks about a
// protocol the branch it selects feeds.
//
// The run has a body, so it EXECUTES — and the probe inside it is a real
// value-level conformance question about `Serialize` and `GPA`. An erased
// protocol's answer is utterable only against impls nothing can still write.
// The only driver in the program is the one reading the run, and its taken
// branch would declare exactly the impl in question, so the fact it awaits is
// one only it could fire.
//
// Runnable work is exhausted with the bookmark still down. A state admitting
// more than one consistent outcome is genuinely ambiguous, so sx refuses
// rather than electing a fixpoint (specs.md §7.9).
#import "modules/std.sx";

Serialize :: protocol vtable { write :: (self: *Self) -> i64; }

GPA :: struct { n: i64; }

HAS :: #run { g := GPA{ n = 1 }; g.(?Serialize) != null };

inline if !HAS {
    impl Serialize for GPA { write :: (self: *GPA) -> i64 { self.n } }
}

main :: () {
    g := GPA{ n = 3 };
    print("{}\n", g.n);
}
