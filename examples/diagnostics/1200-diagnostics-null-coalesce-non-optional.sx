// `??` (null-coalesce) requires an optional left operand; a resolved non-optional
// lhs is a located type error. The guard inspects the inferred lhs type before
// codegen. An already-`.unresolved` lhs — a prior error, e.g. an undefined name —
// passes through untouched, so the original diagnostic is not double-reported.

#import "modules/std.sx";

main :: () {
  x := 5 ?? 7;   // <- left operand of '??' must be an optional, but has type 'i64'
  print("{}\n", x);
}
