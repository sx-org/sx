// Coherence is GLOBAL on the tagged kind: one `(protocol, conformer)` pair may
// have exactly one impl, whatever the import visibility, because the switch arm
// that pair owns can only call one body. The collision is diagnosed once the
// instantiation is REACHED — and reaching it takes no value: asking about
// membership computes the set, so a protocol named only by `has_impl` is
// checked exactly like one the program erases into.
#import "modules/std.sx";

View :: protocol tagged { area :: (self: *Self) -> i64; }

Widget :: struct { n: i64; }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n } }
impl View for Widget { area :: (self: *Widget) -> i64 { self.n * 2 } }

// Nothing ever makes a `Mark` value — the question alone arms its coherence.
Mark :: protocol tagged { rank :: (self: *Self) -> i64; }

Badge :: struct { k: i64; }
impl Mark for Badge { rank :: (self: *Badge) -> i64 { self.k } }
impl Mark for Badge { rank :: (self: *Badge) -> i64 { self.k + 1 } }

ASKED :: #run has_impl(Mark, Badge);

main :: () {
    w := Widget{ n = 3 };
    v : View = w;
    print("{} {}\n", v.area(), ASKED);
}
