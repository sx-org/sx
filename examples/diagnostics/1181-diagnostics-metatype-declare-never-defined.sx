// A `meta.declare("X")` that no `meta.define(handle, info)` completes is
// rejected. `meta.declare` mints an empty nominal slot with zero variants,
// which is never a usable type; the diagnostic names the type and the call.
@import "modules/std.sx";
@import "modules/std/meta.sx";

Undef :: meta.declare("Undef");          // never defined

main :: () -> i32 {
    x : Undef = ---;
    return 0;
}
