// A `declare("X")` that no `define(handle, info)` completes is rejected. `declare`
// mints an empty nominal slot with zero variants, which is never a usable type;
// the diagnostic names the type and points at the bare `declare`.
@import "modules/std.sx";
@import "modules/std/meta.sx";

Undef :: declare("Undef");          // never define()d

main :: () -> i32 {
    x : Undef = ---;
    return 0;
}
