// A generic value-param arg that does not fit its declared integer type is a hard
// error when that type is reached through a type ALIAS too (`$K: Count` where
// `Count :: u32`, `$K: Small` where `Small :: i8`). The constraint resolves to
// its underlying builtin before range-checking, at both the struct and type-fn
// binders.
#import "modules/std.sx";

Count :: u32;
Small :: i8;
Box  :: struct ($K: Count) { value: i64; }
Tiny :: struct ($K: Small) { value: i64; }

main :: () {
    b : Box(5000000000) = ---;
    t : Tiny(300) = ---;
    print("unreachable {} {}\n", b.value, t.value);
}
