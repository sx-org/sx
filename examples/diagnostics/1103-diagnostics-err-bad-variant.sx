// A match arm naming a variant the subject's enum/tagged-union does not have
// reports `no variant 'X' on type 'Y'`.

@import "modules/std.sx";

Shape :: enum {
    circle: f32;
    rect: struct { w, h: f32; };
    none;
}

main :: () {
    s :Shape = .circle(3.14);
    match s {
        case .circle: |r| { print("r={}\n", r); }
        case .Bogus: |x| { print("bogus={}\n", x); }
        case .none: print("none\n");
        case .rect: print("rect\n");
    }
}
