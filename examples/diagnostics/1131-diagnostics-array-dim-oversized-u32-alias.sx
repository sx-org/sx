// An out-of-u32 array dimension reports the same precise diagnostic behind a type
// ALIAS (`Big :: [5_000_000_000]i64`) as written directly (example 1130): both
// route through one shared folder and one shared message map. The message names
// the u32 bound, since 5_000_000_000 IS a compile-time integer constant — a
// genuinely non-const alias dim gets the generic message instead (example 1129).
#import "modules/std.sx";

Big :: [5000000000]i64;

main :: () {
    a : Big = ---;
    a[0] = 7;
    print("unreachable: {}\n", a[0]);
}
