// Erasing a concrete type to a protocol it does NOT `impl`-ement is reported at
// the erasure site. A plain free function `speak :: (self: *Dog)` with a matching
// receiver does not satisfy the protocol: erasure is impl-driven, not structural
// (specs.md §"Storage and protocol conformance").

#import "modules/std.sx";

Speaker :: protocol vtable { speak :: (self: *Self) -> i64; }
Dog :: struct { n: i64 = 0; }
speak :: (self: *Dog) -> i64 { return self.n; }   // free fn — NOT an impl
Holder :: struct { s: Speaker; b: i64 = 0; }

main :: () {
  d := Dog{ n = 42 };
  h : Holder = .{ s = d.(Speaker, context.allocator), b = 5 };   // <- 'Dog' does not implement 'Speaker'
  print("{}\n", h.s.speak());
}
