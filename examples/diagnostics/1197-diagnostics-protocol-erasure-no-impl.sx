// Coercing a concrete type to an interface it does NOT `impl`-ement is reported at
// the site. A plain free function `speak :: (self: *Dog)` with a matching
// receiver does not satisfy the interface: handle coercion is impl-driven, not
// structural.

@import "modules/std.sx";

Speaker :: interface { speak :: (self: *Self) -> i64; }
Dog :: struct { n: i64 = 0; }
speak :: (self: *Dog) -> i64 { return self.n; }   // free fn — NOT an impl
Holder :: struct { s: Speaker; b: i64 = 0; }

main :: () {
  d := Dog{ n = 42 };
  h : Holder = .{ s = d.(Speaker), b = 5 };   // <- 'Dog' does not implement 'Speaker'
  print("{}\n", h.s.speak());
}
