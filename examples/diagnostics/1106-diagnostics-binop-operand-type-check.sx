// Scalar binary operators check operand-type compatibility; the result type is
// otherwise taken from the left operand. Rejected at compile time:
// - arithmetic `+ - * / %`  (numeric / vector / pointer operands)
// - ordering   `< <= > >=`  (numeric / enum / pointer operands)
// - bitwise    `& | ^`      (integer / enum operands)
// - shift      `<< >>`      (integer / enum operands)
// Int+float promotion, flags-enum bitwise and enum/pointer comparison are
// legitimate mixes — see `examples/50-smoke.sx`.

#import "modules/std.sx";

main :: () -> i32 {
    n : i64 = 40;
    s : string = "nope";
    a := n + s;      // arithmetic: i64 + string
    b := s * n;      // arithmetic: non-numeric LHS (string * i64)
    c := n < s;      // ordering:   i64 < string
    d := n & s;      // bitwise:    i64 & string
    e := n << s;     // shift:      i64 << string
    0
}
