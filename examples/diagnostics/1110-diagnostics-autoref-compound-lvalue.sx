// Auto-ref of a COMPOUND lvalue (field access / index / deref) passed to a `*T`
// parameter references the real lvalue, not a copy: `make_move(self.board, m)`
// mutates the field itself. Plain locals (`bump(x)`) and compound lvalues
// auto-ref alike.

@import "modules/std.sx";

S :: struct { v: i32; }
W :: struct { s: S; }

bump :: (p: *S) { p.v = p.v + 41; }

main :: () -> i32 {
    w : W = .{ s = .{ v = 1 } };
    bump(w.s);                       // field access, no `@` — auto-refs &w.s
    print("w.s.v = {}\n", w.s.v);    // 42, not 1
    return 0;
}
