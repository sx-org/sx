// A case-style match subject carries a discriminant the switch can dispatch on:
// enums, tagged unions, error sets, optionals, integers, bools, or type ids (specs
// §Pattern Matching). A `string` subject and a float subject have none and are
// rejected up front with a located diagnostic.
#import "modules/std.sx";

main :: () {
    s : string = "hi";
    r := if s == { case "hi": { 1 } case "bye": { 2 } else: { 0 } };
    print("{}\n", r);

    x : f64 = 2.5;
    y := if x == { case 1: { 10 } case 2: { 20 } else: { 0 } };
    print("{}\n", y);

    // A type-CATEGORY pattern doesn't smuggle the string past the gate: the
    // exemption is a property of the SUBJECT (a Type value — `type_of(...)`
    // / `$T`), never of the patterns.
    u := if s == { case string: { 1 } else: { 0 } };
    print("{}\n", u);

    // An `any` subject IS legal — it is the TYPE SWITCH, dispatching on the
    // value's runtime type tag — but its arms name TYPES or CATEGORIES.
    // Value patterns still cannot reach the unboxed payload (the
    // silently-wrong arm would be `any = 6` matching `case 5:`, exit 0);
    // they get a per-arm diagnostic instead of a subject-level
    // one.
    a : any = 6;
    v := if a == { case 5: { 1 } case 6: { 2 } else: { 0 } };
    print("{}\n", v);
}
