// Erasing a concrete type to a protocol whose `impl` method introduces its OWN
// type parameter is reported at the erasure site. `Dog.speak` matches by name, but
// generics are monomorphized rather than registered, so the thunk's
// `lazyLowerFunction("Dog.speak")` bails on `type_params.len > 0`. The conformance
// gate mirrors the thunk: a method that introduces its own type params is a
// signature mismatch.

@import "modules/std.sx";

Speaker :: interface { speak :: (self: *Self) -> i64; }
Dog :: struct { n: i64 = 0; }
impl Speaker for Dog { speak :: (self: *Dog, $T: Type) -> i64 { return self.n; } }

main :: () {
  d := Dog{ n = 42 };
  s := d.(Speaker, context.allocator);   // <- 'Dog.speak' has a mismatched signature
  print("{}\n", s.speak());
}
