// Materialization is type-directed, so an escape whose carried value cannot be
// walked is refused (specs.md §7.9): a `*void` referent has no layout to read
// bytes by, and the build fails naming it instead of shipping an address into
// compile-time memory.
#import "modules/std.sx";

Box :: struct { p: *void; }

make :: () -> Box {
    return Box.{ p = context.allocator.alloc_bytes(8) };
}

B :: #run make();

main :: () {
    print("{}\n", 1);
}
