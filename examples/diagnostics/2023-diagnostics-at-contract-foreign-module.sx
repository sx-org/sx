// A contract is recognized by WHICH FILE declares it, not by what the path
// spells. This import resolves to a file whose path ends in
// `modules/std/core.sx`, but it is not the `modules/std/core.sx` any library
// root holds, so its `@SourceSite` is refused like any other foreign
// declaration.
@import "modules/std.sx";
@import "2023-diagnostics-at-contract-foreign-module/modules/std/core.sx";

main :: () {
    print("{}\n", 1);
}
