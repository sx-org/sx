// Cancellation rides the `!` error channel. `f.cancel()`
// sets the per-future cancel flag + marks `state = .canceled`, so a
// subsequent `f.await()` raises `IoErr.Canceled` out of its value-failable
// `($R, !IoErr)` — caught here with `or`. A future that is NOT canceled
// awaits its value normally.
@import "modules/std.sx";

main :: () {
    // Not canceled → await yields the value. The worker is FAILABLE
    // (`Closure() -> ($R, !)`) — the unified worker shape.
    ok := context.io.async(|| -> (i64, !IoErr) 7);
    print("ok: {}\n", ok.await() ?? { -1 });

    // Canceled → await raises .Canceled → the `or` default is taken.
    c := context.io.async(|| -> (i64, !IoErr) 7);
    c.cancel();
    print("canceled: {}\n", c.await() ?? { -99 });
}
