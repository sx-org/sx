// The `async(worker, alloc)` ownership matrix under the FIBER scheduler: the
// contract the blocking impl keeps (0344) survives a worker that runs as a real
// fiber and parks its awaiter. A capturing worker IS its env, so `alloc` funds
// the whole task — worker env, completion env, `ThunkBox`, `Future` — and ends
// level once the future is awaited; the `context.allocator` at the call funds
// none of it, and an arena hands the task storage it already holds.
//
// aarch64-pinned (the scheduler's per-arch asm): runs end-to-end on a matching
// host (macOS + linux), ir-only on a mismatch.
@import "modules/std.sx";
@import "modules/std/mem.sx";
sched :: @import "modules/std/sched.sx";

Out :: struct {
    read: i64;
    wrote: i64;
    outer: i64;
    ctx_held: i64;
    level: bool;
    arena_read: i64;
    growth: i64;
}

main :: () -> i64 {
    out : Out = ---;
    po := *out;

    gpa := GPA.init();
    base := gpa.(Allocator);
    ctx := TrackingAllocator.init(base);
    a := TrackingAllocator.init(base);
    arena := Arena.init(base, 4096);
    pgpa := *gpa; pctx := *ctx; pa := *a;
    ctx_h : Allocator = ctx;
    a_h : Allocator = a;
    arena_h : Allocator = arena;

    s := sched.Scheduler.init();
    ps := *s;
    push .{ io = s, allocator = ctx_h } {
        ps.spawn(||_{ po, pgpa, pctx, pa, a_h, arena_h } {
            held := pctx.leakCount();

            n := 41;
            f := context.io.async(||_{ n } -> (i64, !IoErr) n, a_h);
            po.read = f.await() ?? 0;

            // A worker that WRITES its env writes the persisted copy — the
            // binding the literal read keeps the value it had.
            hits := 0;
            g := context.io.async(||_{ hits } -> (i64, !IoErr) { hits = hits + 1; hits }, a_h);
            po.wrote = g.await() ?? 0;
            po.outer = hits;

            po.ctx_held = pctx.leakCount() - held;
            po.level = pa.allocCount == pa.deallocCount;

            before := pgpa.allocCount;
            k := 6;
            h := context.io.async(||_{ k } -> (i64, !IoErr) k * 7, arena_h);
            po.arena_read = h.await() ?? 0;
            po.growth = pgpa.allocCount - before;
        });
        ps.run();
    }
    s.deinit();
    arena.deinit();

    print("read {} level {} ctx holds {}\n", out.read, out.level, out.ctx_held);
    print("wrote {} outer {}\n", out.wrote, out.outer);
    print("arena {} gpa growth {}\n", out.arena_read, out.growth);
    print("task level {} gpa outstanding {}\n", a.allocCount == a.deallocCount, gpa.allocCount);
    return 0;
}
