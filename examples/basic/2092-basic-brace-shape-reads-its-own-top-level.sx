// `push` owns the LAST brace group as its body, so inside a push context
// expression the brace body's OWN top level tells a construction from the body.
// Groups nest — parens and brackets alike — so the `,` between call arguments,
// the `=` naming one, and everything else inside a nested group belongs to that
// group: a body statement stays one statement, however many arguments,
// subscripts or postfix links it spans. Everywhere else types settle the
// reading and the body's shape says nothing.
@import "modules/std.sx";

pair :: ufcs (a: i64, b: i64) -> i64 => a + b;

show :: ufcs (xs: []i64) { for x in xs { print("{}", x) } }

Box :: struct ($T: Type) { v: T = 0; w: T = 0 }

Holder :: struct { ctx: Context = .{} }

run :: (label: string, body: Closure()) {
    print("{}: ", label);
    body();
    print("\n")
}

main :: () -> i32 {
    slots : [4]i64 = .[0, 0, 0, 0];

    // Two arguments and no `;`: the `,` is the argument list's.
    run("call") {
        print("{}", pair(1, 2))
    };
    // A named argument's `=` names a parameter, not a field.
    run("named") {
        print("{}", pair(a = 3, b = 4))
    };
    // Every link of a postfix chain keeps its own arguments.
    run("chain") {
        print("{}", 1.pair(2).pair(3))
    };
    // A subscript is a group too, and so is the call inside it.
    run("subscript") {
        slots[pair(0, 1)] = 9;
        print("{}", slots[1])
    };
    // A bracketed literal's elements are the literal's.
    run("brackets") {
        [3]i64.[7, 8, 9].show()
    };
    // The rule holds at any depth: an inner block is a group of the outer one.
    run("nested") {
        run("inner") {
            print("{}", pair(4, 5))
        }
    };

    // The push body is statement-shaped, so the brace is the body.
    h := Holder{ ctx = context };
    push h.ctx {
        print("push: {}\n", pair(6, 7))
    }

    // `Box` names a type, so every body shape constructs — positional
    // elements, a field init, a lone positional element.
    a := Box(i64){ 1, 2 };
    b := Box(i64){ v = pair(1, 2) };
    c := Box(i64){ pair(3, 4) };
    print("box: {} {} {}\n", a.v, b.v, c.v);
    0
}
