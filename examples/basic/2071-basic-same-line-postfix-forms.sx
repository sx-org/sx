// Whitespace is syntax (specs §1), the binding layer: a postfix `!` attaches to
// what precedes it only on that expression's own line, because a `!` across the
// break is the prefix `not`. Every other postfix carries one reading — a `{`
// juxtaposes and `.` / `?.` / `catch` chain — so each binds wherever the
// statement is still open and only a `;` cuts it off.
@import "modules/std.sx";

Pair :: struct { a: i64; b: i64 }

Box :: struct($T: Type) { v: T }

mk :: () -> i64 { 1 }

main :: () -> i32 {
    // A head that names a type constructs: a name, and a type application.
    p := Pair{ a = 1, b = 2 };
    b := Box(i64){ v = 3 };
    print("p={} {} b={}\n", p.a, p.b, b.v);

    // The `;` makes each head a statement of its own, so the brace group under
    // it is a scope block — whatever the head was.
    Pair;
    { print("after a type name\n") }

    mk();
    { print("after a value call\n") }

    Box(i64);
    { print("after a type application\n") }

    // `!` is force-unwrap behind its operand and `not` in front of one.
    maybe : ?i64 = 4;
    print("unwrapped={}\n", maybe!);

    ready := false;
    ready;
    !ready;
    print("ready={}\n", !ready);

    0
}
