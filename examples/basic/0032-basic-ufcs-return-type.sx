@import "modules/std.sx";
@import "modules/math";
@import "modules/build.sx";
@import "modules/std/test.sx";
pkg :: @import "tests/fixtures/testpkg";

Point :: struct { x, y: i32; }

pointSum :: ufcs (p: Point) -> i32 { p.x + p.y }

// @run compile-time constants

main :: () {

    // ========================================================
    // 20. UFCS RETURN TYPE INFERENCE
    // ========================================================
    print("=== 20. UFCS Return Type ===\n");
    {
        p := Point{ 3, 4};
        print("direct: {}\n", pointSum(p));
        print("ufcs: {}\n", p.pointSum());
    }
}
