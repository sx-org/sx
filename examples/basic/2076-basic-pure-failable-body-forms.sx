// The pure-failable demand is a property of the SIGNATURE, so every body form
// reads it the same way: a nested local function, a generic instance, a pack-fn
// monomorph, a closure's arrow body and a closure's block body all discard an
// undemanded tail and return only an error one.
//
// This is the body-form row of the tail matrix. Each row carries an error tail
// (its `catch` is hot), an ordinary 4-byte tail, an 8-byte / aggregate tail, a
// value-less compound block, a void call, a prefix-bound tail and mixed
// control flow (both arm orders) — every one of those prints exactly once and
// leaves its `catch` cold. Defers unwind before the exit on both paths.
@import "modules/std.sx";

Failed :: error { Nope }

tick :: (label: string) -> i32 {
    print("tick {}\n", label);
    42
}

tick64 :: (label: string) -> i64 {
    print("tick64 {}\n", label);
    7
}

name :: (label: string) -> string {
    print("name {}\n", label);
    "n"
}

nothing :: (label: string) {
    print("void {}\n", label);
}

fails :: () -> !Failed {
    .Nope
}

// ── Generic instance ───────────────────────────────────────────────────

genValue :: (v: $T) -> !Failed {
    print("gen {}\n", v);
    v
}

genError :: (v: $T) -> !Failed {
    print("gen-error {}\n", v);
    fails()
}

genMixed :: (v: $T, b: bool) -> !Failed {
    if b { fails() } else { v }
}

// ── Pack-fn monomorph ──────────────────────────────────────────────────

packValue :: (label: string, ..$args) -> !Failed {
    print("pack {}\n", label);
    tick("pack-tail")
}

packError :: (label: string, ..$args) -> !Failed {
    print("pack-error {}\n", label);
    .Nope
}

// ── Nested local functions ─────────────────────────────────────────────

runLocals :: () -> i32 {
    localValue :: () -> !Failed {
        tick("local")
    }
    localWide :: () -> !Failed {
        tick64("local")
    }
    localString :: () -> !Failed {
        name("local")
    }
    localCompound :: () -> !Failed {
        { x := tick("local-compound"); }
    }
    localVoid :: () -> !Failed {
        nothing("local")
    }
    localPrefix :: () -> !Failed {
        e := fails();
        e
    }
    localError :: () -> !Failed {
        .Nope
    }
    localMixed :: (b: bool) -> !Failed {
        defer print("local defer\n");
        if b { fails() } else { tick("local-mixed") }
    }

    localValue() catch { print("NOT REACHED local-value\n"); };
    localWide() catch { print("NOT REACHED local-wide\n"); };
    localString() catch { print("NOT REACHED local-string\n"); };
    localCompound() catch { print("NOT REACHED local-compound\n"); };
    localVoid() catch { print("NOT REACHED local-void\n"); };
    localMixed(false) catch { print("NOT REACHED local-mixed\n"); };
    localError() catch { print("caught local-error\n"); };
    localPrefix() catch { print("caught local-prefix\n"); };
    localMixed(true) catch { print("caught local-mixed\n"); };
    0
}

// A closure declared inside a NAMED-return function must not see the enclosing
// function's named-return slots: its own body is its own boundary.
namedReturnHost :: () -> (x: i32, y: i32) {
    inner := || -> !Failed tick("inside-named-return");
    inner() catch { print("NOT REACHED inner\n"); };
    x = 3;
    y = 4;
}

main :: () -> i32 {
    // Generic instances.
    genValue(11) catch { print("NOT REACHED gen-i32\n"); };
    genValue("s") catch { print("NOT REACHED gen-string\n"); };
    genMixed(12, false) catch { print("NOT REACHED gen-mixed\n"); };
    genError(13) catch { print("caught gen-error\n"); };
    genMixed(14, true) catch { print("caught gen-mixed\n"); };

    // Pack-fn monomorphs.
    packValue("a", 1, "two") catch { print("NOT REACHED pack\n"); };
    packError("b", 3) catch { print("caught pack-error\n"); };

    // Nested local functions.
    r := runLocals();

    // Closure ARROW bodies — the tail is the whole body.
    arrowValue := || -> !Failed tick("arrow");
    arrowWide := || -> !Failed tick64("arrow");
    arrowString := || -> !Failed name("arrow");
    arrowVoid := || -> !Failed nothing("arrow");
    arrowError := || -> !Failed (.Nope);
    arrowForward := || -> !Failed fails();
    arrowValue() catch { print("NOT REACHED arrow-value\n"); };
    arrowWide() catch { print("NOT REACHED arrow-wide\n"); };
    arrowString() catch { print("NOT REACHED arrow-string\n"); };
    arrowVoid() catch { print("NOT REACHED arrow-void\n"); };
    arrowError() catch { print("caught arrow-error\n"); };
    arrowForward() catch { print("caught arrow-forward\n"); };

    // Closure BLOCK bodies.
    blockValue := || -> !Failed { tick("block") };
    blockWide := || -> !Failed { tick64("block") };
    blockCompound := || -> !Failed { { x := tick("block-compound"); } };
    blockPrefix := || -> !Failed {
        v := tick("block-prefix");
        v
    };
    blockDefer := || -> !Failed {
        defer print("block defer\n");
        tick("block-defer")
    };
    blockError := || -> !Failed {
        defer print("block defer error\n");
        fails()
    };
    blockValue() catch { print("NOT REACHED block-value\n"); };
    blockWide() catch { print("NOT REACHED block-wide\n"); };
    blockCompound() catch { print("NOT REACHED block-compound\n"); };
    blockPrefix() catch { print("NOT REACHED block-prefix\n"); };
    blockDefer() catch { print("NOT REACHED block-defer\n"); };
    blockError() catch { print("caught block-error\n"); };

    // Mixed control flow inside a closure, both arm orders.
    cloMixed := |b: bool| -> !Failed {
        if b { fails() } else { tick("clo-mixed") }
    };
    cloMixed(false) catch { print("NOT REACHED clo-mixed\n"); };
    cloMixed(true) catch { print("caught clo-mixed\n"); };

    x, y := namedReturnHost();
    print("named={} {}\n", x, y);
    r
}
