// Whitespace is syntax (specs §1), the spacing rule across a line break. A
// line break is ordinary space, so a completed left operand makes `-` and `*`
// infix whatever the spacing around them — line-leading, trailing, glued, or
// spaced. `;` is what cuts the expression, so a prefix `-b` needs one above it.
//
// The gap is read as WRITTEN, so a raw identifier's backtick counts as part of
// it: `-`x is glued and `- `x is not.
#import "modules/std.sx";
#import "modules/fluent.sx";

`x :: 5;

Drawable :: protocol constraint {
    weight :: (self: *Self) -> i64;
}

Tile :: struct { n: i64 = 0; }
impl Drawable for Tile {
    weight :: (self: *Tile) -> i64 => self.n;
}

Counter :: struct {
    children: i64 = 0;
    total: i64 = 0;

    expression :: (self: *Counter, value: $I/@Init($V/Drawable)) {
        item: V = ---;
        value.write(*item);
        self.children += 1;
        self.total += item.weight();
    }
}

column :: (content: $B/@BuildBlock(Drawable)) -> Counter {
    sink := Counter{};
    content.run(*sink);
    return sink;
}

main :: () -> i32 {
    base := 40;
    fee := 7;

    // line-leading and spaced: one expression
    spaced := base
        - fee;

    // trailing and glued to the break: one expression
    trailing := base-
        fee;

    // line-leading and glued: still one expression, so `value` is the difference
    value := base
-fee;

    // the same reading with a raw identifier, whose backtick is part of the gap
    raw_break := base
-`x;
    raw_same_line := base -`x;

    print("spaced={} trailing={} value={}\n", spaced, trailing, value);
    print("raw_break={} raw_same_line={}\n", raw_break, raw_same_line);

    // the `;` is the cut: with one above it, `-fee` is a negation of its own
    print("cut\n");
-fee;

    // a build body reads the same way, so the join leaves the block one child
    c := column() {
        n := base-
            fee;
        Tile{ n = n }
    };
    print("children={} total={}\n", c.children, c.total);
    return 0;
}
