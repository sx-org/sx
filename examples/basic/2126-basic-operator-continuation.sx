// Whitespace is syntax (specs §1), spacing rule across a line break. Only at a
// break does glue decide `-` and `*`: an operator that opens the next line
// glued to its operand starts a fresh statement, and every other shape keeps
// reading the expression above. So a spaced line-leading `- fee` continues, a
// trailing `base-` continues onto the line below, and a glued `-fee` is a
// statement of its own.
//
// The gap is read as WRITTEN, so a raw identifier's backtick counts as part of
// it: `-`x is glued and `- `x is not.
#import "modules/std.sx";
#import "modules/fluent.sx";

`x :: 5;

Drawable :: protocol constraint {
    weight :: (self: *Self) -> i64;
}

Tile :: struct { n: i64 = 0; }
impl Drawable for Tile {
    weight :: (self: *Tile) -> i64 => self.n;
}

Counter :: struct {
    children: i64 = 0;
    total: i64 = 0;

    expression :: (self: *Counter, value: $I/@Init($V/Drawable)) {
        item: V = ---;
        value.write(*item);
        self.children += 1;
        self.total += item.weight();
    }
}

column :: (content: $B/@BuildBlock(Drawable)) -> Counter {
    sink := Counter{};
    content.run(*sink);
    return sink;
}

main :: () -> i32 {
    base := 40;
    fee := 7;

    // line-leading and spaced: one expression
    spaced := base
        - fee;

    // trailing and glued to the break: one expression
    trailing := base-
        fee;

    // line-leading and glued: two statements, so `value` is `base`
    value := base
-fee;

    // the same two readings with a raw identifier, whose backtick is part of
    // the gap
    raw_break := base
-`x;
    raw_same_line := base -`x;

    print("spaced={} trailing={} value={}\n", spaced, trailing, value);
    print("raw_break={} raw_same_line={}\n", raw_break, raw_same_line);

    // a build body reads the same way, so the join leaves the block one child
    c := column() {
        n := base-
            fee
        Tile{ n = n }
    };
    print("children={} total={}\n", c.children, c.total);
    return 0;
}
