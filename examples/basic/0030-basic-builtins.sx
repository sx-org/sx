@import "modules/std.sx";
@import "modules/math";
@import "modules/build.sx";
@import "modules/std/test.sx";
pkg :: @import "tests/fixtures/testpkg";

Point :: struct { x, y: i32; }

Color :: enum { red; green; blue; }

Shape :: enum {
    circle: f32;
    rect: struct { w, h: f32; };
    none;
}

main :: () {

    // ========================================================
    // 7. BUILT-IN FUNCTIONS
    // ========================================================
    print("=== 7. Builtins ===\n");

    // out
    out("out-ok\n");

    // sqrt
    print("sqrt: {}\n", @sqrt(9.0));
    print("sqrt-f64: {}\n", @sqrt(16.0));

    // @sizeOf
    print("sizeof-i32: {}\n", @sizeOf(i32));
    print("sizeof-f64: {}\n", @sizeOf(f64));
    print("sizeof-struct: {}\n", @sizeOf(Point));

    // @alignOf
    print("alignof-u8: {}\n", @alignOf(u8));
    print("alignof-i32: {}\n", @alignOf(i32));
    print("alignof-i64: {}\n", @alignOf(i64));
    print("alignof-struct: {}\n", @alignOf(Point));

    // @typeOf + category matching
    tv := 42;
    ttype := @typeOf(tv);
    match ttype {
        case int: print("typeof: int\n");
        case float: print("typeof: float\n");
        else: print("typeof: other\n");
    }

    // @typeOf — float
    tf := 3.14;
    match @typeOf(tf) {
        case float: print("typeof-float: float\n");
        else: print("typeof-float: other\n");
    }

    // @typeOf — string
    ts := "hello";
    match @typeOf(ts) {
        case string: print("typeof-string: string\n");
        else: print("typeof-string: other\n");
    }

    // @typeOf — bool
    tb := true;
    match @typeOf(tb) {
        case bool: print("typeof-bool: bool\n");
        else: print("typeof-bool: other\n");
    }

    // @typeOf — struct
    tst := Point{ 1, 2 };
    match @typeOf(tst) {
        case struct: print("typeof-struct: struct\n");
        else: print("typeof-struct: other\n");
    }

    // @typeOf — enum
    ten : Color = .red;
    match @typeOf(ten) {
        case enum: print("typeof-enum: enum\n");
        else: print("typeof-enum: other\n");
    }

    // @typeName
    print("typename: {}\n", @typeName(Point));

    // structFieldCount on struct
    print("fieldcount: {}\n", structFieldCount(Point));

    // structFieldCount on enum
    print("fieldcount-enum: {}\n", variantCount(Color));

    // structFieldName on struct
    print("fieldname0: {}\n", structFieldName(Point, 0));
    print("fieldname1: {}\n", structFieldName(Point, 1));

    // structFieldName on enum
    print("fieldname-enum0: {}\n", variantName(Color, 0));
    print("fieldname-enum2: {}\n", variantName(Color, 2));

    // structFieldValue (use anyToString to avoid sext-on-any bug)
    fv_pt := Point{ 11, 22 };
    out("fieldval0: ");
    out(anyToString(structFieldValue(fv_pt, 0)));
    out("\n");
    out("fieldval1: ");
    out(anyToString(structFieldValue(fv_pt, 1)));
    out("\n");

    // variantIndex on plain enum
    fi_c : Color = .green;
    print("fieldidx: {}\n", variantIndex(Color, fi_c));

    // variantIndex on tagged enum
    fi_sh : Shape = .circle(1.0);
    print("fieldidx-tagged: {}\n", variantIndex(Shape, fi_sh));
    fi_sh2 : Shape = .none;
    print("fieldidx-tagged2: {}\n", variantIndex(Shape, fi_sh2));

    // cast
    cval : f64 = 3.7;
    print("cast: {}\n", cval.(i32));
    cv2 : i32 = 42;
    print("cast-int-f64: {}\n", cv2.(f64));
}
