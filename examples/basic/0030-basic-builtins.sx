@import "modules/std.sx";
@import "modules/math";
@import "modules/build.sx";
@import "modules/std/test.sx";
pkg :: @import "tests/fixtures/testpkg";

Point :: struct { x, y: i32; }

Color :: enum { red; green; blue; }

main :: () {

    // ========================================================
    // 7. BUILT-IN FUNCTIONS
    // ========================================================
    print("=== 7. Builtins ===\n");

    // out
    out("out-ok\n");

    // sqrt
    print("sqrt: {}\n", @sqrt(9.0));
    print("sqrt-f64: {}\n", @sqrt(16.0));

    // @sizeOf
    print("sizeof-i32: {}\n", @sizeOf(i32));
    print("sizeof-f64: {}\n", @sizeOf(f64));
    print("sizeof-struct: {}\n", @sizeOf(Point));

    // @alignOf
    print("alignof-u8: {}\n", @alignOf(u8));
    print("alignof-i32: {}\n", @alignOf(i32));
    print("alignof-i64: {}\n", @alignOf(i64));
    print("alignof-struct: {}\n", @alignOf(Point));

    // @typeOf + category matching
    tv := 42;
    ttype := @typeOf(tv);
    match ttype {
        case int: print("typeof: int\n");
        case float: print("typeof: float\n");
        else: print("typeof: other\n");
    }

    // @typeOf — float
    tf := 3.14;
    match @typeOf(tf) {
        case float: print("typeof-float: float\n");
        else: print("typeof-float: other\n");
    }

    // @typeOf — string
    ts := "hello";
    match @typeOf(ts) {
        case string: print("typeof-string: string\n");
        else: print("typeof-string: other\n");
    }

    // @typeOf — bool
    tb := true;
    match @typeOf(tb) {
        case bool: print("typeof-bool: bool\n");
        else: print("typeof-bool: other\n");
    }

    // @typeOf — struct
    tst := Point{ 1, 2 };
    match @typeOf(tst) {
        case struct: print("typeof-struct: struct\n");
        else: print("typeof-struct: other\n");
    }

    // @typeOf — enum
    ten : Color = .red;
    match @typeOf(ten) {
        case enum: print("typeof-enum: enum\n");
        else: print("typeof-enum: other\n");
    }

    // @typeName
    print("typename: {}\n", @typeName(Point));

    // reflected member count on struct
    print("fieldcount: {}\n", @typeInfo(Point).struct.fields.len);

    // reflected member count on enum
    print("fieldcount-enum: {}\n", @typeInfo(Color).enum.fields.len);

    // reflected member name on struct
    print("fieldname0: {}\n", @typeInfo(Point).struct.fields[0].name);
    print("fieldname1: {}\n", @typeInfo(Point).struct.fields[1].name);

    // reflected member name on enum
    print("fieldname-enum0: {}\n", @typeInfo(Color).enum.fields[0].name);
    print("fieldname-enum2: {}\n", @typeInfo(Color).enum.fields[2].name);

    // @field
    fvPt := Point{ 11, 22 };
    print("fieldval0: {}\n", @field(fvPt, 0));
    print("fieldval1: {}\n", @field(fvPt, 1));

    // @len
    print("partcount: {}\n", @len(fvPt));
    fiC : Color = .green;
    print("partcount-enum: {}\n", @len(fiC));

    // cast
    cval : f64 = 3.7;
    print("cast: {}\n", cval.(i32));
    cv2 : i32 = 42;
    print("cast-int-f64: {}\n", cv2.(f64));
}
