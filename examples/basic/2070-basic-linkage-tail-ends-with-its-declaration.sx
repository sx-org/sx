// Whitespace is syntax (specs §1), statement termination: `[LIB] ["csym"]`
// after `extern` / `export` is two optional bare names, and the declaration's
// `;` is what closes the tail.
#import "modules/std.sx";

// Both slots left empty: the `;` closes the tail, and the name below belongs to
// the declaration below.
__stdinp : *void extern;
LIMIT :: 9;

// On the declaration's own line the same tail still binds — `c_abs` is C's
// `abs`.
c_abs :: (n: i32) -> i32 extern "abs";

// A line break inside the tail is ordinary whitespace, so both slots read on
// through one.
sx_double :: (n: i32) -> i32 export
    "double_c"
    { n * 2 }

main :: () -> i32 {
    stdin_bits : u64 = xx *__stdinp;
    print("limit={} stdin={}\n", LIMIT, stdin_bits != 0);
    print("abs={} double={}\n", c_abs(xx -42), sx_double(21));
    0
}
