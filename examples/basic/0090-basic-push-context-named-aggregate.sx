// The three `push` spellings, none of them needing parens: a patch over the
// ambient context, an explicit named construction, and an existing value.
// `push` owns the LAST brace group as its body — the reservation covers the
// brace written at the header's own depth, so a construction inside the patch
// juxtaposes like any other nested expression.

@import "modules/std.sx";

Holder :: struct { ctx: Context = .{}; }

Box :: struct($T: Type) { v: T; }

@context.extend box: Box(i64) = .{ v = 0 };

main :: () -> i64 {
    push Context{ allocator = context.allocator } {
        print("named\n");
    }
    push .{ allocator = context.allocator } {
        print("idiomatic\n");
    }
    h := Holder{ ctx = context };
    push h.ctx {
        print("value\n");
    }
    push .{ box = Box(i64){ v = 7 } } {
        print("nested {}\n", context.box.v);
    }
    return 0;
}
