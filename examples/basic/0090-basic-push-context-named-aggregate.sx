// `push Context{ fields } { body }` — named aggregate context without parens.
// Idiomatic form remains `push .{ fields } { body }`.
// Expected: exit 0.

#import "modules/std.sx";

main :: () -> i64 {
    push Context{ allocator = context.allocator } {
        print("named\n");
    }
    push .{ allocator = context.allocator } {
        print("idiomatic\n");
    }
    return 0;
}
