// Compound assignment `OP=` is one read-modify-write over the storage place the
// target names: a local slot, a module global, a qualified global (plain and
// through a field), a struct field, an array element and a deref target all
// load, apply the operator and store back the same slot. The place is resolved
// ONCE — `xs[bump()] += 5` calls `bump` a single time — and the RHS is
// evaluated before the index expression.
#import "modules/std.sx";
lib :: #import "2113-basic-compound-place-rmw/lib.sx";

Point :: struct { x, y: i64; }

n : i64 = 0;
g : i64 = 100;

bump :: () -> i64 {
    n += 1;
    return 0;
}

trace : i64 = 0;
idx_probe :: () -> i64 {
    trace = trace * 10 + 1;
    return 1;
}
rhs_probe :: () -> i64 {
    trace = trace * 10 + 2;
    return 7;
}

main :: () -> i32 {
    a := 10;
    a += 5;
    a -= 3;
    print("local={}\n", a);                          // 12

    g += 5;
    g -= 2;
    print("global={}\n", g);                         // 103

    lib.lib_g += 8;
    lib.lib_g -= 3;
    lib.lib_pair.a += 41;
    print("qualified={} field={}\n", lib.lib_g, lib.lib_pair.a);   // 5 42

    p : Point = .{ x = 1, y = 2 };
    p.x += 9;
    p.y -= 1;
    print("field={} {}\n", p.x, p.y);                // 10 1

    xs : [3]i64 = .[1, 2, 3];
    xs[2] += 7;
    xs[0] -= 1;
    print("elem={} {}\n", xs[0], xs[2]);             // 0 10

    q : *i64 = *xs[1];
    q.* += 40;
    q.* -= 2;
    print("deref={}\n", xs[1]);                      // 40

    // The index expression runs ONCE for the whole read-modify-write.
    xs[bump()] += 5;
    print("elem0={} calls={}\n", xs[0], n);          // 5 1

    // The RHS runs before the index expression: the trace reads 2 then 1.
    xs[idx_probe()] += rhs_probe();
    print("order={} elem1={}\n", trace, xs[1]);      // 21 47

    return 0;
}
