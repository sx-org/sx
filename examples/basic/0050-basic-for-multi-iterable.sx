#import "modules/std.sx";

pair_sum :: (xs: []i64, ys: []i64) -> i64 {
    total := 0;
    for x, y in xs, ys { total += x * y; }
    total
}

make :: () -> [3]i64 {
    r : [3]i64 = .[7, 8, 9];
    r
}

main :: () -> i32 {
    // Agra's example: a 1..5 inclusive, b open-ended following along.
    for a, b in 1..=5, 0.. { print("{}:{} ", a, b); }
    print("\n");

    // Index idiom.
    xs : [3]i64 = .[10, 20, 30];
    for x, i in xs, 0.. { print("[{}]={} ", i, x); }
    print("\n");

    // Parallel slices.
    a4 : [4]i64 = .[1, 2, 3, 4];
    b4 : [4]i64 = .[10, 20, 30, 40];
    print("dot={}\n", pair_sum(a4, b4));

    // Arrow bodies.
    s := 0;
    for i in 0..4 => s += i;
    print("arrow-range s={}\n", s);
    t := 0;
    for x in xs => t += x;
    print("arrow-coll t={}\n", t);

    // Call iterable + capture.
    for v in make() { print("v{} ", v); }
    print("\n");

    // No-capture call iterable.
    n := 0;
    for make() { n += 1; }
    print("call n={}\n", n);

    // Three-way zip: two collections + cursor.
    for p, q, k in a4, b4, 100.. { print("{}/{}/{} ", p, q, k); }
    print("\n");

    // By-ref capture in a multi-iterable header.
    for *p, i in a4, 0.. { p.* += i; }
    print("after ref: {} {} {} {}\n", a4[0], a4[1], a4[2], a4[3]);
    0
}
