// Large (64KB+) stack arrays compile and are accessed in place: `---`
// emits no initializer store, and element reads GEP the array's storage
// instead of loading the whole array as a value.
//
// A whole-aggregate shape — the undef store from `---`, or `index_get` on
// the loaded array value — scalarizes into one SelectionDAG node per
// element, so neither appears here.
//
// Results print via out/intToString.

@import "modules/std.sx";

checksum :: () -> i64 {
    buf : [65536]u8 = ---;
    i := 0;
    while i < 65536 {
        buf[i] = xx (i % 251);
        i += 1;
    }
    sum := 0;
    i = 0;
    while i < 65536 {
        sum += buf[i];
        i += 1;
    }
    return sum;
}

big :: () -> i64 {
    buf : [131072]i64 = ---;
    buf[0] = 11;
    buf[131071] = 31;
    return buf[0] + buf[131071];
}

main :: () -> i32 {
    out(intToString(checksum()));
    out("\n");
    out(intToString(big()));
    out("\n");
    return 0;
}
