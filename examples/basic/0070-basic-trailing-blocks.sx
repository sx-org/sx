// Trailing blocks (specs: Trailing Blocks): `f(args) { body }` passes the
// block as a closure literal bound to the callee's LAST declared parameter —
// definitionally `f(args, content = || { body })`, with the closure's
// parameters written as a `|…|` header after the `{`. Covers: statement
// position, middle defaults skipped, named args + block, expression position,
// capture-by-value semantics, a `;`-cut scope block, header calls being
// unaffected, and the parameter header — one param, several, an annotation, an
// empty body, and a closure ELEMENT parenthesized inside a construction.
@import "modules/std.sx";

vstack :: (spacing: f32, content: $F/() -> void) -> i64 {
    print("begin {}\n", spacing);
    content();
    print("end\n");
    7
}

each :: (xs: []i64, body: $F/(i64) -> void) { for v in xs { body(v); } }
pair :: (f: $F/(i64, i64) -> void) { f(3, 4); }
Sink :: struct($T: Type) { taken: Closure(i64); }

scaffold :: (topBar: ?Closure() = null, fab: ?Closure() = null, content: $F/() -> void) {
    if tb := topBar { tb(); }
    content();
    if fb := fab { fb(); }
}

toolbar :: () { print("toolbar\n"); }
check :: (f: $F/() -> void) -> bool { f(); true }

main :: () {
    _ = vstack(8.0) { print("a\n"); print("b\n"); };
    scaffold() { print("content\n"); };
    scaffold(topBar = toolbar) { print("content2\n"); };
    r := vstack(2.0) { print("x\n"); };
    print("ret {}\n", r);
    // The env takes `n` by value, so the block mutates its own field.
    n := 0;
    _ = vstack(1.0) { ||_{ n = n } n += 9; };
    print("by-value {}\n", n);
    // The `;` cuts, so the brace group after it is an ordinary scope block.
    _ = vstack(3.0, || print("lam\n"));
    { print("scope\n"); }
    // a call in a while/if header never grabs the statement body.
    m := 0;
    while check(|| print("hdr\n")) and m < 1 { m += 1; }
    // Nested trailing block inside call args (parens disambiguate).
    _ = vstack(4.0, || { _ = vstack(5.0) { print("inner\n"); }; });
    // The header IS the closure's parameter list, so the two spellings agree.
    xs := .[1, 2];
    each(xs) { |x| print("each {}\n", x); };
    each(xs, |x| { print("each-explicit {}\n", x); });
    pair() { |a, b| print("pair {}\n", a + b); };
    // An annotated header, and a body that is empty under it.
    each(xs) { |x: i64| print("typed {}\n", x); };
    each(xs) { |x| };
    // A `|` right after the `{` is the block's header, so a construction spells
    // a closure ELEMENT in parens.
    s := Sink(i64){ (|x: i64| print("sink {}\n", x)), };
    s.taken(6);
}
