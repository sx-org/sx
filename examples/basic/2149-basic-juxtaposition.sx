// `expr { … }` is two adjacent expressions (specs §Trailing Blocks): the left
// one and a block. Types settle the reading — a construction, or the block
// fused onto the call's last parameter — and a statement that ends in one takes
// `;` after the `}`. `;` is the only cut, so a brace on the next line binds the
// same way, and a `;` before it makes two statements.
#import "modules/std.sx";

Label :: struct { text: string = ""; }

vstack :: (gap: f64, content: Closure()) -> i64 { content(); xx gap }
place :: (a: i64, m: Label) -> i64 => a + m.text.len;
twice :: ufcs (n: i64) -> i64 => n * 2;
begin_build :: () { print("begin\n"); }

main :: () -> i32 {
    screen := vstack(12.0) {
        _ = Label { text = "x" };
    };
    wrapped := vstack(12.0)
    {
        _ = Label { text = "yy" };
    };
    print("fused {} {}\n", screen, wrapped);

    // A `;` between the call and the brace group is two statements.
    begin_build();
    {
        print("scope\n");
    }

    // The aggregate, then a scope of its own.
    outer := 0;
    l := Label { text = "zzz" };
    {
        outer = 1;
    }
    print("aggregate {} {}\n", l.text, outer);

    // A block-form value never juxtaposes: the group below it is a statement.
    x := if true { 1 } else { 2 }
    {
        print("after if {}\n", x);
    }

    // Past the `}`, infix and dot-led postfix both continue.
    sum := vstack(1.0) { print("a\n"); } + 2;
    chained := vstack(2.0) { print("b\n"); }.twice();
    nested := place(vstack(8.0) { print("c\n"); }, Label { text = "dd" });
    print("continues {} {} {}\n", sum, chained, nested);
    0
}

// ** stdout **
// fused 12 12
// begin
// scope
// aggregate zzz 1
// after if 1
// a
// b
// c
// continues 3 4 10
