// Whitespace is syntax (specs §1), inside a `match` arm. `case` heads an arm,
// and an arm is a statement, so the break before the next `case` ends the
// statement above it. `else:` — a `:` glued to the `else` — heads the default
// arm and ends it the same way, while every other `else` chains the `if` above
// it. The last arm's last statement is ended by the match's `}`.
//
// Every arm body ends this way: a statement LIST, `case .x: break`, and
// `case .x: |e| expr` alike. A written `;` stays legal in each — it is a
// separator. A statement that IS a block, and a declaration whose INITIALIZER
// is block-form, end at that `}` and take nothing after it.
#import "modules/std.sx"

Color :: enum {
    Red
    Green
    Blue
}

Shape :: enum {
    rect: i64
    dot
}

// Three statements per arm, each ended by its line break — the last one by the
// `case` / `else` / `}` that follows it.
trace :: (c: Color) -> i64 {
    n := 0
    match c {
        case .Red:
            n = n + 1
            n = n + 10
            n = n + 100
        case .Green:
            n = n + 2
            n = n + 20
        else:
            n = n + 3
            n = n + 30
    }
    n
}

// The same arms with the separator written out: every `;` here is legal and
// changes nothing.
trace_semi :: (c: Color) -> i64 {
    n := 0
    match c {
        case .Red:
            n = n + 1;
            n = n + 10;
            n = n + 100;
        case .Green:
            n = n + 2;
            n = n + 20;
        else:
            n = n + 3;
            n = n + 30;
    }
    n
}

// An arm closing on a statement which IS a block writes no `;`: the `if` and
// the bare scope each end at their own `}`.
shade :: (c: Color) -> i64 {
    n := 0
    match c {
        case .Red:
            n = 1
            if n == 1 {
                n = n + 6
            }
        case .Green: {
            n = 2
            n = n + 60
        }
        else:
            n = 3
    }
    n
}

// `}` NEWLINE `else` chains the `if` — the glued `:` is what makes the default
// arm's `else` a different token. Both spellings meet here: the first arm's
// `if` takes the chaining `else`, the second arm's `if` takes none and the
// `else:` under it opens the default arm.
tone :: (c: Color) -> i64 {
    n := 0
    match c {
        case .Red:
            if n == 0 {
                n = 1
            }
            else {
                n = 2
            }
        case .Green:
            hot := if n == 0 { 10 } else { 20 }
            if hot == 10 {
                n = hot
            }
        else:
            n = 3
    }
    n
}

// An arm's last expression is the arm's value, with or without the `;`.
classify :: (n: i64) -> i64 {
    match n {
        case 0: 100
        case 1: { x := 5; x * 2 }
        else:   7
    }
}

classify_semi :: (n: i64) -> i64 {
    match n {
        case 0: 100;
        case 1: { x := 5; x * 2 };
        else:   7;
    }
}

// `break` ends where a `break` statement anywhere ends.
first :: (c: Color) -> string {
    out := "none"
    match c {
        case .Red:
            out = "red"
        case .Green:
            break
        else:
            out = "other"
    }
    out
}

first_semi :: (c: Color) -> string {
    out := "none"
    match c {
        case .Red:
            out = "red";
        case .Green:
            break;
        else:
            out = "other";
    }
    out
}

main :: () -> i32 {
    print("{} {} {}\n", trace(Color.Red), trace(Color.Green), trace(Color.Blue))
    print("{} {} {}\n", trace_semi(Color.Red), trace_semi(Color.Green), trace_semi(Color.Blue))
    print("{} {} {}\n", shade(Color.Red), shade(Color.Green), shade(Color.Blue))
    print("{} {} {}\n", tone(Color.Red), tone(Color.Green), tone(Color.Blue))
    print("{} {} {}\n", classify(0), classify(1), classify(2))
    print("{} {} {}\n", classify_semi(0), classify_semi(1), classify_semi(2))
    print("{} {} {}\n", first(Color.Red), first(Color.Green), first(Color.Blue))
    print("{} {} {}\n", first_semi(Color.Red), first_semi(Color.Green), first_semi(Color.Blue))

    // `(e) => expr` ends at the break before the next arm head.
    s := Shape.rect(4)
    match s {
        case .rect: |size| print("rect {}\n", size)
        case .dot:
            print("dot\n")
    }
    match s {
        case .rect: |size| print("rect {}\n", size);
        case .dot:
            print("dot\n")
    }
    0
}
