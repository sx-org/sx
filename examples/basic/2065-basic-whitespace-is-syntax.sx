// Whitespace is syntax (specs §1), positive side. `;` ends a statement and a
// line break is ordinary space, so the gap before a `(` / `[` and after a
// prefix `-` / `--` / `*` carries no reading of its own: every form below is
// written spaced and reads exactly as its tight spelling does.
@import "modules/std.sx";

double :: (n: i64) -> i64 => n * 2;

Box :: struct ($T: Type) { v: $T; }

// a type application in an alias
BoxI :: Box (i64);

// a pointer type whose `*` is spaced from the pointee
bump :: (p: * i64) { p.* = p.* + 1; }

// a pack index is an index like any other, in an expression as in a type
first_type :: (..$args) -> string => type_name($args [0]);

// `else :` heads the default arm; the gap before the `:` says nothing
kind :: (v: i64) -> string {
    out := "";
    match v {
        case 1: out = "one";
        else :
            out = "many";
    }
    out
}

main :: () -> i32 {
    xs : [3]i64 = .[10, 20, 30];
    print("call={} {}\n", double(21), double (21));
    print("index={} {}\n", xs[1], xs [1]);
    print("packindex={}\n", first_type(1, true));

    // a type application in an annotation and in a construction
    b : Box (i64) = Box (i64){ v = 7 };
    print("box={} alias={}\n", b.v, BoxI{ v = 5 }.v);

    // prefix `-` / `--` / `*`, spaced from their operands
    n := 4;
    p := * n;
    bump(* n);
    m := 9;
    dec := -- m;
    print("neg={} deref={} dec={}\n", - n, p.*, dec);

    // the by-ref capture's `*` takes a space too
    for * x in xs { x.* = x + 100; }
    print("byref={} {} {}\n", xs[0], xs[1], xs[2]);

    print("kind={} {}\n", kind(1), kind(7));
    return 0;
}
