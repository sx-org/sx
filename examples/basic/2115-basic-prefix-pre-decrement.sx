#import "modules/std.sx";
lib :: #import "2113-basic-compound-place-rmw/lib.sx";

Counter :: struct { count: i64; }
Box :: struct { inner: Counter; }

g : i64 = 100;

main :: () -> i32 {
    i := 3;
    x := --i;
    print("local={} value={}\n", i, x);

    --g;
    print("global={}\n", g);

    --lib.lib_g;
    --lib.lib_pair.a;
    print("qualified={} field={}\n", lib.lib_g, lib.lib_pair.a);

    b : Counter = .{ count = 5 };
    --b.count;
    print("field={}\n", b.count);

    nested : Box = .{ inner = .{ count = 9 } };
    --nested.inner.count;
    print("nested={}\n", nested.inner.count);

    xs : [3]i64 = .[1, 2, 3];
    --xs[2];
    print("elem={}\n", xs[2]);

    q : *i64 = *xs[0];
    --q.*;
    print("deref={}\n", xs[0]);

    return 0;
}
