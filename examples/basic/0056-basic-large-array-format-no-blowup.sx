// Interning a large (~64KB) array type and using `{}` formatting elsewhere must
// NOT scalarize into an O(N) SelectionDAG (which crashes `sx build` and makes
// `sx run` take ~12s). The `{}` walk strides one element VIEW per index over
// the boxed storage, so the whole [65536]u8 never loads by value: the output is
// `[a, b, c]`, and a large unrelated array type costs nothing.

@import "modules/std.sx";

f :: () {
    buf : [65536]u8 = ---;
    buf[0] = 65; // 'A'
    out(string{ ptr = *buf[0], len = 1 });
    out("\n");
}

main :: () -> i32 {
    f();
    print("{}\n", 5);                 // an int format — unaffected by the big array
    small : [3]i64 = .[7, 8, 9];
    print("{}\n", small);             // array format still renders the element list
    return 0;
}
