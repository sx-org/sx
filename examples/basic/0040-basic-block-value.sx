// Block value rule: a block's value is its last statement, when that statement
// is an expression. The value flows to whatever the block's position demands —
// the return of a `-> T` body, the value of a value-bound block — and is
// discarded when nothing demands it.
//
//   { … expr }    → value is `expr`
//   { … n := 1; } → void (a declaration is not a value)
//
// The terminator plays no part: `;` separates statements. 0041 writes the same
// shapes with `;` and gets the same values.

#import "modules/std.sx";

// Implicit return: the body's trailing expression.
double :: (n: i32) -> i32 { n * 2 }

// if/else as a value — each branch's value is its last expression.
sign :: (n: i32) -> i32 {
    if n < 0 { -1 } else if n > 0 { 1 } else { 0 }
}

// A value-producing block bound to a name.
sum3 :: (a: i32, b: i32, c: i32) -> i32 {
    t := { x := a + b; x + c };   // block value is `x + c`
    t
}

// Each arm's `;` separates it from the next `case`, and each arm still yields
// its expression as the match value.
classify :: (n: i32) -> i32 {
    if n == {
        case 0:  100;
        case 1:  10;
        else:    7;
    }
}

main :: () -> i32 {
    total : i32 = 0;
    total = total + double(10);       // 20
    total = total + sign(-7);         // -1
    total = total + sum3(1, 2, 3);    // 6
    total = total + classify(1);      // 10
    print("block-value total: {}\n", total);   // 20 - 1 + 6 + 10 = 35
    total
}
