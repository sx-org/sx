// Whitespace is syntax (specs §1), statement termination: `;` ends a statement
// and a line break is ordinary space. This file writes the terminator
// everywhere it is owed — top-level declarations, bindings, calls, assignments,
// `return`, `defer` — and pins the four positions that end a statement without
// one: a statement that IS a block, a declaration whose initializer is a block
// form, the tail before a `}`, and the end of the file.
@import "modules/std.sx";

TAU :: 6;
seed : i64 = 7;

// The value-less forms take the terminator too: a declaration with no
// initializer, and a `return` with nothing to return.
counter : i64;

bump :: (by: i64) -> void {
    counter = counter + by;
    return;
}

// A `return` in expression position ends the same way, so the call below the
// early exit is the next statement and not the value the exit returns.
report :: (quiet: bool) -> void {
    if quiet then return;
    print("loud\n");
}

// A value before the `;` still belongs to the `return`.
clamp :: (v: i64) -> i64 {
    if v > 100 then return 100;
    v
}

Point :: struct { x: i64; y: i64 }

add :: (a: i64, b: i64) -> i64 => a + b;

// The tail expression has no terminator, so it is the block's value — the
// one-line and multi-line spellings are the same function.
tight :: () -> i64 { 41 }
spread :: () -> i64 {
    n := 41;
    n
}

accumulate :: (v: i64) -> i64 {
    total := 0;
    total = total + v;
    total = total + TAU;
    return total;
}

// Nothing demands a mid-block statement's value, so `v`'s goes nowhere and the
// tail `0` is the return. The `;` only separates the two lines.
discarded :: (v: i64) -> i64 {
    v;
    0
}

// An unterminated statement reads straight on through the break, so these are
// single expressions spread over several lines.
packed :: (hi: i64, lo: i64) -> i64 {
    (hi << 16)
        | lo
}

reachable :: (ready: bool, loaded: bool, forced: bool) -> bool {
    ready
        and loaded
        or forced
}

// `-` and `*` read the same across a break: a completed left operand makes them
// infix whatever the spacing.
gap :: (a: i64, b: i64) -> i64 {
    a
        - b
}

main :: () -> i32 {
    p := Point{ x = 1, y = 2 };
    n := add(p.x, p.y);
    n = accumulate(n);
    print("tau={} seed={} n={}\n", TAU, seed, n);
    print("tight={} spread={} discarded={}\n", tight(), spread(), discarded(9));
    print("packed={} reachable={} gap={}\n", packed(1, 2), reachable(true, true, false), gap(10, 4));

    bump(5);
    bump(TAU);
    print("counter={} version={}\n", counter, VERSION);

    report(true);
    report(false);
    print("clamp={} {}\n", clamp(7), clamp(250));

    // A statement that IS a block ends at its `}`, and `}` then `else` on the
    // next line is one chain.
    if n > 3 {
        print("big\n");
    }
    else {
        print("small\n");
    }

    // A declaration whose initializer is a block form ends at that `}` too.
    grade := if n > 3 { "big" } else { "small" }
    print("grade={}\n", grade);

    defer print("done\n");
    0
}

// The file's last declaration has no terminator either — nothing follows it to
// run into, so the end of the file ends it.
VERSION :: 2
