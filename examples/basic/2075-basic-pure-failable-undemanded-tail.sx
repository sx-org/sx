// A PURE-failable function (`-> !E`) has no success value — its whole return IS
// the error channel. So only a trailing ERROR value is its return; a tail of any
// other type is demanded by nothing. It is evaluated for its effects and its
// value is discarded, and the function takes the ordinary success exit.
//
// `;` is a pure separator, so a tail written with one and a tail written
// without one are the same tail.
//
// This file is the NAMED row of the tail matrix — a block body and an arrow
// body against every tail kind. Each discarded tail prints exactly once (the
// golden pins the count, so a skipped or twice-lowered tail fails the file),
// every success `catch` stays cold, and every kind has an error twin whose
// `catch` observes the declared tag — "discard every tail" cannot pass here.
@import "modules/std.sx";

Failed :: error { Nope }

Drawable :: interface {
    draw :: (self: *Self) -> string;
}

Label :: struct { text: string = ""; }
impl Drawable for Label {
    draw :: (self: *Label) -> string => self.text;
}

Colour :: enum { red; green; }

tick :: (label: string) -> i32 {
    print("tick {}\n", label);
    42
}

tick64 :: (label: string) -> i64 {
    print("tick64 {}\n", label);
    7
}

name :: (label: string) -> string {
    print("name {}\n", label);
    "n"
}

nothing :: (label: string) {
    print("void {}\n", label);
}

// ── The error tails: the one thing a pure-failable body returns ────────

// The contextual `.X` spelling resolves against the declared set.
fails :: () -> !Failed {
    .Nope
}

// A call whose result is the SAME set — forwarded, not discarded.
forwards :: () -> !Failed {
    fails()
}

// An arrow body is the same tail (the parser normalises `=> expr` to a block).
forwardsArrow :: () -> !Failed => fails();

// ── The discarded tails ────────────────────────────────────────────────

// An erased protocol handle is a tail like any other: built, then dropped.
eraseTail :: () -> !Failed {
    lab := Label{ text = "hi" };
    lab.(Drawable);
}

// The tail's EFFECT still happens; only its value is dropped.
effectTail :: () -> !Failed {
    tick("with-semi");
}

// The same tail without the terminator.
effectTailNoSemi :: () -> !Failed {
    tick("no-semi")
}

// An arrow body, same rule.
effectArrow :: () -> !Failed => tick("arrow");

// 8-byte and aggregate tails — a tag is 4 bytes, and neither is one.
wideTail :: () -> !Failed {
    tick64("wide")
}

stringTail :: () -> !Failed {
    name("string")
}

// A typed ordinary enum tail is evaluated and discarded; it is not a
// contextual error literal.
enumTail :: () -> !Failed {
    c := Colour.green;
    c
}

// A compound, value-less block.
compoundTail :: () -> !Failed {
    { x := tick("compound"); }
}

// A void call, and a no-`else` guard `if`.
voidTail :: () -> !Failed {
    nothing("void-tail")
}

guardTail :: (n: i32) -> !Failed {
    if n > 0 {
        print("guard {}\n", n);
    }
}

// No tail at all.
emptyTail :: () -> !Failed {
    print("empty\n");
    x := 1;
}

// The typeless placeholders: neither is ever an error value.
undefTail :: () -> !Failed {
    ---
}

nullTail :: () -> !Failed {
    null
}

// A tail whose type is only known once the prefix has bound it: the tail is
// classified after the prefix runs, so it reads the LOCAL, not an outer name.
prefixError :: () -> !Failed {
    e : Failed = .Nope;
    e
}

prefixCall :: () -> !Failed {
    e := fails();
    e
}

prefixValue :: () -> !Failed {
    v := tick("prefix");
    v
}

// Mixed live arms, BOTH orders — the error arm returns the tag, the ordinary
// arm is discarded and the function succeeds. Neither arm decides the other's
// fate, so neither order welds a value into the tag or swallows the error.
ifErrFirst :: (b: bool) -> !Failed {
    if b { fails() } else { tick("if-err-first") }
}

ifValFirst :: (b: bool) -> !Failed {
    if b { tick("if-val-first") } else { fails() }
}

matchErrFirst :: (n: i32) -> !Failed {
    match n {
        case 0: fails();
        else:   tick("match-err-first");
    }
}

matchValFirst :: (n: i32) -> !Failed {
    match n {
        case 0: tick("match-val-first");
        else:   fails();
    }
}

// Defers unwind before the exit on BOTH paths — an implicit error tail is a
// `return <error>;` and runs them exactly like one.
deferSuccess :: () -> !Failed {
    defer print("defer success\n");
    tick("defer-success")
}

deferError :: () -> !Failed {
    defer print("defer error\n");
    fails()
}

deferMixed :: (b: bool) -> !Failed {
    defer print("defer mixed\n");
    if b { fails() } else { tick("defer-mixed") }
}

main :: () -> i32 {
    // Cold `catch`: every discarded tail took the success exit.
    eraseTail() catch { print("NOT REACHED erase\n"); };
    effectTail() catch { print("NOT REACHED effect\n"); };
    effectTailNoSemi() catch { print("NOT REACHED no-semi\n"); };
    effectArrow() catch { print("NOT REACHED arrow\n"); };
    wideTail() catch { print("NOT REACHED wide\n"); };
    stringTail() catch { print("NOT REACHED string\n"); };
    enumTail() catch { print("NOT REACHED enum\n"); };
    compoundTail() catch { print("NOT REACHED compound\n"); };
    voidTail() catch { print("NOT REACHED void\n"); };
    guardTail(1) catch { print("NOT REACHED guard\n"); };
    emptyTail() catch { print("NOT REACHED empty\n"); };
    undefTail() catch { print("NOT REACHED undef\n"); };
    nullTail() catch { print("NOT REACHED null\n"); };
    prefixValue() catch { print("NOT REACHED prefix\n"); };
    ifErrFirst(false) catch { print("NOT REACHED if-err-first\n"); };
    ifValFirst(true) catch { print("NOT REACHED if-val-first\n"); };
    matchErrFirst(1) catch { print("NOT REACHED match-err-first\n"); };
    matchValFirst(0) catch { print("NOT REACHED match-val-first\n"); };
    deferSuccess() catch { print("NOT REACHED defer-success\n"); };
    deferMixed(false) catch { print("NOT REACHED defer-mixed\n"); };

    // Hot `catch`: the error tails reached the caller through the channel.
    fails() catch { print("caught fails\n"); };
    forwards() catch { print("caught forwards\n"); };
    forwardsArrow() catch { print("caught arrow\n"); };
    prefixError() catch { print("caught prefix\n"); };
    prefixCall() catch { print("caught prefix-call\n"); };
    ifErrFirst(true) catch { print("caught if-err-first\n"); };
    ifValFirst(false) catch { print("caught if-val-first\n"); };
    matchErrFirst(0) catch { print("caught match-err-first\n"); };
    matchValFirst(1) catch { print("caught match-val-first\n"); };
    deferError() catch { print("caught defer-error\n"); };
    deferMixed(true) catch { print("caught defer-mixed\n"); };

    // The same rows read as VALUES: only the error tails carry a tag.
    a := eraseTail();
    b := effectTail();
    c := effectTailNoSemi();
    d := fails();
    r : i32 = 0;
    if a == .Nope { r = r + 1; }
    if b == .Nope { r = r + 2; }
    if c == .Nope { r = r + 4; }
    if d == .Nope { r = r + 8; }
    print("r={}\n", r);
    0
}
