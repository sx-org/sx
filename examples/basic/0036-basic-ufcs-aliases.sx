@import "modules/std.sx";
@import "modules/math";
@import "modules/build.sx";
@import "modules/std/test.sx";
pkg :: @import "tests/fixtures/testpkg";

main :: () {

    // --- UFCS Aliases ---
    {
        print("=== UFCS Aliases ===\n");

        numSum :: (a: i64, b: i64) -> i64 { a + b }
        sum :: ufcs numSum;

        print("{}\n", numSum(40, 2));   // 42 — direct call
        print("{}\n", sum(40, 2));       // 42 — alias direct call

        compute :: (a: i64, b: i64, c: i64, d: i64) -> i64 { a + b * c - d }
        calc :: ufcs compute;

        print("{}\n", compute(1, 2, 3, 4));    // 1+2*3-4 = 3
        print("{}\n", calc(1, 2, 3, 4));       // same = 3 — alias direct call

        // Multi-return
        swap :: (a: i64, b: i64) -> (i64, i64) { return b, a; }
        s := swap(1, 2);
        a := s.0;
        b := s.1;
        print("{}\n", a);                // 2
        print("{}\n", b);                // 1

        wrap :: (x: i64) -> i64 { x }
        t := wrap(99);
        print("{}\n", t);             // 99
    }
}
