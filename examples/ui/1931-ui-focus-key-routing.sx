// G5 Step 2 — key/text routing (ui/focus.sx). Pins:
//   - with no focus, keys and text DROP;
//   - a focused region's on_key receives key_downs (with the logical
//     key), its on_text the committed text — other regions untouched;
//   - tab/shift+tab traverse declaration order and are CONSUMED (no
//     on_key fires for them);
//   - delivery is fire-time from the LATEST committed snapshot: a
//     rebuild between events delivers to the FRESH frame's closure
//     (the build sequence captured in each frame's env proves it);
//   - clear() → keys drop again;
//   - pointers still route: a tap fires through the combined dispatch
//     alongside key routing.
#import "modules/std.sx";
#import "modules/ui/types.sx";
#import "modules/ui/render.sx";
#import "modules/ui/view.sx";
#import "modules/ui/ambient.sx";
#import "modules/ui/store.sx";
#import "modules/ui/input.sx";
#import "modules/ui/runtime.sx";
#import "modules/ui/frame.sx";
#import "modules/ui/router.sx";
#import "modules/ui/focus.sx";

g_a : u64 = 0;
g_b : u64 = 0;

g_build_seq : i64 = 0;
g_a_keys : i64 = 0;
g_b_keys : i64 = 0;
g_b_last_key : LogicalKey = .unknown;
g_b_seen_seq : i64 = 0;
g_b_text : i64 = 0;
g_taps : i64 = 0;

Field :: struct {
    eid: u64;
    is_b: bool;
    w, h: f32;
}
impl View for Field {
    size_that_fits :: (self: *Field, proposal: ProposedSize) -> Size {
        Size{ width = self.w, height = self.h }
    }
    layout :: (self: *Field, bounds: Frame) {}
    render :: (self: *Field, ctx: *RenderContext, frame: Frame) {
        ctx.add_rect(frame, COLOR_BLUE);
        ctx.hit_region(self.eid, frame, on_tap = () { g_taps += 1; });
        if self.is_b {
            seq := g_build_seq;   // env re-supplied each frame — C8 proof
            ctx.focus_region(self.eid, frame,
                on_key = (k: *KeyEvent) { g_b_keys += 1; g_b_last_key = k.logical; g_b_seen_seq = seq; },
                on_text = (s: string) { g_b_text += s.len; });
        } else {
            ctx.focus_region(self.eid, frame,
                on_key = (k: *KeyEvent) { g_a_keys += 1; });
        }
    }
}

home :: () -> View {
    g_build_seq += 1;
    vstack(0.0) {
        a := element_id().value;
        g_a = a;
        place(Field{ eid = a, is_b = false, w = 100.0, h = 20.0 });
        b := element_id().value;
        g_b = b;
        place(Field{ eid = b, is_b = true, w = 100.0, h = 20.0 });
    }
}

g_loop : *FrameLoop = null;
g_root : *UiRoot = null;
g_router : *Router = null;
g_focus : *FocusTable = null;

tick :: () -> *CommittedUiSnapshot {
    s := g_loop.tick(g_root, home, 100.0, 100.0);
    g_router.refresh();
    g_focus.refresh();
    s
}

MS :: 1_000_000;

key :: (l: LogicalKey, shift: bool, t_ms: u64) {
    g_root.input.push(.key_down(.{
        header = .{ time_ns = t_ms * MS.(u64), modifiers = .{ shift = shift } },
        logical = l,
    }));
}
text :: (s: string, t_ms: u64) {
    g_root.input.push(.text(.{ header = .{ time_ns = t_ms * MS.(u64) }, text = s }));
}

main :: () {
    loop := FrameLoop.init();
    root := UiRoot.init(.{ value = 16 });
    router := Router.init();
    focus : FocusTable = .{};
    g_loop = *loop;
    g_root = *root;
    g_router = *router;
    g_focus = *focus;
    router.attach(*loop, *root);
    focus.attach(*loop, *root, *router);   // combined dispatch takes on_input

    tick();

    // No focus: keys and text drop.
    key(.left, false, 100); text("xy", 110);
    tick();
    process.assert(g_a_keys == 0 and g_b_keys == 0 and g_b_text == 0, "no focus, everything drops");

    // Focused region receives; others untouched.
    focus.request_focus(.{ value = g_b });
    key(.left, false, 200);
    tick();
    process.assert(g_b_keys == 1 and g_b_last_key == .left and g_a_keys == 0, "B's on_key got the key");
    text("hello", 300);
    tick();
    process.assert(g_b_text == 5, "B's on_text got the text");

    // Fire-time: the delivered env is the LATEST build's.
    seq_before := g_build_seq;
    tick();   // rebuild — fresh closures on the new frame
    key(.enter, false, 400);
    tick();
    process.assert(g_b_seen_seq > seq_before, "delivery resolved against the fresh frame (C8)");

    // Tab traverses and is consumed.
    b_keys_before := g_b_keys;
    key(.tab, false, 500);
    tick();
    process.assert(focus.is_focused(.{ value = g_a }), "tab: B → A (wrap)");
    process.assert(g_b_keys == b_keys_before, "tab was consumed, no on_key");
    key(.tab, true, 600);
    tick();
    process.assert(focus.is_focused(.{ value = g_b }), "shift+tab: back to B");

    // clear() → drop again.
    focus.clear();
    key(.left, false, 700);
    tick();
    process.assert(g_b_keys == b_keys_before, "cleared focus drops keys");

    // Pointers still route through the combined dispatch.
    g_root.input.push(.pointer_down(.{ header = .{ time_ns = 800 * MS.(u64) },
        pointer = .{ value = 1 }, position = .{ x = 50.0, y = 10.0 } }));
    g_root.input.push(.pointer_up(.{ header = .{ time_ns = 850 * MS.(u64) },
        pointer = .{ value = 1 }, position = .{ x = 50.0, y = 10.0 } }));
    tick();
    process.assert(g_taps == 1, "the tap fired alongside key routing");

    print("ok focus routing\n");
    router.deinit();
    loop.deinit();
    root.teardown();
}
