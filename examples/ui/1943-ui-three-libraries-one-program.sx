// Three UI View sets in one program: the stdlib fluent library plus the
// compose and emit example packages.
//
// A component joins a set by DECLARING itself into it, and each of these
// declared itself into exactly one — so `compose.Label` is a member of
// `compose.View` and of nothing else. compose and fluent both measure and
// render through the ui foundation; emit carries its own. The three sets
// stay distinct either way.
@import "modules/std.sx";

c :: @import "examples/ui/compose/package.sx";
e :: @import "examples/ui/emit/package.sx";
@import "modules/ui/fluent.sx";

main :: () -> i32 {
    // Each library's own component forms its own library's slot.
    cv : c.View = c.Label{ text = "composed" };
    ev : e.View = e.Label{ text = "emitted" };
    fv : fluent.View = fluent.Label{ text = "fluent" };

    // Each set answers for the member it carries — three distinct `Label`s.
    print("{} {} {}\n", @typeOf(cv), @typeOf(ev), @typeOf(fv));

    // Three sets, each laid out on its own members.
    print("sets {} {} {}\n", @sizeOf(c.View), @sizeOf(e.View), @sizeOf(fluent.View));

    // Each library renders through its own runtime, into the tree type that
    // library speaks.
    ct := c.RenderTree{};
    et := e.RenderTree{};
    ft := fluent.RenderTree{};
    c.renderRoot(*cv, c.Size{ width = 80.0, height = 20.0 }, *ct);
    e.renderRoot(*ev, e.Size{ width = 80.0, height = 20.0 }, *et);
    fluent.renderRoot(*fv, fluent.Size{ width = 80.0, height = 20.0 }, *ft);
    print("commands {} {} {}\n",
        c.commandCount(*ct), e.commandCount(*et), fluent.commandCount(*ft));
    0
}
