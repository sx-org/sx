@import "modules/std.sx";
@import "modules/ui/fluent.sx";

BoardViewState :: struct {
    cellEids: [81]u64 = ---;
}

BoardView :: @OpenVariant(fluent.View) {
    state: *BoardViewState = null;
    side: f32 = 0.0;

    fit :: (self: *BoardView, proposal: fluent.ProposedSize) -> fluent.Size {
        fluent.Size{ width = self.side, height = self.side }
    }

    layout :: (self: *BoardView, bounds: fluent.Frame) {}

    render :: (self: *BoardView, rc: *fluent.RenderContext, frame: fluent.Frame) {
        rc.addRect(frame, fluent.Color{ r = 26, g = 26, b = 26, a = 255 });
    }
}

main :: () -> i32 {
    st := BoardViewState{};
    for i in 0..81 { st.cellEids[i] = (i + 1).(u64); }

    cells := fluent.VStack{ children = fluent.collectViews() {
        for i in 0..81 {
            fluent.Label{ text = "c" };
        }
    } };

    actions := fluent.VStack{ spacing = 8.0, children = fluent.collectViews() {
        fluent.Button{ label = "New" };
        fluent.Button{ label = "Hint" };
        fluent.Button{ label = "Undo" };
    } };

    screen := fluent.VStack{ spacing = 12.0, children = fluent.collectViews() {
        fluent.Label{ text = "sudoku" };
        cells;
        BoardView{ state = *st, side = 90.0 };
        actions;
    } };

    print("top {}\n", screen.children.len);
    inner := screen.children.items[1].(fluent.VStack);
    print("cells {}\n", inner.children.len);
    print("slot {} state {}\n", @sizeOf(fluent.View), @sizeOf(BoardViewState));

    root : fluent.View = screen;
    tree := fluent.RenderTree{};
    fluent.renderRoot(*root, fluent.Size{ width = 200.0, height = 400.0 }, *tree);
    print("commands {}\n", fluent.commandCount(*tree));
    0
}
