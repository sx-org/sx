// The experiment/ui target spelling compiles as written:
// trailing blocks + named arguments over the ambient-sink emit
// model — scope fns, slots, handlers, `place` writing through
// `context.<field>` directly, and point-free `?Closure` slots
// Stubbed View/Ui types; the pin is the SPELLING, end to end.
@import "modules/std.sx";

View :: struct { tag: string; }

Sink :: struct ($T: Type) {
    items: List(T) = .{};
    emit :: (self: *Sink(T), v: T) { self.items.append(v); }
}

@context.extend uiSink: *Sink(View) = null;

place :: (v: View) -> View {
    if context.uiSink != null { context.uiSink.emit(v); }
    v
}

text :: (s: string) -> View { place(View{ tag = s }) }
spacer :: () -> View { place(View{ tag = "spacer" }) }

vstack :: (spacing: f32, content: $F/() -> void) -> View {
    s := Sink(View){};
    push .{ uiSink = *s } { content(); }
    place(View{ tag = "vstack" })
}

hstack :: (spacing: f32, content: $F/() -> void) -> View {
    s := Sink(View){};
    push .{ uiSink = *s } { content(); }
    place(View{ tag = "hstack" })
}

button :: (label: string, onTap: $F/() -> void) -> View {
    place(View{ tag = label })
}

scaffold :: (topBar: ?Closure() = null, fab: ?Closure() = null, content: $F/() -> void) -> View {
    vstack(0.0) { ||_{ topBar = topBar, fab = fab, content = content }
        if tb := topBar { tb(); }
        content();
        if fb := fab { fb(); }
    }
}

toolbar :: () { text("toolbar"); }

homeScreen :: () -> View {
    vstack(0.0) {
        hstack(8.0) { text("Chats"); spacer(); };
        button("New chat") { print("tapped\n"); };
    }
}

main :: () {
    root := Sink(View){};
    push .{ uiSink = *root } {
        homeScreen();
        scaffold(topBar = toolbar) { text("content"); }
    }
    print("emitted {}\n", root.items.len);
    print("{} {}\n", root.items.items[0].tag, root.items.items[1].tag);
}
