// Example emit UI library — public facade.
//
// One import gets a consumer the library. Its product story is an ambient child
// list plus an explicit terminal `.emit()`: there is no interception, so a child
// written without `.emit()` does not appear.
//
// `emit.View` is this package's open set.
@import "modules/std.sx";

geometry :: @import "examples/ui/emit/geometry.sx";
render :: @import "examples/ui/emit/render.sx";
view :: @import "examples/ui/emit/view.sx";
modifier :: @import "examples/ui/emit/modifier.sx";
components :: @import "examples/ui/emit/components.sx";
sink :: @import "examples/ui/emit/sink.sx";
containers :: @import "examples/ui/emit/containers.sx";
emit_mod :: @import "examples/ui/emit/emit.sx";
runtime :: @import "examples/ui/emit/runtime.sx";

// Geometry
Point :: geometry.Point;
Size :: geometry.Size;
Frame :: geometry.Frame;
ProposedSize :: geometry.ProposedSize;
EdgeInsets :: geometry.EdgeInsets;

// Render
Color :: render.Color;
RenderCommand :: render.RenderCommand;
RenderTree :: render.RenderTree;
RenderContext :: render.RenderContext;

// The set and what joins it
View :: view.View;
Modifier :: modifier.Modifier;
Label :: components.Label;
Button :: components.Button;
VStack :: containers.VStack;

// Ambient buffer and the terminal publish
EmitSink :: sink.EmitSink;
emit :: emit_mod.emit;
vstack :: containers.vstack;
renderRoot :: runtime.renderRoot;
commandCount :: runtime.commandCount;
