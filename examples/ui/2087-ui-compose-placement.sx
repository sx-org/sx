// Placing a compose component: one Mod, one wrapper, one order.
//
// `place(view, Mod{ … })` applies margin → size → bg/border/corner → padding →
// content. Every field acts at that single wrapper, so the number of fields set
// does not change how deep the tree gets — and the order is the Mod's, never the
// order the fields were written in.
#import "modules/std.sx";
#import "modules/ui/compose.sx";
ui :: #import "modules/ui/types.sx";

show :: (tree: *RenderTree) {
    for n in tree.nodes {
        if n.type == .text {
            print("  {} '{}' at {},{} {}x{}\n", n.type, n.text,
                n.frame.origin.x.(i64), n.frame.origin.y.(i64),
                n.frame.size.width.(i64), n.frame.size.height.(i64));
            continue;
        }
        print("  {} at {},{} {}x{} corner {} opacity {}\n", n.type,
            n.frame.origin.x.(i64), n.frame.origin.y.(i64),
            n.frame.size.width.(i64), n.frame.size.height.(i64),
            n.corner_radius.(i64), n.opacity);
    }
}

draw :: (root: *View, bounds: Frame) {
    tree := RenderTree{};
    rc := RenderContext.init(*tree);
    root.layout(bounds);
    root.render(*rc, bounds);
    show(*tree);
}

main :: () -> i32 {
    // A card: the margin holds the background off the bounds, the padding holds
    // the label off the background.
    card : View = place(Label{ text = "card" }, Mod{
        margin = ui.EdgeInsets.all(4.0),
        bg = ui.COLOR_DARK_GRAY,
        corner = 8.0,
        padding = ui.EdgeInsets.symmetric(6.0, 2.0),
    });
    card_size := card.size_that_fits(ProposedSize.flexible());
    print("card {}x{}\n", card_size.width.(i64), card_size.height.(i64));
    draw(*card, Frame.make(0.0, 0.0, card_size.width, card_size.height));

    // The same fields written in another order are the same element.
    same : View = place(Label{ text = "card" }, Mod{
        padding = ui.EdgeInsets.symmetric(6.0, 2.0),
        corner = 8.0,
        bg = ui.COLOR_DARK_GRAY,
        margin = ui.EdgeInsets.all(4.0),
    });
    same_size := same.size_that_fits(ProposedSize.flexible());
    print("same {}x{}\n", same_size.width.(i64), same_size.height.(i64));

    // A ring instead of a fill; a fixed size centres the box in the bounds and
    // the content takes what the padding leaves of it.
    chip : View = place(Label{ text = "9" }, Mod{
        width = 40.0,
        height = 24.0,
        border = Stroke{ color = ui.COLOR_YELLOW, width = 2.0 },
        corner = 4.0,
    });
    print("chip\n");
    draw(*chip, Frame.make(0.0, 0.0, 60.0, 40.0));

    // Opacity and clip bracket the content they apply to.
    faded : View = place(Label{ text = "dim" }, Mod{
        bg = ui.COLOR_BLUE,
        opacity = 0.5,
        clip = true,
    });
    print("faded\n");
    draw(*faded, Frame.make(0.0, 0.0, 40.0, 16.0));

    // Hidden measures zero and draws nothing.
    gone : View = place(Label{ text = "gone" }, Mod{ hidden = true });
    gone_size := gone.size_that_fits(ProposedSize.flexible());
    print("hidden {}x{}\n", gone_size.width.(i64), gone_size.height.(i64));
    draw(*gone, Frame.make(0.0, 0.0, 40.0, 16.0));

    // A placed component is a member, so it stacks like any other — and a
    // placed component can be placed again.
    screen : View = vstack(2.0) {
        place(Button{ label = "ok" }, Mod{ margin = ui.EdgeInsets.all(2.0) });
        place(place(Label{ text = "deep" }, Mod{ bg = ui.COLOR_GRAY }),
            Mod{ margin = ui.EdgeInsets.all(1.0) });
    };
    print("screen\n");
    draw(*screen, Frame.make(0.0, 0.0, 60.0, 60.0));

    print("slot {}\n", size_of(View));
    0
}

// ** stdout **
// card 52x28
//   .rounded_rect at 4,4 44x20 corner 8 opacity 1.000000
//   .text 'card' at 10,6 32x16
// same 52x28
// chip
//   .rounded_rect at 10,8 40x24 corner 4 opacity 1.000000
//   .text '9' at 10,8 40x24
// faded
//   .opacity_push at 0,0 0x0 corner 0 opacity 0.500000
//   .rect at 0,0 40x16 corner 0 opacity 0.500000
//   .clip_push at 0,0 40x16 corner 0 opacity 0.000000
//   .text 'dim' at 0,0 40x16
//   .clip_pop at 0,0 0x0 corner 0 opacity 0.000000
//   .opacity_pop at 0,0 0x0 corner 0 opacity 0.000000
// hidden 0x0
// screen
//   .rounded_rect at 2,2 40x28 corner 6 opacity 1.000000
//   .text 'ok' at 14,8 16x16
//   .rect at 1,35 32x16 corner 0 opacity 1.000000
//   .text 'deep' at 1,35 32x16
// slot 192
