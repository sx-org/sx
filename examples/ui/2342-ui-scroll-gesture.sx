// A wheel event reaches the scroll region under its position. A pointer that
// moves past the slop while a scroll region holds it becomes a drag: the tap
// it captured is cancelled and the region receives the movement, from the down
// point on the start, then per move, then on the up. A pointer that stays
// under the slop taps. A region declared inside a clip is bounded by it, so a
// tap on the clipped-away part of a row falls to what lies beneath.
@import "modules/std.sx";
@import "modules/std/mem.sx";
@import "modules/ui/fluent.sx";

at :: (x: f32, y: f32) -> fluent.InputEvent => .pointerDown(.{ position = .{ x = x, y = y } });
to :: (x: f32, y: f32) -> fluent.InputEvent => .pointerMove(.{ position = .{ x = x, y = y } });
lift :: (x: f32, y: f32) -> fluent.InputEvent => .pointerUp(.{ position = .{ x = x, y = y } });
wheel :: (x: f32, y: f32, dy: f32) -> fluent.InputEvent =>
    .scroll(.{ position = .{ x = x, y = y }, delta = .{ x = 0.0, y = dy } });

// One event per frame: the queue merges consecutive moves of one pointer.
step :: (loop: *fluent.FrameLoop, ev: fluent.InputEvent) {
    loop.root.queue.push(ev);
    loop.frame();
}

main :: () -> i32 {
    root := fluent.UiRoot.init(fluent.Size{ width = 100.0, height = 200.0 }, context.allocator);
    loop := fluent.FrameLoop.init(*root, closure(|| -> fluent.View {
        v : fluent.View = fluent.zstack(fluent.ALIGN_TOP_LEADING) {
            fluent.scrollable(fluent.Rect{ fill = fluent.Color.rgb(20, 20, 20) }, closure(|g: *fluent.ScrollGesture| {
                print("  {} {},{}\n", g.phase, g.delta.x.(i64), g.delta.y.(i64))
            }));
            fluent.tappable(fluent.Rect{}, closure(|| { print("  tap\n") }));
            // Two 40-tall rows under a 60-tall clip: the second row shows
            // its top half only.
            fluent.place(fluent.vstack(0.0) {
                fluent.tappable(fluent.Rect{ height = 40.0 }, closure(|| { print("  tap row 1\n") }));
                fluent.tappable(fluent.Rect{ height = 40.0 }, closure(|| { print("  tap row 2\n") }));
            }, fluent.Mod{ margin = fluent.EdgeInsets{ top = 100.0, left = 0.0, bottom = 0.0, right = 0.0 },
                height = 60.0, clip = true });
        };
        v
    }), context.allocator);

    loop.frame();
    print("regions hit {} scroll {}\n", root.snapshot.hitList.len, root.snapshot.scrollList.len);
    for r in root.snapshot.hitList {
        print("  hit at {},{} {}x{}\n", r.frame.origin.x.(i64), r.frame.origin.y.(i64),
            r.frame.size.width.(i64), r.frame.size.height.(i64));
    }

    print("wheel\n");
    step(*loop, wheel(50.0, 50.0, -3.0));

    print("under the slop\n");
    step(*loop, at(20.0, 20.0));
    step(*loop, to(24.0, 22.0));
    step(*loop, lift(24.0, 22.0));

    print("past the slop\n");
    step(*loop, at(20.0, 20.0));
    step(*loop, to(20.0, 30.0));
    step(*loop, to(20.0, 45.0));
    step(*loop, lift(20.0, 50.0));

    print("cancelled\n");
    step(*loop, at(60.0, 60.0));
    step(*loop, to(60.0, 80.0));
    step(*loop, .pointerCancel(.{ position = .{ x = 60.0, y = 80.0 } }));

    print("clipped rows\n");
    step(*loop, at(50.0, 120.0));
    step(*loop, lift(50.0, 120.0));
    step(*loop, at(50.0, 150.0));
    step(*loop, lift(50.0, 150.0));
    step(*loop, at(50.0, 170.0));
    step(*loop, lift(50.0, 170.0));

    root.deinit();
    loop.deinit();
    0
}
