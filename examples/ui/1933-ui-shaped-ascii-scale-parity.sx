// One fontSize means ONE size: a run measures the same whether it took the
// ASCII fast path (stbtt) or the shaping path (kbts). The two disagreed
// because they scaled font units differently, so adding a single non-ASCII
// character silently resized the whole string.
//
// Run:
//     sx run examples/ui/1933-ui-shaped-ascii-scale-parity.sx
// Other desktops go GL over a hidden SDL window (bare externs):
//     sx run --lflags -lSDL3 -L /opt/homebrew/lib examples/ui/1933-ui-shaped-ascii-scale-parity.sx
//
// The corpus compiles this file but does not run it: measuring needs a real
// font and a GPU-backed atlas, so the measurement stays a manual host gate
// and a host without a display/GPU reports a clean skip.
@import "modules/std.sx";
@import "modules/ui/types.sx";
@import "modules/ui/font.sx";
@import "modules/ui/surface.sx";
@import "modules/ui/surface_select.sx";

main :: () {
    surface := openPixelSurface(64, 32);
    if surface == null {
        print("scale parity skipped: no display/GPU on this host\n");
        return;
    }

    // "AB" is ASCII, so it shapes through stbtt. "AB·" contains a non-ASCII
    // byte, so the WHOLE run shapes through kbts — including the same A and B.
    // Subtracting the middot leaves the identical pair, measured by the other
    // path.
    ascii := measureText("AB", 20.0).width;
    dot := measureText("·", 20.0).width;
    shaped := measureText("AB·", 20.0).width - dot;

    delta := if shaped > ascii then shaped - ascii else ascii - shaped;
    process.assert(delta < 0.01, "the two shaping paths scale font units identically");
    process.assert(dot > 0.0, "a non-ASCII glyph has a real advance");

    print("ok\n");
}
