// The Ui's per-build identity lists live on the frame arena, and the frame
// loop reuses each arena every other tick. Their backings must be DETACHED at
// begin_build, not merely emptied: an arena that grew past its first chunk
// frees the older chunks on reset, so a retained ptr/cap appends into memory
// that is already gone.
// Regression (issue 0358): builds 1 and 2 pass (each arena is still fresh);
// build 3 — the first REUSE of a grown arena — corrupted the heap and crashed.
//
// The scene is sized to grow the arena past its 256KB initial chunk; the keyed
// rows make `chain`, `occ` and `seen_keys` all non-trivial.
#import "modules/std.sx";
#import "modules/ui/types.sx";
#import "modules/ui/render.sx";
#import "modules/ui/view.sx";
#import "modules/ui/compose.sx";
#import "modules/ui/store.sx";
#import "modules/ui/input.sx";
#import "modules/ui/runtime.sx";
#import "modules/ui/frame.sx";

ROWS :: 300;

Blob :: struct {
    eid: u64;
    pad: [1024]u8;      // bulk, so the tree outgrows one arena chunk
}

impl View for Blob {
    size_that_fits :: (self: *Blob, proposal: ProposedSize) -> Size {
        Size.{ width = 1.0, height = 1.0 }
    }
    layout :: (self: *Blob, bounds: Frame) {}
    render :: (self: *Blob, ctx: *RenderContext, frame: Frame) {
        ctx.hit_region(self.eid, frame);
    }
}

row :: () -> View {
    vstack(0.0) { place(Blob.{ eid = element_id().value }.(View)); }
}

home :: () -> View {
    vstack(0.0) {
        for 0..ROWS (i) { keyed(i) { row(); } }
    }
}

main :: () {
    loop := FrameLoop.init();
    root := UiRoot.init(.{ value = 1 });

    // Five ticks: two fresh arenas, then three reuses.
    for 1..=5 (n) {
        s := loop.tick(*root, home, 100.0, 100.0);
        process.assert(s.hit_list.len == ROWS, "every row declares its region on every build");
        process.assert(s.revision == n, "one commit per tick");
    }

    print("ok\n");
    loop.deinit();
    root.teardown();
}
