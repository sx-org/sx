// How a compose stack places its children.
//
// A column proposes its own width and leaves height free; a row does the
// opposite. Each child is laid out at the size it asked for, offset by the
// stack's alignment, and a spacer takes the slack the stack has left over —
// which is what pushes a row's ends apart.
//
// Every pass asks the same question, so a child's frame in `render` is the frame
// it was laid out in.
@import "modules/std.sx";
@import "examples/ui/compose.sx";
ui :: @import "modules/ui/types.sx";

// The frames a scene draws, read back off the tree.
frames :: (tree: *RenderTree) {
    for n in tree.nodes {
        if n.type != .text { continue; }
        print("  '{}' at {},{} {}x{}\n", n.text,
            n.frame.origin.x.(i64), n.frame.origin.y.(i64),
            n.frame.size.width.(i64), n.frame.size.height.(i64));
    }
}

draw :: (root: *View, bounds: Frame) {
    tree := RenderTree{};
    rc := RenderContext.init(*tree);
    root.layout(bounds);
    root.render(*rc, bounds);
    frames(*tree);
}

main :: () -> i32 {
    // A row hands each child its measured width and centres it on the cross
    // axis by default.
    row : View = hstack(4.0) {
        Label{ text = "a" };
        Label{ text = "bb", fontSize = 8.0 };
        Label{ text = "ccc" };
    };
    rowSize := row.sizeThatFits(ProposedSize.flexible());
    print("row {}x{}\n", rowSize.width.(i64), rowSize.height.(i64));
    draw(*row, Frame.make(0.0, 0.0, 200.0, 16.0));

    // A spacer between two labels takes what the row has left, so the ends sit
    // against the bounds.
    ends : View = hstack(0.0) {
        Label{ text = "left" };
        Spacer{};
        Label{ text = "right" };
    };
    print("ends\n");
    draw(*ends, Frame.make(0.0, 0.0, 100.0, 16.0));

    // A spacer's minimum is a MAIN-axis length. It lengthens the stack it sits
    // in and measures to nothing across, so a row keeps its tallest child's
    // height and a column keeps its widest child's width.
    minRow : View = hstack(0.0) {
        Label{ text = "a", fontSize = 8.0 };
        Spacer{ minLength = 20.0 };
        Label{ text = "b", fontSize = 8.0 };
    };
    minRowSize := minRow.sizeThatFits(ProposedSize.flexible());
    print("min row {}x{}\n", minRowSize.width.(i64), minRowSize.height.(i64));
    draw(*minRow, Frame.make(0.0, 0.0, 28.0, 8.0));

    minCol : View = vstack(0.0) {
        Label{ text = "a", fontSize = 8.0 };
        Spacer{ minLength = 20.0 };
        Label{ text = "b", fontSize = 8.0 };
    };
    minColSize := minCol.sizeThatFits(ProposedSize.flexible());
    print("min col {}x{}\n", minColSize.width.(i64), minColSize.height.(i64));
    // Slack lands ON TOP of the minimum: the spacer grows to 32 and the second
    // label follows it down.
    draw(*minCol, Frame.make(0.0, 0.0, 4.0, 48.0));

    // A column aligns on the horizontal axis.
    column : View = vstack(2.0, alignment = .trailing) {
        Label{ text = "one" };
        Label{ text = "twenty" };
    };
    print("column\n");
    draw(*column, Frame.make(0.0, 0.0, 80.0, 40.0));

    // A z-stack aligns each child in the bounds, at the child's own size.
    layered : View = zstack(ui.ALIGN_BOTTOM_TRAILING) {
        Label{ text = "under" };
        Label{ text = "on top" };
    };
    print("layered\n");
    draw(*layered, Frame.make(0.0, 0.0, 100.0, 40.0));

    // The same stacks over children a caller already holds.
    kids := collectViews() {
        Label{ text = "x" };
        Label{ text = "yy" };
    };
    folded := foldHstack(kids.items, 6.0);
    foldedSize := folded.sizeThatFits(ProposedSize.flexible());
    print("folded {} wide {}\n", folded.children.len, foldedSize.width.(i64));
    root : View = folded;
    draw(*root, Frame.make(0.0, 0.0, 60.0, 16.0));
    0
}

// ** stdout **
// row 48x16
//   'a' at 0,0 8x16
//   'bb' at 12,4 8x8
//   'ccc' at 24,0 24x16
// ends
//   'left' at 0,0 32x16
//   'right' at 60,0 40x16
// min row 28x8
//   'a' at 0,0 4x8
//   'b' at 24,0 4x8
// min col 4x36
//   'a' at 0,0 4x8
//   'b' at 0,40 4x8
// column
//   'one' at 56,0 24x16
//   'twenty' at 32,18 48x16
// layered
//   'under' at 60,24 40x16
//   'on top' at 52,24 48x16
// folded 2 wide 30
//   'x' at 0,0 8x16
//   'yy' at 14,0 16x16
