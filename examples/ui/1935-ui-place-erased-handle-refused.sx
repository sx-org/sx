// `place` takes the view at its CONCRETE type because that is the moment the
// bytes move into frame-arena storage. `View` is a tagged protocol with no
// owning form, so an already-erased handle has nothing left to copy — placing
// one could only forward a borrow of a caller frame temp into a tree that
// layout walks after that frame is gone. The erased argument is refused at
// the call site, with the fix-it: drop the erasure.
#import "modules/std.sx";
#import "modules/ui/compose.sx";
#import "modules/ui/view.sx";
#import "modules/ui/types.sx";
#import "modules/ui/render.sx";

Dot :: struct { s: f32; }

impl View for Dot {
    size_that_fits :: (self: *Dot, proposal: ProposedSize) -> Size {
        Size.{ width = self.s, height = self.s }
    }
    layout :: (self: *Dot, bounds: Frame) {}
    render :: (self: *Dot, ctx: *RenderContext, frame: Frame) {}
}

// The concrete spelling — the one that compiles, and the fix-it's target.
sound :: () -> View { place(Dot.{ s = 4.0 }) }

// The erase-early spelling: `V` binds to `View` itself. The handle here
// borrows a NAMED local, so nothing else about the erasure is wrong — the
// refusal is `place`'s alone. Non-default Mod is pinned separately in 1938.
erased :: () {
    d := Dot.{ s = 4.0 };
    place(d.(View));
}

main :: () {
    u := Ui.{};
    push .{ ui = *u } {
        sound();
        erased();
    }
}
