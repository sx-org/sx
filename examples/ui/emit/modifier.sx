// `emit.Modifier` and the library's UFCS modifiers.
//
// A modifier is an ordinary value carried by a component, and a modifier call is
// an ordinary value operation — chaining one does not intercept anything.
@import "modules/std.sx";
@import "examples/ui/emit/geometry.sx";

Modifier :: struct {
    opacity: f32 = 1.0;
    padding: EdgeInsets = .{};
}

// The modifiers take and return the modifier itself, so a component exposes them
// by threading its own field through.
withOpacity :: ufcs (m: Modifier, alpha: f32) -> Modifier {
    Modifier{ opacity = alpha, padding = m.padding }
}

withPadding :: ufcs (m: Modifier, insets: EdgeInsets) -> Modifier {
    Modifier{ opacity = m.opacity, padding = insets }
}
