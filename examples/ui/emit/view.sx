// `emit.View` — this example package's open set.
//
// A type joins by declaring itself into THIS set.
@import "modules/std.sx";
@import "examples/ui/emit/geometry.sx";
@import "examples/ui/emit/render.sx";

View :: @OpenSet(.{ max = 256, align = 8 }) {
    sizeThatFits :: (self: *Self, proposal: ProposedSize) -> Size;
    layout :: (self: *Self, bounds: Frame);
    render :: (self: *Self, rc: *RenderContext, frame: Frame);
}
