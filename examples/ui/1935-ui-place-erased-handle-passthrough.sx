// `place` accepts an already-erased `View` handle (V = View): pass through
// with default Mod, or wrap one ModBox(View) when Mod is set. No create of
// the protocol type, no `impl View for View`.
//
// Helpers that return View must return a handle whose referent outlives the
// helper frame — typically by placing (arena storage) inside the helper.
#import "modules/std.sx";
#import "modules/ui/ambient.sx";
#import "modules/ui/view.sx";
#import "modules/ui/types.sx";
#import "modules/ui/render.sx";
#import "modules/ui/modifier.sx";

Dot :: struct { s: f32; }

impl View for Dot {
    size_that_fits :: (self: *Dot, proposal: ProposedSize) -> Size {
        Size{ width = self.s, height = self.s }
    }
    layout :: (self: *Dot, bounds: Frame) {}
    render :: (self: *Dot, ctx: *RenderContext, frame: Frame) {
        ctx.add_rect(frame, COLOR_RED);
    }
}

// Sound erase-early helper: place into frame arena, return that handle.
erased_dot :: () -> View {
    place(Dot{ s = 4.0 })
}

measure_layout_render :: (v: View) -> i64 {
    sz := v.size_that_fits(ProposedSize.flexible());
    bounds := Frame.make(0.0, 0.0, sz.width, sz.height);
    v.layout(bounds);
    tree := RenderTree.init();
    ctx := RenderContext.init(*tree);
    v.render(*ctx, bounds);
    tree.nodes.len
}

main :: () {
    u := Ui{};
    push .{ ui = *u } {
        // Concrete path still works.
        plain := place(Dot{ s = 4.0 });
        process.assert(plain.(?Dot) != null, "concrete place returns the leaf");

        // Erased handle from a living local, default Mod: passthrough.
        d := Dot{ s = 4.0 };
        h := place(d.(View));
        process.assert(h.(?ModBox(View)) == null, "default Mod on handle adds no wrapper");
        process.assert(h.(?Dot) != null, "passthrough still dispatches to Dot");
        process.assert(measure_layout_render(h) >= 1, "passthrough handle can measure/layout/render");

        // Erased handle, non-default Mod: one ModBox(View); dispatch through it.
        hm := place(d.(View), Mod{ opacity = 0.5 });
        boxed := hm.(?ModBox(View));
        process.assert(boxed != null, "non-default Mod wraps ModBox(View)");
        process.assert(measure_layout_render(hm) >= 1, "ModBox(View) can measure/layout/render");

        // Helper that returns a placed View (arena referent outlives the call).
        from_helper := place(erased_dot());
        process.assert(from_helper.(?Dot) != null, "place(helper()->View) passthrough");
        from_helper_m := place(erased_dot(), Mod{ opacity = 0.8 });
        process.assert(from_helper_m.(?ModBox(View)) != null, "place(helper(), mod) wraps once");
        process.assert(measure_layout_render(from_helper_m) >= 1, "helper+mod dispatches");

        print("ok\n");
    }
}
