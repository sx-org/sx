// The modifier surface is a fluent chain over ONE Mod (compose.sx `el`):
// each link sets a field on the handle and `place` finalizes it into a
// single ModBox. The box applies its fields in the canonical order —
// margin → size → bg/border/corner → padding → content — so the chain's
// own order is free; what the chain buys is the spelling, never a
// dispatch level per link.
#import "modules/std.sx";
#import "modules/ui/types.sx";
#import "modules/ui/render.sx";
#import "modules/ui/view.sx";
#import "modules/ui/modifier.sx";
#import "modules/ui/compose.sx";

// A minimal concrete leaf: reports a fixed intrinsic size.
Leaf :: struct { w, h: f32; }
impl View for Leaf {
    size_that_fits :: (self: *Leaf, proposal: ProposedSize) -> Size {
        Size{ width = self.w, height = self.h }
    }
    layout :: (self: *Leaf, bounds: Frame) {}
    render :: (self: *Leaf, ctx: *RenderContext, frame: Frame) {}
}

main :: () {
    u := Ui{};
    flexible := ProposedSize{ width = null, height = null };

    // Value mode: ui set, no sink — `place` returns without emitting.
    push .{ ui = *u } {
        // Four links: the fixed size pins the box, the margin grows the
        // measured total around it.
        tree := el(Leaf{ w = 10.0, h = 20.0 })
            .opacity(0.5)
            .clip()
            .size(30.0, 40.0)
            .margin(EdgeInsets.all(8.0))
            .place();
        sz := tree.size_that_fits(flexible);
        print("chain: {}x{}\n", sz.width, sz.height);

        // hidden collapses the measured size to zero.
        h := el(Leaf{ w = 10.0, h = 20.0 }).hidden(true).place();
        hz := h.size_that_fits(flexible);
        print("hidden: {}x{}\n", hz.width, hz.height);

        // Padding sits INSIDE the background whichever link set it first.
        mixed := el(Leaf{ w = 5.0, h = 5.0 })
            .bg(COLOR_RED, 1.0)
            .padding(EdgeInsets.all(2.0))
            .place();
        ms := mixed.size_that_fits(flexible);
        print("mixed: {}x{}\n", ms.width, ms.height);
    }
}
