// Same refusal as 1935, with a non-default Mod argument so the monomorph is
// still `place(View, …)` and the `#error` arm is the sole diagnostic path for
// this file (1935 already pins the default-Mod erased call).
#import "modules/std.sx";
#import "modules/ui/compose.sx";
#import "modules/ui/view.sx";
#import "modules/ui/types.sx";
#import "modules/ui/render.sx";
#import "modules/ui/modifier.sx";

Dot :: struct { s: f32; }

impl View for Dot {
    size_that_fits :: (self: *Dot, proposal: ProposedSize) -> Size {
        Size.{ width = self.s, height = self.s }
    }
    layout :: (self: *Dot, bounds: Frame) {}
    render :: (self: *Dot, ctx: *RenderContext, frame: Frame) {}
}

main :: () {
    u := Ui.{};
    push .{ ui = *u } {
        d := Dot.{ s = 4.0 };
        place(d.(View), Mod.{ opacity = 0.5 });
    }
}
