// A compose call site keeps its own state across the builds that reach it.
//
// `useState` claims the entry its site owns: the first build to reach the site
// fills it from the default, and every later one is handed back what the
// previous build left. Two sites never share an entry, a site reached twice in
// one build gets one entry per occurrence, and a site a committed build stops
// reaching loses its entry.
@import "modules/std.sx";
@import "examples/ui/compose.sx";

// One site — its entry survives every frame that runs this.
tick :: () -> i64 {
    n := useState(i64, 0);
    n.set(n.get() + 1);
    n.get()
}

// A second site, with its own entry and its own default.
offset :: () -> i64 {
    n := useState(i64, 100);
    n.set(n.get() + 10);
    n.get()
}

Cursor :: struct {
    row: i64 = 0;
    col: i64 = 0;
}

frame :: (ui: *Identity, store: *StateStore, withOffset: bool) -> (a: i64, b: i64, c: i64) {
    ui.beginBuild();
    store.beginBuild();

    counted := tick();
    shifted := if withOffset then offset() else 0;

    // A struct payload rides the same claim, and the loop's three occurrences
    // of ONE site keep three entries.
    total := 0;
    for i in 0..3 {
        cur := useState(Cursor, .{});
        v := cur.get();
        v.row += 1;
        v.col += i;
        cur.set(v);
        total += v.row * 10 + v.col;
    }

    store.commitBuild();
    return a = counted, b = shifted, c = total;
}

main :: () -> i32 {
    ui := Identity.init(context.allocator);
    store := StateStore.init(context.allocator);
    push .{ composeUi = *ui, composeState = *store } {
        oneA, oneB, oneC := frame(*ui, *store, true);
        twoA, twoB, twoC := frame(*ui, *store, true);
        threeA, threeB, threeC := frame(*ui, *store, true);
        print("counter {} {} {}\n", oneA, twoA, threeA);
        print("offset {} {} {}\n", oneB, twoB, threeB);
        print("cursors {} {} {}\n", oneC, twoC, threeC);
        print("entries {}\n", store.entries.len);

        // The offset site goes unreached: its entry sweeps at commit, so the
        // build after it starts that site over from the default.
        fourA, fourB, fourC := frame(*ui, *store, false);
        print("dropped {} {}\n", fourB, store.entries.len);
        fiveA, fiveB, fiveC := frame(*ui, *store, true);
        print("restarted {} {}\n", fiveB, fiveA)
    }
    store.teardown();
    ui.deinit();
    0
}
