// `closure(f)` funds the env copy through `context.allocator`, not
// `.heap_alloc` directly. So when a `push .{ allocator = tracer }` block is
// active, persisting a capturing literal inside it allocates through the
// tracker.

@import "modules/std.sx";
@import "modules/std/mem.sx";

Tracer :: struct {
    count: i64;

    init :: () -> *Tracer {
        t : *Tracer = xx c.libc_malloc(size_of(Tracer));
        t.count = 0;
        t
    }
}

impl Allocator for Tracer {
    alloc_bytes :: (self: *Tracer, size: i64) -> *void {
        self.count += 1;
        return c.libc_malloc(size);
    }
    dealloc_bytes :: (self: *Tracer, ptr: *void) {
        c.libc_free(ptr);
    }
}

main :: () -> i32 {
    tracer := Tracer.init();
    push .{ allocator = tracer } {
        // The literal IS its env; `closure` copies that env into storage the
        // installed tracer's `alloc` hands out.
        captured : i64 = 100;
        add_capture : Closure(i64) -> i64 = closure(|y: i64|_{ captured } -> i64 y + captured);
        _ = add_capture(1);
    }
    print("Tracer.count = {}\n", tracer.count);
    0
}
