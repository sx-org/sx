// `closure(f)` funds the env copy through `context.allocator`. So when a
// `push .{ allocator = tracer }` block is active, persisting a capturing
// literal inside it allocates through the tracker.

@import "modules/std.sx";
@import "modules/std/mem.sx";

Tracer :: struct {
    count: i64;

    init :: () -> *Tracer {
        t : *Tracer = xx c.libcMalloc(@sizeOf(Tracer));
        t.count = 0;
        t
    }
}

impl Allocator for Tracer {
    allocBytes :: (self: *Tracer, size: i64) -> *void {
        self.count += 1;
        return c.libcMalloc(size);
    }
    deallocBytes :: (self: *Tracer, ptr: *void) {
        c.libcFree(ptr);
    }
}

main :: () -> i32 {
    tracer := Tracer.init();
    push .{ allocator = tracer } {
        // The literal IS its env; `closure` copies that env into storage the
        // installed tracer's `alloc` hands out.
        captured : i64 = 100;
        addCapture : Closure(i64) -> i64 = closure(|y: i64|_{ captured } -> i64 y + captured);
        _ = addCapture(1);
    }
    print("Tracer.count = {}\n", tracer.count);
    0
}
