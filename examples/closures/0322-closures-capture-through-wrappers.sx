// An env field is reached through every expression WRAPPER a closure body can
// put it behind: a postfix cast's operand (`box.(Shape)`), a named argument's
// value (`f(b = side)`), and a trailing block's lambda (`f(1.0) { … side … }`).
// A nested lambda names in its own `_{ … }` what it takes from the enclosing
// env, including a local the loop rebinds each turn.
@import "modules/std.sx";

Shape :: interface { area :: (self: *Self) -> f32; }

Box :: struct { w: f32; }
impl Shape for Box { area :: (self: *Box) -> f32 { self.w } }

run   :: (f: $F/() -> void) { f(); }
put   :: (s: Shape) { print("area {}\n", s.area()); }
named :: (a: f32 = 0.0, b: f32 = 0.0) { print("named {} {}\n", a, b); }
block :: (x: f32, body: $F/() -> void) { print("block {}\n", x); body(); }

eraseInClosure :: (side: f32) {
    run(||_{ side = side } { box := Box{ w = side }; put(box.(Shape)); });
}

namedArgInClosure :: (side: f32) {
    run(||_{ side = side } { named(b = side); });
}

trailingBlockInClosure :: (side: f32) {
    run(||_{ side = side } { block(1.0) { ||_{ side = side } print("inner {}\n", side); }; });
}

allAtOnce :: (side: f32) {
    run(||_{ side = side } {
        for i in 0..2 {
            n := i;
            block(side) { ||_{ side = side, n = n }
                bx := Box{ w = side + n.(f32) };
                put(bx.(Shape));
            };
        }
    });
}

main :: () {
    eraseInClosure(7.0);
    namedArgInClosure(5.0);
    trailingBlockInClosure(6.0);
    allAtOnce(10.0);
}
