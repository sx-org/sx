// Closure capture: a local/param that SHADOWS a global fn name is captured
// like any other binding — the lexical scope wins over the program-wide fn
// table (specs §Variable Shadowing — innermost wins).
//
// The rule mirrors call dispatch: `collectCaptures` asks
// `Scope.lookupNearest` first, which resolves the binding at the nearest
// declaring depth; the fn-name skip applies only when no binding exists.
// Here the local is named `concat`, which the std prelude also declares.
@import "modules/std.sx";

// 1. Local pointer shadow, mutated THROUGH the closure — result visible.
mutate :: () -> i64 {
    result : i64 = 0;
    concat := *result;              // local named like the prelude fn `concat`
    c := ||_{ concat = concat } { concat.* = 42; };  // must capture `concat`, not skip it
    c();
    result
}

// 2. Param shadow, captured by value.
addOne :: (concat: i64) -> i64 {
    c := ||_{ concat = concat } concat + 1;
    c()
}

// 3. No shadow: the closure calls the REAL prelude fn `concat`.
callReal :: () {
    c := || { @printf("{}", concat("real-", "out\n")); };
    c();
}

main :: () -> i32 {
    print("{}\n", mutate());     // 42
    print("{}\n", addOne(41));   // 42
    callReal();                  // real-out
    0
}
