// A trailing header is the same function boundary as a `|…|` literal.
// `each(xs) { |x| return; }` inside `defer` is `each(xs, |x| { return; })`.
// The `return` leaves the closure, not the deferred scope.
@import "modules/std.sx";

each :: (xs: []i64, body: $F/(i64) -> void) { for v in xs { body(v); } }

runTrailing :: () {
    xs := .[1, 2];
    defer {
        each(xs) { |x|
            print("trail {}\n", x);
            return;
        };
        print("after-trail\n");
    }
    print("body-trail\n");
}

runExplicit :: () {
    xs := .[1, 2];
    defer {
        each(xs, |x| {
            print("expl {}\n", x);
            return;
        });
        print("after-expl\n");
    }
    print("body-expl\n");
}

main :: () -> i32 {
    runTrailing();
    runExplicit();
    return 0;
}
