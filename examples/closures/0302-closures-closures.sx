@import "modules/std.sx";

// --- Closure Basics ---

// Factory: returns a new closure each time
makeAdder :: (n: i64) -> $F/(i64) -> i64 {
    return |x: i64|_{ n = n } -> i64 x + n;
}

// Higher-order function: accepts anything callable at `(i64) -> i64`
apply :: (f: $F/(i64) -> i64, x: i64) -> i64 { return f(x); }

// Reduce: fold over a slice with a closure
reduce :: (arr: []i64, f: $F/(i64, i64) -> i64, init: i64) -> i64 {
    acc := init;
    i : i64 = 0;
    while i < arr.len { acc = f(acc, arr[i]); i += 1; }
    return acc;
}

// Auto-promoted bare function
triple :: (x: i64) -> i64 { return x * 3; }

// Struct with optional closure callback
Widget :: struct {
    name: string;
    onUpdate: ?Closure(i64) -> void;
}

main :: () {
    // 1. Basic closure with capture
    offset := 100;
    addOffset := |x: i64|_{ offset = offset } -> i64 x + offset;
     
    print("basic: {}\n", addOffset(42));

    // 2. Capture by value (snapshot semantics)
    n := 10;
    snap := |x: i64|_{ n = n } -> i64 x + n;
    n = 999;
    print("snapshot: {}\n", snap(5));

    // 3. Block-body closure with control flow
    clamp := |x: i64| -> i64 {
        if x < 0 { return 0; }
        if x > 100 { return 100; }
        return x;
    };
    print("clamp: {} {} {}\n", clamp(50), clamp(0 - 10), clamp(200));

    // 4. Void closure with string capture
    tag := "INFO";
    logger := |msg: string|_{ tag = tag } {
        print("[{}] {}\n", tag, msg);
    };
    logger("system ready");

    // 5. Factory pattern
    add5 := makeAdder(5);
    add10 := makeAdder(10);
    print("factory: {} {}\n", add5(100), add10(100));

    // 6. A bare fn answers the callable bound out of its own shape
    print("auto-promote: {}\n", apply(triple, 7));

    // 7. Closure passed to higher-order function
    factor := 4;
    print("hof: {}\n", apply(|x: i64|_{ factor = factor } -> i64 x * factor, 10));

    // 8. Reduce with closure
    nums : []i64 = .[1, 2, 3, 4, 5];
    total := reduce(nums, |acc: i64, x: i64| -> i64 acc + x, 0);
    print("reduce: {}\n", total);

    // 9. Closure captures closure
    inner := |x: i64| -> i64 x + 10;
    outer := |x: i64|_{ inner = inner } -> i64 inner(x) * 2;
    print("compose: {}\n", outer(5));

    // 10. Multiple closures from same scope
    base := 100;
    clAdd := |x: i64|_{ base = base } -> i64 x + base;
    clMul := |x: i64|_{ base = base } -> i64 x * base;
    print("multi: {} {}\n", clAdd(5), clMul(5));

    // 11. Optional closures
    w1 := Widget{ name = "slider", onUpdate = |val: i64| {
        print("widget: {} = {}\n", "slider", val);
    } };
    w2 := Widget{ name = "label", onUpdate = null };

    if h := w1.onUpdate { h(42); }
    if h := w2.onUpdate { h(0); } else { print("widget: no handler\n"); }

    print("=== DONE ===\n");
}
