// Closure whose return type is an interface handle — exercises the
// indirect-call path where the result is a handle over `make` storage.

@import "modules/std.sx";

MyProtocol :: interface {
    get_value :: (self: *Self) -> i64;
}

MyImpl :: struct { value: i64; }
impl MyProtocol for MyImpl {
    get_value :: (self: *MyImpl) -> i64 { self.value }
}

make_thing :: () -> MyProtocol {
    context.allocator.make(MyImpl{ value = 42 }).(MyProtocol)
}

main :: () -> void {
    v := make_thing();
    out("direct call works\n");

    c := make_thing;
    result := c();
    out("closure call works\n");
}
