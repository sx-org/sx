// Closure literal declared (and used) inside a `defer` body.
//
// A lambda opens its own defer window, like every other function-lowering
// entry: it does not inherit the enclosing function's `func_defer_base`, so
// its own `return` drains only its own defers.

@import "modules/std.sx";

run :: () {
    defer {
        cb := |n: i32| -> i32 { return n * 2; };
        print("defer closure: {}\n", cb(21));   // 42, at scope exit
    }
    print("body\n");
}

main :: () -> i32 {
    run();
    return 0;
}
