// Closure literal declared (and used) inside a `defer` body.
//
// A lambda that inherits the enclosing function's
// `func_defer_base` re-drains the enclosing function's defers on its own
// `return` — and when the defer body itself declares the lambda, that
// re-lowers the lambda forever (infinite recursion). A lambda
// opens its own defer window (like every other function-lowering entry).

#import "modules/std.sx";

run :: () {
    defer {
        cb := (n: i32) -> i32 { return n * 2; };
        print("defer closure: {}\n", cb(21));   // 42, at scope exit
    }
    print("body\n");
}

main :: () -> i32 {
    run();
    return 0;
}
