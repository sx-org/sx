// A block-body lambda (`(params) { ... }`) with an INFERRED return
// type whose value is produced via early `return`s must infer the return type
// from the `return` operands — not fall through to void.
//
// Regression: `() { if c { return 11; } return 22; }`
// infers `void` if the block's last stmt (the `return`) is read as its value,
// so the call site feeds an `i64 undef` to `print` and LLVM verification
// fails. Closure return-type inference mirrors the function-decl path,
// scanning the body's `return` statements.
//
// Syntax note: a block body is the `(params) -> R? { ... }` form; the
// bare `(params) => expr` lambda is arrow + EXPRESSION only (no block).
#import "modules/std.sx";

main :: () {
  // early returns only — inferred return, no optionals
  f := () { if 1 > 0 { return 11; } return 22; };
  print("f: {}\n", f());

  // early return + trailing-expression block value
  g := (n: i64) { if n > 0 { return 100; } 200 };
  print("g+: {}\n", g(1));
  print("g-: {}\n", g(-1));

  // inferred float return via early returns
  h := (n: i64) { if n > 0 { return 3.5; } return 1.5; };
  print("h: {}\n", h(1));
}
