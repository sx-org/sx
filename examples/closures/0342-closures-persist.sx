// Persisting an erased closure preserves its allocation and target.

@import "modules/std.sx";
@import "modules/std/mem.sx";

triple :: (x: i64) -> i64 { return x * 3; }

Accum :: struct { total: i64; }
impl (i64) -> i64 for Accum {
    call :: (self: *Accum, x: i64) -> i64 { return self.total + x; }
}

Widget :: struct { onTap: ?Closure(i64) -> void; }

main :: () {
    n := 5;
    unique := |x: i64|_{ n } -> i64 x + n;
    print("env-type {} {}\n", @sizeOf(@envType(@typeOf(unique))), @sizeOf(i64));

    lam := mem.closure(unique);
    print("lambda {}\n", lam(1));                              // 6

    fp := mem.closure(triple);
    print("fn-ptr {}\n", fp(4));                               // 12

    acc := Accum{ total = 100 };
    nom := mem.closure(acc);
    print("nominal {}\n", nom(7));                             // 107

    // Already erased: returned unchanged, environment shared not copied.
    again := mem.closure(lam);
    print("identity {} {}\n", again(2), @reinterpret(@Closure, again).env == @reinterpret(@Closure, lam).env);

    // A zero-sized environment funds nothing.
    empty := mem.closure(|x: i64|_{ } -> i64 x * 2);
    print("empty {} {}\n", empty(21), @reinterpret(@Closure, empty).env == null);

    // The allocator is chosen, or taken from the context.
    arena := mem.Arena.init(context.allocator, 4096);
    m := 7;
    onArena := mem.closure(|x: i64|_{ m } -> i64 x * m, arena);
    print("arena {}\n", onArena(6));                          // 42
    arena.deinit();

    // A capturing lambda reaches a `Closure` field through `closure`.
    id := 3;
    tap := mem.closure(|x: i64|_{ id } print("tap {} {}\n", id, x));
    w := Widget{ onTap = tap };
    if h := w.onTap { h(9); }

    mem.free(tap);
    mem.free(lam);
    mem.free(fp);
    mem.free(nom);
    mem.free(empty);
}
