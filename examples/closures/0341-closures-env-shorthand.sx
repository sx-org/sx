// A bare env field is a copy of the enclosing name: `_{ n }` is `_{ n = n }`,
// the same shorthand a struct literal takes. Named fields mix with it freely,
// and `*` on a value gives a field that points at the enclosing storage.

@import "modules/std.sx";

make_adder :: (bias: i32) -> $F/(i32) -> i32 { return |x: i32|_{ bias } -> i32 x + bias; }

main :: () {
    add := make_adder(10);
    print("adder {}\n", add(5));                                // 15
    print("field {} {}\n", size_of(@typeOf(add)), size_of(i32)); // 4 4

    n := 7;
    // Shorthand and named fields in one env.
    mix := |x: i32|_{ bias = 1, n, k = n * 2 } -> i32 x + bias + n + k;
    print("mix {}\n", mix(1));                                  // 1+1+7+14

    // A bare field copies, so a later write to the outer name is not the field.
    copy := |x: i32|_{ n } -> i32 x + n;
    n = 100;
    print("copy {}\n", copy(1));                                // 8

    // `n = *n` is a named field holding an address, loaded with `.*`.
    ref := |x: i32|_{ n = *n } -> i32 x + n.*;
    print("ref {} {}\n", ref(1), size_of(@typeOf(ref)));        // 101 8
    n = 200;
    print("through {}\n", ref(1));                              // 201
}
