// A return-position binder names the callable the body hands back, and the value
// keeps its own shape: a named function stays 8 bytes, a `|x|` literal is the
// 16-byte erased form, and a `_{ }` literal is its own env. Every exit types its
// value from the bound's signature — including the second one — and the function
// keeps ONE return type. The factories are declared after `main`, so the shape a
// caller reads is the one the body fixed.

@import "modules/std.sx";

double :: (x: i64) -> i64 { return x * 2; }

main :: () {
    f := factory();
    print("named {} size {}\n", f(5), @sizeOf(@typeOf(f)));

    g := boxed();
    print("lambda {} size {}\n", g(5), @sizeOf(@typeOf(g)));

    e := empty();
    print("unique {} size {}\n", e(5), @sizeOf(@typeOf(e)));

    print("same {} {}\n", twice(true)(5), twice(false)(5));
    print("both {} {}\n", either(true)(5), either(false)(5));

    // A parameter binder alongside the return binder: the call fixes `G`, the
    // body fixes `H`.
    print("wrapped {}\n", wrap(double)(5));
}

factory :: () -> $F/(i64) -> i64 { return double; }

boxed :: () -> $F/(i64) -> i64 { return |x| x * 3; }

empty :: () -> $F/(i64) -> i64 { return |x|_{ } x * 3; }

twice :: (b: bool) -> $F/(i64) -> i64 {
    if b { return double; }
    return double;
}

either :: (b: bool) -> $F/(i64) -> i64 {
    if b { return |x| x * 2; }
    return |x| x * 3;
}

wrap :: (g: $G/(i64) -> i64) -> $H/(i64) -> i64 {
    return |x|_{ g = g } g(x) + 1;
}
