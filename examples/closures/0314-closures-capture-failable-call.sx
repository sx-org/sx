// A FAILABLE closure held in a nested closure's environment stays failable when
// CALLED in that body: the error-handling expressions (`catch`, `try`) that
// consume the env field's error channel see the call at its own type.
//
// The async completion closure
// `() { f.value = worker() catch {…} }` holds a `Closure() -> ($R, !)`
// worker and consumes its error channel — exactly this shape.
@import "modules/std.sx";
@import "modules/std/mem.sx";

WorkErr :: error { Bad }

Box :: struct { run: Closure() -> void; }

// `catch` path: the nested closure absorbs the worker's error.
runCatch :: (worker: Closure() -> (i64, !)) {
    b : Box = ---;
    b.run = closure(||_{ worker } {
        v := worker() catch {
            print("caught\n");
            return;
        };
        print("ok {}\n", v);
    });
    b.run();
    free(b.run);
}

// `try` path: the nested closure is itself failable and propagates.
mkTrier :: (worker: Closure() -> (i64, !)) -> Closure() -> (i64, !) {
    return closure(||_{ worker } -> (i64, !) {
        v := try worker();
        v + 100
    });
}

main :: () -> i64 {
    runCatch(|| -> (i64, !) { 7 });            // ok 7
    runCatch(|| -> (i64, !) { raise WorkErr.Bad; }); // caught

    t := mkTrier(|| -> (i64, !) { 5 });
    r := t() catch { return 1; };
    print("try {}\n", r);                          // try 105
    free(t);
    return 0;
}
