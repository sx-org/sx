// `async(worker, alloc)` funds its whole per-task heap from `alloc`: the `Future`,
// the `ThunkBox`, the completion closure's environment, and the worker's, which
// `closure(worker, alloc)` persisted. The `context.allocator` in force at the call
// funds none of it, so a task submitted under one allocator still frees back to the
// one it was handed, and `alloc` can be an arena the task never outlives.

@import "modules/std.sx";
@import "modules/std/mem.sx";

main :: () {
    gpa := GPA.init();
    base := gpa.(Allocator);
    ctx := TrackingAllocator.init(base);
    task := TrackingAllocator.init(base);

    answer := 0;
    ctx_allocs := 0;
    push .{ allocator = ctx } {
        n := 41;
        f := context.io.async(||_{ n } -> (i64, !) n + 1, task);
        answer = await(f) catch { 0 };
        ctx_allocs = ctx.alloc_count;
    }

    print("answer {}\n", answer);
    print("task allocs {} deallocs {} outstanding {}\n",
          task.alloc_count, task.dealloc_count, task.leak_count());
    print("context allocs {}\n", ctx_allocs);

    // An arena is a valid `alloc`: the task's allocations land in the chunk it
    // already holds, so the GPA behind it sees no growth.
    arena := Arena.init(base, 4096);
    before := gpa.alloc_count;
    k := 6;
    g := context.io.async(||_{ k } -> (i64, !) k * 7, arena);
    product := await(g) catch { 0 };
    print("arena {} gpa growth {}\n", product, gpa.alloc_count - before);
    arena.deinit();
    print("gpa outstanding {}\n", gpa.alloc_count);
}
