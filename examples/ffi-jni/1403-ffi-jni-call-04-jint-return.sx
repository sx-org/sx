// `@JniCall(i32)` (jint return). CallIntMethod is vtable slot 49.
//
// Runtime: unreachable. Same `gShouldCall` global pattern as
// `ffi-jni-call-03` — keeps `readInt` alive so the IR snapshot has
// the JNI lowering visible, but the dereferences never execute.

@import "modules/std.sx";

gShouldCall : bool = false;

readInt :: (env: *void, target: *void) -> i32 {
    @JniCall(i32, env, target, "getCount", "()I")
}

main :: () -> i32 {
    if gShouldCall {
        _ := readInt(null, null);
    }
    print("ok\n");
    0
}
