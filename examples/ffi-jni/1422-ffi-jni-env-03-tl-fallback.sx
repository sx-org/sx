// A helper called from a `push .{ jni = env }` block reads `context.jni`.
// The handle is call-carried on the context, so the helper does not take
// env as a parameter.

@import "modules/std.sx";

gShouldCall : bool = false;

helper :: (target: *void) {
    @JniCall(void, context.jni, target, "noop", "()V");
}

unused :: (env: *void, target: *void) {
    push .{ jni = env } {
        helper(target);
    }
}

main :: () -> i32 {
    if gShouldCall {
        unused(null, null);
    }
    print("ok\n");
    0
}
