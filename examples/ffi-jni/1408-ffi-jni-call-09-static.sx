// `#jni_static_call` lowering.
// The target is already a `jclass`, so the lowering skips `GetObjectClass`
// and uses `GetStaticMethodID` + `CallStatic<Type>Method`.

#import "modules/std.sx";

g_should_call : bool = false;

call_static_max :: (env: *void, cls: *void) -> i32 {
    #jni_env(env) {
        #jni_static_call(i32)(cls, "max", "(II)I", 3, 7)
    }
}

main :: () -> i32 {
    if g_should_call {
        _ := call_static_max(null, null);
    }
    print("ok\n");
    0
}
