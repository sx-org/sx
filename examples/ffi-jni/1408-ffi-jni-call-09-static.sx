// `@JniStaticCall` lowering.
// The target is already a `jclass`, so the lowering skips `GetObjectClass`
// and uses `GetStaticMethodID` + `CallStatic<Type>Method`.

@import "modules/std.sx";

gShouldCall : bool = false;

callStaticMax :: (env: *void, cls: *void) -> i32 {
    @JniStaticCall(i32, env, cls, "max", "(II)I", 3, 7)
}

main :: () -> i32 {
    if gShouldCall {
        _ := callStaticMax(null, null);
    }
    print("ok\n");
    0
}
