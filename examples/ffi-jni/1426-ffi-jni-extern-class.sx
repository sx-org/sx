// Postfix `extern` on a `@JniClass` aggregate imports the class. Parse-only
// on macOS (no JVM at runtime), mirroring 1412's runtime-class reference.
//   View :: @JniClass("…") extern { … }   ==   View :: @JniClass(…) extern("…") { … }

#import "modules/std.sx";

View :: @JniClass("android/view/View") extern {
    getId :: (self: *Self) -> i32;
}

main :: () -> i32 {
    print("parse-only ok\n");
    0
}
