// `@JniCall(f64)` (jdouble return).
// First non-integer return type for JNI — exercises the LLVM
// `double` ret path through CallDoubleMethod (vtable slot 58).

@import "modules/std.sx";

gShouldCall : bool = false;

readDouble :: (env: *void, target: *void) -> f64 {
    @JniCall(f64, env, target, "getValue", "()D")
}

main :: () -> i32 {
    if gShouldCall {
        _ := readDouble(null, null);
    }
    print("ok\n");
    0
}
