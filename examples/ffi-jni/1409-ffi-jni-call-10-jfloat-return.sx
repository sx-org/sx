// `@JniCall(f32)` (jfloat return). CallFloatMethod is vtable slot 55.
// `MotionEvent.getX()` / `getY()` return this shape into
// `sxAndroidPushTouch`.

@import "modules/std.sx";

gShouldCall : bool = false;

readFloat :: (env: *void, target: *void) -> f32 {
    @JniCall(f32, env, target, "getValue", "()F")
}

main :: () -> i32 {
    if gShouldCall {
        _ := readFloat(null, null);
    }
    print("ok\n");
    0
}
