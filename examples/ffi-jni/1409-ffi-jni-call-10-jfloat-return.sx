// `#jni_call(f32)` (jfloat return).
// The Call<T>Method switch in `src/ir/emit_llvm.zig` covers `.f32`, so a JNI
// method returning `float` dispatches through CallFloatMethod (vtable 55)
// rather than the `else` arm's `LLVMGetUndef` — the shape an Android
// `MotionEvent.getX()` / `getY()` result rides into
// `sx_android_push_touch`.

#import "modules/std.sx";

g_should_call : bool = false;

read_float :: (env: *void, target: *void) -> f32 {
    #jni_env(env) {
        #jni_call(f32)(target, "getValue", "()F")
    }
}

main :: () -> i32 {
    if g_should_call {
        _ := read_float(null, null);
    }
    print("ok\n");
    0
}
