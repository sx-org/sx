// Narrow JNI integer returns: i8/u8 → CallByteMethod (jbyte),
// i16 → CallShortMethod (jshort), u16 → CallCharMethod (jchar).
// The `#jni_class` method form uses the same slots.

#import "modules/std.sx";

g_should_call : bool = false;

read_i8 :: (env: *void, target: *void) -> i8 {
    #jni_env(env) {
        #jni_call(i8)(target, "getByte", "()B")
    }
}

read_u8 :: (env: *void, target: *void) -> u8 {
    #jni_env(env) {
        #jni_call(u8)(target, "getUnsignedByte", "()B")
    }
}

read_i16 :: (env: *void, target: *void) -> i16 {
    #jni_env(env) {
        #jni_call(i16)(target, "getShort", "()S")
    }
}

read_u16 :: (env: *void, target: *void) -> u16 {
    #jni_env(env) {
        #jni_call(u16)(target, "getChar", "()C")
    }
}

Buf :: #jni_class("java/nio/ByteBuffer") extern {
    get :: (self: *Self) -> i8;
}

unused_dsl :: (env: *void, b: *Buf) {
    #jni_env(env) {
        _ := b.get();
    }
}

main :: () -> i32 {
    if g_should_call {
        _ := read_i8(null, null);
        _ := read_u8(null, null);
        _ := read_i16(null, null);
        _ := read_u16(null, null);
        unused_dsl(null, null);
    }
    print("ok\n");
    0
}
