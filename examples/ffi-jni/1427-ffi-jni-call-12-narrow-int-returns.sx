// Narrow JNI integer returns: i8/u8 → CallByteMethod (jbyte),
// i16 → CallShortMethod (jshort), u16 → CallCharMethod (jchar).
// The `@JniClass` method form uses the same slots.

#import "modules/std.sx";

g_should_call : bool = false;

read_i8 :: (env: *void, target: *void) -> i8 {
    @JniCall(i8, env, target, "getByte", "()B")
}

read_u8 :: (env: *void, target: *void) -> u8 {
    @JniCall(u8, env, target, "getUnsignedByte", "()B")
}

read_i16 :: (env: *void, target: *void) -> i16 {
    @JniCall(i16, env, target, "getShort", "()S")
}

read_u16 :: (env: *void, target: *void) -> u16 {
    @JniCall(u16, env, target, "getChar", "()C")
}

Buf :: @JniClass("java/nio/ByteBuffer") extern {
    get :: (self: *Self) -> i8;
}

unused_dsl :: (env: *void, b: *Buf) {
    push .{ jni = env } {
        _ := b.get();
    }
}

main :: () -> i32 {
    if g_should_call {
        _ := read_i8(null, null);
        _ := read_u8(null, null);
        _ := read_i16(null, null);
        _ := read_u16(null, null);
        unused_dsl(null, null);
    }
    print("ok\n");
    0
}
