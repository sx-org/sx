// Narrow JNI integer returns: i8/u8 → CallByteMethod (jbyte),
// i16 → CallShortMethod (jshort), u16 → CallCharMethod (jchar).
// The `@JniClass` method form uses the same slots.

@import "modules/std.sx";

gShouldCall : bool = false;

readI8 :: (env: *void, target: *void) -> i8 {
    @JniCall(i8, env, target, "getByte", "()B")
}

readU8 :: (env: *void, target: *void) -> u8 {
    @JniCall(u8, env, target, "getUnsignedByte", "()B")
}

readI16 :: (env: *void, target: *void) -> i16 {
    @JniCall(i16, env, target, "getShort", "()S")
}

readU16 :: (env: *void, target: *void) -> u16 {
    @JniCall(u16, env, target, "getChar", "()C")
}

Buf :: @JniClass("java/nio/ByteBuffer") extern {
    get :: (self: *Self) -> i8;
}

unusedDsl :: (env: *void, b: *Buf) {
    push .{ jni = env } {
        _ := b.get();
    }
}

main :: () -> i32 {
    if gShouldCall {
        _ := readI8(null, null);
        _ := readU8(null, null);
        _ := readI16(null, null);
        _ := readU16(null, null);
        unusedDsl(null, null);
    }
    print("ok\n");
    0
}
