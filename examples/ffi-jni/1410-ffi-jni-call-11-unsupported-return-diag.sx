// A JNI method whose return type is not a JNI scalar — unsigned 32/64
// or an aggregate — is a compile error at the call site.

@import "modules/std.sx";

Buf :: @JniClass("java/nio/ByteBuffer") extern {
    get :: (self: *Self) -> u32;
}

gShouldCall : bool = false;

unused :: (env: *void, b: *Buf) {
    push .{ jni = env } {
        _ := b.get();
    }
}

main :: () -> i32 {
    if gShouldCall {
        unused(null, null);
    }
    0
}
