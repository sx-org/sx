// `push .{ jni = env }` installs the JNI handle on `context.jni` for the
// block. DSL calls and helpers read that field.

@import "modules/std.sx";
@import "modules/platform/jni.sx";

main :: () -> i32 {
    synthEnv : *void = null;
    push .{ jni = synthEnv } {
        print("inside push .{ jni = env } scope\n");
    }
    0
}
