// The `#jni_env(env) { body }` block-form intrinsic scopes a JNIEnv* over a
// lexical block: the body runs as a normal block and the env arg is captured
// for the enclosed `#jni_call` sites.

#import "modules/std.sx";

main :: () -> i32 {
    synth_env : *void = null;
    #jni_env(synth_env) {
        print("inside #jni_env scope\n");
    }
    0
}
