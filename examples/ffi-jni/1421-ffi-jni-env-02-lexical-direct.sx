// Lexical-direct env resolution inside a `push .{ jni = env }` scope.
// `@JniCall(T, env, target, "name", "sig", args...)` — three args before the first
// string literal — has the env omitted. Lowering walks the in-progress AST
// visit stack to find the enclosing `push .{ jni = env }(env)` block and uses that env
// value directly as the IR-level env arg. No thread-local read, no per-call
// lookup; env stays register-resident across loop bodies.

#import "modules/std.sx";

g_should_call : bool = false;

unused_jni :: (env: *void, target: *void) {
    push .{ jni = env } {
        // Omitted env — env comes from the enclosing push .{ jni = env } scope.
        @JniCall(void, env, target, "noop", "()V");
    }
}

main :: () -> i32 {
    if g_should_call {
        unused_jni(null, null);
    }
    print("ok\n");
    0
}
