// Parser coverage for `@JniCall`
// and `@JniStaticCall`. Same `#<intrinsic>(ReturnT)(args...)`
// shape as `@ObjcCall`, parsed by the same rule.
//
// `inline if false` suppresses sema/codegen; this file pins the parse
// surface only.

#import "modules/std.sx";

main :: () -> i32 {
    inline if false {
        env : *void = null;
        push .{ jni = env } {
            // Instance method: target, name, sig, args...
            @JniCall(*void, env, null, "getWindow", "()Landroid/view/Window;");

            // Static method: class, name, sig, args...
            @JniStaticCall(i32, env, null, "max", "(II)I", 3, 7);

            // Returning a Java primitive (jboolean → sx bool).
            @JniCall(bool, env, null, "isShown", "()Z");
        }
    }
    print("parse-only ok\n");
    0
}
