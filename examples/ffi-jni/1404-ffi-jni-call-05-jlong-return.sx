// `@JniCall(i64)` (jlong return) dispatches through `CallLongMethod`,
// vtable slot 52.

@import "modules/std.sx";

gShouldCall : bool = false;

readLong :: (env: *void, target: *void) -> i64 {
    @JniCall(i64, env, target, "currentTimeMillis", "()J")
}

main :: () -> i32 {
    if gShouldCall {
        _ := readLong(null, null);
    }
    print("ok\n");
    0
}
