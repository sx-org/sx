// `#jni_call(i64)` (jlong return) dispatches through `CallLongMethod`,
// vtable slot 52.

#import "modules/std.sx";

g_should_call : bool = false;

read_long :: (env: *void, target: *void) -> i64 {
    #jni_env(env) {
        #jni_call(i64)(target, "currentTimeMillis", "()J")
    }
}

main :: () -> i32 {
    if g_should_call {
        _ := read_long(null, null);
    }
    print("ok\n");
    0
}
