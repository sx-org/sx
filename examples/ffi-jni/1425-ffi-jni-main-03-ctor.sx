// `Alias.new(args)` constructor dispatch on a `extern @JniClass`
// The sx-side `static new :: (...) ->
// *Self;` member lowers to JNI `FindClass + GetMethodID("<init>", sig)
// + NewObject(env, clazz, mid, args...)`.
//
// This smoke instantiates a `SurfaceView` from inside the Activity's
// `onCreate` body.

@import "modules/std.sx";
@import "modules/build.sx";

Bundle :: @JniClass("android/os/Bundle") extern {}
JContext :: @JniClass("android/content/Context") extern {}

SurfaceView :: @JniClass("android/view/SurfaceView") extern {
    new :: (ctx: *JContext) -> *Self;  // no `self: *Self` → class method
}

gHeldView : *void = null;

SxApp :: @JniClass("co/swipelab/sxjnictor/SxApp", main = true) {
    onCreate :: (self: *Self, b: *Bundle) {
        super.onCreate(b);
        ctx : *JContext = self.(*JContext); // Activity IS a Context.
        view := SurfaceView.new(ctx);
        gHeldView = view; // keep alive so LLVM doesn't DCE the construction.
    }
}

main :: () -> i32 { 0 }
