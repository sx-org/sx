// New-form variadic `..name: []T` defined in an imported
// module is callable from another module.
//
// `resolveParamType` + `packVariadicCallArgs` must not put the
// slice-form variadic's element type through an extra `sliceOf`
// wrap: treating `..parts: []string` like `parts: ..string` adds a
// slice level on top of the already-declared slice, and the
// double-wrapped `[][]T` signature does not match the `[N x T]`
// the call-site marshalling emits.
//
// The stdlib `pathJoin` uses the form
// (`(..parts: []string) -> string`); it lives in `modules/std.sx`
// and is called here from another module. Two- and three-arg
// shapes round-trip the slice through the function-call
// boundary and concatenate the parts with '/'. Empty join (no
// args) returns "".

@import "modules/std.sx";

main :: () -> i32 {
    print("{}\n", pathJoin());
    print("{}\n", pathJoin("a"));
    print("{}\n", pathJoin("a", "b"));
    print("{}\n", pathJoin("a", "b", "c", "d"));
    return 0;
}
