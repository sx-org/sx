// New-form variadic `..name: []T` defined in an imported
// module is callable from another module without crashing LLVM emit.
//
// `resolveParamType` + `packVariadicCallArgs` must not put the
// slice-form variadic's element type through an extra `sliceOf`
// wrap: treating `..parts: []string` like `parts: ..string` adds a
// slice level on top of the already-declared slice. The
// double-wrapped `[][]T` signature mismatches what the call-site
// marshalling emits as `[N x T]`, producing null/undef Refs that crash
// `LLVMBuildExtractValue` inside `emitStrCmp` during emission.
//
// The stdlib `path_join` uses the form
// (`(..parts: []string) -> string`); it lives in `modules/std.sx`
// and is called here from the test module. Two- and three-arg
// shapes must round-trip the slice through the function-call
// boundary and concatenate the parts with '/'. Empty join (no
// args) returns "".

#import "modules/std.sx";

main :: () -> i32 {
    print("{}\n", path_join());
    print("{}\n", path_join("a"));
    print("{}\n", path_join("a", "b"));
    print("{}\n", path_join("a", "b", "c", "d"));
    return 0;
}
