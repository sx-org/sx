// Variadic heterogeneous type packs — `..$args` — impl matching
// lock-in.
//
// A user-declared `impl Into(Block) for Closure(..$args) -> $R` matches a
// concrete closure source type: the `xx` cast at a `Closure(i32, bool) -> bool`
// source resolves through the pack impl.

#import "modules/std.sx";
#import "modules/ffi/objc_block.sx";

impl Into(Block) for Closure(..$args) -> $R {
    convert :: (self: Closure(..$args) -> $R, alloc: Allocator = context.allocator) -> Block {
        _ = alloc;
        .{
            isa = *_NSConcreteStackBlock,
            flags = 0,
            reserved = 0,
            invoke = null,
            descriptor = *__sx_block_descriptor,
            sx_env = self.env,
            sx_fn = self.fn_ptr,
        }
    }
}

main :: () -> i32 {
    cl := |a: i32, b: bool| true;
    blk := cl.(Block);
    b := *blk;
    print("pack impl match ok\n");
    return 0;
}
