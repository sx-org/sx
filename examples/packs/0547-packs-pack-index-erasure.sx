// A comptime-pack element bound to a named local, then coerced into an
// interface-typed handle. `sources[i]` is a pack index (no runtime storage of
// its own); the local is the storage the handle borrows.

@import "modules/std.sx";

VL :: interface(T: Type) { get :: (self: *Self) -> T; }
IntCell :: struct { v: i64; }
impl VL(i64) for IntCell { get :: (self: *IntCell) -> i64 => self.v; }

first :: (..sources: VL) -> i64 {
    s := sources[0];
    x := s.(VL(i64));
    return x.get();
}

main :: () -> i32 {
    print("{}\n", first(IntCell{ v = 7 }));                       // 7
    print("{}\n", first(IntCell{ v = 42 }, IntCell{ v = 99 }));  // 42 (element 0)
    0
}
