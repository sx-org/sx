// `<pack>[i].(I)` — a pack element coerced into an interface-typed local.
//
// A pack index is a comptime rvalue: a pack has no runtime storage, and
// `sources[i]` resolves to the call-site argument, which gets storage only
// when it is lowered as a value. So the coercion takes the rvalue arm — a
// frame-scoped temporary the handle borrows.

@import "modules/std.sx";

VL :: interface(T: Type) { get :: (self: *Self) -> T; }
IntCell :: struct { v: i64; }
impl VL(i64) for IntCell { get :: (self: *IntCell) -> i64 => self.v; }

first :: (..sources: VL) -> i64 {
    x := sources[0].(VL(i64));
    return x.get();
}

main :: () -> i32 {
    print("{}\n", first(IntCell{ v = 7 }));                       // 7
    print("{}\n", first(IntCell{ v = 42 }, IntCell{ v = 99 }));  // 42 (element 0)
    0
}
