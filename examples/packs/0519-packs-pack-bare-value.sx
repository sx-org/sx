// Bare `$args` — no `[...]` index — in expression position evaluates to a
// comptime `[]Type` slice: the whole pack as data, so a body can walk it and
// read `.len`.

@import "modules/std.sx";

len_of :: (..$args) -> i64 {
    list := $args;
    return list.len;
}

main :: () -> i32 {
    print("{}\n", len_of());
    print("{}\n", len_of(42));
    print("{}\n", len_of(1, 2, 3));
    print("{}\n", len_of("a", true, 3.14, "b"));
    return 0;
}
