// Variadic heterogeneous type packs — the control-flow edge of
// inline-comptime-body returns.
//
// An inline-comptime-body `return X;` routes into a result slot so
// the caller's basic block isn't terminated mid-flight, and sets
// `block_terminated = true` after the inline return — which must not
// leak PAST the enclosing `if`'s merge block. For the body shape
//   if cond { return X; }
//   return Y;
// the false-condition path has to reach the trailing `return Y;`, so
// `lowerBlockValue`'s loop keeps lowering past the merge block.
//
// Pack-fn `..$args` is the shortest spelling because `args.len`
// gives a comptime test for the condition. The shape is
// incidental — any comptime body with `if cond { return X; };
// return Y;` takes the same path.
//
// `maybe()` with zero call-args takes the false branch and falls through to
// `return -1;`.

@import "modules/std.sx";

maybe :: (..$args) -> i64 {
    if args.len > 0 {
        return 42;
    }
    return -1;
}

main :: () -> i32 {
    print("{}\n", maybe());      // expect -1
    print("{}\n", maybe(99));    // expect 42
    return 0;
}
