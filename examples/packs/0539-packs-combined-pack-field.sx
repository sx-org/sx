// The canonical `Combined` struct's storage layer: a generic
// struct whose field is a pack of PARAMETERIZED-protocol values,
// `sources: struct { ..VL(Ts) }` → positional product of `VL(T0), VL(T1), …`.
// Each `VL(Ti)` is a real 16-byte protocol value; the spread applies `VL` per
// pack element.
// Instantiate + whole-tuple store of postfix-erased values + per-element
// method dispatch all work.

@import "modules/std.sx";

VL :: interface(T: Type) { get :: (self: *Self) -> T; }
IntCell :: struct { v: i64; }
StrCell :: struct { s: string; }
impl VL(i64) for IntCell { get :: (self: *IntCell) -> i64 => self.v; }
impl VL(string) for StrCell { get :: (self: *StrCell) -> string => self.s; }

Combined :: struct($R: Type, ..$Ts: []Type) {
    sources: struct { ..VL(Ts) };
    value:   $R;
}

main :: () -> i32 {
    // Combined(i64, i64, string): R=i64, Ts=[i64, string],
    // sources: (VL(i64), VL(string)).
    c : Combined(i64, i64, string) = ---;
    c.sources = .{IntCell{ v = 10 }.(VL(i64)), StrCell{ s = "hi" }.(VL(string))};
    c.value = 99;
    print("{} {} {}\n", c.sources.0.get(), c.sources.1.get(), c.value);  // 10 hi 99
    0
}
