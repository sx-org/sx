// Bare `$args` slice survives crossing a function-call
// boundary — both `.len` AND per-element values come through.
//
// `lazyLowerFunction` must not let the callee's `args.len` be
// constant-folded to the outer pack-fn mono's arity:
// `walk(args: []any) { return args.len; }` lazily lowered
// inside `probe(..$args)`'s first mono must not inherit
// `pack_param_count["args"] = N` from the pack, or the
// `<pack_name>.len` intercept in `lowerFieldAccess` bakes
// `ret i64 N` into walk's IR and every later shape reads that
// same constant.
//
// `describe(args)` walks element-by-element so a silent
// truncation surfaces as a missing tail (or a different type at
// some position) — not just the wrong length.
//
// Walking under `#run` is required: the bare-`$args` slice
// carries `const_type` elements that only the interp materialises;
// LLVM emission leaves the per-element slots as undef, bare-pack
// being comptime-only.
//
// The element type is `[]Type` (a bare `$args` is the list of the
// pack args' TYPES, each an 8-byte `.type_value`). Declaring it
// `[]any` (16-byte boxes) reads every element past the first at the
// wrong stride, which the byte-accurate comptime VM rejects.

#import "modules/std.sx";

describe :: (args: []Type) -> string {
    s := "[";
    i : i64 = 0;
    while i < args.len {
        if i > 0 { s = concat(s, ", "); }
        s = concat(s, type_name(args[i]));
        i = i + 1;
    }
    return concat(s, "]");
}

probe :: (..$args) -> string {
    list := $args;
    return describe(list);
}

run_all :: () {
    print("0: {}\n", probe());
    print("1: {}\n", probe(1));
    print("3: {}\n", probe(1, "x", true));
    print("5: {}\n", probe(1, 2.0, "x", true, 99));
}
#run run_all();

main :: () { print("rt\n"); }
