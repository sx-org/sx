// Variadic heterogeneous type packs — `..$args` — parse smoke.
//
// The parser accepts `..$args` (variadic marker + comptime sigil + name) as a
// parameter declaration. The function is declared but never instantiated, so
// nothing here binds the pack.

@import "modules/std.sx";

foo :: (..$args) -> i64 {
    return 0;
}

main :: () -> i32 {
    print("pack parse ok\n");
    return 0;
}
