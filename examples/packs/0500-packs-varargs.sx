@import "modules/std.sx";

sum :: (..args: []i32) -> i32 {
    result: i32 = 0;
    for it in args {
        result = result + it;
    }
    result
}

printAll :: (..args: []i32) {
    for it in args {
        print("{} ", intToString(it));
    }
    print("\n");
}

main :: () -> i32 {
    print("{}\n", intToString(sum(10, 20, 30)));

    printAll(1, 2, 3, 4, 5);

    arr : [3]i32 = .[10, 20, 30];
    print("{}\n", intToString(sum(..arr)));

    for it in arr {
        print("{} ", intToString(it));
    }
    print("\n");
    0
}
