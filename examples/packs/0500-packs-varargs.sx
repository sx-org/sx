@import "modules/std.sx";

sum :: (..args: []i32) -> i32 {
    result := 0;
    for it in args {
        result = result + it;
    }
    result
}

printAll :: (..args: []i32) {
    for it in args {
        @printf("{}", intToString(it));
        @printf(" ");
    }
    @printf("\n");
}

main :: () -> i32 {
    @printf("{}", intToString(sum(10, 20, 30)));
    @printf("\n");

    printAll(1, 2, 3, 4, 5);

    arr : [3]i32 = .[10, 20, 30];
    @printf("{}", intToString(sum(..arr)));
    @printf("\n");

    for it in arr {
        @printf("{}", intToString(it));
        @printf(" ");
    }
    @printf("\n");
    0
}
