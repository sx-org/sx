@import "modules/std.sx";

sum :: (..args: []i32) -> i32 {
    result := 0;
    for it in args {
        result = result + it;
    }
    result
}

printAll :: (..args: []i32) {
    for it in args {
        out(intToString(it));
        out(" ");
    }
    out("\n");
}

main :: () -> i32 {
    out(intToString(sum(10, 20, 30)));
    out("\n");

    printAll(1, 2, 3, 4, 5);

    arr : [3]i32 = .[10, 20, 30];
    out(intToString(sum(..arr)));
    out("\n");

    for it in arr {
        out(intToString(it));
        out(" ");
    }
    out("\n");
    0
}
