// Two distinct comptime-pack elements, each bound to a named local and then
// coerced to an interface handle. Each handle borrows its local and dispatches
// that concrete type's method (IntCell.get vs Doubler.get).

@import "modules/std.sx";

VL :: interface(T: Type) { get :: (self: *Self) -> T; }
IntCell :: struct { v: i64; }
impl VL(i64) for IntCell { get :: (self: *IntCell) -> i64 => self.v; }
Doubler :: struct { n: i64; }
impl VL(i64) for Doubler { get :: (self: *Doubler) -> i64 => self.n * 2; }

sum_two :: (..sources: VL) -> i64 {
    s0 := sources[0];
    s1 := sources[1];
    a := s0.(VL(i64));
    b := s1.(VL(i64));
    return a.get() + b.get();
}

main :: () -> i32 {
    print("{}\n", sum_two(IntCell{ v = 10 }, Doubler{ n = 16 }));  // 10 + (16*2) = 42
    0
}
