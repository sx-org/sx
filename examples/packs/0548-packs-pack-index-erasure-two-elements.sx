// Coerce two DISTINCT comptime-pack elements into interface locals — each
// borrows its own frame temporary and resolves to its OWN concrete type's
// method (IntCell.get vs Doubler.get), so the per-element coercion picks the
// right vtable.
//
// Single-element `pack[i].(I)` has its own path, distinct from lowering the
// bare pack as a value.

@import "modules/std.sx";

VL :: interface(T: Type) { get :: (self: *Self) -> T; }
IntCell :: struct { v: i64; }
impl VL(i64) for IntCell { get :: (self: *IntCell) -> i64 => self.v; }
Doubler :: struct { n: i64; }
impl VL(i64) for Doubler { get :: (self: *Doubler) -> i64 => self.n * 2; }

sum_two :: (..sources: VL) -> i64 {
    a := sources[0].(VL(i64));   // own element 0
    b := sources[1].(VL(i64));   // own element 1
    return a.get() + b.get();
}

main :: () -> i32 {
    print("{}\n", sum_two(IntCell{ v = 10 }, Doubler{ n = 16 }));  // 10 + (16*2) = 42
    0
}
