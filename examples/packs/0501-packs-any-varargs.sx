@import "modules/std.sx";

Point :: struct {
    x: i32;
    y: i32;
}

// Print all arguments — accepts any type, dispatches via type-switch
printAny :: (..args: []any) {
    for it in args {
        type := @typeOf(it);
        match type {
            case int: print("{}", @as(i64, it));
            case string: print("{}", it.(string));
            case bool: print("{}", it.(bool));
            case float: print("{}", @as(f64, it));
            case Point: {
                p := it.(Point);
                print("({},{})", intToString(p.x), intToString(p.y));
            }
        }
        print(" ");
    }
    print("\n");
}

count :: (..args: []any) -> i32 {
    args.len.(i32)
}

main :: () -> i32 {
    printAny(42, "hello", true, 3.14);

    // Test with struct
    p := Point{ x=10, y=20 };
    printAny("point:", p, 99);

    // Test count
    print("{}\n", intToString(count(1, 2, 3)));

    0
}
