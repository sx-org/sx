// Variadic heterogeneous type packs — mixed `$comptime + ..$args` pack-fn
// signatures.
//
// A pack-fn signature may carry other comptime params ahead of the trailing
// pack: `tagged :: ($tag: i32, ..$args)` binds `tag` as a value in the body
// alongside the pack's comptime `args.len`.

@import "modules/std.sx";

tagged :: ($tag: i32, ..$args) -> i64 {
    return tag * 100 + args.len;
}

main :: () -> i32 {
    print("{}\n", tagged(7, 1, 2, 3));   // 7*100 + 3 = 703
    print("{}\n", tagged(9));             // 9*100 + 0 = 900
    return 0;
}
