// `<pack>[i].(P, alloc)` — a pack element owned into a protocol-typed local.
//
// Erasing a single comptime-pack element to a protocol scalar routes through
// the postfix owning erasure. A pack index is a comptime rvalue (a pack has
// no runtime storage — `sources[i]` resolves to the call-site arg, which
// only gets storage when lowered as a value), so the erasure heap-copies
// the materialized element rather than taking its address.

@import "modules/std.sx";

VL :: interface(T: Type) { get :: (self: *Self) -> T; }
IntCell :: struct { v: i64; }
impl VL(i64) for IntCell { get :: (self: *IntCell) -> i64 => self.v; }

first :: (..sources: VL) -> i64 {
    x := sources[0].(VL(i64));   // own element 0 as VL(i64)
    return x.get();
}

main :: () -> i32 {
    print("{}\n", first(IntCell{ v = 7 }));                       // 7
    print("{}\n", first(IntCell{ v = 42 }, IntCell{ v = 99 }));  // 42 (element 0)
    0
}
