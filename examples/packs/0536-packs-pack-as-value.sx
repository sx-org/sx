// Pack-as-value diagnostics. A pack is comptime-only, so using the bare pack
// name where a runtime value is required is an error, with a context-tailored
// suggestion. All five categories below fire (the functions are monomorphized
// when called from main).

@import "modules/std.sx";

Show :: constraint { show :: (self: *Self) -> string; }
A :: struct {}
impl Show for A { show :: (self: *A) -> string => "A"; }

sink :: (v: i64) -> void { _ = v; }

storage :: (..xs: Show) -> void { y := xs; _ = y; }          // A: store
call    :: (..xs: Show) -> void { sink(xs); }                // B: pass to a call
ret     :: (..xs: Show) -> i64  { return xs; }               // C: return
iter    :: (..xs: Show) -> void { for x in xs { _ = x; } }  // D: runtime iterate
env     :: (..xs: Show) -> void { f := ||_{ xs = xs } {}; f(); }  // E: a closure env field

main :: () -> i32 {
    storage(A{});
    call(A{});
    _ = ret(A{});
    iter(A{});
    env(A{});
    0
}
