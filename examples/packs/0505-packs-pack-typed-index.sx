// `args[$i]`, with `$i` a comptime-known integer, resolves inside a pack-fn
// body to the i-th call-site argument at its CONCRETE type rather than a
// boxed `any`, so field access, typed coercion and typed slots reach the
// element directly: `args[0].x` on a struct-typed call arg reads the field.

#import "modules/std.sx";

Point :: struct { x: i64; y: i64; }

get_x :: (..$args) -> i64 => args[0].x;

main :: () -> i32 {
    p := Point{ x = 7, y = 9 };
    n := get_x(p);
    print("{}\n", n);
    return 0;
}
