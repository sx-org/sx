// `$args[$i]` resolves to the i-th element type of the active pack binding
// wherever a type expression is expected. Two positions are exercised per
// mono:
// - return type: `-> $args[0]`
// - local var annotation: `x : $args[1] = ...`

@import "modules/std.sx";

swapTake :: (..$args) -> $args[0] {
    second : $args[1] = args[1];
    return args[0];
}

main :: () -> i32 {
    // Heterogeneous call shapes — each picks a different concrete
    // pair, gets its own mono.
    a : i64 = swapTake(42, "ignored");      // $args[0] = i64, $args[1] = string
    b : string = swapTake("first", 99);      // $args[0] = string, $args[1] = i64
    print("{} {}\n", a, b);
    return 0;
}
