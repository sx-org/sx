// A pack-closure param-impl source `Closure(*Box, ..$args) -> $R` mixes a
// CONCRETE fixed prefix (`*Box`) with pack metadata (`..$args`, `$R`). The
// choke-point decides template-vs-author AT THE LEAF: `*Box` is resolved
// SOURCE-AWARE through `resolveCompound` while `..$args`/`$R` stay pack
// metadata via `PackResolver` — not through a top-level "contains-unbound →
// no-author wrapper" router, which sends `*Box` down the global last-wins
// path and registers the collision silently. With two flat `Box` authors and
// none own, the concrete `*Box` prefix is a genuine collision and the build
// exits 1, while the pack parts raise nothing.
//
// The pure-pack `Closure(..$args) -> $R` bridge in
// `library/modules/ffi/objc_block.sx` has a single author and keeps the
// prefix-free path (0504 / 1302 / 1304).

@import "modules/std.sx";
@import "0829-packs-param-impl-mixed-pack-source-ambiguous/a.sx";
@import "0829-packs-param-impl-mixed-pack-source-ambiguous/b.sx";

Block :: struct { tag: i32; }

Sink :: protocol(T: Type) {
    convert :: (self: *Self) -> T;
}

impl Sink(Block) for Closure(*Box, ..$args) -> $R {
    convert :: (self: Closure(*Box, ..$args) -> $R) -> Block {
        .{ tag = 0 }
    }
}

main :: () -> i32 {
    0
}
