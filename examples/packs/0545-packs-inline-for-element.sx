// `inline for` element form over a pack — multi-iterable parity with the
// runtime for-loop. Position 0 drives the unroll count (a pack's arity or a
// bounded range's span); trailing iterables pair with it. A pack capture is
// the concrete per-position element viewed through the constraint protocol
// (same semantics as `xs[i]`); a range capture is a comptime cursor.
//
//   inline for x in xs            — element form
//   inline for x, i in xs, 0..    — element + paired index
//   inline for i, x in 0..xs.len, xs — range driver, trailing pack
//   inline for xs {}            — captureless; N=0 unrolls nothing

@import "modules/std.sx";

Show :: constraint { show :: (self: *Self) -> string; }
IntBox :: struct { v: i64; }
StrBox :: struct { s: string; }
impl Show for IntBox { show :: (self: *IntBox) -> string { intToString(self.v) } }
impl Show for StrBox { show :: (self: *StrBox) -> string { self.s } }

bare :: (..xs: Show) {
    inline for x in xs {
        print("bare: {}\n", x.show());
    }
}
elemAndIndex :: (..xs: Show) {
    inline for x, i in xs, 0.. {
        print("{}: {}\n", i, x.show());
    }
}
rangeDriver :: (..xs: Show) {
    inline for i, x in 0..xs.len, xs {
        print("r{}: {}\n", i, x.show());
    }
}
offsetIndex :: (..xs: Show) {
    inline for x, i in xs, 10.. {
        print("{} -> {}\n", i, x.show());
    }
}
captureless :: (..xs: Show) {
    n := 0;
    inline for xs { n += 1; }
    print("ran {}\n", n);
}
valuePos :: (..xs: Show) {
    inline for x in xs {
        print("val: {}\n", x);
    }
}
empty :: (..xs: Show) {
    inline for x in xs { print("never\n"); }
    print("empty ok\n");
}

main :: () {
    bare(IntBox{ v = 7 }, StrBox{ s = "hi" });
    elemAndIndex(IntBox{ v = 7 }, StrBox{ s = "hi" });
    rangeDriver(IntBox{ v = 1 }, StrBox{ s = "two" });
    offsetIndex(StrBox{ s = "x" }, StrBox{ s = "y" });
    captureless(IntBox{ v = 0 }, IntBox{ v = 0 }, IntBox{ v = 0 });
    valuePos(IntBox{ v = 42 });
    empty();
}
