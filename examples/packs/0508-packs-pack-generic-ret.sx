// A pack-fn's return type can be a generic name (`$R`) — bound at
// the call site to match the body's natural type or the caller's
// target. `monomorphizePackFn` resolves `$R` against the call's own
// bindings, so the mono's signature carries the concrete ret_ty.

@import "modules/std.sx";

first :: (..$args) -> $R => args[0];

main :: () -> i32 {
    a : i64 = first(42);
    b : i64 = first(99);
    print("{} {}\n", a, b);
    return 0;
}
