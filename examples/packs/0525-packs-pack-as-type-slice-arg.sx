// A variadic `..$args` pack forwarded as a `[]Type`
// ARGUMENT across a call must read the right element types.
// `buildPackSliceValue` materializes the pack at the target element type's
// own stride, so a `[]Type` reader (`.type_value`, 8 bytes) sees
// `[t0, t1, …]` rather than the 16-byte `[]any` layout — a distinction the
// byte-accurate comptime VM enforces.
@import "modules/std.sx";

inner :: (args: []Type) -> string {
    s := "";
    i : i64 = 0;
    while i < args.len {
        s = concat(s, type_name(args[i]));
        s = concat(s, " ");
        i = i + 1;
    }
    return s;
}

outer :: (..$args) -> string { return inner($args); }

R :: @run outer(42, "hi", true);

main :: () {
    print("[{}]\n", R);
}
