// Slice-of-protocol variadic `..xs: []P` — the RUNTIME counterpart to the
// comptime pack `..xs: P`. Each trailing arg coerces per §5.2 into a `P`
// handle and packs into a runtime `[N]P`; the array is call-scoped and does
// not invent referents. Elements are indexed by a RUNTIME index and dispatched
// through the handle (unlike a pack, which is comptime-only — see 0526).

@import "modules/std.sx";

Show :: interface { show :: (self: *Self) -> string; }
A :: struct { x: i64; }
B :: struct { s: string; }
impl Show for A { show :: (self: *A) -> string => "A"; }
impl Show for B { show :: (self: *B) -> string => "B"; }

// Runtime loop over a []Show: runtime index + protocol-method dispatch.
each :: (..xs: []Show) -> void {
    i := 0;
    while i < xs.len {
        print("[{}]={}\n", i, xs[i].show());
        i = i + 1;
    }
}

main :: () -> i32 {
    a1 := A{ x = 1 };
    b1 := B{ s = "hi" };
    a3 := A{ x = 3 };
    each(a1.(Show), b1.(Show), a3.(Show));
    each();                                            // empty is fine (len 0)
    0
}
