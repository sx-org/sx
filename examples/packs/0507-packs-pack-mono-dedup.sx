// A pack-fn monomorphises per call SHAPE: each unique call signature gets ONE
// mono fn and repeat calls with the same signature share it, so IR size scales
// with the number of unique shapes rather than with call sites. `sx ir` shows
// the distinct mono symbols:
//
//   call @count__pack(ctx)
//   call @count__pack_i64(ctx, 1)
//   call @count__pack_i64(ctx, 2)              ← shares with the 1-arg i64 call
//   call @count__pack_i64_i64_i64(ctx, 1, 2, 3)
//   call @count__pack_string_bool(ctx, ..)

#import "modules/std.sx";

count :: (..$args) -> i64 => args.len;

main :: () -> i32 {
    a := count();
    b := count(1);
    c := count(2);
    d := count(1, 2, 3);
    e := count("x", true);
    print("{} {} {} {} {}\n", a, b, c, d, e);
    return 0;
}
