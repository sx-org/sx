// An `@Init(T)` cannot be returned from an ordinary function (spec §5.1): its
// recipe captures the forming frame, so handing it back would outlive the
// captures. A receiver may forward it to another `@Init(T)` parameter, but the
// value itself never leaves the call that formed it.
// Expected: exit 1.
#import "modules/std.sx";

Button :: struct {
    label: string = "";
}

keep :: (value: @Init($T)) -> @Init(T) {   // refused: not a parameter position
    value
}

main :: () -> i32 {
    0
}
