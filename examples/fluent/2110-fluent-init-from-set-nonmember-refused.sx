// A set value narrows only to a type that declares membership in that set, and a
// target outside the set is refused as a non-member — under an optional too, in
// both the argument and dot-receiver spellings.
//
// The narrowing belongs to the formation write alone. The same conversion written
// anywhere else — at top level, or inside a formation's own source expression —
// is the ordinary refusal, and so is the element of a product the write decomposes.
@import "modules/std.sx";

Named :: interface { name :: (self: *Self) -> string; }

View :: @OpenSet(.{ max = 128 }) { render :: (self: *Self) -> string; }

Label :: @OpenVariant(View) {
    text: string = "";
    render :: (self: *Label) -> string => self.text;
}

Plain :: struct { text: string = ""; }

formPlain :: ufcs (value: $I/@Init(Plain)) {
    slot: Plain = ---;
    value.write(*slot);
}

formOptPlain :: ufcs (value: $I/@Init(?Plain)) {
    slot: ?Plain = ---;
    value.write(*slot);
}

formNamed :: ufcs (value: $I/@Init(Named)) {
    slot: Named = ---;
    value.write(*slot);
}

formLabel :: ufcs (value: $I/@Init(Label)) {
    slot: Label = ---;
    value.write(*slot);
}

ViewI64 :: struct { a: View; b: i64 };
LabelI64 :: struct { a: Label; b: i64 };
formTuple :: ufcs (value: $I/@Init(LabelI64)) {
    slot: LabelI64 = ---;
    value.write(*slot);
}

needLabel :: ufcs (l: Label) { print("need Label {}\n", l.text); }
needOptLabel :: ufcs (l: ?Label) { print("need ?Label {}\n", l?!.text); }

echoLabel :: (l: Label) -> Label => l;

main :: () -> i32 {
    v : View = Label{ text = "member" };

    formPlain(v);
    v.formPlain();
    formOptPlain(v);
    v.formOptPlain();
    formNamed(v);
    v.formNamed();

    needLabel(v);
    v.needLabel();
    formLabel(echoLabel(v));
    echoLabel(v).formLabel();

    t : ViewI64 = .{a = v, b = 3};
    formTuple(t);

    label : Label = v;
    needOptLabel(v);
    0
}
