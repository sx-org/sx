// `content.shape()` plus example-owned planning.
//
// `@BuildShape` is compiler-produced FACT and lives in stdlib. Planning is
// ordinary library POLICY over those facts, so `Plan` / `PlanPolicy` /
// `make_plan` are declared right here rather than in stdlib — nothing about
// them is a language contract. A hybrid accepter asks for the shape, reserves
// from the plan, then runs.
@import "modules/std.sx";
@import "modules/fluent.sx";

Drawable :: constraint {
    draw :: (self: *Self) -> string;
}

// Example-owned planning policy over the compiler's facts.
PlanPolicy :: struct {
    reserve_static: bool = true;
    dynamic_chunk: i32 = 64;
}

Plan :: struct {
    shape: @BuildShape = .{};
    static_capacity: i32 = 0;
    reserved_bytes: i64 = 0;
    dynamic_chunk: i32 = 64;
}

make_plan :: (shape: @BuildShape, policy: PlanPolicy) -> Plan {
    reserved : i64 = if policy.reserve_static then shape.known_bytes ?? 0 else 0;
    capacity : i32 = if policy.reserve_static then shape.static_expressions else 0;
    Plan{
        shape = shape,
        static_capacity = capacity,
        reserved_bytes = reserved,
        dynamic_chunk = policy.dynamic_chunk,
    }
}

Label :: struct { text: string = ""; }
impl Drawable for Label {
    draw :: (self: *Label) -> string => self.text;
}

Dot :: struct { n: i32 = 0; }
impl Drawable for Dot {
    draw :: (self: *Dot) -> string => ".";
}

// Capturing sink that also prints the plan it reserved for.
Hold :: struct {
    n: i32 = 0;
    expression :: (self: *Hold, value: $I/@Init($V/Drawable)) {
        dest := context.allocator.create(V);
        value.write(dest);
        print("  kept #{} {}\n", self.n, dest.draw());
        self.n += 1;
        context.allocator.destroy(dest);
    }
}

panel :: (content: $B/@BuildBlock(Drawable)) -> i32 {
    shape: @BuildShape = content.shape();
    plan := make_plan(shape, .{
        reserve_static = true,
        dynamic_chunk = 8,
    });
    print("shape static={} dynamic={} known={} align={}\n",
        shape.static_expressions,
        shape.dynamic_regions,
        shape.known_bytes ?? -1,
        shape.max_alignment);
    print("plan capacity={} reserved={} chunk={}\n",
        plan.static_capacity,
        plan.reserved_bytes,
        plan.dynamic_chunk);
    sink := Hold{};
    content.run(*sink);
    sink.n
}

main :: () -> i32 {
    // Two static expressions, no dynamic regions.
    a := panel() {
        Label{ text = "A" };
        Label{ text = "B" };
    };
    // A runtime loop is one dynamic region.
    items := .["x", "y", "z"];
    b := panel() {
        for t in items {
            Label{ text = t };
        }
        Dot{ n = 1 };
    };
    print("reached {} {}\n", a, b);
    0
}
