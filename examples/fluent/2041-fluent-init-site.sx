// `value.site()` — where the initializer's expression was WRITTEN. The
// counterpart of `content.site()` (2039): a block reports the
// block, an initializer reports the one expression it was formed from.
//
// Each formation site is its own initializer type, so the site is a compile-time
// constant of that type: two expressions in one declaration report different
// lines and different ordinals, and the receiving function is monomorphized once
// per site.
//
// Inside a generic function the site is the TEMPLATE's: both instantiations
// report the same declaration path and the same ordinal, so an identity built
// from a site is stable against instantiation order.
@import "modules/std.sx";
@import "modules/std/core.sx";
@import "modules/std/source_site.sx";

Button :: struct { label: string = ""; }

report :: (tag: string, value: $I/@Init($T)) -> i32 {
    s := value.site();
    if s == null {
        print("{}: no site\n", tag);
        return 0;
    }
    print("{}: {}:{} in {} ordinal {} parity={}\n", tag, s?!.file, s?!.line, s?!.declaration,
        s?!.ordinal, s?!.id == sourceSiteKeyId(sourceSiteKey(s?!)));
    s?!.line
}

// Two formation sites in one declaration: distinct lines, distinct ordinals.
two_sites :: () {
    _first := report("first", Button{ label = "a" });
    _second := report("second", Button{ label = "b" });
}

// One formation site inside a generic function: both instantiations report the
// template's declaration and ordinal.
relay :: (tag: string, x: $T) -> i32 {
    report(tag, x)
}

// A runtime loop reuses one lexical site however many times it runs.
looped :: () {
    for i in 0..2 {
        _ignored := report("loop", Button{ label = "in a loop" });
    }
}

main :: () -> i32 {
    two_sites();
    _b := relay("generic Button", Button{ label = "g" });
    _i := relay("generic i64", 7);
    looped();
    0
}

// ** stdout **
// first: 2041-fluent-init-site.sx:32 in 2041-fluent-init-site.two_sites ordinal 5 parity=true
// second: 2041-fluent-init-site.sx:33 in 2041-fluent-init-site.two_sites ordinal 15 parity=true
// generic Button: 2041-fluent-init-site.sx:39 in 2041-fluent-init-site.relay ordinal 7 parity=true
// generic i64: 2041-fluent-init-site.sx:39 in 2041-fluent-init-site.relay ordinal 7 parity=true
// loop: 2041-fluent-init-site.sx:45 in 2041-fluent-init-site.looped ordinal 9 parity=true
// loop: 2041-fluent-init-site.sx:45 in 2041-fluent-init-site.looped ordinal 9 parity=true
//
