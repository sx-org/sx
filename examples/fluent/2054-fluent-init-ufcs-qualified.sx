// A dot on a NAME is not a receiver.
//
// A ufcs function whose first parameter is destination-first takes its receiver
// unevaluated, because the receiver IS that first argument. A qualified spelling
// has no receiver at all: the name before the dot says where the function lives —
// a module reached by name, or the type whose static it is — and what follows the
// parentheses is the whole of what it is called with.
//
// All three spellings share one name here, and each reaches what it names.
//
// Which module declares which matters: the ufcs is flat-imported and the plain
// function is reached by name, because a name declared BOTH here and in a
// flat-imported module collapses to one winner, and the dot-call would then report
// whichever declaration won rather than the spelling under test.
@import "modules/std.sx";
@import "modules/std/list.sx";
@import "2054-fluent-init-ufcs-qualified/emitter.sx";
lib :: @import "2054-fluent-init-ufcs-qualified/named.sx";

Holder :: struct {
    v: i64 = 0;

    // A static of the same name: `Holder.publish(3)` names this one.
    publish :: (n: i64) -> string => "static";
}

main :: () -> i32 {
    out : List(View) = .{};
    push .{ uiOut = *out } {
        // The name before the dot is a module, then a type: neither is an argument.
        print("{} {}\n", lib.publish(6), Holder.publish(3));

        // A value receiver: formed, and evaluated only by the write.
        print("{}\n", Label{ text = "a member" }.publish());
    }
    print("emitted {} {}\n", out.len, out.items[0].render());
    0
}

// ** stdout **
// namespace static
// receiver
// emitted 1 a member
//
