// An `@Init(T)` constructs its destination AT MOST ONCE (spec §5.1, §6.2).
// A second `write` on the same initializer is refused, naming the first.
// Expected: exit 1.
#import "modules/std.sx";

Button :: struct {
    label: string = "";
}

store_twice :: (value: @Init($T)) -> *T {
    first := context.allocator.create(T);
    second := context.allocator.create(T);
    value.write(first);
    value.write(second);   // refused: the recipe is already consumed
    first
}

main :: () -> i32 {
    b := store_twice(Button{ label = "Play" });
    print("{}\n", b.label);
    0
}
