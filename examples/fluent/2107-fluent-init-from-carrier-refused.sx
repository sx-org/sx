// A protocol value is a handle to its conformer, not the concrete value an
// `@Init(T)` writes. Argument and dot-receiver formation both refuse tagged and
// erased handles and name `.(T)` / `.(?T)` as the explicit downcast path.
#import "modules/std.sx";

Named :: protocol tagged { name :: (self: *Self) -> string; }
Boxed :: protocol vtable { name :: (self: *Self) -> string; }
Wired :: protocol inline { name :: (self: *Self) -> string; }

Round :: struct { s: string = "round"; }
impl Named for Round { name :: (self: *Round) -> string => self.s; }
impl Boxed for Round { name :: (self: *Round) -> string => self.s; }
impl Wired for Round { name :: (self: *Round) -> string => self.s; }

// A conformer laid out at the handle's own width: a handle is still not it.
Wide :: struct { n: i64 = 0; s: string = ""; }
impl Boxed for Wide { name :: (self: *Wide) -> string => self.s; }

keep :: ufcs (value: $I/@Init(Round)) {
    slot: Round = ---;
    value.write(*slot);
    print("kept {}\n", slot.s);
}

keep_wide :: ufcs (value: $I/@Init(Wide)) {
    slot: Wide = ---;
    value.write(*slot);
    print("wide {}\n", slot.s);
}

main :: () -> i32 {
    // A tagged handle: two words that reference the conformer.
    n : Named = Round{ s = "tagged" };
    keep(n);
    n.keep();

    // The erased kinds, which carry their dispatch in the value itself.
    b : Boxed = Round{ s = "vtable" };
    keep(b);
    b.keep();

    w : Wired = Round{ s = "inline" };
    keep(w);
    w.keep();

    x : Boxed = Wide{ n = 1, s = "same width" };
    keep_wide(x);
    x.keep_wide();

    0
}
