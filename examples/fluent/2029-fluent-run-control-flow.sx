// Ordinary control flow inside a build block, and what a build site identifies
// (fluent spec §7.4, §7.5, §8).
//
// `if` / `for` / `while` execute when `run` executes — the block is replayed,
// not unrolled, and no runtime compiler service is involved. A loop therefore
// performs one handshake per iteration and reports the SAME lexical site every
// time: a site is where the expression is WRITTEN, not when it ran. A library
// that needs per-item identity combines the site with a key or an occurrence
// count of its own, which `Roster` below does with `seen`.
//
// `run` may also be called more than once. Each call replays the body from the
// start, so the same block observed by two sinks reports the same sites in the
// same order.
#import "modules/std.sx";
#import "modules/fluent.sx";

Drawable :: protocol constraint {
    draw :: (self: *Self) -> string;
}

Label :: struct { text: string = ""; }
impl Drawable for Label {
    draw :: (self: *Label) -> string => self.text;
}

Roster :: struct {
    seen: i32 = 0;
    // Which lexical expression a publication came from is the INITIALIZER's to
    // report (`value.site()`); the sink adds the occurrence count, which is what
    // distinguishes a loop's repeats from separate statements.
    expression :: (self: *Roster, value: $I/@Init($V/Drawable)) {
        dest := context.allocator.create(V);
        value.write(dest);
        s := value.site();
        if s != null {
            print("  line {} ordinal {} occurrence {} -> {}\n", s!.line, s!.ordinal, self.seen, dest.draw());
        }
        self.seen += 1;
        context.allocator.destroy(dest);
    }
}

column :: (content: $B/@BuildBlock(Drawable)) {
    first := Roster{};
    content.run(*first);
    print("  -- replay --\n");
    second := Roster{};
    content.run(*second);
}

main :: () -> i32 {
    show_title := true;
    rows := .["alpha", "beta"];

    column() {
        if show_title {
            Label{ text = "title" };
        }
        for rows (row) {
            Label{ text = row };
        }
    };
    0
}

// ** stdout **
//   line 57 ordinal 16 occurrence 0 -> title
//   line 60 ordinal 21 occurrence 1 -> alpha
//   line 60 ordinal 21 occurrence 2 -> beta
//   -- replay --
//   line 57 ordinal 16 occurrence 0 -> title
//   line 60 ordinal 21 occurrence 1 -> alpha
//   line 60 ordinal 21 occurrence 2 -> beta
