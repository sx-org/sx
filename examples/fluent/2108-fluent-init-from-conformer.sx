// What forms an `@Init(T)` is a value that IS a `T`.
//
// A concrete conformer forms one wherever it is written — as an argument, as a
// dot receiver — and the write fills the destination with exactly what the
// expression produced. Every modeled conversion the language already has reaches
// the target the same way it does at any other store: a member into its set, a
// value under an optional, anything into `any` — which boxes a handle's concrete
// receiver and a set slot's active member. A protocol handle reaches a concrete
// parameter by naming the conformer: the downcast yields the concrete value, and
// that forms; its own protocol type it forms as it stands.
//
// The source expression is an ordinary expression: calls inside it are typed and
// converted by ordinary rules before the write decides anything.
@import "modules/std.sx";

Named :: interface { name :: (self: *Self) -> string; }

Round :: struct { s: string = "round"; }
impl Named for Round { name :: (self: *Round) -> string => self.s; }

View :: @OpenSet(.{ max = 128 }) { render :: (self: *Self) -> string; }

Label :: @OpenVariant(View) {
    text: string = "";
    render :: (self: *Label) -> string => self.text;
}

formRound :: ufcs (value: $I/@Init(Round)) {
    slot: Round = ---;
    value.write(*slot);
    print("Round {}\n", slot.s);
}

formOptRound :: ufcs (value: $I/@Init(?Round)) {
    slot: ?Round = ---;
    value.write(*slot);
    print("?Round {}\n", slot?!.s);
}

formView :: ufcs (value: $I/@Init(View)) {
    slot: View = ---;
    value.write(*slot);
    print("View {}\n", slot.render());
}

formOptView :: ufcs (value: $I/@Init(?View)) {
    slot: ?View = ---;
    value.write(*slot);
    print("?View {}\n", slot?!.render());
}

formNamed :: ufcs (value: $I/@Init(Named)) {
    slot: Named = ---;
    value.write(*slot);
    print("Named {}\n", slot.name());
}

formAny :: ufcs (value: $I/@Init(any)) {
    slot: any = ---;
    value.write(*slot);
    match slot {
        case Round: |r| { print("any Round {}\n", r.s); }
        case Label: |l| { print("any Label {}\n", l.text); }
        else: { print("any other\n"); }
    }
}

echoRound :: (r: Round) -> Round => r;
echoLabel :: (l: Label) -> Label => l;

main :: () -> i32 {
    named := Round{ s = "downcast" };
    h : Named = *named;

    formRound(Round{ s = "argument" });
    Round{ s = "receiver" }.formRound();
    formRound(h.(Round));
    h.(Round).formRound();

    formOptRound(Round{ s = "wrapped" });
    Round{ s = "wrapped receiver" }.formOptRound();

    formView(Label{ text = "member" });
    Label{ text = "member receiver" }.formView();

    formOptView(Label{ text = "member wrapped" });
    Label{ text = "member wrapped receiver" }.formOptView();

    formNamed(h);
    h.formNamed();

    formAny(Round{ s = "boxed" });
    Round{ s = "boxed receiver" }.formAny();
    formAny(h);
    formAny(Label{ text = "boxed member" });

    formRound(echoRound(Round{ s = "nested" }));
    echoRound(Round{ s = "nested receiver" }).formRound();
    formView(echoLabel(Label{ text = "nested member" }));
    echoLabel(Label{ text = "nested member receiver" }).formView();
    0
}
