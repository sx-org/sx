// Ordinary modeled conversions compose from a protocol-typed source. At an
// unmodeled concrete leaf, the source is a handle to its conformer, not the
// conformer's value, so a protocol source is refused in both the argument and
// dot-receiver spellings. A concrete leaf names the downcast that reads the
// conformer out; a set destination answers in the terms it decides by,
// membership.
#import "modules/std.sx";

Boxed :: protocol vtable { name :: (self: *Self) -> string; }

Round :: struct { s: string = "round"; }
impl Boxed for Round { name :: (self: *Round) -> string => self.s; }

// A multi-word conformer: the refusal reads the static protocol type, not the
// layout.
Wide :: struct { a: i64 = 0; b: i64 = 0; }
impl Boxed for Wide { name :: (self: *Wide) -> string => "wide"; }

View :: @OpenSet(.{ max = 128 }) { render :: (self: *Self) -> string; }

Label :: @OpenVariant(View) {
    text: string = "";
    render :: (self: *Label) -> string => self.text;
}

form_Round :: ufcs (value: $I/@Init(Round)) {
    slot: Round = ---;
    value.write(*slot);
    print("Round {}\n", slot.s);
}

form_opt_Round :: ufcs (value: $I/@Init(?Round)) {
    slot: ?Round = ---;
    value.write(*slot);
    print("?Round {}\n", slot!.s);
}

form_View :: ufcs (value: $I/@Init(View)) {
    slot: View = ---;
    value.write(*slot);
    print("View {}\n", slot.render());
}

form_opt_View :: ufcs (value: $I/@Init(?View)) {
    slot: ?View = ---;
    value.write(*slot);
    print("?View {}\n", slot!.render());
}

form_Wide :: ufcs (value: $I/@Init(Wide)) {
    slot: Wide = ---;
    value.write(*slot);
    print("Wide {}\n", slot.a);
}

main :: () -> i32 {
    b := Round{ s = "vtable" }.(Boxed, context.allocator);
    x := Wide{ a = 1, b = 2 }.(Boxed, context.allocator);

    form_Round(b);
    b.form_Round();
    form_View(b);
    b.form_View();
    form_opt_Round(b);
    b.form_opt_Round();
    form_opt_View(b);
    b.form_opt_View();

    form_Wide(x);
    x.form_Wide();
    0
}
