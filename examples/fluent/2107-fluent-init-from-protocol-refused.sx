// Ordinary modeled conversions compose from a handle source. At an
// unmodeled concrete leaf, the source is a handle to its conformer, not the
// conformer's value, so a handle source is refused in both the argument and
// dot-receiver spellings. A concrete leaf names the downcast that reads the
// conformer out; a set destination answers in the terms it decides by,
// membership.
@import "modules/std.sx";

Boxed :: interface { name :: (self: *Self) -> string; }

Round :: struct { s: string = "round"; }
impl Boxed for Round { name :: (self: *Round) -> string => self.s; }

// A multi-word conformer: the refusal reads the static protocol type, not the
// layout.
Wide :: struct { a: i64 = 0; b: i64 = 0; }
impl Boxed for Wide { name :: (self: *Wide) -> string => "wide"; }

View :: @OpenSet(.{ max = 128 }) { render :: (self: *Self) -> string; }

Label :: @OpenVariant(View) {
    text: string = "";
    render :: (self: *Label) -> string => self.text;
}

formRound :: ufcs (value: $I/@Init(Round)) {
    slot: Round = ---;
    value.write(*slot);
    print("Round {}\n", slot.s);
}

formOptRound :: ufcs (value: $I/@Init(?Round)) {
    slot: ?Round = ---;
    value.write(*slot);
    print("?Round {}\n", slot?!.s);
}

formView :: ufcs (value: $I/@Init(View)) {
    slot: View = ---;
    value.write(*slot);
    print("View {}\n", slot.render());
}

formOptView :: ufcs (value: $I/@Init(?View)) {
    slot: ?View = ---;
    value.write(*slot);
    print("?View {}\n", slot?!.render());
}

formWide :: ufcs (value: $I/@Init(Wide)) {
    slot: Wide = ---;
    value.write(*slot);
    print("Wide {}\n", slot.a);
}

main :: () -> i32 {
    r := Round{ s = "vtable" };
    b := r.(Boxed);
    w := Wide{ a = 1, b = 2 };
    x := w.(Boxed);

    formRound(b);
    b.formRound();
    formView(b);
    b.formView();
    formOptRound(b);
    b.formOptRound();
    formOptView(b);
    b.formOptView();

    formWide(x);
    x.formWide();
    0
}
