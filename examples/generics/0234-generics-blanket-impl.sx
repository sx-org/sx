// A BLANKET parameterized impl — one whose protocol type arguments are the
// impl's own binders (specs: Generic bounds).
//
// `impl Series($T) for Buffer($T)` cannot be keyed by a concrete argument
// tuple, since the arguments it writes are binders no request ever spells. It
// is registered under the protocol name and matched at the use site, where the
// request's own arguments and the source instantiation's bindings decide.
//
// Lookup is a specificity rule: a concrete impl answers first, and a blanket
// impl only when nothing concrete matches. `Cell` below proves the concrete
// arm still wins for its own instantiation.
#import "modules/std.sx";

Series :: protocol(T: Type) constraint {
    count :: (self: *Self) -> i64;
}

Buffer :: struct($T: Type) { n: i64; }

// Covers EVERY instantiation of `Buffer`.
impl Series($T) for Buffer($T) {
    count :: (self: *Buffer) -> i64 { self.n }
}

// A concrete impl of the same protocol family for an unrelated carrier.
Cell :: struct { v: i64 = 0; }
impl Series(i64) for Cell {
    count :: (self: *Cell) -> i64 { self.v * 10 }
}

// The bound is satisfied through whichever impl matches.
tally :: (b: $B/Series(i64)) -> i64 { b.count() }

// A second instantiation of the same template, at a different argument.
tally_f32 :: (b: $B/Series(f32)) -> i64 { b.count() }

main :: () -> i32 {
    print("{}\n", tally(Buffer(i64){ n = 7 }));
    print("{}\n", tally(Cell{ v = 3 }));
    print("{}\n", tally_f32(Buffer(f32){ n = 9 }));
    0
}
