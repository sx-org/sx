// A generic method taking a slice (`xs: []$T`) binds `T` through method-call
// syntax (`b.take(a)`), through the explicit `Box.take(*b, a)` form, and
// through the same signature on a free function. Each element type
// monomorphizes independently.
//
// The receiver-prepended call site installs no bindings when
// `resolveCallParamTypes` gives each arg a target type, so `[]$T` must not
// resolve to `[]unresolved` — no runtime value can ever have one.

@import "modules/std.sx";

Box :: struct {
    n: i64;

    take :: (self: *Box, xs: []$T) -> i64 {
        print("take {}\n", xs.len);
        xs.len
    }

    first :: (self: *Box, xs: []$T) -> T {
        xs[0]
    }
}

free_take :: (n: *i64, xs: []$T) -> i64 { xs.len }

main :: () -> i64 {
    b := Box{ n = 1 };
    a : [4]i64 = .[10, 20, 30, 40];

    print("{}\n", Box.take(*b, a));   // explicit form
    print("{}\n", b.take(a));         // method syntax

    // `T` binds to the element type, not just to the slice's length.
    print("{}\n", b.first(a));        // 10

    // A second element type monomorphizes independently.
    f : [2]f32 = .[1.5, 2.5];
    print("{}\n", b.first(f));        // 1.5

    v : i64 = 0;
    print("{}\n", free_take(*v, a));

    s : []i64 = a;
    print("{}\n", s);

    return 0;
}
