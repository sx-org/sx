// A generic type CONSTRUCTOR applied to arguments — `Box(f64)`, `Box(V)` —
// is a type wherever a type is read, including the value grammar of an
// argument slot: the type position parses the spelling as a parameterized
// type, an argument slot parses the same text as a call, and both name the
// same instantiation. So a `$T: Type` parameter binds from it (directly and
// through ufcs), and the constructor is a first-class Type value.
//
// The receiver side of the same shape: `hold(...)` returns a VALUE, so a
// method call on its result is an ordinary method call — never a type
// instantiation over its arguments.
@import "modules/std.sx";
@import "modules/std/mem.sx";

Box :: struct ($V: Type) {
    inner: V;
    tag: i64 = 0;
    retag :: (self: Box(V), t: i64) -> Box(V) { b := self; b.tag = t; b }
}

Point :: struct { x: f64; y: f64; }

hold :: (v: $V) -> Box(V) { Box(V){ inner = v, tag = 0 } }

// The constructor reaches a `$T: Type` slot from inside a generic body too,
// where its argument is the enclosing function's own type parameter.
boxed_size :: (v: $V) -> i64 { @sizeOf(Box(V)) }

new_box :: (v: $V) -> *Box(V) {
    p := context.allocator.create(Box(V));
    p.inner = v;
    p.tag = 7;
    p
}

main :: () {
    // A `$T: Type` parameter binds from the constructor call.
    p := context.allocator.create(Box(f64));
    p.inner = 2.5;
    p.tag = 1;
    print("{} {}\n", p.inner, p.tag);

    // …and as a first-class Type value.
    t : Type = Box(f64);
    print("{} {}\n", t == Box(f64), @sizeOf(Box(f64)));

    // Inside a generic body, over the body's own parameter.
    q := new_box(Point{ x = 1.0, y = 2.0 });
    print("{} {} {}\n", q.inner.x, q.tag, boxed_size(Point{ x = 0.0, y = 0.0 }));

    // A method on the result of a value-returning generic call.
    print("{}\n", hold(Point{ x = 3.0, y = 4.0 }).retag(9).tag);
}
