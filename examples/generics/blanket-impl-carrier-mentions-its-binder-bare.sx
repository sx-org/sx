// A blanket impl's carrier mentions a binder its type arguments introduced
// bare: `Buffer(T)` after `Series($T)`, and `V` beside a concrete `i64`.
@import "modules/std.sx";

Series :: constraint(T: Type) {
    count :: (self: *Self) -> i64;
    at    :: (self: *Self, i: i64) -> T;
}

Buffer :: struct($T: Type) { items: []T; }
impl Series($T) for Buffer(T) {
    count :: (self: *Buffer) -> i64 { self.items.len }
    at    :: (self: *Buffer, i: i64) -> $T { self.items[i] }
}

Map2 :: struct($K: Type, $V: Type) { n: i64; v: V; }
impl Series($V) for Map2(i64, V) {
    count :: (self: *Map2) -> i64 { self.n }
    at    :: (self: *Map2, i: i64) -> $V { self.v }
}

last  :: (s: $S/Series(i64)) -> i64 { s.at(s.count() - 1) }
lastF :: (s: $S/Series(f32)) -> f32 { s.at(s.count() - 1) }

main :: () -> i32 {
    xs : [3]i64 = .[1, 2, 3];
    fs : [2]f32 = .[1.5, 2.5];
    print("{}\n", last(Buffer(i64){ items = xs[..] }));
    print("{}\n", lastF(Buffer(f32){ items = fs[..] }));
    print("{}\n", lastF(Map2(i64, f32){ n = 4, v = 0.5 }));
    0
}
