// An instantiation spelling is legal wherever a type is expected, including a
// type-switch arm (`case Buffer(f32):`, nested `case Buffer(Buffer(f32)):`) and
// a type-value comparison (`@typeOf(x) == Buffer(f32)`). An arm that names a
// DIFFERENT instantiation of the same template does not match.
@import "modules/std.sx";

Series :: interface(T: Type) { count :: (self: *Self) -> i64; }

Buffer :: struct($T: Type) { n: i64; }
impl Series($T) for Buffer($T) { count :: (self: *Buffer) -> i64 { self.n } }

open :: (s: Series(f32)) {
    match s {
        case Buffer(f32): |x| { print("f32 arm {}\n", x.n); }
    }
}

main :: () {
    buf := Buffer(f32){ n = 7 };
    a := buf.(Series(f32));
    open(a);
    //stdout: f32 arm 7

    // Comparison position: identity of the interned instantiation.
    print("{} {}\n", @typeOf(a) == Buffer(f32), @typeOf(a) == Buffer(i64));
    //stdout: true false

    // An `any` subject dispatches on the same tag; the i64 arm is live here and
    // does not claim an f32 value.
    v : any = Buffer(f32){ n = 3 };
    match v {
        case Buffer(i64): |x| { print("i64 arm {}\n", x.n); }
        case Buffer(f32): |x| { print("f32 arm {}\n", x.n); }
        else: { print("no arm\n"); }
    }
    //stdout: f32 arm 3

    w : any = Buffer(i64){ n = 4 };
    match w {
        case Buffer(f32): |x| { print("f32 arm {}\n", x.n); }
        else: { print("no f32 arm\n"); }
    }
    //stdout: no f32 arm

    // Nested instantiation in arm and compare position.
    z : any = Buffer(Buffer(f32)){ n = 9 };
    match z {
        case Buffer(Buffer(f32)): |x| { print("nested {}\n", x.n); }
        else: { print("nested miss\n"); }
    }
    //stdout: nested 9

    print("{}\n", @typeOf(z) == Buffer(Buffer(f32)));
    //stdout: true
}
