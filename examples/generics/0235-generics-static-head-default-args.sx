// A generic-struct STATIC-method head — `Box(i64).make()` — expands the
// omitted trailing defaults of its callee. The head carries no receiver and no
// type-decl slot, so a parameter index IS an argument index there.

@import "modules/std.sx";
@import "modules/std/mem.sx";

Box :: struct ($T: Type) {
    v: T;

    make :: (y: i64 = 7) -> i64 { y }

    sized :: (n: i64, alloc: Allocator = context.allocator, site: @SourceSite = @caller) -> i64 {
        raw := alloc.alloc_bytes(n * @sizeOf(T));
        if raw == null { @panic("sized allocation failed", site); }
        alloc.dealloc_bytes(raw);
        n
    }

    bump :: (self: *Box(T), k: i64 = 5) -> i64 { self.v.(i64) + k }
}

Plain :: struct {
    make :: (y: i64 = 11) -> i64 { y }
}

scaled :: ($T: Type, x: T, k: i64 = 3) -> i64 { x.(i64) * k }

main :: () {
    print("static:   {} {}\n", Box(i64).make(), Box(i64).make(9));
    print("sized:    {} {}\n", Box(i64).sized(4), Box(i64).sized(6, context.allocator, @SourceSite{}));
    print("plain:    {} {}\n", Plain.make(), Plain.make(13));

    b := Box(i64){ v = 1 };
    print("instance: {} {}\n", b.bump(), b.bump(2));
    print("free:     {} {}\n", scaled(i64, 7), scaled(i64, 7, 2));
}
