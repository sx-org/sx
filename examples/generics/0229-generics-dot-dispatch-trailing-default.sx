// Trailing parameter defaults expand for a GENERIC callee reached through
// dot-dispatch — both the ufcs form (`xs.release()`) and a generic method on
// a struct (`b.bump(x)`). The value-arg list of a generic dot-call skips the
// declaration's type-decl slots, so each omitted slot is filled by parameter
// index, not argument index.

@import "modules/std.sx";
@import "modules/std/mem.sx";
..mem;

Tracker :: struct {
    allocs: i64;
    deallocs: i64;
}
impl Allocator for Tracker {
    allocBytes :: (self: *Tracker, size: i64) -> *void {
        self.allocs += 1;
        c.malloc(size)
    }
    deallocBytes :: (self: *Tracker, ptr: *void) {
        self.deallocs += 1;
        c.free(ptr);
    }
}

release :: ufcs (xs: []$T, a: Allocator = context.allocator) {
    a.free(xs);
}

// A default that owes nothing to the context: it pins the general mechanism
// rather than the `context.allocator` path.
headScaled :: ufcs (xs: []$T, k: i64 = 3) -> i64 {
    xs[0] * k
}

Box :: struct {
    base: i64;

    bump :: (self: *Box, x: $T, k: i64 = 5) -> i64 { self.base + k }
}

main :: () {
    t := Tracker{ allocs = 0, deallocs = 0 };
    // Counts are read inside the push and printed after it: `print` itself
    // allocates through the current context allocator.
    dfltA : i64 = 0; dfltD : i64 = 0;
    explA : i64 = 0; explD : i64 = 0;
    push .{ allocator = t } {
        // Defaulted spelling: the allocator arrives through the default.
        xs := context.allocator.alloc(i64, 3);
        xs.release();
        dfltA = t.allocs; dfltD = t.deallocs;

        // Explicit spelling: the same call with the allocator written out.
        ys := context.allocator.alloc(i64, 3);
        ys.release(context.allocator);
        explA = t.allocs - dfltA; explD = t.deallocs - dfltD;
    }
    print("defaulted: {}/{}\n", dfltA, dfltD);
    print("explicit:  {}/{}\n", explA, explD);

    zs := context.allocator.alloc(i64, 2);
    zs[0] = 7;
    zs[1] = 9;
    print("scaled: {} {} {}\n", zs.headScaled(), zs.headScaled(3), zs.headScaled(2));

    b := Box{ base = 1 };
    print("bump: {} {} {}\n", b.bump(zs), b.bump(zs, 5), b.bump(zs, 2));

    context.allocator.free(zs);
}
