// A more-specific UFCS receiver overload wins over a fully-generic one
// (`*Box($T)` beats `*$T`), and call planning agrees with lowering on which
// overload is dispatched — planner and lowering share one receiver-aware,
// pointer-peeling selection, and specificity is ordered rather than boolean.
@import "modules/std.sx";
@import "0218-generics-ufcs-receiver-specificity/0218-shared.sx";
@import "0218-generics-ufcs-receiver-specificity/anyref.sx";

// More-specific receiver than the imported `pick(x: *$T)`.
pick :: ufcs (b: *Box($T)) -> i64 { return 7; }

// Generic passthrough — its result type is the PLANNED type of its argument.
echo :: (x: $U) -> $U { return x; }

main :: () -> i64 {
    b : Box(i64) = ---; b.v = 0;
    r := echo((*b).pick());   // *Box wins → i64 7; the plan types it the same
    print("r: {}\n", r);
    return 0;
}
