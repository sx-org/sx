// Monomorph keys are built in dynamic storage — a base and type
// arguments whose mangled key runs well past 256 bytes stay distinct all
// the way to the last byte. Both authors' long spelling is identical, so only
// the full key separates them.
@import "modules/std.sx";
a :: @import "0227-generics-long-mono-key/a.sx";
b :: @import "0227-generics-long-mono-key/b.sx";

VeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes :: struct($T: Type) { value: T; }

sizer :: (v: $T) -> i64 { return @sizeOf(T); }

report :: (label: string, ok: bool) {
    if ok { print("{}: ok\n", label); } else { print("{}: FAIL\n", label); }
}

main :: () -> i32 {
    wa : VeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes(a.VeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes) = .{ value = a.make() };
    wb : VeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes(b.VeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes) = .{ value = b.make() };
    report("long template key", @sizeOf(VeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes(a.VeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes)) == 8 and @sizeOf(VeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongGenericTemplateNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes(b.VeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytesVeryLongNominalTypeNameWhoseMangledMonomorphKeyRunsPastTwoHundredAndFiftySixBytes)) == 24);
