// A param-impl SOURCE pattern whose concrete `*Box` leaf is NESTED inside an inner
// parameterized form that itself carries unbound pack parts
// (`Closure(*Box, ..$inner) -> $IR`).
//
// `walkConcreteSigArgs` SKIPS a direct arg that has an unbound part instead of
// RECURSING into it, so the nested concrete `*Box` leaf is never ambiguity-checked:
// `impl ... for Closure(Closure(*Box, ..)->.., ..)->..` compiles rc=0 while the
// DIRECT `Closure(*Box, ..)` form (0829) errors. Both leaves resolve silently
// through the no-author wrapper path (`type_bridge.resolveTemplateSignatureType`,
// global last-wins), so this program exits 0 with NO diagnostic.
//
// TARGET: the whole-AST resolver walks EVERY reference position, nested
// parameterized-pattern leaves included, so the nested `Box` is ambiguity-checked
// like any other reference and the build emits "type 'Box' is ambiguous" and exits
// 1. A resolver that resolves every reference position has no notion of "skip a
// nested arg with an unbound sibling", so the hole cannot exist. The target's exact
// bytes are stated as a spec in
// ../expected/e6br5-nested-pack-source-ambiguous.target.md.

#import "modules/std.sx";
#import "e6br5-nested-pack-source-ambiguous/a.sx";
#import "e6br5-nested-pack-source-ambiguous/b.sx";

Block :: struct { tag: i32; }

Sink :: protocol(T: Type) {
    convert :: (self: Self) -> T;
}

impl Sink(Block) for Closure(Closure(*Box, ..$inner) -> $IR, ..$args) -> $R {
    convert :: (self: Closure(Closure(*Box, ..$inner) -> $IR, ..$args) -> $R) -> Block {
        .{ tag = 0 }
    }
}

main :: () -> i32 {
    0
}
