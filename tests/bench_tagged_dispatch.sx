// Tagged-vs-vtable canary. Runnable on demand:
//
//     ./zig-out/bin/sx build --opt 3 -o .sx-tmp/bench-tagged \
//         tests/bench_tagged_dispatch.sx && .sx-tmp/bench-tagged
//
// Three dispatch models over one shared array of concrete conformers:
//   tagged      — `protocol tagged`, a 2-word borrow, outlined switch.
//   vtable/own  — `protocol vtable`, value/own erasure.
//   vtable/id   — `protocol vtable #identity`, borrowing erasure.
//
// Two phases, measured separately:
//   BUILD — fill an array of protocol values from the conformers. The
//           value/own vtable value heap-copies its receiver through
//           `context.allocator` (and is freed per sample); the tagged value
//           writes 16 bytes in place; the identity value writes a 3-word
//           borrow in place (`free` refuses on it — there is no backing).
//   WALK  — sum a dispatched method over the array, repeatedly. Tagged calls
//           the outlined switch; both vtable models load the table and call
//           indirect.
//
// NOT a corpus example: it runs for seconds.

#import "modules/std.sx";
#import "modules/std/mem.sx";

N       : i64 : 20000;
WALKS   : i64 : 200;
SAMPLES : i64 : 5;

Tagged :: protocol tagged { area :: (self: *Self) -> i64; }
Vtab   :: protocol vtable { area :: (self: *Self) -> i64; }
VtabId :: protocol vtable #identity { area :: (self: *Self) -> i64; }

Sq  :: struct { s: i64; }
Rc  :: struct { w: i64; h: i64; }
Tri :: struct { b: i64; h: i64; }

impl Tagged for Sq  { area :: (self: *Sq) -> i64 { self.s * self.s } }
impl Tagged for Rc  { area :: (self: *Rc) -> i64 { self.w * self.h } }
impl Tagged for Tri { area :: (self: *Tri) -> i64 { self.b * self.h / 2 } }
impl Vtab   for Sq  { area :: (self: *Sq) -> i64 { self.s * self.s } }
impl Vtab   for Rc  { area :: (self: *Rc) -> i64 { self.w * self.h } }
impl Vtab   for Tri { area :: (self: *Tri) -> i64 { self.b * self.h / 2 } }
impl VtabId for Sq  { area :: (self: *Sq) -> i64 { self.s * self.s } }
impl VtabId for Rc  { area :: (self: *Rc) -> i64 { self.w * self.h } }
impl VtabId for Tri { area :: (self: *Tri) -> i64 { self.b * self.h / 2 } }

mono_ns :: () -> i64 {
    ts : time.Timespec = .{};
    c.clock_gettime(time.CLOCK_MONOTONIC, *ts);
    ts.sec * 1000000000 + ts.nsec
}

median :: (xs: []i64) -> i64 {
    i := 1;
    while i < xs.len {
        k := xs[i];
        j := i - 1;
        while j >= 0 and xs[j] > k { xs[j + 1] = xs[j]; j = j - 1; }
        xs[j + 1] = k;
        i = i + 1;
    }
    xs[xs.len / 2]
}

report :: (label: string, build_ns: i64, walk_ns: i64) {
    print("{}\tbuild {} ns\twalk {} ns\n", label, build_ns, walk_ns);
}

ratio :: (label: string, build_ns: i64, walk_ns: i64, base_build: i64, base_walk: i64) {
    print("{}\tbuild x{}.{}\twalk x{}.{}\n", label,
          build_ns / base_build, (build_ns * 10 / base_build) % 10,
          walk_ns / base_walk, (walk_ns * 10 / base_walk) % 10);
}

main :: () {
    sqs  := context.allocator.alloc(Sq, N);
    rcs  := context.allocator.alloc(Rc, N);
    tris := context.allocator.alloc(Tri, N);
    i := 0;
    while i < N {
        sqs[i]  = .{ s = i % 17 };
        rcs[i]  = .{ w = i % 13, h = 3 };
        tris[i] = .{ b = i % 11, h = 4 };
        i = i + 1;
    }

    tv := context.allocator.alloc(Tagged, N);
    vv := context.allocator.alloc(Vtab, N);
    iv := context.allocator.alloc(VtabId, N);

    tb := context.allocator.alloc(i64, SAMPLES);
    tw := context.allocator.alloc(i64, SAMPLES);
    vb := context.allocator.alloc(i64, SAMPLES);
    vw := context.allocator.alloc(i64, SAMPLES);
    ib := context.allocator.alloc(i64, SAMPLES);
    iw := context.allocator.alloc(i64, SAMPLES);

    tsink := 0;
    vsink := 0;
    isink := 0;
    s := 0;
    while s < SAMPLES {
        // ── tagged: build (borrows) ──
        t0 := mono_ns();
        i = 0;
        while i < N {
            m := i % 3;
            if m == 0 { tv[i] = sqs[i]; }
            else if m == 1 { tv[i] = rcs[i]; }
            else { tv[i] = tris[i]; }
            i = i + 1;
        }
        t1 := mono_ns();

        // ── tagged: walk (outlined switch) ──
        k := 0;
        while k < WALKS {
            i = 0;
            while i < N { tsink = tsink + tv[i].area(); i = i + 1; }
            k = k + 1;
        }
        t2 := mono_ns();

        // ── vtable/own: build (owning erasure, one heap copy each) ──
        i = 0;
        while i < N {
            m := i % 3;
            if m == 0 { vv[i] = sqs[i].(Vtab); }
            else if m == 1 { vv[i] = rcs[i].(Vtab); }
            else { vv[i] = tris[i].(Vtab); }
            i = i + 1;
        }
        t3 := mono_ns();

        // ── vtable/own: walk (table load + indirect call) ──
        k = 0;
        while k < WALKS {
            i = 0;
            while i < N { vsink = vsink + vv[i].area(); i = i + 1; }
            k = k + 1;
        }
        t4 := mono_ns();

        i = 0;
        while i < N { free(vv[i]); i = i + 1; }

        // ── vtable/id: build (identity erasure, borrows in place) ──
        t5 := mono_ns();
        i = 0;
        while i < N {
            m := i % 3;
            if m == 0 { iv[i] = sqs[i]; }
            else if m == 1 { iv[i] = rcs[i]; }
            else { iv[i] = tris[i]; }
            i = i + 1;
        }
        t6 := mono_ns();

        // ── vtable/id: walk (table load + indirect call) ──
        k = 0;
        while k < WALKS {
            i = 0;
            while i < N { isink = isink + iv[i].area(); i = i + 1; }
            k = k + 1;
        }
        t7 := mono_ns();

        tb[s] = t1 - t0;
        tw[s] = t2 - t1;
        vb[s] = t3 - t2;
        vw[s] = t4 - t3;
        ib[s] = t6 - t5;
        iw[s] = t7 - t6;
        s = s + 1;
    }

    tbm := median(tb);
    twm := median(tw);
    vbm := median(vb);
    vwm := median(vw);
    ibm := median(ib);
    iwm := median(iw);
    report("tagged    ", tbm, twm);
    report("vtable/own", vbm, vwm);
    report("vtable/id ", ibm, iwm);
    ratio("own/tagged", vbm, vwm, tbm, twm);
    ratio("id/tagged ", ibm, iwm, tbm, twm);
    // Same conformers, same walks: a checksum divergence means one model
    // dispatched a wrong body.
    if tsink != vsink or tsink != isink {
        print("CHECKSUM MISMATCH tagged {} vtable/own {} vtable/id {}\n", tsink, vsink, isink);
        c.exit(1);
    }
    print("checksum {} (all three models agree)\n", tsink % 1000);
}
