b00 : B00 = .{};
b01 : B01 = .{};
b02 : B02 = .{};
b03 : B03 = .{};
b04 : B04 = .{};
b05 : B05 = .{};
b06 : B06 = .{};
b07 : B07 = .{};
b08 : B08 = .{};
b09 : B09 = .{};
b10 : B10 = .{};
b11 : B11 = .{};
b12 : B12 = .{};
b13 : B13 = .{};
b14 : B14 = .{};
b15 : B15 = .{};
b16 : B16 = .{};
b17 : B17 = .{};
b18 : B18 = .{};
b19 : B19 = .{};

// The handle array every interleaved lane dispatches through: 20 borrows of
// 20 named conformers, erased once, read back per iteration.
fill_handles :: (h: []Allocator, slabs: [*]u8) {
    b00.base = *slabs[0 * SLAB]; b00.cap = SLAB - 64; h[0] = *b00;
    b01.base = *slabs[1 * SLAB]; b01.cap = SLAB - 64; h[1] = *b01;
    b02.base = *slabs[2 * SLAB]; b02.cap = SLAB - 64; h[2] = *b02;
    b03.base = *slabs[3 * SLAB]; b03.cap = SLAB - 64; h[3] = *b03;
    b04.base = *slabs[4 * SLAB]; b04.cap = SLAB - 64; h[4] = *b04;
    b05.base = *slabs[5 * SLAB]; b05.cap = SLAB - 64; h[5] = *b05;
    b06.base = *slabs[6 * SLAB]; b06.cap = SLAB - 64; h[6] = *b06;
    b07.base = *slabs[7 * SLAB]; b07.cap = SLAB - 64; h[7] = *b07;
    b08.base = *slabs[8 * SLAB]; b08.cap = SLAB - 64; h[8] = *b08;
    b09.base = *slabs[9 * SLAB]; b09.cap = SLAB - 64; h[9] = *b09;
    b10.base = *slabs[10 * SLAB]; b10.cap = SLAB - 64; h[10] = *b10;
    b11.base = *slabs[11 * SLAB]; b11.cap = SLAB - 64; h[11] = *b11;
    b12.base = *slabs[12 * SLAB]; b12.cap = SLAB - 64; h[12] = *b12;
    b13.base = *slabs[13 * SLAB]; b13.cap = SLAB - 64; h[13] = *b13;
    b14.base = *slabs[14 * SLAB]; b14.cap = SLAB - 64; h[14] = *b14;
    b15.base = *slabs[15 * SLAB]; b15.cap = SLAB - 64; h[15] = *b15;
    b16.base = *slabs[16 * SLAB]; b16.cap = SLAB - 64; h[16] = *b16;
    b17.base = *slabs[17 * SLAB]; b17.cap = SLAB - 64; h[17] = *b17;
    b18.base = *slabs[18 * SLAB]; b18.cap = SLAB - 64; h[18] = *b18;
    b19.base = *slabs[19 * SLAB]; b19.cap = SLAB - 64; h[19] = *b19;
}

// ── The pointer-shaped Context field ─────────────────────────────────────
//
// A second capability slot carrying `*Allocator` rather than `Allocator`.
// Nothing in the compiler is involved: `@contextExtend` takes the field
// type it is given, and `context.ap.method()` auto-derefs the handle, so
// this is a shape a stdlib may pick on its own.
//
// The default target is a named global handle, which is what a `*Allocator`
// field can point at in a static initializer.
ap_default : Allocator = b00;
@contextExtend ap: *Allocator = *ap_default;

// ── Lanes ────────────────────────────────────────────────────────────────

direct_lane :: (arena: *Arena) -> i64 {
    t0 := mono_ns();
    sink := 0;
    i := 0;
    while i < ALLOCS {
        p := arena.alloc_bytes(16);
        b : [*]u8 = xx p;
        b[0] = xx (i % 251);
        sink = sink + b[0];
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

borrow_lane :: (arena: *Arena) -> i64 {
    a : Allocator = arena;
    t0 := mono_ns();
    sink := 0;
    i := 0;
    while i < ALLOCS {
        p := a.alloc_bytes(16);
        b : [*]u8 = xx p;
        b[0] = xx (i % 251);
        sink = sink + b[0];
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

ctx_lane :: (arena: *Arena) -> i64 {
    push .{ allocator = arena } {
        t0 := mono_ns();
        sink := 0;
        i := 0;
        while i < ALLOCS {
            p := context.allocator.alloc_bytes(16);
            b : [*]u8 = xx p;
            b[0] = xx (i % 251);
            sink = sink + b[0];
            i = i + 1;
        }
        el := mono_ns() - t0;
        checksum = checksum + sink;
        return el;
    }
}

default_lane :: () -> i64 {
    t0 := mono_ns();
    sink := 0;
    i := 0;
    while i < ALLOCS {
        p := context.allocator.alloc_bytes(16);
        b : [*]u8 = xx p;
        b[0] = xx (i % 251);
        sink = sink + b[0];
        escaped = p;
        context.allocator.dealloc_bytes(p);
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

// The receiver changes per allocation, in the order the runtime-filled index
// stream dictates. `h.len` is 20 or 2 — the same loop measures both, so the
// only difference between the two interleaved lanes is the switch's width.
interleaved_lane :: (h: []Allocator, idx: []i64) -> i64 {
    t0 := mono_ns();
    sink := 0;
    i := 0;
    while i < ALLOCS {
        p := h[idx[i & IDXMASK]].alloc_bytes(16);
        b : [*]u8 = xx p;
        b[0] = xx (i % 251);
        sink = sink + b[0];
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

// The same 20 receivers, walked in a fixed rotation: the switch is as wide as
// the interleaved lane's, the sequence is perfectly predictable.
rotate_lane :: (h: []Allocator) -> i64 {
    t0 := mono_ns();
    sink := 0;
    i := 0;
    k := 0;
    while i < ALLOCS {
        p := h[k].alloc_bytes(16);
        b : [*]u8 = xx p;
        b[0] = xx (i % 251);
        sink = sink + b[0];
        k = k + 1;
        if k == NCONF { k = 0; }
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

// The pointer-field anchor: one conformer, reached as `context.ap`. Against
// the CTX lane this is exactly the cost of the extra dependent load.
ctx_ptr_lane :: (arena: *Arena) -> i64 {
    ah : Allocator = arena;
    push .{ ap = *ah } {
        t0 := mono_ns();
        sink := 0;
        i := 0;
        while i < ALLOCS {
            p := context.ap.alloc_bytes(16);
            b : [*]u8 = xx p;
            b[0] = xx (i % 251);
            sink = sink + b[0];
            i = i + 1;
        }
        el := mono_ns() - t0;
        checksum = checksum + sink;
        return el;
    }
}

// The interleaved lanes' pointer twin. Cycling an array of `*Allocator` —
// rather than retargeting one Context field per iteration — is what isolates
// the indirection honestly: the dispatched-to set and the index stream are
// the same as `interleaved_lane`'s, and the only added work is the load of
// the pointer before the load of the handle.
interleaved_ptr_lane :: (ps: []*Allocator, idx: []i64) -> i64 {
    t0 := mono_ns();
    sink := 0;
    i := 0;
    while i < ALLOCS {
        p := ps[idx[i & IDXMASK]].alloc_bytes(16);
        b : [*]u8 = xx p;
        b[0] = xx (i % 251);
        sink = sink + b[0];
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

rotate_ptr_lane :: (ps: []*Allocator) -> i64 {
    t0 := mono_ns();
    sink := 0;
    i := 0;
    k := 0;
    while i < ALLOCS {
        p := ps[k].alloc_bytes(16);
        b : [*]u8 = xx p;
        b[0] = xx (i % 251);
        sink = sink + b[0];
        k = k + 1;
        if k == NCONF { k = 0; }
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

// `push` per allocation, overriding the handle field. A push copies the
// whole Context, so the pair below differs only in the width of the one
// field being written.
push_h16_lane :: (arena: *Arena) -> i64 {
    t0 := mono_ns();
    sink := 0;
    i := 0;
    while i < ALLOCS {
        push .{ allocator = arena } {
            p := context.allocator.alloc_bytes(16);
            b : [*]u8 = xx p;
            b[0] = xx (i % 251);
            sink = sink + b[0];
        }
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

push_ptr_lane :: (arena: *Arena) -> i64 {
    ah : Allocator = arena;
    t0 := mono_ns();
    sink := 0;
    i := 0;
    while i < ALLOCS {
        push .{ ap = *ah } {
            p := context.ap.alloc_bytes(16);
            b : [*]u8 = xx p;
            b[0] = xx (i % 251);
            sink = sink + b[0];
        }
        i = i + 1;
    }
    el := mono_ns() - t0;
    checksum = checksum + sink;
    el
}

main :: () {
    gpa := GPA.init();
    direct := context.allocator.alloc(i64, TRIALS);
    borrow := context.allocator.alloc(i64, TRIALS);
    ctx := context.allocator.alloc(i64, TRIALS);
    dflt := context.allocator.alloc(i64, TRIALS);
    in20 := context.allocator.alloc(i64, TRIALS);
    in2 := context.allocator.alloc(i64, TRIALS);
    rot := context.allocator.alloc(i64, TRIALS);
    ctxp := context.allocator.alloc(i64, TRIALS);
    in20p := context.allocator.alloc(i64, TRIALS);
    in2p := context.allocator.alloc(i64, TRIALS);
    rotp := context.allocator.alloc(i64, TRIALS);
    push16 := context.allocator.alloc(i64, TRIALS);
    pushp := context.allocator.alloc(i64, TRIALS);

    // The 20 slabs, the 20 handles, and the two index streams. The streams
    // are filled here, at runtime, from the xorshift — the lane sees only a
    // heap array whose contents no pass can fold.
    slabs := context.allocator.alloc(u8, NCONF * SLAB);
    handles := context.allocator.alloc(Allocator, NCONF);
    fill_handles(handles, slabs.ptr);
    pair := context.allocator.alloc(Allocator, 2);
    pair[0] = *b00;
    pair[1] = *b01;

    // The same handles, reached one pointer further out.
    hptr := context.allocator.alloc(*Allocator, NCONF);
    pptr := context.allocator.alloc(*Allocator, 2);
    k := 0;
    while k < NCONF {
        hptr[k] = *handles[k];
        k = k + 1;
    }
    pptr[0] = *pair[0];
    pptr[1] = *pair[1];

    rng : Rng = .{ s = SEED };
    idx20 := context.allocator.alloc(i64, IDXN);
    idx2 := context.allocator.alloc(i64, IDXN);
    j := 0;
    while j < IDXN {
        idx20[j] = rng.next() % NCONF;
        idx2[j] = rng.next() % 2;
        j = j + 1;
    }

    t := 0;
    while t < TRIALS {
        arena := Arena.init(gpa, CHUNK);
        direct[t] = direct_lane(*arena);
        arena.reset();
        borrow[t] = borrow_lane(*arena);
        arena.reset();
        ctx[t] = ctx_lane(*arena);
        arena.deinit();
        dflt[t] = default_lane();
        in20[t] = interleaved_lane(handles, idx20);
        in2[t] = interleaved_lane(pair, idx2);
        rot[t] = rotate_lane(handles);

        arena2 := Arena.init(gpa, CHUNK);
        ctxp[t] = ctx_ptr_lane(*arena2);
        arena2.reset();
        push16[t] = push_h16_lane(*arena2);
        arena2.reset();
        pushp[t] = push_ptr_lane(*arena2);
        arena2.deinit();
        in20p[t] = interleaved_ptr_lane(hptr, idx20);
        in2p[t] = interleaved_ptr_lane(pptr, idx2);
        rotp[t] = rotate_ptr_lane(hptr);
        t = t + 1;
    }

    report("direct  ", direct);
    report("borrow  ", borrow);
    report("ctx     ", ctx);
    report("default ", dflt);
    report("inter20 ", in20);
    report("inter2  ", in2);
    report("rotate20", rot);
    report("ctx*    ", ctxp);
    report("inter20*", in20p);
    report("inter2* ", in2p);
    report("rotate2*", rotp);
    report("push    ", push16);
    report("push*   ", pushp);
    dm := direct[direct.len / 2];
    bm := borrow[borrow.len / 2];
    cm := ctx[ctx.len / 2];
    print("borrow/direct x{}.{}\tctx/direct x{}.{}\n",
          bm / dm, (bm * 100 / dm) % 100, cm / dm, (cm * 100 / dm) % 100);
    print("checksum {}\n", checksum);
    // The conformers' own counters escape too, so no arm's bookkeeping can be
    // optimized away as dead.
    print("bookkeeping {}\n", b00.n + b01.n + b09.n + b19.n);
}
