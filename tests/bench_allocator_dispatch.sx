// The `Allocator` interface's dispatch cost, on demand:
//
//     ./zig-out/bin/sx build --opt 3 -o .sx-tmp/bench-alloc \
//         tests/bench_allocator_dispatch.sx && .sx-tmp/bench-alloc
//
// Thirteen lanes over the same bump-allocation workload, so the dispatch's
// share of the cost is the difference between them.
//
// It measures the declaration std SHIPS — `Allocator :: interface`
// (std/core.sx).
//
// The first four lanes hold ONE conformer live per run — the predictable
// regime, where a dispatch has a single arm to select and the branch
// predictor pins it:
//   DIRECT  — `arena.alloc_bytes(n)` on the concrete receiver. No handle at
//             all: the floor a devirtualized dispatch can reach.
//   BORROW  — the same loop through a handle erased AT THE SITE, so the
//             receiver's conformer is statically known. Whether that fact
//             reaches the machine code is the whole question a
//             representation answers.
//   CTX     — the same loop under `push .{ allocator = arena }`, so every
//             allocation goes through `context.allocator`. The handle is
//             loaded from the pushed Context, so the receiver is dynamic —
//             this is the lane that measures a real dispatch.
//   DEFAULT — `context.allocator` as the program starts, i.e. the folded
//             default-context handle over `c_allocator`. Measures the
//             malloc/free round trip through the same handle shape.
//
// The next three are the ADVERSARIAL matrix: 20 named conformers (B00..B19,
// bump arenas with unequal bookkeeping so no two arms fold together) are
// erased into a handle array, and the lane picks a handle per allocation —
// an allocator population a call site cannot predict:
//   INTER20 — the handle index comes from a heap array filled at RUNTIME by
//             an xorshift stream. The order is data-dependent: invisible to
//             LLVM, unlearnable by the branch predictor. Measures
//             prediction failure ON TOP OF a wide switch.
//   INTER2  — the same shape over 2 conformers only, so the interleaving is
//             just as unpredictable but the switch is minimal. Isolates
//             prediction failure from switch WIDTH.
//   ROTATE20 — the same 20 conformers in a fixed rotation. The switch is
//             just as wide but the sequence is perfectly learnable.
//             Isolates switch width from prediction failure.
//
// The last six repeat that shape against a Context field that holds a
// POINTER to a handle (`@contextExtend ap: *Allocator`) instead of the
// handle itself — the field shape a stdlib could choose without any
// compiler change. Each `*`-suffixed lane pays exactly one extra dependent
// load before the same dispatch:
//   CTX*      — the single-conformer anchor through `context.ap`.
//   INTER20* / INTER2* / ROTATE20* — the adversarial three, cycling an
//             array of `*Allocator` rather than an array of handles, so the
//             indirection is the only difference from the lanes above.
//   PUSH / PUSH* — `push` INSIDE the loop, overriding the handle field and
//             the 8-byte pointer field respectively. A push copies the
//             whole Context either way; these two isolate the width of the
//             overridden field's own store.
//
// 61 trials per lane, reported as median with the quartile spread, so a
// lane-to-lane comparison has a noise bound to be read against. Each lane
// TIMES ITSELF and `main` only collects: thirteen hot loops inlined into one
// driver blow past the inliner's budget, and the lane that stops being
// devirtualized is then an artifact of the harness, not of the language.
//
// NOT a corpus example: it runs for seconds.

@import "modules/std.sx";
@import "modules/std/mem.sx";

ALLOCS  : i64 : 2000000;
TRIALS  : i64 : 61;
CHUNK   : i64 : 1 << 20;

// The interleaved conformer set and its per-conformer slab.
NCONF   : i64 : 20;
SLAB    : i64 : 1 << 16;

// The pre-built index stream. A power of two so the lane's wrap is a mask,
// and long enough that no branch predictor holds the whole sequence.
IDXN    : i64 : 8192;
IDXMASK : i64 : 8191;

SEED    : i64 : 0x2545F4914F6CDD1D;

// Each lane folds its checksum in here rather than returning it, so the
// return value is the elapsed time and the loop still cannot be deleted.
checksum : i64 = 0;

// The default lane frees what it allocates, and an allocation whose pointer
// never leaves the loop is one LLVM is entitled to delete outright. Parking
// it in a global makes it escape, so the round trip is really executed.
escaped : *void = null;

// Deterministic xorshift64. It fills the index stream at RUNTIME, so the
// order the interleaved lanes dispatch in is a value LLVM cannot read.
Rng :: struct {
    s: i64 = 0;
    next :: (self: *Rng) -> i64 {
        x := self.s;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        self.s = x;
        return x & 0x7FFFFFFFFFFFFFFF;
    }
}

mono_ns :: () -> i64 {
    ts : time.Timespec = .{};
    c.clock_gettime(time.CLOCK_MONOTONIC, *ts);
    ts.sec * 1000000000 + ts.nsec
}

sort :: (xs: []i64) {
    i := 1;
    while i < xs.len {
        k := xs[i];
        j := i - 1;
        while j >= 0 and xs[j] > k { xs[j + 1] = xs[j]; j = j - 1; }
        xs[j + 1] = k;
        i = i + 1;
    }
}

// Median plus the inter-quartile spread in per-mille of the median — the
// noise bound a lane-to-lane delta has to clear to mean anything.
report :: (label: string, xs: []i64) {
    sort(xs);
    med := xs[xs.len / 2];
    q1 := xs[xs.len / 4];
    q3 := xs[xs.len * 3 / 4];
    spread := if med > 0 then (q3 - q1) * 1000 / med else 0;
    print("{}\tmedian {} ns\tp25 {} ns\tp75 {} ns\tiqr {}/1000\tper-alloc {} ps\n",
          label, med, q1, q3, spread, med * 1000 / ALLOCS);
}

// ── The 20 interleaved conformers ────────────────────────────────────────
//
// Twenty bump arenas over twenty slabs. The alignment step cycles 8/16/32/64
// and the bookkeeping counter advances by a per-conformer amount, so every
// arm is a distinct body: nothing here folds two arms into one.

B00 :: struct {
    base: [*]u8 = null;
    off: i64 = 0;
    cap: i64 = 0;
    n: i64 = 0;
}
impl Allocator for B00 {
    alloc_bytes :: (self: *B00, size: i64) -> *void {
        self.n = self.n + 1;
        a := (size + 7) & (0 - 8);
        if self.off + a > self.cap { self.off = 0; }
        p := *self.base[self.off];
        self.off = self.off + a;
        return p;
    }
    dealloc_bytes :: (self: *B00, ptr: *void) { self.n = self.n - 1; }
}

