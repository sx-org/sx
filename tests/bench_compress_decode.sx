// One-shot std.zlib decoding benchmark.
//
// The encode executable writes the inputs consumed here. Every decoded result
// is checked outside the timed interval so a fast wrong decoder cannot pass.

@import "modules/std.sx";

BENCH_WARMUPS : i64 = 3;
BENCH_SAMPLES : i64 = 15;

monoNs :: () -> i64 {
    ts : time.Timespec = .{};
    if c.clock_gettime(time.CLOCK_MONOTONIC, @ts) != 0 { return -1; }
    ts.sec * 1000000000 + ts.nsec
}

artifactPath :: (label: string, level: i64) -> [:0]u8 {
    if label[0] == 'r' {
        if level == 1 { return ".sx-tmp/bench-compress/sx-repeat-1.zlib"; }
        if level == 6 { return ".sx-tmp/bench-compress/sx-repeat-6.zlib"; }
        return ".sx-tmp/bench-compress/sx-repeat-9.zlib";
    }
    if level == 1 { return ".sx-tmp/bench-compress/sx-random-1.zlib"; }
    if level == 6 { return ".sx-tmp/bench-compress/sx-random-6.zlib"; }
    ".sx-tmp/bench-compress/sx-random-9.zlib"
}

same :: (left: string, right: string) -> bool {
    if left.len != right.len { return false; }
    i := 0;
    while i < left.len {
        if left[i] != right[i] { return false; }
        i += 1;
    }
    true
}

medianSample :: (samples: *[15]i64) -> i64 {
    i := 1;
    while i < BENCH_SAMPLES {
        value := samples[i];
        j := i;
        while j > 0 and samples[j - 1] > value {
            samples[j] = samples[j - 1];
            j -= 1;
        }
        samples[j] = value;
        i += 1;
    }
    samples[BENCH_SAMPLES / 2]
}

runCase :: (label: string, data: string, level: i64, alloc: Allocator) -> bool {
    maybePacked := fs.readFile(artifactPath(label, level));
    if maybePacked == null { return false; }
    packed := maybePacked?!;

    warmup := 0;
    while warmup < BENCH_WARMUPS {
        plain := zlib.decode(packed, data.len, alloc) catch {
            context.allocator.deallocBytes(packed.ptr);
            return false;
        };
        ok := same(data, plain);
        alloc.deallocBytes(plain.ptr);
        if !ok {
            context.allocator.deallocBytes(packed.ptr);
            return false;
        }
        warmup += 1;
    }

    samples : [15]i64 = ---;
    run := 0;
    while run < BENCH_SAMPLES {
        started := monoNs();
        if started < 0 {
            context.allocator.deallocBytes(packed.ptr);
            return false;
        }
        plain := zlib.decode(packed, data.len, alloc) catch {
            context.allocator.deallocBytes(packed.ptr);
            return false;
        };
        finished := monoNs();
        if finished < started {
            alloc.deallocBytes(plain.ptr);
            context.allocator.deallocBytes(packed.ptr);
            return false;
        }
        samples[run] = finished - started;
        ok := same(data, plain);
        alloc.deallocBytes(plain.ptr);
        if !ok {
            context.allocator.deallocBytes(packed.ptr);
            return false;
        }
        run += 1;
    }
    decodeNs := medianSample(@samples);
    if decodeNs <= 0 {
        context.allocator.deallocBytes(packed.ptr);
        return false;
    }
    safeNs := if decodeNs > 0 then decodeNs else 1;
    ratioPermille := if data.len > 0 then packed.len * 1000 / data.len else 0;
    throughput := data.len * 1000000000 / 1024 / safeNs;
    print("{} level={} input={} packed={} ratio_permille={} decode_ns={} decode_KiB_s={}\n",
        label, level, data.len, packed.len, ratioPermille, decodeNs, throughput);
    context.allocator.deallocBytes(packed.ptr);
    true
}

runCorpora :: (data: string, alloc: Allocator) -> bool {
    i := 0;
    while i < data.len {
        data.ptr[i] = ('a' + ((i / 97 + i) % 11)).(u8);
        i += 1;
    }
    if !runCase("repetitive", data, 1, alloc) or
       !runCase("repetitive", data, 6, alloc) or
       !runCase("repetitive", data, 9, alloc) { return false; }

    state := 0x12345678;
    i = 0;
    while i < data.len {
        state = (state ^ (state << 13)) & 0xffffffff;
        state = state ^ (state >> 17);
        state = (state ^ (state << 5)) & 0xffffffff;
        data.ptr[i] = (state & 0xff).(u8);
        i += 1;
    }
    runCase("incompressible", data, 1, alloc) and
    runCase("incompressible", data, 6, alloc) and
    runCase("incompressible", data, 9, alloc)
}

main :: () -> i32 {
    gpa := mem.GPA.init();
    raw := gpa.allocBytes(1048576);
    if raw == null { return 1; }
    data := string{ ptr = xx raw, len = 1048576 };
    ok := runCorpora(data, gpa);
    gpa.deallocBytes(raw);
    if !ok or gpa.allocCount != 0 { return 1; }
    0
}
