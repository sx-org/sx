// Interface-dispatch canary. Runnable on demand:
//
//     ./zig-out/bin/sx build --opt 3 -o .sx-tmp/bench-protocol \
//         tests/bench_protocol_dispatch.sx && .sx-tmp/bench-protocol
//
// One shared array of concrete conformers, walked two ways:
//   handle — through `[]Shape`, a table load plus an indirect call per element.
//   direct — the same conformers by concrete type, the floor a devirtualized
//            dispatch can reach.
//
// The handle lane is measured in two phases:
//   BUILD — erase each conformer into the array. A handle borrows in place, so
//           this writes three words and allocates nothing.
//   WALK  — sum a dispatched method over the array, repeatedly.
//
// NOT a corpus example: it runs for seconds.

@import "modules/std.sx";
@import "modules/std/mem.sx";

N       : i64 : 20000;
WALKS   : i64 : 200;
SAMPLES : i64 : 5;

Shape :: interface { area :: (self: *Self) -> i64; }

Sq  :: struct { s: i64; }
Rc  :: struct { w: i64; h: i64; }
Tri :: struct { b: i64; h: i64; }

impl Shape for Sq  { area :: (self: *Sq) -> i64 { self.s * self.s } }
impl Shape for Rc  { area :: (self: *Rc) -> i64 { self.w * self.h } }
impl Shape for Tri { area :: (self: *Tri) -> i64 { self.b * self.h / 2 } }

monoNs :: () -> i64 {
    ts : time.Timespec = .{};
    c.clock_gettime(time.CLOCK_MONOTONIC, *ts);
    ts.sec * 1000000000 + ts.nsec
}

median :: (xs: []i64) -> i64 {
    i := 1;
    while i < xs.len {
        k := xs[i];
        j := i - 1;
        while j >= 0 and xs[j] > k { xs[j + 1] = xs[j]; j = j - 1; }
        xs[j + 1] = k;
        i = i + 1;
    }
    xs[xs.len / 2]
}

report :: (label: string, buildNs: i64, walkNs: i64) {
    print("{}\tbuild {} ns\twalk {} ns\n", label, buildNs, walkNs);
}

main :: () {
    sqs  := context.allocator.alloc(Sq, N);
    rcs  := context.allocator.alloc(Rc, N);
    tris := context.allocator.alloc(Tri, N);
    i := 0;
    while i < N {
        sqs[i]  = .{ s = i % 17 };
        rcs[i]  = .{ w = i % 13, h = 3 };
        tris[i] = .{ b = i % 11, h = 4 };
        i = i + 1;
    }

    hv := context.allocator.alloc(Shape, N);

    hb := context.allocator.alloc(i64, SAMPLES);
    hw := context.allocator.alloc(i64, SAMPLES);
    dw := context.allocator.alloc(i64, SAMPLES);

    hsink := 0;
    dsink := 0;
    s := 0;
    while s < SAMPLES {
        // ── handle: build (the handle borrows each conformer in place) ──
        t0 := monoNs();
        i = 0;
        while i < N {
            m := i % 3;
            if m == 0 { hv[i] = sqs[i]; }
            else if m == 1 { hv[i] = rcs[i]; }
            else { hv[i] = tris[i]; }
            i = i + 1;
        }
        t1 := monoNs();

        // ── handle: walk (table load + indirect call) ──
        k := 0;
        while k < WALKS {
            i = 0;
            while i < N { hsink = hsink + hv[i].area(); i = i + 1; }
            k = k + 1;
        }
        t2 := monoNs();

        // ── direct: the same conformers, same order, no handle ──
        k = 0;
        while k < WALKS {
            i = 0;
            while i < N {
                m := i % 3;
                if m == 0 { dsink = dsink + sqs[i].area(); }
                else if m == 1 { dsink = dsink + rcs[i].area(); }
                else { dsink = dsink + tris[i].area(); }
                i = i + 1;
            }
            k = k + 1;
        }
        t3 := monoNs();

        hb[s] = t1 - t0;
        hw[s] = t2 - t1;
        dw[s] = t3 - t2;
        s = s + 1;
    }

    hbm := median(hb);
    hwm := median(hw);
    dwm := median(dw);
    report("handle", hbm, hwm);
    report("direct", 0, dwm);
    print("handle/direct\twalk x{}.{}\n", hwm / dwm, (hwm * 10 / dwm) % 10);
    // Same conformers, same walks: a checksum divergence means one lane
    // dispatched a wrong body.
    if hsink != dsink {
        print("CHECKSUM MISMATCH handle {} direct {}\n", hsink, dsink);
        c.exit(1);
    }
    print("checksum {} (both lanes agree)\n", hsink % 1000);
}
