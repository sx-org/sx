// A private field cannot be named from another file: a foreign write and a
// foreign named literal both fail.

facade :: #import "foreign-private-field-naming/facade.sx";

main :: () -> i32 {
    wrapped := facade.Wrapper.init(1);
    wrapped.state.value = 2;
    forged : facade.Wrapper = .{ state = .{ value = 3 } };
    if wrapped.get() != 2 { return 1; }
    if forged.get() != 3 { return 2; }
    0
}
