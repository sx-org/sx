@import "modules/std.sx";

Pair :: struct { a: i64; b: i64; }

g :: () {}

main :: () {
    positional := Pair{ g(), 2 };
    named := Pair{ a = g(), b = 2 };
    contextual : Pair = .{ g(), 2 };
    array : [2]i64 = .{ 1, g() };
    _ = positional;
    _ = named;
    _ = contextual;
    _ = array;
}
