#import "modules/std.sx";

remainder :: (n: i64) -> f64 {
    e := n;
    while e > 22 { e -= 22; }
    e
}

stepped :: (n: i64) -> f32 {
    e := n;
    while e > 'A' and e < 1000 { e -= 22; }
    e
}

range_sum :: () -> f64 {
    s := 0;
    for i in 0..5 { s += i; }
    for i in 1..=3 { s += i; }
    for 0..2 { s += 100; }
    s
}

wide_bound :: () -> f64 {
    last := 0;
    for i in 9007199254740993..9007199254740995 { last = i; }
    last
}

range_from_float_bounds :: (lo: f64, hi: f64) -> i64 {
    sum := 0;
    for i in (lo.(i64))..(hi.(i64)) { sum += i; }
    sum
}

main :: () {
    print("{}\n", remainder(50));
    print("{}\n", stepped(200));
    print("{}\n", range_sum());
    print("{}\n", wide_bound());
    print("{}\n", range_from_float_bounds(1.0, 4.0));
}
