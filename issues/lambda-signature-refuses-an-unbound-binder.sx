@import "modules/std.sx";

Box :: struct ($V: Type) { v: V; }
Holder :: struct ($T: Type) { run :: (self: *Holder) {} }

main :: () {
    wrapped := |x: Box($T)| 1;
    through := |x: *Box($T)| 2;
    sliced := |x: []$T| 21;
    sized := |x: [3]$T| 22;
    unsized := |x: [*]$T| 23;
    inline_struct := |x: struct { v: $T; }| 3;
    inline_union := |x: union { a: $T; b: i64; }| 31;
    inline_enum := |x: enum { a: $T; b; }| 32;
    fn_pointer := |x: ($T) -> i64| 33;
    failable := |x: (Box($T), !)| 34;
    phantom := |x: Holder($T)| 4;
    formed := |v: $I/@Init(Box($T))| 5;
    nested_formation := |v: Box($I/@Init(i64))| 6;
    signature := |f: Closure(i64) -> Box($T)| 7;
    pack := |f: Closure(..$Ts) -> i64| 8;
    returns := |x: i64| -> Box($T) .{ v = x };
    multi_returns := |x: i64| -> (Box($T), i64) { return .{ v = x }, x; };
    spread_returns := |x: i64| -> (..$Ts, i64) { return x; };
    _ = wrapped;
    _ = through;
    _ = sliced;
    _ = sized;
    _ = unsized;
    _ = inline_struct;
    _ = inline_union;
    _ = inline_enum;
    _ = fn_pointer;
    _ = failable;
    _ = phantom;
    _ = formed;
    _ = nested_formation;
    _ = signature;
    _ = pack;
    _ = returns;
    _ = multi_returns;
    _ = spread_returns;
}
