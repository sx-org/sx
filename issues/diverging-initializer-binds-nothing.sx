@import "modules/std.sx";

stop :: () -> noreturn {
    @panic("unreachable");
}

blockTail :: (live: bool) -> i32 {
    if live { return 1; }
    x := { stop() };
    return x;
}

directCall :: (live: bool) -> i32 {
    if live { return 2; }
    x := stop();
    return x;
}

earlyReturn :: (live: bool) -> i32 {
    if live { return 3; }
    x := { return 9; };
    return x;
}

main :: () {
    print("{} {} {}\n", blockTail(true), directCall(true), earlyReturn(true));
}
