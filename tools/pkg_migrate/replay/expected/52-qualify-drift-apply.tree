===== testdata/qualify/ambiguous_map.txt
# `helper` is provided by two different sources — AMBIGUOUS, the tool must
# refuse to rewrite anything.
helper=util
helper=other
CONSTANT=util
===== testdata/qualify/map.txt
# name=alias mapping for qualify
helper=util
CONSTANT=util
===== testdata/qualify/shadow.sx
// shadow fixture: this file declares `helper` locally, so NO occurrence of
// `helper` may be rewritten — every one must be reported as a skip.
#import "modules/util.sx";

helper :: (n: int) -> int {
    return n + 1;
}

main :: () {
    x := helper(3); // local, not util.helper — rewriting would break it
    print("{}\n", x);
}
===== testdata/qualify/uses.sx
// qualify fixture: flat uses of `helper` and `CONSTANT` should become
// qualified; mentions in this comment (helper) and in strings must not.
#import "modules/util.sx";

main :: () {
    x := helper(3);            // call position -> util.helper(3)
    y := x + CONSTANT;         // use position  -> util.CONSTANT
    s := "helper CONSTANT";    // inside a string: untouched
    already := util.helper(4); // already qualified: untouched
    lit := Config{ helper = 1 }; // field init: SKIP, reported
    print("{} {} {} {}\n", x, y, s, already, lit);
}
