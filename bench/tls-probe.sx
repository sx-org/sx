// TLS link probe — NOT a corpus test: it links the heavy 109-file mbedTLS
// vendor, so it stays out of the suite. An sx program links the vendored
// mbedTLS for the host AND aarch64-linux: it initializes an
// entropy source + CTR_DRBG + an SSL config, applies server stream
// defaults, and prints the linked mbedTLS version.
//
//   ./zig-out/bin/sx build bench/tls-probe.sx -o .sx-tmp/tlsprobe
//   .sx-tmp/tlsprobe                          # expect "3.6.6", exit 0
//
//   ./zig-out/bin/sx build --target aarch64-linux --self-contained \
//       bench/tls-probe.sx -o .sx-tmp/tlsprobe-l
//   container run --rm -v "$PWD/.sx-tmp:/work" alpine /work/tlsprobe-l
@import "modules/std.sx";
@import "vendors/mbedtls/mbedtls.sx";

main :: () -> i32 {
    entropy : mbedtls.Entropy = .{};
    drbg    : mbedtls.CtrDrbg = .{};
    conf    : mbedtls.SslConfig = .{};

    mbedtls.mbedtls_entropy_init(@entropy);
    mbedtls.mbedtls_ctr_drbg_init(@drbg);
    mbedtls.mbedtls_ssl_config_init(@conf);

    // Seed the DRBG from the entropy source (entropy_func is the collector).
    rc := mbedtls.mbedtls_ctr_drbg_seed(@drbg, mbedtls.mbedtls_entropy_func, xx @entropy, xx 0, 0);
    if rc != 0 {
        print("ctr_drbg_seed failed: {}\n", rc);
        return 1;
    }

    // Server-side, TLS-stream, default preset.
    rc = mbedtls.mbedtls_ssl_config_defaults(
        @conf,
        mbedtls.MBEDTLS_SSL_IS_SERVER,
        mbedtls.MBEDTLS_SSL_TRANSPORT_STREAM,
        mbedtls.MBEDTLS_SSL_PRESET_DEFAULT,
    );
    if rc != 0 {
        print("ssl_config_defaults failed: {}\n", rc);
        return 1;
    }

    // Print the linked mbedTLS version (writes a NUL-terminated C string).
    ver : [16]u8 = ---;
    mbedtls.mbedtls_version_get_string(xx @ver);
    n := 0;
    while n < 16 and ver[n] != 0 { n = n + 1; }
    s := string{ ptr = xx @ver, len = n };
    print("{}\n", s);

    mbedtls.mbedtls_ssl_config_free(@conf);
    mbedtls.mbedtls_ctr_drbg_free(@drbg);
    mbedtls.mbedtls_entropy_free(@entropy);
    return 0;
}
